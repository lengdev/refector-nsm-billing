    function loadVendorDeposits() {

        var vendorId = getVendorId();

        resetDepositForm();

        if (!vendorId) {
            return;
        }

        $("#lblDepositVendor").text(
            $("#PayeeID option:selected").text()
        );

        $("#depositHelp").text("Loading vendor deposits...");

        var selectedDepositID =
            Number(ViewBagVendorDepositID) || 0;

        var existingAppliedAmount =
            Number(ViewBagAppliedAmount) || 0;

        var isEdit = selectedDepositID > 0;

        $.ajax({
            url: depositUrl,
            type: "GET",
            dataType: "json",

            data: {
                vendorId: vendorId,
                vendorDepositId: selectedDepositID,
                expenseID: Number(PrimaryFieldValue) || 0
            },

            success: function (response) {

                if (!response || !response.success) {

                    $("#depositHelp").text(
                        response?.message || "Unable to load vendor deposits."
                    );

                    return;
                }

                vendorDeposits = response.data || [];

                var $select = $("#VendorDepositTransactionID");

                $select.empty().append(
                    $("<option>", {
                        value: "",
                        text: "-- Select Deposit --"
                    })
                );

                var availableTotal = 0;

                vendorDeposits.forEach(function (deposit) {

                    var depositID =
                        Number(deposit.VendorDepositID) || 0;

                    // IMPORTANT:
                    // Use AvailableAmount when editing.
                    // It includes the current expense's previous application.
                    var available =
                        Number(deposit.AvailableAmount) || 0;

                    var isPreviouslySelected =
                        isEdit && depositID === selectedDepositID;

                    // Skip deposits without available balance,
                    // except the previously selected deposit.
                    if (available <= 0 && !isPreviouslySelected) {
                        return;
                    }

                    // Sum available balances for the current vendor.
                    availableTotal += Math.max(available, 0);

                    var label =
                        deposit.DepositNo +
                        " | " +
                        deposit.DepositDate +
                        " | Available: $" +
                        money(available);

                    if (isPreviouslySelected) {
                        label += " (Currently Applied)";
                    }

                    $select.append(
                        $("<option>", {
                            value: depositID,
                            text: label
                        })
                    );
                });

                // Display available total.
                $("#lblAvailableDeposit").text(
                    money(availableTotal)
                );

                // Show/hide deposit section.
                var hasDeposits =
                    $select.find("option").length > 1;

                if (hasDeposits) {

                    $("#divAPPLYVENDORDEPOSIT")
                        .removeClass("d-none")
                        .show();

                } else {

                    $("#divAPPLYVENDORDEPOSIT").hide();
                }

                // Restore previous deposit selection.
                if (isEdit) {

                    var existingDeposit = vendorDeposits.find(
                        function (x) {
                            return Number(x.VendorDepositID) ===
                                selectedDepositID;
                        }
                    );

                    if (existingDeposit) {

                        $select.val(selectedDepositID);

                        // Trigger selected deposit calculation.
                        $select.trigger("change");

                        // Restore original application amount.
                        // Do this AFTER triggering change.
                        $("#AmountToApply").val(
                            existingAppliedAmount.toFixed(2)
                        );

                        // Update validation limit.
                        $("#AmountToApply").attr(
                            "max",
                            Number(existingDeposit.AvailableAmount) || 0
                        );

                        $("#AmountToApply").attr(
                            "data-available",
                            Number(existingDeposit.AvailableAmount) || 0
                        );                        
                    } else {

                        $("#AmountToApply").val("0.00");
                    }
                }
                if (PrimaryFieldValue > 0) {
                    $select.prop("disabled", true);

                }
                else
                    $select.prop("disabled", !hasDeposits);

                $("#depositHelp").text(
                    hasDeposits
                        ? ""
                        : "This vendor has no available deposits."
                );

            },

            error: function (xhr) {

                console.error(
                    "GetAvailableDeposits error:",
                    xhr.responseText
                );

                $("#depositHelp").text(
                    "Error loading deposits. Please try again."
                );
            }
        });
    }

    function getSelectedDeposit() {
        var id = Number(
            $("#VendorDepositTransactionID").val()
        );

        return vendorDeposits.find(function (deposit) {
            return Number(deposit.VendorDepositID) === id;
        });
    }


    function updateDepositPreview() {

        var deposit = getSelectedDeposit();

        var billTotal = getBillTotal();

        var amount = Number($("#AmountToApply").val()) || 0;
        if (!deposit) {

            $("#AmountToApply")
                .val("0.00")
                .prop("disabled", true)
                .removeAttr("max")
                .removeAttr("data-available");

            $("#btnMaxDeposit").prop("disabled", true);
            $("#btnApplyVendorDeposit").prop("disabled", true);

            $("#lblSelectedDeposit").text("-");
            $("#lblDepositRemaining").text("0.00");

            $("#lblBillRemainingAfterDeposit").text(
                money(billTotal)
            );

            return;
        }

        // AvailableAmount includes the existing application
        // for this bill when editing.
        var depositAvailable = Number(deposit.AvailableAmount);

        if (!Number.isFinite(depositAvailable)) {
            depositAvailable = Number(deposit.RemainingAmount) || 0;
        }

        depositAvailable = Math.max(0, depositAvailable);

        // Maximum amount cannot exceed either balance.
        var maxAmount = Math.min(
            depositAvailable,
            billTotal
        );

        // Validate amount.
        var validAmount =
            amount > 0 &&
            amount <= maxAmount;

        // Selected deposit.
        $("#lblSelectedDeposit").text(
            deposit.DepositNo || "-"
        );

        // Remaining deposit after applying.
        $("#lblDepositRemaining").text(
            money(Math.max(0, depositAvailable - amount))
        );

        // Remaining bill after applying.
        $("#lblBillRemainingAfterDeposit").text(
            money(Math.max(0, billTotal - amount))
        );

        // Input settings.
        $("#AmountToApply")
            .prop("disabled", false)
            .attr("max", maxAmount)
            .attr("data-available", depositAvailable);

        // Max button.
        $("#btnMaxDeposit").prop(
            "disabled",
            maxAmount <= 0
        );

        // Apply button.
        $("#btnApplyVendorDeposit").prop(
            "disabled",
            !validAmount
        );

        // Validation message.
        if (amount > depositAvailable) {

            $("#depositHelp").text(
                "Amount exceeds available deposit: $" +
                money(depositAvailable)
            );

        } else if (amount > billTotal) {

            $("#depositHelp").text(
                "Amount exceeds bill total: $" +
                money(billTotal)
            );

        } else {

            $("#depositHelp").text("");
        }
    }

    // $(document).on("change", "#PayeeID", function () {
    //     loadVendorDeposits();
    // });


    $(document)
        .off("change.vendorDeposit", "#VendorDepositTransactionID")
        .on("change.vendorDeposit", "#VendorDepositTransactionID", function () {

            var deposit = getSelectedDeposit();

            if (!deposit) {
                updateDepositPreview();
                return;
            }

            var billID = Number(PrimaryFieldValue) || 0;
            var savedDepositID = Number(ViewBagVendorDepositID) || 0;
            var selectedDepositID =
                Number($("#VendorDepositTransactionID").val()) || 0;

            // Parse the saved applied amount.
            var savedAmount = accounting.unformat(
                String(ViewBagAppliedAmount || "0")
            ) || 0;

            var amountToApply = 0;
            var SubTotal = accounting.unformat(
                $.trim($("#summaryGrandUsd").text() || "")
            );
            if (Number(PrimaryFieldValue) > 0) {
                if (deposit.CurrentExpenseAppliedAmount == 0) {
                    deposit.CurrentExpenseAppliedAmount = SubTotal;
                }
                // Editing: restore the original amount applied to this expense.
                amountToApply =
                    Number(deposit.CurrentExpenseAppliedAmount) || 0;
            } else {
                // New expense: use the available deposit balance.
                
                amountToApply =
                    Number(SubTotal) || 0;
            }
            $("#AmountToApply")
                .val(amountToApply.toFixed(2))
                .prop("disabled", false);
            setTimeout(function () {
                getBillRemaining();
                updateDepositPreview();
            }, 500);
            

            // console.log("Vendor Deposit Debug:", {
            //     billID: billID,
            //     savedDepositID: savedDepositID,
            //     selectedDepositID: selectedDepositID,
            //     savedAmount: savedAmount,
            //     amountToApply: amountToApply,
            //     depositRemaining: deposit.RemainingAmount
            // });
        });
    $(document).on(
        "input",
        "#AmountToApply",
        updateDepositPreview
    );

    // Initialize if a vendor is already selected.
    $(function () {
        if (getVendorId()) {
            loadVendorDeposits();
        }
    });

//})(jQuery);
</script>
<script>

(function () {
    "use strict";

    // Remove the previous handler if this script is executed again.
    if (window.amsExpenseTabClickHandler) {
        document.removeEventListener(
            "click",
            window.amsExpenseTabClickHandler,
            true
        );
    }

    window.amsExpenseTabClickHandler = function (event) {

        const tab = event.target.closest(
            "#ams-expense-tabs .ams-tab-link"
        );

        if (!tab) return;

        event.preventDefault();

        const container = tab.closest("#ams-expense-tabs");
        if (!container) return;

        const target = tab.getAttribute("data-tab");

        // Update tab styles.
        container.querySelectorAll(".ams-tab-link").forEach(function (link) {
            const active = link === tab;

            link.classList.toggle("active", active);
            link.setAttribute("aria-selected", active ? "true" : "false");
        });

        // Show the selected content and hide the other content.
        container.querySelectorAll(".ams-tab-pane").forEach(function (pane) {
            pane.style.display =
                pane.getAttribute("data-content") === target ? "block" : "none";
        });

        // console.log("Active tab:", target);
    };

    document.addEventListener(
        "click",
        window.amsExpenseTabClickHandler,
        true
    );

})();
</script>

