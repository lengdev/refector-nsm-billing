    $(document).on("input", "input[name='ApplyPercent']", function () {

        var $row = $(this).closest("tr");

        var originalAmount =
            parseFloat($row.find("input[name='OriginalAmount']").val()) || 0;

        var applyPercent =
            parseFloat($(this).val()) || 0;

        // Limit 0 - 100
        if (applyPercent < 0) {
            applyPercent = 0;
            $(this).val(0);
        }

        if (applyPercent > 100) {
            applyPercent = 100;
            $(this).val(100);
        }

        // Calculate Apply Amount
        var applyAmount =
            originalAmount * applyPercent / 100;

        // Calculate Remaining Amount
        var remainAmount =
            originalAmount - applyAmount;

        // Set values
        $row.find("input[name='ApplyAmount']")
            .val(applyAmount.toFixed(2));

        $row.find("input[name='RemainAmount']")
            .val(remainAmount.toFixed(2));

        // console.log(remainAmount);
        // Update summary
        calculateVendorDepositTotal();
    });

    function calculateVendorDepositTotal() {

        var originalTotal = 0;
        var totalApplyAmount = 0;
        var unusedDepositBalance = 0;

        $("table#TblAccountVendorDepositDetails tbody tr").each(function () {

            var $row = $(this);

            var originalAmount =
                parseFloat(
                    $row.find("input[name='OriginalAmount']").val()
                ) || 0;

            var applyAmount =
                parseFloat(
                    $row.find("input[name='ApplyAmount']").val()
                ) || 0;

            var remainAmount =
                parseFloat(
                    $row.find("input[name='RemainAmount']").val()
                ) || 0;

            originalTotal += originalAmount;
            totalApplyAmount += applyAmount;
            unusedDepositBalance += remainAmount;
        });

        $("#OriginalTotal").text(originalTotal.toFixed(2));
        $("#TotalApplyAmount").text(totalApplyAmount.toFixed(2));
        $("#UnusedDepositBalance").text(unusedDepositBalance.toFixed(2));
    }


    function OnApplyAmount(THIS) {
        var $row = $(THIS).closest("tr");

        if ($row.length > 0) {
            var ApplyAmount =
                parseFloat(accounting.unformat($(THIS).val())) || 0;

            var originalAmount =
                parseFloat(
                    accounting.unformat(
                        $row.find("input[name='OriginalAmount']").val()
                    )
                ) || 0;

            // Apply Amount cannot be greater than Original Amount
            if (ApplyAmount > originalAmount) {
                DialogSweetAlert(
                    'error',
                    'Apply Amount cannot be bigger than Original Amount.'
                );
                return false;
            }

            // Calculate Remaining Amount
            var remainAmount = originalAmount - ApplyAmount;

            // Calculate Apply Percent
            var percent = 0;

            if (originalAmount > 0) {
                percent = (ApplyAmount / originalAmount) * 100;
            }

            // Round percentage to 2 decimal places
            percent = Math.round((percent + Number.EPSILON) * 100) / 100;

            // Set values
            $row.find("input[name='RemainAmount']")
                .val(remainAmount.toFixed(2));

            $row.find("input[name='ApplyPercent']")
                .val(percent.toFixed(2) + '%');

            UpdateVendorDepositSummary(THIS);
        }
    }

    function OnApplyPercent(THIS) {
        var $row = $(THIS).closest("tr");
        if ($row.length > 0) {
            //var ApplyAmount = accounting.unformat($(THIS).val())
            var originalAmount = parseFloat(accounting.unformat($row.find("input[name='OriginalAmount']").val())) || 0;
            //if (ApplyAmount > originalAmount) {
            //    DialogSweetAlert('error', `Apply Amount cannot bigger then Original Amount.`);
            //    return false;
            //}
            var applyPercent = parseFloat(accounting.unformat($(THIS).val())) || 0;
            //console.log(applyPercent)
            // Limit 0 - 100
            if (applyPercent < 0) {
                applyPercent = 0;
                $(THIS).val(0);
            }

            if (applyPercent > 100) {
                applyPercent = 100;
                $(THIS).val(100);
            }

            // Calculate Apply Amount
            var applyAmount = originalAmount * applyPercent / 100;

            // Calculate Remaining Amount
            var remainAmount = originalAmount - accounting.unformat(applyAmount);
            var percent = (applyAmount / originalAmount) * 100;

            // Set values
            $row.find("input[name='ApplyAmount']").val(applyAmount.toFixed(2));

            $row.find("input[name='RemainAmount']").val(remainAmount.toFixed(2));
            //$row.find("input[name='ApplyPercent']").val(percent + '%');
            UpdateVendorDepositSummary(THIS);
        }
    }

