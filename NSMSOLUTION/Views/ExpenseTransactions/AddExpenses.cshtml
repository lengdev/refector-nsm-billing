        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
    }

        .deposit-info-row:last-child {
            margin-bottom: 0;
        }

    /* Field labels */
    .deposit-inline-row .settlement-label {
        display: block;
        margin-bottom: 6px;
        font-weight: 600;
        font-size: 13px;
    }

    /* Input sizing */
    .deposit-inline-row .settlement-input {
        width: 100%;
        min-width: 0;
    }

    /* Help text */
