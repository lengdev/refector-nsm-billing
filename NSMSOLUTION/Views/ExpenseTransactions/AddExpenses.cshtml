                                    $ExpenseDetailsAmount.focus();
                                });
                                isValid = false;
                                return false;
                            }
                            var Account_Name = $row.find("input[name=AccountVendorDeposit]").data("kendoMultiColumnComboBox");
                            var AccountName = Account_Name ? Account_Name.text() : "";
                            var AccountID = Account_Name ? Account_Name.value() : "";
                            var Description = AccountName + "-" + $ExpenseDetailsDescription.val();

                            var qtyVal = accounting.unformat($ExpenseDetailsQTY.val());
                            var amountVal = accounting.unformat($ExpenseDetailsAmount.val());
                            var totalVal = accounting.unformat($ExpenseDetailsTotal.val()) || (qtyVal * amountVal);

                            RowData2[i].AccountID = AccountID;
                            RowData2[i].AccountName = AccountName;
                            RowData2[i].Description = AccountName;
                            RowData2[i].DisUSD = 0;
                            RowData2[i].UM = $ExpenseDetailsUM.val();
                            RowData2[i].QTY = qtyVal;
                            RowData2[i].UnitPrice = amountVal;
                            RowData2[i].Total = totalVal;// accounting.unformat($("#PaymentAmount").val());
                            RowData2[i].ItemGrandTotal = totalVal;
                            RowData2[i].ItemID = 0;
                            RowData2[i].ItemName_Description = "";
                            RowData2[i].RefNo = $row.attr("data-refno") || "";
                            RowData2[i].SourceType = $row.attr("data-sourcetype") || "";
                            RowData2[i].ItemTAX = 0;
                            RowData2[i].ItemVAT = 0;
                            RowData2[i].ExpenseCategoryType = "Expenses";
                        }
                    });
                    if (!isValid) {
                        isSubmittingExpense = false;
                        setExpenseSaveButtonsState(false);
                        return false;
                    }
                }
                if (RowData.length > 0 && RowData[RowData.length - 1].mergedData == "") {
                    RowData.pop();
                }
                if (RowData2.length > 0 && RowData2[RowData2.length - 1].ItemName == "") {
                    RowData2.pop();
                }
                // 1. Merge RowData + RowData2
                var mergedData = [
                    ...(Array.isArray(RowData) ? RowData : []),
                    ...(Array.isArray(RowData2) ? RowData2 : [])
                ];
                // Remove ALL rows where ExpenseCategory is empty
                mergedData = mergedData.filter(x => x?.ItemName !== "");

                // console.log("Final mergedData:", mergedData);
                if (!isHaveData || mergedData.length ==0) {
                    DialogSweetAlert('error', 'Please enter Data.', function () {
                        setExpenseSaveButtonsState(false);
                    });
                    return false;
                }
                if (isValid) {
                    var DATA = {
                        DATA: JSON.stringify({
                            ExpenseData: Expense,
                            Details: mergedData
                        })
                    };

                    DoSaveChageAjaxForm("FrmAddExpense", "ExpenseTransactions/CreateAsync", DATA, "", function (response) {
                        if (response.Result === 2) {
                            //closeDialogClick("modal-default");
                            $("#modal-default").modal('hide');
                            $('.modal').remove();
                            $('.modal-backdrop').remove();
                            $('body').removeClass("modal-open");
                            $("#BunSearch").click();
                        }
                        else {
                            isSubmittingExpense = false;
                            setExpenseSaveButtonsState(false);
                            DialogSweetAlert('error', response.message);
                        }
                    });
                }
                else {
                    isSubmittingExpense = false;
                    setExpenseSaveButtonsState(false);
                }
            }, 500);
        }
        else {
            var DATA = {
                DATA: JSON.stringify({
                    ExpenseData: Expense,
                    Details: []
                })
            };
            DoSaveChageAjaxForm("FrmAddExpense", "ExpenseTransactions/CreateAsync", DATA, "", function (response) {
                if (response.Result === 2) {
