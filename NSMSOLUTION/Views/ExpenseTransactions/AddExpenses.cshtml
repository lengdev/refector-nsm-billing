    function RefreshExpenseNo() {
        var ClassID = $("#ClassName").val();
        var PaymentDate = $("#PaymentDate").val();
        if (!ClassID || !PaymentDate) {
            return;
        }

        // When editing an existing expense:
        if (PrimaryFieldValue != "" && PrimaryFieldValue != "0") {
            getOriginalExpenseNo();

            // First time ClassID and PaymentDate become available, record them as the original values
            if (initialClassID === null) {
                initialClassID = ClassID;
            }
            if (initialPaymentDate === null) {
                initialPaymentDate = PaymentDate;
            }

            // If Class has not changed, and the Year-Month (yyMM) is the same, KEEP original ExpenseNo!
            var currentYM = getYearMonth(PaymentDate);
            var initialYM = getYearMonth(initialPaymentDate);
            if (ClassID == initialClassID && currentYM === initialYM) {
                if (initialExpenseNo) {
                    $("#ExpenseNo").val(initialExpenseNo);
                }
                return;
            }
        }

        LoadData("ExpenseTransactions/GetPVNumber?ClassID=" + encodeURIComponent(ClassID) + "&paymentDate=" + encodeURIComponent(StringToDate(PaymentDate)) + "&IsFromBills=" + (IsFromBills.toLowerCase() === "true"), function (response) {
            var rst = JSON.parse(response);
            if (rst && rst.ExpenseNo) {
                if (PrimaryFieldValue != "" && PrimaryFieldValue != "0") {
                    var currentYM = getYearMonth($("#PaymentDate").val());
                    var initialYM = getYearMonth(initialPaymentDate);
                    if (currentYM === initialYM && initialExpenseNo) {
                        $("#ExpenseNo").val(initialExpenseNo);
                        return;
                    }
                }
                $("#ExpenseNo").val(rst.ExpenseNo);
            }
        });
    }

