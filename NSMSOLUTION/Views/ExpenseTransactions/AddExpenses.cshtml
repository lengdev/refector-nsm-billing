    function LoadVendorBankInfo() {
        VendorBankInfo = [];
        var multicolumncombobox = $("#PayeeID").data("kendoMultiColumnComboBox");
        var VendorID = multicolumncombobox.value();
        if (VendorID != "0" && VendorID != "" && PrimaryFieldValue == 0) {
            $("#TblExpensesItem #BankInfo").val('');
            LoadData("AddVendor/LoadVendorBankInfo?VendorID=" + VendorID, function (response) {
                if (response != "[]" && response != "") {
                    var rst = JSON.parse(response)[0];
                    VendorBankInfo.push(rst);
                    var row = '';
                    if (rst.BankerName != "")
                        row += `Banker's Name: ` + rst.BankerName + `\n`;
                    if (rst.SwiftCode != "")
                        row += `Swift Code: ` + rst.SwiftCode + `\n`;
                    if (rst.AccountNo != "")
                        row += `Account No: ` + rst.AccountNo + `\n`;
                    if (rst.AccountName != "")
                        row += `Account Name: ` + rst.AccountName + `\n`;

                    $("#BankerName").val(rst.BankerName);
                    $("#BankAccountName").val(rst.AccountName);
                    $("#BankAccountNo").val(rst.AccountNo);
                    //$("#TblExpensesItem #BankInfo").val(row);
                }
                loadVendorDeposits();
            });
        }
        else {
            loadVendorDeposits();
        }
    }

