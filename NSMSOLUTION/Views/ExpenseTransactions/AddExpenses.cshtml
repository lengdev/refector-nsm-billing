@{
    decimal totalAmount = 0;
    decimal paidAmount = 0;
    decimal PreviousPaidAmount = 0;
    bool IsRequestedPayment = false;
    decimal balanceAmount = 0;
    string PostedPaymentNo = "";
    if (!string.IsNullOrWhiteSpace(Convert.ToString(ViewBag.PaymentNo)))
    {
        DataTable dt = ViewBag.ItemDetails as DataTable ?? new DataTable();
        DataTable dtSummary = ViewBag.dtSummary as DataTable ?? new DataTable();
        DataTable dtPaymentHistory = ViewBag.dtPaymentHistory as DataTable ?? new DataTable();

        if (dtSummary.Rows.Count > 0)
        {
            DataRow r = dtSummary.Rows[0];

            totalAmount = r["TotalAmount"] == DBNull.Value ? 0 : Convert.ToDecimal(r["TotalAmount"]);
            PreviousPaidAmount = r["PreviousPaidAmount"] == DBNull.Value ? 0 : Convert.ToDecimal(r["PreviousPaidAmount"]);
            paidAmount = r["PaidAmount"] == DBNull.Value ? 0 : Convert.ToDecimal(r["PaidAmount"]);
            balanceAmount = r["BalanceAmount"] == DBNull.Value ? 0 : Convert.ToDecimal(r["BalanceAmount"]);
            IsRequestedPayment = r["IsRequestedPayment"] == DBNull.Value ? false : Convert.ToBoolean(r["IsRequestedPayment"]);
            PostedPaymentNo = r["PostedPaymentNo"] == DBNull.Value ? "" : r["PostedPaymentNo"].ToString();
            //if (IsRequestedPayment)
            //{
            //    balanceAmount += paidAmount;
            //}
        }
        <div class="card shadow-sm mt-3">
            <div class="card-header bg-warning text-white fw-bold">
                Item Details
            </div>

            <div class="card-body p-0 table-responsive">
                <table class="table table-bordered table-hover table-sm">
                    <thead class="table-light text-nowrap">
                        <tr class="text-uppercase text-center">
                            <th class="text-center">#</th>
                            <th>Expense Account</th>
                            <th>Account No</th>
                            <th>Item / Service</th>
                            @*<th>Description</th>*@
                            <th class="text-center">UOM</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount</th>
                            <th class="text-end">Tax</th>
                            <th class="text-end">Grand Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int i = 1;
                            decimal grandTotal = 0;
                        }

                        @foreach (DataRow row in dt.Rows)
                        {
                            grandTotal += Convert.ToDecimal(row["Total"]);

                            <tr>

                                <td class="text-center">@i</td>

                                <td>@row["ExpenseAccount"]</td>

                                <td>@row["AccountNo"]</td>

                                <td>
                                    @row["ItemName"]<br />
                                    @row["ItemName_Description"]
                                </td>

                                @*<td>@row["ItemName_Description"]</td>*@

                                <td class="text-center">@row["UM"]</td>

                                <td class="text-right">@Convert.ToDecimal(row["QTY"]).ToString("N0")</td>

                                <td class="text-right">@Convert.ToDecimal(row["UnitPrice"]).ToString("N4")</td>

                                <td class="text-right">@Convert.ToDecimal(row["DisUSD"]).ToString("N2")</td>

                                <td class="text-right">@Convert.ToDecimal(row["ItemTAX"]).ToString("N2")%</td>

                                <td class="text-right fw-bold">
                                    @Convert.ToDecimal(row["Total"]).ToString("N2")
                                </td>

                            </tr>

                            i++;
                        }

                    </tbody>

                    <tfoot class="table-light">
                        <tr>
                            <th colspan="9" class="text-right">
                                Grand Total
                            </th>

                            <th class="text-right text-primary">
                                <label name="SubTotal">@grandTotal.ToString("N2")</label>

                            </th>
                        </tr>
                    </tfoot>

                </table>

            </div>
        </div>
        <div class="card shadow-sm border-0 pt-2">

            <div class="card-header bg-warning text-white fw-bold">
                Payment Information
            </div>

            <div class="card-body">

                <!-- Payment Amount -->
                <div class="row align-items-center mb-4">
                    <label class="fw-semibold pr-1">
                        Payment Amount: <span class="text-danger">*</span>
                    </label>

                    <div class="">
                        <input type="text"
                               id="txtAmountInput"
                               class="form-control form-control-lg text-end"
                               placeholder="0.00"
                               value="@(IsRequestedPayment ? PreviousPaidAmount.ToString("N2") : "")" />
                    </div>
                </div>

                <hr>

                <!-- Summary -->
                <div style="font-size:16px">

                    <div class="row py-2 text-nowrap text-primary">
                        <div class="col-5 fw-semibold">
                            Total Expense:
                        </div>

                        <div class="col-auto text-end fs-5 fw-bold">
                            @totalAmount.ToString("C2")
                        </div>
                    </div>

                    <div class="row py-2 text-nowrap">
                        <div class="col-5 fw-semibold">
                            Already Paid:
                        </div>

                        <div class="col-auto text-end text-primary fw-bold">
                            @paidAmount.ToString("C2")
                        </div>
                    </div>

                    <div class="row py-2 border-top text-nowrap">
                        <div class="col-5 fw-semibold">
                            Balance:
                        </div>

                        <div class="col-auto text-end text-danger fw-bold fs-5">
                            <span id="lblTotalAll">@balanceAmount.ToString("C2")</span>
                        </div>
                    </div>

                    <div class="row py-2 border-top text-nowrap">
                        <div class="col-5 fw-bold">
                            Remaining Balance:
                        </div>

                        <div class="col-auto text-end text-success fw-bold fs-4">
                            <span id="lblRemainingBalance">
                                @balanceAmount.ToString("C2")
                            </span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="card shadow-sm mt-3">

            <div class="card-header bg-warning text-white fw-bold">
                Payment History
            </div>

            <div class="card-body p-0 table-responsive">

                <table class="table table-bordered table-hover table-sm mb-0">

                    <thead class="table-light">
                        <tr class="text-center text-uppercase text-nowrap">

                            <th style="width:50px">No.</th>

                            <th>Created Date</th>
                            <th>Posted Date</th>

                            <th>Payment No</th>

                            <th>Payment Method</th>

                            <th class="text-end">Paid Amount</th>

                            <th class="text-end">Running Balance</th>

                            <th>Posted By</th>
                            <th>Workflow Status</th>
                            <th>Payment Status</th>

                            <th>Remark</th>

                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int no = 1;
                        }

                        @foreach (DataRow row in dtPaymentHistory.Rows)
                        {
                            <tr>

                                <td class="text-center">@no</td>

                                <td class="text-center">
                                    @(row["CreatedDate"] == DBNull.Value ? "" :
        Convert.ToDateTime(row["CreatedDate"]).ToString("dd/MM/yyyy"))
                                </td>
                                <td class="text-center">
                                    @(row["PostedDate"] == DBNull.Value ? "" :
        Convert.ToDateTime(row["PostedDate"]).ToString("dd/MM/yyyy"))
                                </td>

                                <td>@row["PaymentNo"]</td>

                                <td>@row["PaymentMethod"]</td>

                                <td class="text-right text-success fw-bold">
                                    @Convert.ToDecimal(row["PaidAmount"]).ToString("N2")
                                </td>

                                <td class="text-right text-danger fw-bold">
                                    @Convert.ToDecimal(row["BalanceAmount"]).ToString("N2")
                                </td>

                                <td>@row["PaidBy"]</td>

                                <td class="text-center">

                                    @if (Convert.ToBoolean(row["IsPosted"]))
                                    {
                                        <span class="badge badge-success">Posted</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-warning">
                                            @row["Status"]
                                        </span>
                                    }

                                </td>
                                <td class="text-center">

                                    @*@if (Convert.ToBoolean(row["IsPosted"]))
                                        {
                                            <span class="badge badge-success">Posted</span>
                                        }
                                        else
                                        {*@
                                    <span class="badge badge-warning">
                                        @row["PaymentStatus"]
                                    </span>
                                    @*}*@

                                </td>
                                <td>@row["Remark"]</td>

                            </tr>

                            no++;
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
}
<script>
    var isGrandTotalKhrManuallyEdited = false;
    // Track the previous exchange rate
    var lastObservedExchangeRate = null;
    var POData = "";
    $(function () {
        var setTableValues = window.SetValueTableRow;
        if (typeof setTableValues !== "function") return;

        function hasAccount(data, accountId) {
            var found = false;

            function visit(items) {
                if (!items || found) return;
                for (var i = 0; i < items.length; i++) {
                    var item = items[i];
                    if (item.items) {
                        visit(item.items);
                    } else if (String(item.ExpensesAccountID) === String(accountId)) {
                        found = true;
                        return;
                    }
                }
            }

            visit(data);
            return found;
        }

        window.SetValueTableRow = async function (data, inputName, tableId) {
            var result = await setTableValues.apply(this, arguments);
            if ((tableId !== "TblExpensesItem" && tableId !== "ExpenseDetails") || !Array.isArray(data)) return result;

            var comboInputSelector = tableId === "ExpenseDetails"
                ? "#ExpenseDetails input[name=AccountVendorDeposit]"
                : "#TblExpensesItem input[name=ExpenseCategory]";

            data.forEach(function (row, rowIndex) {
                var accountId = row.ExpenseCategory;
                if (accountId == null || accountId === "" || String(accountId) === "0") return;

                var attempts = 0;
                var stableSelections = 0;
                var previousCombo = null;
                var timer = window.setInterval(function () {
                    attempts++;
                    var combo = $(comboInputSelector)
                        .eq(rowIndex)
                        .data("kendoMultiColumnComboBox");

                    if (combo && hasAccount(combo.dataSource.data(), accountId)) {
                        if (combo !== previousCombo) {
                            previousCombo = combo;
                            stableSelections = 0;
                        }

                        if (String(combo.value()) !== String(accountId)) {
                            combo.value(accountId);
                            combo.trigger("change");
                            stableSelections = 0;
                        } else {
                            stableSelections++;
                        }

                        if (stableSelections >= 20) {
                            window.clearInterval(timer);
                        }
                    }

                    if (attempts >= 200) {
                        window.clearInterval(timer);
                        console.error(
                            "Could not restore the saved account for item row " +
                            (rowIndex + 1) + " (account " + accountId + ")."
                        );
                    }
                }, 100);
            });

            return result;
        };
    });
