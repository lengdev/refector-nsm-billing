    var isCalculatingExpenseTotal = false;

    function calculateExpenseTotal() {

        // Prevent recursive/repeated execution
        if (isCalculatingExpenseTotal) {
            return;
        }

        isCalculatingExpenseTotal = true;

        try {

            var total = 0;

            // ==============================
            // 1. Calculate Subtotal
            // ==============================
            $('#ExpenseDetails tbody tr[name="VTR_No"]').each(function () {
                var $row = $(this);
                var qtyStr = String($row.find('input[name="ExpenseDetailsQTY"]').val() || '').replace(/,/g, '').trim();
                var amtStr = String($row.find('input[name="ExpenseDetailsAmount"]').val() || '').replace(/,/g, '').trim();
                var $totalInput = $row.find('input[name="ExpenseDetailsTotal"]');

                if (qtyStr !== '' || amtStr !== '') {
                    var qty = parseFloat(qtyStr) || 0;
                    var amt = parseFloat(amtStr) || 0;
                    var rowTotal = qty * amt;
                    var formattedRowTotal = accounting.formatNumber(rowTotal, 2);
                    if ($totalInput.val() !== formattedRowTotal) {
                        $totalInput.val(formattedRowTotal);
                    }
                }
            });

            $('#TblExpensesItem input[name="ItemGrandTotal"], #ExpenseDetails input[name="ExpenseDetailsTotal"]')
                .each(function () {

                    var value = String($(this).val() || '')
                        .replace(/,/g, '')
                        .trim();

                    var amount = parseFloat(value);

                    if (!isNaN(amount)) {
                        total += amount;
                    }
                });


            // ==============================
            // 2. Discount
            // ==============================
            var discount = parseFloat(
                String($('#TxtDisUSD').val() || '0')
                    .replace(/,/g, '')
                    .trim()
            ) || 0;


            // ==============================
            // 3. Tax Rate
            // HeaderTax:
            // 0  = NONE VAT
            // 10 = VAT 10%
            // 15 = VAT 15%
            // ==============================
            var taxRate = parseFloat($('#HeaderTax').val()) || 0;


            // ==============================
            // 4. Taxable Amount
            // ==============================
            var taxableAmount = total - discount;

            // Don't allow negative taxable amount
            if (taxableAmount < 0) {
                taxableAmount = 0;
            }


            // ==============================
            // 5. Tax Amount
            // ==============================
            var taxAmount = taxableAmount * taxRate / 100;


            // ==============================
            // 6. Grand Total
            // ==============================
            var grandTotal = taxableAmount + taxAmount;


            // ==============================
            // 7. Format Money
            // ==============================
            function formatMoney(value) {

                return value.toLocaleString('en-US', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

            }


            // ==============================
            // 8. Update UI
            // ==============================

            // Subtotal
            $('#summaryItemTotal').html(
                formatMoney(total)
            );

            // Discount
            $('#summaryDiscount').html(
                formatMoney(discount)
            );

            // Tax
            $('#summaryTaxAmount').html(
                formatMoney(taxAmount)
            );

            // Grand Total
            $('#summaryGrandUsd').html(
                formatMoney(grandTotal)
            );

            // Payment Amount
            $('#PaymentAmount').val(
                formatMoney(grandTotal)
            );


            // Return final amount
            return grandTotal;

        } finally {

            isCalculatingExpenseTotal = false;

        }
    }


    function calRequestPaidAmount() {
        var balance = @balanceAmount;

        var payment = parseFloat($("#txtAmountInput").val().replace(/,/g, "")) || 0;

        var remaining = balance - payment;

        if (IsRequestedPayment)
            remaining = (balance + parseFloat(PreviousPaidAmount)) - payment;

        //console.log(balance, PreviousPaidAmount, payment, IsRequestedPayment)

        if (remaining < 0)
            remaining = 0;

        $("#lblRemainingBalance").text(
            remaining.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            })
        );
    }

    function calWithExchangeRate() {

        // ==========================================
        // 1. VAT Remark Visibility
        // ==========================================
        $("#divVATRemark").removeClass("d-none");

        if ($("#HeaderTax").val() == 0) {
            $("#divVATRemark").hide();
        }
        else {
            $("#divVATRemark").show();
        }


        // ==========================================
        // 2. Read Current Exchange Rate
        // ==========================================
        var exchangeRate = accounting.unformat(
            $.trim($("#ExchangeRate").val() || "")
        );

        exchangeRate = Number(exchangeRate) || 0;


        // ==========================================
        // 3. Detect Exchange Rate Changes
        // ==========================================
        if (lastObservedExchangeRate === null) {

            // First calculation
            lastObservedExchangeRate = exchangeRate;

        }
        else if (exchangeRate !== lastObservedExchangeRate) {

            // Exchange rate changed:
            // Reset manual KHR editing mode.
            isGrandTotalKhrManuallyEdited = false;

            lastObservedExchangeRate = exchangeRate;

            $("#GrandTotalKHRStatus")
                .text("Automatically calculated using exchange rate.")
                .removeClass("text-primary")
                .addClass("text-muted");
        }


        // ==========================================
        // 4. Read USD Grand Total
        // ==========================================
        var SubTotal = accounting.unformat(
            $.trim($("#summaryGrandUsd").text() || "")
        );

        SubTotal = Number(SubTotal) || 0;


        // ==========================================
        // 5. Validate Exchange Rate
        // ==========================================
        if (exchangeRate <= 0 || SubTotal <= 0) {

            $("#GrandTotalKH").hide();

            return;
        }


        // ==========================================
        // 6. Show KHR Grand Total
        // ==========================================
        $("#GrandTotalKH").removeClass("d-none");
        $("#GrandTotalKH").show();


        // ==========================================
        // 7. Calculate KHR
        // ==========================================
        var rawRiel = SubTotal * exchangeRate;

        var roundedRiel = Math.round(rawRiel);

        var exchangeRateTotalRow = accounting.formatNumber(
            roundedRiel,
            0
        );


        // ==========================================
        // 8. Update KHR
        // ==========================================
        if (!isGrandTotalKhrManuallyEdited) {

            $("#summaryGrandKhr").val(exchangeRateTotalRow);

            $("#GrandTotalKHRStatus")
                .text("Automatically calculated using exchange rate.")
                .removeClass("text-primary")
                .addClass("text-muted");
        }

        // If manually edited and exchange rate has not changed,
        // preserve the user's manually entered KHR amount.
    }

