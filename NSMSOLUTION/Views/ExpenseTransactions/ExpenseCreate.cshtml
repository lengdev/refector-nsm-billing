            </div>

        </div>

    }

</div>

<script>
    var DataClass = @Html.Raw(ViewBag.DataClass);
    var DataPayee = `@Html.Raw(ViewBag.DataPayee)`;

    $(function () {
        $("#modal-defaultmodalbody, #modal-defaultmodalbody p").css({
            "padding": "0"
        });
        var $class = $("#ClassID");
        // Populate dropdown
        $class.empty();
        $class.append(new Option("", "", false, false));
        $.each(DataClass, function (index, item) {
            $class.append(
                new Option(item.ClassName, item.ClassID, false, false)
            );
        });
        // Initialize Select2
        $class.select2({
            placeholder: $class.data("placeholder"),
            allowClear: true,
            width: "100%"
        });


        var attachmentFiles = [];
        var maxFileSize = 10 * 1024 * 1024;

        var allowedExtensions = ["pdf", "jpg", "jpeg", "png"];

        function addFiles(fileList) {
            $.each(Array.from(fileList), function (_, file) {
                var extension = file.name.split(".").pop().toLowerCase();

                if ($.inArray(extension, allowedExtensions) === -1) {
                    alert("Unsupported file type: " + file.name);
                    return;
                }

                if (file.size > maxFileSize) {
                    alert(file.name + " exceeds the 10 MB limit.");
                    return;
                }

                // Avoid adding the same file twice.
                var duplicate = attachmentFiles.some(function (item) {
                    return item.name === file.name &&
                        item.size === file.size &&
                        item.lastModified === file.lastModified;
                });

                if (!duplicate) {
                    attachmentFiles.push(file);
                }
            });

            renderAttachments();
        }

        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + " B";
            if (bytes < 1024 * 1024)
                return (bytes / 1024).toFixed(1) + " KB";

            return (bytes / (1024 * 1024)).toFixed(2) + " MB";
        }

        function renderAttachments() {
            var $tbody = $("#attachmentTableBody");
            $tbody.empty();

            var totalSize = 0;

            if (attachmentFiles.length === 0) {
                $tbody.append(
                    '<tr id="noAttachmentRow">' +
                    '<td colspan="4" class="text-center py-4">' +
                    '<i class="bi bi-file-earmark fs-3 d-block text-muted"></i>' +
                    '<span class="text-muted">No files attached</span>' +
                    '</td>' +
                    '</tr>'
                );
            } else {
                $.each(attachmentFiles, function (index, file) {
                    totalSize += file.size;

                    var $row = $("<tr>");

                    $("<td>")
                        .text(index + 1)
                        .appendTo($row);

                    // File name with ellipsis
                    var $fileName = $("<div>", {
                        class: "text-ellipsis",
                        title: file.name
                    }).text(file.name);

                    $("<td>")
                        .append($fileName)
                        .appendTo($row);

                    $('<td class="text-nowrap">')
                        .text(formatFileSize(file.size))
                        .appendTo($row);

                    var $button = $("<button>", {
                        type: "button",
                        class: "attachment-delete",
                        title: "Remove attachment"
                    }).append(
                        $("<i>", { class: "bi bi-trash" })
                    );

                    $button.on("click", function () {
                        attachmentFiles.splice(index, 1);
                        renderAttachments();
                    });

                    $("<td>")
                        .addClass("text-center")
                        .append($button)
                        .appendTo($row);

                    $tbody.append($row);
                });
            }

            $("#attachmentCount").text(attachmentFiles.length);

            $("#attachmentTotalSize").text(
                attachmentFiles.length + " file(s) · " +
                formatFileSize(totalSize)
            );
        }

        $("#expenseAttachments").on("change", function () {
            addFiles(this.files);

            // Reset so the same file can be selected again.
            this.value = "";
        });

        var $dropzone = $("#attachmentDropzone");

        $dropzone.on("dragover", function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.addClass("drag-over");
        });

        $dropzone.on("dragleave", function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dropzone.removeClass("drag-over");
        });

        $dropzone.on("drop", function (e) {
            e.preventDefault();
            e.stopPropagation();

            $dropzone.removeClass("drag-over");

            var files = e.originalEvent.dataTransfer.files;
            addFiles(files);
        });

        // Expose selected files for your existing save handler.
        window.getExpenseAttachments = function () {
            return attachmentFiles.slice();
        };

        renderAttachments();
    });
</script>


<script>
    $(function () {
        PaymentDate_ApplyDatePicker();
        Reload_PayeeID();
    });
    function PaymentDate_ApplyDatePicker() {
        $("#PaymentDate").daterangepicker({
            drops: 'auto',
            showDropdowns: true,
            singleDatePicker: true,
            autoApply: true,
            parentEl: "body",
            locale: {
                format: 'DD/MM/YYYY'
            },
        });
        $("#PaymentDate").on('apply.daterangepicker', function (ev, picker) {
            $(this).val(picker.startDate.format('DD/MM/YYYY'));
        });
        $("#PaymentDate").on('cancel.daterangepicker', function (ev, picker) {
            $(this).val('');
        });
    }
</script>

<script>
    // Handle Add New button click
    $(document)
        .off("click", "#btnAddNewFooter")
        .on("click", "#btnAddNewFooter", function (e) {
            e.preventDefault();
            e.stopPropagation();
            AddNewPayee();
        });


    function Reload_PayeeID(index) {

        index = (typeof index === "undefined" ? "0" : index);

        PostData("DoActionData/ReturnSQLJson/", { SQL: DataPayee }, function (response) {

            var dataSource_PayeeID = JSON.parse(JSON.parse(response).Data);

            dataSource_PayeeID.forEach(function (item) {
                for (var key in item) {
                    if (typeof item[key] === "string") {
                        item[key] = $("<textarea/>").html(item[key]).text();
                    }
                }
            });

            $("#span_PayeeID").html(
                '<input style="width:100%" ' +
                'data-placeholder="Enter payee" ' +
                'id="PayeeID" ' +
                'name="PayeeID" ' +
                'data-validate="Payee is required." />'
            );

            $("#PayeeID").kendoMultiColumnComboBox({

                height: 350,

                filter: "contains",

                dataTextField: "Name",
                dataValueField: "PayeeID",

                dataSource: {
                    data: dataSource_PayeeID
                },

                change: function (e) {
                    // LoadVendorBankInfo();
                },

                footerTemplate: `
                <div style="padding:8px;text-align:center;">
                    <button type="button"
                            class="k-button k-primary"
                            id="btnAddNewFooter">
                        <i class="k-icon k-i-plus"></i>
                        Add New
                    </button>
                </div>
            `,

                columns: [
                    {
                        field: "Name",
                        title: "Name",
                        width: 550
                    },
                    {
                        field: "Type",
                        title: "Type",
                        width: 120
                    }
                ]
            });

            $("input[name='PayeeID_input']")
                .off("click.payee")
                .on("click.payee", function (e) {
                    e.preventDefault();

                    $(this)
                        .parent()
                        .find("button.k-input-button")
                        .trigger("click");
                });

        });
    }
    function AddNewPayee(ID) {
    var combo = $("#PayeeID").data("kendoMultiColumnComboBox");

    if (combo) {
        combo.close();
    }

        ID = (typeof ID == "undefined" ? 0 : ID);
        var Type = "AddNewVendor";
        var Title = "New Vendor";
        if (ID != 0) {
            Type = "EditVendor";
            Title = "Edit Vendor";
        }
        var URL = "AddVendor/CreateVendor?PrimaryFieldValue=" + ID + "&Type=" + Type;
        ShowDialogBox2(Title, "Auto", "", URL, ID, "DialogAddNewVendor", function() {
            $("#DialogAddNewVendor").on('hide.bs.modal', function () {
                Reload_PayeeID();
            });
        });
    }
</script>