                                    <tbody id="attachmentTableBody">
                                        <tr id="noAttachmentRow">
                                            <td colspan="4" class="text-center py-4">
                                                <i class="bi bi-file-earmark fs-3 d-block text-muted"></i>
                                                <span class="text-muted">
                                                    No files attached
                                                </span>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
