    function loadCustPrefix() {
        LoadData('AddCustomer/LoadCustPrefix', function (result) {
            var data = JSON.parse(result).data;
            data = JSON.parse(data);
            CustPrefix = data;
            $("#CustomerCode").typeahead({
                hint: true,
                highlight: true,
                minLength: 0
            },
                {
                    limit: 9999,
                    display: "Display",
                    source: function (query, cb) {
                        var filteredList = $.grep(data, function (item, index) {
                            return item;
                        });
                        mapped = $.map(filteredList, function (item) { return { Display: item.Display, PrefixID: item.PrefixID } });
                        cb(mapped);
                    },
                    templates: {
                        header: "<div class=\"tt-suggestion tt-selectable\"><a href=\"javascript:void(0);\" onclick=\"addnewPrefix('Customer');\">Add New Prefix</a></div>"
                    }
                }).bind("typeahead:selected", function (obj, data, name) {
                    $("#PrefixID").val(data.PrefixID);
                });
            $("#CustomerCode").on("click", function () {
                $("#CustomerCode").typeahead("open");
            });
        });
    }

