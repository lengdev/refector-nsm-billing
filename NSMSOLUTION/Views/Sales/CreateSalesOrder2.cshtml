    function loadCustomerType() {
        LoadData('AddCustomer/LoadCustType', function (result) {
            var DataTypeahead = JSON.parse(JSON.parse(result).data);
            CustomerTypeData = DataTypeahead;
            $("#CustomerType").typeahead({
                hint: true,
                highlight: true,
                minLength: 0
            },
                {
                    limit: 9999,
                    display: "Name",
                    source: function (query, cb) {
                        var matches = [];
                        $.each(DataTypeahead, function (i, str) {
                            const value = str.CustomerType;
                            const globalRegex = new RegExp(query, '\ig');
                            if (globalRegex.test(value)) {
                                matches.push({ Name: str.CustomerType, ID: str.CustomerTypeID });
                            }
                        });
                        cb(matches);
                    },
                    templates: {
                        header: "<div onclick=\"AddNewCustType();\" class=\"tt-suggestion tt-selectable\"><a href=\"javascript:void(0);\">Add New</a></div>"
                    }
                }).on("typeahead:change", function (aEvent, aSuggestion) {
                    if (aEvent.isDefaultPrevented()) return;
                    aEvent.preventDefault();
                    let data = (typeof DataTypeahead.filter(name => name.CustomerType === aSuggestion)[0] == "undefined" ? [] : DataTypeahead.filter(name => name.CustomerType === aSuggestion)[0]);
                    //.bind("typeahead:selected", function (obj, data, name) {
                    if (data) {
                        CustomerTypeID = data.CustomerTypeID;
                        $("#CustomerTypeID").val(CustomerTypeID);
                        //$(this).data("seletectedId", data.ID);
                        var Cust_Type = $("#CustomerType").val();
                        LoadData('AddCustomer/LoadCustTypePrefix?CustomerType=' + encodeURIComponent(Cust_Type), function (result) {
                            result = JSON.parse(JSON.parse(result).data)[0];
                            ChangeCustomerCode = result.PrefixNumber;
                            $("#CustomerCode").val(result.PrefixNumber);
                        });
                    }
                    else {
                        ChangeCustomerCode = "";
                        $("#CustomerTypeID").val("");
                        $("#CustomerCode").val("");
                    }
                }).on("focus", function (aEvent) {
                    if (aEvent.isDefaultPrevented()) return;
                    aEvent.preventDefault();
                    $(this).select();
                }).on("click", function () {
                    $("#CustomerType").typeahead("open");
                });
        });
    }



