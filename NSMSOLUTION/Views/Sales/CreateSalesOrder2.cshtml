            Swal.fire({
                position: 'top',
                title: 'Are you sure?',
                text: "Export this invoice to DMC you won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, do it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    ApplySaveChangeCustomerInfo();
                }
                else {
                    Swal.fire({
                        position: 'top',
