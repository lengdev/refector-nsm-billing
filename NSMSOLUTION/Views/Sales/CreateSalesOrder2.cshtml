    function SetTypeAheadGroup(ID, Name, SQL, FieldName, Value, TypeaheadGroupByField, DBField, HiddenFeild, DisplayOnFields, CallBackFunction) {
        CallBackFunction = (typeof CallBackFunction == 'undefined') ? "" : CallBackFunction;
        SQL = (typeof SQL == 'undefined') ? "" : SQL;
        FieldName = (typeof FieldName == 'undefined') ? "" : FieldName;
        Value = (typeof Value == 'undefined') ? "" : Value;
        TypeaheadGroupByField = (typeof TypeaheadGroupByField == 'undefined') ? "" : TypeaheadGroupByField;
        DBField = (typeof DBField == 'undefined') ? "" : DBField;
        HiddenFeild = (typeof HiddenFeild == 'undefined') ? "" : HiddenFeild;
        DisplayOnFields = (typeof DisplayOnFields == 'undefined') ? "" : DisplayOnFields;
        Name = (typeof Name == 'undefined') ? "" : Name;
        $("#" + ID + "").typeahead("destroy");
        $("#TypeAheadGroup_" + ID + "").remove();
        PostData("DoActionData/ReturnSQLJson/",
            {
                SQL: SQL, FieldName: FieldName, Value: Value,
                IsRender: "True",
                ID: "" + ID + "",
                TypeaheadGroupByField: TypeaheadGroupByField,
                DBField: DBField,
                DisplayOnFields: DisplayOnFields,
                HiddenFeild: HiddenFeild,
                Name: Name,
                CallBackFunction: CallBackFunction,
            }, function (response) {
                let row = '<div id="TypeAheadGroup_' + ID + '">';
                row += JSON.parse(response).Data;
                row += '</div>';
                $("#" + ID + "").parent().after(row);
                if (typeof CallBackFunction === 'function')
                    CallBackFunction();
            }, false);
    }

