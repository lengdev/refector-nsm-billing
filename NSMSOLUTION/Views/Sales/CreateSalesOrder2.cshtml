
@{
    Layout = null;
}
<style>
    .tt-menu{
        top: 20px !important;
    }
</style>
<section class="content" id="CustomerFormAgreement">
    <div class="" name="custFormAgreement" id="custFormAgreement">
        <div id="divHead" style="display:none">
            @*<div class="row">
                    <div class="col-12">
                        <div id="DivLogoCompany"></div>
                    </div>
                </div>*@
            <div class="row">
                <div class="col text-center" style="padding:20px 0 0 0">
                    <span style="font-family: 'Francois One','Bayon'; font-size: 30px" id="HeadKHTitle">
                        បែបបទចុះឈ្មោះប្រើប្រាស់សេវាកម្ម
                    </span>
                    <br />
                    <span class="text-center text-uppercase" style="font-family: 'Francois One','Bayon'; font-size: 28px" id="HeadENTitle">Services Registration Form</span>
                </div>
            </div>
        </div>
        <form id="frmcust" name="frmcust" class="khmerFont1 contact2-form validate-form" novalidate autocomplete="off">
            <div style="display:none">
                <input type="file" name="CustomerAttFiles" class="d-print-none" style="display: none; user-select: none; visibility: hidden;" />
                <input type="file" id="CustomerBankSlip" name="CustomerBankSlip" class="d-print-none" style="display: none; user-select: none; visibility: hidden;" />
            </div>
            <div class="row" id="divSaleInfo">
                <div class="col-sm-auto">
                    <label for="Employee" class="col-form-label khmerFont1">ភ្នាក់ងារលក់/Sale's Name:</label>
                </div>
                <div class="col-sm">
                    <div class="wrap-input2 validate-input" data-validate="Sale's Name is required">
                        <input type="text" class="input2 CustInfo" id="Employee" name="Employee">
                        <input type="hidden" class="input2 CustInfo" id="EmployeeID" name="EmployeeID">
                        <span class="focus-input2"></span>
                    </div>
                </div>
                <div class="col-sm-auto" name="div_ReferenceNo">
                    <label for="ReferenceNo" class="col-form-label khmerFont1">Reference No.:</label>
                </div>
                <div class="col-sm" name="div_ReferenceNo">
                    <div class="wrap-input2">
                        <input type="text" class="input2 CustInfo" id="ReferenceNo" name="ReferenceNo">
                        <span class="focus-input2"></span>
                    </div>
                </div>
                <div class="col-sm-auto" name="div_ClassName">
                    <label for="ClassName" class="col-form-label khmerFont1">Class Name:</label>
                </div>
                <div class="col-sm" name="div_ClassName">
                    <div class="wrap-input2 validate-input" data-validate="Class Name is required">
                        <input type="text" class="input2 CustInfo" id="ClassName" name="ClassName" />
                        <input type="hidden" class="input2 CustInfo" id="ClassNameID" name="ClassNameID" />
                        <span class="focus-input2"></span>
                    </div>
                </div>

                <div class="col-sm-auto" style="display:none">
                    <label for="CustomerAccount" class="col-form-label khmerFont1">លេខគណនី/Customer's Account:</label>
                </div>
                <div class="col-sm-2" style="display:none">
                    <div class="wrap-input2" data-validate="Customer's Account is required">
                        <input type="text" class="input2 CustInfo" id="CustomerAccount" name="CustomerAccount" />
                        @*onkeypress="validate(event);"*@
                        <span class="focus-input2"></span>
                        <div class="input-generateAccNo" title="Generate Customer's Account Number" data-validate="Generate Customer's Account Number" onclick="generateCustAcc();">
                            <i class="fa fa-sync"></i>
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-sm-auto" name="div_Location">
                    <label for="Warehouse" class="col-form-label khmerFont1">Location:</label>
                </div>
                <div class="col-sm-4" name="div_Location">
                    <div class="wrap-input2" data-validate="Location is required">
                        <input type="text" class="input2 CustInfo" id="Warehouse" name="Warehouse" />
                        <input type="hidden" class="input2 CustInfo" id="Warehouse_LocationID" name="Warehouse_LocationID" />
                        <span class="focus-input2"></span>
                    </div>
                </div>
                <div class="col-sm-auto d-none" name="div_CustomerGroup_label">
                    <label for="CustomerGroup" class="col-form-label khmerFont1">Customer Group:</label>
                </div>
                <div class="col-sm-auto d-none" name="div_CustomerGroup_data">
                    <div class="wrap-input2" data-validate="Customer Group is required">
                        <input type="text" class="input2 CustInfo" id="CustomerGroup" name="CustomerGroup" />
                        <input type="hidden" class="input2 CustInfo" id="CustomerGroupID" name="CustomerGroupID" />
                        <span class="focus-input2"></span>
                    </div>
                </div>
                <div class="col-sm-auto d-none" name="div_InvoiceNo">
                    <label for="CustomerInvoiceNo" class="col-form-label khmerFont1">Invoice No:</label>
                </div>
                <div class="col-sm-auto d-none" name="div_InvoiceNo">
                    <div class="wrap-input2">
                        <input type="text" class="input2 CustInfo" id="CustomerInvoiceNo" name="CustomerInvoiceNo" />
                        <span class="focus-input2"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12 p-0" style="border:solid 1px #808080">
                    <div class="form-content">
                        <div id="divCustomerInformation">
                            <div class="bg-gray-light" style="display:none">
                                <div class="">
                                    <h3 class="card-title text-uppercase">Order Type</h3>
                                </div>
                            </div>
                            <div class="form-group clearfix p-2" id="CustOrderType" style="display:none"></div>
                            <div style="background-color: #F89C39">
                                <div class="row">
                                    <div class="col-auto">
                                        <div class="">
                                            <h3 class="card-title khmerFont1-Header">ព័ត៌មានអតិថិជន / Customer Information</h3>
                                        </div>
                                    </div>
                                    <div class="col d-none">
                                        <div id="DivSetCID" class="khmerFont1-Header">
                                            <label for="SetCID">Save as to:</label>
                                            <select name="SetCID" id="SetCID">
                                                <option value="None VAT">None</option>
                                                <option value="VAT">TAX</option>
                                                <option value="CM">CM</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="p-2">
                                <div class="row">
                                    <div class="col-sm-auto">
                                        <label for="CustomerName" class="col-form-label khmerFont1">
                                            ឈ្មោះអតិថិជន/Customer Name:
                                        </label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2 validate-input" data-validate="Customer Name is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerName" name="CustomerName" />
                                            <input type="hidden" value="0" class="input2 CustInfo" id="CustomerID" name="CustomerID" />
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerType" class="col-form-label khmerFont1">
                                            ប្រភេទអតិថិជន/Customer Type:
                                        </label>
                                    </div>
                                    <div class="col-sm align-text-bottom">
                                        <input type="hidden" class="input2 CustInfo" id="CustomerType_ISVAT" name="CustomerType_ISVAT" value="false">
                                        <div class="wrap-input2" data-validate="Customer Type is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerType" name="CustomerType" readonly>
                                            <input type="hidden" class="input2 CustInfo" id="CustomerType_CustomerTypeID" name="CustomerType_CustomerTypeID">
                                            <input type="hidden" class="input2 CustInfo" id="CustomerType_PrefixVAT" name="CustomerType_PrefixVAT" value="0">
                                            <input type="hidden" class="input2 CustInfo" id="CustomerType_PrefixCM" name="CustomerType_PrefixCM" value="0">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto" name="CIDInfo">
                                        <label for="CustomerCode" class="col-form-label khmerFont1">
                                            លេខសម្គាល់/Customer Code:
                                        </label>
                                    </div>
                                    <div class="col-sm" name="CIDInfo">
                                        <div class="wrap-input2 validate-input" data-validate="Customer Code is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerCode" name="CustomerCode" readonly />
                                            @*<input type="hidden" class="input2 CustInfo" id="CustomerID" value="0" name="CustomerID" />*@
                                            <span class="focus-input2"></span>
                                            @*<input type="hidden" class="input2 CustInfo" id="PrefixID" name="PrefixID">*@
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerGender" class="col-form-label khmerFont1">ភេទ/Gender:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2" data-validate="Gender is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerGender" name="CustomerGender" readonly>
                                            <input type="hidden" class="input2 CustInfo" id="CustomerGenderID" name="CustomerGenderID">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-auto">
                                        <label for="CustomerAddress" class="col-form-label khmerFont1">អាសយដ្ឋាន/Address:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2" data-validate="Address is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerAddress" name="CustomerAddress" readonly>
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerCommune" class="col-form-label khmerFont1">សង្កាត់/Commune:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2" data-validate="Commune is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerCommune" name="CustomerCommune" readonly/>
                                            <input type="hidden" class="input2 CustInfo" id="CommuneID" name="CommuneID" value="" />
                                            <input type="hidden" class="input2 CustInfo" id="DistrictID" name="DistrictID" value="" />
                                            <input type="hidden" class="input2 CustInfo" id="ProvinceCityID" name="ProvinceCityID" value="" />
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerDistrict" class="col-form-label khmerFont1">ខណ្ឌ/District:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2" data-validate="District is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerDistrict" name="CustomerDistrict" readonly="readonly" />
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerProvinceCity" class="col-form-label khmerFont1">ខេត្ត/ក្រុង/Province/City:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2" data-validate="Province/City is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerProvinceCity" name="CustomerProvinceCity" readonly="readonly" />
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-sm-auto">
                                        <label for="CustomerMobile" class="col-form-label khmerFont1">ទូរស័ព្ទដៃ/H/P:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2 validate-input" data-validate="Hand Phone is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerMobile" name="CustomerMobile" readonly>
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerEmail" class="col-form-label khmerFont1">អ៊ីមែល/Email:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2">
                                            <input type="email" class="input2 CustInfo" id="CustomerEmail" name="CustomerEmail" readonly>
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto d-none">
                                        <label for="CustomerNationality" class="col-form-label khmerFont1">សញ្ជាតិ/Nationality:</label>
                                    </div>
                                    <div class="col-sm d-none">
                                        <div class="wrap-input2" data-validate="Nationality is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerNationality" name="CustomerNationality">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row d-none">
                                    <div class="col-sm-auto">
                                        <label for="CustomerIdentification" class="col-form-label khmerFont1">អត្តសញ្ញាណប័ណ្ណ/លិខិតឆ្លងដែន/Identification/Passport No:</label>
                                    </div>
                                    <div class="col">
                                        <div class="wrap-input2">
                                            <input type="text" class="input2 CustInfo" id="CustomerIdentification" name="CustomerIdentification">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto">
                                        <label for="CustomerContactName" class="col-form-label">ATT Name:</label>
                                    </div>
                                    <div class="col-sm">
                                        <div class="wrap-input2">
                                            <input type="text" class="input2 CustInfo" id="ATTName" name="ATTName">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto" style="display:none">
                                        <label for="CustomerContactName" class="col-form-label">Contact Name:</label>
                                    </div>
                                    <div class="col-sm" style="display:none">
                                        <div class="wrap-input2" data-validate="Contact Name is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerContactName" name="CustomerContactName">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto" style="display:none">
                                        <label for="CustomerContactMobileNumber" class="col-form-label">Contact Mobile Number:</label>
                                    </div>
                                    <div class="col-sm" style="display:none">
                                        <div class="wrap-input2" data-validate="Contact Mobile Number is required">
                                            <input type="text" class="input2 CustInfo" id="CustomerContactMobileNumber" name="CustomerContactMobileNumber">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                    <div class="col-sm-auto" style="display:none">
                                        <label for="CustomerContactEmail" class="col-form-label">Contact Email:</label>
                                    </div>
                                    <div class="col-sm" style="display:none">
                                        <div class="wrap-input2">
                                            <input type="email" class="input2 CustInfo" id="CustomerContactEmail" name="CustomerContactEmail">
                                            <span class="focus-input2"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="ShowCustomerBillingInformation" style="background-color: #F89C39" class="d-none">
                                <div style="border-bottom: 1px solid wheat;">
                                    <div class="row">
                                        <div class="col-auto">
                                            <h3 class="card-title khmerFont1-Header">ព័ត៌មានទូទាត់វិក្កយបត្រ / Customer Billing Information</h3>
                                        </div>
                                        <div class="col-auto" style="padding-top: 10px">
                                            <a class="text-white" href="javascript:void(0);">
                                                <i class="fa-solid fa-chevrons-down"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="divCustomerBillingInformation" class="d-none">
                                <div class="p-2">
                                    <div class="row">
                                        <div class="col-sm-auto">
                                            <label for="CompanyName" class="col-form-label khmerFont1">ឈ្មោះក្រុមហ៊ុន/Company Name:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="text" class="input2 CustInfo" id="CompanyName" name="CompanyName" />
                                                <input type="hidden" class="input2 CustInfo" id="CustomerBillInformationID" name="CustomerBillInformationID" />
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyNameKH" class="col-form-label khmerFont1">ឈ្មោះក្រុមហ៊ុនជាភាសាខ្មែរ/Company Name KH:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="text" class="input2 CustInfo" id="CompanyNameKH" name="CompanyNameKH">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-auto">
                                            <label for="CompanyDeskPhone" class="col-form-label khmerFont1">ទូរស័ព្ទលើតុ/Company Desk Phone:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="text" class="input2 CustInfo" id="CompanyDeskPhone" name="CompanyDeskPhone">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyMobile" class="col-form-label khmerFont1">ទូរស័ព្ទដៃ/Company H/P:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="text" class="input2 CustInfo" id="CompanyMobile" name="CompanyMobile">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyEmail" class="col-form-label khmerFont1">អ៊ីមែលទូទាត់វិក្កយបត្រ/Billing Email:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="email" class="input2 CustInfo" id="CompanyEmail" name="CompanyEmail">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-auto">
                                            <label for="VATNumber" class="col-form-label khmerFont1">លេខ VAT/VAT TIN:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2">
                                                <input type="text" class="input2 CustInfo" id="VATNumber" name="VATNumber">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="IndustryType" class="col-form-label khmerFont1">ប្រភេទអាជីវកម្ម/Business Type:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2" data-validate="Business Type is required">
                                                <input type="text" class="input2 CustInfo" id="IndustryType" name="IndustryType">
                                                <input type="hidden" class="input2 CustInfo" id="IndustryType_ID" name="IndustryType_ID">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-auto">
                                            <label for="CompanyAddress" class="col-form-label khmerFont1">អាសយដ្ឋានក្រុមហ៊ុន/Company Add.:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2" data-validate="Company Address is required">
                                                <input type="text" class="input2 CustInfo" id="CompanyAddress" name="CompanyAddress">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyCommune" class="col-form-label khmerFont1">សង្កាត់/Commune:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2" data-validate="Commune is required">
                                                <input type="text" class="input2 CustInfo" id="CompanyCommune" name="CompanyCommune">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyDistrict" class="col-form-label khmerFont1">ខណ្ឌ/District:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2" data-validate="District is required">
                                                <input type="text" class="input2 CustInfo" id="CompanyDistrict" name="CompanyDistrict">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                        <div class="col-sm-auto">
                                            <label for="CompanyProvinceCity" class="col-form-label khmerFont1">ខេត្ត/ក្រុង/Province/City:</label>
                                        </div>
                                        <div class="col-sm">
                                            <div class="wrap-input2" data-validate="Province/City is required">
                                                <input type="text" class="input2 CustInfo" id="CompanyProvinceCity" name="CompanyProvinceCity">
                                                <span class="focus-input2"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-12" style="background-color:papayawhip">
                                            <div class="row">
                                                <div class="col-sm-auto">
                                                    <label for="CompanyContactName" class="col-form-label khmerFont1">ឈ្មោះទំនាក់ទំនង/Contact Person:</label>
                                                </div>
                                                <div class="col-sm">
                                                    <div class="wrap-input2" data-validate="Company Contact Name is required">
                                                        <input type="text" class="input2 CustInfo" id="CompanyContactName" name="CompanyContactName">
                                                        <span class="focus-input2"></span>
                                                    </div>
                                                </div>
                                                <div class="col-sm-auto">
                                                    <label for="CompanyContactPosition" class="col-form-label khmerFont1">តំណែង/Position:</label>
                                                </div>
                                                <div class="col-sm">
                                                    <div class="wrap-input2">
                                                        <input type="text" class="input2 CustInfo" id="CompanyContactPosition" name="CompanyContactPosition">
                                                        <span class="focus-input2"></span>
                                                    </div>
                                                </div>
                                                <div class="col-sm-auto">
                                                    <label for="CompanyContactMobileNumber" class="col-form-label khmerFont1">លេខទំនាក់ទំនង/Contact Number:</label>
                                                </div>
                                                <div class="col-sm">
                                                    <div class="wrap-input2" data-validate="Contact Mobile Number is required">
                                                        <input type="text" class="input2 CustInfo" id="CompanyContactMobileNumber" name="CompanyContactMobileNumber">
                                                        <span class="focus-input2"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row" id="DivBillToAddress">
