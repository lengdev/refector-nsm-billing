                        icon: 'success'
                    });
                }
            });
        }
        else if (LocalInvoiceType == "Credit Notes") {
            SweetCofirmYesNoCancel("", "Yes, do it now.", "", function (rst) {
                CreditNoteComment = rst;
                ApplySaveChangeCustomerInfo();
            }, "", true);
            return false;
        }
        else {
            ApplySaveChangeCustomerInfo();
        }
    });
