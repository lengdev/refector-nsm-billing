    $("#SaveChange").click(function ()
    {
        return
        ShowPreviewInv = false;
        if ($("#CustomerID").val() == "")
            $("#CustomerID").val(0);
        CustomerID = $("#CustomerID").val();
        var TypeOfInvoice_Checked = $("input[name=TypeOfInvoice]:checked").val();
