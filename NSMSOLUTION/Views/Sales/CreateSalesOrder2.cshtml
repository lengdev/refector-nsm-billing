    function InvoiceToDMCTAX(Status) {
        Status = typeof Status == "undefined" ? false : Status;
        LoadData('AddCustomer/LoadUserApprovalForDMCTAX', function (response) {
            console.log(response); return
            var Data = JSON.parse(JSON.parse(response).Data)[0].Table;
            var row = '<label>Select Approval</label><div class="mb-3"><select class="rounded-0 rounded-start form-select" id="SelectCheckBy" name="SelectCheckBy">';
            row += '<option data-bind="Check By" value="0">Please choose check by</option>';
            $.each(Data, function (key, value) {
                row += '<option data-bind="' + value.TelegramUserName + '" value="' + value.UserLoginID + '">' + value.FullName + '</option>';
            });
            row += '</select></div>';
            row += '<div><select class="rounded-0 rounded-start form-select" id="SelectApproval" name="SelectApproval">';
            row += '<option data-bind="No Need Approval" value="0">No Need Approval</option>';
            $.each(Data, function (key, value) {
                row += '<option data-bind="' + value.TelegramUserName + '" value="' + value.UserLoginID + '">' + value.FullName + '</option>';
            });
            row += '</select></div>';
            DialogSweetCofirm(function () {
                var dtselect = $("#SelectApproval").select2('data')[0];
                var dtselectCheckBy = $("#SelectCheckBy").select2('data')[0];
                RequestCheckByNameID = dtselectCheckBy.id;
                var RequestApprovalTgUser = $(dtselect.element).attr("data-bind");
                var RequestApprovalNameID = dtselect.id;
                if (RequestApprovalNameID == 0) {
                    IsRequestApprovalSO = false;
                    IsNoNeedApproval = true;
                    IsNeedToCheckApproval = false;
                }
                if (RequestCheckByNameID != 0) {
                    IsNeedToCheckApproval = true;
                    IsRequestApprovalSO = false;
                    IsNoNeedApproval = false;
                }
                var RequestApprovalName = dtselect.text;
                if (FormStatus == "ToDMC") {
                    PostData("AddCustomer/RequestApproveInvToDMCTAX", {
                        InvoiceDate: $("#InvoiceDate").data('daterangepicker').startDate.format('YYYY-MM-DD'),
                        CustomerCode: CustomerCode,
                        CustomerName: encodeURIComponent($("#CustomerName").val()),
                        CustomerID: CustomerID,
                        InvoiceNo: InvoiceNo,
                        RequestApprovalTgUser: RequestApprovalTgUser,
                        RequestApprovalNameID: RequestApprovalNameID,
                        RequestApprovalName: RequestApprovalName,
                        RequestCheckByTgUser: $(dtselectCheckBy.element).attr("data-bind"),
                        RequestCheckByNameID: RequestCheckByNameID,
                        RequestCheckByName: dtselectCheckBy.text
                    }, function (response) {
                        var rst = JSON.parse(response);
                        if (rst.Result == 1) {
                            DialogSweetAlert("error", rst.Message);
                        }
                    });
                }
                if (Status) {
                    $("#CloseModal").click();
                    var fn = window['LoadCustomerServices'];
                    if (typeof fn != "undefined") {
                        if (typeof fn === "function") {
                            return fn(CustomerID);
                        }
                    }
                    else {
                        $("input[name=RD]").eq(0).click();
                        $("#CboSearchText").val(InvoiceNo);
                        $("#BunSearch").click();
                    }
                }
                else {
                    SaveAs = false;
                    ApplySaveChangeCustomerInfo(false, function (response) {
                        var rst = JSON.parse(response.InvoiceData)[0];
                        if (RequestApprovalNameID != 0 || RequestCheckByNameID != 0) {
                            PostData("AddCustomer/RequestApproveInvToDMCTAX", {
                                InvoiceDate: rst.InvoiceDate,
                                CustomerCode: rst.CustomerCode,
                                CustomerName: rst.CustomerName,
                                CustomerID: rst.CustomerID,
                                InvoiceNo: rst.InvoiceNo,
                                RequestApprovalTgUser: RequestApprovalTgUser,
                                RequestApprovalNameID: RequestApprovalNameID,
                                RequestApprovalName: RequestApprovalName,
                                RequestCheckByTgUser: $(dtselectCheckBy.element).attr("data-bind"),
                                RequestCheckByNameID: dtselectCheckBy.id,
                                RequestCheckByName: dtselectCheckBy.text
                            }, function (response) {
                                var rst = JSON.parse(response);
                                if (rst.Result == 1) {
                                    DialogSweetAlert("error", rst.Message);
                                }
                            }, false);
                        }
                        else {
