    function LoadCustInvoice(el) {
        const type = $(el).attr("aria-controls");
        Chart.unregister(ChartDataLabels);
        PreviewInvoice = (typeof PreviewInvoice == "undefined" ? "" : PreviewInvoice);
        LoadData(`Sales/LoadCustInvoice?ID=${CustomerID}&Type=${type}`, function (response) {
            $("#DivCustInvoice").empty();
            $("#showUnpaidInvoice").empty();
            $("#showPaidInvoice").empty();
            $("#showPartialInvoice").empty();
            if(type === "Invoice")
                $("#DivCustInvoice").html(JSON.parse(response).data);
            else if (type === "unpaid")
                $("#showUnpaidInvoice").html(JSON.parse(response).data);
            else if (type === "partial")
                $("#showPartialInvoice").html(JSON.parse(response).data);
            else if (type === "paid")
                $("#showPaidInvoice").html(JSON.parse(response).data);                

            LoadCustInfo(CustomerID);
            LoadCustomerServices(CustomerID);
            //LoadCustServices(CustomerID);
            if (ShowCustomerInvoiceProfile == "True") {
                //LoadCustomerBalance(CustomerID);
                LoadCustPieChart();
                showCustAlertInof(CustomerID);
            }
            document.addEventListener('click', function (e) {
                if (e.target.name == "APreviewInv") {
                    e.preventDefault();
                }
            });
            if (PreviewInvoice == 'loadpi')
                $("#SaleOrderInvoice-tab").click();
        });
    }
