        let CustomerBillInformationID = $("#CustomerBillInformationID_" + i).val();
        let CustomerInvoiceNo = $("#CustomerInvoiceNo_" + i).val();
        let CustomerID = $("#CustomerID_" + i).val();
        let CompanyName = $("#CompanyName_" + i).val();
        let CompanyNameKH = $("#CompanyNameKH_" + i).val();
        let CompanyDeskPhone = $("#CompanyDeskPhone_" + i).val();
        let CompanyMobile = $("#CompanyMobile_" + i).val();
        let CompanyEmail = $("#CompanyEmail_" + i).val();
        let VATNumber = $("#VATNumber_" + i).val();
        let IndustryTypeID = $("#IndustryTypeID_" + i).val();
        let ATTName = $("#ATTName_" + i).val();
        let CompanyAddress = $("#CompanyAddress_" + i).val();
        let CompanyCommune = $("#CompanyCommune_" + i).val();
        let CompanyDistrict = $("#CompanyDistrict_" + i).val();
        let CompanyProvinceCity = $("#CompanyProvinceCity_" + i).val();
        let CompanyContactName = $("#CompanyContactName_" + i).val();
        let CompanyContactPosition = $("#CompanyContactPosition_" + i).val();
        let CompanyContactMobileNumber = $("#CompanyContactMobileNumber_" + i).val();
        let BillToAddress = $("#BillToAddress_" + i).val();
        let BillToCommune = $("#BillToCommune_" + i).val();
        let BillToDistrict = $("#BillToDistrict_" + i).val();
        let BillToProvinceCity = $("#BillToProvinceCity_" + i).val();
        let InstallAddress = $("#InstallAddress_" + i).val();
        let InstallCommune = $("#InstallCommune_" + i).val();
        let InstallDistrict = $("#InstallDistrict_" + i).val();
        let InstallProvinceCity = $("#InstallProvinceCity_" + i).val();
        let GoogleMap_FullAddress = $("#GoogleMap_FullAddress_" + i).val();
        let GoogleMap_Latitude = $("#GoogleMap_Latitude_" + i).val();
        let GoogleMap_Longitude = $("#GoogleMap_Longitude_" + i).val();
        let obj = {};
        obj = {
            CustomerName: CustomerName,
            CustomerID: CustomerID,
            InvoiceNo: CustomerInvoiceNo,
            CustomerBillInformationID: CustomerBillInformationID,
            CompanyName: CompanyName,
            CompanyNameKH: CompanyNameKH,
            CompanyDeskPhone: CompanyDeskPhone,
            CompanyMobile: CompanyMobile,
            CompanyEmail: CompanyEmail,
            VATNumber: VATNumber,
            CompanyAddress: CompanyAddress,
            CompanyCommune: CompanyCommune,
            CompanyDistrict: CompanyDistrict,
            CompanyProvinceCity: CompanyProvinceCity,
            CompanyContactName: CompanyContactName,
            CompanyContactPosition: CompanyContactPosition,
            CompanyContactMobileNumber: CompanyContactMobileNumber,
            BillToAddress: BillToAddress,
            BillToCommune: BillToCommune,
            BillToDistrict: BillToDistrict,
            BillToProvinceCity: BillToProvinceCity,
            InstallAddress: InstallAddress,
            InstallCommune: InstallCommune,
            InstallDistrict: InstallDistrict,
            InstallProvinceCity: InstallProvinceCity,
            GoogleMap_FullAddress: GoogleMap_FullAddress,
            GoogleMap_Latitude: GoogleMap_Latitude,
            GoogleMap_Longitude: GoogleMap_Longitude,
            ATTName: ATTName, IndustryTypeID: IndustryTypeID
        };

        var URL = "/AddCustomer/SaveChangeCustomerBillInfo";
        var DATA = { CustomerBillData: JSON.stringify(obj) };
        DoSaveChangeData(URL, DATA, function (response) {
        });
    }
