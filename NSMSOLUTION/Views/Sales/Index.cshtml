    function CheckConnectivityStatus(CustomerID) {
        LoadData("CustomerProfile/CheckConnectivityStatus?CustomerID=" + CustomerID, function (response) {
            var data = JSON.parse(response).Data;
            data = JSON.parse(data);
            var UpgradeP = JSON.parse(response).UpgradeP;
            var row = '<div class="row"><div class="col">';
            row += '<div id="ConnectivityStatus" class="carousel slide" data-ride="carousel" data-bs-touch="true">';
            var row1 = '<ol class="carousel-indicators">';
            var row2 = '';
            $.each(data, function (key, val) {
                if (key == 0)
                    row1 += '<li data-target="#ConnectivityStatus" data-slide-to="0" class="active"></li>';
                else
                    row1 += '<li data-target="#ConnectivityStatus" data-slide-to="' + key + '"></li>';
                if (key == 0)
                    row2 += '<div class="carousel-item active" style="min-height:auto">';
                else
                    row2 += '<div class="carousel-item" style="min-height:auto">';
                row2 += '<div class="btn-group">';
                if (val.ConnectivityStatus == "40")
                    row2 += '<label class="btn bg-primary active text-uppercase">Status: ' + val.Status + '</label>';
                else
                    row2 += '<label class="btn bg-danger active text-uppercase">Status: ' + val.Status + '</label>';
                if (val.ConnectionType == "PPPoE") {
                    row2 += '<label class="btn bg-cyan">PPPoE User: ' + val.PPPoEUserName + '</label>';
                } else {
                    row2 += '<label class="btn bg-cyan">IP Address: ' + val.IPAddress + '</label>';
                }
                row2 += '</div>';
                if (val.ConnectionType != "PPPoE") {
                    row2 += '<div class="row"><div class="col">';
                    row2 += '<label class="col-form-label text-dark">Vlan Name: ' + val.VLanName + '</label>';
                    row2 += '</div></div>';
                }
                row2 += '</div>';
            });
            if (data.length == 0) {
                row1 += '<li data-target="#ConnectivityStatus" data-slide-to="0" class="active"></li>';
                row2 += '<div class="carousel-item active" style="min-height:auto">';
                row2 += '<div class="btn-group">';
                    row2 += '<label class="btn bg-danger active text-uppercase">Status: Inactive</label>';
                //row2 += '<label class="btn bg-cyan">Active Now</label>';
                row2 += '</div></div>';
            }
            row1 += '</ol>';
            //row += row1;
            row += '<div class="carousel-inner">';
            row += row2;
            row += '</div>';
            row += '</div>';
            row += '</div></div>';
            $("#divConnectivityStatus").html(row);
            $('#ConnectivityStatus').carousel({
                interval: 3000
            });

            if (UpgradeP != "[]" && UpgradeP != "") {
                UpgradeP = JSON.parse(UpgradeP);
                row = '<div class="row"><div class="col">';
                row += '<div id="UpdradeP" class="carousel slide" data-ride="carousel" data-bs-touch="true">';
                var row1 = '<ol class="carousel-indicators">';
                var row2 = '';
                $.each(UpgradeP, function (key, val) {
                    if (key == 0)
                        row1 += '<li data-target="#UpdradeP" data-slide-to="0" class="active"></li>';
                    else
                        row1 += '<li data-target="#UpdradeP" data-slide-to="' + key + '"></li>';
                    if (key == 0)
                        row2 += '<div class="carousel-item active" style="min-height:auto">';
                    else
                        row2 += '<div class="carousel-item" style="min-height:auto">';
                    row2 += val.NewPackageName;
                    row2 += '</div>';
                });
                if (data.length == 0) {
                    row1 += '<li data-target="#UpdradeP" data-slide-to="0" class="active"></li>';
                    row2 += '<div class="carousel-item active" style="min-height:auto">';
                    row2 += '<div class="btn-group">';
                    row2 += '<label class="btn bg-danger active text-uppercase">Status: Inactive</label>';
                    //row2 += '<label class="btn bg-cyan">Active Now</label>';
                    row2 += '</div></div>';
                }
                row1 += '</ol>';
                //row += row1;
                row += '<div class="carousel-inner">';
                row += row2;
                row += '</div>';
                row += '</div>';
                row += '</div></div>';
                $("#divConnectivityStatus").append(row);
                $('#UpdradeP').carousel({
                    interval: 3000
                });
            }
        });
    }

    function display_ct7() {
        var x = new Date()
        var ampm = x.getHours() >= 12 ? ' PM' : ' AM';
        hours = x.getHours() % 12;
        hours = hours ? hours : 12;
        hours = hours.toString().length == 1 ? 0 + hours.toString() : hours;

        var minutes = x.getMinutes().toString()
        minutes = minutes.length == 1 ? 0 + minutes : minutes;

        var seconds = x.getSeconds().toString()
        seconds = seconds.length == 1 ? 0 + seconds : seconds;

        var month = (x.getMonth() + 1).toString();
        month = month.length == 1 ? 0 + month : month;

        var dt = x.getDate().toString();
        dt = dt.length == 1 ? 0 + dt : dt;

        var x1 = dt + "/" + month + "/" + x.getFullYear();
        x1 = x1 + " - " + hours + ":" + minutes + ":" + seconds + " " + ampm;
        var elem = (typeof document.getElementById('ct7') == "undefined" ? "" : document.getElementById('ct7'));
        if (elem !== "" && elem !== null) {
            document.getElementById('ct7').innerHTML = x1;
            display_c7();
        }
    }
    function display_c7() {
        var refresh = 1000; // Refresh rate in milli seconds
        mytime = setTimeout('display_ct7()', refresh)
    }

