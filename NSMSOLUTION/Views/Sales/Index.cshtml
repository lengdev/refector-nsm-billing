    function LoadCustAttachmentFile(CustomerID, TypeFor) {
        TypeFor = typeof TypeFor == "undefined" ? "AttachmentFile" : TypeFor;
        LoadData("CustomerProfile/LoadCustAttachmentFile?ID=" + CustomerID + "&TypeFor=" + TypeFor, function (response) {
