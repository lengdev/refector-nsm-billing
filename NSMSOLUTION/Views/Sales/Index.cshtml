    function SetAutoLock(THIS, ActivateCustomerID, ConnectionOfConnectionID, InvoiceNo) {
        var msg = "Are you sure you want to turn Auto Lock off?";
        var setAutoLock = 0;
        if ($(THIS).val() === 'false') {
            setAutoLock = 1;
            msg = "Are you sure you want to turn Auto Lock on?";
        }
        DialogSweetCofirm(function () {
            PostData("CustomerProfile/SetAutoLockOnOff", {
                CustomerID: CustomerID,
                InvoiceNo: InvoiceNo,
                AutoLock: setAutoLock
            }, function (response) {

            });
        }, function () {
            if ($(THIS).val() === 'true') {
                $(THIS).prop("checked", true);
            }
            else
                $(THIS).prop("checked", false);
        }, msg, "Yes Do It Now");
    }

    function CustomerChangePlan(BillingInvoiceID, PackageDetailID, ConnectionID) {
        Customer_ID = (typeof Customer_ID == "undefined" ? "" : Customer_ID);
        if (Customer_ID == "") {
            var url = window.location.hash;
            var ID = url.substring(url.indexOf('?'));
            Customer_ID = ID.substring(ID.indexOf('=')).replace(/=/g, '');
        }
        //number 2 for create invoicing...
        var Data = [];
        var obj = {};
        obj = {
            PrimaryFieldValue: "2",
            InvoiceNo: "0",
            CustomerID: "" + Customer_ID + "",
            FormStatus: "CreateInvoice",
            ChangePlan: true,
            BillingInvoiceID: BillingInvoiceID,
            PackageDetailID: PackageDetailID,
            ConnectionID: ConnectionID
        };
        Data.push(obj);
        AddQuotation(obj, "Create Customer Invoice");
    }
