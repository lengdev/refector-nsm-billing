
@{
    Layout = null;
}
@Html.Raw(ViewBag.DrawHTMLForm)
@Html.Raw(ViewBag.AccountTypeGroup)
<script>
    var ItemName = "@ViewBag.ItemName";
    var ItemID = "@ViewBag.ItemID";
    var Clone = "@ViewBag.Clone";
    var Type = "@ViewBag.Type";
    var KVendorName = "@ViewBag.VendorName";
    var primaryFieldValue = "@ViewBag.PrimaryFieldValue";
    var saleNote = "@ViewBag.SaleNote";
    var quoteTermVAT = "";
    var quoteTermNonVAT = "";

    function setQuoteTermsConditions() {
        var classID = Number($('#ClassName_ClassID').val());
        if (!classID) {
            $("#TermsConditions").val("");
            return;
        }
        if ($('#NonVAT').is(':checked') || classID === 11) {
            $("#TermsConditions").val(quoteTermNonVAT);
        } else if ($('#IncludedVAT').is(':checked') || classID === 12) {
            $("#TermsConditions").val(quoteTermVAT);
        } else {
            $("#TermsConditions").val(quoteTermVAT || quoteTermNonVAT);
        }
    }

    function onChangeDisP(THIS) {
        let Index = $(THIS).closest("tr").index();
        let QTY = $("input[name=QTY]").eq(Index).val();
        QTY = (QTY == "" ? 0 : accounting.unformat(QTY));
        let UnitPrice = $("input[name=UnitPrice]").eq(Index).val();
        UnitPrice = (UnitPrice == "" ? 0 : accounting.unformat(UnitPrice));
        let Amount = (QTY * UnitPrice);
        let DisP = ($(THIS).val() == "" ? 0 : accounting.unformat($(THIS).val()));
        let DiscountUSD = ((Amount * DisP) / 100);
        $("input[name=DisUSD]").eq(Index).val(accounting.formatMoney(DiscountUSD, ''));
        TotalAll();
    }
    function onChangeDisUSD(THIS) {
        let DiscountUSD = ($(THIS).val() == "" ? 0 : accounting.unformat($(THIS).val()));
        let Index = $(THIS).closest("tr").index();
        let QTY = $("input[name=QTY]").eq(Index).val();
        QTY = (QTY == "" ? 0 : accounting.unformat(QTY));
        let UnitPrice = $("input[name=UnitPrice]").eq(Index).val();
        UnitPrice = (UnitPrice == "" ? 0 : accounting.unformat(UnitPrice));
        let Amount = (QTY * UnitPrice);
        let DiscountP = ((DiscountUSD / Amount) * 100);
        $("input[name=DisP]").eq(Index).val(accounting.formatMoney(DiscountP, ''));
        TotalAll();
    }
    $(function () {
        var $label = $('label[name="VAT"]');
        var $input = $('<input>', {
            type: 'text',
            name: 'VAT',
            class: 'input2 text-center text-bold',
            value: $label.text(),
            //onclick: 'this.select()',
            onchange: 'VATChangeHandler($(this).val())'
        });
        var td = $label.parent();
        // Replace the label with the input
        $label.replaceWith($input);
        var div = $('<div>', {
            class: 'wrap-input3'
        });
        td.append(div);
        div.append($input);
        div.append('<span class="focus-input2"></span>');

        $("#Tax, #Tax_Rate").change(function () {
            if ($(this).val() != "") {
                $("tr[name=trVAT] td label").first().html('ពន្ធបន្ថែម / ' + $("#Tax").val());
            }
            else {
                $("#Tax_Rate").val(0);
                $("tr[name=trVAT] td label").first().html('ពន្ធបន្ថែម / VAT 10%:');
                $("input[name=VAT]").html('0.00');
            }
            TotalAll();
        });

        $("input[name=TxtDisP], input[name=TxtDisUSD], input[name=TxtDeposit], input[name=TxtBalance]").autoNumeric({ vMin: '0.00' });

        $("input[name=TxtDisP], input[name=TxtDisUSD], input[name=TxtDeposit], input[name=TxtBalance]").on('focus', function () { $(this).select() });

        $("input[name=TxtDisP]").keyup(function () {
            var Amount = accounting.unformat($("label[name=Total]").html());
            var DisP = ($(this).val() == "" ? 0 : accounting.unformat($(this).val()));
            var DiscountUSD = ((Amount * DisP) / 100);
            $("input[name=TxtDisUSD]").val(accounting.formatMoney(DiscountUSD, ''));
            TotalAll();
        });
        $("input[name=TxtDisUSD]").keyup(function () {
            var DiscountUSD = ($(this).val() == "" ? 0 : accounting.unformat($(this).val()));
            var Amount = accounting.unformat($("label[name=Total]").html());
            var DiscountP = ((DiscountUSD / Amount) * 100);
            $("input[name=TxtDisP]").val(accounting.formatMoney(DiscountP, ''));
            TotalAll();
        });
        $("input[name=TxtDeposit]").keyup(function () {
            TotalAll();
        });

        $("#PaymentTerms_NumberofDays").bind("change", function (e) {
            var currentValue = $(this).val();
            var ApplyDueDate = '';
            if (currentValue != "Due on Receipt") {
                ApplyDueDate = moment(new Date()).add(currentValue, 'day');
                $("#PaymentDueDate").data('daterangepicker').setStartDate(ApplyDueDate);
            }
            else {
                ApplyDueDate = moment(new Date());
                $("#PaymentDueDate").data('daterangepicker').setStartDate(ApplyDueDate);
            }
        });

        $("#TxtStatusID").val("@ViewBag.StatusID");
        if ("@ViewBag.StatusID" == "60")
            $("#POStatus").val("0");

        if (Type == "NewPO") {
            if (ItemName != "" && ItemID != "") {
                setTimeout(function () {
                    $("input[name=ItemName]").val(ItemName).trigger("keydown");
                }, 500);
                setTimeout(function () {
                    $("ul.ui-autocomplete li").first().trigger("click");
                    $("input[name=ItemName]").blur();
                }, 1000);
            }
        }


        //is edit
        if (Clone != "True" && primaryFieldValue != 0) {
            $("input[name=PODate]").attr("disabled", true);
        }

        //Call back item info when change item
        $(document).on('change', "input[name='ItemStatus']", function () {
            var Index = $(this).closest("tr").index();
            var itemStatus = $(this).val();
            var tr = $(this).closest("tr");
            var ItemID = tr.find('input[name="ItemID"]').val();
            if (ItemID != "") {
                LoadData("Sales/LoadItemInfo?ItemID=" + ItemID + "&ItemStatus=" + itemStatus, function (response) {
                    var rst = JSON.parse(response).data;
                    rst = JSON.parse(rst);
                    $("textarea[name=ItemName_Description]").eq(Index).val(rst[0].ItemSize);
                    $("input[name=UM]").eq(Index).val(rst[0].UM);
                    $("input[name=UomID]").eq(Index).val(rst[0].UomID);
                    $("input[name=UnitPrice]").eq(Index).val(accounting.formatMoney(rst[0].SalePrice, ''));
                    tr.find("input[name='UomID']").trigger('change');
                    //Get um value after input change
                    var strUM = tr.find('input[name="UM"]').val();
                    if (strUM.includes("m2") || strUM.includes("M2")) {
                        tr.find('input[name="Dimension"]').prop('readonly', false);
                    }
                    TotalAll();
                });
            }
        });

        //When change uom
        $(document).on("change", "input[name='UomID']", function () {
            var tr = $(this).closest("tr");
            var strUM = tr.find('input[name="UM"]').val();
            if (strUM.includes("m2") || strUM.includes("M2")) {
                tr.find('input[name="Dimension"]').prop('readonly', false);
            } else {
                tr.find('input[name="Dimension"]').val('');
                tr.find('input[name="Dimension"]').prop('readonly', true);
            }
        });

        $(document).on("keyup", "input[name='Dimension']", function () {
            var tr = $(this).closest("tr");
            var strUM = tr.find('input[name="UM"]').val();

            if (strUM) {
                if (!(strUM.includes("m2") || strUM.includes("M2"))) {
                    DialogSweetAlert("error", "Allow only unit \"m2\"");
                    return;
                }
            } else {
                DialogSweetAlert("error", "Please select unit!");
                return;
            }

            const qtyM2 = calculateArea($(this).val());
            tr.find($('input[name="QTY"]')).val(accounting.toFixed(qtyM2, 3));
            TotalAll();
        });

        //Append Tax options
        $('#Customer_Notes').closest('div.row').before(`
            <div class="row mt-3 mb-4" id="divTypeOfInvoice">
                <div class="col-auto">
                    <div class="icheck-material-cyan icheck-inline">
                        <input type="checkbox" name="TypeOfInvoice" id="IncludedVAT" data-value="VAT">
                        <label for="IncludedVAT">Included VAT</label>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="icheck-material-cyan icheck-inline">
                        <input type="checkbox" name="TypeOfInvoice" id="CommercialINV" data-value="CM">
                        <label for="CommercialINV">Commercial Inv.</label>
                    </div>
                </div>
                <div class="col-auto">
                    <div class="icheck-material-cyan icheck-inline">
                        <input type="checkbox" name="TypeOfInvoice" id="NonVAT" data-value="NonVAT">
                        <label for="NonVAT">None VAT</label>
                    </div>
                </div>
            </div>
        `);

        //Click check box tax
        $(document).on('click', 'input[name="TypeOfInvoice"]', function () {
            const id = $(this).attr('id');
            // Uncheck all others first
            $('input[name="TypeOfInvoice"]').not(this).prop('checked', false).val(false);

            if ($(this).is(':checked')) {
                $(this).val(true);
            }

            if (id === 'NonVAT') {
                // None VAT — no VAT applied
            }

            setQuoteTermsConditions();
            TotalAll();
        });

        //Change class trigger tax
        $(document).on('typeahead:change', '#ClassName', function () { handleClassNameChange(true); });
        $('#ClassName_ClassID').on('change', function () {
            handleClassNameChange(true);
        });

        if (primaryFieldValue) {
            handleClassNameChange(false);
        }

        //Change attr for bank info
        $("#BankInfo").attr({
            id: "SaleNote",
            placeholder: "Sale Note",
            name: "SaleNote"
        }).siblings("label").attr({
            for: "SaleNote"
        }).html("Sale Note");

        if (primaryFieldValue) {
            $("textarea[name='SaleNote']").val(saleNote)
        }

        // Select the Terms & Conditions and Remark elements
        var remark = $('#Customer_Notes').closest('.row');
        var terms = $('#TermsConditions').closest('.row');
        //console.log(remark, terms)
        // Move Terms & Conditions above Remark
        terms.insertBefore(remark);

        //Load term & condition
        LoadData("Sales/LoadCompanyInfo", function (res) {
            const rst = JSON.parse(JSON.parse(res).data);
            if (rst.length == 0) return;

            quoteTermVAT = rst[0].QuoteTermConditionVAT ? decode(rst[0].QuoteTermConditionVAT) : (rst[0].TermConditionVAT ? decode(rst[0].TermConditionVAT) : '');
            quoteTermNonVAT = rst[0].QuoteTermConditionNonVAT ? decode(rst[0].QuoteTermConditionNonVAT) : (rst[0].TermConditionNonVAT ? decode(rst[0].TermConditionNonVAT) : '');

            if (!primaryFieldValue || primaryFieldValue == "0" || Clone == "True") {
                setQuoteTermsConditions();
            }
        });

        //Load exchange rate
        LoadData("Sales/LoadExchangeRate", function (res) {
            return false;
            const rst = JSON.parse(JSON.parse(res).data);
            if (rst.length == 0) return;
            $("#ExchangeRate").val(rst[0].ExchangeRate);
        });

        //setTimeout(function () {
        //    $('#ClassName_ClassID').trigger('change', true);
        //}, 300)
        //Remove sales_id is clone
        if (Clone == "True") {
            $("#SalesID").val('');
        }
    });
    function getPrefixNumber(classID) {
        const module = "Quote";
        setTimeout(function () {
            LoadData(`Sales/GetPrefixCallBack?ClassID=${classID}&Module=${module}`, function (res) {
                const rst = JSON.parse(JSON.parse(res).data);
                //console.log(rst, rst[0].PrefixNumber)
                $("#QuoteNumber").val(rst[0].PrefixNumber);
                $("#PrefixQuote").val(rst[0].Prefix);
            });
        }, 100);
    }

    function handleClassNameChange(isManual = true) {
        const classID = Number($('#ClassName_ClassID').val());

        $('#IncludedVAT, #CommercialINV, #NonVAT').prop('checked', false).val(false);

        if (classID === 12) { // BS Co.,Ltd — Included VAT
            $('#IncludedVAT').prop('checked', true).val(true);
            $('#CommercialINV').val(false);
            $('#NonVAT').prop('disabled', true);
            $('#IncludedVAT, #CommercialINV').prop('disabled', false);
        }
        else if (classID === 11) { // None VAT
            $('#NonVAT').prop('checked', true).val(true);
            $('#IncludedVAT, #CommercialINV').val(false);
            $('#NonVAT').prop('disabled', false);
            $('#IncludedVAT, #CommercialINV').prop('disabled', true);
        }
        else if (classID === 10) { // Default
            $('#IncludedVAT, #CommercialINV, #NonVAT').val(false);
        }
        else if (classID === '') {
            $('#CommercialINV').prop('checked', false);
            $('#IncludedVAT').prop('checked', false);
        }

        if (isManual && (!primaryFieldValue || primaryFieldValue == "0" || Clone == "True")) {
            setQuoteTermsConditions();
        }

        if (Clone == "True") {
            getPrefixNumber(classID);
        }

        TotalAll();
    }

    function VAT() {
        var SubTotal = accounting.unformat($("label[name=SubTotal]").html());
        var VAT = 0;
        var Total = 0;
        if ($('#IncludedVAT').is(':checked'))
            VAT = (SubTotal * 10) / 100;
        $("input[name=VAT]").val(accounting.formatMoney(VAT, ''));
        Total = (SubTotal + VAT);
        $("label[name=Total]").html(accounting.formatMoney(Total, ''));
        //DisP(); DisUSD();
        //TotalAll(); // REMOVED TO PREVENT RECURSION
        return Total;
    }
    //function getPrefixNumber(ClassID, ClassName) {
    //    if (ClassID) {
    //        LoadData('Sales/LoadPrefix?ClassID=' + ClassID + '&ClassName=' + encodeURIComponent(ClassName), function (result) {
    //            result = JSON.parse(JSON.parse(result).data)[0];
    //            $("#InvoiceNumber").val(result.PrefixNumber);
    //        });
    //    }
    //}

    function AmountKeyup(THIS) {
        var SubTotal = 0;// $(THIS).val();
        $("input[name=ItemName]").each(function (i) {
            if ($("input[name=ItemName]").eq(i).val() != "" && $("input[name=Amount]").eq(i).val() != "") {
                SubTotal += accounting.unformat($("input[name=Amount]").eq(i).val());
            }
        });
        $("label[name=SubTotal]").html(accounting.formatNumber(SubTotal, 2));
        var Rate = ($("#Tax_Rate").val() == "" ? 0 : $("#Tax_Rate").val());
        Rate = (Rate == "" ? 0 : accounting.unformat(Rate));
        //var VAT = //$("label[name=VAT]").html();
        var Total = accounting.unformat(SubTotal);
        //if (Rate != 0) {
        var VAT = ((accounting.unformat(SubTotal) * Rate) / 100);
        $("input[name=VAT]").val(accounting.formatNumber(VAT, 2));
        Total += accounting.unformat(VAT);
        //console.log(Total);
        //}
        Total = accounting.unformat($("label[name=SubTotal]").html()) + accounting.unformat($("input[name=VAT]").val());

        $("label[name=Total]").html(accounting.formatNumber(Total, 2));
        var TxtDisUSD = $("input[name=TxtDisUSD]").val();
        TxtDisUSD = (TxtDisUSD == "" ? 0 : accounting.unformat(TxtDisUSD));
        var GrandTotal = accounting.unformat(Total) - TxtDisUSD;
        $("label[name=GrandTotal]").html(accounting.formatNumber(GrandTotal, 2));

        let Deposit = accounting.unformat($("input[name=TxtDeposit]").val());
        let Balance = GrandTotal - Deposit;
        $("input[name=TxtBalance]").val(accounting.formatNumber(Balance, 2));

        var cutext = $("#Currency").val();
        var ex = $("#TxtExchangeRate").val();
        if (ex != "" && cutext != "") {
            $("tr[name=TRTotalAS]").show();
            $("label[name=LBLTotalAS]").html('សរុបជា ' + cutext + ' / Total​ As ' + cutext + ':');
            var GrandTotal = accounting.unformat($("label[name=GrandTotal]").html());
            GrandTotal = parseFloat(GrandTotal) * accounting.unformat(ex);
            $("label[name=TotalAS]").html(accounting.formatNumber(GrandTotal, 2));
        }
        else {
            $("tr[name=TRTotalAS]").hide();
        }
    }

    function VATChangeHandler(vatAmt) {
        var Total = accounting.unformat($("label[name=SubTotal]").html()) + accounting.unformat(vatAmt);
        $("label[name=Total]").html(accounting.formatNumber(Total, 2));
        var TxtDisUSD = $("input[name=TxtDisUSD]").val();
        TxtDisUSD = (TxtDisUSD == "" ? 0 : accounting.unformat(TxtDisUSD));
        var GrandTotal = accounting.unformat(Total) - TxtDisUSD;
        $("label[name=GrandTotal]").html(accounting.formatNumber(GrandTotal, 2));
    }

    function TotalAll() {
        return new Promise(resolve => {
            setTimeout(function () {
                var SubTotal = 0;
                $("input[name=ItemName]").each(function (i) {
                    var QTY = $("input[name=QTY]").eq(i).val();
                    QTY = (QTY == "" ? 0 : accounting.unformat(QTY));
                    var UnitPrice = $("input[name=UnitPrice]").eq(i).val();
                    UnitPrice = (UnitPrice == "" ? 0 : accounting.unformat(UnitPrice));
                    var Amount = (QTY * UnitPrice);
                    var DisUSD = $("input[name=DisUSD]").eq(i).val();
                    DisUSD = (DisUSD == "" ? 0 : accounting.unformat(DisUSD));
                    Amount = Amount - DisUSD;
                    $("input[name=Amount]").eq(i).val(accounting.toFixed(Amount, 2));
                    SubTotal += Amount;
                });

                $("label[name=SubTotal]").html(accounting.formatNumber(SubTotal, 2));
                var Rate = ($("#Tax_Rate").val() == "" ? 0 : $("#Tax_Rate").val());
                Rate = (Rate == "" ? 0 : accounting.unformat(Rate));
                //var VAT = //$("label[name=VAT]").html();
                //var Total = accounting.unformat(SubTotal);
                //if (Rate != 0) {
                //var VAT = ((accounting.unformat(SubTotal) * Rate) / 100);
                //$("input[name=VAT]").val(accounting.formatNumber(VAT, 2));
                var Total = VAT();
                //Total += accounting.unformat(VAT);
                //Total = accounting.unformat($("label[name=SubTotal]").html()) + accounting.unformat($("input[name=VAT]").val());
                //}
                //$("label[name=Total]").html(accounting.formatNumber(Total, 2));
                var TxtDisUSD = $("input[name=TxtDisUSD]").val();
                TxtDisUSD = (TxtDisUSD == "" ? 0 : accounting.unformat(TxtDisUSD));
                var GrandTotal = accounting.unformat(Total) - TxtDisUSD;
                $("label[name=GrandTotal]").html(accounting.formatNumber(GrandTotal, 2));

                let Deposit = accounting.unformat($("input[name=TxtDeposit]").val());
                let Balance = GrandTotal - Deposit;
                $("input[name=TxtBalance]").val(accounting.formatNumber(Balance, 2));

                var cutext = $("#Currency").val();
                var ex = $("#TxtExchangeRate").val();
                if (ex != "" && cutext != "") {
                    $("tr[name=TRTotalAS]").show();
                    $("label[name=LBLTotalAS]").html('សរុបជា ' + cutext + ' / Total​ As ' + cutext + ':');
                    var GrandTotal = accounting.unformat($("label[name=GrandTotal]").html());
                    GrandTotal = parseFloat(GrandTotal) * accounting.unformat(ex);
                    $("label[name=TotalAS]").html(accounting.formatNumber(GrandTotal, 2));
                }
                else {
                    $("tr[name=TRTotalAS]").hide();
                }
                resolve();
            }, 10);
        });
    }

    function calculateArea(expression) {
        try {
            //Remove invalid characters
            const regexExp = expression.replace(/[^0-9.*]/g, "");
            //Remove trailing operators (e.g. *)
            const sequence = regexExp.replace(/[*\/]+$/, "");
            if (sequence) {
                const result = eval(sequence);
                return result.toFixed(4);
            }
            return "1.000";
        } catch (error) {
            DialogSweetAlert("error", error);
        }
    }

    function SaveChangeCallbackFunction(response) {
        let data = JSON.parse(response.Data)[0];
        PostData("Sales/SendNotificationToTelegram", { SalesID: data.SalesID });
    }
  
    function getDateEdit(response) {
        setTimeout(function () {
            var classID = $('#ClassName_ClassID').val();
            if (classID) {
                $('#ClassName_ClassID').trigger("change");
            }
            if (primaryFieldValue && primaryFieldValue != "0") {
                $("textarea[name='SaleNote']").val(saleNote);
            }
            TotalAll();
        }, 300);
    }
</script>
