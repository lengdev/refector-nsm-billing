<script>
    var keyupTimer = "";
    $(function () {
        SetAutoComplete("keyword", "@ViewBag.AutoCompleteSQL", "ItemID");
        $("#back-to-top").hide();
        $('#CboCategories').prepend('<option selected=""></option>').select2({
            placeholder: "All Categories",
            allowClear: true,
            //containerCssClass: "form-control form-control-lg myselectcontrol"
        }).on("change", function () {
            if ($(this).val() != "") {
                $(".showItemDetail").html("");
                filterProducts();
            }
            else {
                if ($("#keyword").val() == "" && $("#CboItemBrand").val() == "") {
                    $(".showItemDetail").html("");
                } else {
                    filterProducts();
                }
            }

        });
        $('#CboItemBrand').prepend('<option selected=""></option>').select2({
            placeholder: "All Brands",
            allowClear: true,
            //containerCssClass: "form-control form-control-lg myselectcontrol"
        }).on("change", function () {
            if ($(this).val() != "") {
                $(".showItemDetail").html("");
                filterProducts();
            }
            else {
                if ($("#keyword").val() == "" && $("#CboCategories").val() == "") {
                    $(".showItemDetail").html("");
                } else {
                    filterProducts();
                }
            }
        });
        //$('#CboCategories').data('select2').$container.addClass('error')
        //$('#CboCategories').data('select2').$container.removeClass('form-control')
        //$('#CboCategories')//form-control form-control-lg
        //filterProducts();

        $("#keyword").on("keyup", function (event) {
            var isPressEnter = false;
            if ($(this).val() != "")
                $("#btnClear").show();
            else
                $("#btnClear").hide();
            //clearTimeout(keyupTimer);
            //keyupTimer = setTimeout(function () {
            if (event.which == 13) {

                isPressEnter = true;
                if ($(this).val() != "") {
                    filterProducts(isPressEnter);
                }
                //LoadItemDetail();
            }
            //}, 500);
        });
        $("#btnClear").click(function () {
            $(this).hide();
            $("#ItemID").val("0");
            $("#keyword").val("").focus();
            if ($("#CboCategories").val() == "") {
                $(".showItemDetail").html("");
            } else {
                filterProducts()
            }
        });

        $("#btnClearAll").click(function () {
            $(".showItemDetail").html("");
            $('#CboCategories, #CboItemBrand').val(null).trigger('change');
            $(".totalQOH").addClass('d-none');
        });

        //Scroll fix total stock on hand
        const totalQOHElement = document.querySelector('.totalQOH');
        const originalPosition = totalQOHElement.getBoundingClientRect().top + window.scrollY;
        const elementHeight = totalQOHElement.offsetHeight;
        totalQOHElement.style.transition = 'all 0.3s ease-in-out';
        window.addEventListener('scroll', function () {
            if (window.scrollY > originalPosition) {
                totalQOHElement.style.position = 'fixed';
                totalQOHElement.style.top = '67px';
                totalQOHElement.style.width = 'auto';
                totalQOHElement.style.zIndex = '1000';
                totalQOHElement.style.backgroundColor = 'rgb(15 23 42)';
                totalQOHElement.style.color = 'rgb(203 213 225)';
            } else {
                totalQOHElement.style.position = 'static';
                totalQOHElement.style.top = 'auto';
                totalQOHElement.style.left = 'auto';
                totalQOHElement.style.width = 'auto';
                totalQOHElement.style.zIndex = 'auto';
                totalQOHElement.style.backgroundColor = 'rgb(240 253 244)';
                totalQOHElement.style.color = 'rgb(0, 216, 82)';
            }
        });

        //Scroll to top
        const scrollToTopBtn = document.getElementById('scrollToTopBtn');
        // Scroll functionality
        window.addEventListener('scroll', function () {
            if (window.scrollY > 300) {
                scrollToTopBtn.classList.add('show');
            } else {
                scrollToTopBtn.classList.remove('show');
            }
        });

        // Click event to scroll to top
        scrollToTopBtn.addEventListener('click', function () {
            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        // JavaScript for zoom effect
        $(document).on("mousemove", "#mainImage", function (e) {
            const $zoomResult = $("#zoomResult");
            const $mainImage = $(this);
            const $zoomLens = $mainImage.siblings(".zoom-lens");
            // Get image offset relative to document
            const offset = $mainImage.offset();
            const width = $mainImage.width();
            const height = $mainImage.height();
            const x = e.pageX - offset.left;
            const y = e.pageY - offset.top;

            // Calculate lens position (relative to image)
            const lensWidth = $zoomLens.outerWidth();
            const lensHeight = $zoomLens.outerHeight();
            let lensX = x - lensWidth / 2;
            let lensY = y - lensHeight / 2;

            // Clamp lens position within image
            lensX = Math.max(0, Math.min(lensX, width - lensWidth));
            lensY = Math.max(0, Math.min(lensY, height - lensHeight));

            // Position the lens absolutely over the image, relative to image container
            $zoomLens.css({
                left: lensX + "px",
                top: lensY + "px",
                width: lensWidth + "px",
                height: lensHeight + "px",
                display: "block",
                position: "absolute",
                zIndex: 1001,
                pointerEvents: "none"
            });

            // Calculate zoom ratio (how much bigger the background is)
            const zoomRatioX = $zoomResult.outerWidth() / lensWidth;
            const zoomRatioY = $zoomResult.outerHeight() / lensHeight;

            // Apply zoom effect
            $zoomResult.css({
                "background-image": `url('${$mainImage.attr("src")}')`,
                "background-size": `${width * zoomRatioX}px ${height * zoomRatioY}px`,
                "background-position": `-${lensX * zoomRatioX}px -${lensY * zoomRatioY}px`,
                "display": "block",
                "z-index": 1000
            })
        });

        $(document).on("mouseleave", "#mainImage", function () {
            $("#zoomResult").css({
                backgroundImage: "none",
                display: "none"
            });
            $(this).siblings(".zoom-lens").css("display", "none");
        });

    });

    //function LoadItemDetail() {
    //    var ItemID = $("#ItemID").val();
    //    //console.log(ItemID);
    //    LoadData("Items/LoadItemDetail?ItemID=" + ItemID, function (response) {
    //        var Table = JSON.parse(response).Table;
    //        //console.log(Table);
    //    });
    //}

    function totalStockOnHandByWarehouse(items) {
        let warehouseStockMap = {};
        let strTotalQOH = '';
        const seenCombinations = new Set();
        //Sum stock by unique (ItemID + WarehouseName)
        $.each(items, function (index, item) {
            const warehouse = item.WarehouseName;
            const serialNumber = item.SerialNumber;
            const stock = item.TotalStock || 0;
            const itemID = item.ItemID || '';

            //Skip if warehouse is not defined
            if (!warehouse) return;

            const comboKey = `${itemID}::${warehouse}::${serialNumber}`;
            if (!seenCombinations.has(comboKey)) {
                seenCombinations.add(comboKey);

                // Initialize warehouse if not exists
                if (!warehouseStockMap[warehouse]) {
                    warehouseStockMap[warehouse] = {};
                }

                // Initialize serial number if not exists
                if (!warehouseStockMap[warehouse][serialNumber]) {
                    warehouseStockMap[warehouse][serialNumber] = 0;
                }

                warehouseStockMap[warehouse][serialNumber] += stock;
            }
        });
        //Total stock pills by warehouse
        const arrWstock = Object.entries(warehouseStockMap);
        const sorted = Object.fromEntries(arrWstock.sort());
        $.each(sorted, function (warehouse, totalStock) {
            const arrQty = Object.values(totalStock);
            strTotalQOH += `<div class="pills">${warehouse}: <span class="text-danger">
                ${arrQty.reduce((a, b) => a + b, 0)}
            </span></div>&nbsp;`;
        });
        $("#totalQOH").html(strTotalQOH);
    }

    function filterProducts(isPressEnter) {
        var ItemID = $("#ItemID").val();
        var keyword = $("#keyword").val();
        var Categories = $("#CboCategories").val();
        var ItemBrand = $("#CboItemBrand").val();
        var ServerRoot = location.protocol + '//' + location.host + "/";
        var noimg = ServerRoot + "Content/images/placeholder.jpg";
        var html = '';

        function LoadData(url, callback) {
            $.ajax({
                type: "GET",
                url: ServerRoot + url,
                dataType: 'json',
                beforeSend: function () {
                    $("#loading").removeClass('d-none');
                },
                success: callback,
                error: function (xhr, status, error) {
                    console.error("Failed to load data:", status, error);
                }
            });
        }

        // Main function to load and process data
        LoadData(`Items/filterProducts?keyword=${keyword}&Categories=${Categories}&ItemBrand=${ItemBrand}`, async function (response) {
            let { Table: items } = response;
            if (items.length === 0) {
                DialogSweetAlert("error", "No item found!");
                $("#loading").addClass('d-none');
                $("#keyword").select();
                return;
            }
            const expBarcode = items.filter(item => item.ExpBarcode === keyword);
            if (expBarcode.length > 0) {
                items = expBarcode;
            }
            let cardItem = '';
            //console.log(Categories)
            const seenItemsId = new Set();
            const seenItemsSerialNumber = new Set();
            totalStockOnHandByWarehouse(items);
            //Filter unique items for card rendering
            const uniqueItems = items.filter(item => {
                if (seenItemsId.has(item.ItemID) && seenItemsSerialNumber.has(item.SerialNumber)) return false;
                seenItemsId.add(item.ItemID);
                seenItemsSerialNumber.add(item.SerialNumber);
                return true;
            });

            //Generate cards
            $.each(uniqueItems, (index, item) => {
                cardItem += generateItemCard(items, item);
            });

            //Render
            renderCardShow(cardItem, keyword, Categories);
            $("#loading").addClass('d-none');
            $(".totalQOH").removeClass('d-none');
            $(document).on('click', '.remove-item-card', function () {
                var itemID = $(this).data('item');
                // Remove the card
                $(this).closest(`.item-id_${itemID}`).remove();
                if ($(".showItemDetail").children().length === 0) {
                    $(".totalQOH").addClass('d-none');
                }
                items = items.filter(i => i.ItemID !== itemID);
                totalStockOnHandByWarehouse(items);
            });
        });

        function generateItemCard(allItems, item) {
            const itemImages = item.ItemImage || '';
            const itemUM = item.UM || '';

            const images = itemImages ? itemImages.split('~') : [];
            const units = itemUM ? itemUM.split(',') : [];

            const seenWarehouse = new Set();
            const qtyByWarehouse =
                allItems.filter(i => i.ItemID === item.ItemID && i.WarehouseName)
                    .filter(function (obj) {
                        const key = JSON.stringify(obj.WarehouseName);
                        return seenWarehouse.has(key) ? false : seenWarehouse.add(key);
                    });

            const totalQtyIn = qtyByWarehouse.reduce((sum, i) => sum + (i.QTYIN || 0), 0);
            const totalQtyOut = qtyByWarehouse.reduce((sum, i) => sum + (i.QTYOUT || 0), 0);
            const totalStockOnHand = qtyByWarehouse.reduce((sum, i) => sum + (i.StockOnHand || 0), 0);

            // ====== Qty by ExpireDate with Summation ======
            const qtyByExpireDateMap = {};

            allItems.forEach(i => {
                if (i.ItemID === item.ItemID && i.ExpireDate) {
                    const key = i.ExpireDate;
                    if (!qtyByExpireDateMap[key]) {
                        qtyByExpireDateMap[key] = {
                            ExpireDate: key,
                            ExpBarcode: i.ExpBarcode || '',
                            QTYIN: 0,
                            QTYOUT: 0,
                            StockOnHand: 0
                        };
                    }
                    qtyByExpireDateMap[key].QTYIN += i.ExpQTYIN || 0;
                    qtyByExpireDateMap[key].QTYOUT += i.ExpQTYOUT || 0;
                    qtyByExpireDateMap[key].StockOnHand += i.ExpStockOnHand || 0;
                }
            });

            // Convert map to array
            const qtyByExpireDate = Object.values(qtyByExpireDateMap);

            return `
            <div class="card item-card item-id_${item.ItemID}" style="border-bottom: 5px solid #FF5D5D; color:#000;border-radius: 1rem;">
                <div class="row card-body relative" style="padding:2rem;">
                    <span>
                        <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="currentColor"  class="icon icon-tabler icons-tabler-filled icon-tabler-square-x remove-item-card" data-item="${item.ItemID}"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 2h-14a3 3 0 0 0 -3 3v14a3 3 0 0 0 3 3h14a3 3 0 0 0 3 -3v-14a3 3 0 0 0 -3 -3zm-9.387 6.21l.094 .083l2.293 2.292l2.293 -2.292a1 1 0 0 1 1.497 1.32l-.083 .094l-2.292 2.293l2.292 2.293a1 1 0 0 1 -1.32 1.497l-.094 -.083l-2.293 -2.292l-2.293 2.292a1 1 0 0 1 -1.497 -1.32l.083 -.094l2.292 -2.293l-2.292 -2.293a1 1 0 0 1 1.32 -1.497z" /></svg>
                    </span>
                    <div class="col-6 col-md-3">
                        <div id="div_show_product">
                            <div class="row">
                                <div class="col">
                                    <div class="card">
                                        <a href="${images.length > 0 ? `Uploads/Items/${images[0]}` : `javascript:void(0)`}" data-toggle="lightbox" data-max-width="800" class="img-hover-zoom--colorize zoom-container">
                                            <img class="main-image" loading="lazy" id="mainImage" style="height: 330px; width: 100%; object-fit:cover" src="${images.length > 0 ? `Uploads/Items/${images[0]}` : ``}" onerror="this.onerror=null;this.src='${noimg}';">
                                            <div class="zoom-lens"></div>
                                        </a>
                                        <div class="thumbnails">
                                            ${images.length > 0 ? images.map((img) =>
                `<div class="img-box">
                                                    <img class="thumbnail" loading="lazy" src="Uploads/Items/${img}" onclick="changeImage(this)" onerror="this.onerror=null;this.src='${noimg}';"/>
                                                </div>`).join('')
                    : `<div class="img-box"><img class="thumbnail" loading="lazy" src="" onclick="changeImage(this)" onerror="this.onerror=null;this.src='${noimg}';"/></div>`
                }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-md-9">
                        <div class="card">
                        <input type="hidden" class="form-control qtyQoh" value="${item.StockOnHand}"/>
                            <div class="card-header d-flex align-items-center text-white" style="background: #2561e6;gap: 8px;">
                                <span>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-list-details"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M13 5h8" /><path d="M13 9h5" /><path d="M13 15h8" /><path d="M13 19h5" /><path d="M3 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /><path d="M3 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" /></svg>
                                </span>
                                <h4 class="card-title text-uppercase" style="font-size: 18px; font-weight: 800">Item Detail Information</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col col-md-6 detail">
                                        <div><label>Item Name:</label> <a href="${ServerRoot}#!/ItemProfile?ID=${item.ItemID}" class="text-primary" target="_blank">${item.ItemName}</a></div>
                                        <div><label>Code:</label> ${item.ItemCode || ``}</div>
                                        <div><label>Barcode:</label> ${item.Barcode || ``}</div>
                                        <div><label>Size:</label> ${item.ItemSize || ``}</div>
                                        <div><label>Category:</label> ${item.StockName || ``}</div>
                                        <div><label>Brand:</label> ${item.ItemBrand || ``}</div>
                                        <div><label>Serial Number:</label> ${item.SerialNumber || ``}</div>
                                    </div>
                                    <div class="col col-md-6 detail">
                                        <div><label>Unit Variant:</label> ${units.map((unit) => `<span class="pill">${unit}</span>`).join(',')}</div>
                                        <div><label>Stock Opening:</label> ${0}</div>
                                          <div><label>Stock In:</label> <span class="text-success">${totalQtyIn}</span></div>
                                        <div><label>Stock Out:</label> <span class="text-danger">${totalQtyOut}</span></div>
                                        <div><label>Stock On Hand:</label> <span class="text-primary">${totalStockOnHand}</span></div>
                                    </div>
                                </div>
                                <div class="row" style="margin-top: 10px;">
                                    <div class="col col-md-6">
                                        <table class="table1 table-sm table-striped table-hover">
                                            <thead style="background:#F89C39; color:#fff">
                                                <tr>
                                                    <th class="text-black">Warehouse Name</th>
                                                    <th class="text-black">In</th>
                                                    <th class="text-black">Out</th>
                                                    <th class="text-black">QOH</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            ${qtyByWarehouse.length > 0 ? qtyByWarehouse.map(w => `<tr>
                                                    <td>${w.WarehouseName}</td>
                                                    <td class="text-danger">${w.QTYIN}</td>
                                                    <td class="text-danger">${w.QTYOUT}</td>
                                                    <td class="text-primary">${w.QTYIN - w.QTYOUT}</td>
                                                </tr>`).join('') : `<tr>
                                                    <td colspan="4" class="text-center">No data</td>
                                                </tr>` }
                                            </tbody>
                                        </table>
                                    </div>
                                    <div class="col col-md-6">
                                        <table class="table1 table-sm table-striped table-hover">
                                            <thead style="background:#F89C39; color:#fff">
                                                <tr>
                                                    <th class="text-black">Expire Date</th>
                                                    <th class="text-black">Barcode</th>
                                                    <th class="text-black">In</th>
                                                    <th class="text-black">Out</th>
                                                    <th class="text-black">QOH</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                            ${qtyByExpireDate.length > 0 ? qtyByExpireDate.map(e => `<tr>
                                                <td>${convertFormatDate(e.ExpireDate, `dd-MM-yyyy`)}</td>
                                                <td class="text-danger">${e.ExpBarcode}</td>
                                                <td class="text-danger">${e.QTYIN}</td>
                                                <td class="text-danger">${e.QTYOUT}</td>
                                                <td class="text-primary">${e.StockOnHand}</td>
                                                </tr>`).join('') : `<tr>
                                                        <td colspan="5" class="text-center">No data</td>
                                                    </tr>` }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>`;
        }

        function renderCardShow(itemCard, keyword, Categories) {
            if (keyword !== '' && isPressEnter && !Categories) {
                $(".showItemDetail").prepend(itemCard);
                $("#keyword").val("").focus();
                $("#btnClear").hide();
            } else {
                $(".showItemDetail").html(itemCard);
            }

            setTimeout(() => {
                $('.showItemDetail').children().removeClass('item-card');
            }, 500);
        }

    }


    function changeImage(el) {
        var imgSrc = $(el).attr("src");
        $(el).closest(".row").find("a").attr("href", imgSrc);
        $(el).closest(".row").find(".main-image").attr("src", imgSrc);
    }

    $(document).on('click', '[data-toggle="lightbox"]', function (event) {
        event.preventDefault();
        $(this).ekkoLightbox({
            //alwaysShowClose: true,
            wrapping: false
        });
    });

</script>