@{ Layout = null; }
@using NSM.Models;
@*
<link href="~/Content/css/custom/aiz-core.css" rel="stylesheet" type="text/css" />*@
<style>
    .table1 {
        border-spacing: 1;
        border-collapse: collapse;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        /*        max-width: 800px;*/
        width: 100%;
        /*        margin: 0 auto;*/
        position: relative;
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
    }

    body.dark-mode .table1 tbody tr {
        background: var(--dark-bg-quaternary) !important;
    }

    .table-sm th,
    .table-sm td {
        padding: 0.5rem !important;
    }

    .item-card::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: #999;
        z-index: 1;
        opacity: 0.3;
        border-radius: 1rem;
    }

    a.text-success:hover,
    a.text-success:active {
        color: #007bff !important;
    }

    .pills {
        background: rgb(238, 238, 239);
        display: inline;
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        color: rgb(74, 74, 80);
    }

    .item-card-exist::before {
        content: "";
        position: absolute;
        width: 100%;
        height: 100%;
        background: #FFC96F;
        /*z-index: 1;*/
        opacity: 0.3;
    }

    .pill {
        background: #F89C39;
        padding: 4px 8px;
        margin-left: 5px;
        border-radius: 8px;
        font-size: 14px;
        font-weight: bold;
        color: #fff;
    }

    .container {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .main-image {
        /*        width: 300px;*/
        margin-bottom: 20px;
    }

    .img-hover-zoom--colorize img {
        transition: transform .5s, filter 1.5s ease-in-out;
        /*filter: grayscale(100%);*/
    }

    .img-hover-zoom--colorize:hover img {
        /*filter: grayscale(0);*/
        /*        transform: scale(1.1);*/
    }

    .img-box {
        border: 1px dashed #ccc;
        border-radius: 1rem;
        height: 65px;
        width: 65px;
        align-content: center;
        text-align: center;
        overflow: hidden;
    }

    .thumbnails {
        width: 100%;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        /*        overflow: scroll;*/
        margin: 0.5rem 0 1rem;
    }

    .thumbnail {
        width: inherit;
        height: inherit;
        cursor: pointer;
        object-fit: cover;
    }

    .thumbnail:hover,
    .thumbnail.active {
        opacity: 0.7;
    }

    .card {
        box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        overflow: hidden;
        border-radius: 1rem;
    }

    .btnRemoveCard {
        position: absolute;
        top: 0;
        right: 0;
        width: 0.75rem;
        height: 0.75rem;
        background: red;
        margin: 15px;
    }

    span>svg.icon-tabler-list-details {
        width: 24px;
        height: 24px;
        fill: none;
    }

    span>svg.icon-tabler-square-x {
        position: absolute;
        top: 0;
        right: 0;
        width: 22px;
        height: 22px;
        margin: 10px;
        color: red;
        cursor: pointer;
        transition: all ease 0.4s;
    }

    span>svg.icon-tabler-square-x:hover {
        scale: 0.9;
    }

    .detail div label {
        margin-bottom: 0;
    }

    .detail div {
        padding: 0.375rem 0.5rem;
        border-radius: .5rem;
    }

    .detail div:hover {
        background: #eeeeee;
        font-weight: 600;
    }

    body.dark-mode .detail div:hover {
        background: var(--dark-bg-quaternary);
    }

    body.dark-mode .table-hover tbody tr:hover {}

    .cube {
        margin: 40px auto;
        font-size: 24px;
        height: 1em;
        width: 1em;
        position: relative;
        transform: rotatex(30deg) rotatey(45deg);
        transform-style: preserve-3d;
        animation: cube-spin 1.5s infinite ease-in-out alternate;
    }

    .side {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        transform-style: preserve-3d;
    }

    .side::before {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        background-color: currentcolor;
        transform: translatez(0.5em);
        animation: cube-explode 1.5s infinite ease-in-out;
        opacity: 0.5;
    }

    .side:nth-child(1) {
        transform: rotatey(90deg);
    }

    .side:nth-child(2) {
        transform: rotatey(180deg);
    }

    .side:nth-child(3) {
        transform: rotatey(270deg);
    }

    .side:nth-child(4) {
        transform: rotatey(360deg);
    }

    .side:nth-child(5) {
        transform: rotatex(90deg);
    }

    .side:nth-child(6) {
        transform: rotatex(270deg);
    }

    @@keyframes cube-spin {
        0% {
            transform: rotatex(30deg) rotatey(45deg);
        }

        100% {
            transform: rotatex(30deg) rotatey(405deg);
        }
    }

    @@keyframes cube-explode {
        0% {
            transform: translatez(0.5em);
        }

        50% {
            transform: translatez(0.75em);
        }

        100% {
            transform: translatez(0.5em);
        }
    }
</style>
<style>
    #scrollToTopBtn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background-color: #2561e6;
        color: white;
        border: none;
        border-radius: 50%;
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
        z-index: 1000;
    }

    #scrollToTopBtn:hover {
        background-color: #1a4bba;
        transform: scale(1.1);
    }

    #scrollToTopBtn.show {
        opacity: 1;
        visibility: visible;
    }

    .zoom-container {
        position: relative;
        display: flex;
    }

    .zoom-result {
        width: 90vw;
        max-width: 600px;
        height: 90vh;
        max-height: 600px;
        backdrop-filter: blur(8px);
        background-repeat: no-repeat;
        background-position: center;
        background-size: cover;
        display: none;
        position: fixed;
        top: 50%;
        left: 60%;
        transform: translate(-60%, -50%);
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
        z-index: 9999;
    }

    .zoom-lens {
        position: absolute;
        background-image: url("Uploads/mouse_hover_bg.gif");
        cursor: pointer;
        width: 160px;
        height: 120px;
        display: none;
    }
</style>
<div class="row">
