@{ Layout = null;}
<div class="row">
    <div class="col">
        @Html.Raw(ViewBag.DrawHTMLSearchForm)
    </div>
</div>
<div class="row">
    <div class="col">
        <div id="divShowPODetail"></div>
    </div>
</div>
@*<font face="IDAutomationC128M" size="28"></font>*@
    <script>
        function Search() {
            var PO = $("#CboSearchText").val();
            if (PO == "") {
                DialogSweetAlert("error", "Please entery PO.", function () {
                    $("#CboSearchText").focus();
                    return false;
                });
                return false;
            }
            LoadData("Items/PODetail?PO=" + encodeURIComponent(PO), function (response) {

                $("#divShowPODetail").html(response);
            });
        }
    </script>
