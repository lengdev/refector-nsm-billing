<script>
    $(function () {
        $("#btnAddItemRequest").click(function () {
            AddItemRequest(0);
        });
        LoadRequstItem();
    });
    function AddItemRequest(ItemRequestID) {
        var Title = "Add Item Request";
        if (ItemRequestID != 0)
            Title = "Edit Item Request";
        ShowDialogBox(Title, "auto", 0, "Items/AddItemRequest", ItemRequestID, "DialogAddItemRequest", "", "", "", function () {
            $("#DialogAddItemRequest").on('hide.bs.modal', function () {
                if (SaveChangeResponse.length > 0) {
                    var ID = SaveChangeResponse["Data"].IDENTITYValue;
                    var IDs = ID.split("~");
                    ID = IDs[0].split("|")[1];
                    SaveChangeResponse = [];
                    LoadData("Items/ApproveRequestItem?ID=" + ID, function (response) {

                    });
                }
            });
        });
    }
    function LoadRequstItem()
    {
        LoadData("Items/LoadItemRequested", function (response) {
            var rst = JSON.parse(JSON.parse(response).Data);
            var row = '<ul class="mynav nav nav-pills flex-column">';
            $.each(rst, function (key, value) {
                row += `<li class="nav-item">
    <a href="javascript:void(0);" onclick="showItemRequestForm(this,`+ value.RequestItemID + `);" class="nav-link">` + value.RequestDate;
                if (value.Status == "Approved")
                    row += `<span class="badge bg-primary float-right">` + value.Status + `</span>`;
                else
                    row += `<span class="badge bg-danger float-right">` + value.Status + `</span>`;
                row += `<br><span class="text-sm">` + value.RequestNo + `</span>`;
                row += `<br><span class="text-sm">Need to Approval By: ` + value.FullName + `</span>`;
                row += `</a></li>`;
            });
            row += '</ul>';
            $("#div_request").html(row);
            $("ul.mynav li a").eq(0).click();
        });
    }

    function showItemRequestForm(THIS, RequestItemID) {
        $("ul.mynav li a").removeClass("active");
        $("#btnEdit, #btnApproveItemRequest").unbind();
        LoadData("Items/ItemRequestForm?ID=" + RequestItemID +"&RequestMode=Item Request", function (response) {
            $("#div_ItemRequestForm").html(response);
            $("#btnEdit").click(function () {
                //ShowDialogBox("Edit Item Request", "auto", 0, "Items/AddItemRequest", RequestItemID);
                AddItemRequest(RequestItemID);
            });
            $("#btnApproveItemRequest").click(function () {
                ApproveDisapproveItemRequest(RequestItemID, 'Approved');
            });
            $("#btnDisapproveItemRequest").click(function () {
                ApproveDisapproveItemRequest(RequestItemID, 'Disapproved');
            });
            $("#btnDeleteItemRequest").click(function () {
                DoSaveChangeSweetCofirm("Items/DeleteItemRequest?ID=" + RequestItemID, "", function () {
                    LoadRequstItem();
                });
            });
            $(THIS).addClass("active");
        });
    }
    function ApproveDisapproveItemRequest(RequestItemID, Status) {
        var msg = "Approval this Inventory Request. You won't be able to revert this!";
        var m = "Approving...";
        if (Status == "Disapproved") {
            m = "Disapproving...";
            msg = "Disapprove this Inventory Request. You won't be able to revert this!";
        }
        DoSaveChangeSweetCofirm("Items/ApproveDisapproveItemRequest?ID=" + RequestItemID + "&Status=" + Status, "", function (response) {
            LoadRequstItem();
        }, m, msg);
    }

    function printItemRequest() {
        $("#div_ItemRequestForm").printThis();
    }


</script>-->

@Html.Raw(ViewBag.DrawHTMLSearchForm)


<script>
    var _RequestItemID = 0;
    function ConfirmReceivedItem(RequestItemID, RequestNo, ReceivedBy, ReceivedUserID, ReceivedTelegaramUserName) {
        _RequestItemID = RequestItemID;
        //console.log(ReceivedBy, ReceivedUserID)
        ShowDialogBox("Request No:. " + RequestNo, "500", "300", "Items/ConfirmReceivedItem?ID=" + RequestItemID, 0, "dialogitemrequest", "", "", "", function () {
            $("#ReceivedBy").val(ReceivedBy);
            $("#ReceivedBy_ReceivedUserID").val(ReceivedUserID);
            $("#ReceivedTelegaramUserName").val(ReceivedTelegaramUserName);
        });
    }
    function SaveChangeConfirmItemRequest() {
        var obj = {};
        obj = $("form[name=CreateReceived]").serializeObject();
        obj["RequestItemID"] = _RequestItemID;
        var DATA = { Data: JSON.stringify(obj) }
        PostData("Items/SaveChangeConfirmItemRequest", DATA, function (response) {
            response = JSON.parse(response);
            if (response.Result == 2) {
                $("#dialogitemrequest").modal('hide');
                $("#BunSearch").click();
                $("#CloseModal").click();
            }
            else {
                DialogSweetAlert("error", response.Message, function () {
                    $("#ReceivedBy").focus();
                });
            }
        });
    }    
    function showItemRequestForm(requestId, isRequestApproval, requestNo) {
        var URL = "Items/ItemRequestForm?ID=" + requestId + "&IsRequestApprovalItemOut=" + isRequestApproval;
        ShowDialogBox(`Preview Item Request Form No.: ${requestNo}`, "Auto", "500", URL, "", "", "", "", "", function () {
            $("#SaveChange").html('<i class="fa fa-print" aria-hidden="true"></i> Print');
            $("#SaveChange").click(function () {
                $("#divItemRequestForm").printThis();
            });
        });
    }
</script>
