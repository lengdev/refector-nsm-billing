                ApproveDisapproveItemRequest(RequestItemID, 'Approved');
            });
            $("#btnDisapproveItemRequest").click(function () {
                ApproveDisapproveItemRequest(RequestItemID, 'Disapproved');
            });
            $("#btnDeleteItemRequest").click(function () {
                DoSaveChangeSweetCofirm("Items/DeleteItemRequest?ID=" + RequestItemID, "", function () {
                    LoadRequstItem();
                });
            });
            $(THIS).addClass("active");
        });
    }
    function ApproveDisapproveItemRequest(RequestItemID, Status) {
