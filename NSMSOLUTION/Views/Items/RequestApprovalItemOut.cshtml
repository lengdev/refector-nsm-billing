@Html.Raw(ViewBag.DrawHTMLSearchForm)

<script>

    $(function () {
        $(document).on('change', 'input[name="QTY"]', function (e) {
            var qty = e.target.value;
            var curEl = $(this);
            var tr = curEl.closest('tr');
            var itemReqId = curEl.closest('#divmain').find('#ReferenceRequestItemID').val();
            var itemId = tr.find('input[name="ItemID"]').val();
            //var itemName = tr.find('input[name="ItemName"]').val();
            if (!itemId) {
                curEl.val('');
            }
            if (itemReqId) {
                return false
                LoadData(`Items/ShowRequestItem?ID=${itemReqId}`, function (res) {
                    var resArr = JSON.parse(JSON.parse(res));
                    $.each(resArr, (index, data) => {
                        if (itemId == data.ItemID) {
                            if (qty > data.QTY) {
                                DialogSweetAlert("error",`You can\'t input qty greater than qty request of item <span class="text-muted">${data.ItemNameFull}</span>`,
                                    function () {
                                        curEl.val('');
                                        curEl.focus();
                                    }
                                );
                            }
                        }
                    });
                });
            }
        });
    });

    function ConfirmPreparedItem(Element, RequestItemID, RequestNo, ReceivedBy, ReceivedUserID, ReceivedTelegaramUserName) {
        var isClicked = 1;
        var el = $(Element);
        el.attr('data-is-click', isClicked);
        ShowDialogBox("Confirm Prepared Stock Request No:. " + RequestNo, "auto", "300", "Items/AddRequestApprovalItemOut?IsConfirmPrepared=true", RequestItemID, "dialogitemrequest", "", "", "", function () {
            $("#RequestNo").val(RequestNo);
            $("#ReferenceRequestItemID").val(RequestItemID);
            $("#ReceivedBy").val(ReceivedBy);
            $("#ReceivedBy_ReceivedUserID").val(ReceivedUserID);
            $("#ReceivedBy_ReceivedTelegaramUserName").val(ReceivedTelegaramUserName);
            //$("#ReceivedBy").val(ReceivedBy);
            $("#dialogitemrequest").on('hide.bs.modal', function () {
                $("#BunSearch").click();
            });
            //
            //setTimeout(function () {
            //    //ShowRequestItem();
            //}, 100);
        });
    }

    function showItemRequestForm(requestId, isRequestApproval, requestNo) {
        var URL = "Items/ItemRequestForm?ID=" + requestId + "&IsRequestApprovalItemOut=" + isRequestApproval;
        ShowDialogBox(`Preview Item Request Approval Form No.: ${requestNo}`, "Auto", "500", URL, "", "", "", "", "", function () {
            $("#SaveChange").html('<i class="fa fa-print" aria-hidden="true"></i> Print');
            $("#SaveChange").click(function () {
                $("#divItemRequestForm").printThis();
            });
        });
    }

</script>

