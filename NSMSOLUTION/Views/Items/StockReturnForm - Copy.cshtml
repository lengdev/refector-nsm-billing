
@{
    Layout = null;
    System.Data.DataRow dataRow = ViewBag.Data.Rows[0];
}
<link href="https://fonts.googleapis.com/css2?family=Moul&display=swap" rel="stylesheet">
<style>
    .mytable th, .mytable td {
        border: 0.7px solid #000000 !important;
    }

    .mytable th {
        background-color: #f89c39;
        color: #fff;
    }

    .moul-regular {
        font-family: "Moul", serif;
        font-weight: 400;
        font-style: normal;
    }

    @@media print {
        @@page {
            size: A3 !important;
            margin: 0px 20px 0px 50px !important;
        }
        footer {
            margin-bottom: 4.5rem;
        }
    }
</style>
<div style="padding:5px;" id="divItemRequestForm">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-end mt-4 mb-3">
            <div class="img">
                <img class="img-fluid" src="@ViewBag.Logo" width="200" />
            </div>
        </div>
        @{
            if (ViewBag.IsRequestStockReturn)
            {
                <div style="margin: 0 auto 10px;text-align: center;">
                    <h4 class="page-header mb-2 moul-regular" ​>ប័ណ្ណស្នើបង្វិលទំនិញ</h4>
                    <h5 class="page-header text-uppercase" style="font-family: 'Times New Roman', Times, serif">Request Stock Return</h5>
                </div>
            }
            else
            {
                <div style="margin: 0 auto 10px;text-align: center;">
                    <h4 class="page-header mb-2 moul-regular" ​>ប័ណ្ណបង្វិលទំនិញ</h4>
                    <h5 class="page-header text-uppercase" style="font-family: 'Times New Roman', Times, serif">Stock Return</h5>
                </div>
            }
        }
    </div>

    <div class="row mt-2">
        @{
            if (ViewBag.IsRequestStockReturn)
            {
                <div class="col">
                    <label><b>Return Name:</b> @dataRow["RequestName"]</label><br />
                    <label><b>Tel:</b> @dataRow["RequestPhone"]</label><br />
                    <label><b>Department:</b> @dataRow["Department"]</label><br />
                    <label><b>Address:</b> @dataRow["Address"]</label>
                </div>
                <div class="col text-right">
                    <label><b>Return No.:</b> @dataRow["RequestReturnNo"].ToString()</label><br />
                    <label><b>Return Date:</b> @dataRow["RequestDate"].ToString()</label><br />
                </div>
            }
            else
            {
                <div class="col">
                    <label><b>Return Name:</b> @dataRow["RequestName"]</label><br />
                    <label><b>Tel:</b> @dataRow["RequestPhone"]</label><br />
                    <label><b>Department:</b> @dataRow["Department"]</label><br />
                    <label><b>Warehouse:</b> @dataRow["WarehouseName"]</label>
                </div>
                <div class="col text-right">
                    <label><b>Stock Return No.:</b> @dataRow["RequestApprovalNo"].ToString()</label><br />
                    <label><b>Request Return No.:</b> @dataRow["RequestReturnNo"].ToString()</label><br />
                    <label><b>Date:</b> @DateTime.Parse(dataRow["PreparedDate"].ToString()).ToString("dd-MM-yyyy")</label><br />
                </div>
            }
        }
    </div>
    <div class="row mt-3">
        <div class="col">
            @{
                if (ViewBag.IsRequestStockReturn)
                {
                    <table class="table mytable">
                        <thead class="text-center">
                            <tr>
                                <th width="5%">No.</th>
                                <th width="10%">Item Code</th>
                                <th width="30%">Item Name</th>
                                @*<th>Model</th>*@
                                <th width="10%" nowrap>SN Number</th>
                                <th width="10%">QTY</th>
                                <th width="30%">Purpose or Reasons</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                                foreach (System.Data.DataRow dr in ViewBag.Data.Rows)
                                {
                                    i++;
                                    <tr>
                                        <td align="center">@i</td>
                                        <td align="center">@dr["ItemCode"]</td>
                                        <td>@dr["ItemName"]</td>
                                        @*<td>@dr["Model"]</td>*@
                                        <td align="center">@dr["SerialNumber"]</td>
                                        <td align="right">@dr["QTY"] @dr["Unit"]</td>
                                        <td>@dr["Remark"]</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="table mytable">
                        <thead class="text-center">
                            <tr>
                                <th width="">No.</th>
                                <th>Item Code</th>
                                <th width="35%">Item Name</th>
                                @*<th>Model</th>*@
                                <th>SN Number</th>
                                <th width="">QTY</th>
                                <th width="35%">Purpose or Reasons</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int i = 0;
                                foreach (System.Data.DataRow dr in ViewBag.Data.Rows)
                                {
                                    i++;
                                    <tr>
                                        <td align="center">@i</td>
                                        <td nowrap>@dr["ItemCode"]</td>
                                        <td>@dr["ItemName"]</td>
                                        @*<td>@dr["Model"]</td>*@
                                        <td nowrap>@dr["SerialNumber"]</td>
                                        <td align="right" nowrap>@dr["QTY"] @dr["Unit"]</td>
                                        <td>@dr["Remark"]</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            }

        </div>
    </div>
    @{
        if (ViewBag.IsRequestStockReturn)
        {
            <div class="row">
                <div class="col">
                    <p><b>***បញ្ចាក់ៈ សូមពិនិត្យទំនិញឲ្យបានត្រឹមត្រូវមុននឹងប្រគល់ជូនផ្នែកស្តុក</b></p>
                </div>
            </div>
        }
    }
    <footer>
        <div id="divFooterPrint">
            @{
                if (ViewBag.IsRequestStockReturn)
                {
                    <div class="row" style="margin-top:50px">
                        <div class="col-4">
                            @{string[] aa = dataRow["RequestSignature"].ToString().Split('~');
                                if (aa[0].ToString() != "")
                                {
                                    <div class="text-center" style="height:50px">
                                        <img height="60" src="../Uploads/Users/@aa[0]" />
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center" style="height:50px"></div>
                                }
                            }
                            <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                            <div class="row">
                                <div class="col text-center">
                                    <label class="col-form-label text-uppercase text-nowrap">Prepared By</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label class="col-form-label text-nowrap">Name: @dataRow["RequestName"].ToString()</label><br>
                                    <label class="col-form-label text-nowrap">Position: @dataRow["RequestByPosition"].ToString()</label><br>
                                    <label class="col-form-label text-nowrap">Date: @dataRow["RequestDate"].ToString()</label><br>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">&nbsp;</div>
                        <div class="col-4">
                            @{aa = dataRow["NeedToApprovalSignature"].ToString().Split('~');
                                if (aa[0].ToString() != "" && dataRow["Status"].ToString() != "Pending")
                                {
                                    <div class="text-center" style="height:50px">
                                        <img height="60" src="../Uploads/Users/@aa[0]" />
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center" style="height:50px"></div>
                                }
                            }
                            <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                            <div class="row">
                                <div class="col text-center">
                                    <label class="col-form-label text-uppercase text-nowrap">
                                        @(dataRow["Status"].ToString() == "Disapproved" ? "Disapproved By" : (dataRow["Status"].ToString() == "Rejected" ? "Rejected By" : "Approved By"))
                                    </label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label class="col-form-label text-nowrap">Name: @(dataRow["Status"].ToString() != "Pending" ? dataRow["ApprovalName"].ToString() : "")</label><br>
                                    <label class="col-form-label text-nowrap">Position: @(dataRow["Status"].ToString() != "Pending" ? dataRow["ApprovalByPosition"].ToString() : "")</label><br>
                                    <label class="col-form-label text-nowrap">Date: @(dataRow["Status"].ToString() != "Pending" ? DateTime.Parse(dataRow["ApproveDisapproveDate"].ToString()).ToString("dd-MM-yyyy") : "")</label><br>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="row" style="margin-top:50px">
                        <div class="col-4">
                            @{string[] aa = dataRow["PreparedSignature"].ToString().Split('~');
                                if (aa[0].ToString() != "")
                                {
                                    <div class="text-center" style="height:50px">
                                        <img height="60" src="../Uploads/Users/@aa[0]" />
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center" style="height:50px"></div>
                                }
                            }
                            <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                            <div class="row">
                                <div class="col text-center">
                                    <label class="col-form-label text-uppercase text-nowrap">Prepared By</label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label class="col-form-label text-nowrap">Name: @dataRow["PreparedBy"].ToString()</label><br>
                                    <label class="col-form-label text-nowrap">Position: @dataRow["PrepareByPosition"].ToString()</label><br>
                                    <label class="col-form-label text-nowrap">Date: @DateTime.Parse(dataRow["PreparedDate"].ToString()).ToString("dd-MM-yyyy")</label><br>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            @{aa = dataRow["NeedToApprovalSignature"].ToString().Split('~');
                                if (aa[0].ToString() != "" && dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending")
                                {
                                    <div class="text-center" style="height:50px">
                                        <img height="60" src="../Uploads/Users/@aa[0]" />
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center" style="height:50px"></div>
                                }
                            }
                            <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                            <div class="row">
                                <div class="col text-center">
                                    <label class="col-form-label text-uppercase text-nowrap">
                                        @(dataRow["RequestApprovalItemOutStatus"].ToString() == "Disapproved" ? "Disapproved By" : "Approved By")
                                    </label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label class="col-form-label text-nowrap">Name: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? dataRow["ApprovalName"].ToString() : "")</label><br>
                                    <label class="col-form-label text-nowrap">Position: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? dataRow["ApprovalByPosition"].ToString() : "")</label><br>
                                    <label class="col-form-label text-nowrap">Date: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? dataRow["ApprovedRequestDate"].ToString() : "")</label><br>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            @{aa = dataRow["ReceivedUserSignature"].ToString().Split('~');
                                if (aa[0].ToString() != "" && dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending")
                                {
                                    <div class="text-center" style="height:50px">
                                        <img height="60" src="../Uploads/Users/@aa[0]" />
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center" style="height:50px"></div>
                                }
                            }
                            <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                            <div class="row">
                                <div class="col text-center">
                                    <label class="col-form-label text-uppercase text-nowrap">
                                        Received By
                                    </label>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">
                                    <label class="col-form-label text-nowrap">Name: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? dataRow["ReceivedBy"].ToString():"")</label><br>
                                    <label class="col-form-label text-nowrap">Position: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? dataRow["ReceiveByPosition"].ToString(): "")</label><br>
                                    <label class="col-form-label text-nowrap">Date: @(dataRow["RequestApprovalItemOutStatus"].ToString() != "Pending" ? DateTime.Parse(dataRow["PreparedDate"].ToString()).ToString("dd-MM-yyyy") : "")</label><br>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </footer>
</div>

<script>
    var SRID = '@ViewBag.SRID';
    var Status = '@ViewBag.Status';
    var IsRequestApprovalItemOut = '@ViewBag.IsRequestStockReturn';
    //console.log(IsRequestApprovalItemOut);
    $(function () {
        //if (Status == "Approved" && IsRequestApprovalItemOut === "False") {
        //    let btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveStockRequest();\" id=\"CancelSR\" class=\"btn btn-danger\">";
        //    btn += '<i class="fa-regular fa-ban"></i> Cancel Stock Request</button></div>';
        //    $("#SaveChange2").before(btn);
        //}
    });

    function ApproveStockRequest() {
        DoSaveChangeSweetCofirm("Items/ApproveDisapproveItemRequest", { ID: SRID, Status: "Cancel", FromName: "", RequestMode: "", ApprovalType: "", Comment: $("#txtComment").val() }, function (result) {
            if (result.Result == 2) {
                $("#CloseModal2").click();
                LoadTableGrid(CurrentPage);
            }
        }, "", "", "Cancel Stock Request");
    }
</script>