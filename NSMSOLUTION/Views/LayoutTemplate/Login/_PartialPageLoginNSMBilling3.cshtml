<body ng-controller="LoginController">
    @*<div class="container_login" style="background-image: url('../../Content/LoginV1_files/bglogin.jpg');">*@
        <!-- Preloader -->
        <div class="preloader flex-column justify-content-center align-items-center">
            <img class="animation__wobble" src="~/Content/NSMISPLogo.png" alt="NSM SOLUTION">
        </div>
        <div id="particles_effect" class="particles-effect"></div>
        <div class="limiter">
            <div class="container-login100 row">
                <div class="wrap-login100 col-auto">
                    <div class="row">
                        <div class="col">
                            <div class="login100-pic js-tilt" data-tilt=""
                                style="will-change: transform; transform: perspective(300px) rotateX(-5.85deg) rotateY(0.44deg) scale3d(1.1, 1.1, 1.1); transition: all 400ms cubic-bezier(0.03, 0.98, 0.52, 0.99) 0s;">
                                <img src="~/Content/NSMISPLogo.png" alt="NSM ISP LOGO">
                            </div>
                            <div class="login100-pic js-tilt" data-tilt=""
                                style="margin-top:40px; will-change: transform; transform: perspective(300px) rotateX(-5.85deg) rotateY(0.44deg) scale3d(1.1, 1.1, 1.1); transition: all 400ms cubic-bezier(0.03, 0.98, 0.52, 0.99) 0s;">
                                <h3 class="text-uppercase text-center text-info">
                                    Welcome to NSM Billing System Version: 0.4
                                </h3>
                                <div class="m-t-60"></div>
                                <h6 class="txt1">Last update: 03-August-2023 01:00 PM @@NSM</h6>
                                <h6 class="txt1">Create Date: 01-June-2022 @@PP Factory</h6>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <form class="login100-form validate-form">
                                <span class="login100-form-title text-nowrap" style="color: #F89C39">
                                    Sign in to start your session
                                </span>
                                <div class="wrap-input100 validate-input" data-validate="User Name is required">
                                    <input autofocus="autofocus" class="input100" type="text" id="username"
                                        name="username" placeholder="User Name" data-ng-model="LoginData.UserName">
                                    <span class="focus-input100"></span>
                                    <span class="symbol-input100">
                                        <i class="fa fa-user" aria-hidden="true"></i>
                                    </span>
                                </div>
                                <div class="wrap-input100 validate-input" data-validate="Password is required">
                                    <input class="input100" type="password" name="password" id="password"
                                        placeholder="Password" data-ng-model="LoginData.Password">
                                    <span class="focus-input100"></span>
                                    <span class="symbol-input100">
                                        <i class="fa fa-lock" aria-hidden="true"></i>
                                    </span>
                                    <span id="toggle-password" toggle="#password"
                                        class="fa field-icon toggle-password fa-eye"></span>
                                </div>
                                <div class="container-login100-form-btn">
                                    <button class="login100-form-btn" id="Login">
                                        Login
                                    </button>
                                </div>
                                <div class="text-center p-t-12">
                                    <span class="txt1">
                                        Forgot
                                    </span>
                                    <a class="txt2" href="#" id="ResetPassword">
                                        Password?
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <div class="text-center text-white-50 text-sm">
                            Copyright © 2019-2023 NSM SOLUTION & MAINTENANCE CO., LTD. All rights reserved.
                        </div>
                    </div>
                </div>
            </div>
        </div>
        @*
    </div>*@
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>

    <script src="~/Content/LoginV1_files/tilt.jquery.min.js"></script>

    <script src="~/Content/AdminLTE-3.2.0/plugins/sweetalert2/sweetalert2.all.min.js"></script>

    <script>
        $(function () {
            "use strict";
            $('.js-tilt').tilt({
                scale: 1.1
            })
            $("#toggle-password").click(function () {
                $(this).toggleClass("fa-eye fa-eye-slash");
                var input = $($(this).attr("toggle"));
                if (input.attr("type") == "password") {
                    input.attr("type", "text");
                    $("#password").focus().select();
                } else {
                    input.attr("type", "password");
                    $("#password").focus().select();
                }
            });
            $("#ResetPassword").click(function () {
                Swal.fire({
                    title: 'Reset Password Form',
                    html: `<input type="text" value="${$("#username").val()}" id="TxtUserName" class="swal2-input" placeholder="Username">
                                                                    <input type="text" id="TxtPhone" class="swal2-input" placeholder="Registered Phone Number">
                                                                    <input type="password" id="TxtPassword" class="swal2-input" placeholder="Password">
                                                                    <input type="password" id="TxtConfirmPassword" class="swal2-input" placeholder="Confirm Password">`,
                    confirmButtonText: 'Reset Password',
                    focusConfirm: false,
                    width: '700px',
                    position: 'top',
                    showLoaderOnConfirm: true,
                    preConfirm: () => {
                        const User_Name = Swal.getPopup().querySelector('#TxtUserName').value;
                        const Phone = Swal.getPopup().querySelector('#TxtPhone').value;
                        const Pass_word = Swal.getPopup().querySelector('#TxtPassword').value;
                        const ConfirmPassword = Swal.getPopup().querySelector('#TxtConfirmPassword').value;
                        if (!User_Name) {
                            Swal.showValidationMessage(`Please enter User Name.`);
                            Swal.getPopup().querySelector('#TxtUserName').focus();
                            return false;
                        }
                        else if (!Phone) {
                            Swal.showValidationMessage(`Please enter Registerd Phone Number.`);
                            Swal.getPopup().querySelector('#TxtPhone').focus();
                            return false;
                        }
                        else if (!Pass_word) {
                            Swal.showValidationMessage(`Please enter Password.`);
                            Swal.getPopup().querySelector('#TxtPassword').focus();
                            return false;
                        }
                        else if (!ConfirmPassword) {
                            Swal.showValidationMessage(`Please enter Confirm Password.`);
                            Swal.getPopup().querySelector('#TxtConfirmPassword').focus();
                            return false;
                        }
                        else if (Pass_word != ConfirmPassword) {
                            Swal.showValidationMessage(`Your Password and Confirm Password not the same.`);
                            Swal.getPopup().querySelector('#TxtPassword').focus();
                            return false;
                        }
                        validatePassword(Pass_word, function (valid, message) {
                            if (!valid) {
                                Swal.showValidationMessage(message);
                                return false;
                            }
                            else {
                                var DATA = { UserName: User_Name, Phone: Phone, Password: Pass_word };
                                $.ajax({
                                    url: ServerRoot + "Login/SaveChangeResetPassword",
                                    dataType: "html",
                                    async: false,
                                    cache: false,
                                    type: 'POST',
                                    data: DATA,
                                    beforeSend: function (xhr) {
                                        $("button").attr('disabled', true);
                                        //DialogSweetAlert("ToastrLoading", "Saving...");
                                    },
                                    success: function (response) {
                                        $("button").attr('disabled', false);
                                        var result = JSON.parse(response);
                                        if (result.Result == 2) {
                                            $("#username").val(User_Name);
                                            $("#password").val(Pass_word);
                                            $("#username").trigger('input');
                                            $("#password").trigger('input');
                                            $("#Login").click();
                                            //DialogSweetAlert("ToastrLoading", "Your data has been saved.");
                                            return true;
                                        }
                                        else {
                                            Swal.showValidationMessage(result.Message);
                                            //DialogSweetAlert("ToastrLoading", result.Message);
                                            //DialogSweetAlert("error", result.Message);
                                            return false;
                                        }
                                    },
                                    error: function (response, callStatus, errorThrown) {
                                        $("button").attr('disabled', false);
                                        Swal.showValidationMessage(response.status + " " + response.statusText);
                                        //DialogSweetAlert("ToastrLoading", response.status + " " + response.statusText);
                                        return false;
                                    }
                                });
                                //return { UserName: UserName, Phone: Phone, Password, Password }
                            }
                        });
                        return false;
                        //return { UserName: UserName, Phone: Phone, Password, Password }

                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                    }
                })
            });
            var input = $('.validate-input .input100');
            $('.validate-form').on('submit', function () {
                var check = true;
                for (var i = 0; i < input.length; i++) {
                    if ((input[i]).value == "") {
                        showValidate(input[i]);
                        check = false;
                    }
                }
                if (check) {
                    angular.element(document.getElementById('Login')).scope().Login();
                }
                return check;
            });
            $('.validate-form .input100').each(function () {
                $(this).focus(function () {
                    hideValidate(this);
                });
            });
        });

        function showValidate(input) {
            var thisAlert = $(input).parent();
            $(thisAlert).addClass('alert-validate');
        }
        function hideValidate(input) {
            var thisAlert = $(input).parent();
            $(thisAlert).removeClass('alert-validate');
        }
    </script>
