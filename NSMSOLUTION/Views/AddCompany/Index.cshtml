    /* QR Grid - 2 columns */
    .qr-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    /* QR Card */
    .qr-card {
        background: white;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 24px;
        transition: all 0.3s;
        position: relative;
    }

        .qr-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 16px rgba(0,0,0,0.1);
            border-color: #007bff;
        }

        .qr-card.active {
            border-color: #28a745;
            background: #f8fff9;
        }

        .qr-card.inactive {
            border-color: #e9ecef;
            background: #f8f9fa;
            opacity: 0.7;
        }

    /* Status Badge */
    .status-badge {
        position: absolute;
        top: 16px;
        right: 16px;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

        .status-badge.active {
            background: #d4edda;
            color: #155724;
        }

        .status-badge.inactive {
            background: #e9ecef;
            color: #6c757d;
        }

    /* QR Image */
    .qr-image {
        width: 100%;
        aspect-ratio: 1;
        background: #f8f9fa;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        border: 1px solid #e9ecef;
        overflow: hidden;
    }

        .qr-image img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 16px;
        }

    .qr-placeholder {
        font-size: 64px;
        color: #cbd5e0;
    }

    /* QR Info */
    .qr-title {
        font-size: 18px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 8px;
        text-align: center;
    }

    .qr-desc {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 20px;
        text-align: center;
    }

    /* Toggle Button */
    .toggle-btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .toggle-btn.active {
            background: #28a745;
            color: white;
        }

            .toggle-btn.active:hover {
                background: #218838;
            }

        .toggle-btn.inactive {
            background: #6c757d;
            color: white;
        }

            .toggle-btn.inactive:hover {
                background: #5a6268;
            }

    /* Responsive */
    @@media (max-width: 768px) {
        .qr-grid {
            grid-template-columns: 1fr;
        }

        .container {
            padding: 20px;
        }

        .upload-section {
            padding: 30px 20px;
        }
    }

