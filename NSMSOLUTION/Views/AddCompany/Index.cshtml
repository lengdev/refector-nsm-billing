    // ========== DOCUMENT READY ==========
    $(document).ready(function() {
        // Find and initialize with the default company
        let defaultCompany = 'main-office'; // fallback

        // Check which company has ISDefault = true/1
        for (const [key, value] of Object.entries(companyData)) {
            if (value.isDefault === '1' || value.isDefault === 'True' || value.isDefault === true) {
                defaultCompany = key;
                console.log('Default company found:', key, 'ISDefault:', value.isDefault);
                break;
            }
        }

        // Set the default company tab as active
        document.querySelectorAll('.company-tab').forEach((tab, index) => {
            tab.classList.remove('active');
            const companyKeys = Object.keys(companyData);
            if (companyKeys[index] === defaultCompany) {
                tab.classList.add('active');
            }
        });

        // Initialize with default company
        currentCompany = defaultCompany;
        const defaultData = companyData[defaultCompany];
        
        // Load default company data
        if (defaultData) {
            if (defaultData.length > 0) {
                // Update all fields
                document.getElementById('company-name-en').value = defaultData.nameEn;
                document.getElementById('company-name-kh').value = defaultData.nameKh;
                document.getElementById('email').value = defaultData.email;
                document.getElementById('website').value = defaultData.website;
                document.getElementById('phone-company').value = defaultData.phoneCompany;
                document.getElementById('phone-customer').value = defaultData.phoneCustomer;
                document.getElementById('vat-number').value = defaultData.vatNumber;

                document.querySelector('#basic-info #address-en').value = defaultData.addressEn;
                document.querySelector('#basic-info #address-kh').value = defaultData.addressKh;

                // Update Invoice Template section
                const invoicePrefixes = document.querySelectorAll('#invoice-template .invoice-prefix-value');
                if (invoicePrefixes[0]) invoicePrefixes[0].textContent = defaultData.prefixVAT;
                if (invoicePrefixes[1]) invoicePrefixes[1].textContent = defaultData.prefixNonVAT;
                if (invoicePrefixes[2]) invoicePrefixes[2].textContent = defaultData.prefixProformaVAT;
                if (invoicePrefixes[3]) invoicePrefixes[3].textContent = defaultData.prefixProformaNonVAT;
                if (invoicePrefixes[4]) invoicePrefixes[4].textContent = defaultData.prefixQuotationVAT;
                if (invoicePrefixes[5]) invoicePrefixes[5].textContent = defaultData.prefixQuotationNonVAT;

                const companyDataValues = document.querySelectorAll('#invoice-template .company-data-value');
                if (companyDataValues[0]) companyDataValues[0].textContent = defaultData.prefixReceiptVAT;
                if (companyDataValues[1]) companyDataValues[1].textContent = defaultData.prefixReceiptNonVAT;
                if (companyDataValues[2]) companyDataValues[2].textContent = defaultData.prefixCreditNote;
                if (companyDataValues[3]) companyDataValues[3].textContent = defaultData.prefixRequestApproval;
                if (companyDataValues[4]) companyDataValues[4].textContent = defaultData.prefixRequestApproval;

                const advancedTextareas = document.querySelectorAll('#advanced .form-textarea');
                if (advancedTextareas[0]) advancedTextareas[0].value = defaultData.termConditionVAT;
                if (advancedTextareas[1]) advancedTextareas[1].value = defaultData.termConditionNonVAT;
                if (advancedTextareas[2]) advancedTextareas[2].value = defaultData.quoteTermVAT;
                if (advancedTextareas[3]) advancedTextareas[3].value = defaultData.quoteTermNonVAT;

                // Update logo
                const logoImg = document.getElementById('companyLogo');
                if (logoImg) {
                    const logoPath = defaultData.logo
                        ? serverRoot + "/CompanyLogo/" + defaultData.logo
                        : noimg;
                    logoImg.src = logoPath;
                    logoImg.onerror = function () {
                        this.onerror = null;
                        this.src = noimg;
                    };
                }

                // Update company info sidebar
                document.getElementById('current-company').textContent = defaultData.invoiceTemplateName;
                const companyInfoPs = document.querySelectorAll('.company-info p');
                if (companyInfoPs[1]) {
                    const isDefaultStrong = companyInfoPs[1].querySelector('strong');
                    if (isDefaultStrong) {
                        isDefaultStrong.textContent = defaultData.isDefault;
                    }
                }

                const logoTitle = document.querySelector('.logo-title');
                if (logoTitle) {
                    logoTitle.textContent = defaultData.name;
                }

                const editBtn = document.querySelector('.edit-item');
                if (editBtn) {
                    editBtn.setAttribute('data-id', defaultData.id);
                }

                // Load QR codes for default company
                loadQrBanksByCompany(defaultData.id);
            }
        }
        // ========== UPLOAD QR MODAL HANDLERS ==========

        // Load companies when upload modal opens
        $('#DialogAddAttCustFile').on('shown.bs.modal', function () {
            loadCompanies();
        });

        // Upload container and button click
        $('#uploadContainer, #uploadContainer button').on('click', function (e) {
            e.preventDefault();
            $('#custFile').click();
        });

        // File input change handler
        $('#custFile').on('change', function (e) {
            var file = e.target.files[0];
            if (file) {
                if (!file.type.match('image.*')) {
                    //alert('Please select an image file!');
                    DialogSweetAlert("error", `Please select an image file!`);
                    $(this).val('');
                    return;
                }

                $('#fileNameText').text(file.name);
                $('#fileName').show();

                var reader = new FileReader();
                reader.onload = function (event) {
                    $('#imagePreview').attr('src', event.target.result).show();
                };
                reader.readAsDataURL(file);
            }
        });

        // Remove image button
        $('#removeImage').on('click', function (e) {
            e.stopPropagation();
            $('#custFile').val('');
            $('#imagePreview').hide();
            $('#fileName').hide();
        });

        // Save QR Code
        $('#SaveChange2').on('click', function () {
            // Validation
            var isValid = true;
            var errorMsg = '';

            if ($('#CompanyID').val() === '') {
                isValid = false;
                errorMsg += '- Please select a company\n';
            }

            if ($('#QrName').val().trim() === '') {
                isValid = false;
                errorMsg += '- Please enter QR name\n';
            }

            if ($('#custFile').val() === '') {
                isValid = false;
                errorMsg += '- Please upload a QR image\n';
            }

            if ($('#Status').val() === '') {
                isValid = false;
                errorMsg += '- Please select status\n';
            }

            if (!isValid) {
                DialogSweetAlert("error", 'Please fill in all required fields:\n\n' + errorMsg);
                return;
            }

            // Get form data
            var formData = new FormData($('#frm_UploadFiles')[0]);

            // Show loading indicator
            $(this).prop('disabled', true).text('Saving...');

            // AJAX submission
            $.ajax({
                url: '/AddCompany/SaveQrCompany',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    $('#SaveChange2').prop('disabled', false).text('Save');

                    if (response.success) {
                        //alert('QR Code saved successfully!');
                        DialogSweetAlert("success", `QR Code saved successfully!`);
                        $('#DialogAddAttCustFile').modal('hide');
                        // Reload QR banks for current company
                        const currentData = companyData[currentCompany];
                        if (currentData && currentData.id) {
                            loadQrBanksByCompany(currentData.id);
                        }
                    } else {
                        alert('Error: ' + response.message);
                        DialogSweetAlert("error", response.message);
                    }
                },
                error: function (xhr, status, error) {
                    $('#SaveChange2').prop('disabled', false).text('Save');
                    //alert('Error saving QR Code: ' + error);
                    DialogSweetAlert("error", 'Error saving QR Code: ' + error);
                }
            });
        });

        // Reset form when modal closes
        $('#DialogAddAttCustFile').on('hidden.bs.modal', function () {
            $('#frm_UploadFiles')[0].reset();
            $('#imagePreview').hide();
            $('#fileName').hide();
            $('#SaveChange2').prop('disabled', false).text('Save');
        });

        // ========== BUTTON HANDLERS ==========

        // Add Company button handler
        $(document).on('click', '.add-item', function () {
            ShowDialogBox("Add Company", 'Auto', 600, "AddCompany/CreateCompany");
        });

        // Edit Company button handler
        $(document).on('click', '.edit-item', function () {
            const selectedCompanyData = companyData[currentCompany];
            ShowDialogBox(
                "Edit Company",
                'Auto',
                600,
                "AddCompany/CreateCompany",
                selectedCompanyData.id
            );
        });

        // Make functions globally accessible
        window.loadQrBanksByCompany = loadQrBanksByCompany;
        window.loadCompanies = loadCompanies;
        window.switchCompany = switchCompany;
        window.switchTab = switchTab;
        window.toggleQrStatus = toggleQrStatus;
    });
</script>
