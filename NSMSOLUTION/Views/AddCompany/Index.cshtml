    // Render QR Banks
    function renderQrBanks(qrBanks) {
        const container = $('#qr-grid-container');
        container.empty();

        if (!qrBanks || qrBanks.length === 0) {
            container.html(`
                <div class="text-center w-100" style="grid-column: 1 / -1; padding: 40px;">
                    <i class="fas fa-qrcode" style="font-size: 48px; color: #cbd5e0; margin-bottom: 16px;"></i>
                    <p style="color: #6c757d; font-size: 16px;">No QR codes found for this company.</p>
                    <p style="color: #adb5bd; font-size: 14px;">Use "Add Qr Company" button to create one.</p>
                </div>
            `);
            return;
        }

        qrBanks.forEach(function(qr) {
            const qrId = qr.QrID;
            const status = parseInt(qr.Status);
            const isActive = status === 1;
            const statusClass = isActive ? 'active' : 'inactive';
            const statusText = isActive ? 'Active' : 'Inactive';
            const iconClass = isActive ? 'fa-check-circle' : 'fa-times-circle';

            // Handle image path
            let imageHtml = '';
            if (qr.QrImagePath && qr.QrImagePath.trim() !== '') {
                const imagePath = qr.QrImagePath.startsWith('/')
                    ? qr.QrImagePath
                    : serverRoot + '/Uploads/Qrbank/' + qr.QrImagePath;

                imageHtml = `
                    <img src="${imagePath}"
                         alt="${qr.QrName || 'QR Code'}"
                         onerror="this.parentElement.innerHTML='<div class=\\'qr-placeholder\\'><i class=\\'fas fa-qrcode\\'></i></div>';">
                `;
            } else {
                imageHtml = '<div class="qr-placeholder"><i class="fas fa-qrcode"></i></div>';
            }

            const cardHtml = `
                <div class="qr-card ${statusClass}" data-id="${qrId}">
                    <span class="status-badge ${statusClass}">${statusText}</span>
                    <div class="qr-image">
                        ${imageHtml}
                    </div>
                    <h3 class="qr-title">${qr.QrName || 'QR Code ' + qrId}</h3>
                    <p class="qr-desc">Payment QR Code</p>
                    <button class="toggle-btn ${statusClass}"
                            onclick="toggleQrStatus(${qrId}, this, ${status})">
                        <i class="fas ${iconClass}"></i>
                        <span>${statusText}</span>
                    </button>
                </div>
            `;

            container.append(cardHtml);
        });

        console.log(`Loaded ${qrBanks.length} QR code(s) for company`);
    }

    // Show QR Error
    function showQrError(message) {
        const container = $('#qr-grid-container');
        container.html(`
            <div class="text-center w-100" style="grid-column: 1 / -1; padding: 40px;">
                <i class="fas fa-exclamation-triangle" style="font-size: 48px; color: #dc3545; margin-bottom: 16px;"></i>
                <p style="color: #dc3545; font-size: 16px;">${message}</p>
                <button onclick="location.reload()" class="btn btn-primary" style="margin-top: 16px;">
                    <i class="fas fa-sync"></i> Refresh Page
                </button>
            </div>
        `);
    }

    // Toggle QR Status
    function toggleQrStatus(qrId, button, currentStatus) {
        const card = $(button).closest('.qr-card');
        const badge = card.find('.status-badge');
        const currentActive = parseInt(currentStatus) === 1;
        const newStatus = currentActive ? 0 : 1;

        $(button).prop('disabled', true);

        $.ajax({
            url: '/AddCompany/ActiveQrBank',
            type: 'POST',
            data: {
                QrID: qrId,
                Status: newStatus
            },
            success: function(response) {
                $(button).prop('disabled', false);

                if (response.success) {
                    if (newStatus === 1) {
                        card.removeClass('inactive').addClass('active');
                        badge.removeClass('inactive').addClass('active').text('Active');
                        $(button).removeClass('inactive').addClass('active')
                            .html('<i class="fas fa-check-circle"></i><span>Active</span>');
                    } else {
                        card.removeClass('active').addClass('inactive');
                        badge.removeClass('active').addClass('inactive').text('Inactive');
                        $(button).removeClass('active').addClass('inactive')
                            .html('<i class="fas fa-times-circle"></i><span>Inactive</span>');
                    }

                    $(button).attr('onclick', `toggleQrStatus(${qrId}, this, ${newStatus})`);
                    //console.log(`QR ${qrId} status changed: ${currentActive ? 'Active → Inactive' : 'Inactive → Active'}`);
                } else {
                    alert('Failed to update status: ' + (response.message || 'Unknown error'));
                }
            },
            error: function(xhr, status, error) {
                $(button).prop('disabled', false);
                console.error('AJAX Error:', error);
                alert('Error updating status. Please try again.');
            }
        });
    }

