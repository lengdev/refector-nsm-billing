    // Switch Company Function - UPDATED to load QR codes
    function switchCompany(company, event) {
        const data = companyData[company];
        if (!data || !data.id) {
            console.warn('Company data not found for:', company);
            return; // Exit if company doesn't exist
        }

        currentCompany = company;
        isEditMode = false;

        // Update tab styles - only if event exists (clicked by user)
        if (event) {
            document.querySelectorAll('.company-tab').forEach(tab => {
                tab.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
        }

        // Get data for selected company
        //const data = companyData[company];

        // Update Basic Information
        document.getElementById('company-name-en').value = data.nameEn;
        document.getElementById('company-name-kh').value = data.nameKh;
        document.getElementById('email').value = data.email;
        document.getElementById('website').value = data.website;
        document.getElementById('phone-company').value = data.phoneCompany;
        document.getElementById('phone-customer').value = data.phoneCustomer;
        document.getElementById('vat-number').value = data.vatNumber;

        // Update textareas in Basic Info
        document.querySelector('#basic-info #address-en').value = data.addressEn;
        document.querySelector('#basic-info #address-kh').value = data.addressKh;

        // Update Invoice Template section
        const invoicePrefixes = document.querySelectorAll('#invoice-template .invoice-prefix-value');
        if (invoicePrefixes[0]) invoicePrefixes[0].textContent = data.prefixVAT;
        if (invoicePrefixes[1]) invoicePrefixes[1].textContent = data.prefixNonVAT;
        if (invoicePrefixes[2]) invoicePrefixes[2].textContent = data.prefixProformaVAT;
        if (invoicePrefixes[3]) invoicePrefixes[3].textContent = data.prefixProformaNonVAT;
        if (invoicePrefixes[4]) invoicePrefixes[4].textContent = data.prefixQuotationVAT;
        if (invoicePrefixes[5]) invoicePrefixes[5].textContent = data.prefixQuotationNonVAT;

        // Update Receipt & Credit section
        const companyDataValues = document.querySelectorAll('#invoice-template .company-data-value');
        if (companyDataValues[0]) companyDataValues[0].textContent = data.prefixReceiptVAT;
        if (companyDataValues[1]) companyDataValues[1].textContent = data.prefixReceiptNonVAT;
        if (companyDataValues[2]) companyDataValues[2].textContent = data.prefixCreditNote;
        if (companyDataValues[3]) companyDataValues[3].textContent = data.prefixRequestApproval;
        if (companyDataValues[4]) companyDataValues[4].textContent = data.prefixRequestApproval;

        // Update Advanced/Terms section
        const advancedTextareas = document.querySelectorAll('#advanced .form-textarea');
        if (advancedTextareas[0]) advancedTextareas[0].value = data.termConditionVAT;
        if (advancedTextareas[1]) advancedTextareas[1].value = data.termConditionNonVAT;
        if (advancedTextareas[2]) advancedTextareas[2].value = data.quoteTermVAT;
        if (advancedTextareas[3]) advancedTextareas[3].value = data.quoteTermNonVAT;

        // Update logo based on selected company
        const logoImg = document.getElementById('companyLogo');
        if (logoImg) {
            const logoPath = data.logo
                ? serverRoot + "/CompanyLogo/" + data.logo
                : noimg;

            logoImg.src = logoPath;
            logoImg.onerror = function () {
                console.log("Failed to load logo for " + company + ", using placeholder");
                this.onerror = null;
                this.src = noimg;
            };
        }

        // Update company info sidebar
        document.getElementById('current-company').textContent = data.invoiceTemplateName;
        const companyInfoPs = document.querySelectorAll('.company-info p');
        if (companyInfoPs[1]) {
            const isDefaultStrong = companyInfoPs[1].querySelector('strong');
            if (isDefaultStrong) {
                isDefaultStrong.textContent = data.isDefault;
            }
        }

        // Update logo title
        const logoTitle = document.querySelector('.logo-title');
        if (logoTitle) {
            logoTitle.textContent = data.name;
        }

        // Update the edit button data-id
        const editBtn = document.querySelector('.edit-item');
        if (editBtn) {
            editBtn.setAttribute('data-id', data.id);
        }

        // Reset edit mode UI
        disableEditMode();

        // *** LOAD QR CODES FOR THIS COMPANY ***
        loadQrBanksByCompany(data.id);
    }

    // Switch Tab Function
    function switchTab(tabId) {
        // Update nav items
        document.querySelectorAll('.nav-item').forEach(item => {
            item.classList.remove('active');
        });
        event.currentTarget.classList.add('active');

        // Update tab panes
        document.querySelectorAll('.tab-pane').forEach(pane => {
            pane.classList.remove('active');
        });
        document.getElementById(tabId).classList.add('active');

        // If switching to QR tab, reload QR codes for current company
        if (tabId === 'Qrcode') {
            const currentData = companyData[currentCompany];
            if (currentData && currentData.id) {
                loadQrBanksByCompany(currentData.id);
            }
        }
    }

    // Disable Edit Mode
    function disableEditMode() {
        isEditMode = false;

        document.querySelectorAll('.form-input').forEach(input => {
