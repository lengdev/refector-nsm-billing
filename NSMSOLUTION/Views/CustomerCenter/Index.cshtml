            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Identification / Passport No:</div>';
            row += '<div class="col-4 text-left text-truncate" title="' + CustInfo.CustomerIdentification + '">' + CustInfo.CustomerIdentification + '</div>';
            row += '</div>';
            if (CustInfo.EmployeeName != null) {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">' + "Sale's Name:" + '</div>';
                row += '<div class="col-4 text-left text-nowrap">' + CustInfo.EmployeeName + '</div>';
                row += '</div>';
            }
            if (CustInfo.ContactName != null && CustInfo.ContactName != "") {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">' + "Contact Name:" + '</div>';
                row += '<div class="col-4 text-left">' + CustInfo.ContactName + '</div>';
                row += '</div>';
            }
            $("div#CustInfo-left").html(row);
        });
    }
    function GetCustomerBalance(CustomerID) {
        LoadData("CustomerCenter/GetCustomerBalance?CustomerID=" + CustomerID, function (response) {
            var data = JSON.parse(JSON.parse(response).Data);
            Swal.close();
            if (data) {
                data = data[0];
                var TotalInv = accounting.formatMoney(data.Total, '');
                var CountInv = accounting.formatNumber(data.Invoice);
                var paid = accounting.formatMoney(data.Paid, '');
                var Deposit = accounting.formatMoney(data.DepositFee, '');
                var AR = accounting.formatMoney(data.AR, '');
                $("#TotalInv").html(TotalInv);
                $("#CountInv").html(CountInv + ' invoice(s)');
                $("#Paid").html(paid);
                $("h5#Deposit").html(Deposit);
                $("#Unpaid").html(AR);
            }
            
        });
    }

