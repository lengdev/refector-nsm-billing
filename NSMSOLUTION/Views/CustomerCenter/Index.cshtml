@{ Layout = null; }
<style>
    /* Ensure proper scrolling for the item list */
    .scrollable-list {
        list-style: none;
        padding: 0;
        margin: 0;
        height: calc(100vh - 200px); /* Adjust height based on your layout (account for other elements like search box) */
        overflow-y: auto; /* Enable vertical scroll */
    }

    /* Flex layout for the main layout */
    #mypane, #vertical, #horizontal {
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    #horizontal {
        display: flex;
        width: 100%;
        height: 100%;
    }

    /* Left and center panes */
    /*#left-pane {
        flex: 0 0 30%;
        max-width: 30%;
    }

    #center-pane {
        flex: 0 0 70%;
        max-width: 70%;
    }*/

    .pane-content {
        padding: 10px;
        box-sizing: border-box;
    }

    /* Ensure the sticky search box is within a scrollable container */
    #itemList {
        list-style: none;
        padding: 0;
        margin: 0;
        height: calc(100vh - 100px); /* Adjust based on your layout */
        overflow-y: auto;        
    }

    .sticky-search {
        position: sticky;
        top: 0; /* Ensure it's stuck at the top of its container */
        z-index: 10; /* Ensure it sits above other content */
        background-color: white; /* Make sure the background is set so it is visible above other content */
    }

    .k-item {
        padding: 8px;
        cursor: pointer;
        border-bottom: solid 1px #e8e5e5;
    }

        .k-item.k-state-selected {
            background-color: #e0e0e0;
        }
</style>

