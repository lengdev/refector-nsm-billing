@{
    Layout = null;
}
<div class="row">
    <div class="col">
        @Html.Raw(ViewBag.DrawHTMLForm)
    </div>
    <div class="col">
        @Html.Raw(ViewBag.DrawHTMLFormTotal)
        @Html.Raw(ViewBag.DrawHTMLFormAttachment)

        @*<button type="button" onclick="AddAttachmentFile('Add Attachment File', 'CustomerAttFiles');" id="AddAttachmentFile" class="btn btn-info">
            <i class="fas fa-paperclip"></i> Add Attachment File
        </button>*@

    </div>
</div>
<div class="row mt-3">
    <div class="col">
        <div class="card card-primary card-outline card-tabs">
            <div class="card-header p-0 pt-1 border-bottom-0">
                <ul class="nav nav-tabs" id="Customer_AddCollection_Tab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="PaymentDetail_Tab" data-toggle="pill" href="#Payment_Tab" role="tab" aria-controls="Payment_Tab" aria-selected="true">Payment Detail</a>
                    </li>
                    <li class="nav-item d-none">
                        <a class="nav-link" id="OtherCharge_Tab" data-toggle="pill" href="#Other_Tab" role="tab" aria-controls="Other_Tab" aria-selected="false">Other Charge</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="Payment_Tab" role="tabpanel" aria-labelledby="PaymentDetail_Tab">
                        <div id="gridPaymentDetail"></div>
                        <div id="paymentFooter" class="text-danger text-lg text-right"></div>

                    </div>
                    <div class="tab-pane fade" id="Other_Tab" role="tabpanel" aria-labelledby="OtherCharge_Tab">
                        <div>
                            @Html.Raw(ViewBag.DrawHTMLFormOtherCharge)
                        </div>
                    </div>
                </div>
            </div>
            <!-- /.card -->
        </div>
    </div>
</div>

<script>
    var CustID = "@ViewBag.CustomerID";
    var CustCode = "@ViewBag.CustomerCode";
    $(function () {
        $("#Customer_AddCollection_Tab a").click(function (e) {
            e.preventDefault();
        });

        // Override generated onclick
        var saveBtn = $("[id^='SaveChange_']");
        saveBtn.attr("onclick", null);
        saveBtn.off("click").on("click", function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            SaveChange_Data();
        });

        var divInfo = '<div id="divInfo" class="mr-auto text-danger"></div>';
        $("div.modal-footer button:eq(0)").before(divInfo);

        LoadAllCustInvoice(CustID);

        $("#txtCustomerName_CustomerID").change(function () {
            var CustomerID = $(this).val();
            if (CustomerID != "")
                LoadAllCustInvoice(CustomerID);
            else
                $("#gridPaymentDetail").html("");
        });

        $("#txtCustomerName_CustomerID").val(Customer_ID);
        $("#txtCustomerName_CustName").val(Cust_Name);
        $("#txtCustomerName_CID").val(CustCode);

        // Allow manual typing in SubTotal and Discount to auto-calculate Grand Total
        $(document).off("input change blur", "#SubTotal, #Discount").on("input change blur", "#SubTotal, #Discount", function (e) {
            SumOtherCharge();
            if (e.type === "blur" || e.type === "change") {
                var v = accounting.unformat($(this).val());
                $(this).val(v === 0 ? "" : kendo.toString(v, "n2"));
            }
        });

        // InvoiceType is a Select2 widget — use event delegation to catch change events
        $(document).off('change', '#InvoiceType').on('change', '#InvoiceType', function() {
            ChangeInvoiceType(this);
        });

        function getChequeRow() {
            var $input = $('#ChequeNumber, [name="ChequeNumber"]');
            if ($input.length === 0) {
                // Fallback: find by label text
                return $('label:contains("Cheque No")').closest('tr, .form-group.row');
            }
            var $row = $input.closest('tr');
            if ($row.length === 0) {
                $row = $input.closest('.form-group.row');
            }
            return $row;
        }

        function toggleChequeField() {
            var $cbo = $('[id^="PaymentMenthod"]').first();
            var kCbo = $cbo.data('kendoComboBox') || $cbo.data('kendoDropDownList');
            var txt = kCbo ? kCbo.text() : ($cbo.find('option:selected').text() || '');

            var $row = getChequeRow();
            if (txt && txt.toLowerCase().indexOf('cheque') >= 0) {
                $row.show();
            } else {
                $row.hide();
                $('#ChequeNumber').val('');
            }
        }

        // Native change binding
        $(document).on('change', '[id^="PaymentMenthod"]', function() {
            toggleChequeField();
        });

        // Kendo-specific binding (runs after Kendo widgets initialize)
        setTimeout(function() {
            toggleChequeField();
            // Force ChequeNumber editable in Add Collection screen
            $('#ChequeNumber').prop('readonly', false).removeAttr('readonly').css('background-color', '');
            var $cbo = $('[id^="PaymentMenthod"]').first();
            var kCbo = $cbo.data('kendoComboBox') || $cbo.data('kendoDropDownList');
            if (kCbo) {
                kCbo.bind('change', function() { toggleChequeField(); });
            }
        }, 800);

    });
