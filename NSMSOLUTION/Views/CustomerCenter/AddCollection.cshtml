    function ChangeInvoiceType(e) {
        var module = "";
        // Get the value from the Kendo widget directly
        var combo = $("#InvoiceType").data("kendoComboBox");
        if (combo) {
            module = combo.value();
            // Fallback to text if value is empty
            if (!module) module = combo.text();
        }
        var dropdown = $("#InvoiceType").data("kendoDropDownList");
        if (dropdown) {
            module = dropdown.value();
            if (!module) module = dropdown.text();
        }
        // Last resort: try jQuery val
        if (!module) {
            module = $("#InvoiceType").val();
        }

        console.log("ChangeInvoiceType called, module = '" + module + "'");

        if (module) {
            $.ajax({
                url: ServerRoot + "CustomerCenter/GetNextReceiptNumber",
                type: 'GET',
                data: { Module: module },
                headers: { "Authorization": "Bearer " + access_Token },
                success: function (response) {
                    console.log("GetNextReceiptNumber response:", response);
                    if (response && response.Number) {
                        $("#RVNumber").val(response.Number);
                        $("#RVNumber_PrefixOR").val(response.Prefix);
                        // Trigger change to update any dependent logic
                        $("#RVNumber").trigger("change");
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching next number for module " + module + ": " + error);
                }
            });
        }
    }
</script>

