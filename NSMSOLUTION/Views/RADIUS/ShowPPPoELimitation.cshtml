@{ Layout = null;}
<div class="row">
    <div class="col">
        @Html.Raw(ViewBag.CboRouterID)
    </div>
</div>
<div class="row p-3">
    <div class="col">
        <div id="packagelist"></div>
    </div>
</div>
<script>
    $("#CboRouterID").select2().on("change", function (e) {
        let id = $(this).val();
        getLimitation(id);
    });

    function getLimitation(id) {
        PostData("RADIUS/GetLimitation", {
            RouterIP: id
        }, function (response) {
            var Version = JSON.parse(response).Version;
            if (JSON.parse(response).Data != "") {
                response = JSON.parse(JSON.parse(response).Data);
                var row = `<table id="tblShowPPPoEPackageList" class="table table-bordered table-head-fixed text-nowrap" width="100%" cellspacing="0" cellpadding="5" border="0">
<thead>
<tr class="header"><th>#</th><th>Limitation Name</th><th>IP Pool</th><th>MIN-RX</th><th>MIN-TX</th><th>TX</th><th>RX</th><th>Action</th></tr></thead><tbody>`;
                $.each(response, function (key, val) {
                    row += "<tr>";
                    row += "<td align=\"right\">" + (key + 1) + "</td><td>" + val.Words.name + "</td>";
                    row += "<td>" + (typeof val.Words["ip-pool"] == "undefined" ? "" : val.Words["ip-pool"]) + "</td>";
                    row += "<td>" + formatBytes(val.Words["rate-limit-min-rx"]) + "</td>";
                    row += "<td>" + formatBytes(val.Words["rate-limit-min-tx"]) + "</td>";
                    row += "<td>" + formatBytes(val.Words["rate-limit-rx"]) + "</td>";
                    row += "<td>" + formatBytes(val.Words["rate-limit-tx"]) + "</td>";
                    row += `<td align="center"><a onclick="editProfile(` + id + `,'` + val.Words[".id"] + `', this, '` + val.Words.name + `','` + val.Words["rate-limit-min-rx"] + `','` + val.Words["rate-limit-min-tx"] + `','` + val.Words["rate-limit-rx"] + `','` + val.Words["rate-limit-tx"] + `','` + (typeof val.Words["ip-pool"] == "undefined" ? "" : val.Words["ip-pool"]) + `');" name="Edit" class="btn btn-primary btn-sm" href="javascript:void(0);" title="Edit" alt="Edit"><i class="fa fa-edit"></i></a><a onclick="deleteProfile(` + id + `,'` + val.Words[".id"] + `', this);" name="Delete" class="btn btn-danger btn-sm" href="javascript:void(0);" title="Delete" alt="Delete"><i class="fa fa-trash"></i></a></td>`;
                    row += "</tr>";
                });
                row += "</tbody></table>";
                $("#packagelist").html(row);

                var MyDataTable = $("#tblShowPPPoEPackageList").DataTable({ "responsive": false, lengthMenu: [[30, 50, 100, -1], ['30', '50', '100', 'Show all']], "lengthChange": true, "paging": true, "language": { "emptyTable": "No items to display.", "info": "Showing _START_ to _END_ of _TOTAL_ entries", "infoEmpty": "Showing 0 to 0 of 0 entries", searchPlaceholder: "Search" }, dom: "<'row'<'col-sm-12 col-md-6 d-flex align-items-center justify-content-start'f><'col-sm-12 col-md-6 d-flex align-items-center justify-content-end'B>>" + "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-12 col-md-5'i><'col-sm-12 col-md-7'p>>", buttons: ['pageLength', { extend: 'colvis', text: 'Column visibility', exportOptions: { columns: ':visible' } }, { extend: 'excelHtml5', text: '<i class="fa-regular fa-file-excel"></i> <span class="d-none d-md-inline">Excel</span>', titleAttr: 'Generate Excel', className: 'btn btn-primary btn-sm' }, { extend: 'print', exportOptions: { columns: ':visible' }, text: '<i class="fa fa-print"></i><span class="d-none d-md-inline">Print</span>', titleAttr: 'Print Table', className: 'btn btn-default btn-sm' }] })
                row = '<div class="card-header pl-0 mb-3">'; row += '</div>'; row = ''; row += '<div class="form-group"><div class="input-group">'
                row += '<div class="input-group-prepend"><label for="myInputSearch" class="input-group-text"><i class="fas fa-search"></i></label></div>'
                row += '<input id="myInputSearch" type="search" class="form-control" placeholder="Search" />'; row += '</div></div>'
                $("#TableGride_filter").html(row); $("#TableGride_filter").removeClass("dataTables_filter"); $('#myInputSearch').on('keyup', function () { MyDataTable.search(this.value).draw(); }); $("div.dt-buttons").addClass('btn-group flex-wrap'); $("div.btn-group").removeClass('dt-buttons');
            }
            else {
                $("#packagelist").html('');
            }
        });
    }

    function deleteProfile(RouterID,id, THIS) {
        DoSaveChangeSweetCofirm("RADIUS/DeleteLimitation", { RouterID: RouterID, ProfileID: id }, function (response) {
            $(THIS).closest("tr").remove();
        });
    }
    function editProfile(RouterID, id, THIS, LimitationName, ratelimitminrx, ratelimitmintx, ratelimitrx, ratelimittx, ippool) {
        var row = '<div class="row"><div class="col text-nowrap text-right mb-3"><label class="form-label" for="rate-limit-min-rx">Rate-Limit-Min-RX (MB):</label></div><div class="col"><input value="' + accounting.unformat(formatBytes(ratelimitminrx)) + '" class="form-control" type="number" id="rate-limit-min-rx" name="rate-limit-min-rx" required /></div></div>';
        row += '<div class="row"><div class="col text-nowrap mb-3 text-right"><label class="form-label" for="rate-limit-min-tx">Rate-Limit-Min-TX (MB):</label></div><div class="col"><input value="' + accounting.unformat(formatBytes(ratelimitmintx)) + '" class="form-control" type="number" id="rate-limit-min-tx" name="rate-limit-min-tx" required /></div></div>';
        row += '<div class="row"><div class="col text-nowrap mb-3 text-right"><label class="form-label" for="rate-limit-rx">Rate-Limit-RX (MB):</label></div><div class="col"><input value="' + accounting.unformat(formatBytes(ratelimitrx)) + '" class="form-control" type="number" id="rate-limit-rx" name="rate-limit-rx" required /></div></div>';
        row += '<div class="row"><div class="col text-nowrap mb-3 text-right"><label class="form-label" for="rate-limit-tx">Rate-Limit-TX (MB):</label></div><div class="col"><input value="' + accounting.unformat(formatBytes(ratelimittx)) + '" class="form-control" type="number" id="rate-limit-tx" name="rate-limit-tx" required /></div></div>';
        row += '<div class="row"><div class="col text-nowrap mb-3 text-right"><label class="form-label" for="ippool">IP POOl:</label></div><div class="col"><input value="' + ippool + '" class="form-control" type="text" id="ippool" name="ippool" required /></div></div>';
        
        DialogSweetCofirm(function () {
            var Bytes = 1048576;
            var minrx = $("#rate-limit-min-rx").val();
            var mintx = $("#rate-limit-min-tx").val();
            var rx = $("#rate-limit-rx").val();
            var tx = $("#rate-limit-tx").val();
            var IPPOOL = $("#ippool").val();
            //if (minrx == "") {
            //    isValid = false;
            //    //DialogSweetAlert("error", "Please enter rate-limit-min-rx.", function () {
            //    //    $("#rate-limit-min-rx").focus();
            //    //});
            //}
            minrx = (minrx * Bytes);
            mintx = (mintx * Bytes);
            rx = (rx * Bytes);
            tx = (tx * Bytes);
            var DATA = {
                RouterID: RouterID,
                LimitationName: LimitationName,
                minrx: minrx,
                mintx: mintx,
                rx: rx,
                tx: tx,
                IPPOOL: IPPOOL
            }
            PostData("RADIUS/UpdateLimitation", DATA, function (response) {
                response = JSON.parse(response);
                if (response.Result == 2) {
                    DialogSweetAlert("loadsuccess", response.Message);
                    getLimitation(RouterID);
                }
                else {
                    DialogSweetAlert("error", response.Message);
                }
            });
        }, "", 'Are you sure?<br>Edit: <span class="text-red">' + LimitationName + '</span>', "Save Change", "", row, function () {
            //console.log('done');
        }, false);
        //DoSaveChangeSweetCofirm("RADIUS/DeleteLimitation", { RouterID: RouterID, ProfileID: id }, function (response) {
          //  $(THIS).closest("tr").remove();
        //});
    }
    
</script>

