    function Login() {
        var storedData = JSON.parse(localStorage.getItem("SeleniumDatasessionList")) || [];
        var Id = $("#TxtUserName").val();        
        var session_Id = "";
        var sessionId = storedData.filter(item => item.Id === Id)[0]?.sessionId;
        if (sessionId)
            session_Id = sessionId;

        var DATA = { sessionId: session_Id, Id: Id };       

        DialogSweetAlert('load', 'Login...');
        setTimeout(function () {
            PostData("Taxs/StartSeleniumAsync", DATA, function (response) {
                var rst = JSON.parse(response);
                if (rst.Result == 1) {
                    DialogSweetAlert('error', rst.Message);
                    return false;
                }

                //$("#showcomInof").html(rst.GridData);
                DrawGrid(rst.GridData);
                sessionId = rst.sessionId;
                var storedData = JSON.parse(localStorage.getItem("SeleniumDatasessionList")) || [];
                if (storedData.length > 0) {
                    // Filter out the item with Id = "5"
                    var updatedData = storedData.filter(function (item) {
                        return item.Id != Id; // Keep only the items where Id is not "5"
                    });
                    if (updatedData)
                        sessionList = updatedData;
                    else
                        sessionList = storedData;
                }
                var obj = { Id: Id, sessionId: sessionId, GridData: rst.GridData };
                sessionList.push(obj);
                // Store the list in localStorage as a JSON string
                localStorage.setItem("SeleniumDatasessionList", JSON.stringify(sessionList));

                DialogSweetAlert('message', "Logged Successful!");
            });
        }, 200);
    }

    function LogOut() {
        DialogSweetCofirm(function () {
            var Id = $("#TxtUserName").val();
            var storedData = JSON.parse(localStorage.getItem("SeleniumDatasessionList")) || [];
            if (storedData.length > 0) {
                var sessionId = storedData.filter(item => item.Id === Id)[0]?.sessionId;
                if (sessionId) {
                    var DATA = { sessionId: sessionId };
                    DialogSweetAlert('load', 'Logout...');
                    setTimeout(function () {
                        PostData("Taxs/LogOut", DATA, function (response) {
                            var rst = JSON.parse(response);
                            if (rst.Result == 1) {
                                DialogSweetAlert('error', rst.Message);
                                return false;
                            }
                            storedData = storedData.filter(function (item) {
                                return item.Id !== Id;  // Assuming Id is a string, adjust if it's a number
                            });

                            // Store the updated data back into localStorage
                            localStorage.setItem("SeleniumDatasessionList", JSON.stringify(storedData));
                            DialogSweetAlert('message', "Logout successful.");
                        });
                    }, 200);
                }
                else {
                    DialogSweetAlert('message', "No session for logout.");
                }
            }
            else {
                DialogSweetAlert('message', "No session for logout.");
            }

        }, "", "Are you sure for logout?", "Yes Logout");
    }

    function GetCompanyInfo() {
        var Id = $("#TxtUserName").val();
        var sessionId = "";
        var storedData = JSON.parse(localStorage.getItem("SeleniumDatasessionList")) || [];
        if (storedData) {
            var mysession = storedData.filter(function (item) {
                return item.Id === Id;
            });
            sessionId = mysession.sessionId;

            // If a session is found, get the sessionId
            if (mysession.length > 0) {
                console.log(mysession[0]); // First matching item
                sessionId = mysession[0].sessionId; // Get the session ID
            } else {
                DialogSweetAlert('error', "No session found with the given ID. Please Login First.");
                return false;
            }
        }

        var DATA = { sessionId: sessionId };
        DialogSweetAlert('load');
        setTimeout(function () {
            PostData("Taxs/GetMyCompanyInof", DATA, function (response) {
                var rst = JSON.parse(response);
                console.log(rst);
                if (rst.Result == 1) {
                    DialogSweetAlert('error', rst.Message);
                    return false;
                }
                DialogSweetAlert('message', "Get Successful!");
            });
        }, 200);
    }

