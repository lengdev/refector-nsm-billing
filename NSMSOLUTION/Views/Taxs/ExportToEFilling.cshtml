        var TYPE = $("#selectType").val();
        var COM_ID = $("#CompanyName").val();
        var SheetName = $("#selectSheetName option:selected").text();
        if (kendoData_1726893507.length > 0) {
            var GData = kendoData_1726893507.filter(function (item) {
                return item.ComID === COM_ID;
            })[0];
            if (GData) {
                var TAX_BRANCH = GData.TaxBranchID;
                var IS_BRANCH = false;
                var COM_TYPE = GData.ComType;

                if ($("#grid_willexpot").data("kendoGrid")) {
                    var storedData = JSON.parse(localStorage.getItem("SeleniumDatasessionList")) || [];
                    var userID = $("#TxtUserName").val();
                    // Filter the array and return only the sessionId for the object with Id
                    var sessionId = storedData.filter(item => item.Id === userID)[0]?.sessionId;

                    var data = $("#grid_willexpot").data("kendoGrid").dataSource.view();//.dataSource.data();

                    // Filter numeric keys only to ignore other non-data entries
                    var filteredData = Object.keys(data).filter(key => !isNaN(key)).map(key => data[key]);

                    // Apply filter where both TID and VAT are non-empty
                    var validEntries = filteredData.filter(item => $.trim(item.TID) !== "" || $.trim(item.VAT) !== "");


                    // Create an array of invoices to send as JSON
                    var invoiceArray = [];
                    var allowInsert = true;
                    for (var i = 0; i < validEntries.length; i++) {
                        var invoice = validEntries[i];
                        if (invoice.Name === null || invoice.Name === "") {
                            allowInsert = false;
                            DialogSweetAlert('error', "Please enter Name.");
                            return false;
                        }
                        // Replace null VATPrice with an empty string
                        var VAT = invoice.VAT === null ? "0" : invoice.VAT;
                        var vatPrice = invoice.VATPrice === null ? "0" : invoice.VATPrice;
                        var TID = invoice.TID === null ? "0" : invoice.TID;

                        VAT = VAT === "" ? "0" : VAT;
                        vatPrice = vatPrice === "" ? "0" : vatPrice;
                        TID = TID === "" ? "0" : TID;

                        // Build an object for each invoice
                        var invoiceObject = {
                            TYPE: `${TYPE}`,
                            SheetName: `${SheetName}`,
                            TRANSACTION: `${TYPE}`,
                            sessionId: `${sessionId}`,
                            COM_ID: `${COM_ID}`,
                            TAX_BRANCH: `${TAX_BRANCH}`,
                            IS_BRANCH: `false`,
                            COMPANY_BRANCH: `0`,
                            MONTH: `${moment(formatDate(invoice.InvoiceDate)).format('MM')}`,
                            YEAR: `${moment(formatDate(invoice.InvoiceDate)).format('YYYY')}`,
                            INV_DATE: `${formatDate(invoice.InvoiceDate)}`,
                            INV_NO: `${invoice.InvoiceNumber}`,
                            TOTAL_AMT: accounting.unformat(`${invoice.InvoiceAmount}`),
                            Name: `${invoice.Name}`,
                            VAT: `${VAT}`,
                            VATPrice: `${vatPrice}`,
                            INV_REMARK: `${invoice.Descript}`,
                            TID: `${TID}`,
                            COM_TYPE: `${COM_TYPE}`,
                            insertedInvoice: invoice
                        };
                        // Add to the array
                        invoiceArray.push(invoiceObject);
                    }

                    if (!allowInsert)
                        return false;
                    // Convert the array to a JSON string
                    var jsonData = JSON.stringify(invoiceArray);

                    DialogSweetAlert('load', 'Exporting...');
                    setTimeout(function () {
                        $.ajax({
