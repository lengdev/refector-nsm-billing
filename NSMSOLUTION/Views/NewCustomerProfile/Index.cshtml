<script>
    var AgencyCommissionData = JSON.parse(`@Html.Raw(ViewBag.AgencyCommissionData)`)[0];
    var CustomerID = "@ViewBag.CustomerID";
    var ISSO = "@ViewBag.ISSO";
    var isRegisterForm = "@ViewBag.isRegisterForm";
    var Customer_ID = "";
    //var Cust_Info = "@ViewBag.CustInfo";
    var CustDetail = "@ViewBag.CustDetail";
    var ExchangeRate = "@ViewBag.ExchangeRate";
    ExchangeRate = JSON.parse(ExchangeRate.replace(/&quot;/ig, '"'))[0];
    var CustomerTypeID = 0;
    var CustomerCode = "";
    var Commune = "", District = "", ProvinceCity = "";
    var BusinessTypeID = 0;
    var Cust_Name = "";
    var ServiceID = "";
    var ConnectionTypeID = "";
    var PackageDetailID = "";
    var BillingInvoiceID = "";
    var IndustryTypeData = "";
    var CommuneData = "";

    function LoadCustInfo(CustomerID) {
        LoadData("CustomerProfile/LoadCustInfo?ID=" + CustomerID, function (response) {
            var CustInfo = JSON.parse(JSON.parse(response).data)[0];
            Cust_Name = CustInfo.CustomerName;
            Customer_ID = CustomerID;
            var row = '<div class="row">';
            row += '<div class="col-auto text-left"><i class="far fa-star"></i></div>';
            row += '<div class="col text-left">' + CustInfo.CustomerType + '</div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-user"></i></div>';
            row += '<div class="col text-left"><label>' + CustInfo.CustomerName + '</label></div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-phone"></i></div>';
            row += '<div class="col text-left">' + CustInfo.CustomerMobile + '</div>';
            row += '</div>';
            if (CustInfo.CustomerEmail != "") {
                row += '<div class="row">';
                row += '<div class="col-auto text-left"><i class="fa fa-envelope"></i></div>';
                row += '<div class="col text-left">' + CustInfo.CustomerEmail + '</div>';
                row += '</div>';
            }
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-building"></i></div>';
            row += '<div class="col text-left">' + CustInfo.Address + '.</div>';
            row += '</div>';
            $("div#CustInfo").html(row);
            row = '';
            if (CustInfo.IndustryType != null) {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">Business Type:</div>';
                row += '<div class="col-4 text-left">' + CustInfo.IndustryType + '</div>';
                row += '</div>';
            }
