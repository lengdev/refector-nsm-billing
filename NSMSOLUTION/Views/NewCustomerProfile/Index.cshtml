    function LoadCustMAP(CustomerID) {
        var Map_Data = [];
        LoadData("CustomerProfile/LoadCustMap?ID=" + CustomerID, function (response) {
            response = JSON.parse(response);
            var data = JSON.parse(response.data);
            //var mapAdd = (data[0].GoogleMap_FullAddress == null ? "" : data[0].GoogleMap_FullAddress);
            //if (mapAdd != "") {
            //MapData = data;
            var row = '<div class="row">';
            row += '<div class="col-auto"><label>Location: </label></div>';
            row += '</div>';
            row += '<ul class="row" style="list-style-type: none;">';
            var i = 0;
            $.each(data, function (key, val) {
                var mapAdd = (val.GoogleMap_FullAddress == null ? "" : val.GoogleMap_FullAddress);
                if (mapAdd != "") {
                    i++;
                    var obj = {};
                    obj["GoogleMap_FullAddress"] = val.GoogleMap_FullAddress;
                    obj["GoogleMap_Latitude"] = val.GoogleMap_Latitude;
                    obj["GoogleMap_Longitude"] = val.GoogleMap_Longitude;
                    Map_Data.push(obj);
                    //row += '<div class="row">';
                    //row += '<div class="col-auto"><label>Invoice No.: </label></div>';
                    //row += '<div class="col-auto">' + val.InvoiceNo + '</div>';
                    //row += '<div class="col-auto"><label>Invoice Date: </label></div>';
                    //row += '<div class="col-auto">' + val.InvoiceDate + '</div>';
                    //row += '</div>';
                    row += "<li class=\"col-auto\">" + i + ". <a href=\"javascript:void(0);\" onclick=\"gotoMapLocation('" + val.GoogleMap_FullAddress + "'," + val.GoogleMap_Latitude + ", " + val.GoogleMap_Longitude + ");\">" + val.GoogleMap_FullAddress + "</a></li>";
                }
            });
            row += '</ul>';
            if (Map_Data.length > 0)
                $("#ShowCustMap").html(row);

            PostData("MAP", { Data: JSON.stringify(Map_Data) }, function (response) {
                $("#ShowMap").html(response);
            });
            //LoadData("MAP?Data=" + JSON.stringify(Map_Data), function (response) {
            //    $("#ShowMap").html(response);
            //});
        });
    }
    function LoadCustProfilePicture(CustomerID) {
        LoadData("CustomerProfile/LoadCustProfilePicture?ID=" + CustomerID, function (response) {
            var data = JSON.parse(JSON.parse(response).data);
            var CustomerProfilePicture = data[0].CustomerProfilePicture;
            CustomerProfilePicture = (typeof CustomerProfilePicture == "undefined" ? "" : CustomerProfilePicture);
            CustomerProfilePicture = (CustomerProfilePicture == null ? "" : CustomerProfilePicture);
            var DestinationFile = data[0].DestinationFile;
            var img = ServerRoot + DestinationFile + CustomerProfilePicture;
            img = '<img class="profilepic__image" src="' + img + '" />';
            var row = '<div>';
            row += img;
            row += '</div>';
            row += "<div id=\"addCustPic\" class=\"profilepic__content\" style=\"cursor:pointer\">";
            row += '<span class="profilepic__icon"><i class="fas fa-camera"></i> <i name="deletepiccust" class="far fa-trash-alt"></i> ';
            row += '<a id="apreviewpropic" href="' + ServerRoot + DestinationFile + CustomerProfilePicture + '">';
            row += '<i name="viewprofilepic" class="far fa-eye"></i>';
            row+='</a></span>';
            row += '<span class="profilepic__text">Edit Profile</span>';
            row += '</div>';
            if (CustomerProfilePicture != "") {
                $("#Cust_profilepic").html(row);
                baguetteBox.run('#apreviewpropic');
            }
            else {
                row = '<div class="profilepic__image"><i class="fa fa-8x fa-user-circle text-info"></i></div>';
                row += '<div class="profilepic__content" id="addCustPic" style="cursor:pointer">';
                row += '<span class="profilepic__icon"><i class="fas fa-camera"></i></span>';
                row += '<span class="profilepic__text">Edit Profile</span></div>';
                $("#Cust_profilepic").html(row);
            }
            $("#addCustPic").click(function (ev) {
                elementClicked = $(ev.target);
                var name = (typeof elementClicked.attr('name') == "undefined" ? "" : elementClicked.attr('name'));
                if (name == "")
                    AddCustomerAttachmentFile('AddCustomerProfilePic');
                else if (name == "viewprofilepic") {

                }
                else {
                    DialogSweetCofirm(function () {
                        var URL = "CustomerProfile/SaveChangeCustomerProfilePicture";
                        var DATA = {
                            Data: JSON.stringify({ CustomerName: Cust_Name, CustomerID: Customer_ID, CustomerCode: CustomerCode })
                        };
                        DoSaveChangeData(URL, DATA);
                        row = '<div class="profilepic__image"><i class="fa fa-8x fa-user-circle text-info"></i></div>';
                        row += "<div class=\"profilepic__content\" id=\"addCustPic\" onclick=\"AddCustomerAttachmentFile('AddCustomerProfilePic');\" style=\"cursor:pointer\">";
                        row += '<span class="profilepic__icon"><i class="fas fa-camera"></i></span>';
                        row += '<span class="profilepic__text">Edit Profile</span></div>';
                        $("#Cust_profilepic").html(row);
                    }, '','Do you to delete this file?');
                }
            });
        });
    }
    function AddCustomerAttachmentFile(AddCustomerProfilePic) {
        AddCustomerProfilePic = (typeof AddCustomerProfilePic == "undefined" ? "" : AddCustomerProfilePic)
        var URL = "CustomerProfile/SaveChangeCustomerUploadFile";
        var Title = "Add Attachment File to Customer";
        if (AddCustomerProfilePic != "") {
            URL = "CustomerProfile/SaveChangeCustomerProfilePicture";
            Title = "Add Customer Profile Picture";
        }
        var PrimaryFieldValue = {
            SaveOnItsForm: true,
            CustomerName: Cust_Name,
            CustomerID: Customer_ID,
            URL: URL,
            CustomerCode: CustomerCode
        };
        var uri = "UploadFileForm?AllowOnlyImage=true&ShowAvatar=true";
        if (AddCustomerProfilePic == "")
            uri = "UploadFileForm";

        ShowDialogBox2(Title, 700, 500, uri, PrimaryFieldValue, "DialogAddAttCustFile", function () {
            $("#DialogAddAttCustFile").on('hide.bs.modal', function () {
                if (AddCustomerProfilePic == "")
                    LoadCustAttachmentFile(Customer_ID);
                else
                    LoadCustProfilePicture(Customer_ID);
            });
        });
    }
