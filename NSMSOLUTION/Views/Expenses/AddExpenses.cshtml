    function checkVATRemarkVisibility() {
        var hasVAT = false;
        $("#TblExpensesItem [name='ItemTAX'], #TblExpensesItem input[name='ItemTAX']").each(function () {
            var val = 0;
            var $el = $(this);
            var combo = $el.data("kendoComboBox") || $el.data("kendoDropDownList");
            if (combo) {
                val = parseFloat(combo.value()) || 0;
                if (!val) {
                    var txt = combo.text() || "";
                    if (txt.indexOf("%") >= 0 || txt.toLowerCase().indexOf("vat") >= 0 || txt.toLowerCase().indexOf("tax") >= 0) {
                        var match = txt.match(/\d+(\.\d+)?/);
                        if (match) val = parseFloat(match[0]);
                    }
                }
            } else {
                val = parseFloat($el.val()) || 0;
                if (!val) {
                    var text = $el.is("select") ? $el.find("option:selected").text() : ($el.val() || "");
                    if (text.indexOf("%") >= 0 || text.toLowerCase().indexOf("vat") >= 0 || text.toLowerCase().indexOf("tax") >= 0) {
                        var m = text.match(/\d+(\.\d+)?/);
                        if (m) val = parseFloat(m[0]);
                    }
                }
            }
            if (val > 0) {
                hasVAT = true;
            }
        });

        if (!hasVAT) {
            $("#TblExpensesItem tbody tr").each(function () {
                var taxVal = parseFloat($(this).find("input[name='ItemTAX']").val()) || 0;
                if (taxVal > 0) hasVAT = true;
            });
        }

        if ($("#trVATRemarkRow").length === 0) {
            var vatRowHtml = `
<tr id="trVATRemarkRow" style="display: none;">
    <td colspan="2" style="vertical-align: middle; font-weight: bold; text-align: left; background-color: #f8f9fa; padding: 8px 12px; color: #333;">
        Remark for VAT:
