        </label>
    </td>
    <td align="center">
        <input type="text" class="input2 text-center text-bold" value="${exchangeRateTotalRow}" id="inputExchangeRateTotalRow" name="inputExchangeRateTotalRow">
    </td>
</tr>`;

            $("#TblExpensesItem tfoot tr:last").after(html);
            $('#inputExchangeRateTotalRow').autoNumeric({vMin: "-99999999999", vMax: "9999999999999999999999999999999999999999999999999999999"});
        }
    }

