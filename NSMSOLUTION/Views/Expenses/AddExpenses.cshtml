            } else {
                $("#TblExpensesItem").append("<tfoot>" + vatRowHtml + "</tfoot>");
            }
        }

        $("#divVATRemarkBox").remove();

        if (hasVAT) {
            $("#trVATRemarkRow").stop(true, true).show();
            if (ExistingVATRemark && !$("#VATRemark").val()) {
