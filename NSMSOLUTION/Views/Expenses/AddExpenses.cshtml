            ) || 0;

            var apply = accounting.unformat(
                $(this).find('[name="ApplyAmount"]').val()
            ) || 0;

            originalTotal += original;
            totalApplyAmount += apply;
        });

        var unusedDepositBalance = originalTotal - totalApplyAmount;

        var $tbody = $("#TblAccountVendorDepositDetails tbody");

        $(".vendor-deposit-summary").remove();

        $tbody.after(`
        <tfoot>
        <tr class="vendor-deposit-summary">
            <td colspan="8" style="text-align:right; font-weight:bold;">
                Original Total:
            </td>
            <td style="text-align:right; font-weight:bold;">
                ${originalTotal.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })}
            </td>
        </tr>

        <tr class="vendor-deposit-summary">
            <td colspan="8" style="text-align:right; font-weight:bold;">
                Total Apply Amount:
            </td>
            <td style="text-align:right; font-weight:bold;">
                ${totalApplyAmount.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })}
            </td>
        </tr>

        <tr class="vendor-deposit-summary">
            <td colspan="8" style="text-align:right; font-weight:bold;">
                Unused Deposit Balance:
            </td>
            <td style="text-align:right; font-weight:bold;">
                ${unusedDepositBalance.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })}
            </td>
        </tr></tfoot>
    `);
    }
