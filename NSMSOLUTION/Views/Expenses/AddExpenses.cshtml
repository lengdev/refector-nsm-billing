        isRemovingInvalidTag = true;
        try {
            if (typeof $("#Reference").tagsinput === "function") {
                $("#Reference").tagsinput('removeAll');
                if (validReferences.length > 0) {
                    $.each(validReferences, function (i, ref) {
                        $("#Reference").tagsinput('add', ref);
                    });
                }
            } else {
                $("#Reference").val(validReferences.length > 0 ? ("," + validReferences.join(',')) : "");
            }
        } catch (e) {
            console.log("Error restoring tags:", e);
        }

        $("#Source").val(validSources.length > 0 ? ("," + validSources.join(',')) : "");
        isRemovingInvalidTag = false;
    }

    function LoadDetail(THIS) {
        if (isRemovingInvalidTag) return;

        var Source = $("#Source").val();
        var Reference = removeFirst($("#Reference").val());

        var Sources = Source.split(',').filter(x => x !== "");
        var References = Reference.split(',').filter(x => x !== "");

        var PO = [], RF = [], ADV = [], PostPO = '', PostRF = '', PostADV = '';

        $.each(Sources, function (key, value) {
            var Data = References[key];
            if (!Data) return;

            if (value == "PO") {
                PO.push(Data);
            }
            else if (value == "RF") {
                RF.push(Data);
            }
            else if (value == "ADV") {
                ADV.push(Data);
            }
