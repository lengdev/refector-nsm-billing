    function calRequestPaidAmount() {
        var balance = @balanceAmount;

        var payment = parseFloat($("#txtAmountInput").val().replace(/,/g, "")) || 0;

        var remaining = balance - payment;

        if (IsRequestedPayment)
            remaining = (balance + parseFloat(PreviousPaidAmount)) - payment;

        //console.log(balance, PreviousPaidAmount, payment, IsRequestedPayment)

        if (remaining < 0)
            remaining = 0;

        $("#lblRemainingBalance").text(
            remaining.toLocaleString('en-US', {
                style: 'currency',
                currency: 'USD'
            })
        );
    }

    function calWithExchangeRate() {
        var exchangeRate = accounting.unformat($.trim($("#ExchangeRate").val()));
        var SubTotal = accounting.unformat($.trim($("label[name=GrandTotal]").text()));

        if (!exchangeRate || exchangeRate == 0 || SubTotal <= 0) {
            $("#exchangeRateTotalRow").remove();
            return;
        }

        var rawRiel = SubTotal * exchangeRate;
        var roundedRiel = Math.round(rawRiel);
        var exchangeRateTotalRow = accounting.formatNumber(roundedRiel, 0);
        if ($("#inputExchangeRateTotalRow").length > 0) {
            if (!$("#inputExchangeRateTotalRow").is(":focus")) {
                $("#inputExchangeRateTotalRow").val(exchangeRateTotalRow);
            }
