    function sendVoucherToTelegram(id) {

        $.ajax({
            url: '/Expenses/SendVoucherToTelegram',
            type: 'POST',
            data: { id: id },
            success: function (response) {

                if (response.success) {
                    alert("✅ Voucher sent to Telegram successfully.");
                } else {
                    alert("❌ " + response.message);
                }

            },
            error: function () {
                alert("❌ Error sending voucher.");
            }
        });

    }
