@{
Layout = null;
}
<style>
    /* ─── Reset & Root ─── */
    .up-root *,
    .up-root *::before,
    .up-root *::after {
        box-sizing: border-box;
    }

    .up-root {
        font-family: 'DM Sans', 'Segoe UI', sans-serif;
        background: #f4f6f9;
        min-height: 100vh;
        padding: 1.5rem;
        display: grid;
        grid-template-columns: 230px 1fr;
        gap: 1.25rem;
        align-items: start;
    }

    /* ─── Sidebar ─── */
    .up-sidebar {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 1.75rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .04);
        position: sticky;
        top: 4.3rem;
    }

    .up-avatar-wrap {
        position: relative;
        width: 90px;
        height: 90px;
        margin-bottom: 1rem;
    }

    .up-avatar {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #B5D4F4 0%, #9FE1CB 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 500;
        color: #0C447C;
        letter-spacing: -0.5px;
        border: 3px solid #fff;
        outline: 1px solid #dee2e6;
        cursor: pointer;
        transition: opacity 0.2s;
        overflow: hidden;
    }

    .up-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .up-avatar-badge {
        position: absolute;
        bottom: 2px;
        right: 2px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #fff;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background 0.15s;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
    }

    .up-avatar-badge:hover {
        background: #f1f3f5;
    }

    .up-avatar-badge i {
        font-size: 13px;
        color: #6c757d;
    }

    .up-name {
        font-size: 15px;
        font-weight: 500;
        color: #212529;
        text-align: center;
        margin: 0 0 3px;
        line-height: 1.3;
    }

    .up-role {
        font-size: 12px;
        color: #868e96;
        text-align: center;
        margin: 0 0 1.25rem;
    }

    .up-divider {
        width: 100%;
        height: 1px;
        background: #f1f3f5;
        margin-bottom: 1.25rem;
    }

    .up-stat-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .up-stat {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .up-stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #adb5bd;
        font-weight: 500;
    }

    .up-stat-value {
        font-size: 12.5px;
        color: #495057;
        font-family: 'DM Mono', 'Courier New', monospace;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .up-stat-value.danger {
        color: #dc3545;
    }

    /* ─── Main Panel ─── */
    .up-main {
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, .04);
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    /* ─── Tab Bar ─── */
    .up-tab-bar {
        display: flex;
        border-bottom: 1px solid #f1f3f5;
        padding: 0 1.25rem;
        gap: 0;
        background: #fafafa;
    }

    .up-tab {
        font-family: 'DM Sans', 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 400;
        color: #868e96;
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.9rem 0.75rem;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: -1px;
        outline: none;
    }

    .up-tab i {
        font-size: 15px;
    }

    .up-tab:hover {
        color: #343a40;
    }

    .up-tab.active {
        color: #212529;
        font-weight: 500;
        /* border-bottom-color: #212529; */
    }

    /* ─── Panes ─── */
    .up-pane {
        display: none;
        padding: 1.75rem 1.5rem;
    }

    .up-pane.active {
        display: block;
    }

    /* ─── Form Grid ─── */
    .up-form {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .up-field {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .up-field.full {
        grid-column: 1 / -1;
    }

    .up-label {
        font-size: 11px;
        font-weight: 500;
        color: #868e96;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }

    .up-input-wrap {
        position: relative;
    }

    .up-input-wrap>i {
        position: absolute;
        left: 11px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 15px;
        color: #ced4da;
        pointer-events: none;
        z-index: 1;
    }

    .up-input {
        width: 100%;
        font-family: 'DM Sans', 'Segoe UI', sans-serif;
        font-size: 13.5px;
        padding: 9px 12px 9px 34px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        color: #212529;
        transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
        outline: none;
        -webkit-appearance: none;
    }

    .up-input::placeholder {
        color: #ced4da;
    }

    .up-input:hover {
        border-color: #ced4da;
    }

    .up-input:focus {
        border-color: #74b9e8;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(116, 185, 232, .15);
    }

    /* ─── Form Actions ─── */
    .up-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        margin-top: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid #f1f3f5;
    }

    .up-btn {
        font-family: 'DM Sans', 'Segoe UI', sans-serif;
        font-size: 13px;
        font-weight: 500;
        padding: 8px 18px;
        border-radius: 8px;
        cursor: pointer;
        border: 1px solid #dee2e6;
        transition: all 0.15s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
    }

    .up-btn i {
        font-size: 14px;
    }

    .up-btn-ghost {
        background: #ffffff;
        color: #6c757d;
    }

    .up-btn-ghost:hover {
        background: #f8f9fa;
        color: #343a40;
        border-color: #ced4da;
    }

    .up-btn-primary {
        background: #212529;
        color: #ffffff;
        border-color: #212529;
    }

    .up-btn-primary:hover {
        background: #343a40;
        border-color: #343a40;
    }

    /* ─── Signature Grid ─── */
    .up-sign-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }

    .up-sign-title {
        font-size: 13px;
        font-weight: 500;
        color: #495057;
    }

    .up-sign-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .up-sign-card {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        overflow: hidden;
        position: relative;
        aspect-ratio: 16 / 9;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 5px;
        cursor: pointer;
        transition: border-color 0.15s;
    }

    .up-sign-card:hover {
        border-color: #ced4da;
    }

    .up-sign-card img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .up-sign-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        color: #ced4da;
    }

    .up-sign-placeholder i {
        font-size: 20px;
    }

    .up-sign-placeholder span {
        font-size: 11px;
    }

    .up-sign-dl {
        position: absolute;
        bottom: 7px;
        right: 7px;
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: #fff;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.15s;
        color: #495057;
        font-size: 13px;
        text-decoration: none;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .06);
    }

    .up-sign-card:hover .up-sign-dl {
        opacity: 1;
    }

    .up-sign-add {
        border-style: dashed;
        border-color: #dee2e6;
    }

    .up-sign-add:hover {
        border-color: #adb5bd;
        background: #f1f3f5;
    }

    .up-sign-add .up-sign-placeholder {
        color: #adb5bd;
    }

    /* ─── Upload Modal ─── */
    .up-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .45);
        z-index: 1050;
        align-items: center;
        justify-content: center;
    }

    .up-modal-backdrop.open {
        display: flex;
    }

    .up-modal {
        background: #fff;
        border-radius: 14px;
        box-shadow: 0 8px 40px rgba(0, 0, 0, .18);
        width: 440px;
        max-width: calc(100vw - 2rem);
        overflow: hidden;
        animation: upModalIn .18s ease;
    }

    @@keyframes upModalIn {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.97);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .up-modal-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f1f3f5;
    }

    .up-modal-head h6 {
        margin: 0;
        font-size: 14px;
        font-weight: 500;
        color: #212529;
    }

    .up-modal-close {
        width: 28px;
        height: 28px;
        border-radius: 7px;
        background: none;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #868e96;
        transition: background .15s;
        padding: 0;
    }

    .up-modal-close:hover {
        background: #f1f3f5;
        color: #343a40;
    }

    .up-modal-body {
        padding: 1.5rem 1.25rem;
    }

    .up-drop-zone {
        border: 2px dashed #dee2e6;
        border-radius: 10px;
        padding: 2rem 1rem;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        background: #fafafa;
    }

    .up-drop-zone:hover,
    .up-drop-zone.dragover {
        border-color: #74b9e8;
        background: #f0f8ff;
    }

    .up-drop-zone i {
        font-size: 32px;
        color: #ced4da;
        margin-bottom: .5rem;
        display: block;
        transition: color .2s;
    }

    .up-drop-zone:hover i,
    .up-drop-zone.dragover i {
        color: #74b9e8;
    }

    .up-drop-zone p {
        margin: 0 0 4px;
        font-size: 13.5px;
        color: #495057;
        font-weight: 500;
    }

    .up-drop-zone small {
        font-size: 11px;
        color: #adb5bd;
    }

    /* Multi-file preview list */
    .up-file-list {
        display: none;
        margin-top: 1rem;
        display: none;
        flex-direction: column;
        gap: 8px;
        max-height: 240px;
        overflow-y: auto;
    }

    .up-file-list.has-files {
        display: flex;
    }

    .up-file-item {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 8px 10px;
    }

    .up-file-thumb {
        width: 44px;
        height: 44px;
        border-radius: 6px;
        overflow: hidden;
        flex-shrink: 0;
        background: #e9ecef;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .up-file-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .up-file-thumb i {
        font-size: 20px;
        color: #868e96;
    }

    .up-file-meta {
        flex: 1;
        min-width: 0;
    }

    .up-file-name {
        font-size: 12.5px;
        font-weight: 500;
        color: #343a40;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .up-file-size {
        font-size: 11px;
        color: #adb5bd;
        margin-top: 1px;
    }

    .up-file-status {
        font-size: 11px;
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .up-file-status.pending {
        color: #adb5bd;
    }

    .up-file-status.uploading {
        color: #378ADD;
    }

    .up-file-status.done {
        color: #3B6D11;
    }

    .up-file-status.error {
        color: #A32D2D;
    }

    .up-file-bar-wrap {
        height: 2px;
        background: #e9ecef;
        border-radius: 99px;
        overflow: hidden;
        margin-top: 4px;
    }

    .up-file-bar {
        height: 100%;
        background: #343a40;
        border-radius: 99px;
        width: 0%;
        transition: width .3s;
    }

    .up-file-remove {
        width: 24px;
        height: 24px;
        border-radius: 6px;
        background: none;
        border: 1px solid #dee2e6;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #868e96;
        font-size: 12px;
        padding: 0;
        flex-shrink: 0;
        transition: background .15s, color .15s;
    }

    .up-file-remove:hover {
        background: #fee2e2;
        border-color: #fca5a5;
        color: #dc2626;
    }

    .up-file-remove:disabled {
        opacity: .4;
        cursor: not-allowed;
    }

    /* file count badge in modal header */
    .up-file-count {
        font-size: 11px;
        font-weight: 500;
        background: #f1f3f5;
        color: #495057;
        border-radius: 99px;
        padding: 2px 8px;
        margin-left: 6px;
        display: none;
    }

    .up-upload-progress {
        display: none;
        margin-top: .75rem;
    }

    .up-progress-bar-wrap {
        height: 4px;
        background: #e9ecef;
        border-radius: 99px;
        overflow: hidden;
    }

    .up-progress-bar {
        height: 100%;
        background: #343a40;
        border-radius: 99px;
        width: 0%;
        transition: width .3s;
    }

    .up-progress-label {
        font-size: 11px;
        color: #868e96;
        margin-top: 4px;
        text-align: right;
    }

    .up-modal-foot {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 1rem 1.25rem;
        border-top: 1px solid #f1f3f5;
        background: #fafafa;
    }

    /* ─── Responsive ─── */
    @@media (max-width: 768px) {
        .up-root {
            grid-template-columns: 1fr;
            padding: 1rem;
        }

        .up-sidebar {
            position: static;
        }

        .up-form {
            grid-template-columns: 1fr;
        }

        .up-field.full {
            grid-column: 1;
        }

        .up-sign-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 480px) {
        .up-sign-grid {
            grid-template-columns: 1fr;
        }

        .up-actions {
            flex-direction: column-reverse;
        }

        .up-btn {
            width: 100%;
            justify-content: center;
        }
    }

    /* ============================================================
   DARK MODE — User Profile Settings page
   ============================================================ */
    body.dark-mode .up-root {
        background: var(--dark-bg-primary);
    }

    /* ── Sidebar ── */
    body.dark-mode .up-sidebar,
    body.dark-mode .up-main {
        background: var(--dark-bg-secondary);
        border-color: var(--dark-border-light);
        box-shadow: none;
    }

    body.dark-mode .up-avatar {
        border-color: var(--dark-bg-secondary);
        outline-color: var(--dark-border-medium);
    }

    body.dark-mode .up-avatar-badge {
        background: var(--dark-bg-tertiary);
        border-color: var(--dark-border-medium);
    }

    body.dark-mode .up-avatar-badge:hover {
        background: var(--dark-bg-quaternary);
    }

    body.dark-mode .up-avatar-badge i {
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-name {
        color: var(--dark-text-primary);
    }

    body.dark-mode .up-role {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-divider {
        background: var(--dark-border-light);
    }

    body.dark-mode .up-stat-label {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-stat-value {
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-stat-value.danger {
        color: var(--red-dark);
    }

    /* ── Tab bar ── */
    body.dark-mode .up-tab-bar {
        background: var(--dark-bg-tertiary);
        border-bottom-color: var(--dark-border-light);
    }

    body.dark-mode .up-tab {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-tab:hover {
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-tab.active {
        color: var(--dark-text-primary);
    }

    /* ── Form fields ── */
    body.dark-mode .up-label {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-input-wrap>i {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-input {
        background: var(--dark-bg-tertiary);
        border-color: var(--dark-border-medium);
        color: var(--dark-text-primary);
    }

    body.dark-mode .up-input::placeholder {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-input:hover {
        border-color: var(--dark-border-strong);
    }

    body.dark-mode .up-input:focus {
        border-color: var(--blue-dark);
        background: var(--dark-bg-secondary);
        box-shadow: 0 0 0 3px var(--blue-light-dark);
    }

    body.dark-mode .up-actions {
        border-top-color: var(--dark-border-light);
    }

    /* ── Buttons ── */
    body.dark-mode .up-btn-ghost {
        background: var(--dark-bg-tertiary);
        color: var(--dark-text-secondary);
        border-color: var(--dark-border-medium);
    }

    body.dark-mode .up-btn-ghost:hover {
        background: var(--dark-bg-quaternary);
        color: var(--dark-text-primary);
        border-color: var(--dark-border-strong);
    }

    body.dark-mode .up-btn-primary {
        background: var(--blue-dark);
        color: #fff;
        border-color: var(--blue-dark);
    }

    body.dark-mode .up-btn-primary:hover {
        background: var(--indigo-dark);
        border-color: var(--indigo-dark);
    }

    /* ── Signature grid ── */
    body.dark-mode .up-sign-title {
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-sign-card {
        background: var(--dark-bg-tertiary);
        border-color: var(--dark-border-light);
    }

    body.dark-mode .up-sign-card:hover {
        border-color: var(--dark-border-strong);
    }

    body.dark-mode .up-sign-placeholder {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-sign-dl {
        background: var(--dark-bg-quaternary);
        border-color: var(--dark-border-medium);
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-sign-add {
        border-color: var(--dark-border-medium);
    }

    body.dark-mode .up-sign-add:hover {
        border-color: var(--dark-border-strong);
        background: var(--dark-bg-quaternary);
    }

    body.dark-mode .up-sign-add .up-sign-placeholder {
        color: var(--dark-text-muted);
    }

    /* ── Upload modal ── */
    body.dark-mode .up-modal {
        background: var(--dark-bg-secondary);
    }

    body.dark-mode .up-modal-head {
        border-bottom-color: var(--dark-border-light);
    }

    body.dark-mode .up-modal-head h6 {
        color: var(--dark-text-primary);
    }

    body.dark-mode .up-modal-close {
        border-color: var(--dark-border-medium);
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-modal-close:hover {
        background: var(--dark-bg-quaternary);
        color: var(--dark-text-primary);
    }

    body.dark-mode .up-drop-zone {
        background: var(--dark-bg-tertiary);
        border-color: var(--dark-border-medium);
    }

    body.dark-mode .up-drop-zone:hover,
    body.dark-mode .up-drop-zone.dragover {
        background: var(--blue-light-dark);
        border-color: var(--blue-dark);
    }

    body.dark-mode .up-drop-zone i {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-drop-zone:hover i,
    body.dark-mode .up-drop-zone.dragover i {
        color: var(--blue-dark);
    }

    body.dark-mode .up-drop-zone p {
        color: var(--dark-text-secondary);
    }

    body.dark-mode .up-drop-zone small {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-file-item {
        background: var(--dark-bg-tertiary);
        border-color: var(--dark-border-light);
    }

    body.dark-mode .up-file-thumb {
        background: var(--dark-bg-quaternary);
    }

    body.dark-mode .up-file-thumb i {
        color: var(--dark-text-muted);
    }

    body.dark-mode .up-file-name {
        color: var(--dark-text-primary);
    }

    body.dark-mode .up-file-size {
