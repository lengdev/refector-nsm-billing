</style>

<section class="content py-4">
    <div class="up-root">

        <!-- ── Sidebar ── -->
        <aside class="up-sidebar">
            <div class="up-avatar-wrap">
                <div class="up-avatar" id="avatarCircle">
                    <img id="profilePic" src="~/Content/images/avatar/user.png" alt="Profile photo">
                    <span id="avatarInitials"></span>
                </div>
                <div class="up-avatar-badge" id="newProfilePhoto" title="Change photo">
                    <i class="ti ti-camera"></i>
                </div>
