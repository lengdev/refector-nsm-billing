            <p class="up-name" id="FullName"></p>
            <p class="up-role" id="Job"></p>

            <div class="up-divider"></div>

            <ul class="up-stat-list list-unstyled m-0 w-100">
                <li class="up-stat">
                    <span class="up-stat-label">Phone</span>
                    <span class="up-stat-value" id="Phone"></span>
                </li>
                <li class="up-stat">
                    <span class="up-stat-label">Email</span>
                    <span class="up-stat-value" id="Email"></span>
                </li>
                <li class="up-stat">
                    <span class="up-stat-label">Role</span>
                    <span class="up-stat-value" id="RoleName"></span>
                </li>
                <li class="up-stat">
                    <span class="up-stat-label">Last login</span>
                    <span class="up-stat-value danger" id="Login"></span>
                </li>
            </ul>
        </aside>

        <!-- ── Main Panel ── -->
        <div class="up-main">
            <div class="up-tab-bar" role="tablist">
                <button class="up-tab active" data-pane="pane-info" role="tab" aria-selected="true">
                    <i class="ti ti-user" aria-hidden="true"></i>Information
                </button>
                <button class="up-tab" data-pane="pane-sign" role="tab" aria-selected="false">
                    <i class="ti ti-writing" aria-hidden="true"></i>Signatures
                </button>
            </div>

            <!-- Information Pane -->
            <div class="up-pane active" id="pane-info" role="tabpanel">
                <form id="userSettingsForm" novalidate>
                    <div class="up-form">

                        <div class="up-field">
                            <label class="up-label" for="FullNameInput">Full Name</label>
                            <div class="up-input-wrap">
                                <i class="ti ti-user" aria-hidden="true"></i>
                                <input class="up-input" type="text" id="FullNameInput" name="FullName"
                                    placeholder="Enter full name" required>
                            </div>
                        </div>

                        <div class="up-field">
                            <label class="up-label" for="EmailInput">Email</label>
                            <div class="up-input-wrap">
                                <i class="ti ti-mail" aria-hidden="true"></i>
                                <input class="up-input" type="email" id="EmailInput" name="Email"
                                    placeholder="Enter email address">
                            </div>
                        </div>

                        <div class="up-field">
                            <label class="up-label" for="PhoneInput">Phone</label>
                            <div class="up-input-wrap">
                                <i class="ti ti-phone" aria-hidden="true"></i>
                                <input class="up-input" type="text" id="PhoneInput" name="Telephone"
                                    placeholder="Enter phone number" required pattern="[0-9+ ]{6,15}">
                            </div>
                        </div>

                        <div class="up-field">
                            <label class="up-label" for="JobInput">Position</label>
                            <div class="up-input-wrap">
                                <i class="ti ti-briefcase" aria-hidden="true"></i>
                                <input class="up-input" type="text" id="JobInput" name="Job"
                                    placeholder="Enter position">
                            </div>
                        </div>

                        <div class="up-field">
                            <label class="up-label" for="UsernameInput">Telegram Username</label>
                            <div class="up-input-wrap">
                                <i class="ti ti-brand-telegram" aria-hidden="true"></i>
                                <input class="up-input" type="text" id="UsernameInput" name="TelegramUserName"
                                    placeholder="" required>
                            </div>
                        </div>

                        <div class="up-field">
                            <label class="up-label" for="ImageInput">Image Url <span
                                    class="up-label-hint text-muted text-red text-capitalize">(external
                                    link)</sp> </label>
                            <div class="up-input-wrap">
                                <i class="ti ti-link" aria-hidden="true"></i>
                                <input class="up-input" type="text" id="ImageInput" name="ImageLink" placeholder="">
