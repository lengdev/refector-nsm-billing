                </form>
            </div>

            <!-- Signatures Pane -->
            <div class="up-pane" id="pane-sign" role="tabpanel">
                <div class="up-sign-header">
                    <span class="up-sign-title">Uploaded signatures</span>
                </div>
                <div class="up-sign-grid" id="sign-tab"></div>
            </div>
        </div>
    </div>
</section>

<!-- Hidden file input — multiple -->
<input type="file" id="signatureFileInput" accept="image/*,.pdf" multiple style="display:none">

<!-- Upload Signature Modal -->
<div class="up-modal-backdrop" id="signUploadModal" role="dialog" aria-modal="true" aria-labelledby="signModalTitle">
    <div class="up-modal">
        <div class="up-modal-head">
            <h6 id="signModalTitle">
                <i class="ti ti-writing" aria-hidden="true"
                    style="margin-right:6px;font-size:15px;vertical-align:-2px"></i>Upload Signatures
                <span class="up-file-count" id="signFileCount"></span>
            </h6>
            <button class="up-modal-close" onclick="closeSignModal()" aria-label="Close">
                <i class="ti ti-x" aria-hidden="true" style="font-size:14px"></i>
            </button>
        </div>
        <div class="up-modal-body">
            <div class="up-drop-zone" id="signDropZone">
                <i class="ti ti-cloud-upload" aria-hidden="true"></i>
                <p>Click to browse or drag &amp; drop</p>
                <small>PNG, JPG, GIF, WEBP, PDF &mdash; max 5 MB each &mdash; multiple allowed</small>
            </div>
            <!-- Per-file list -->
            <div class="up-file-list" id="signFileList"></div>
        </div>
        <div class="up-modal-foot">
            <button class="up-btn up-btn-ghost" onclick="closeSignModal()">
                <i class="ti ti-x" aria-hidden="true"></i>Cancel
            </button>
            <button class="up-btn up-btn-primary" id="signUploadBtn" onclick="UploadSignature()" disabled>
                <i class="ti ti-upload" aria-hidden="true"></i>Upload
            </button>
        </div>
    </div>
</div>

<script>
    /* ── Tab switching ── */
    document.querySelectorAll('.up-tab').forEach(function (tab) {
        tab.addEventListener('click', function () {
            document.querySelectorAll('.up-tab').forEach(function (t) {
                t.classList.remove('active');
                t.setAttribute('aria-selected', 'false');
            });
            document.querySelectorAll('.up-pane').forEach(function (p) {
                p.classList.remove('active');
            });
            tab.classList.add('active');
            tab.setAttribute('aria-selected', 'true');
            document.getElementById(tab.dataset.pane).classList.add('active');
        });
    });

    /* ── Avatar initials helper ── */
    function setAvatarInitials(fullName) {
        var parts = (fullName || '').trim().split(/\s+/);
        var initials = parts.length >= 2
            ? (parts[0][0] + parts[parts.length - 1][0]).toUpperCase()
            : (parts[0] || '?')[0].toUpperCase();
        $('#avatarInitials').text(initials);
    }

    /* ── Load profile data ── */
    function LoadUserProfilePic() {
        LoadData("SupportUserProfile/LoadUserProfilePic", function (response) {
            response = JSON.parse(response);

            var $pic = $("#profilePic");
            if (response.HasUserProfilePicture) {
                $pic.attr("src", response.UserPicture).show();
                $('#avatarInitials').hide();
            } else {
                $pic.hide();
                var data = JSON.parse(response.DataSet).Table[0];
                setAvatarInitials(data.FullName);
                $('#avatarInitials').show();
            }

            var data = JSON.parse(response.DataSet).Table[0];

            // Sidebar
            $("#FullName").text(data.FullName);
            $("#Job").text(data.Job);
            $("#Phone").text(data.Telephone);
            $("#Email").text(data.Email);
            $("#RoleName").text(data.RoleName);
            $("#Login").text(moment(data.LoginTime).format("DD-MM-YYYY HH:mm:ss"));

            // Form fields
            $("#FullNameInput").val(data.FullName);
            $("#UserLoginID").val(data.UserLoginID);
            $("#EmailInput").val(data.Email);
            $("#PhoneInput").val(data.Telephone);
            $("#JobInput").val(data.Job);
            $("#UsernameInput").val(data.TelegramUserName);
            $("#ImageInput").val(data.ImageLink);

            // Signatures
            RenderSignatures(data.Signature);
        });
    }

    /* ── Render signature grid ── */
    function RenderSignatures(signatureStr) {
        var $signTab = $('#sign-tab');
        $signTab.empty();

        if (signatureStr) {
            var signs = signatureStr.split('~').filter(Boolean);
            $.each(signs, function (index, value) {
                var fileUrl = '../Uploads/Users/' + value;
                $signTab.append(
                    '<div class="up-sign-card">' +
                    '<img src="' + fileUrl + '" alt="Signature ' + (index + 1) + '">' +
                    '<a href="' + fileUrl + '" download class="up-sign-dl" title="Download">' +
                    '<i class="ti ti-download" aria-hidden="true"></i>' +
                    '</a>' +
                    '</div>'
                );
            });
        }

        // Add-new slot — clicking opens the upload modal
        $signTab.append(
            '<div class="up-sign-card up-sign-add" id="signAddCard" role="button" tabindex="0" ' +
            'title="Upload new signature" onclick="openSignModal()">' +
            '<div class="up-sign-placeholder">' +
            '<i class="ti ti-plus" aria-hidden="true"></i>' +
            '<span>Add signature</span>' +
            '</div>' +
            '</div>'
        );
    }

    /* ══════════════════════════════════════
       Upload Signature Modal — multi-file
    ══════════════════════════════════════ */
    var _signFiles = [];   // array of { file, id, status }
    var _signIdSeq = 0;

    function openSignModal() {
        _signFiles = [];
        _signIdSeq = 0;
        document.getElementById('signatureFileInput').value = '';
        renderFileList();
        document.getElementById('signUploadModal').classList.add('open');
    }

    function closeSignModal() {
        document.getElementById('signUploadModal').classList.remove('open');
    }

    /* Format bytes to human-readable */
    function fmtBytes(bytes) {
        if (bytes < 1024) return bytes + ' B';
        if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
        return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    /* Add files from FileList to queue */
    function addSignFiles(fileList) {
        var allowed = ['image/png', 'image/jpeg', 'image/gif', 'image/webp', 'application/pdf'];
        var maxBytes = 5 * 1024 * 1024;
        var rejected = [];

        Array.prototype.forEach.call(fileList, function (file) {
            if (allowed.indexOf(file.type) === -1) {
                rejected.push(file.name + ' (unsupported type)');
                return;
            }
            if (file.size > maxBytes) {
                rejected.push(file.name + ' (exceeds 5 MB)');
                return;
            }
            _signFiles.push({ file: file, id: ++_signIdSeq, status: 'pending' });
        });

        if (rejected.length) {
            DialogSweetAlert('error', 'Skipped: ' + rejected.join(', '));
        }

        renderFileList();
    }

    /* Remove one file from queue */
    function removeSignFile(id) {
        _signFiles = _signFiles.filter(function (f) { return f.id !== id; });
        renderFileList();
    }

    /* Rebuild the file list UI */
    function renderFileList() {
        var $list = $('#signFileList');
        var $count = $('#signFileCount');
        var $btn = $('#signUploadBtn');
        var $dz = $('#signDropZone');

        $list.empty();

        var pending = _signFiles.filter(function (f) { return f.status === 'pending'; });

        if (_signFiles.length === 0) {
            $list.removeClass('has-files');
            $dz.show();
            $count.hide();
            $btn.prop('disabled', true);
            return;
        }

        $list.addClass('has-files');
        $dz.hide();
        $count.text(_signFiles.length + ' file' + (_signFiles.length > 1 ? 's' : '')).show();
        $btn.prop('disabled', pending.length === 0);

        _signFiles.forEach(function (entry) {
            var isImage = entry.file.type.startsWith('image/');
            var thumbHtml = isImage
                ? '<div class="up-file-thumb"><img src="" data-id="' + entry.id + '" alt=""></div>'
                : '<div class="up-file-thumb"><i class="ti ti-file-type-pdf" aria-hidden="true"></i></div>';

            var statusClass = entry.status;
            var statusText = { pending: 'Ready', uploading: 'Uploading\u2026', done: 'Done', error: 'Failed' }[entry.status] || '';
            var statusIcon = { pending: 'ti-clock', uploading: 'ti-loader', done: 'ti-circle-check', error: 'ti-alert-circle' }[entry.status] || '';

            var removable = (entry.status === 'pending' || entry.status === 'error');

            $list.append(
                '<div class="up-file-item" id="fi-' + entry.id + '">' +
                thumbHtml +
                '<div class="up-file-meta">' +
                '<div class="up-file-name">' + $('<span>').text(entry.file.name).html() + '</div>' +
                '<div class="up-file-size">' + fmtBytes(entry.file.size) + '</div>' +
                '<div class="up-file-status ' + statusClass + '">' +
                '<i class="ti ' + statusIcon + '" aria-hidden="true" style="font-size:12px"></i>' +
                '<span>' + statusText + '</span>' +
                '</div>' +
                '<div class="up-file-bar-wrap" style="' + (entry.status === 'uploading' ? '' : 'display:none') + '">' +
                '<div class="up-file-bar" id="fb-' + entry.id + '"></div>' +
                '</div>' +
                '</div>' +
                '<button class="up-file-remove" ' + (removable ? '' : 'disabled') +
                ' onclick="removeSignFile(' + entry.id + ')" aria-label="Remove">' +
                '<i class="ti ti-x" aria-hidden="true"></i>' +
                '</button>' +
                '</div>'
            );

            // Load image thumbnail async
            if (isImage) {
                var reader = new FileReader();
                reader.onload = (function (id) {
                    return function (e) {
                        $('img[data-id="' + id + '"]').attr('src', e.target.result);
                    };
                })(entry.id);
                reader.readAsDataURL(entry.file);
            }
        });

        // Show drop zone again at bottom as "add more" hint when files already selected
        $dz.show().find('p').text('Add more files');
        $dz.find('small').text('Click or drag to add more');
    }

    /* Upload all pending files sequentially */
    function UploadSignature() {
        var pending = _signFiles.filter(function (f) { return f.status === 'pending'; });
        if (pending.length === 0) return;

        $('#signUploadBtn').prop('disabled', true);

        var chain = Promise.resolve();
        pending.forEach(function (entry) {
            chain = chain.then(function () { return uploadOne(entry); });
        });

        chain.then(function () {
            var failed = _signFiles.filter(function (f) { return f.status === 'error'; });
            if (failed.length === 0) {
                Swal.fire({ icon: 'success', title: 'All signatures uploaded!' })
                    .then(function () {
                        closeSignModal();
                        LoadUserProfilePic();
                    });
            } else {
                var done = _signFiles.filter(function (f) { return f.status === 'done'; }).length;
                Swal.fire({
                    icon: 'warning',
                    title: done + ' uploaded, ' + failed.length + ' failed',
                    text: 'Failed files are still listed — you can retry them.'
                }).then(function () { LoadUserProfilePic(); });
                // Keep failed items; re-enable upload button for retry
                _signFiles = _signFiles.filter(function (f) { return f.status !== 'done'; });
                _signFiles.forEach(function (f) { if (f.status !== 'error') f.status = 'pending'; });
                renderFileList();
            }
        });
    }

    function uploadOne(entry) {
        return new Promise(function (resolve) {
            entry.status = 'uploading';
            updateFileItemStatus(entry);

            var formData = new FormData();
            formData.append('SignatureFile', entry.file);
            formData.append('UserLoginID', $('#UserLoginID').val());

            $.ajax({
                url: 'SupportUserProfile/UploadSignature',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { "Authorization": "Bearer " + access_Token },
                xhr: function () {
                    var xhr = new XMLHttpRequest();
                    xhr.upload.addEventListener('progress', function (e) {
                        if (e.lengthComputable) {
                            var pct = Math.round((e.loaded / e.total) * 100);
                            $('#fb-' + entry.id).css('width', pct + '%');
                        }
                    });
                    return xhr;
                },
                success: function (response) {
                    var res = (typeof response === 'string') ? JSON.parse(response) : response;
                    entry.status = res.success ? 'done' : 'error';
                    updateFileItemStatus(entry);
                    resolve();
                },
                error: function () {
                    entry.status = 'error';
                    updateFileItemStatus(entry);
                    resolve();
                }
            });
        });
    }

    /* Patch a single file row's status without re-rendering the whole list */
    function updateFileItemStatus(entry) {
        var $item = $('#fi-' + entry.id);
        var statusText = { pending: 'Ready', uploading: 'Uploading\u2026', done: 'Done', error: 'Failed' }[entry.status];
        var statusIcon = { pending: 'ti-clock', uploading: 'ti-loader', done: 'ti-circle-check', error: 'ti-alert-circle' }[entry.status];

        $item.find('.up-file-status')
            .attr('class', 'up-file-status ' + entry.status)
            .html('<i class="ti ' + statusIcon + '" aria-hidden="true" style="font-size:12px"></i><span>' + statusText + '</span>');

        if (entry.status === 'uploading') {
            $item.find('.up-file-bar-wrap').show();
            $item.find('.up-file-remove').prop('disabled', true);
        } else {
            $item.find('.up-file-bar-wrap').hide();
            $item.find('.up-file-remove').prop('disabled', entry.status === 'done');
        }
    }

    /* ── Save settings ── */
    function SaveSettings() {
        var form = document.getElementById("userSettingsForm");

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        var formDataObj = Object.fromEntries(
            $("#userSettingsForm").serializeArray().map(function (x) {
                return [x.name, x.value];
            })
        );

        PostData("SupportUserProfile/SaveUserInfo", formDataObj, function (response) {
            var res = JSON.parse(response);

            if (res.success) {
                Swal.fire({
                    icon: "success",
                    title: "Profile updated successfully!"
                }).then(function () {
                    localStorage.removeItem("ImageLink");
                    localStorage.setItem("ImageLink", formDataObj.ImageLink || res.UserPicture || "");

                    location.reload();
                });
            } else {
                DialogSweetAlert("error", res.message || "Update failed");
            }
        });
    }

    /* ── Cancel / reset ── */
    function CancelSettings() {
        LoadUserProfilePic();
    }

    /* ── Init ── */
    $(function () {
        LoadUserProfilePic();

        /* Profile photo */
        $("#newProfilePhoto").click(function () {
            ShowDialogBox2(
                "Update Profile Picture",
                700,
                500,
                "UploadFileForm?AllowOnlyImage=true&ShowAvatar=true",
                { URL: "SupportUserProfile/SaveChangePhotoProfile" },
                "DialogAddAttCustFile",
                function () {
                    $("#DialogAddAttCustFile").on("hide.bs.modal", function () {
                        setTimeout(LoadUserProfilePic, 1200);
                    });
                }
            );
        });

        /* Drop zone — click to browse */
        $('#signDropZone').on('click', function () {
            $('#signatureFileInput').trigger('click');
        });

        /* File input change — multiple files */
        $('#signatureFileInput').on('change', function () {
            if (this.files.length) addSignFiles(this.files);
            this.value = '';  // reset so same file can be re-selected if removed
        });

        /* Drag-and-drop */
        var $dz = $('#signDropZone');

        $dz.on('dragover dragenter', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dz.addClass('dragover');
        });

        $dz.on('dragleave drop', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $dz.removeClass('dragover');
        });

        $dz.on('drop', function (e) {
            var files = e.originalEvent.dataTransfer.files;
            if (files.length) addSignFiles(files);
        });

        /* Close modal on backdrop click */
        $('#signUploadModal').on('click', function (e) {
            if (e.target === this) closeSignModal();
        });

        /* Close modal on Escape key */
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape') closeSignModal();
        });
    });
</script>