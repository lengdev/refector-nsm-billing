@{
    Layout = null;
}
<form name="FrmsendEmail">
    <div class="row">
        <div class="col">
            <div class="card card-outline card-success">
                @*<div class="card-header">
                        <h3 class="card-title">Send Email</h3>
                    </div>*@
                <div class="card-body">
                    <div class="mb-3 floating-label validate-input" data-validate="Mail to is required.">
                            <input type="text" id="txtTo" name="txtTo" class="form-control" placeholder=" " />
                            <label for="txtTo">To</label>
                        </div>
                        <div class="mb-3 floating-label">
                            <input type="email" id="txtCC" class="form-control" placeholder=" " />
                            <label for="txtCC">CC</label>
                        </div>
                        <div class="mb-3 floating-label">
                            <input type="email" id="txtBCC" class="form-control" placeholder=" " />
                            <label for="txtBCC">BCC</label>
                        </div>
                        <div class="mb-3 floating-label validate-input" data-validate="Subject is required.">
                            <input type="text" id="txtSubject" name="txtSubject" class="form-control" placeholder=" " />
                            <label for="txtSubject">Subject</label>
                        </div>
                        @*<div class="mb-3 floating-label"><label for="txtMessage">Message Body</label></div>*@
                        <div class="mb-3 floating-label">
                            <textarea id="txtMessage" placeholder="Message Body"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-12">
                                <div class="card card-outline card-success">
                                    <div class="card-header">
                                        <h3 class="card-title">Attachment File</h3>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-3">
                                                <div class="gallery-container">
                                                    <div class="img-gallery">
                                                        <a class="lightbox" id="attachment_file_a">
                                                            <img id="attachment_file" class="img-fluid" alt="Attachment File" />
                                                            <div class="text-sm imgoverlay text-nowrap" id="invTitle">Invocie No</div>
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</form>
