    var row = 'Dear ' + Data.CustomerName + ',';
    row += '<br /><br />Greeting from NSM SOLUTION CO., LTD.';
    if (EmailType == "mail_invoice_created")
        row += '<br /><br />This email serves as your official invoice.';
    else if (EmailType == "mail_invoice_reminder") {
        row += '<br /><br />This is a billing reminder that your invoice no. ' + Data.InvoiceNo + ' which was generated on ' + Data.InvoiceDate + ' is due on ' + Data.PaymentDueDate + '.';
        subject = 'Payment Reminder ' + (Data.ServiceName != '' ? 'INVOICE #' + Data.InvoiceNo + ' for ' + Data.ServiceName : 'INVOICE #' + Data.InvoiceNo);
    }
    else if (EmailType == "mail_invoice_overdue") {
        row += '<br /><br />This is the notice that your invoice no. ' + Data.InvoiceNo + ' which was generated on ' + Data.InvoiceDate + ' is now overdue.';
        subject = 'Payment Overdue Notice ' + (Data.ServiceName != '' ? 'INVOICE #' + Data.InvoiceNo + ' for ' + Data.ServiceName : 'INVOICE #' + Data.InvoiceNo);
    }
    else if (EmailType == "mail_invoice_confirm") {
        row += '<br /><br />This is a payment receipt for Invoice ' + Data.InvoiceNo + ' sent on ' + $.format.date(addMonths(new Date(), 0), 'dd-MMMM-yyyy') +'.';
        subject = 'Invoice Payment Confirmation ' + (Data.ServiceName != '' ? 'INVOICE #' + Data.InvoiceNo + ' for ' + Data.ServiceName : 'INVOICE #' + Data.InvoiceNo);
