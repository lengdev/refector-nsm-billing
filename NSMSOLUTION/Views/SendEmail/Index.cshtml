                    MessageBody: MessageBoy, CustomerCode: Cust_Code,
                    InvoiceFileName: InvoiceFileName, PDF_FileName: PDF_FileName, PNG_FileName: PNG_FileName
                    //, imgAttachmentFile: imgData,
                    //pdfData: pdfData, NSM_LOGO: imgurl1, NSM_ISP_LOGO: imgurl2
                };
                SaveChageDialogAjaxForm("FrmsendEmail", "SendEmail/Send", DATA, "E-mail Sending Please wait...", function (response) {
                    if (response.Result == 2) {
                        DialogSweetAlert('loadsuccess', "E-mail sent successfully.");
                        DialogSweetAlert("close");
                        $("#CloseModal").click();
                    }
                    else {
                        DialogSweetAlert('error');
                        console.log(response.Message);
                    }
                }, "Get");
            }
            else
                DialogSweetAlert('error', 'Please fill data required.');
        });
    });



