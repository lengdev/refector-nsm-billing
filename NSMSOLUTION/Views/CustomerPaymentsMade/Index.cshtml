@{Layout = null;}
@Html.Raw(ViewBag.DrawHTMLForm)
<script>
    $(function () {
        $("#FromBankName").closest("div.row").hide();
        $("#ChequeNumber").closest("div.row").hide();
        $("#FromPhoneNumber").closest("div.row").hide();

        $("#FromBankName").closest("div.row").parent().removeClass('p-2');
        $("#ChequeNumber").closest("div.row").parent().removeClass('p-2');
        $("#FromPhoneNumber").closest("div.row").parent().removeClass('p-2');
        setTimeout(function () {
            $("#PaymentModeID").change(function () {
                var data = $('#PaymentModeID').select2('data')
                var PaymentMode = data[0].text;
                $("#FromBankName").closest("div.row").hide();
                $("#ChequeNumber").closest("div.row").hide();
                $("#FromPhoneNumber").closest("div.row").hide();

                $("#FromBankName").closest("div.row").parent().removeClass('p-2');
                $("#ChequeNumber").closest("div.row").parent().removeClass('p-2');
                $("#FromPhoneNumber").closest("div.row").parent().removeClass('p-2');

                if (PaymentMode == "Bank Transfer") {
                    $("#FromBankName").closest("div.row").show();
                    $("#FromBankName").closest("div.row").parent().addClass('p-2');
                }
                else if (PaymentMode == "Cheque") { //
                    $("#ChequeNumber").closest("div.row").show();
                    $("#ChequeNumber").closest("div.row").parent().addClass('p-2');
                }
                else if (PaymentMode != "Cash" && PaymentMode != "ATM Withdrawals") {
                    $("#FromPhoneNumber").closest("div.row").show();
                    $("#FromPhoneNumber").closest("div.row").parent().addClass('p-2');
                }
            });
        }, 400);

        $("#Payee").change(function () {
            var CustomerID = $("#CustomerID").val();
            LoadData("CustomerPaymentsMade/TransactionDetails?CustomerID=" + CustomerID, function (response) {
                response = JSON.parse(response).Data;
                $("#divTblTransactionDetails").html(response);
                setTimeout(function () {
                    $("input[name=Unpaid]").autoNumeric({ vMin: '0.00' });
                    $("input[name=Unpaid]").on("keyup", function () {
                        CheckPaymentAmount(this);
                    });
                    row = '<tr>';
                    row += '<td colspan="8" class="text-primary" align="right">';
                    row += '<label>Total Payment Amount:</label></td><td align="right"><label id="TotalPaymentAmount">0.00</label></td>';
                    row += '</tr>';
                    row += '<tr>';
                    row += '<td colspan="8" class="text-red" align="right">';
                    row += '<label>Remain Balance:</label></td><td align="right"><label id="RemainBalance">0.00</label></td>';
                    row += '</tr>';
                    $("#tblCustInvoice tbody tr:last").after(row);
                    $("input[name=BillingInvoiceID]").attr('checked', 'checked');
                    TotalPaymentAmount();

                    $("input[name=BillingInvoiceID]").change(function () {
                        TotalPaymentAmount();
                    });

                    //    $("input[name=BillID]").attr('checked', 'checked');
                    //    if (BillID != "") {
                    //        $("input[name=BillID]").removeAttr('checked');
                    //        $("input[name=BillID]").each(function () {
                    //            var BID = $(this).val();
                    //            if (BillID == BID) {
                    //                $(this).attr('checked', 'checked');
                    //                return;
                    //            }
                    //        });
                    //    }
                }, 300);
            });
        });
        setTimeout(function () {
            $("#Payee").change();
        }, 200);
    });

    function TotalPaymentAmount() {
        var TPaymentAmount = 0;
        var RemainBalance = 0;
        var BL = "";
        $("input[name=Unpaid]").each(function (i) {
            RemainBalance += accounting.unformat($("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(8)").html());
            if ($("input[name=BillingInvoiceID]").eq(i).is(':checked')) {
                TPaymentAmount += accounting.unformat($(this).val());
                if (BL == "" && accounting.unformat($(this).val()) != 0)
                    BL = $("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(1)").text();
                else if (BL != "" && accounting.unformat($(this).val()) != 0)
                    BL += ", " + $("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(1)").text();
            }
        });
        $("label#TotalBalanc").html(accounting.formatMoney(RemainBalance, ''));
        $("label#TotalPaymentAmount").html(accounting.formatMoney(TPaymentAmount, ''));
        RemainBalance = accounting.unformat(RemainBalance) - accounting.unformat(TPaymentAmount);
        $("label#RemainBalance").html(accounting.formatMoney(RemainBalance, ''));
        var desc = "Payment for Invoice#: " + BL + " with amount: " + accounting.formatMoney(TPaymentAmount, '');
        $("#Description").val(desc);
        $("#Reference").val("Invoice#: " + BL);
    }

    function CheckPaymentAmount(THIS) {
        var PaymentAmount = accounting.unformat($(THIS).val());
        var originalAmountDue = $(THIS).closest('tr').index() + 1;
        originalAmountDue = $("#tblCustInvoice tr:eq(" + originalAmountDue + ") td:eq(8)").html();
        if (accounting.unformat(originalAmountDue) < PaymentAmount) {
            DialogSweetAlert("error", "You cannot made payment bigger then " + originalAmountDue + ".");
            $(THIS).val(originalAmountDue).select();
        }
        TotalPaymentAmount();
    }


    function SaveChangeCustomerPayment() {
        let TotalPaymentAmount = accounting.unformat($("#TotalPaymentAmount").html());
        let PaymentID = 0;
        let CustomerID = $("#CustomerID").val();
        let StatusID = $("#StatusID").val();
        let Payer = $("#Payee").val();
        let PaymentDate = StringToDate($("#PaymentDate").val());
        let PaymentMenthod = $("#PaymentModeID").val().toString();
        let FromBankName = $("#FromBankName").val();
        let FromAccountName = $("#FromAccountName").val();
        let FromAccountNumber = $("#FromAccountNumber").val();
        let ToAccountNumber = $("#ToAccountNumber").val().toString();
        let FromPhoneNumber = $("#FromPhoneNumber").val();
        let ToPhoneNumber = $("#ToPhoneNumber").val();
        let ChequeNumber = $("#ChequeNumber").val();
        let Category = $("#PaymentCategoryID").select2('data')[0].text;
        let PaymentDescription = $("#Description").val();
        let ReceivedFromName = $("#ReceivedFromName").val();
        let PaidBy = $("#PaidBy").val();
        let ReferenceNo = $("#Reference").val();
        let ChartOfAccountID = $("#ChartOfAccountID").val().toString();
        let Memo = encodeURIComponent(nl2br($("#Memo").val()));
        let obj = {};
        let FormData = [];

        if (TotalPaymentAmount > 0) {
            var isChecked = $("input[name=BillingInvoiceID]:checked").length;
            if (isChecked > 0) {
                $("input[name=BillingInvoiceID]:checked").each(function (i) {
                    obj = {};
                    let InvoiceNo = $("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(1)").text();
                    let InvoiceDate = StringToDate($("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(2)").html());
                    let IsIncludedVAT = $("#tblCustInvoice tr:eq(" + (i + 1) + ") td:eq(3)").html();
                    let PaymentAmount = $("input[name=Unpaid]").eq(i).val();
                    obj = {
                        PaymentID: PaymentID, CustomerID: CustomerID,
                        //CustomerName: encodeURIComponent($("#Payee").val()),
                        StatusID: StatusID, InvoiceNo: InvoiceNo,
                        Payer: Payer, PaymentDate: PaymentDate,
                        PaymentMenthod: PaymentMenthod, FromBankName: FromBankName,
                        FromAccountName: FromAccountName, FromAccountNumber: FromAccountNumber,
                        ToAccountNumber: ToAccountNumber, FromPhoneNumber: FromPhoneNumber,
                        ToPhoneNumber: ToPhoneNumber, ChequeNumber: ChequeNumber,
                        Category: Category, PaymentDescription: PaymentDescription,
                        ReceivedFromName: ReceivedFromName, PaymentAmount: accounting.unformat(PaymentAmount),
                        PaidBy: PaidBy, ReferenceNo: ReferenceNo,
                        ChartOfAccountID: ChartOfAccountID, Memo: Memo, InvoiceDate: InvoiceDate,
                        IsIncludedVAT: IsIncludedVAT
                    };
                    FormData.push(obj);
                });
                URL = "CustomerPaymentsMade/SaveChangePayment";
                DATA = { PaymentData: JSON.stringify(FormData) };
                DoSaveChageAjaxForm("PaymentInvoice", URL, DATA, "", function (response) {
                    $("#DialogCustomerPaymentsMade").modal('hide');
                    response = JSON.parse(response.OfficialReceiptData)[0];
                    //var OfficialReceiptNo = response.OfficialReceiptNo;
                    var url = window.location.hash;
                    var ID = url.substring(url.indexOf('?'));
                    ID = ID.substring(ID.indexOf('=')).replace(/=/g, '');
                    $("input[name=RD]").eq(0).click();
                    $("#CboSearchText").val(response.CustomerCode);
                    $("#txtStatus").val("All").trigger("change");
                    OpenNewTap('#!/CustomerProfile?ID=' + response.CustomerID);
                    //DATA = {
                    //    CustomerName: response.CustomerName,
                    //    CustomerCode: response.CustomerCode,
                    //    CustomerID: response.CustomerID,
                    //    InvoiceNo: response.InvoiceNo,
                    //    InvoiceDate: response.InvoiceDate,
                    //    IsIncludedVAT: response.IsIncludedVAT,
                    //    StatusID: 10,
                    //    UploadToServer: false,
                    //    OfficialReceiptNo: ''
                    //};
                    //PostData("AddCustomer/InvoiceToPDFandUpload", DATA);
                    DATA = {
                        CustomerID: result.CustomerID,
                        InvoiceNo: result.InvoiceNo,
                        UploadToDMC: false
                        //CustomerName: result.CustomerName,
                        //CustomerCode: result.CustomerCode,
                        //CustomerID: result.CustomerID,
                        //InvoiceNo: result.InvoiceNo,
                        //InvoiceDate: result.InvoiceDate,
                        //IsIncludedVAT: result.ISVAT,
                        //StatusID: result.StatusID,
                        //UploadToServer: false,
                        //OfficialReceiptNo: OfficialReceiptNo
                    };
                    if (Domain_ID == "001,002") {
                        PostData("CustomerReports/UploadInvoiceTODMC", DATA);
                    }
                });
            }
            else {
                DialogSweetAlert("error", "Please choose invoice for payment.");
            }
        }
        else {
            DialogSweetAlert("error", "Cannot make Payment Amount with zero.");
        }
    }
</script>