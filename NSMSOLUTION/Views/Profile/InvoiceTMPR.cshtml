                        </button>
                        <div class="dropdown-menu" role="menu">
                            <a id="ViewPDF" class="dropdown-item" href="javascript:void(0);">View PDF</a>
                            <a id="Download_PDF" class="dropdown-item" href="javascript:void(0);">Download PDF</a>
                        </div>
                    </div>
                    @*<a href="javascript:void(0);" id="NewVendorPO" class="btn btn-sm btn-secondary" data-toggle="tooltip" data-animation="true" data-placement="top" title="New PO" data-bs-original-title="New PO"><i class="fa fa-file"></i> <span class="d-none d-md-inline">New PO</span></a>*@
                    @*<a href="javascript:void(0);" id="NewVendorBill" class="btn btn-sm btn-primary" data-toggle="tooltip" data-animation="true" data-placement="top" title="New Bill" data-bs-original-title="New Bill"><i class="fa fa-file"></i> <span class="d-none d-md-inline">New Bill</span></a>*@
