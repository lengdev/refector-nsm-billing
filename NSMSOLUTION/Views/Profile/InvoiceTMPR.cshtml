</nav>

<div id="" class="bg-white p-2">
    <div id="div_PO">
        <div id="div_show_info">
            @Html.Raw(@ViewBag.Data)
        </div>
        <div id="div_show_PO" style="display:none"></div>
        <div id="div_show_Bill" style="display:none"></div>
        <div id="div_show_receivedNote" style="display:none"></div>
        <div id="div_show_PaymentVoucher" style="display:none"></div>
    </div>
</div>
<script>
    var url = $(location).attr('href');
    var UrlEndPoint = url.split("/")[4];
    var BillNumber = "@ViewBag.BillNumber";
    var PurchaseOrderID = "@ViewBag.PurchaseOrderID";
    var PaymentStatus = "@ViewBag.PaymentStatus";
    var BillID = "@ViewBag.BillID";
    var BillType = "@ViewBag.BillType";
    var OfficialReceipt = "@ViewBag.OfficialReceipt";
    var Status_ID = "@ViewBag.StatusID";
    var Type = "@ViewBag.Type";
    var PRID = "@ViewBag.PRID";
    var PRNumber = "@ViewBag.PRNumber";
    var VendorID = "@ViewBag.VendorID";
    var IsConvertedToPO = "@ViewBag.IsConvertedToPO";
    var div_show_PO = "";
    var div_show_Bill = "";
    var div_show_info = "";
    var div_show_receivedNote = "";
    var div_show_PaymentVoucher = "";
    var StockInID = "@ViewBag.StockInID";
    $(function () {
        $("#PaymentVoucher").hide();
        $("#NewVendorBill").click(function () {
            NewBill(VendorID);
        });
        $("#NewVendorPO").click(function () {
            NewPurchaseOrder(VendorID);
        });
        if (BillID == "") {
            $("#ShowBill").hide();
        }
        $("#ClonePO").hide();
        $("#CloneBill").hide();
        $("#ReceivedNote").hide();
        if (Type == 'PR') {
            if (Status_ID != 60 && Status_ID != 91) {
                $("#Edit").remove();
            }
            $("#ClonePO").show();
            $("#Edit").click(function () {
                var URL = 'Purchase/CreatePurchaseRequest?PrimaryFieldValue=' + PRID + '&Type=EditPR';
                ShowDialogBox("Edit Purchase Request", "Auto", 600, URL, PRID);
            });
            $("#ClonePO").click(function () {
                var URL = 'Purchase/CreatePurchaseRequest?PrimaryFieldValue=' + PRID + '&Type=EditPR&Clone=true';
                ShowDialogBox("Clone Purchase Request", "Auto", 600, URL, PRID);
            });
        }
        
        $("#Print").click(function () {
            $("#div_PO").printThis();
        });

        if (PaymentStatus == 14) {
            $("#Edit").click(function () {
                var URL = 'Bills/CreateBill?PrimaryFieldValue=' + PRID + '&Type=EditBill&Status=ConvertToCreditNote';
                ShowDialogBox("Edit Credit Note", "Auto", 600, URL, PRID);
            });
        }

        var row = '<i class="fa fa-print" aria-hidden="true"></i> Print';
        $("#SaveChange").html(row);
        $("#SaveChange").click(function () {
            $("#div_PO").printThis();
        });
        if (Type == 'PR') {
            let PRStatus = "@ViewBag.PRStatus";
            if (Status_ID == 60 || Status_ID == 90 || Status_ID == 91 || Status_ID == 92) {
                if (PRStatus == 0) {
                    if (UrlEndPoint == "AuthorizePurchaseRequest") {
                        let btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(92);\" id=\"CheckVerify\" class=\"btn btn-primary\">";
                        btn += '<i class="fa-duotone fa-check-to-slot"></i> CheckVerify This PO</button></div>';
                        $("#SaveChange").before(btn);
                        btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(91);\" id=\"DisApprovePR\" class=\"btn btn-danger\">";
                        btn += '<i class="fa-regular fa-ban"></i> Disapprove This PO</button></div>';
                        $("#SaveChange").before(btn);
                        btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(90);\" id=\"ApprovePR\" class=\"btn btn-primary\">";
                        btn += '<i class="fa-regular fa-check-double"></i> Approve This PO</button></div>';
                        $("#SaveChange").before(btn);
                    } 
                }
                else if (PRStatus == 91) {
                    let btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(90);\" id=\"ApprovePR\" class=\"btn btn-primary\">";
                    btn += '<i class="fa-regular fa-check-double"></i> Approve This PO</button></div>';
                    $("#SaveChange").before(btn);
                }
                else if (PRStatus == 92) {
                    if (UrlEndPoint == "AuthorizePurchaseRequest") {
                        btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(91);\" id=\"DisApprovePR\" class=\"btn btn-danger\">";
                        btn += '<i class="fa-regular fa-ban"></i> Disapprove This PO</button></div>';
                        $("#SaveChange").before(btn);
                        btn = "<div class=\"\"><button type=\"button\" onclick=\"ApprovePR(90);\" id=\"ApprovePR\" class=\"btn btn-primary\">";
                        btn += '<i class="fa-regular fa-check-double"></i> Approve This PO</button></div>';
                        $("#SaveChange").before(btn);
                    }
                }
            }

            if (UrlEndPoint == "PurchaseRequest" && Status_ID != 92 && IsConvertedToPO == "") {
                var btn = "<div class=\"\"><button type=\"button\" onclick=\"ConvertToPO();\" id=\"ConvertToBill\" class=\"btn btn-danger\">";
                btn += '<i class="fa fa-file-invoice-dollar"></i> Convert To PO</button></div>';
                $("#SaveChange").before(btn);
            }
        }
        if (Status_ID == 64 && Status_ID != "" && Status_ID != 10 && Status_ID != 60 && Status_ID != 65 && PaymentStatus != 10 && PaymentStatus != 14) {
            if (UrlEndPoint == "EnterBill") {

                $("#VendorPaymentsMade").remove();
                var btn = "<div class=\"\"><button type=\"button\" onclick=\"VendorPaymentsMade(" + VendorID + ", '', '" + BillID + "');\" id=\"VendorPaymentsMade\" class=\"btn btn-danger\">";
                btn += '<i class="fa fa-file-invoice-dollar"></i> Payments</button></div>';
                $("#SaveChange").before(btn);
            }
        }

        if (UrlEndPoint == "EnterBill") {
            $("#ReceivedNote").show();
            $("#VendorCreditNote").remove();
            var btn = "<div class=\"\"><button type=\"button\" id=\"VendorCreditNote\" class=\"btn btn-info\">";
            btn += '<i class="fa fa-add"></i> Convert To Credit Note</button></div>';
            $("#SaveChange").before(btn);

            $("#VendorCreditNote").click(function () {
                var URL = 'Bills/CreateBill?PrimaryFieldValue=' + BillID + '&Type=EditBill&Clone=true&Status=ConvertToCreditNote';
                ShowDialogBox("Credit Note", "Auto", 600, URL, BillID);
            });
        }
        if (PaymentStatus == 10 || PaymentStatus == 15) {
            $("#PaymentVoucher").show();
        }
        if (PurchaseOrderID == 0)
            $("#ShowPO").hide();
        if (PaymentStatus == 11) {
            if (UrlEndPoint == "EnterBill") {
                $("#VendorPaymentsMade").remove();
                let btn = "<div class=\"\"><button type=\"button\" onclick=\"VendorPaymentsMade(" + VendorID + ", '', '" + BillID + "');\" id=\"VendorPaymentsMade\" class=\"btn btn-danger\">";
                btn += '<i class="fa fa-file-invoice-dollar"></i> Payments</button></div>';
                $("#SaveChange").before(btn);
            }
        }
    });

    function ConvertToPO() {
        var URL = 'Purchase/ConvertToPurchaseOrder?PrimaryFieldValue='+PRID+'&BillID=' + BillID + "&Type=''&PR_Number=" + encodeURIComponent(PRNumber) + "&BillNumber=" + encodeURIComponent(BillNumber);
        ShowDialogBox("Convert To PO", "Auto", 600, URL, 0);
    }
       
    function ApprovePR(PRStatus) {
        if (PRStatus == 90 || PRStatus == 92) {
            DoSaveChangeSweetCofirm("Purchase/ApprovePR", { PRID: PRID, PRStatus: PRStatus }, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    $("#BtnSearchVendorPO").click();
                    LoadTableGrid(CurrentPage);
                    //PostData("Profile/InvoiceTMP?VendorID=" + response.VendorID + "&PRID=" + response.PurchaseOrderID + "&Type=PO&ReturnHtmlData=false&ReturnAllHtmlData=true", "", function (result) {
                    //    result = JSON.parse(result);
                    //    response["Data"] = result.Data;
                    //    PostData("PurchaseOrder/SendNotificationToTelegram", response);
                    //});
                }
            });
        }
        else if (PRStatus == 91) {
            DoSaveChangeSweetCofirm("PurchaseOrder/ApprovPO", { PRID: PRID, PRStatus: PRStatus, Comment: $("#txtComment").val() }, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    $("#BtnSearchVendorPO").click();
                    LoadTableGrid(CurrentPage);
                    //PostData("Profile/InvoiceTMP?VendorID=" + response.VendorID + "&PRID=" + response.PurchaseOrderID + "&Type=PO&ReturnHtmlData=false&ReturnAllHtmlData=true", "", function (result) {
                    //    result = JSON.parse(result);
                    //    response["Data"] = result.Data;
                    //    PostData("PurchaseOrder/SendNotificationToTelegram", response);
                    //});
                }
            }, "", "","Disapprove This PO");
        }
    }

</script>

