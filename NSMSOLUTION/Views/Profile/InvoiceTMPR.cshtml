                    <a href="javascript:void(0);" id="Edit" class="btn btn-sm btn-warning text-white" data-toggle="tooltip" data-animation="true" data-placement="top" title="Edit" data-bs-original-title="Edit"><i class="fa-solid fa-pencil"></i> <span class="d-none d-md-inline">Edit</span></a>
                    @*<a href="javascript:void(0);" id="ClonePO" class="btn btn-sm btn-secondary text-white" data-toggle="tooltip" data-animation="true" data-placement="top" title="Clone PO" data-bs-original-title="Clone PO"><i class="fa fa-copy"></i> <span class="d-none d-md-inline">Clone PO</span></a>*@
                    @*<a href="javascript:void(0);" id="CloneBill" class="btn btn-sm btn-secondary text-white" data-toggle="tooltip" data-animation="true" data-placement="top" title="Clone Bill" data-bs-original-title="Clone Bill"><i class="fa fa-copy"></i> <span class="d-none d-md-inline">Clone Bill</span></a>*@
                    @*<a href="javascript:void(0);" onclick="ShowBill('PO');" id="ShowPO" class="btn btn-sm btn-danger" data-toggle="tooltip" data-animation="true" data-placement="top" title="Show PO" data-bs-original-title="Show PO"><i class="fas fa-file"></i> <span class="d-none d-md-inline">Show PO</span></a>*@
                    @*<a href="javascript:void(0);" onclick="ShowBill('Bill');" id="ShowBill" class="btn btn-sm btn-warning text-white" data-toggle="tooltip" data-animation="true" data-placement="top" title="Show Bill" data-bs-original-title="Show Bill"><i class="fas fa-file-invoice"></i> <span class="d-none d-md-inline">Show Bill</span></a>*@
                    @*<a href="javascript:void(0);" onclick="ShowBill('ReceivedNote');" id="ReceivedNote" class="btn btn-sm btn-info" data-toggle="tooltip" data-animation="true" data-placement="top" title="Goods Received Note" data-bs-original-title="Goods Received Note"><i class="fas fa-tasks"></i> <span class="d-none d-md-inline">GSRN</span></a>*@
                    @*<a href="javascript:void(0);" onclick="ShowBill('PaymentVoucher');" id="PaymentVoucher" class="btn btn-sm btn-danger" data-toggle="tooltip" data-animation="true" data-placement="top" title="Payment Voucher (Disburse)" data-bs-original-title="Payment Voucher (Disburse)"><i class="fas fa-file-invoice-dollar"></i> <span class="d-none d-md-inline">Payment Voucher (Disburse)</span></a>*@
                    <div class="btn-group " role="group">
                        <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-envelope"></i> <span class="d-none d-md-inline">Send Email</span>
