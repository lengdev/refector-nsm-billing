    function LoadPaymentsStatus() {
        LoadData("Profile/LoadPaymentsStatus?ID=" + ID, function (result) {
            result = JSON.parse(JSON.parse(result).Data);
            var TotalBill = 0;
            var TotalBillAmount = 0;
            var TotalAmountPaid = 0;
            var TotalPartiallyPaid = 0;
            var TotalUnpaidAmount = 0;
            $.each(result, function (key, value) {
                TotalBill += value.Bill;
                TotalBillAmount += value.BillAmount;
                if (value.StatusID == 10)
                    TotalAmountPaid += value.AmountPaid;
                else if (value.StatusID == 15)
                    TotalPartiallyPaid += value.AmountPaid;
                if (value.StatusID != 10)
                    TotalUnpaidAmount += value.AmountDue;
            });

            var TotalPaid = (TotalAmountPaid * 100) / TotalBillAmount;
            TotalPaid = Math.round(TotalPaid * 100) / 100;
            $("#paidP").html(accounting.formatMoney(TotalPaid, { symbol: "%", format: "%v %s" }));
            $("#paidper").attr("aria-valuenow", TotalPaid);
            $("#paidper").css("width", TotalPaid + "%");

            $("#TotalBill").html(accounting.formatNumber(TotalBill));
            $("#BillAmount").html(accounting.formatMoney(TotalBillAmount));
            $("#PaidAmount").html(accounting.formatMoney(TotalAmountPaid));
            var CountPaidBill = result.filter(function (currentValue, index, arr) {
                return currentValue.StatusID === 10;
            })[0];
            if (CountPaidBill) {
                $("#CountPaidBill").html(accounting.formatNumber(CountPaidBill.Bill));

            }
            var UnpaidAmount = result.filter(function (currentValue, index, arr) {
                return currentValue.StatusID === 11;
            })[0];
            var PartiallyPaid = result.filter(function (currentValue, index, arr) {
                return currentValue.StatusID === 15;
            })[0];
            if (UnpaidAmount) {
                $("#CountUnpaidBill").html(accounting.formatNumber(UnpaidAmount.Bill));
                $("#UnpaidAmount").html(accounting.formatMoney(TotalUnpaidAmount));
                UnpaidAmount = TotalUnpaidAmount;
            }
            else if (TotalUnpaidAmount > 0) {
                var UnpaidAmount_Bill = 0;
                if (PartiallyPaid) {
                    UnpaidAmount_Bill = PartiallyPaid.Bill;
                }
                $("#CountUnpaidBill").html(accounting.formatNumber(UnpaidAmount_Bill));
                $("#UnpaidAmount").html(accounting.formatMoney(TotalUnpaidAmount));
                UnpaidAmount = TotalUnpaidAmount;
            }
            else {
                UnpaidAmount = 0;
                $("#CountUnpaidBill").html("0");
                $("#UnpaidAmount").html("0.00");
            }


            if (PartiallyPaid) {
                $("#PartiallyPaid").html(accounting.formatMoney(TotalPartiallyPaid));
                $("#CountPartiallyPaid").html(accounting.formatNumber(PartiallyPaid.Bill));
                PartiallyPaid = TotalPartiallyPaid;
            }
            else {
                PartiallyPaid = 0;
                $("#PartiallyPaid").html("0.00");
                $("#CountPartiallyPaid").html("0");
            }
            var TotalUnPaid = (UnpaidAmount * 100) / TotalBillAmount;
            TotalUnPaid = Math.round(TotalUnPaid * 100) / 100;
            $("#unpaidP").html(accounting.formatMoney(TotalUnPaid, { symbol: "%", format: "%v %s" }));
            $("#unpaidper").attr("aria-valuenow", TotalUnPaid);
            $("#unpaidper").css("width", TotalUnPaid + "%");

            var TotalPartiallyPaid = (PartiallyPaid * 100) / TotalBillAmount;
            TotalPartiallyPaid = Math.round(TotalPartiallyPaid * 100) / 100;
            $("#parpaidP").html(accounting.formatMoney(TotalPartiallyPaid, { symbol: "%", format: "%v %s" }));
            $("#parpaidper").attr("aria-valuenow", TotalPartiallyPaid);
            $("#parpaidper").css("width", TotalPartiallyPaid + "%");
        });
    }
