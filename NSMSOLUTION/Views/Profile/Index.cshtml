<script>
    var VendorName = "";
    var Bill_Number = "";
    var PO_Number = "";
    var ID = "@ViewBag.ID";
    var OfficalReceiptNo = "";
    $(function () {
        $("#profile_tap a").click(function (e) {
            e.preventDefault();
            $(this).tab("show");
        });
        LoadVendorInfo();
        $("#NewPurchaseOrder").click(function () {
            var _id = ID;
            NewPurchaseOrder(_id);
        });
        $("#NewBill").click(function () {
            var _id = ID;
            NewBill(_id);
        });
        $("#AddCreditNote").click(function () {
            NewBill(ID, 'Credit Note');
        });
        $("#EditVendor").click(function () {
            var _id = ID;
            AddNewVendor(_id);
        });
        $("#Bills_Tap").click(function () {
            LoadBills(ID);
        });
        $("#CreditNote_Tap").click(function () {
            LoadBills(ID, 'CreditNote');
        });
        $("#paymentsmade_Tap").click(function () {
            //if (OfficalReceiptNo != "") {
            //    $("#TxtPaymentsMade").val(OfficalReceiptNo);
            //    $("#BtnSearchPaymentsMade").click();
            //    OfficalReceiptNo = "";
            //} else {
            Load_Payments_Made(ID);
            //}
        });
        $("#PurchaseOrder_Tap").click(function () {
            LoadVendorPO(ID);
        });
        $("#Products_Tap").click(function () {
            LoadVendorProduct(ID);
        });
        setTimeout(function () {
            var loc = window.location.href;
            var Type = getQueryStringValue(loc, 'Type');
            OfficalReceiptNo = getQueryStringValue(loc, 'OfficalReceiptNo');
            if (Type == "PaymentMade") {
                $("#paymentsmade_Tap").click();
            }
            Bill_Number = getQueryStringValue(loc, 'BillNumber');
            if (Bill_Number != "") {
                $("#Bills_Tap").click();
            }
            PO_Number = getQueryStringValue(loc, 'PONumber');
            if (PO_Number != "") {
                $("#PurchaseOrder_Tap").click();
            }
        }, 300);
        LoadPaymentsStatus();
        LoadStock(ID);

        $("[data-widget=pushmenu]").click();

        $("#newProfilePhoto").click(function () {
            var PrimaryFieldValue = {
                URL: 'Profile/SaveChangePhotoProfile?VendorID=' + ID + '&VendorName=' + encodeURIComponent(VendorName)
            };
            ShowDialogBox2("Add Vendor Profile Picture", 700, 500, "UploadFileForm?AllowOnlyImage=true&ShowAvatar=true", PrimaryFieldValue, "DialogAddAttCustFile", function () {
                $("#DialogAddAttCustFile").on('hide.bs.modal', function () {
                    setTimeout(function () {
                        LoadVendorInfo();
                    }, 1600);
                });
            });
        });

        TapScroll();
    });

    $("#StockIn_Tap").click(function () {
        LoadStock(ID);
    });
    $("#StockOut_Tap").click(function () {
        LoadStockOut(ID);
    });
    $("#StockStatus_Tap").click(function () {
        LoadStockStatus(ID);
    });
    $("#StockMaintain_Tap").click(function () {
        LoadStockMaintain(ID);
    });
    function LoadStock(_ID) {
        LoadData('Profile/LoadStock?ID=' + _ID, function (result) {
            var data = JSON.parse(result).data;
            $("#showStock").html(data);
        });
    }
    function LoadStockOut(_ID) {
        LoadData('Profile/LoadStockOut?ID=' + _ID, function (result) {
            var data = JSON.parse(result).data;
            $("#showStockOut").html(data);
        });
    }
    function LoadStockStatus(_ID) {
        LoadData('Profile/LoadStockStatus?ID=' + _ID, function (result) {
            var data = JSON.parse(result).data;
            $("#showStockStatus").html(data);

            setTimeout(function () {
                $("#txtStockStatusDate").data('daterangepicker').remove();

                $('#txtStockStatusDate').daterangepicker({
                    startDate: moment().startOf('month'),
                    endDate: moment().endOf('month'),
                    locale: {
                        format: 'DD-MM-YYYY'
                    },
                    autoApply: true,
                    ranges: {
                        'Today': [moment(), moment()],
                        'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                        'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                        //'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                        'This Month': [moment().startOf('month'), moment().endOf('month')],
                        'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],
                        'This Year': [moment().startOf('year'), moment().endOf('year')],
                        'Last Year': [moment().subtract(1, 'year').startOf('year'), moment().subtract(1, 'year').endOf('year')]
                    }
                });
            }, 200);
        });
    }
    function LoadVendorProduct(_ID) {
        LoadData('Profile/LoadVendorProduct?ID=' + _ID, function (result) {
            var data = JSON.parse(result).data;
            $("#ShowVendorProduct").html(data);
        });
    }
    function LoadStockMaintain(_ID) {
        LoadData('Profile/LoadStockMaintain?ID=' + _ID, function (result) {
            $("#showStockMaintain").html(result);
        });
    }
    function LoadVendorPO(_ID) {
        LoadData('Profile/LoadPurchaseOrder?ID=' + _ID, function (result) {
            var data = JSON.parse(result).data;
            $("#ShowVendorPO").html(data);
            if (PO_Number != "") {
                setTimeout(function () {
                    $("#TXTSearchPO").val(PO_Number);
                    $("#BtnSearchVendorPO").click();
                    PO_Number = "";
                }, 200);
            }
        });
    }
    function LoadBills(ID, Type) {
        Type = (typeof Type == "undefined" ? "Bill" : Type);
        LoadPaymentsStatus(ID);
        LoadData('Profile/LoadBills?ID=' + ID + '&Type=' + Type, function (result) {
            var data = JSON.parse(result).data;
            if (Type == "Bill") {
                $("#ShowVendorBills").html(data);
                if (Bill_Number != "") {
                    setTimeout(function () {
                        $("#txtBillNumberBill").val(Bill_Number);
                        $("#BtnSearchVendorBills").click();
                        Bill_Number = "";
                    }, 200);
                }
            }
            else {
                $("#ShowCreditNote").html(data);
            }
        });
    }
    function LoadVendorInfo() {
        LoadData('Profile/LoadVendorInfo?ID=' + ID, function (result) {
            var data = JSON.parse(result).data;
            data = JSON.parse(data)[0];
            VendorName = data.VendorName;
            $("#ProfileName").html(data.VendorName);
            $("#ProfileType").html(data.VendorType);
            $("#ProfileAddress").html(data.Address);
            $("#ProfileMap").hide();
            $("#ProfileBillingEmail").hide();
            $("#ProfileWebsite").hide();
            $("#ProfileComName").hide();
            $("#ProfileComNameKH").hide();
            $("#ProfileDeskPhone").hide();
            $("#ProfileHendPhone").hide();
            $("#ProfileVEmail").hide();
            if (data.GoogleMap_FullAddress != "") {
                $("#ProfileMap").show();
                var row = "Google Map:<br>";
                row += '<a target="_blank" href="https://www.google.com/maps/place/' + data.GoogleMap_Latitude + ',' + data.GoogleMap_Longitude + '/@@' + data.GoogleMap_Latitude + ',' + data.GoogleMap_Longitude + ',15z">';
                row += data.GoogleMap_FullAddress;
                row += '</a>';
                $("#ProfileMap").html(row);
            }
            $("#ProfileContactName").html('Name: ' + data.ContactPersonName);
            $("#ProfileContactPosition").html('Position: ' + data.Position);
            $("#ProfileContactPhone").html('Phone: ' + data.ContactPhoneNumber);
            if (data.BillingEmail != '') {
                $("#ProfileBillingEmail").show();
                $("#ProfileBillingEmail").html('Billing Email: <a href="mailto:' + data.BillingEmail + '">' + data.BillingEmail + '</a>');
            }
            if (data.Website != '') {
                $("#ProfileWebsite").show();
                $("#ProfileWebsite").html('Website: <a target="_blank" href="' + data.Website + '">' + data.Website + '</a>');
            }
            if (data.CompanyName != '') {
                $("#ProfileComName").show();
                $("#ProfileComName").html(data.CompanyName);
            }
            if (data.CompanyNameKH != '') {
                $("#ProfileComNameKH").show();
                $("#ProfileComNameKH").html(data.CompanyNameKH);
            }
            if (data.DeskPhone != '') {
                $("#ProfileDeskPhone").show();
                $("#ProfileDeskPhone").html('Desk Phone: ' + data.DeskPhone);
            }
            if (data.HendPhone != '') {
                $("#ProfileHendPhone").show();
