
@{ Layout = null;}

<nav class="navbar sticky-top justify-content-end p-2">
    <div class="btn-group flex-wrap panel-toolbar gap-8 px-3 py-2" role="group">
        <button id="Edit" class="btn btn-info btn-sm">
            <i class="ti ti-pencil-minus"></i>
            <span class="d-none d-md-inline">Edit</span>
        </button>
        <button id="CloneRF" class="btn btn-warning btn-sm">
            <i class="ti ti-copy"></i>
            <span class="d-none d-md-inline">Clone RF</span>
        </button>
        <button id="Print" class="btn btn-primary btn-sm">
            <i class="ti ti-printer"></i>
            <span class="d-none d-md-inline">Print</span>
        </button>
    </div>
</nav>

<div id="" class="bg-white p-2">
    <div id="div_container">
        <div id="div_show_info">
            @Html.Raw(@ViewBag.Data)
        </div>
    </div>
</div>
<script>
    var url = $(location).attr('href');
    var UrlEndPoint = url.split("/")[4];
    var Status_ID = "@ViewBag.StatusID";
    var RequestStatusID = "@ViewBag.RequestStatusID";
    var RequestFormID = "@ViewBag.RequestFormID";
    var NeedToCheckUserID = "@ViewBag.NeedToCheckUserID";
    var nextApproverID = "@ViewBag.NextApprovalByUserID";
    var isNextApprovedId = "@ViewBag.NextApproveStatusID";

    $(function () {
        if (Status_ID == 93 || Status_ID == 94) {
            $("#Edit").remove();
        }
        $("#Edit").click(function () {
            var URL = 'RequestForm/CreateRequestForm?PrimaryFieldValue=' + RequestFormID + '&Type=Edit';
            ShowDialogBox("Edit Request Form", "Auto", 600, URL, RequestFormID);
        });
        $("#CloneRF").click(function () {
            var URL = 'RequestForm/CreateRequestForm?PrimaryFieldValue=' + RequestFormID + '&IsClone=true';
            ShowDialogBox("Clone Request Form", "Auto", 600, URL, RequestFormID, "", "", "", "", function () {
                setTimeout(function () {
                    var requestDate = $("input[name=RequestDate]");
                    var requirementDate = $("input[name=RequirementDate]");
                    const currentDate = new Date();
                    const year = currentDate.getFullYear();
                    const month = String(currentDate.getMonth() + 1).padStart(2, '0'); // Months are zero-based
                    const day = String(currentDate.getDate()).padStart(2, '0');

                    const now = `${day}/${month}/${year}`;
                    $(requestDate).val(now);
                    $(requirementDate).val(now);
                }, 100);
            });
        });

        var row = '<i class="ti ti-printer" aria-hidden="true"></i> Print';
        $("#SaveChange").html(row);
        $("#SaveChange, #Print").click(function () {
            $("#div_container").printThis();
        });

        let btn = "";
        if (Status_ID == 60) {
            if (NeedToCheckUserID != 0) {
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(92);\" id=\"CheckVerify\" class=\"btn btn-primary\">";
                btn += '<i class="ti ti-checkbox"></i> CheckVerify </button></div>';
                $("#SaveChange").before(btn);
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
                btn += '<i class="ti ti-circle-dashed-x"></i> Disapprove </button></div>';
                $("#SaveChange").before(btn);
            } else {
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(90);\" id=\"ApproveRF\" class=\"btn btn-primary\">";
                btn += '<i class="ti ti-circle-dashed-check"></i> Approve </button></div>';
                $("#SaveChange").before(btn);
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
                btn += '<i class="ti ti-circle-dashed-x"></i> Disapprove </button></div>';
                $("#SaveChange").before(btn);
            }

            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(93);\" id=\"RejctRA\" class=\"btn btn-danger\">";
            btn += '<i class="ti ti-circle-dashed-x"></i> Reject </button></div>';
            $("#SaveChange").before(btn);

        } else if (Status_ID == 92) {
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(90);\" id=\"ApproveRF\" class=\"btn btn-primary\">";
            btn += '<i class="ti ti-circle-dashed-check"></i> Approve </button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
            btn += '<i class="ti ti-circle-dashed-x"></i> Disapprove </button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(93);\" id=\"RejctRF\" class=\"btn btn-danger\">";
            btn += '<i class="ti ti-circle-dashed-x"></i> Reject </button></div>';
            $("#SaveChange").before(btn);
        }
        if (Status_ID == 90) {
            if (nextApproverID != 0 && isNextApprovedId == 0) {
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(90);\" id=\"ApproveRF\" class=\"btn btn-primary\">";
                btn += '<i class="ti ti-circle-dashed-check"></i> Next approve</button></div>';
                $("#SaveChange").before(btn);
                btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
                btn += '<i class="ti ti-circle-dashed-x"></i> Disapprove </button></div>';
                $("#SaveChange").before(btn);
            }

            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(94);\" id=\"CancelRA\" class=\"btn btn-danger\">";
            btn += '<i class="ti ti-cancel"></i> Cancel </button></div>';
            $("#SaveChange").before(btn);
        }
    });

    function ApproveRF(StatusID) {
        var requestData = {
            EntryID: RequestFormID,
            StatusID: StatusID,
            Comment: $("#txtComment").val()
        }
        if (StatusID == 90 || StatusID == 92) {
            DoSaveChangeSweetCofirm("RequestForm/ApproveRequestForm", requestData, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    LoadTableGrid(CurrentPage);
                }
            });
        }
        else {
            DoSaveChangeSweetCofirm("RequestForm/ApproveRequestForm", requestData, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    LoadTableGrid(CurrentPage);
                }
            }, "", "", "Save");
        }
    }
</script>

