    function ShowStockMaintain() {
        var FromDate = $("#txtStockStockMaintain").data('daterangepicker').startDate.format('YYYY-MM-DD');
        var ToDate = $("#txtStockStockMaintain").data('daterangepicker').endDate.format('YYYY-MM-DD');
        var ItemName = $("#TXT_Item_NameStockMaintain").val();
        var ItemGroup = $("#txt_Item_Group_StockMaintain").val();
        var WarehouseName = $("#txtWarehouseName").val();
        if ($("#txtStockStockMaintain").val() == "") {
            FromDate = "";
            ToDate = "";
        }
        LoadData('Profile/ShowStockMaintain?VendorID=' + VendorID + '&FromDate=' + FromDate + '&ToDate=' + ToDate + '&ItemName=' + ItemName + '&ItemGroup=' + ItemGroup + '&WarehouseName=' + WarehouseName, function (result) {
            $("#trShowStockMaintain").remove();
            $("#TXT_Item_NameStockMaintain").closest("tr").after('<tr id="trShowStockMaintain"><td colspan="3">' + result + '</td></tr>');
        });
    }
</script>