<link href="https://fonts.googleapis.com/css2?family=Moul&display=swap" rel="stylesheet">
<style>
    .moul-regular {
        font-family: "Moul", serif;
        font-weight: 400;
        font-style: normal;
    }

    .mytable-head tr td {
        padding-bottom: 0 !important;
    }

        .mytable-head tr td:first-child {
            font-weight: bold;
        }

    .mytable th, .mytable td {
        border: 1px solid #000000 !important;
    }

    body {
        margin: 0 !important;
        padding: 0 !important;
    }

    @@media print {
        @@page {
            size: A3 !important;
            margin: 20px 20px 0 50px !important;
        }

        .footer {
            width: calc(100% - 20px) !important;
            position: fixed;
            bottom: 0 !important;
        }

        .deposit {
            border: none;
            outline: none;
        }

            .deposit::placeholder {
                color: transparent;
            }
    }
</style>
