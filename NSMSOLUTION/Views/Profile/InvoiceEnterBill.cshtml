                    $("#BtnSearchVendorPO").click();
                    LoadTableGrid(CurrentPage);
                    //PostData("Profile/InvoiceTMP?VendorID=" + response.VendorID + "&POID=" + response.PurchaseOrderID + "&Type=PO&ReturnHtmlData=false&ReturnAllHtmlData=true", "", function (result) {
                    //    result = JSON.parse(result);
                    //    response["Data"] = result.Data;
                    //    PostData("PurchaseOrder/SendNotificationToTelegram", response);
                    //});
                }
            });
        }
        else if (POStatus == 91) {
            DoSaveChangeSweetCofirm("PurchaseOrder/ApprovPO", { POID: POID, POStatus: POStatus, Comment: $("#txtComment").val() }, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
