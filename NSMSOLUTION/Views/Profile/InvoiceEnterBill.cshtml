                        </td>

                        <!-- ✅ Conditional columns -->
                        @if (type != "ReceivingNote" && type != "ReceivingNoteFromStockInOnly")
                        {
                            <td class="text-center">@float.Parse(dr["QTY"].ToString()).ToString("#,#0.000")</td>
                            <td class="text-center">@dr["UM"]</td>
                            <td class="text-center">$@float.Parse(dr["UnitPrice"].ToString()).ToString("#,#0.00")</td>
