<div id="" class="bg-white p-2">
    <div id="div_PO">
        <div id="div_show_info">
            @Html.Raw(@ViewBag.Data)
        </div>
        <div id="div_show_PO" style="display:none"></div>
        <div id="div_show_Bill" style="display:none"></div>
        <div id="div_show_receivedNote" style="display:none"></div>
        <div id="div_show_PaymentVoucher" style="display:none"></div>
    </div>
</div>
<script>
    var url = $(location).attr('href');
    var UrlEndPoint = url.split("/")[4];
    var Status_ID = "@ViewBag.StatusID";
    var RequestStatusID = "@ViewBag.RequestStatusID";
    var RequestFormID = "@ViewBag.RequestFormID";
    $(function () {
        if (Status_ID == 93 || Status_ID == 94) {
            $("#Edit").remove();
        }
        $("#CloneRF").show();
        $("#Edit").click(function () {
            var URL = 'RequestForm/CreateRequestForm?PrimaryFieldValue=' + RequestFormID + '&Type=Edit';
            ShowDialogBox("Edit Request Form", "Auto", 600, URL, RequestFormID);
        });
        $("#CloneRF").click(function () {
            var URL = 'RequestForm/CreateRequestForm?PrimaryFieldValue=' + RequestFormID + '&Type=Edit&Clone=true';
            ShowDialogBox("Clone Request Form", "Auto", 600, URL, RequestFormID, "", "", "", "", function () {
                setTimeout(function () {
                    var requestDate = $("input[name=RequestDate]");
                    var requirementDate = $("input[name=RequirementDate]");
                    const currentDate = new Date();
                    const year = currentDate.getFullYear();
                    const month = String(currentDate.getMonth() + 1).padStart(2, '0'); // Months are zero-based
                    const day = String(currentDate.getDate()).padStart(2, '0');

                    const now = `${day}/${month}/${year}`;
                    $(requestDate).val(now);
                    $(requirementDate).val(now);
                }, 100);
            });
        });

        $("#Print").click(function () {
            $("#div_PO").printThis();
        });

        var row = '<i class="fa fa-print" aria-hidden="true"></i> Print';
        $("#SaveChange").html(row);
        $("#SaveChange").click(function () {
            $("#div_PO").printThis();
        });

        if (Status_ID == 60) {
            let btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(92);\" id=\"CheckVerify\" class=\"btn btn-primary\">";
            btn += '<i class="fa-duotone fa-check-to-slot"></i> CheckVerify This RF</button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
            btn += '<i class="fa-regular fa-ban"></i> Disapprove This RF</button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(93);\" id=\"RejctRF\" class=\"btn btn-danger\">";
            btn += '<i class="fa-regular fa-ban"></i> Reject This RF</button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(90);\" id=\"ApproveRF\" class=\"btn btn-primary\">";
            btn += '<i class="fa-regular fa-check-double"></i> Approve This RF</button></div>';
            $("#SaveChange").before(btn);
        } else if (Status_ID == 92) {
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(91);\" id=\"DisApproveRF\" class=\"btn btn-danger\">";
            btn += '<i class="fa-regular fa-ban"></i> Disapprove This RF</button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(93);\" id=\"RejctRF\" class=\"btn btn-danger\">";
            btn += '<i class="fa-regular fa-ban"></i> Reject This RF</button></div>';
            $("#SaveChange").before(btn);
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(90);\" id=\"ApproveRF\" class=\"btn btn-primary\">";
            btn += '<i class="fa-regular fa-check-double"></i> Approve This RF</button></div>';
            $("#SaveChange").before(btn);
        }

        if (Status_ID == 90) {
            btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(94);\" id=\"CancelRF\" class=\"btn btn-danger\">";
            btn += '<i class="fa-regular fa-ban"></i> Cancel This RF</button></div>';
            $("#SaveChange").before(btn);
        }
        //if (Status_ID == 90 && RequestStatusID == 90) {
        //    btn = "<div class=\"\"><button type=\"button\" onclick=\"ApproveRF(67);\" id=\"RecieveRF\" class=\"btn btn-primary\">";
        //    btn += '<i class="fa-regular fa-check-circle"></i> Receive This RF</button></div>';
        //    $("#SaveChange").before(btn);
        //}
    });

    function ApproveRF(StatusID) {
        if (StatusID == 90 || StatusID == 92 || StatusID == 67) {
            DoSaveChangeSweetCofirm("RequestForm/ApproveRF", { RequestFormID: RequestFormID, StatusID: StatusID }, function (result) {
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    $("#BtnSearchVendorPO").click();
                    LoadTableGrid(CurrentPage);
                }
            });
        }
        else if (StatusID == 91 || StatusID == 94 || StatusID == 93) {
            DoSaveChangeSweetCofirm("RequestForm/ApproveRF", { RequestFormID: RequestFormID, StatusID: StatusID, Comment: $("#txtComment").val() }, function (result) {
                //console.log(result)
                if (result.Result == 2) {
                    $("#CloseModal").click();
                    $("#BunSearch").click();
                    $("#BtnSearchVendorPO").click();
                    LoadTableGrid(CurrentPage);
                }
            }, "", "", StatusID == 91 ? "Disapprove This RF" : (StatusID == 93 ? "Reject This RF" : "Cancel This RF"));
        }
    }
</script>


