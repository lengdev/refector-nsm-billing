@{ Layout = null; }
<style>
    .form-floating .select2-container--bootstrap-5 .select2-selection {
        height: calc(3.5rem + 1px);
        padding: 1rem 0.60rem;
    }

        .form-floating .select2-container--bootstrap-5 .select2-selection > .select2-selection__rendered {
            margin-top: 0.6rem;
            margin-left: 0.25rem;
        }

            .form-floating .select2-container--bootstrap-5 .select2-selection > .select2-selection__rendered > li {
                padding: 1px 3px 1px 3px;
            }

    .form-floating label {
        z-index: 1;
    }

    .w-100 {
        width: 300px !important;
    }

    .table-bordered {
        border: 1px solid #000000 !important;
    }

    @@media print {
        .no-print {
            display: none !important;
        }
    }
</style>
<div class="card card-primary card-outline card-outline-tabs">
    <div class="card-header p-0 border-bottom-0">
        <ul class="nav nav-tabs" id="custTelegramTab" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="custom-tabs-four-home-tab" data-toggle="pill" href="#custom-tabs-four-home" role="tab" aria-controls="custom-tabs-four-home" aria-selected="true">Notification</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-five-messages-tab" data-toggle="pill" href="#custom-tabs-five-messages" role="tab" aria-controls="custom-tabs-five-messages" aria-selected="false">Notification Payment</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-four-profile-tab" data-toggle="pill" href="#custom-tabs-four-profile" role="tab" aria-controls="custom-tabs-four-profile" aria-selected="false">Setting</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="custom-tabs-four-messages-tab" data-toggle="pill" href="#custom-tabs-four-messages" role="tab" aria-controls="custom-tabs-four-messages" aria-selected="false">Contact</a>
            </li>
            <li class="nav-item navbar-nav ml-auto">
                <div class="col-auto">
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="maximize">
                            <i class="fas fa-expand"></i>
                        </button>
                    </div>
                </div>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <div class="tab-content" id="custom-tabs-four-tabContent">
            <div class="tab-pane fade show active" id="custom-tabs-four-home" role="tabpanel" aria-labelledby="custom-tabs-four-home-tab">
                <div id="divCustTelegramNotification"></div>
            </div>
            <div class="tab-pane fade" id="custom-tabs-five-messages" role="tabpanel" aria-labelledby="custom-tabs-five-messages-tab">
                <div class="row">
                    <div class="col-sm-auto col-12 mb-3">
                        <div id="divCustInvoice"></div>
                    </div>
                    <div class="col-sm-auto col-12 mb-3">
                        <div id="divReviseNP"></div>
                    </div>
                    <div class="col">@Html.Raw(ViewBag.DrawInvDate)</div>
                </div>
                <div class="row align-items-center">
                    <div class="col-sm-auto col-12" data-validate="Package Name is required">
                        <input type="text" id="PackageName" class="form-control PackageName w-100" name="PackageName" placeholder="Package Name">
                        <input type="hidden" id="PackageID" class="input2" name="PackageID">
                        <input type="hidden" id="PID" class="input2" name="PID">
                        <input type="hidden" id="Duration" class="input2" name="Duration">
                        <input type="hidden" id="PackageDetailID" class="input2" name="PackageDetailID">
                        <input type="hidden" id="DownSpeed" class="input2" name="DownSpeed">
                        <input type="hidden" id="UpSpeed" class="input2" name="UpSpeed">
                        <input type="hidden" id="Bandwidth" class="input2" name="Bandwidth">
                        <input type="hidden" id="Feature" class="input2" name="Feature">
                        <input type="hidden" id="ChartOfAccountID" class="input2" name="ChartOfAccountID">
                    </div>
                    <div class="col-sm-auto col-12" data-validate="Checked By is required">
                        <input type="text" id="CheckedBy" class="form-control CheckedBy w-100" name="CheckedBy" placeholder="Checked By" autocomplete="off">
                        <input type="hidden" id="CheckedBy_CheckedByUserID" name="CheckedByUserID" value="0">
                        <input type="hidden" id="CheckedBy_CheckedByTelegramUserName" name="CheckedByTelegramUserName" value="">
                    </div>
                    <div class="col-sm-auto col-12" data-validate="Approved By is required">
                        <input type="text" id="ApprovedBy" class="form-control ApprovedBy w-100" name="ApprovedBy" placeholder="Approved By" autocomplete="off">
                        <input type="hidden" id="ApprovedBy_ApprovedByUserID" name="ApprovedByUserID" value="0">
                        <input type="hidden" id="ApprovedBy_ApprovedByTelegramUserName" name="ApprovedByTelegramUserName" value="">
                    </div>
                    <div class="col-sm-auto col-12 mt-1 mt-sm-0">
                        <button class="btn btn-outline-success" type="button" name="btnAddServiceRow" id="btnAddServiceRow" title="Add Service Row"><i class="fa fa-plus mr-1"></i> Add Service</button>
                    </div>
                    <div class="col-sm-auto col-12 mt-1 mt-sm-0">
                        <button class="btn btn-primary" name="btnSaveNotificationPayment" id="btnSaveNotificationPayment" title="Save & Send to Telegram"><i class="fa-regular fa-floppy-disk mr-1"></i> Save</button>
                    </div>
                    <div class="col-sm-auto col-12 mt-1 mt-sm-0">
                        <button class="btn btn-outline-primary" name="btnSendNotificationPayment" id="btnSendNotificationPayment" title="Send"><i class="fa-regular fa-paper-plane-top"></i></button>
                    </div>
                    <div class="col-sm-auto col-12 mt-1 mt-sm-0">
                        <button class="btn btn-outline-primary" name="btnDownload" id="btnDownload" title="Download"><i class="fa-regular fa-download"></i></button>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col table-responsive divNotificationPayment">
                        <div id="divNotificationPayment"></div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="custom-tabs-four-profile" role="tabpanel" aria-labelledby="custom-tabs-four-profile-tab">
                <div class="row">
                    <div class="col">
                        <div class="card card-outline card-primary">
                            <div class="card-body">
                                <div id="divcboCustPhone"></div>
                                <div class="row mt-3">
                                    <div class="col">
                                        <div class="card card-default">
                                            <div class="card-header">
                                                <h3 class="card-title">Notification</h3>
                                            </div>
                                            <!-- /.card-header -->
                                            <div class="card-body">
                                                <form>
                                                    <div class="row">
                                                        <div class="col">
                                                            <!-- checkbox -->
                                                            <div class="form-group" id="divNotificationList"></div>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                            <!-- /.card-body -->
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col text-right">
                                        <button type="button" id="SaveChangeNotification" name="SaveChangeNotification" class="btn btn-outline-primary"><i class="fa fa-save"></i> Save Change</button>
                                    </div>
                                </div>
                            </div>
                            <!-- /.card-body -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="tab-pane fade" id="custom-tabs-four-messages" role="tabpanel" aria-labelledby="custom-tabs-four-messages-tab">
                @Html.Raw(ViewBag.DrawHTMLSearchForm)
            </div>
        </div>
    </div>
    <!-- /.card -->
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    var CustomerCode = "@ViewBag.CustomerCode";
    var CustomerName = @Html.Raw(Json.Encode(ViewBag.CustomerName ?? ""));
    var ExchangeRate = "@ViewBag.ExchangeRate";
    var CustInvoice = @Html.Raw(Json.Encode(ViewBag.CustInvoice != null ? ViewBag.CustInvoice.ToString() : ""));
    var CustomerID = "@ViewBag.CustomerID";
    var CustPhone = JSON.parse(@Html.Raw(Json.Encode(ViewBag.CustPhone != null ? ViewBag.CustPhone.ToString() : "[]")));
    var NotificationList = JSON.parse(@Html.Raw(Json.Encode(ViewBag.NotificationList != null ? ViewBag.NotificationList.ToString() : "[]")));
    var ApprovedByData = JSON.parse(@Html.Raw(Json.Encode(ViewBag.ApprovedByJson != null ? ViewBag.ApprovedByJson.ToString() : "[]")));
    var CheckedByData = JSON.parse(@Html.Raw(Json.Encode(ViewBag.CheckedByJson != null ? ViewBag.CheckedByJson.ToString() : (ViewBag.ApprovedByJson != null ? ViewBag.ApprovedByJson.ToString() : "[]"))));

    // ── Lazy-init flags: tab content that depends on visible layout (select2,
    // the injected invoice table, daterangepickers) must NOT be built while its
    // pane is display:none, or it measures 0 width and renders wrong. We build
    // it the first time each tab is actually shown instead of at page load.
    var settingTabLoaded = false;
    var invoiceTabLoaded = false;

    $(function () {
        var row = `<div class="form-floating"><select class="form-select" id="CboCustPhone" name="CboCustPhone">`;
        $.each(CustPhone, function (key, value) {
            row += `<option data-bind-value="` + value.TelegramNotificationID + `" value="` + value.TelegramCustomerID + `">` + value.CustomerPhone + `</option>`;
        });
        row += `</select><label for="floatingSelect">Customer Phone Number</label></div>`;
        $("div#divcboCustPhone").html(row);

        $("#custTelegramTab a").click(function (e) {
            e.preventDefault();
        });

        row = "";
        $.each(NotificationList, function (key, value) {
            row += `<div class="custom-control custom-checkbox">
                <input class="custom-control-input" type="checkbox" name="chNotification" value="`+ value.TelegramNotificationID + `" id="chNotifcationList_` + value.TelegramNotificationID + `" checked>
                <label for="chNotifcationList_`+ value.TelegramNotificationID + `" class="custom-control-label">` + value.Description + `</label>
            </div>`;
        });
        $("#divNotificationList").html(row);

        $("#CboCustPhone").change(function () {
            if ($(this).val() != null) {
                var TelegramNotificationIDs = $('option:selected', this).attr("data-bind-value");
                $("input[name=chNotification]").prop('checked', false);
                if (TelegramNotificationIDs != "") {
                    var TNotificationIDs = TelegramNotificationIDs.split(",");
                    $.each(TNotificationIDs, function (key, value) {
                        $("#chNotifcationList_" + value + "").prop('checked', true);
                    });
                }
            }
        });

        // NOTE: removed the eager $("#CboCustPhone").trigger("change") that used
        // to run here while the Setting pane was still hidden. It now runs from
        // initSettingTab() below, only once that pane is actually shown.

        $("#SaveChangeNotification").click(function () {
            if ($("#CboCustPhone").val() != null) {
                var TelegramNotificationIDs = $("input[name=chNotification]:checkbox:checked").map(function () {
                    return $(this).val();
                }).toArray();
                var TelegramCustomerID = $("#CboCustPhone").val();
                DoSaveChangeData("CustomerProfile/SaveChangeCustTelegramNotification", {
                    TelegramCustomerID: TelegramCustomerID,
                    TelegramNotificationIDs: TelegramNotificationIDs.toString()
                }, function (response) {
                    $('#CboCustPhone option:selected').attr("data-bind-value", TelegramNotificationIDs.toString());
                });
            } else {
                DialogSweetAlert("error", "Please select Customer Phone Number.");
            }
        });

        LoadData("CustomerProfile/ShowCustomerTelegramNotification/?CustomerID=" + CustomerID, function (response) {
            $("#divCustTelegramNotification").html(response);
        });

        if (CustInvoice != "" && CustInvoice != null) {
            try { CustInvoice = JSON.parse(CustInvoice); } catch(e) { CustInvoice = []; }
            var row = `<div class="mt-1 floating-label"><select class="form-control" id="CboCustInvoice" name="CboCustInvoice">`;
            $.each(CustInvoice, function (key, value) {
                row += `<option value="` + value.InvoiceNo + `">` + value.InvoiceNo + `</option>`;
            });
            row += `</select><label for="floatingSelect">Customer Invoice</label></div>`;
            $("#divCustInvoice").html(row);

            var reviseRow = `<div class="mt-1 floating-label"><select class="form-control" id="CboReviseNP" name="CboReviseNP" style="min-width: 220px; max-width: 340px;"><option value="">-- New NP Number --</option></select><label for="CboReviseNP">Revise NP No</label></div>`;
            $("#divReviseNP").html(reviseRow);

            $(document).on("change", "#CboReviseNP", function () {
                ShowPaymentNotification();
            });

            $("#CboCustInvoice").change(function () {
                if ($("#CboReviseNP").length) {
                    $("#CboReviseNP").val("");
                }
                // Clear package inputs so newly selected invoice parses cleanly
                $("#PackageName").val("");
                if ($("#PackageName").typeahead) {
                    try { $("#PackageName").typeahead('val', ""); } catch (e) { }
                }
                $("#PackageID, #PID, #Duration, #PackageDetailID, #DownSpeed, #UpSpeed, #Bandwidth, #Feature, #ChartOfAccountID").val("");
                ShowPaymentNotification();
            });

            $("#TxtStartDate").on('apply.daterangepicker', function (ev, picker) {
                handleStartDateChange(picker.startDate);
            });
            $("#TxtStartDate").on('change', function () {
                var val = $(this).val().trim();
                if (val) {
                    var m = moment(val, ["DD/MM/YYYY", "YYYY/MM/DD", "DD-MM-YYYY", "YYYY-MM-DD"]);
                    if (m.isValid()) handleStartDateChange(m);
                }
            });

            $("#TxtEndDate").on('apply.daterangepicker', function (ev, picker) {
                handleEndDateChange(picker.startDate);
            });
            $("#TxtEndDate").on('change', function () {
                if (isUpdatingEndDate) return;
                var val = $(this).val().trim();
                if (val) {
                    var m = moment(val, ["DD/MM/YYYY", "YYYY/MM/DD", "DD-MM-YYYY", "YYYY-MM-DD"]);
                    if (m.isValid()) handleEndDateChange(m);
                }
            });

            $("#TxtInvoiceDate").on('apply.daterangepicker', function (ev, picker) {
                var invDateStr = picker.startDate.format('DD/MM/YYYY');
                if ($("#TxtPaymentDueDate").data('daterangepicker')) {
                    $("#TxtPaymentDueDate").data('daterangepicker').setStartDate(picker.startDate.clone());
                    $("#TxtPaymentDueDate").data('daterangepicker').setEndDate(picker.startDate.clone());
                    $("#TxtPaymentDueDate").val(invDateStr);
                }
                updateInvoiceDateLabels(invDateStr, invDateStr);
            });
            $("#TxtInvoiceDate").on('change', function () {
                var val = $(this).val().trim();
                if (val) updateInvoiceDateLabels(val, val);
            });

            $("#TxtPaymentDueDate").on('apply.daterangepicker', function (ev, picker) {
                var dueDateStr = picker.startDate.format('DD/MM/YYYY');
                updateInvoiceDueDateLabels(dueDateStr);
            });
            $("#TxtPaymentDueDate").on('change', function () {
                var val = $(this).val().trim();
                if (val) updateInvoiceDueDateLabels(val);
            });

            $("#btnSendNotificationPayment").click(async function () {
                var invNo = $("#CboCustInvoice").val();
                var CustPhone = $("#TxtCustPhone").val();
                if (CustPhone == null) {
                    DialogSweetAlert('error', "Please select  customer phone number.");
                    return false;
                }
                var StartDate      = $("#TxtStartDate").data('daterangepicker').startDate.format('YYYY/MM/DD');
                var InvoiceDate    = $("#TxtInvoiceDate").data('daterangepicker').startDate.format('DD/MM/YYYY');
                var InvoiceDueDate = $("#TxtPaymentDueDate").data('daterangepicker').startDate.format('DD/MM/YYYY');

                SweetCofirmYesNoCancel("Send Notification to Customer Phone: " + CustPhone, "Send", "", function (InvoiceComment) {
                    var MessageText = encodeURIComponent(nl2br(InvoiceComment));
                    if (MessageText == "") {
                        DialogSweetAlert('error', "Please enter your comment.", function () {
                            $("#TxtInvoiceComment").focus();
                        });
                    }
                    var pkgParams = getSelectedPackageParams();
                    var extraRowsData = getExtraRowsData();
                    DoSaveChangeData("CustomerProfile/NotificationPayment", {
                        CustomerName: encodeURIComponent(CustomerName),
                        CustomerCode: CustomerCode,
                        CustPhone: CustPhone,
                        MessageText: MessageText,
                        CustomerID: CustomerID,
                        InvoiceNo: invNo,
                        InvoiceDate: InvoiceDate,
                        InvoiceDueDate: InvoiceDueDate,
                        StartDate: StartDate,
                        EndDate: pkgParams.EndDate,
                        SendNotificationPaymentToCustomer: true,
                        PackageName: pkgParams.PackageName,
                        UnitPrice: pkgParams.UnitPrice,
                        Duration: pkgParams.Duration,
                        UM: pkgParams.UM,
                        Feature: pkgParams.Feature,
                        ExchangeRate: pkgParams.ExchangeRate,
                        HideSignature: pkgParams.HideSignature,
                        ExtraRowsJson: JSON.stringify(extraRowsData)
                    }, function (response) {
                    }, "", "Sending...", "Sent Successfully.");
                });
            });

            // NOTE: removed the eager $("#CboCustInvoice").trigger("change") that
            // used to run here while the Notification Payment pane was hidden.
            // It now runs from initInvoiceTab() below, only once shown.
        }

        if (CheckedByData && CheckedByData.length > 0) {
            ApplyTypeahead("CheckedBy", CheckedByData,
                {
                    CheckedBy_CheckedByUserID: "ApprovedByUserID",
                    CheckedBy_CheckedByTelegramUserName: "ApprovedByTelegramUserName"
                },
                { Name: "ApprovedBy" }
            );
        }

        $("#CheckedBy").on("input change keyup blur", function () {
            var val = $(this).val().trim();
            if (!val) {
                $("#CheckedBy_CheckedByUserID").val("0");
                $("#CheckedBy_CheckedByTelegramUserName").val("");
            }
        });

        if (ApprovedByData && ApprovedByData.length > 0) {
            ApplyTypeahead("ApprovedBy", ApprovedByData,
                {
                    ApprovedBy_ApprovedByUserID: "ApprovedByUserID",
                    ApprovedBy_ApprovedByTelegramUserName: "ApprovedByTelegramUserName"
                },
                { Name: "ApprovedBy" }
            );
        }

        $("#ApprovedBy").on("input change keyup blur", function () {
            var val = $(this).val().trim();
            if (!val) {
                $("#ApprovedBy_ApprovedByUserID").val("0");
                $("#ApprovedBy_ApprovedByTelegramUserName").val("");
            }
        });

        function getSelectedPackageParams() {
            var packageName = $("#PackageName").val().trim();
            var duration = parseInt($("#Duration").val()) || null;
            var um = "";
            var feature = $("#Feature").val();
            var unitPrice = null;

            if ($("#divNotificationPayment .line-item-row.primary-service-row .edit-unit-price").length > 0) {
                unitPrice = accounting.unformat($("#divNotificationPayment .line-item-row.primary-service-row .edit-unit-price").val()) || null;
            } else if ($("#divNotificationPayment .edit-unit-price").length > 0) {
                unitPrice = accounting.unformat($("#divNotificationPayment .edit-unit-price").first().val()) || null;
            }

            if (packageName && window.packageData) {
                $.each(window.packageData, function (i, pkg) {
                    if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === packageName.toLowerCase()) {
                        if (!duration) duration = pkg.Duration;
                        um = pkg.UM;
                        if (!feature) feature = pkg.Feature;
                        if (!unitPrice) unitPrice = pkg.Price;
                        return false;
                    }
                });
            }

            var currentExRate = null;
            if ($("#divNotificationPayment .edit-exchange-rate").length > 0) {
                currentExRate = accounting.unformat($("#divNotificationPayment .edit-exchange-rate").val()) || null;
            }
            if (!currentExRate && ExchangeRate) {
                currentExRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || null;
            }

            var EndDate = "";
            if ($("#TxtEndDate").length && $("#TxtEndDate").val() != "") {
                if ($("#TxtEndDate").data('daterangepicker')) {
                    EndDate = $("#TxtEndDate").data('daterangepicker').startDate.format('YYYY/MM/DD');
                } else {
                    EndDate = $("#TxtEndDate").val();
                }
            }

            return {
                PackageName: packageName ? encodeURIComponent(packageName) : "",
                UnitPrice: unitPrice,
                Duration: duration,
                UM: um ? encodeURIComponent(um) : "",
                Feature: feature ? encodeURIComponent(feature) : "",
                ExchangeRate: currentExRate,
                EndDate: EndDate,
                HideSignature: hidSignature
            };
        }

        $("#btnSaveNotificationPayment").click(function () {
            var invNo = $("#CboCustInvoice").val();
            if (!invNo) {
                DialogSweetAlert('error', "Please select an invoice.");
                return false;
            }

            var checkerName = $("#CheckedBy").val().trim();
            var checkerUserId = parseInt($("#CheckedBy_CheckedByUserID").val()) || 0;
            var checkerTgUser = $("#CheckedBy_CheckedByTelegramUserName").val().trim();

            if (!checkerName || checkerUserId <= 0) {
                DialogSweetAlert('error', "Please select a checker in 'Checked By'.", function () {
                    $("#CheckedBy").focus();
                });
                return false;
            }

            var approverName = $("#ApprovedBy").val().trim();
            var approverUserId = parseInt($("#ApprovedBy_ApprovedByUserID").val()) || 0;
            var approverTgUser = $("#ApprovedBy_ApprovedByTelegramUserName").val().trim();

            if (!approverName || approverUserId <= 0) {
                DialogSweetAlert('error', "Please select an approver in 'Approved By'.", function () {
                    $("#ApprovedBy").focus();
                });
                return false;
            }

            var StartDate      = $("#TxtStartDate").data('daterangepicker').startDate.format('YYYY/MM/DD');
            var InvoiceDate    = $("#TxtInvoiceDate").data('daterangepicker').startDate.format('DD/MM/YYYY');
            var InvoiceDueDate = $("#TxtPaymentDueDate").data('daterangepicker').startDate.format('DD/MM/YYYY');

            var pkgParams = getSelectedPackageParams();
            var reviseNPNo = ($("#CboReviseNP").length ? $("#CboReviseNP").val() : "") || "";
            var extraRowsData = getExtraRowsData();

            DoSaveChangeData("CustomerProfile/SaveNotificationPayment", {
                CustomerID: CustomerID,
                CustomerName: encodeURIComponent(CustomerName),
                CustomerCode: CustomerCode,
                InvoiceNo: invNo,
                InvoiceDate: InvoiceDate,
                InvoiceDueDate: InvoiceDueDate,
                StartDate: StartDate,
                EndDate: pkgParams.EndDate,
                CheckedByUserID: checkerUserId,
                CheckedBy: encodeURIComponent(checkerName),
                CheckedByTelegramUserName: checkerTgUser,
                ApprovedByUserID: approverUserId,
                ApprovedBy: encodeURIComponent(approverName),
                ApprovedByTelegramUserName: approverTgUser,
                PackageName: pkgParams.PackageName,
                UnitPrice: pkgParams.UnitPrice,
                Duration: pkgParams.Duration,
                UM: pkgParams.UM,
                Feature: pkgParams.Feature,
                ExchangeRate: pkgParams.ExchangeRate,
                HideSignature: pkgParams.HideSignature,
                ReviseNPNo: reviseNPNo,
                ExtraRowsJson: JSON.stringify(extraRowsData)
            }, function (response) {
                if (response && response.NPNo) {
                    var msg = reviseNPNo ? ("Notification Payment " + response.NPNo + " revised and updated successfully!") : ("Notification Payment " + response.NPNo + " saved and sent to Telegram successfully!");
                    DialogSweetAlert('success', msg, function () {
                        if ($("#CboReviseNP").length) {
                            $("#CboReviseNP").val("");
                        }
                        ShowPaymentNotification();
                    });
                } else {
                    if ($("#CboReviseNP").length) {
                        $("#CboReviseNP").val("");
                    }
                    ShowPaymentNotification();
                }
            }, "", "Saving & Sending...", "Notification Payment Sent to Telegram Successfully.");
        });

        // ── Watch #PackageName for any input/change and look up the package directly
        // from window.packageData by name — the most reliable approach since it does
        // not depend on hidden inputs or typeahead events at all.
        $("#PackageName").on("typeahead:select typeahead:autocomplete input change keyup blur", function () {
            var typedName = $(this).val().trim().toLowerCase();
            if (!typedName || !window.packageData) return;

            // Find the matching package in the loaded data
            var matched = null;
            $.each(window.packageData, function (i, pkg) {
                if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === typedName) {
                    matched = pkg;
                    return false; // break
                }
            });

            if (matched) {
                $("#PackageID").val(matched.PackageID || "");
                $("#PID").val(matched.PID || "");
                $("#Duration").val(matched.Duration || "");
                $("#PackageDetailID").val(matched.PackageDetailID || "");
                $("#DownSpeed").val(matched.DowSpeed || "");
                $("#UpSpeed").val(matched.UpSpeed || "");
                $("#Bandwidth").val(matched.Bandwidth || "");
                $("#Feature").val(matched.Feature || "");
                $("#ChartOfAccountID").val(matched.ChartOfAccountID || "");

                updatePackageSpeedsInInvoice(
                    matched.DowSpeed,
                    matched.UpSpeed,
                    matched.Bandwidth,
                    matched.PackageName,
                    matched.Price,
                    matched.Duration,
                    matched.UM,
                    matched.Feature
                );
            }
        });

        // ── Init hidden-tab content only when the tab is actually shown, so
        // width-dependent plugins (select2, the invoice table) measure real
        // layout instead of a 0-width hidden pane.
        function initSettingTab() {
            $("#CboCustPhone").trigger("change");
        }

        function initInvoiceTab() {
            if ($("#CboCustInvoice").length && $("#CboCustInvoice option").length) {
                $("#CboCustInvoice").trigger("change");
            }
        }

        $('#custTelegramTab a[data-toggle="pill"]').on('shown.bs.tab', function (e) {
            var target = $(e.target).attr("href");

            if (target === "#custom-tabs-four-profile" && !settingTabLoaded) {
                settingTabLoaded = true;
                initSettingTab();
            }
            else if (target === "#custom-tabs-five-messages" && !invoiceTabLoaded) {
                invoiceTabLoaded = true;
                initInvoiceTab();
            }
        });
    });

    var isUpdatingEndDate = false;

    function handleStartDateChange(newStartMoment) {
        if (!newStartMoment || !newStartMoment.isValid()) return;

        var duration = 1;
        var um = "Month";
        var currentPkg = $("#PackageName").val().trim().toLowerCase();
        if (currentPkg && window.packageData) {
            $.each(window.packageData, function(i, pkg) {
                if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === currentPkg) {
                    if (pkg.Duration) duration = pkg.Duration;
                    if (pkg.UM) um = pkg.UM;
                    return false;
                }
            });
        } else {
            duration = parseInt($("#Duration").val()) || 1;
            if (duration > 36) duration = 1;
        }

        var endMoment = newStartMoment.clone();
        var u = um.toLowerCase();
        if (u.includes("month")) endMoment.add(duration, 'months');
        else if (u.includes("day")) endMoment.add(duration, 'days');
        else if (u.includes("year")) endMoment.add(duration, 'years');
        endMoment.subtract(1, 'days');

        if ($("#TxtEndDate").length) {
            isUpdatingEndDate = true;
            if ($("#TxtEndDate").data('daterangepicker')) {
                $("#TxtEndDate").data('daterangepicker').setStartDate(endMoment);
                $("#TxtEndDate").data('daterangepicker').setEndDate(endMoment);
            }
            $("#TxtEndDate").val(endMoment.format("DD/MM/YYYY"));
            isUpdatingEndDate = false;
        }

        updateInvoicePeriodDirectly(newStartMoment, endMoment, duration, um);
    }

    function handleEndDateChange(newEndMoment) {
        if (!newEndMoment || !newEndMoment.isValid()) return;

        var startMoment = null;
        if ($("#TxtStartDate").data('daterangepicker') && $("#TxtStartDate").data('daterangepicker').startDate) {
            startMoment = $("#TxtStartDate").data('daterangepicker').startDate.clone();
        } else if ($("#TxtStartDate").val()) {
            startMoment = moment($("#TxtStartDate").val(), ["DD/MM/YYYY", "YYYY/MM/DD", "DD-MM-YYYY", "YYYY-MM-DD"]);
        }
        if (!startMoment || !startMoment.isValid()) {
            startMoment = moment();
        }

        // Keep TxtEndDate holding the new date formatted properly as DD/MM/YYYY
        if ($("#TxtEndDate").length) {
            isUpdatingEndDate = true;
            if ($("#TxtEndDate").data('daterangepicker')) {
                $("#TxtEndDate").data('daterangepicker').setStartDate(newEndMoment);
                $("#TxtEndDate").data('daterangepicker').setEndDate(newEndMoment);
            }
            $("#TxtEndDate").val(newEndMoment.format("DD/MM/YYYY"));
            isUpdatingEndDate = false;
        }

        // Calculate months between startMoment and newEndMoment
        var startYear = startMoment.year();
        var startMonth = startMoment.month(); // 0-11
        var endYear = newEndMoment.year();
        var endMonth = newEndMoment.month(); // 0-11

        var calMonths = (endYear - startYear) * 12 + (endMonth - startMonth);
        var totalDays = newEndMoment.diff(startMoment, 'days') + 1;
        var monthsByDays = Math.round(totalDays / 30.4375);

        // Target duration in months (never raw days!)
        var targetDuration = calMonths > 0 ? calMonths : (monthsByDays > 0 ? monthsByDays : 1);
        if (targetDuration > 36) targetDuration = 1;

        // Determine current package identity to find corresponding package with new duration
        var currentPkgName = $("#PackageName").val().trim();
        var currentOriName = "";
        var currentBandwidth = $("#Bandwidth").val() || "";

        if (window.packageData && currentPkgName) {
            $.each(window.packageData, function (i, pkg) {
                if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === currentPkgName.toLowerCase()) {
                    currentOriName = pkg.OriPackageName || "";
                    if (!currentBandwidth) currentBandwidth = pkg.Bandwidth;
                    return false;
                }
            });
        }

        if (!currentOriName && currentPkgName) {
            var bwMatch = currentPkgName.match(/(.*?)\s*-\s*(\d+)\s*Mbps/i);
            if (bwMatch) {
                currentOriName = bwMatch[1].trim();
                if (!currentBandwidth) currentBandwidth = bwMatch[2].trim();
            }
        }

        // Candidates to search in catalog (calMonths first, then monthsByDays)
        var candidateDurations = [calMonths, monthsByDays];
        candidateDurations = candidateDurations.filter(function (v, idx, arr) { return v > 0 && arr.indexOf(v) === idx; });

        var matchedNewPkg = null;
        if (window.packageData && window.packageData.length > 0) {
            for (var dIdx = 0; dIdx < candidateDurations.length; dIdx++) {
                var durToTry = candidateDurations[dIdx];

                // 1. Match OriPackageName + Bandwidth + Duration
                if (currentOriName) {
                    $.each(window.packageData, function (i, pkg) {
                        var nameMatch = pkg.OriPackageName && (pkg.OriPackageName.trim().toLowerCase() === currentOriName.toLowerCase());
                        var bwMatch = currentBandwidth ? (String(pkg.Bandwidth) === String(currentBandwidth)) : true;
                        var durMatch = (parseInt(pkg.Duration) === durToTry);
                        if (nameMatch && bwMatch && durMatch) {
                            matchedNewPkg = pkg;
                            return false;
                        }
                    });
                }
                if (matchedNewPkg) break;

                // 2. Match Bandwidth + Duration
                if (currentBandwidth) {
                    $.each(window.packageData, function (i, pkg) {
                        var bwMatch = (String(pkg.Bandwidth) === String(currentBandwidth));
                        var durMatch = (parseInt(pkg.Duration) === durToTry);
                        if (bwMatch && durMatch) {
                            matchedNewPkg = pkg;
                            return false;
                        }
                    });
                }
                if (matchedNewPkg) break;
            }
        }

        if (matchedNewPkg) {
            $("#PackageName").val(matchedNewPkg.PackageName);
            if ($("#PackageName").typeahead) {
                try { $("#PackageName").typeahead('val', matchedNewPkg.PackageName); } catch (e) { }
            }

            $("#PackageID").val(matchedNewPkg.PackageID || "");
            $("#PID").val(matchedNewPkg.PID || "");
            $("#Duration").val(matchedNewPkg.Duration || targetDuration);
            $("#PackageDetailID").val(matchedNewPkg.PackageDetailID || "");
            $("#DownSpeed").val(matchedNewPkg.DowSpeed || "");
            $("#UpSpeed").val(matchedNewPkg.UpSpeed || "");
            $("#Bandwidth").val(matchedNewPkg.Bandwidth || "");
            $("#Feature").val(matchedNewPkg.Feature || "");
            $("#ChartOfAccountID").val(matchedNewPkg.ChartOfAccountID || "");

            updatePackageSpeedsInInvoice(
                matchedNewPkg.DowSpeed,
                matchedNewPkg.UpSpeed,
                matchedNewPkg.Bandwidth,
                matchedNewPkg.PackageName,
                matchedNewPkg.Price,
                matchedNewPkg.Duration,
                matchedNewPkg.UM,
                matchedNewPkg.Feature,
                newEndMoment
            );
        } else {
            // Keep package duration in Months (never raw days!)
            var currentPkgDuration = parseInt($("#Duration").val()) || targetDuration;
            var currentUM = "Month";
            if (currentPkgName && window.packageData) {
                $.each(window.packageData, function (i, pkg) {
                    if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === currentPkgName.toLowerCase()) {
                        if (pkg.Duration) currentPkgDuration = pkg.Duration;
                        if (pkg.UM) currentUM = pkg.UM;
                        return false;
                    }
                });
            }
            if (currentPkgDuration > 36) currentPkgDuration = targetDuration;

            $("#Duration").val(currentPkgDuration);
            updateInvoicePeriodDirectly(startMoment, newEndMoment, currentPkgDuration, currentUM);
        }
    }

    function updateInvoicePeriodDirectly(startMoment, endMoment, duration, um) {
        var formatStr = "DD-MMM-YYYY";
        var startDateDisplay = (startMoment && startMoment.isValid()) ? startMoment.format(formatStr) : moment().format(formatStr);
        var endDateDisplay = (endMoment && endMoment.isValid()) ? endMoment.format(formatStr) : moment().format(formatStr);
        var durCount = parseInt(duration) || 1;
        if (durCount > 36 && (um || "Month").toLowerCase().includes("month")) {
            durCount = 1;
        }
        var umText = (um || "Month");
        var umPlural = durCount > 1 ? (umText.endsWith("s") ? umText : umText + "s") : umText.replace(/s$/, "");
        var newText = "Period " + durCount + " " + umPlural + " From " + startDateDisplay + " To " + endDateDisplay;

        $("#divNotificationPayment label:contains('Period')").each(function () {
            var txt = $(this).text().trim();
            if (/Period/i.test(txt) && /From/i.test(txt)) {
                $(this).text(newText);
            }
        });

        var walk = document.createTreeWalker(document.getElementById('divNotificationPayment'), NodeFilter.SHOW_TEXT, null, false);
        var n;
        while (n = walk.nextNode()) {
            var text = n.nodeValue.trim();
            if (/Period(?:\s+\d+\s+(?:Months?|Days?|Years?))?\s+From\s+/i.test(text)) {
                n.nodeValue = n.nodeValue.replace(/Period(?:\s+\d+\s+(?:Months?|Days?|Years?))?\s+From\s+.*$/i, newText);
            }
        }

        var $primaryRow = $("#divNotificationPayment .line-item-row.primary-service-row");
        if ($primaryRow.length > 0) {
            $primaryRow.find("td").eq(2).html(`<div class='text-center'>${durCount} ${umPlural}</div>`);
        }

        if ($("#TxtEndDate").length && endMoment) {
            isUpdatingEndDate = true;
            if ($("#TxtEndDate").data('daterangepicker')) {
                $("#TxtEndDate").data('daterangepicker').setStartDate(endMoment);
                $("#TxtEndDate").data('daterangepicker').setEndDate(endMoment);
            }
            $("#TxtEndDate").val(endMoment.format("DD/MM/YYYY"));
            isUpdatingEndDate = false;
        }
    }

    function updateInvoiceDateLabels(invDateStr, dueDateStr) {
        $("#divNotificationPayment td:contains('Date:')").each(function () {
            var $td = $(this);
            var txt = $td.text().trim();
            if (txt.includes("កាលបរិច្ឆេទ/Date") || txt.startsWith("Date:")) {
                var $valTd = $td.next();
                if ($valTd.length) $valTd.text(invDateStr);
            }
        });
    }

    function updateInvoiceDueDateLabels(dueDateStr) {
        $("#divNotificationPayment td:contains('Due Date')").each(function () {
            var $td = $(this);
            var $valTd = $td.next();
            if ($valTd.length) $valTd.text(dueDateStr);
        });
    }

    function updatePackageSpeedsInInvoice(downSpeed, upSpeed, bandwidth, packageName, price, duration, um, feature, explicitEndMoment) {
        if (!downSpeed && !upSpeed && !bandwidth && !packageName) return;

        var d = parseInt(duration) || 1;
        if (d > 36 && (um || "Month").toLowerCase().includes("month")) {
            d = 1;
        }
        var uUnit = um || "Month";
        var unit = d + " " + (d > 1 ? (uUnit.endsWith("s") ? uUnit : uUnit + "s") : uUnit.replace(/s$/, ""));
        var qty = 1;
        var dollar = price;
        var exchangeRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || 0;
        var riel = dollar * exchangeRate;

        // ✅ Update Package Name and Financial Fields
        $("#divNotificationPayment td")
            .find("br")
            .each(function () {
                var node = this.nextSibling;
                if (node && node.nodeType === 3 && node.nodeValue.includes("Package Name:")) {
                    if (packageName) {
                        node.nodeValue = "Package Name: " + packageName + " ";
                    }

                    var $td = $(this).closest("td");

                    // ✅ Save $tr/$tds BEFORE $td.empty() detaches 'this' from DOM
                    var $tr = $td.closest("tr");
                    var $tds = $tr.find("td");

                    // Save Period/FREE rows first before clearing features
                    var $periodRows = $td.find(".row").filter(function() {
                        return $(this).find("label:contains('Period'), label:contains('FREE')").length > 0;
                    });

                    // Find Service Plan text node to keep it intact
                    var servicePlanText = "Service Plan: Internet Service";
                    $td.contents().each(function() {
                        if (this.nodeType === 3 && this.nodeValue.includes("Service Plan:")) {
                            servicePlanText = this.nodeValue.trim();
                        }
                    });

                    // Clear the cell content
                    $td.empty();

                    // Rebuild the Service Plan and Package Name lines
                    $td.append(document.createTextNode(servicePlanText));
                    $td.append("<br/>");
                    $td.append(document.createTextNode("Package Name: " + packageName + " "));
                    $td.append("<br/>");

                    // Add new features dynamically if defined
                    if (feature) {
                        $td.append("<br/><b>Feature:</b><br/>");
                        var decodedFeature = feature.replace(/&#013;/g, "\r").replace(/&#010;/g, "\n");
                        var lines = decodedFeature.split(/\r?\n/);
                        $.each(lines, function(index, value) {
                            value = value.trim();
                            if (value) {
                                var featureRow = '<div class="row"><div class="col-auto ml-2">' +
                                                 '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" ' +
                                                 'fill="currentColor" class="bi bi-caret-right-fill" viewBox="0 0 16 16">' +
                                                 '<path d="m12.14 8.753-5.482 4.796c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 ' +
                                                 '1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/></svg></div>' +
                                                 '<div class="col"><p class="text-justify">' + value + '</p></div></div>';
                                $td.append(featureRow);
                            }
                        });
                    }

                    // Restore the saved Period/FREE rows at the end
                    if ($periodRows.length > 0) {
                        $td.append($periodRows);
                    }

                    var isISP = $("#divNotificationPayment table th:contains('Dis$'), #divNotificationPayment table th:contains('Discount')").length > 0;
                    var amtIndex = isISP ? 6 : 5;
                    var disIndex = isISP ? 5 : -1;

                    if ($tds.length >= 6) {
                        $tds.eq(2).html(`<div class='text-center'>${unit}</div>`);
                        $tds.eq(3).html(`<div class='text-center'>${qty}</div>`);
                        $tds.eq(4).html(`<input type='text' class='form-control form-control-sm text-right edit-unit-price' value='${accounting.formatMoney(dollar, "$", 2)}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0;'>`);

                        var discount = 0;
                        if (isISP) {
                            discount = accounting.unformat($tds.eq(disIndex).text()) || 0;
                        }

                        var amountDollar = Math.round(((qty * dollar) - discount) * 100) / 100;
                        $tds.eq(amtIndex).removeClass("text-left").addClass("text-right row-amount-dollar").text(accounting.formatMoney(amountDollar, "$", 2));

                        if ($tds.length > amtIndex + 1) {
                            var currentRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || 0;
                            var amountRiel = Math.round(amountDollar * currentRate);
                            $tds.eq(amtIndex + 1).removeClass("text-left").addClass("text-right row-amount-riel").html(`&#x17DB;${accounting.formatMoney(amountRiel, "", 0)}`);
                        }
                    }
                }
            });

        // ✅ Update Period string and recalculate End Date
        var startMoment = null;
        if ($("#TxtStartDate").data('daterangepicker') && $("#TxtStartDate").data('daterangepicker').startDate) {
            startMoment = $("#TxtStartDate").data('daterangepicker').startDate.clone();
        } else if ($("#TxtStartDate").val()) {
            startMoment = moment($("#TxtStartDate").val(), ["DD/MM/YYYY", "YYYY/MM/DD", "DD-MM-YYYY", "YYYY-MM-DD"]);
        }

        var targetEndMoment = explicitEndMoment || null;
        if (!targetEndMoment) {
            var sm = (startMoment && startMoment.isValid()) ? startMoment.clone() : moment();
            var dur = parseInt(duration) || 1;
            if (dur > 36) dur = 1;
            var u = (um || "Month").toLowerCase();
            if (u.includes("month")) sm.add(dur, 'months');
            else if (u.includes("day")) sm.add(dur, 'days');
            else if (u.includes("year")) sm.add(dur, 'years');
            sm.subtract(1, 'days');
            targetEndMoment = sm;
        }

        var formatStr = "DD-MMM-YYYY";
        var startDateDisplay = (startMoment && startMoment.isValid()) ? startMoment.format(formatStr) : moment().format(formatStr);
        var endDateDisplay = targetEndMoment.format(formatStr);
        var durCount = parseInt(duration) || 1;
        if (durCount > 36 && (um || "Month").toLowerCase().includes("month")) {
            durCount = 1;
        }
        var umText = (um || "Month");
        var umPlural = durCount > 1 ? (umText.endsWith("s") ? umText : umText + "s") : umText.replace(/s$/, "");
        var newText = "Period " + durCount + " " + umPlural + " From " + startDateDisplay + " To " + endDateDisplay;

        // Update Period in DOM labels
        $("#divNotificationPayment label:contains('Period')").each(function () {
            var txt = $(this).text().trim();
            if (/Period/i.test(txt) && /From/i.test(txt)) {
                $(this).text(newText);
            }
        });

        // Update Period in text nodes
        var walk = document.createTreeWalker(document.getElementById('divNotificationPayment'), NodeFilter.SHOW_TEXT, null, false);
        var n;
        while(n = walk.nextNode()) {
            var text = n.nodeValue.trim();
            if (/Period(?:\s+\d+\s+(?:Months?|Days?|Years?))?\s+From\s+/i.test(text)) {
                n.nodeValue = n.nodeValue.replace(/Period(?:\s+\d+\s+(?:Months?|Days?|Years?))?\s+From\s+.*$/i, newText);
            }
        }

        if ($("#TxtEndDate").length && targetEndMoment) {
            isUpdatingEndDate = true;
            if ($("#TxtEndDate").data('daterangepicker')) {
                $("#TxtEndDate").data('daterangepicker').setStartDate(targetEndMoment);
                $("#TxtEndDate").data('daterangepicker').setEndDate(targetEndMoment);
            }
            $("#TxtEndDate").val(targetEndMoment.format("DD/MM/YYYY"));
            isUpdatingEndDate = false;
        }

        calculateInvoiceGrandTotals();
    }

    // ✅ Calculate and Update Grand Totals
    function calculateInvoiceGrandTotals() {
        var subTotalDollar = 0;
        var vatDollar = 0;
        var exchangeRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || 0;

        var $headers = $("#divNotificationPayment table th");
        var isISP = $headers.filter(function(){ return $(this).text().includes('Dis$') || $(this).text().includes('Discount'); }).length > 0;
        var amtIndex = isISP ? 6 : 5;

        // 1. Sum regular line item rows in the table
        $("#divNotificationPayment table tr").each(function () {
            var $row = $(this);
            var $tds = $row.find("td");

            // Regular line items have at least 6 cells and no th (exclude summary rows which have 2 or 3 cells)
            if ($tds.length >= 6 && $row.find("th").length === 0 && !$row.text().includes("Total Included VAT") && !$row.text().includes("Grand Total")) {
                var $amtCell = $row.find(".row-amount-dollar").first();
                var amountStr = $amtCell.length > 0 ? $amtCell.text() : $tds.eq(amtIndex).text();
                if (amountStr) {
                    var parsedAmt = accounting.unformat(amountStr) || 0;
                    subTotalDollar += Math.round(parsedAmt * 100) / 100;
                }
            }
        });

        subTotalDollar = Math.round(subTotalDollar * 100) / 100;

        // 2. Check if invoice has VAT row
        var hasVat = false;
        var $vatRow = $("#divNotificationPayment table tr[name='trVAT']");
        if ($vatRow.length > 0) {
            hasVat = true;
        } else {
            // Check if there is an explicit summary VAT row (must NOT be line item, header, terms pre, or dropdown)
            $("#divNotificationPayment table tr:not(.line-item-row)").each(function () {
                var $row = $(this);
                if ($row.find("pre, select, th").length > 0) return;
                var $tds = $row.find("td");
                if ($tds.length >= 2 && $tds.length <= 4) {
                    var labelText = $tds.first().text().trim().toUpperCase();
                    if ((labelText.includes("VAT 10%") || labelText.includes("អាករលើតម្លៃបន្ថែម") || labelText.includes("ពន្ធបន្ថែម")) &&
                        !labelText.includes("TOTAL") && !labelText.includes("INCLUDED") && !labelText.includes("NON-VAT") && !labelText.includes("TIN")) {
                        hasVat = true;
                        $row.attr("name", "trVAT");
                        $vatRow = $row;
                    }
                }
            });
        }

        if (hasVat) {
            vatDollar = Math.round(subTotalDollar * 0.10 * 100) / 100;
        }

        // Check if there is an invoice-level Discount USD row
        var discountDollar = 0;
        $("#divNotificationPayment table tr:not(.line-item-row)").each(function () {
            var $row = $(this);
            if ($row.find("pre, select, th").length > 0) return;
            var $tds = $row.find("td");
            if ($tds.length >= 2 && $tds.length <= 4) {
                var labelText = $tds.first().text().trim().toUpperCase();
                if ((labelText.includes("DISCOUNT") || labelText.includes("បញ្ចុះតម្លៃ")) && !labelText.includes("%")) {
                    var valStr = $tds.eq(1).text();
                    discountDollar = accounting.unformat(valStr) || 0;
                }
            }
        });

        var grandTotalDollar = Math.round((subTotalDollar + vatDollar - discountDollar) * 100) / 100;
        if (grandTotalDollar < 0) grandTotalDollar = 0;
        var subTotalRiel = Math.round(subTotalDollar * exchangeRate);
        var vatRiel = Math.round(vatDollar * exchangeRate);
        var grandTotalRiel = Math.round(grandTotalDollar * exchangeRate);

        // 3. Update Summary Rows
        $("#divNotificationPayment table tr").each(function () {
            var $row = $(this);
            var $tds = $row.find("td");

            // Summary rows have 2 or 3 td cells
            if ($tds.length < 2 || $tds.length > 3) return;

            var $labelTd = $tds.first();
            var text = $labelTd.text().trim();
            var upperText = text.toUpperCase();
            var $amountTd = $tds.eq(1);
            var $rielTd = $tds.length >= 3 ? $tds.eq(2) : null;

            // A. SubTotal / Total Row
            var isSubTotal = ($row.find("label[name='SubTotal'], label[name='Total']").length > 0) ||
                ((upperText.includes("SUB TOTAL") || upperText.includes("SUBTOTAL") || upperText.includes("TOTAL") || text.includes("សរុប")) &&
                 !upperText.includes("GRAND TOTAL") &&
                 !upperText.includes("INCLUDED VAT") &&
                 !upperText.includes("VAT") &&
                 !text.includes("សរុបរួម") &&
                 !text.includes("សរុបទឹកប្រាក់រួម") &&
                 !upperText.includes("DEPOSIT") &&
                 !upperText.includes("DISCOUNT"));

            if (isSubTotal) {
                var lblName = $row.find("label[name='Total']").length > 0 ? "Total" : "SubTotal";
                $amountTd.html(`<div class='p-0 text-center'><label class="col-form-label" name="${lblName}">${accounting.formatMoney(subTotalDollar, "$", 2)}</label></div>`);
                if ($rielTd && $rielTd.length > 0) {
                    $rielTd.html(`<div class='p-0 text-center'><label class="col-form-label" name="${lblName}">&#x17DB;${accounting.formatMoney(subTotalRiel, "", 0)}</label></div>`);
                }
            }
            // B. VAT Row
            else if (hasVat && ($row.is("[name='trVAT']") || (upperText.includes("VAT 10%") && !upperText.includes("GRAND TOTAL") && !upperText.includes("INCLUDED VAT") && !text.includes("សរុបទឹកប្រាក់រួម") && !text.includes("សរុបរួម")))) {
                $amountTd.html(`<div class='p-0 text-center'><label class="col-form-label">${accounting.formatMoney(vatDollar, "$", 2)}</label></div>`);
                if ($rielTd && $rielTd.length > 0) {
                    $rielTd.html(`<div class='p-0 text-center'><label class="col-form-label">&#x17DB;${accounting.formatMoney(vatRiel, "", 0)}</label></div>`);
                }
            }
            // C. Grand Total USD / Total Included VAT Row
            else if (upperText.includes("GRAND TOTAL USD") || upperText.includes("INCLUDED VAT") || upperText.includes("GRAND TOTAL:") || text.includes("សរុបរួម") || text.includes("សរុបទឹកប្រាក់រួម") || text.includes("សរុបចុងក្រោយ") || $row.find("label[name='GrandTotal']").length > 0) {
                if (upperText.includes("KHR") || text.includes("លុយរៀល") || text.includes("ជាលុយរៀល")) {
                    $amountTd.html(`<div class='p-0 text-center'><label class="col-form-label" name="GrandTotal">&#x17DB;${accounting.formatMoney(grandTotalRiel, "", 0)}</label></div>`);
                } else {
                    $amountTd.html(`<div class='p-0 text-center'><label class="col-form-label" name="GrandTotal">${accounting.formatMoney(grandTotalDollar, "$", 2)}</label></div>`);
                    if ($rielTd && $rielTd.length > 0) {
                        $rielTd.html(`<div class='p-0 text-center'><label class="col-form-label" name="GrandTotal">&#x17DB;${accounting.formatMoney(grandTotalRiel, "", 0)}</label></div>`);
                    }
                }
            }
        });
    }

    // ✅ Helper: Update Row Riel Amount
    function updateRowRielAmount($row) {
        var $headers = $("#divNotificationPayment table th");
        var isISP = $headers.filter(function(){ return $(this).text().includes('Dis$') || $(this).text().includes('Discount'); }).length > 0;
        var amtIndex = isISP ? 6 : 5;
        var $tds = $row.find("td");
        var $amtCell = $row.find(".row-amount-dollar").first();
        var amountDollar = accounting.unformat($amtCell.length ? $amtCell.text() : $tds.eq(amtIndex).text()) || 0;
        var exchangeRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || 0;
        var amountRiel = Math.round(amountDollar * exchangeRate);
        var $rielCell = $row.find(".row-amount-riel").first();
        if ($rielCell.length) {
            $rielCell.html(`&#x17DB;${accounting.formatMoney(amountRiel, "", 0)}`);
        } else if ($tds.length > amtIndex + 1) {
            $tds.eq(amtIndex + 1).html(`&#x17DB;${accounting.formatMoney(amountRiel, "", 0)}`);
        }
    }

    // ✅ Helper: Recalculate Row Amount (Dollar and Riel)
    function recalculateRowAmount($row) {
        var isISP = $("#divNotificationPayment table th:contains('Dis$'), #divNotificationPayment table th:contains('Discount')").length > 0;
        var amtIndex = isISP ? 6 : 5;
        var $tds = $row.find("td");
        var qty = accounting.unformat($row.find(".edit-qty").val() || $tds.eq(3).text()) || 0;
        var unitPrice = accounting.unformat($row.find(".edit-unit-price").val() || $tds.eq(4).text()) || 0;
        var discount = 0;
        if (isISP) {
            discount = accounting.unformat($row.find(".edit-discount").val() || $tds.eq(5).text()) || 0;
        }
        var amountDollar = Math.round(((qty * unitPrice) - discount) * 100) / 100;
        var $amtCell = $row.find(".row-amount-dollar").first();
        if ($amtCell.length) {
            $amtCell.text(accounting.formatMoney(amountDollar, "$", 2));
        } else {
            $tds.eq(amtIndex).addClass("row-amount-dollar").text(accounting.formatMoney(amountDollar, "$", 2));
        }
        updateRowRielAmount($row);
    }

