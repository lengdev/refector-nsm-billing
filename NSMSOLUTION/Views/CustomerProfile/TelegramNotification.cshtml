    // Extract extra service rows (excluding row 1 primary service) for saving/sending
    function getExtraRowsData() {
        var extraRows = [];
        var isISP = $("#divNotificationPayment table th:contains('Dis$'), #divNotificationPayment table th:contains('Discount')").length > 0;

        $("#divNotificationPayment table tr.line-item-row").each(function (idx) {
            var $row = $(this);
            if ($row.hasClass("primary-service-row") || idx === 0) return;

            var $tds = $row.find("td");
            if ($tds.length < 6) return;

            var desc = "";
            var $select = $row.find(".select-service-type");
            var $descInput = $row.find(".edit-service-desc");
            var $descSpan = $row.find(".service-desc-text");

            var serviceId = parseInt($row.attr("data-service-id")) || 0;
            var otherChargeId = parseInt($row.attr("data-other-charge-id")) || 0;

            if ($descInput.length && $descInput.val()) {
                desc = $descInput.val().trim();
            } else if ($select.length && $select.val() && $select.val() !== "__custom__") {
                desc = $select.val().trim();
            } else if ($descSpan.length && $descSpan.text()) {
                desc = $descSpan.text().trim();
            } else {
                desc = $tds.eq(1).clone().find(".no-print").remove().end().text().trim();
            }

            if ($select.length && $select.val()) {
                var $opt = $select.find("option:selected");
                if ($opt.length) {
                    if (!serviceId) serviceId = parseInt($opt.attr("data-service-id")) || 0;
                    if (!otherChargeId) otherChargeId = parseInt($opt.attr("data-other-charge-id")) || 0;
                }
            }

            var um = $row.find(".edit-um").length ? $row.find(".edit-um").val().trim() : $tds.eq(2).text().trim();
            var qty = accounting.unformat($row.find(".edit-qty").length ? $row.find(".edit-qty").val() : $tds.eq(3).text()) || 1;
            var unitPrice = accounting.unformat($row.find(".edit-unit-price").length ? $row.find(".edit-unit-price").val() : $tds.eq(4).text()) || 0;
            var discountUSD = 0;
            if (isISP) {
                discountUSD = accounting.unformat($row.find(".edit-discount").length ? $row.find(".edit-discount").val() : $tds.eq(5).text()) || 0;
            }
            var $amtCell = $row.find(".row-amount-dollar").first();
            var amount = accounting.unformat($amtCell.length ? $amtCell.text() : $tds.eq(amtIndex).text()) || ((qty * unitPrice) - discountUSD);
            amount = Math.round(amount * 100) / 100;

            if (desc || amount > 0) {
                extraRows.push({
                    Description: desc,
                    UM: um,
                    QTY: qty,
                    UnitPrice: unitPrice,
                    DiscountUSD: discountUSD,
                    Amount: amount,
                    ServiceID: serviceId,
                    OtherChargeID: otherChargeId
                });
            }
        });
        return extraRows;
    }

