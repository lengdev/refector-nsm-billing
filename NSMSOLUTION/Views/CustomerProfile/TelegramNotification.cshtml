    // ✅ Initialize Unit Price editability and Cleanup Rows
    function initEditableUnitPriceAndCleanup() {
        var count = 1;

        // Force current date in ISSUED BY section
        var today = new Date();
        var dd = String(today.getDate()).padStart(2, '0');
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var yyyy = today.getFullYear();
        var formattedDate = dd + '/' + mm + '/' + yyyy;

        $("#divNotificationPayment label:contains('Date:')").each(function () {
            var txt = $(this).text().trim();
            // If it starts with "Date:" (and not "Due Date:" or "កាលបរិច្ឆេទ/Date:"), it's the ISSUED BY date
            if (txt.startsWith("Date:")) {
                $(this).text("Date: " + formattedDate);
            }
        });

        // We use the latest global ExchangeRate instead of the old one from the invoice

        // ✅ Remove Sale's Name and Sale's Phone from Non-VAT invoice if present
        $("#divNotificationPayment tr:has(td:contains(\"Sale's Name\")), #divNotificationPayment tr:has(td:contains(\"Sale's Phone\"))").remove();
        // ✅ Remove Terms from Non-VAT if present
        $("#divNotificationPayment table td[rowspan] pre").remove();

        // ✅ Remove Note from invoice Vat and Cm (សំគាល់៖ ច្បាប់ដើមសម្រាប់អ្នកទិញ ច្បាប់ចម្លងសម្រាប់អ្នកលក់ / Note: Original invoice for customer and copied invoice for seller)
        // 1. Remove by exact .col.text-sm / .text-sm (which DrawInvoice specifically generates for both note lines)
        $("#divNotificationPayment footer .col.text-sm, #divNotificationPayment div.col.text-sm, #divNotificationPayment .text-sm").each(function () {
            var $p = $(this).parent();
            if ($p.hasClass("row")) {
                $p.remove();
            } else {
                $(this).remove();
            }
        });

        // 2. Remove by text content across any other elements (labels, divs, spans) using Unicode escapes and text
        var khmerNotePatterns = [
            "Original invoice",
            "copied invoice",
            "\u1785\u17d2\u1794\u17b6\u1794\u17cb\u178a\u17be\u1798", // ច្បាប់ដើម
            "\u1785\u17d2\u1794\u17b6\u1794\u17cb\u1785\u1798\u17d2\u179b\u1784", // ច្បាប់ចម្លង
            "\u179f\u17c6\u1782\u17b6\u179b\u17cb", // សំគាល់
            "\u179f\u1798\u17d2\u1782\u17b6\u179b\u17cb", // សម្គាល់
            "\u17a2\u17d2\u1793\u1780\u1791\u17b7\u1789", // អ្នកទិញ
            "\u17a2\u17d2\u1793\u1780\u179b\u1780\u17cb", // អ្នកលក់
            "ច្បាប់ដើម",
            "ច្បាប់ចម្លង",
            "សំគាល់",
            "សម្គាល់"
        ];

        $("#divNotificationPayment footer label, #divNotificationPayment label, #divNotificationPayment p, #divNotificationPayment span, #divNotificationPayment div").filter(function () {
            return $(this).children().length === 0;
        }).each(function () {
            var txt = $(this).text();
            var matched = false;
            for (var i = 0; i < khmerNotePatterns.length; i++) {
                if (txt.indexOf(khmerNotePatterns[i]) >= 0) {
                    matched = true;
                    break;
                }
            }
            if (matched) {
                var $p = $(this).parent();
                $(this).next("br").remove();
                if ($p.hasClass("row") && $p.children().length <= 2) {
                    $p.remove();
                } else if ($p.hasClass("col")) {
                    var $row = $p.closest(".row");
                    $(this).remove();
                    if ($p.children().length === 0 || $row.text().trim() === "") {
                        $row.remove();
                    }
                } else {
                    $(this).remove();
                }
            }
        });

        var lineItemIndex = 0;
        $("#divNotificationPayment table tr").each(function () {
            var $row = $(this);
            var $tds = $row.find("td");

            // Handle ISP Invoices (7 columns with Dis$) or Standard
            var isISP = $("#divNotificationPayment table th:contains('Dis$'), #divNotificationPayment table th:contains('Discount')").length > 0;

            if ($tds.length >= 6 && !$row.text().includes("Total Included VAT") && !$row.text().includes("Grand Total") && $row.find("th").length == 0) {
                lineItemIndex++;
                $row.addClass("line-item-row");
                $tds.eq(0).addClass("row-no").text(lineItemIndex);

                var amtIndex = isISP ? 6 : 5;

                if (lineItemIndex === 1) {
                    $row.addClass("primary-service-row");
                    if ($row.find(".edit-unit-price").length == 0) {
                        var priceVal = $tds.eq(4).text().trim();
                        var amtDollar = $tds.eq(amtIndex).text().trim();

                        $tds.eq(4).html(`<input type='text' class='form-control form-control-sm text-right edit-unit-price' value='${priceVal}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0;'>`);
                        $tds.eq(amtIndex).addClass("row-amount-dollar").text(amtDollar);

                        // If there's a column after Amount$, it's likely the Riel column
                        if ($tds.length > amtIndex + 1) {
                            $tds.eq(amtIndex + 1).addClass("row-amount-riel");
                        }
                    }
                } else {
                    $row.addClass("extra-service-row");

                    // td 1: Description + Delete button
                    if ($row.find(".btn-delete-service-row").length == 0) {
                        var currentDesc = $tds.eq(1).text().trim();
                        $tds.eq(1).html(`
                            <div class="d-flex align-items-center">
                                <span class="service-desc-text font-weight-bold" style="cursor: pointer;" title="Click to edit">${currentDesc}</span>
                                <button type="button" class="btn btn-xs btn-outline-danger btn-delete-service-row no-print ml-auto" title="Delete Row" style="padding: 1px 6px;">
                                    <i class="fa fa-times"></i>
                                </button>
                            </div>
                            <input type="text" class="form-control form-control-sm edit-service-desc d-none mt-1" value="${currentDesc}" style="background: transparent; border: 1px solid #ced4da;">
                        `);
                    }

                    // td 2: UM
                    if ($row.find(".edit-um").length == 0) {
                        var umVal = $tds.eq(2).text().trim();
                        $tds.eq(2).html(`<input type='text' class='form-control form-control-sm text-center edit-um' value='${umVal}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0; width: 65px; display:inline-block;'>`);
                    }

                    // td 3: QTY
                    if ($row.find(".edit-qty").length == 0) {
                        var qtyVal = $tds.eq(3).text().trim();
                        $tds.eq(3).html(`<input type='text' class='form-control form-control-sm text-center edit-qty' value='${qtyVal}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0; width: 45px; display:inline-block;'>`);
                    }

                    // td 4: UnitPrice
                    if ($row.find(".edit-unit-price").length == 0) {
                        var priceVal = $tds.eq(4).text().trim();
                        $tds.eq(4).html(`<input type='text' class='form-control form-control-sm text-right edit-unit-price' value='${priceVal}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0; width: 70px; display:inline-block;'>`);
                    }

                    // td 5: Dis$ (if ISP)
                    if (isISP) {
                        if ($row.find(".edit-discount").length == 0) {
                            var disVal = $tds.eq(5).text().trim();
                            $tds.eq(5).html(`<input type='text' class='form-control form-control-sm text-right edit-discount' value='${disVal}' style='border:none; background:transparent; font-family: inherit; font-size: inherit; color: inherit; padding: 0; width: 60px; display:inline-block;'>`);
                        }
                    }

                    $tds.eq(amtIndex).addClass("row-amount-dollar");
                    if ($tds.length > amtIndex + 1) {
                        $tds.eq(amtIndex + 1).addClass("row-amount-riel");
                    }
                }

                // Recalculate Riel based on potentially updated ExchangeRate
                updateRowRielAmount($row);
            }
        });

        // 4. Make Exchange Rate Editable using the latest global ExchangeRate
        $("#divNotificationPayment td:contains('Exchange Rate')").each(function() {
            var $td = $(this);
            var $valTd = $td.next();
            if ($valTd.length > 0 && $valTd.find("input").length == 0) {
                // Use the global ExchangeRate instead of the old one in the HTML
                var currentRate = parseFloat(String(ExchangeRate).replace(/,/g, '')) || 0;
                $valTd.html(`&#x17DB; <input type='text' class='form-control form-control-sm edit-exchange-rate' value='${accounting.formatMoney(currentRate, "", 0)}' style='border:none; background:transparent; width: 60px; display:inline-block; font-family: inherit; font-size: inherit; color: inherit; padding: 0;'>`);
            }
        });

        $("#divNotificationPayment img#Signature").parent().css("cursor", "pointer");

        calculateInvoiceGrandTotals();
    }

    function renderReviseNPDropdown(uncheckedList, selectedNPNo) {
        var $cbo = $("#CboReviseNP");
        if ($cbo.length === 0) return;

        var currentVal = typeof selectedNPNo !== "undefined" && selectedNPNo !== null ? selectedNPNo : ($cbo.val() || "");
        var currentInv = ($("#CboCustInvoice").val() || "").trim();
        var optionsHtml = '<option value="">-- New NP Number --</option>';

        if (uncheckedList && uncheckedList.length > 0) {
            $.each(uncheckedList, function (i, item) {
                if (item && item.NPNo) {
                    var isSelected = (item.NPNo === currentVal) ? ' selected="selected"' : '';
                    optionsHtml += `<option value="${item.NPNo}"${isSelected}> ${item.NPNo}</option>`;
                }
            });
        }

        if (currentVal && optionsHtml.indexOf(`value="${currentVal}"`) === -1) {
            optionsHtml += `<option value="${currentVal}" selected="selected"> ${currentVal}</option>`;
        }

        $cbo.html(optionsHtml);
        $cbo.val(currentVal);
    }

    function ShowPaymentNotification(Downloads) {
        Downloads = typeof Downloads == "undefined" ? false : true;
        var invNo = $("#CboCustInvoice").val();
        if (invNo != null) {
            var StartDate = $("#TxtStartDate").data('daterangepicker').startDate.format('YYYY/MM/DD');
            var EndDate   = "";
            if ($("#TxtEndDate").val() != "") {
                EndDate = $("#TxtEndDate").data('daterangepicker').startDate.format('YYYY/MM/DD');
            }
            var InvoiceDate    = $("#TxtInvoiceDate").data('daterangepicker').startDate.format('DD/MM/YYYY');
            var InvoiceDueDate = $("#TxtPaymentDueDate").data('daterangepicker').startDate.format('DD/MM/YYYY');
            var reviseNPNo     = ($("#CboReviseNP").length ? $("#CboReviseNP").val() : "") || "";

            LoadData("CustomerProfile/NotificationPayment/?CustomerName=" + encodeURIComponent(CustomerName) +
                "&CustomerCode="   + CustomerCode +
                "&CustomerID="     + CustomerID +
                "&InvoiceNo="      + invNo +
                "&InvoiceDate="    + InvoiceDate +
                "&InvoiceDueDate=" + InvoiceDueDate +
                "&StartDate="      + StartDate +
                "&Download="       + Downloads +
                "&EndDate="        + EndDate +
                "&ReviseNPNo="     + encodeURIComponent(reviseNPNo),
                function (response) {
                    if (!Downloads) {
                        $("#divNotificationPayment").html(response);
                        var newRate = $("#divNotificationPayment #hdnInvoiceExchangeRate").val();
                        if (newRate) {
                            ExchangeRate = newRate;
                        }

                        // Always allow saving/creating new or revised notification payment even if pending
                        $("#btnSaveNotificationPayment").prop("disabled", false).addClass("btn-primary").removeClass("btn-secondary");
                        if (reviseNPNo) {
                            $("#btnSaveNotificationPayment").attr("title", "Revise Notification Payment " + reviseNPNo + " & Send to Telegram");
                        } else {
                            $("#btnSaveNotificationPayment").attr("title", "Save & Send to Telegram");
                        }

                        // Populate unchecked notification payments in Revise NP dropdown
                        var uncheckedRaw = $("#divNotificationPayment #hdnUncheckedNPJson").val();
                        var uncheckedList = [];
                        if (uncheckedRaw) {
                            try {
                                uncheckedList = JSON.parse(uncheckedRaw);
                            } catch (e) {
                                uncheckedList = [];
                            }
                        }
                        renderReviseNPDropdown(uncheckedList, reviseNPNo);

                        initEditableUnitPriceAndCleanup();

                        // Auto-extract Package Name from invoice if empty
                        var currentPkgVal = $("#PackageName").val().trim();
                        if (!currentPkgVal) {
                            var pkgMatch = $("#divNotificationPayment").html().match(/Package Name:\s*([^<]+)/i);
                            if (pkgMatch && pkgMatch[1]) {
                                var extractedPkg = pkgMatch[1].trim();
                                $("#PackageName").val(extractedPkg);
                                if ($("#PackageName").typeahead) {
                                    try { $("#PackageName").typeahead('val', extractedPkg); } catch (e) { }
                                }
                            }
                        }

                        // After invoice reloads, re-apply speeds from the current PackageName
                        var typedName = $("#PackageName").val().trim().toLowerCase();
                        if (typedName && window.packageData) {
                            $.each(window.packageData, function (i, pkg) {
                                if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === typedName) {
                                    $("#PackageID").val(pkg.PackageID || "");
                                    $("#PID").val(pkg.PID || "");
                                    $("#Duration").val(pkg.Duration || "");
                                    $("#PackageDetailID").val(pkg.PackageDetailID || "");
                                    $("#DownSpeed").val(pkg.DowSpeed || "");
                                    $("#UpSpeed").val(pkg.UpSpeed || "");
                                    $("#Bandwidth").val(pkg.Bandwidth || "");
                                    $("#Feature").val(pkg.Feature || "");
                                    $("#ChartOfAccountID").val(pkg.ChartOfAccountID || "");

                                    updatePackageSpeedsInInvoice(
                                        pkg.DowSpeed,
                                        pkg.UpSpeed,
                                        pkg.Bandwidth,
                                        pkg.PackageName,
                                        pkg.Price,
                                        pkg.Duration,
                                        pkg.UM,
                                        pkg.Feature
                                    );
                                    return false; // break
                                }
                            });
                        }
                    } else {
                        response = JSON.parse(response);
                        var OutPutFile = ServerRoot + response.OutPutFile;
                        var FileName   = response.FileName;
                        var link = document.createElement('a');
                        link.href     = OutPutFile;
                        link.download = FileName;
                        link.click();
                        link.remove();
                    }
                });
        }
    }

    loadServiceTypes();
    function loadServiceTypes() {
        $.ajax({
            url: ServerRoot + "CustomerProfile/GetServiceTypes",
            dataType: "json",
            type: 'GET',
            headers: { "Authorization": "Bearer " + access_Token },
            beforeSend: function (xhr) {
                xhr.setRequestHeader('x-custom-header', JSON.stringify(headerPara));
            },
            success: function (res) {
                try {
                    window.serviceTypes = typeof res.data === "string" ? JSON.parse(res.data) : (res.data || []);
                } catch (e) {
                    window.serviceTypes = [];
                }
            },
            error: function (xhr, status, err) {
                console.error("loadServiceTypes failed:", status, err);
            }
        });
    }

    loadPackage();
    function loadPackage(serviceId = 1) {
        $.ajax({
            url: ServerRoot + "AddCustomer/LoadPackages?ServiceID=" + serviceId + "&InvoiceType=''",
            dataType: "json",
            async: false,
            cache: true,
            type: 'GET',
            headers: { "Authorization": "Bearer " + access_Token },
            beforeSend: function (xhr) {
                xhr.setRequestHeader('x-custom-header', JSON.stringify(headerPara));
            },
            success: function (res) {
                try {
                    window.packageData = typeof res.data === "string" ? JSON.parse(res.data) : res.data;
                } catch (e) {
                    window.packageData = [];
                    console.error("loadPackage: failed to parse package data", e);
                    return;
                }
                ApplyTypeahead("PackageName", window.packageData,
                    {
                        PackageID: "PackageID",
                        PID: "PID",
                        Duration: "Duration",
                        PackageDetailID: "PackageDetailID",
                        DownSpeed: "DowSpeed",
                        UpSpeed:   "UpSpeed",
                        Bandwidth: "Bandwidth",
                        Feature:   "Feature",
                        ChartOfAccountID: "ChartOfAccountID"
                    },
                    { Name: "PackageName" }
                );

                // ✅ Auto-apply if #PackageName already has a default value when data loads
                var typedName = $("#PackageName").val().trim().toLowerCase();
                if (typedName && window.packageData) {
                    $.each(window.packageData, function (i, pkg) {
                        if (pkg.PackageName && pkg.PackageName.trim().toLowerCase() === typedName) {
                            $("#PackageID").val(pkg.PackageID || "");
                            $("#PID").val(pkg.PID || "");
                            $("#Duration").val(pkg.Duration || "");
                            $("#PackageDetailID").val(pkg.PackageDetailID || "");
                            $("#DownSpeed").val(pkg.DowSpeed || "");
                            $("#UpSpeed").val(pkg.UpSpeed || "");
                            $("#Bandwidth").val(pkg.Bandwidth || "");
                            $("#Feature").val(pkg.Feature || "");
                            $("#ChartOfAccountID").val(pkg.ChartOfAccountID || "");

                            updatePackageSpeedsInInvoice(
                                pkg.DowSpeed, pkg.UpSpeed, pkg.Bandwidth,
                                pkg.PackageName, pkg.Price,
                                pkg.Duration, pkg.UM, pkg.Feature
                            );
                            return false; // break
                        }
                    });
                }
            },
            error: function (xhr, status, err) {
                console.error("loadPackage AJAX failed:", status, err);
            }
        });
    }
    $("#btnDownload").click(function () {
        var element = document.getElementById("divNotificationPayment");

        // Hide action controls and show pure text for clean PDF export
        $(element).find(".no-print").hide();
        $(element).find(".service-desc-text").removeClass("d-none");
        $(element).find(".edit-service-desc").addClass("d-none");

        $(element).find("table.table-bordered td, table.table-bordered th").css("border", "1px solid black");
        $(element).find("table.table-bordered").css("border-collapse", "collapse");

        var today = new Date();
        var yyyy = today.getFullYear();
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var dd = String(today.getDate()).padStart(2, '0');
        var fileName = `${yyyy}${mm}${dd}-NOTIFICATION-PAYMENT.pdf`;

        var opt = {
            margin: [0, 0.9, 0.5, 0.2],
            filename: fileName,
            image: { type: 'jpeg', quality: 1 },
            html2canvas: { scale: 2 },
            jsPDF: { unit: 'in', format: 'a3', orientation: 'portrait' }
        };

        html2pdf().set(opt).from(element).save().then(function () {
            $(element).find(".no-print").show();
            $(element).find("table.table-bordered td, table.table-bordered th").css("border", "");
            $(element).find("table.table-bordered").css("border-collapse", "");
        });
    });
</script>