    // ── Helper ────────────────────────────────────────────────────────
    function getShortNameProfile(name) {
        if (!name) return "";

        name = name.trim();
        const enTitles = ["mr", "mrs", "ms", "dr", "miss"];
        const khTitles = ["លោក", "អ្នកស្រី", "អ្នកនាង"];

        let words = name.split(/\s+/).filter(w => {
            let clean = w.toLowerCase().replace('.', '');
            return !enTitles.includes(clean) && !khTitles.includes(w);
        });

        const isKhmer = /[\u1780-\u17FF]/.test(name);
        if (words.length === 0) return "";

        if (isKhmer) {
            if (words.length >= 2) {
                return words[0].charAt(0) + words[words.length - 1].charAt(0);
            } else {
                return words[0].charAt(0);
            }
        } else {
            if (words.length >= 2) {
                return (words[0][0] + words[words.length - 1][0]).toUpperCase();
            } else {
                return words[0].substring(0, 2).toUpperCase();
            }
        }
    }

    function goSvc(n) {
        const maxIdx = Math.max(0, totalSvc - 1);
        svcIdx = isNaN(n) ? 0 : Math.max(0, Math.min(maxIdx, Math.round(n)));

        document.getElementById('svcTrackHero').style.transform = 'translateX(-' + svcIdx * 100 + '%)';

        var dots = document.querySelectorAll('#svcDots > div');
        dots.forEach(function (d, i) {
            if (i === svcIdx) {
                d.style.width = '14px';
                d.style.borderRadius = '3px';
                d.style.background = 'var(--accent)';
            } else {
                d.style.width = '5px';
                d.style.borderRadius = '50%';
                d.style.background = 'var(--border2)';
            }
        });
    }

    function getStatusText(status) {
        return status === 40 ? 'Active'
            : status === 41 ? 'Locked'
                : status === 43 ? 'Inactivate'
                    : 'Terminate';
    }

