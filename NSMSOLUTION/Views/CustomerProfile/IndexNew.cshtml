        height: 100%;
        background: linear-gradient(180deg, var(--accent), var(--purple));
        border-radius: 4px 0 0 4px;
    }

    .svc-card.suspended::before {
        background: var(--red);
    }

    .svc-card.suspended:hover {
        border-color: var(--red);
    }

    .svc-card:hover {
        border-color: var(--accent);
        box-shadow: var(--shadow-lg);
