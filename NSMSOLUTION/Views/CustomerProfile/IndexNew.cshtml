        gap: 1.5rem;
        font-size: 12.5px;
        color: var(--text2);
        font-family: var(--mono);
        margin-top: 4px;
    }

    /* ── NOTES ── */
    textarea.note-area {
        width: 100%;
        min-height: 110px;
        padding: .85rem;
        border: 1.5px solid var(--border);
        border-radius: var(--radius);
