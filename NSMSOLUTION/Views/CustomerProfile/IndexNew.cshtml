                                    View</button></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    var customerId = '@customerId';
    var customerCode = '';
    var customerName = '';
    var totalSvc = 0;
    var svcIdx = 0;

    $(function () {
        // ── Sidebar: collapse on first visit, persist state across pages ──
        const sidebarKey = 'sidebarCollapsed';

        if (sessionStorage.getItem(sidebarKey) === null) {
            // very first load — collapse and remember
            $('body').addClass('sidebar-collapse');
            sessionStorage.setItem(sidebarKey, 'true');
        } else if (sessionStorage.getItem(sidebarKey) === 'true') {
            // subsequent loads — restore collapsed state silently
            $('body').addClass('sidebar-collapse');
        }

        // track manual toggle
        $("[data-widget=pushmenu]").on('click', function () {
            const willBeOpen = $('body').hasClass('sidebar-collapse');
            sessionStorage.setItem(sidebarKey, willBeOpen ? 'false' : 'true');
        });

        // Go to unpaid tab
        $('.stat[data-sub]').click(function () {
            const subTarget = $(this).data('sub');
            const $target = $(`[data-sub="${subTarget}"]`, '#invoiceSubTabs');

            if (!$target.length) return;

            $('.tab').removeClass('active');
            $('#invoiceSubTabs > .sub-tab').removeClass('active');

            const $targetParent = $('[data-panel="pan-invoice"]');
            $targetParent.addClass('active').trigger('click');

            $target.addClass('active').trigger('click');

            $target[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
        });

        // Main tab switching
        $('#mainTabs').on('click', '.tab', function () {
            var $tab = $(this);
            $('#mainTabs .tab').removeClass('active');
            $tab.addClass('active');
            var pid = $tab.data('panel');
            $('.body > .panel').removeClass('active');
            $('#' + pid).addClass('active');
            //$('html, body').animate({ scrollTop: 56 }, 200);
        });

        // Generic sub-tab handler factory
        function initSubTabs(tabContainerId, panelParentId) {
            $('#' + tabContainerId).on('click', '.sub-tab', function () {
                var $tab = $(this);
                $('#' + tabContainerId + ' .sub-tab').removeClass('active');
                $tab.addClass('active');
                var sid = $tab.data('sub');
                $('#' + panelParentId + ' .sub-panel').removeClass('active');
                $('#' + sid).addClass('active');

                if (sid === 'inv-quotation') getQuotation();
                if (sid === 'inv-unpaid') getInvoiceUnpaid();
                if (sid === 'inv-paid') getInvoicePaid();
            });
        }

        initSubTabs('invoiceSubTabs', 'pan-invoice');
        initSubTabs('svcSubTabs', 'pan-services');
        initSubTabs('fileSubTabs', 'pan-files');

        getCustomerById();
        loadTotalAmount();
        getAllConnection();
        getInvoiceUnpaid();
        quickSearch();

        // Do search customer 
        $(document).off('typeahead:select', '#search')
            .on('typeahead:select', '#search', function () {
                const custId = $('input[name="CustomerID"]').val();
                const url = `${ServerRoot}#!/CustomerProfile?ID=${custId}`;
                window.location.href = url;
            });

        // Sync service status router to system
        $(document).on('click', '.btn-sync-mismatch', async function () {
            const btn = $(this);
            const activateId = btn.data('activate-id');
            const statusId = btn.data('status-id');
            const endDate = btn.data('end-date');
            const routerId = btn.data('router-id');
            const pppoe = btn.data('pppoe');
            const vlan = btn.data('vlan');

            btn.addClass('syncing').prop('disabled', true);

            try {
                await $.ajax({
                    url: `api/Customer/UpdateStatus`,
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        CustomerID: customerId,
                        ActivateCustomerID: activateId,
                        EndDate: endDate,
                        StatusID: statusId,
                        RouterID: routerId,
                        PPPoEUserName: pppoe,
                        VLanName: vlan
                    })
                });

                btn.closest('.svc-card')
                    .addClass(`${statusId == 41 ? 'suspended' : ''}`);
                btn.closest('.svc-card')
                    .find('.conn-id, .s-id')
                    .removeClass(`${statusId == 40 ? 'text-red' : 'text-purple'} `)
                    .addClass(`${statusId == 40 ? 'text-purple' : 'text-red'} `);
                btn.closest('.svc-card')
                    .find('.progress-fill')
                    .removeClass(`${statusId == 40 ? 'progress-fill-red' : 'progress-fill-green'} `)
                    .addClass(`${statusId == 40 ? 'progress-fill-green' : 'progress-fill-red'} `);
                btn.closest('.svc-card')
                    .find('#system-status')
                    .removeClass(`${statusId == 40 ? 'badge-danger' : 'badge-green'} `)
                    .addClass(`${statusId == 40 ? 'badge-green' : 'badge-danger'} `)
                    .html(`
                        <i class="ti ${statusId === 40 ? 'ti-wifi' : 'ti-wifi-off'}"></i>
                        ${statusId == 40 ? 'Active' : 'Locked'}
                    `);

                btn.remove();
                DialogSweetAlert('success', 'Done Sync 🎉');
            } catch (e) {
                console.error('Sync failed', e);
                btn.removeClass('syncing').prop('disabled', false);
            }
        });

        // Delay Payment
        $("#delayPayment").click(function () {
            ShowDialogBox2("Delay Payment", "", "", "CustomerProfile/DelayPayment", customerId, "DialogDelayPayment", function () {

            });
        });

        // Telegram Notification
        $("#telegramNotification").click(function () {
            ShowDialogBox2("Customer Telegram", "auto", 500, "CustomerProfile/TelegramNotification/?CustomerName=" + encodeURIComponent(customerName) + "&CustomerCode=" + customerCode, customerId, "DialogCustTelegram", function () {
                $("#DialogCustTelegram").find('#SaveChange2').html('<i class="fa fa-print" aria-hidden="true"></i> Print');
                $("#DialogCustTelegram").find('#SaveChange2').hide();
                $("#custom-tabs-five-messages-tab").click(function () {
                    $("#DialogCustTelegram").find('#SaveChange2').show();
                    $("#DialogCustTelegram").find('#SaveChange2').click(function () {
                        $("#CustInvoice").printThis();
                    });
                })
                $("#custom-tabs-four-home-tab, #custom-tabs-four-profile-tab, #custom-tabs-four-messages-tab").click(function () {
                    $("#DialogCustTelegram").find('#SaveChange2').hide();
                });
            });
        });

        // Cutomer Feedback 
        $("#customerFeedback").click(function () {
            ShowDialogBox2("Customer Feedback", "auto", "", "CustomerFeedBack/?CustomerCode=" + customerCode, "", "", function () {
                $("#SaveChange2").remove();
            });
        });

        // Edit Profile Cutomer 
        $("#editProfile").click(function () {
            EditCustomerWithRefNumber(customerId, '', 'NewRegister');
        });

        // Change device router
        $("#ChangeDevice").click(function () {
            var URL = "CustomerProfile/ChangeDevice?CustomerID=" + Customer_ID;
            ShowDialogBox2("Change Device", "auto", "500", URL, 0, "DialogChangeDevice", function () {
                $("#DialogChangeDevice").on('hide.bs.modal', function () {
                    //loadItem();
                });
            });
        });

        // Return device
        $("#ReceivedDevice").click(function () {
            var URL = "CustomerProfile/ReceivedDevice?CustomerID=" + Customer_ID;
            ShowDialogBox2("Receive Device", "auto", "500", URL, 0, "DialogReceivedDevice", function () {
                $("#DialogReceivedDevice").on('hide.bs.modal', function () {
                    //loadItem();
                });
            });
        });
    });

    function getCustomerById() {

        LoadData(`api/Customer/Profile?CustomerID=${customerId}`, function (response) {

            if (response.length == 0) {
                $('.customer-profile').removeClass('d-none')
                    .html(`<span class="text-red">Not found customer!</span>`)
            }

            const res = response[0];
            const heroMeta = $('#heroMeta');
            const infoStrip = $('#infoStrip');

            let heroMetaContent = `
                <div class="hero-name">
                    ${stripHtml(res.CustomerName)}
                    <span class="cust-id text-primary" data-toggle="tooltip" data-placement="top" title="CID">${res.CustomerCode}</span>
                </div>
                <div class="hero-sub">
                    ${res.CustomerType} &nbsp;·&nbsp;
                    ${res.CustomerProvinceCity} &nbsp;·&nbsp;
                    Registered ${convertFormatDate(res.RegisterDate, 'dd MMM yyyy')} by ${res.RegisterBy}
                </div>
                <div class="hero-badges">
                    <!-- ATTName -->
                    ${res.ATTName ? `
                    <span class="badge badge-info" data-toggle="tooltip" data-placement="top" title="ATTName">
                        <i class="ti ti-door"></i> ${res.ATTName}
                    </span>` : ''}

                    <!-- Industry -->
                    ${res.IndustryType ? `
                    <span class="badge badge-blue" data-toggle="tooltip" data-placement="top" title="Bussiness Type">
                        <i class="ti ti-briefcase"></i> ${res.IndustryType}
                    </span>` : ''}

                    <!-- National ID -->
                    ${res.CustomerIdentification ? `
                    <span class="badge badge-neutral" data-toggle="tooltip" data-placement="top" title="National ID / Passport">
                        <i class="ti ti-id-badge"></i> ${res.CustomerIdentification}
                    </span>` : ''}
                </div>
            `;

            let infoStripContent = `
                <div class="info-cell">
                    <div class="info-cell-icon"><i class="ti ti-phone-ringing"></i></div>
                    <div><div class="info-cell-lbl">Mobile</div><div class="info-cell-val">${res.CustomerMobile}</div></div>
                </div>
                <div class="info-cell">
                    <div class="info-cell-icon"><i class="ti ti-mail"></i></div>
                    <div><div class="info-cell-lbl">Email</div><div class="info-cell-val">${res.CustomerEmail || `N/A`}</div></div>
                </div>
                <div class="info-cell">
                    <div class="info-cell-icon"><i class="ti ti-map-pin"></i></div>
                    <div><div class="info-cell-lbl">Address</div><div class="info-cell-val">${res.CustomerAddress}</div></div>
                </div>
                <div class="info-cell">
                    <div class="info-cell-icon"><i class="ti ti-globe"></i></div>
                    <div><div class="info-cell-lbl">Nationality</div><div class="info-cell-val">${res.CustomerNationality}</div></div>
                </div>
            `;

            $('.customer-profile').removeClass('d-none');

            heroMeta.html(heroMetaContent);
            infoStrip.html(infoStripContent);

            var shortName = getShortNameProfile(res.CustomerName);
            $("#nameProfile").text(shortName);

            customerCode = res.CustomserCode;
            customerName = res.CustomerName;
        }, undefined, 'json');
    }

    async function getAllConnection() {
        LoadData(`api/Customer/AllConnection?CustomerID=${customerId}`, async function (response) {
            if (!response || response.length === 0) return;

            totalSvc = response.length;
            if (totalSvc === 1) $('#svc-navication').hide();

            const svcDots = $('#svcDots');
            svcDots.html(response.map((_, index) => `
                <div onclick="goSvc(${index})" style="
                    width:${index === 0 ? '14px' : '5px'};
                    height:5px;
                    border-radius:${index === 0 ? '3px' : '50%'};
                    background:var(${index === 0 ? '--accent' : '--border2'});
                    cursor:pointer;
                    transition:all .25s">
                </div>
            `).join(''));

            let activeCount = 0;
            let disableCount = 0;

            const svcHtml = await Promise.all(
                response.map(async (val, index) => {
                    const statusText = getStatusText(val.ConnectivityStatus);

                    const router = val.ConnectionType === 'PPPoE'
                        ? await getUserPPPoE(val.RouterID, val.PPPoEUserName)
                        : await getUserVlan(val.RouterID, val.VLanName, val.VLanID);

                    activeCount += router?.disabled === 'false' ? 1 : 0;
                    disableCount += router?.disabled === 'true' ? 1 : 0;

                    const isActive = val.ConnectivityStatus === 40;
                    const isSuspended = val.ConnectivityStatus === 41;

                    const isMismatch = (isActive && router?.disabled === 'true')
                        || (isSuspended && router?.disabled === 'false');

                    const statusId = (isActive && router?.disabled === 'true') ? 41 : 40;

                    const isExpired = new Date(val.EndDate) < new Date();

                    return `
                    <div style="min-width:100%">
                        <div class="svc-card ${!isActive ? 'suspended' : ''}" data-activate-id="${val.ActivateCustomerID}">
                            <div class="svc-card-top">
                                <div>
                                    <div class="svc-plan">${val.PackageName} - ${val.Bandwidth} Mbps - ${val.UM}</div>
                                    <div class="svc-detail">${val.PackageName} · ${val.DowSpeed} Mbps down / ${val.UpSpeed} Mbps up</div>
                                    <div class="svc-ids">
                                        ConnectionID: <span class="conn-id ${isActive ? 'text-purple' : 'text-danger'}">${val.ConnectionID}</span>
                                        SID: <span class="s-id ${isActive ? 'text-purple' : 'text-danger'}" data-toggle="tooltip" data-placement="top" title="SID">${val.SID}</span>
                                        Inv #: <span class="td-link">${val.InvoiceNo}</span>
                                        Ticket #: <span class="td-link">${val.TicketNumber}</span>
                                    </div>
                                </div>
                                <span id="system-status-${index}" class="badge ${isActive ? 'badge-green' : 'badge-danger'}" data-toggle="tooltip" data-placement="top" title="System Status">
                                    <i class="ti ${isActive ? 'ti-wifi' : 'ti-wifi-off'}"></i>
                                    ${statusText}
                                </span>
                            </div>

                            <div class="conn-info">
                                <span><span style="color:var(--text3)">Connection Type:</span>&nbsp;<b>${val.ConnectionType || 'N/A'}</b></span>
                                <span><span style="color:var(--text3)">Router:</span>&nbsp;<b data-toggle="tooltip" data-placement="top" title="${val.RouterID}">${val.RouterName || 'N/A'}</b></span>
                                ${val.ConnectionType === 'PPPoE' ? `<span><span style="color:var(--text3)">PPPoE Username:</span>&nbsp;<b>${val.PPPoEUserName || 'N/A'}</b></span>` : ''}
                                ${val.ConnectionType === 'Static' ? `
                                    <span><span style="color:var(--text3)">VLAN:</span>&nbsp;<b>${val.VLanName || 'N/A'}</b></span>
                                    <span><span style="color:var(--text3)">IP Address:</span>&nbsp;<b>${val.IPAddress || 'N/A'}</b></span>
                                ` : ''}
                                <span>
                                    ${router.success ? `<span style="color:var(--text3)">Device Status:</span>&nbsp;
                                        <span class="chip ${router.disabled === 'false' ? 'chip-green' : 'chip-red'} fw-500"
                                            data-toggle="tooltip" data-placement="top" title="Router Status">
                                            ${router.disabled === 'false'
                                ? '<i class="status-pulse-green"></i> Active'
                                : '<i class="status-pulse-red"></i> Disabled'}
                                        </span>` : `<span style="color:var(--text3)" data-toggle="tooltip" data-placement="top" title="${router.message}">Device Status: N/A</span>`}
                                    ${isMismatch ? `
                                        <button class="btn-sync-mismatch"
                                            data-toggle="tooltip" data-placement="top"
                                            title="System is Active but router is Disabled — click to sync"
                                            data-activate-id="${val.ActivateCustomerID}"
                                            data-status-id="${statusId}"
                                            data-end-date="${val.EndDate}"
                                            data-router-id="${val.RouterID}"
                                            data-pppoe="${val.PPPoEUserName || ''}"
                                            data-vlan="${val.VLanName || ''}">
                                            <i class="ti ti-refresh-alert"></i> Sync
                                        </button>` : ''}
                                </span>
                            </div>

                            <div style="display:flex;justify-content:space-between;font-size:13.5px;color:var(--text2);margin-bottom:3px">
                                <span class="d-flex align-items-center gap-6"><i class="ti ti-access-point" style="font-size: 16px;"></i><span>Start: ${convertFormatDate(val.StartDate, 'dd MMM yyyy')} → End: ${convertFormatDate(val.EndDate, 'dd MMM yyyy')}</span></span>
                                ${!isExpired
                            ? `<span>
                                        <span style="color:var(--red);font-weight:600">${val.DayUsed} ${val.DayUsed === 1 ? 'day' : 'days'} used</span>
                                            · <span style="color:var(--accent);font-weight:600">${val.DayLeft} ${val.DayLeft === 1 ? 'day' : 'days'} left</span>
                                    </span>` : `<span class="text-red fw-500">Expired</span>`
                        }
                            </div>

                            <div class="progress" data-toggle="tooltip" data-placement="top" title="${val.TotalUsedPercent}%">
                                <div class="progress-fill ${val.TotalUsedPercent >= 100 && !isActive ? 'progress-fill-red' : 'progress-fill-green'}" style="width:${val.TotalUsedPercent}%"></div>
                            </div>

                            <div class="svc-meta">
                                <span>Cycle: <b>${val.UM}</b></span>
                                <span>Due: <b style="color:var(--red)">${convertFormatDate(val.PaymentDueDate, 'dd MMM yyyy')}</b></span>
                                <span>Next: <b style="color:var(--accent)">${convertFormatDate(val.NextInvoiceDate, 'dd MMM yyyy')}</b></span>
                                <div class="auto-lock">
                                    <label class="toggle">
                                        <input type="checkbox" ${val.AutoLock ? 'checked' : ''}>
                                        <span class="toggle-slider"></span>
                                    </label>Auto Lock
                                </div>
                            </div>

                            <div class="svc-actions">
                                <div class="d-flex justify-content-between">
                                    <div class="d-flex gap-6">
                                        <button class="btn btn-success btn-sm" onclick="RenewDialog(${customerId}, '${stripHtml(val.InvoiceNo)}')"><i class="ti ti-recycle"></i> Renew</button>
                                        <button class="btn btn-primary btn-sm" onclick="ChangePlanDialog(${customerId}, '${stripHtml(val.InvoiceNo)}')"><i class="ti ti-switch-3"></i> Change Plan</button>
                                        <button class="btn btn-secondary btn-sm" onclick="ActivateCustomerService(${val.BillingInvoiceID}, '${val.PPPoEUserName}', ${val.PackageDetailID}, ${val.ActivateCustomerID}, ${val.ServiceID}, ${val.RouterID}, '${stripHtml(val.InvoiceNo)}', ${val.PackageTypeID})">
                                            <i class="ti ti-router"></i> Activate Service
                                        </button>
                                        <button class="btn btn-secondary btn-sm" onclick="GetPPPeEUser_Online(true, '${val.PPPoEUserName}', '${val.ConnectionID}')"><i class="ti ti-history"></i> Log</button>
                                        <button class="btn btn-secondary btn-sm" onclick="NewTicket(0, '${val.ConnectionID}')"><i class="ti ti-ticket"></i> Ticket</button>
                                    </div>
                                    ${isExpired && router?.disabled === 'false' ? `
                                        <div><span class="badge badge-warning">
                                          <i class="ti ti-alert-triangle"></i> Expired — still active on router
                                        </span></div>
                                      ` : ''}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                })
            );

            $('#all-connection').show();
            $('#total-connection').text(totalSvc);
            $('#svcTrackHero').html(svcHtml.join(''));

            if (response[0].ConnectionType === 'PPPoE') {
                trackingUserOnline(response[0].RouterID, response[0].PPPoEUserName);
            }

            const sActive = response.filter(x => x.ConnectivityStatus === 40).length;
            const sInactive = response.filter(x => x.ConnectivityStatus === 43).length;
            const sLocked = response.filter(x => x.ConnectivityStatus === 41).length;
            const sTerminate = response.filter(x => x.ConnectivityStatus === 42).length;

            $('#count-device-status').html(`
            ${activeCount > 0 ? `
                <span class="pill pill-green fw-500" data-toggle="tooltip" data-placement="top" title="Router Status">
                    <span class="dot"></span> Active <span class="count">${activeCount}</span>
                </span>` : ''}
                ${disableCount > 0 ? `
                <span class="pill pill-red fw-500" data-toggle="tooltip" data-placement="top" title="Router Status">
                    <span class="dot"></span> Disabled <span class="count">${disableCount}</span>
                </span>` : ''}
            `);

            // ✅ moved outside Promise.all — only bind once, not per card
            $(document).off('change', '.auto-lock input[type="checkbox"]').on('change', '.auto-lock input[type="checkbox"]', function () {
                const isChecked = $(this).is(':checked');
                const activateId = $(this).closest('.svc-card').data('activate-id');
                console.log(activateId, isChecked);
            });

        }, undefined, 'json');
    }

    function getUserPPPoE(routerId, username) {
        return new Promise((resolve, reject) => {
            const url = `api/mikrotik/pppoe/users/${username}/status?routerId=${routerId}`;

            LoadData(url, function (response) {
                resolve(response);
            }, undefined, 'json');
        });
    }

    function getUserVlan(routerId, vlanName, vlanId) {
        return new Promise((resolve, reject) => {
            const url = `api/mikrotik/vlans/${vlanName}/status?routerId=${routerId}&vlanId=${vlanId}`;

            LoadData(url, function (response) {
                resolve(response);
            }, function (err) {
                reject(err);
            }, 'json');
        });
    }

    function trackingUserOnline(routerId, username) {
        const userActive = $('#online-offline');
        const url = `api/mikrotik/sessions/${username}/history?routerId=${routerId}`;

        LoadData(url, function (response) {

            const sessions = response.data || [];

            let lastSession = sessions.find(x => x.active === "true");

            if (!lastSession) {
                lastSession = sessions.sort((a, b) =>
                    new Date(b.started) - new Date(a.started)
                )[0];
            }
            console.log(lastSession)
            if (!lastSession) return;

            const isOnline = lastSession.active === "true";

            userActive.html(`
                <span class="${isOnline ? 'status-pulse-green' : 'status-pulse-red'}"></span>
                ${isOnline ? 'Online' : 'Offline'}
            `);

            userActive
                .removeClass('d-none status-pill-green status-pill-red')
                .addClass(isOnline ? 'status-pill-green' : 'status-pill-red');

        }, undefined, 'json');
    }

    function loadTotalAmount() {
        LoadData(`api/Customer/CustomerTotalBalance?CustomerID=${customerId}`,
            function (response) {
                const res = response[0];
                const exrate = res.ExchangeRate;
                const dateExrate = res.DateEntry;
                const totalBalance = res.Balance;
                const totalPaid = res.Paid;
                const totalUnpaid = res.Unpaid;
                const totalDeposit = res.Deposit;

                $('#exrate').html(`1 USD = ${accounting.formatNumber(exrate)} KHR &nbsp;·&nbsp; ${convertFormatDate(dateExrate, 'dd MMM yyyy')}`);

                $('#total-amount-balance').html(`${accounting.formatMoney(totalBalance)}`);
                $('#total-amount-paid').html(`${accounting.formatMoney(totalPaid)}`);
                $('#total-amount-unpaid').html(`${accounting.formatMoney(totalUnpaid)}`);
                $('#total-amount-deposit').html(`${accounting.formatMoney(totalDeposit)}`);
            },
            undefined,
            'json'
        );
    }

    function getInvoiceUnpaid() {

        LoadData(`api/Customer/Unpaid?CustomerID=${customerId}`, function (response) {

            const $tbody = $('#inv-unpaid tbody').empty();

            if (!response || response.length === 0) {
                $tbody.html(`
                    <tr>
                        <td colspan="12" class="td-mono text-center fw-500">
                            No Data
                        </td>
                    </tr>
                `);

                $('#total-unpaid-badge').css('display', 'none');
                $('#alert-overdue').closest('.alert-banner').hide();
                $('#total-amount-unpaid').html('$ 0');
                $('#total-overdue').html('$ 0');
                $('#latest-due-date').html('-');

                return;
            }

            let overdueCount = 0;
            let totalOverdueAmount = 0;
            let totalAmount = 0;
            let totalUnpaid = 0;
            let totalPaid = 0;
            let latestDueDate = null;

            const today = new Date();
            today.setHours(0, 0, 0, 0);

            let html = response.map((val, index) => {

                const dueDate = new Date(val.PaymentDueDate);
                dueDate.setHours(0, 0, 0, 0);

                let status = 'Unpaid';
                let badgeClass = 'badge-red';

                // PAID
                if (val.Unpaid <= 0) {
                    status = 'Paid';
                    badgeClass = 'badge-green';
                }
                // OVERDUE
                else if (dueDate < today) {
                    status = 'Overdue';
                    badgeClass = 'badge-red';

                    overdueCount++;
                    totalOverdueAmount += val.Unpaid;

                    if (!latestDueDate || dueDate > latestDueDate) {
                        latestDueDate = dueDate;
                    }
                }
                // DUE TODAY
                else if (dueDate.getTime() === today.getTime()) {
                    status = 'Due Today';
                    badgeClass = 'badge-warning';
                }
                // PARTIAL
                else if (val.Paid > 0) {
                    status = 'Partial';
                    badgeClass = 'badge-blue';
                }

                totalAmount += val.GrandTotal;
                totalUnpaid += val.Unpaid;
                totalPaid += val.Paid;

                return `
                    <tr>
                        <td>${index + 1}</td>
                        <td>${convertFormatDate(val.InvoiceDate, 'dd MMM yyyy')}</td>
                        <td class="td-link">${val.InvoiceNo}</td>
                        <td class="td-mono text-red">${val.InvoiceAge} ${val.InvoiceAge > 1 ? 'Days' : 'Day'}</td>
                        <td>${val.PackageName}</td>
                        <td style="color:var(--red);font-weight:600">${convertFormatDate(val.PaymentDueDate, 'dd MMM yyyy')}</td>
                        <td class="td-mono text-red">${val.DuePeriod} ${val.DuePeriod > 1 ? 'Days' : 'Day'}</td>
                        <td class="td-mono fw-500">${accounting.formatMoney(val.GrandTotal)}</td>
                        <td class="td-mono text-success fw-500">${accounting.formatMoney(val.Paid)}</td>
                        <td class="td-mono text-danger fw-500">${accounting.formatMoney(val.Unpaid)}</td>
                        <td>
                            <span class="badge ${badgeClass}">
                                ${status}
                            </span>
                        </td>
                        <td>
                            <div style="display:flex;gap:4px">
                                <button class="btn bg-primary btn-sm">
                                    <i class="ti ti-credit-card"></i>
                                    Pay Now
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');

            html += `
                <tr class="fw-500">
                   7<td colspan="7" align="right">Total:</td>
                    <td class="td-mono">${accounting.formatMoney(totalAmount)}</td>
                    <td class="td-mono">${accounting.formatMoney(totalPaid)}</td>
                    <td class="td-mono">${accounting.formatMoney(totalUnpaid)}</td>
                    <td colspan="2"></td>
                </tr>
            `;

            // TABLE RENDER
            $tbody.html(html);

            // TOTALS
            $('#total-unpaid-badge').html(response.length);

            // OVERDUE ALERT (ONLY OVERDUE)
            if (overdueCount > 0) {

                $('#alert-overdue').text(
                    `${overdueCount} ${overdueCount > 1 ? 'overdue invoices' : 'overdue invoice'}`
                );

                $('#total-overdue').text(`$${totalOverdueAmount.toFixed(2)}`);

                $('#latest-due-date').text(
                    latestDueDate ? convertFormatDate(latestDueDate, 'dd MMM yyyy') : '-'
                );

                $('.alert-banner').show();

            } else {
                $('.alert-banner').hide();
            }

        }, undefined, 'json');
    }

