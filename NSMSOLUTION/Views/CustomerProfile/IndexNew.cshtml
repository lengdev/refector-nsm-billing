@model int
@{
Layout = "";
ViewBag.Title = "Customer Profile";
var customerId = Model;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=DM+Mono:wght@400;500&display=swap"
    rel="stylesheet">
<style>
    :root {
        --bg: #f5f6fa;
        --bg2: #eef0f7;
        --surface: #ffffff;
        --surface2: #f8f9fc;
        --surface3: #f0f2f8;
        --border: #e4e7f0;
        --border2: #cdd2e4;
        --text: #343a40;
        --text2: #5a6282;
        --text3: #9ba3c0;
        --accent: #3b62f5;
        --accent2: #2a4fe0;
        --accent-light: #eff3ff;
        --green: #0ea871;
        --green-bg: #edfaf5;
        --red: #e63c5e;
        --red-bg: #fff0f3;
        --amber: #e8910a;
        --amber-bg: #fff8ec;
        --purple: #7c51eb;
        --shadow-sm: 0 1px 3px rgba(20, 25, 40, 0.06), 0 1px 2px rgba(20, 25, 40, 0.04);
        --shadow: 0 2px 8px rgba(20, 25, 40, 0.08), 0 1px 3px rgba(20, 25, 40, 0.05);
        --shadow-lg: 0 8px 32px rgba(20, 25, 40, 0.1), 0 2px 8px rgba(20, 25, 40, 0.06);
        --radius: 10px;
        --radius-lg: 14px;
        --font: 'DM Sans', sans-serif !important;
        --mono: 'DM Mono', monospace !important;
    }

    html {
        scroll-behavior: smooth;
    }

    .customer-profile {
        font-family: var(--font) !important;
        background: var(--bg);
        color: var(--text);
        font-size: 16px !important;
        line-height: 1.6;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    a {
        text-decoration: none;
        color: var(--accent);
    }

    ::-webkit-scrollbar {
        width: 5px;
        height: 5px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: var(--border2);
        border-radius: 99px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: var(--text3);
    }

    /* ── TOPBAR ── */
    .topbar {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 0 1.5rem;
        height: 56px;
        display: flex;
        align-items: center;
        gap: 1rem;
        position: sticky;
        top: 0;
        z-index: 200;
        box-shadow: var(--shadow-sm);
    }

    .topbar-brand {
        font-weight: 700;
        letter-spacing: -0.4px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text);
        white-space: nowrap;
    }

    .brand-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--accent);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 15px;
        box-shadow: 0 2px 8px rgba(59, 98, 245, 0.35);
    }

    .topbar-sep {
        width: 1px;
        height: 22px;
        background: var(--border);
        flex-shrink: 0;
    }

    .topbar-search {
        flex: 1;
        max-width: 300px;
        margin-left: .5rem;
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--surface3);
        border: 1px solid var(--border);
        border-radius: 9px;
        padding: 6px 12px;
        cursor: text;
        transition: all 0.18s;
        position: relative;
    }

    .topbar-search:hover,
    .topbar-search:focus-within {
        border-color: var(--accent);
        background: #fff;
        box-shadow: 0 0 0 3px var(--accent-light);
    }

    .topbar-search i {
        font-size: 15px;
        color: var(--text3);
        flex-shrink: 0;
    }

    .topbar-search input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        outline: none;
        font-size: 13px;
        color: var(--text1);
        font-family: var(--sans);
    }

    .topbar-search input:focus {
        box-shadow: none !important;
    }

    .topbar-search input::placeholder {
        color: var(--text3);
    }

    .topbar-search kbd {
        margin-left: auto;
        font-size: 10px;
        color: var(--text3);
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 1px 6px;
        font-family: var(--mono);
        flex-shrink: 0;
        transition: opacity 0.15s;
    }

    .topbar-search kbd.hidden {
        opacity: 0;
        pointer-events: none;
    }

    /* spinner */
    .ts-spinner {
        width: 13px;
        height: 13px;
        border: 2px solid var(--border);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: ts-spin 0.6s linear infinite;
        flex-shrink: 0;
        display: none;
    }

    .ts-spinner.active {
        display: block;
    }

    @@keyframes ts-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* dropdown */
    .ts-dropdown {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        width: 320px;
        background: var(--surface, #fff);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.09);
        z-index: 999;
        overflow: hidden;
    }

    .ts-dropdown.open {
        display: block;
    }

    .ts-section {
        padding: 6px 10px 3px;
        font-size: 10px;
        color: var(--text3);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .ts-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 12px;
        cursor: pointer;
        transition: background 0.1s;
    }

    .ts-item:hover,
    .ts-item.focused {
        background: var(--accent-light, #fdf6ea);
    }

    .ts-avatar {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: var(--surface3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 600;
        color: var(--accent);
        flex-shrink: 0;
    }

    .ts-name {
        font-size: 13px;
        font-weight: 500;
        color: var(--text1);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ts-meta {
        font-size: 11px;
        color: var(--text3);
        margin-top: 1px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ts-id {
        margin-left: auto;
        font-size: 10px;
        font-family: var(--mono);
        color: var(--text3);
        background: var(--surface3);
        border-radius: 4px;
        padding: 2px 5px;
        flex-shrink: 0;
    }

    .ts-empty {
        padding: 18px 12px;
        font-size: 13px;
        color: var(--text3);
        text-align: center;
    }

    .ts-highlight {
        background: color-mix(in srgb, var(--accent) 20%, transparent);
        border-radius: 2px;
        padding: 0 1px;
    }

    .topbar-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .icon-btn {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: 1px solid transparent;
        color: var(--text2);
        cursor: pointer;
        transition: all 0.15s;
        font-size: 17px;
        position: relative;
    }

    .icon-btn:hover {
        background: var(--surface3);
        border-color: var(--border);
        color: var(--text);
    }

    .notif-dot {
        position: absolute;
        top: 7px;
        right: 7px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--red);
        border: 2px solid var(--surface);
    }

    .topbar-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #dbe4ff, #ede9ff);
        border: 1px solid var(--border2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11.5px;
        font-weight: 700;
        color: var(--accent);
        cursor: pointer;
        letter-spacing: 0.3px;
    }

    /* ── HERO ── */
    .hero {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        /*        position: relative;*/
        overflow: hidden;
    }

    .hero::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 500px;
        height: 100%;
        background: linear-gradient(135deg, transparent 60%, rgba(59, 98, 245, 0.03) 100%);
        pointer-events: none;
    }

    .hero-inner {
        /*max-width: 1340px;*/
        margin: 0 auto;
        padding: 1.5rem 1.5rem 0;
        position: relative;
        z-index: 1;
        animation: fadeUp 0.3s ease both;
    }

    .hero-top {
        display: flex;
        gap: 1.5rem;
        align-items: flex-start;
        margin-bottom: 1.25rem;
    }

    .avatar-wrap {
        position: relative;
        flex-shrink: 0;
    }

    .avatar {
        width: 100px;
        height: 100px;
        border-radius: 20px;
        background: linear-gradient(135deg, #dbe4ff 0%, #ede9ff 100%);
        border: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        font-weight: 700;
        color: var(--accent);
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.2s;
        letter-spacing: -1px;
        box-shadow: var(--shadow);
    }

    .avatar:hover {
        border-color: var(--accent);
        box-shadow: 0 0 0 4px var(--accent-light);
    }

    .avatar-overlay {
        position: absolute;
        inset: 0;
        background: rgba(59, 98, 245, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.18s;
        color: #fff;
        font-size: 18px;
    }

    .avatar:hover .avatar-overlay {
        opacity: 1;
    }

    .pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px 3px 6px !important;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.02em;
        white-space: nowrap;
        cursor: default;
        transition: opacity .15s;
    }

    .pill:hover {
        opacity: .75;
    }

    .pill .dot {
        width: 5px;
        height: 5px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .pill .count {
        font-size: 10px;
        font-weight: 600;
        min-width: 14px;
        height: 14px;
        border-radius: 4px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 3px;
    }

    /* Green — Active */
    .pill-green {
        background: var(--green-bg);
        color: var(--green);
        border: 1px solid rgba(14, 168, 113, 0.3);
    }

    .pill-green .dot {
        background: var(--green);
    }

    .pill-green .count {
        background: rgba(14, 168, 113, 0.15);
        color: var(--green);
    }

    /* Red — Locked */
    .pill-red {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid rgba(230, 60, 94, 0.2);
    }

    .pill-red .dot {
        background: var(--red);
    }

    .pill-red .count {
        background: rgba(230, 60, 94, 0.12);
        color: var(--red);
    }

    /* Gray — Inactive / fallback */
    .pill-gray {
        background: var(--surface-2, rgba(0, 0, 0, .04));
        color: var(--text2);
        border: 1px solid var(--border);
    }

    .pill-gray .dot {
        background: var(--text2);
    }

    .pill-gray .count {
        background: rgba(0, 0, 0, .07);
        color: var(--text2);
    }

    .status-pill {
        position: absolute;
        bottom: -7px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 9px;
        font-weight: 700;
        padding: 1px 8px;
        border-radius: 99px;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 3px;
        letter-spacing: 0.5px;
    }

    .status-pill-green {
        background: var(--green-bg);
        color: var(--green);
        border: 1px solid rgba(14, 168, 113, 0.3);
    }

    .status-pill-red {
        background: var(--red-bg);
        color: var(--red);
        border: 1px solid rgba(230, 60, 94, 0.2);
    }

    .status-pulse-green,
    .status-pulse-red {
        width: 5px;
        height: 5px;
        border-radius: 50%;
    }

    .status-pulse-green {
        background: var(--green);
        animation: pulseGreen 2s infinite;
    }

    .status-pulse-red {
        background: var(--red);
        animation: pulseRed 2s infinite;
    }

    /* GREEN */
    @@keyframes pulseGreen {
        0% {
            box-shadow: 0 0 0 0 rgba(14, 168, 113, 0.5);
        }

        70% {
            box-shadow: 0 0 0 5px rgba(14, 168, 113, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(14, 168, 113, 0);
        }
    }

    /* RED */
    @@keyframes pulseRed {
        0% {
            box-shadow: 0 0 0 0 rgba(230, 60, 94, 0.5);
        }

        70% {
            box-shadow: 0 0 0 5px rgba(230, 60, 94, 0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(230, 60, 94, 0);
        }
    }

    .hero-meta {
        flex: 1;
        min-width: 0;
        padding-top: 4px;
    }

    .hero-name {
        font-family: Inter, 'Moul', sans-serif !important;
        font-size: 20px;
        text-transform: uppercase;
        font-weight: 500;
        color: var(--text);
        letter-spacing: -0.3px;
        line-height: 1.2;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 10px;
    }

    .cust-id,
    .conn-id,
    .s-id {
        font-size: 11.5px;
        font-weight: 500;
        color: var(--text3);
        background: var(--surface3);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 2px 8px;
        letter-spacing: 0.5px;
        font-family: var(--mono);
    }

    .hero-sub {
        color: var(--text2);
        margin-top: 4px;
        font-size: 14.5px;
    }

    .hero-badges {
        display: flex;
        gap: 5px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 13.5px;
        padding: 3px 9px;
        border-radius: 7px;
        font-weight: 500;
        border: 1px solid transparent;
        white-space: nowrap;
    }

    .badge-blue {
        background: var(--accent-light);
        color: var(--accent);
        border-color: rgba(59, 98, 245, 0.2);
    }

    .badge-green {
        background: var(--green-bg);
        color: var(--green);
        border-color: rgba(14, 168, 113, 0.2);
    }

    .badge-red {
        background: var(--red-bg);
        color: var(--red);
        border-color: rgba(230, 60, 94, 0.2);
    }

    .badge-amber {
        background: var(--amber-bg);
        color: var(--amber);
        border-color: rgba(232, 145, 10, 0.2);
    }

    .badge-neutral {
        background: var(--surface3);
        color: var(--text2);
        border-color: var(--border);
    }

    .badge-purple {
        background: #f3f0ff;
        color: var(--purple);
        border-color: rgba(124, 81, 235, 0.2);
    }

    .hero-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
        flex-shrink: 0;
    }

    .exrate {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 8px;
        background: var(--amber-bg);
        border: 1px solid rgba(232, 145, 10, 0.2);
        font-size: 11.5px;
        font-weight: 600;
        color: var(--amber);
    }

    .stats-row {
        display: flex;
        gap: 6px;
    }

    .stat {
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: 12px;
        padding: 10px 16px;
        text-align: center;
        min-width: 80px;
        cursor: pointer;
        transition: all 0.15s;
    }

    .stat:hover {
        border-color: var(--accent);
        box-shadow: 0 0 0 3px var(--accent-light);
    }

    .stat-val {
        font-size: 17px;
        font-weight: 500;
        font-family: var(--mono);
        letter-spacing: -0.5px;
        color: var(--text);
    }

    .stat-val.green {
        color: var(--green);
    }

    .stat-val.red {
        color: var(--red);
    }

    .stat-lbl {
        font-size: 12px;
        color: var(--text3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 2px;
        font-weight: 600;
    }

    .hero-actions {
        display: flex;
        gap: 6px;
    }

    /* ── INFO STRIP ── */
    .info-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-top: 1px solid var(--border);
        margin-top: .25rem;
    }

    .info-cell {
        padding: 11px 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        border-right: 1px solid var(--border);
        transition: background 0.15s;
        cursor: default;
    }

    .info-cell:last-child {
        border-right: none;
    }

    .info-cell:hover {
        background: var(--surface2);
    }

    .info-cell-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: var(--surface3);
        border: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        color: var(--text3);
        flex-shrink: 0;
    }

    .info-cell-lbl {
        font-size: 12px;
        color: var(--text3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 600;
        margin-bottom: 1px;
    }

    .info-cell-val {
        font-size: 14px;
        color: var(--text);
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── TABS BAR ── */
    .tabs-bar-wrap {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 56px;
        z-index: 100;
        box-shadow: var(--shadow-sm);
        animation: fadeUp 0.3s 0.05s ease both;
    }

    .tabs-bar {
        /*max-width: 1340px;*/
        margin: 0 auto;
        padding: 0 1.5rem;
        display: flex;
        gap: 0;
        overflow-x: auto;
        scrollbar-width: none;
    }

    .tabs-bar::-webkit-scrollbar {
        display: none;
    }

    .tab {
        font-size: 15px;
        padding: 12px 14px;
        color: var(--text3);
        cursor: pointer;
        white-space: nowrap;
        border-bottom: 2px solid transparent;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
        font-weight: 500;
    }

    .tab:hover {
        color: var(--text2);
    }

    .tab.active {
        color: var(--accent);
        border-bottom-color: var(--accent);
    }

    .tab.active i {
        color: var(--accent);
    }

    .tab-badge {
        background: var(--red);
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        padding: 0 5px;
        border-radius: 99px;
        min-width: 16px;
        text-align: center;
        line-height: 16px;
    }

    /* ── BODY ── */
    .body {
        /*max-width: 1340px;*/
        margin: 0 auto;
        padding: 1.5rem;
        animation: fadeUp 0.3s 0.1s ease both;
    }

    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .panel {
        display: none;
    }

    .panel.active {
        display: block;
        animation: fadeUp 0.2s ease both;
    }

    /* ── CARD ── */
    .customer-profile .card {
        background: var(--surface);
        border: 1.5px solid var(--border);
        border-radius: var(--radius-lg);
        padding: 1.25rem;
        margin-bottom: 1rem;
        box-shadow: var(--shadow-sm);
    }

    .customer-profile .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        gap: .5rem;
    }

    .customer-profile .card-header::after {
        content: none !important;
    }

    .customer-profile .card-title {
        font-weight: 700;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 7px;
        letter-spacing: -0.3px;
    }

    .customer-profile .card-title i {
        font-size: 16px;
        color: var(--text3);
    }

    .card-title-sm {
        font-size: 11px;
        font-weight: 700;
        color: var(--text3);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: .75rem;
        text-transform: uppercase;
        letter-spacing: 0.6px;
    }

    .card-title-sm i {
        font-size: 14px;
    }

    .two-col {
        display: grid;
