        align-items: center;
        justify-content: center;
        border-radius: 99px;
        font-size: 13px;
        font-weight: 700;
        margin-left: 4px;
    }

    .btn-sync-mismatch {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 5px;
