        font-family: var(--font);
        font-size: 13px;
        resize: vertical;
        transition: border-color 0.15s;
        outline: none;
    }

    textarea.note-area:focus {
        border-color: var(--accent);
        background: var(--surface);
        box-shadow: 0 0 0 3px var(--accent-light);
    }

    /* ── EMPTY STATE ── */
    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text3);
    }

