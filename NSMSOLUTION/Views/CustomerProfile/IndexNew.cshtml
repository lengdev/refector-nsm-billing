        padding: 9px 12px;
        margin-bottom: .75rem;
    }

    .conn-info span {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 13.5px;
        color: var(--text2);
    }

    .conn-info span b {
        color: var(--text);
        font-family: var(--mono);
        font-weight: 500;
    }

    .progress {
        height: 5px;
        background: var(--surface3);
        border-radius: 99px;
        overflow: hidden;
        margin: 6px 0 4px;
    }

    .progress-fill {
        height: 100%;
        border-radius: 99px;
        background: linear-gradient(90deg,
                #00c6ff 0%,
                #0072ff 25%,
                #7b61ff 50%,
                #c44dff 75%,
                #ff4fd8 100%);
        background-size: 200% 200%;
        box-shadow:
            0 0 12px rgba(0, 198, 255, 0.45),
            0 0 24px rgba(196, 77, 255, 0.35);
        transition: width 0.8s ease;
        animation: gradientMove 6s ease infinite;
    }

    .progress-fill-blue {
        background: linear-gradient(90deg,
                #00d2ff 0%,
                #3a7bff 35%,
                #6a5cff 70%,
                #8f5bff 100%);
        box-shadow:
            0 0 10px rgba(0, 210, 255, 0.45),
            0 0 18px rgba(106, 92, 255, 0.4);
    }

    .progress-fill-red {
        background: linear-gradient(90deg,
                #ff4b4b 0%,
                #ff0066 35%,
                #ff4d9d 70%,
                #ff8a5b 100%);
        box-shadow:
            0 0 10px rgba(255, 0, 102, 0.45),
            0 0 18px rgba(255, 75, 75, 0.4);
    }

    @@keyframes gradientMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .svc-meta {
        display: flex;
        gap: 1.5rem;
        flex-wrap: wrap;
        font-size: 13px;
        color: var(--text2);
        margin-top: 6px;
        align-items: center;
