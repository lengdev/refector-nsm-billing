    function CalDuration(start_Date, end_Date) {
        start_Date = moment(start_Date);
        end_Date = moment(end_Date);
        var Day_ = end_Date.diff(start_Date, 'days');
        var Month_ = end_Date.diff(start_Date, 'month');

        var Duration = $("#TxtPackageDuration").val();
        var FreeDuration = $("#TxtPackageFreeDuration").val();
        var Period = "";
        if (Month_ == 0) {
            if (Day_ == 1) {
                Period = "1 Day";
                Duration = Day_;
                FreeDuration = 0;
            }
            else {
                Period = Day_ + " Days";
                Duration = Day_;
                FreeDuration = 0;
            }
        }
        else if (Month_ == 1) {
            Period = Month_ + " Month";
            Duration = Month_;
            FreeDuration = 0;
        }
        else {
            Period = Month_ + " Months";
            if (parseInt(Month_) == (parseInt(Duration) + parseInt(FreeDuration))) {
                Period = (parseInt(Month_) - parseInt(FreeDuration)) + " Months";
                Duration = (parseInt(Month_) - parseInt(FreeDuration));
            }
            else if (parseInt(Month_) < (parseInt(Duration) + parseInt(FreeDuration))) {
                FreeDuration = 0;
                Duration = Month_;
            }
            else {
                Duration = Month_;
            }
        }
        //$("#TxtPackageFreeDuration").val(FreeDuration);
        //$("#TxtPackageDuration").val(Duration);
        $("#TxtRemainDuration").val(Period);
    }

    function SaveChangeCustomerChangePlan() {
        var Amount = $("#TxtAmount").val();
        var ReasonForChagne = $("#ReasonForChagne").val();
        if (Amount == "") {
            MessageBox("Please enter Amount.");
            $("#TxtAmount").focus();
            return false;
        }
        else if (ReasonForChagne == "") {
            MessageBox("Please enter Reason For Chagne Plan.");
            $("#ReasonForChagne").focus();
            return false;
        }
