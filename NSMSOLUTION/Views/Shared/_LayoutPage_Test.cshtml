        .ui-autocomplete {
            position: absolute;
            top: 100%;
            left: 0;
            z-index: 1000;
            display: none;
            float: left;
            min-width: 160px;
            padding: 5px 0;
            margin: 2px 0 0;
            list-style: none;
            font-size: 14px;
            text-align: left;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            border: 1px solid rgba(0, 0, 0, 0.15);
            border-radius: 4px;
            -webkit-box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.175);
            background-clip: padding-box;
        }

            .ui-autocomplete > li > div {
                display: block;
                padding: 6px;
                clear: both;
                font-weight: normal;
                line-height: 1.42857143;
                white-space: nowrap;
            }

        .ui-state-hover,
        .ui-state-active,
        .ui-state-focus {
            text-decoration: none;
            color: white;
            background-color: royalblue;
            cursor: pointer;
        }

        .ui-helper-hidden-accessible {
            border: 0;
            clip: rect(0 0 0 0);
            height: 1px;
            margin: -1px;
            overflow: hidden;
            padding: 0;
            position: absolute;
            width: 1px;
        }

        .js-select2 .select2-results__option {
            padding-right: 20px;
            vertical-align: middle;
        }

            .js-select2 .select2-results__option:before {
                content: "";
                display: inline-block;
                position: relative;
                height: 20px;
                width: 20px;
                border: 2px solid #e9e9e9;
                border-radius: 4px;
                background-color: #fff;
                margin-right: 20px;
                vertical-align: middle;
            }

            .js-select2 .select2-results__option[aria-selected=true]:before {
                font-family: fontAwesome;
                content: "\f00c";
                color: #fff;
                background-color: #f77750;
                background-color: white;
                color: black;
                border: 0;
                display: inline-block;
                padding-left: 3px;
            }

        .js-select2 .select2-container--default .js-select2 .select2-results__option[aria-selected=true] {
            background-color: #fff;
        }

        .js-select2 .select2-container--default .js-select2 .select2-results__option--highlighted[aria-selected] {
            background-color: #eaeaeb;
            color: #272727;
        }

        .js-select2 .select2-container--default .js-select2 .select2-selection--multiple {
            margin-bottom: 10px;
        }

        .js-select2 .select2-container--default.select2-container--open.select2-container--below .js-select2 .select2-selection--multiple {
            border-radius: 4px;
        }

        .js-select2 .select2-container--default.select2-container--focus .js-select2 .select2-selection--multiple {
            border-color: #f77750;
            border-width: 2px;
        }

        .js-select2 .select2-container--default .js-select2 .select2-selection--multiple {
            border-width: 2px;
        }

        .js-select2 .select2-container--open .js-select2 .select2-dropdown--below {
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
        }

        .js-select2 .select2-selection .js-select2 .select2-selection--multiple:after {
            content: 'hhghgh';
        }

        .js-select2 li.select2-selection__choice {
            color: black !important;
            background-color: white !important;
        }

        .js-select2 li.select2-results__option[role="group"]:before {
            content: none;
            display: inline-block;
        }

        .js-select2 .select2-results__group {
            color: red;
            display: inline-block;
        }

