<body id="BoyMasterPage" ng-controller="EventsCtrl"
      class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed {{Body}}" ng-cloak>
    <div class="wrapper">
        <div class="col-12">
            <div class="col-4">
                <!-- Main Sidebar Container -->
                <aside class="{{AsideLightSidebar || 'main-sidebar sidebar-light-success ng-scope'}}"
                       ng-controller="HomeMenuController">
                    <a href="#/!" class="brand-link liquid-glass d-flex align-items-center justify-content-center"
                       style="height: 66px; border-bottom: 1px solid rgba(0, 0, 0, .08) !important;">
                        <img class="brand-image" ng-src="{{absUrl}}Uploads/WarehouseLogo/{{SysWLogo}}" ng-if="SysWLogo != ''" />
                    </a>
                    <div class="sidebar">
                        <div class="user-panel mt-4 pb-3 mb-3 d-flex" style="display: none !important">
                            <div class="">
                                <img id="userimg" class="img-circle" alt="User Image"
                                     onerror="this.onerror=null;src='Content/images/avatar/user.png'" />
                            </div>
                            <div class="info">
                                <a id="aUserName" href="#!/SupportUserProfile"
                                   class="d-block text-uppercase text-truncate nothing-you-could-do-regular"
                                   title="{{UserFullName}}">{{UserFullName}}</a>
                            </div>
                        </div>

                        <!-- Sidebar Menu -->
                        <nav class="mt-4 d-none">
                            <div id="DivLeftMenu"></div>
                        </nav>
                        <!-- /.sidebar-menu -->
                    </div>
                    <div class="sidebar-bottom text-danger" ng-controller="LogoutController">
                        <div class="logout-item" ng-click="Logout()">
                            <i class="ti ti-logout"></i>
                            <span>Sign out</span>
                        </div>
                    </div>
                </aside>
            </div>
            <div class="col-8">
                <nav class="main-header navbar navbar-expand navbar-white liquid-glass"
                     style="height: 66px; border-bottom: 1px solid rgba(0, 0, 0, .08) !important;">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" data-widget="pushmenu" href="javascript:;" role="button">
                                <div class="nav-icon-btn">
                                    <i id="menuIcon" class="ti ti-chevrons-left" style="font-size: 1.1rem;"></i>
                                </div>
                            </a>
                        </li>
                        <li class="nav-item d-none d-sm-inline-block">
                            <breadcrumbs></breadcrumbs>
                        </li>
                    </ul>
                    <ul class="navbar-nav ml-auto" ng-controller="LogoutController">
                        <li class="nav-item d-flex gap-12" style="position: relative; margin-right: 1.05em;">
                            <div id="notification" ng-show="showNotification" style="position:relative;">
                                <div id="notification" ng-show="showNotification" style="position:relative;">
                                    <div class="notification-icon nav-icon-btn" data-toggle="dropdown" aria-expanded="false">
                                        <i class="ti ti-bell" style="font-size:18px"></i>
                                        <span class="notification-count" ng-show="nearlyExpiredCount > 0">{{ nearlyExpiredCount }}</span>
                                    </div>

                                    <div class="dropdown-menu dropdown-menu-right notifications-dropdown">
                                        <!-- Header -->
                                        <div class="notification-header">
                                            <div class="nh-title">
                                                <span class="nh-icon"><i class="ti ti-bell-ringing"></i></span>
                                                <div>
                                                    <strong>Expiring Soon</strong>
                                                    <small>Customers nearing expiry</small>
                                                </div>
                                            </div>
                                            <span class="nh-count">{{ nearlyExpiredTotalText }}</span>
                                        </div>

                                        <!-- List -->
                                        <div class="notification-scroll">
                                            <div class="notification-empty" ng-if="nearlyExpiredList.length === 0">
                                                <i class="ti ti-circle-check"></i>
                                                <span>No nearly-expired customers</span>
                                            </div>

                                            <a class="notification-item" ng-repeat="exp in nearlyExpiredList track by $index"
                                               ng-href="#!/ReportCustomerNearlyExpired?CID={{ ::exp.CustomerCode }}">
                                                <div class="ni-avatar"><i class="ti ti-user"></i></div>
                                                <div class="ni-body">
                                                    <div class="ni-top">
                                                        <span class="ni-code">{{ ::exp.CustomerCode }}</span>
                                                        <span class="ni-days"><i class="ti ti-calendar-cancel"></i>{{ ::exp.DaysLeft }}</span>
                                                    </div>
                                                    <div class="ni-name" title="{{ ::exp.CustomerName }}">{{ ::exp.CustomerName }}</div>
                                                    <div class="ni-meta">
                                                        <span><i class="ti ti-file-invoice"></i>{{ ::exp.InvoiceNo }}</span>
                                                        <span class="ni-date">
                                                            <i class="ti ti-calendar-due"></i>{{ ::(exp.EndDate |
                              date:'dd-MMM-yyyy') || '-' }}
                                                        </span>
                                                    </div>
                                                </div>
                                            </a>
                                        </div>

                                        <!-- Footer -->
                                        <div class="notification-footer">
                                            <button type="button" class="nf-btn" ng-click="viewAllCustomerExpired()">
                                                <i class="ti ti-eye"></i>
                                                <span>View all customers</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="dropdown-menu notifications-dropdown">
                                    <div class="notification-header">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong>Customer Nearly Expire</strong>
                                            <span class="badge badge-info text-dark">{{ nearlyExpiredTotalText }}</span>
                                        </div>
                                    </div>

                                    <div class="notification-scroll">
                                        <p class="text-center" ng-if="nearlyExpiredList.length === 0">
                                            No nearly-expired customers.
                                        </p>
                                        <div class="notification-item" ng-repeat="exp in nearlyExpiredList track by $index">
                                            <span class="badge badge-warning mb-1" style="font-size: 0.75rem;">
                                                <i class="ti ti-calendar-cancel" style="font-size: 0.9rem;"></i>
                                                {{ ::exp.DaysLeft }}
                                            </span><br>
                                            Customer: <strong>
                                                <a ng-href="#!/ReportCustomerNearlyExpired?CID={{ ::exp.CustomerCode }}">
                                                    {{ ::exp.CustomerCode }} - {{ ::exp.CustomerName }}
                                                </a>
                                            </strong><br>
                                            Invoice No: <strong>{{ ::exp.InvoiceNo }}</strong><br>
                                            Expire Date: <strong class="text-danger">
                                                {{ ::(exp.EndDate |
                        date:'dd-MMM-yyyy') || '-' }}
                                            </strong><br>
                                        </div>
                                    </div>

                                    <div class="notification-footer">
                                        <button class="btn btn-secondary w-100" ng-click="viewAllCustomerExpired()">
                                            <i class="ti ti-eye" style="font-size: 16px;"></i>
                                            <span>View all</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Dark Mode Toggle -->
                            <button onclick="toggleDarkMode()" class="nav-icon-btn" id="darkModeBtn" aria-label="Toggle dark mode">
                                <i class="ti ti-moon" id="darkModeIcon"></i>
                            </button>

                            <div class="dropdown theme-picker d-none">
                                <a href="javascript:void(0)" class="nav-icon-btn" id="themeDropdownToggle" data-toggle="dropdown">
                                    <i class="ti ti-palette"></i>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right theme-menu" aria-labelledby="themeDropdownToggle">
                                    <div class="theme-menu-header">Dark theme</div>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="midnight">
                                        <span class="theme-swatch" style="background:#0c1017"></span> Midnight
                                    </a>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="slate">
                                        <span class="theme-swatch" style="background:#18181b"></span> Slate
                                    </a>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="cosmos">
                                        <span class="theme-swatch" style="background:linear-gradient(135deg,#1f1a38,#0d0b1a)"></span> Cosmos
                                    </a>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="nord">
                                        <span class="theme-swatch" style="background:#3b4252"></span> Nord
                                    </a>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="dracula">
                                        <span class="theme-swatch" style="background:#282a36"></span> Dracula
                                    </a>
                                    <a href="javascript:void(0)" class="theme-option" data-theme="forest">
                                        <span class="theme-swatch" style="background:linear-gradient(135deg,#0d1712,#08110c)"></span> Forest
                                    </a>
                                </div>
                            </div>

                            <!-- Avatar + Profile Dropdown -->
                            <div class="profile-trigger-wrap">
                                <button class="avatar-ring-btn" id="avatarBtn" onclick="toggleProfileMenu()" aria-expanded="false">
                                    <img id="" class="avatar-inner userimg" alt="User Image"
                                         onerror="this.onerror=null;src='Content/images/profile404.jpg'" />

                                    <span class="nav-user-greeting">
                                        <span class="greeting-label">Welcome</span>
                                        <strong class="greeting-name">{{UserName}}</strong>
                                    </span>

                                    <i class="ti ti-chevron-down profile-chevron"></i>
                                </button>

                                <div class="profile-dropdown" id="profileDropdown" role="menu">
                                    <div class="dd-item dd-item-first">
                                        <img id="" class="dd-avatar userimg" alt="User Image"
                                             onerror="this.onerror=null;src='Content/images/profile404.jpg'" />
                                        <div>
                                            <div style="font-weight:700;font-size:14px;">{{UserFullName}}</div>
                                            <div style="font-size:12px;color:var(--text2);">{{UserRole}}</div>
                                        </div>
                                    </div>

                                    <div class="dd-divider"></div>

                                    <a class="dd-item" role="menuitem" href="#!/SupportUserProfile">
                                        <i class="ti ti-user"></i> Profile
                                        <span class="username-badge"><i class="ti ti-flame"></i> {{UserName}}</span>
                                    </a>
                                    <a class="dd-item" role="menuitem" href="Home/Dashboard" ng-if="isShowSwitchSysOpt">
                                        <i class="ti ti-switch"></i> Switch System
                                    </a>
                                    <a class="dd-item" role="menuitem" href="#!/Settings" ng-if="isShowSettingsOpt">
                                        <i class="ti ti-adjustments-horizontal"></i> Settings
                                    </a>
                                    <div class="dd-divider"></div>
                                    <a class="dd-item dd-item-danger cursor-pointer" role="menuitem" ng-click="Logout()">
                                        <i class="ti ti-logout"></i> Sign out
                                    </a>
                                </div>
                            </div>

                        </li>
                    </ul>
                </nav>
                <!-- /.navbar -->
            </div>
        </div>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">
                <div class="container-fluid">
                </div>
            </div>
            <!-- /.content-header -->
            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="card card-outline card-border-top" section-loader>
                                <div class="card-body">
                                    <div data-ng-view>
                                        @RenderBody()
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- /.row -->
                </div><!--/. container-fluid -->
            </section>
            <!-- /.content -->
            <a id="back-to-top" href="javascript:void(0)" onclick="window.scrollTo({ top: 0, behavior: 'smooth' });"
               class="back-to-top" role="button" aria-label="Scroll to top">
                <i class="ti ti-chevrons-up"></i>
            </a>
            <svg style="display: none">
                <filter id="filter" color-interpolation-filters="linearRGB" filterUnits="objectBoundingBox"
                        primitiveUnits="userSpaceOnUse">
                    <feDisplacementMap in="SourceGraphic" in2="SourceGraphic" xChannelSelector="R" yChannelSelector="B" x="0%"
                                       y="0%" width="100%" height="100%" result="displacementMap" />
                    <feGaussianBlur stdDeviation="3 3" x="0%" y="0%" width="100%" height="100%" in="displacementMap"
                                    edgeMode="none" result="blur" />
                </filter>
            </svg>
        </div>
    </div>
    <div id="imagePopup" style="display:none;text-align:center">
        <div style="margin-bottom:10px" class="buttonNext">
            <button onclick="prevImage()">◀</button>
            <button onclick="nextImage()"> ▶</button>
        </div>
        <img id="popupImage" style="max-width:100%;max-height:70vh;object-fit:contain;">
    </div>

    <script src="~/Content/location-picker/locationpicker.jquery.js" defer></script>
    <script src="~/Scripts/jquery-tagsinput-revisited/dist/jquery.tagsinput-revisited.min.js" defer></script>
    <script src="~/Scripts/bootstrap-fileinput/js/plugins/buffer.min.js" type="text/javascript" defer></script>
