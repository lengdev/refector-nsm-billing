    <script src="~/App/Controllers/ReportController.js" defer></script>
    <script src="~/App/Controllers/ActivateService/ActivateServiceController.js" defer></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js"></script>

    <script>
        $(function () {
            var PageSize = 30;
            var CurrentPage = 1;
            var RowSeleted = -1;
            var FixGridHeight = 297;
            var ISEdit = false;
            var imageWindow = null;
            var currentImages = [];
            var currentIndex = 0;

            $(document).on('select2:open', (e) => {
                e.preventDefault();
                $(this).parent().find('.select2-search__field').focus();
                $(this).parent().find('input.select2-search__field').focus();
            });

            $('.dropdown-menu').on('click', function (e) {
                e.stopPropagation();
            });

            $(document).on('mouseenter', '[data-toggle="tooltip"]', function () {
                $(this).tooltip({ trigger: 'hover' }).tooltip('show');
            });

            $(document).on('mouseenter', function (e) {
                if (!e.target.closest('#avatarBtn') && !e.target.closest('#profileDropdown')) {
                    document.getElementById('profileDropdown')?.classList.remove('open');
                }
            });

            const theme = localStorage.getItem('theme') || 'light';
            if (theme === 'dark') $('.theme-picker').removeClass('d-none');
            applyTheme(theme);

            $(document).on('scroll', function () {
                const btn = document.getElementById('back-to-top');
                if (window.scrollY > 300) {
                    btn.classList.add('show');
                } else {
                    btn.classList.remove('show');
                }
            });
        });

        function showImagePopup(imagesStr, index) {
            if (!imagesStr) return;

            // Convert string or array to array
            currentImages = Array.isArray(imagesStr) ? imagesStr : imagesStr.split(/[,~]/).map(f => f.trim()).filter(f => f);
            if (currentImages.length === 0) return;

            currentIndex = index || 0;

            if (!imageWindow) {
                imageWindow = $("#imagePopup").kendoWindow({
                    width: "700px",
                    height: "500px",
                    title: "Image Viewer",
                    modal: true,
                    visible: false,
                    actions: ["Close"],
                    open: function () {
                        $(".k-overlay").on("click.imagePopup", function () {
                            imageWindow.close();
                        });
                    },
                    close: function () {
                        $(".k-overlay").off("click.imagePopup");
                    }
                }).data("kendoWindow");
            }

            loadImage();
            imageWindow.center().open();
        }
        function loadImage() {
            if (!currentImages[currentIndex]) return; // safety
            var file = currentImages[currentIndex].trim();
            var url = "/Uploads/Items/" + file; // <-- adjust to match ServerRoot + GH.ImagePath if needed
            $("#popupImage").attr("src", url);
        }
        function nextImage() {
            if (currentIndex < currentImages.length - 1) {
                currentIndex++;
                loadImage();
            }
        }
        function prevImage() {
            if (currentIndex > 0) {
                currentIndex--;
                loadImage();
            }
        }
        function toggleProfileMenu() {
            const $dd = $('#profileDropdown');
            const $btn = $('#avatarBtn');

            $dd.toggleClass('open');

            const isOpen = $dd.hasClass('open');
            $btn.attr('aria-expanded', isOpen);

            // Close when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#avatarBtn, #profileDropdown').length) {
                    $('#profileDropdown').removeClass('open');
                    $('#avatarBtn').attr('aria-expanded', false);
                }
            });
        }
        function applyTheme(theme) {
            const $body = $('body');
            const $navbar = $('.main-header');
            const $sidebar = $('.main-sidebar');
            const $icon = $('#darkModeIcon');

            const isDarkMode = theme === 'dark';
            $body.toggleClass('dark-mode', isDarkMode);
            $navbar
                .toggleClass('navbar-dark', isDarkMode)
                .toggleClass('navbar-white', !isDarkMode);
            if ($icon.length) {
                $icon
                    .removeClass('ti-sun ti-moon')
                    .addClass(isDarkMode ? 'ti-sun' : 'ti-moon');
            }
            localStorage.setItem('theme', theme);
        }
        function toggleDarkMode() {
            const theme = $('body').hasClass('dark-mode') ? 'light' : 'dark';
            if (theme === 'dark') $('.theme-picker').removeClass('d-none');
            else $('.theme-picker').addClass('d-none');
            applyTheme(theme);
        }
    </script>
    @RenderSection("Scripts", required: false)
</body>

</html>
