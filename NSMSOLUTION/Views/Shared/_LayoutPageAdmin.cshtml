    <link rel="icon" type="image/x-icon" href="~/Content/nsm.ico" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    @*<title ng-bind="title"></title>*@
    @*<title>@Title</title>*@
