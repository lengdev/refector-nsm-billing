                        </button>
                    </div>
                </div>
            </form>*@

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto mr-3 gap-14">
                <li class="nav-item pt-2">
                    <span style="text-transform: uppercase;">{{UserName}}</span>
                </li>
                <li class="nav-item" ng-controller="LogoutController">
                    <button type="button" ng-click="Logout();" class="btn btn-danger btn-sm">Logout</button>
                </li>
            </ul>
        </nav>
        <!-- /.navbar -->
        <!-- Main Sidebar Container -->
