@{
Utilities.Common common = new Utilities.Common();
string ServerRoot = common.GetServerRoot();
string Title = ViewBag.Title;
string PageName = ViewBag.PageName;
if (Title == "")
{
Title = PageName;
}
}
<!DOCTYPE html>
<html lang="en" data-ng-app="appInventory">

