<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed layout-footer-fixed">
    @*<div ng-controller="GetUserRoleController"></div>*@
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="javascript:;" role="button">
                        <div class="sidebar-expand-wrapper">
                            <i id="menuIcon" class="ti ti-layout-sidebar-right-expand"
                                style="font-size: 1.2rem !important; color: #212529 !important;"></i>
                        </div>
                    </a>
                </li>
                <li class="nav-item">
                    <breadcrumbs></breadcrumbs>
                </li>
            </ul>

            <!-- SEARCH FORM -->
            @*<form class="form-inline ml-3">
                <div class="input-group input-group-sm">
                    <input class="form-control form-control-navbar" type="search" placeholder="Search"
