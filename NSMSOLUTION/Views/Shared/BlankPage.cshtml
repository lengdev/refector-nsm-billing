                size: A3;
                margin-top: 5px !important;
                margin-bottom: 0 !important
            }

            footer {
                width: 100%;
                position: fixed;
                bottom: 0 !important;
                margin-right: 50px !important;
            }
        }

        .khmerFont {
            font-family: 'Noto Sans Khmer', sans-serif;
        }

        .khmerFontMoul {
            font-family: 'Moul', cursive;
        }

        .khmerFont1-Header {
