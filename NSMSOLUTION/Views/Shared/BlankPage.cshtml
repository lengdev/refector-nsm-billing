    <script src="~/Scripts/html2pdf/FileSaver.min.js"></script>
    <script src="~/Scripts/html2pdf/html2canvas.min.js"></script>

    <script>
        $(function () {
            var h = $("#BoyMasterPage").height();
            if (h >= 1586) {
                $("footer").css("cssText", "position: static !important;");
            }
        });
    </script>
