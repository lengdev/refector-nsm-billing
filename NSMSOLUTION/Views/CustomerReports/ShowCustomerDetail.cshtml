@{ Layout = null;}
<div class="card card-primary card-outline card-outline-tabs">
    <div class="card-header p-0 border-bottom-0">
        <div class="scroller scroller-left float-left mt-2">
            <i class="fa fa-chevron-left"></i>
        </div>
        <div class="scroller scroller-right float-right mt-2">
            <i class="fa fa-chevron-right"></i>
        </div>
        <div class="wrapper-nav" id="divwrapperTap">
            <ul class="nav nav-tabs list" id="customer-block-tab" role="tablist"></ul>
        </div>
    </div>
    <div class="card-body">
        <div class="tab-content table-responsive" id="CustomerByBlock"></div>
    </div>
    <!-- /.card -->
</div>
<script>
    var BlockData = JSON.parse(`@Html.Raw(ViewBag.Data)`);
    $(function () {
        var CustomerGroupID = "@ViewBag.CustomerGroupID";
        //var startDate = $("#DateSearch").data('daterangepicker').startDate.format('YYMMDD');
        //var endDate = $("#DateSearch").data('daterangepicker').endDate.format('YYMMDD');
        var startDate = "@ViewBag.startDate";
        var endDate = "@ViewBag.endDate";
        $("#customer-block-tab a").click(function (e) {
            e.preventDefault();
        });
        if (BlockData.length > 0) {
            BlockData = BlockData[0].Table;
            var row = ``;
            $.each(BlockData, function (key, value) {
                row += `<li class="nav-item"><a onclick="ShowCustomerByBlock(` + CustomerGroupID + `,` + value.CustomerTypeID + `,'` + startDate + `','` + endDate + `');" class="nav-link` + (key == 0 ? ' active' : '') + `" id="` + value.CustomerType + `-tab" data-toggle="pill" href="javascript:void(0);" role="tab">` + value.CustomerType + `
    &nbsp;<span class="badge badge-info" title="Customer">` + value.Customer + `</span></a></li>`;
                if (key == 0)
                    ShowCustomerByBlock(CustomerGroupID, value.CustomerTypeID, '' + startDate + '', '' + endDate + '');
            });
            $("#customer-block-tab").append(row);
            TapScroll();
        }
    });
</script>