<script>
    function CustSearchDate() {
        var FromDate = $("#CustSearchDate").data('daterangepicker').startDate.format('YYYYMMDD');
        var ToDate = $("#CustSearchDate").data('daterangepicker').endDate.format('YYYYMMDD');
        LoadData("CustomerReports/CustSearchDate?FromDate=" + FromDate + "&ToDate=" + ToDate, function (response) {
            $("#showCustSearchDate").html(response);
        });
    }

    function ShowCustBlockWithConnection() {
        LoadData("CustomerReports/ShowCustBlockWithConnection", function (response) {
            var colorPalette = ['#D81B60', '#20C997', '#6610F2', '#007BFF', '#FFC107', '#F89C39', '#f48024', '#69d2e7'];
            var result = JSON.parse(response).Table;
            var Table10 = result;
            var CustomerGroup = Table10.map(function (item) {
                return item.CustomerGroup;
            });
            var grouped = _.groupBy(CustomerGroup, function (x) { return x; })
            var custData = [];
            var objhide = [];
            $.each(grouped, function (key, value) {
                var obj = Table10.filter(function (item) {
                    return item.CustomerGroup == key;
                });
                obj = obj.map(function (item) {
                    return item.NewCustomer;
                });
                obj = {
                    name: key,
                    group: key,
                    data: obj
                }
                custData.push(obj);
            });

            $.each(grouped, function (key, value) {
                var obj = Table10.filter(function (item) {
                    return item.CustomerGroup == key;
                });
                obj = obj.map(function (item) {
                    return item.NewConnection;
                });
                obj = {
                    name: key + '_NewConnection',
                    group: key,
                    data: obj
                }
                custData.push(obj);
                objhide.push(key + '_NewConnection');
            });

            $.each(grouped, function (key, value) {
                var obj = Table10.filter(function (item) {
                    return item.CustomerGroup == key;
                });
                obj = obj.map(function (item) {
                    return item.Renew;
                });
                obj = {
                    name: key + '_Renew',
                    group: key,
                    data: obj
                }
                custData.push(obj);
                objhide.push(key + '_Renew');
            });

            $.each(grouped, function (key, value) {
                var obj = Table10.filter(function (item) {
                    return item.CustomerGroup == key;
                });
                obj = obj.map(function (item) {
                    return item.Lock;
                });
                obj = {
                    name: key + '_Lock',
                    group: key,
                    data: obj
                }
                custData.push(obj);
                objhide.push(key + '_Lock');
            });

            options = {
                series: custData,
                chart: {
                    type: 'bar',
                    height: 350,
                    stacked: true,
                },
                //stroke: {
                //    width: 1,
                //    colors: ['#fff']
                //},
                dataLabels: {
                    dropShadow: {
                        enabled: true
                    },
                    style: {
                        fontSize: '13px',
                    }
                    //formatter: (val) => {
                    //    return val / 1000 + 'K'
                    //}
                },
                plotOptions: {
                    bar: {
                        horizontal: false,
                        borderRadius: 4,
                    }
                },
                yaxis: {
                    labels: {
                        show: false
                    }
                },
                xaxis: {
                    categories: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
                },
                fill: {
                    opacity: 1
                },
                colors: colorPalette,
                legend: {
                    position: 'bottom',
                    horizontalAlign: 'center'
                }
            };
            chart = new ApexCharts(document.querySelector("#ShowCustWithBlockConnection"), options);
            chart.render();

            $.each(objhide, function (key, val) {
                chart.hideSeries(val);
            });
            //$("#ShowCustWithBlockConnection").html(response);
        });
    }

    function CustSearchByDate() {
        var FromDate = $("#DateSearch").data('daterangepicker').startDate.format('YYYYMMDD');
        var ToDate = $("#DateSearch").data('daterangepicker').endDate.format('YYYYMMDD');
        LoadData("CustomerReports/ShowCustomerByBlockAndConnection?FromDate=" + FromDate + "&ToDate=" + ToDate, function (response) {
            $("#showCustCon").html(response);
        });
    }
    function ShowCustomerConnectivityStatus(d) {
        LoadData("CustomerReports/ShowCustomerConnectivityStatus?Date=" + d, function (response) {
            $("#custConnectivity").html(response);
        });
    }
    $(function () {
