    function ShowCustByBlock(THIS, CustomerTypeID, Block, Show, CustomerGroup) {
        $(THIS).select();
        var FromDate = $("#CustSearchDate").data('daterangepicker').startDate.format('YYYYMMDD');
        var ToDate = $("#CustSearchDate").data('daterangepicker').endDate.format('YYYYMMDD');
        ModalDialogBox(Block, "CustomerReports/ShowCustByBlock", { CustomerTypeID: CustomerTypeID, Show: Show, FromDate: FromDate, ToDate: ToDate, CustomerGroup: CustomerGroup }, "Dialog", "", "", "", true);
    }
</script>

