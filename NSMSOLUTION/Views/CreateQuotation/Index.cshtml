@{
Layout = null;
}
@Html.Raw(@ViewBag.DrawHTMLSearchForm)
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
  rel="stylesheet">
<style>
  .ubs-backdrop {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    background: rgba(0, 0, 0, 0.55) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 999999 !important;
    pointer-events: none !important;
    opacity: 0 !important;
    transition: opacity 0.3s ease !important;
  }

  /* Force display flex only when active */
  .ubs-backdrop.ubs-active {
    opacity: 1 !important;
    pointer-events: all !important;
  }

  /* -- Modal Card Fix -- */
  .ubs-modal-card {
    position: relative !important;
    margin: auto !important;
    display: block !important;
    background: #ffffff !important;
    border-radius: 16px !important;
    width: calc(100vw - 32px) !important;
    max-width: 580px !important;
    max-height: calc(100vh - 32px) !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
    padding: 36px !important;
    box-sizing: border-box !important;
    transform: translateY(24px) scale(0.97) !important;
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.3s ease !important;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.3) !important;
  }

  .ubs-backdrop.ubs-active .ubs-modal-card {
    transform: translateY(0) scale(1) !important;
  }

  /* -- Header Section -- */
  .ubs-header {
    display: flex !important;
    align-items: flex-start !important;
    justify-content: space-between !important;
    margin-bottom: 28px !important;
  }

  .ubs-icon-box svg {
    width: 22px !important;
    height: 22px !important;
  }

  .ubs-title {
    font-size: 22px !important;
    color: #111318 !important;
    line-height: 1.2 !important;
    margin: 0 !important;
    font-weight: 800 !important;
    font-style: italic;
  }

  .ubs-subtitle {
    font-size: 13px !important;
    color: #6b7280 !important;
    margin-top: 4px !important;
  }

  .ubs-close-btn {
    width: 34px !important;
    height: 34px !important;
    border-radius: 12px !important;
    color: #6b7280 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    transition: all 0.2s !important;
    flex-shrink: 0 !important;
    padding: 0 !important;
  }

  .ubs-close-btn:hover {
    background: rgba(248, 113, 113, 0.1) !important;
    color: #ef4444 !important;
    border-color: rgba(248, 113, 113, 0.25) !important;
  }

  .ubs-close-btn svg {
    width: 16px !important;
    height: 16px !important;
  }


  /* ═══════════════════════════════════════════
        DARK MODE OVERRIDES (AdminLTE Support)
    ═══════════════════════════════════════════ */
  body.dark-mode .ubs-modal-card {
    background-color: #1e1e2d !important;
    color: #ffffff !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
  }

  body.dark-mode .ubs-title {
    color: #ffffff !important;
  }

  body.dark-mode .ubs-subtitle {
    color: #a1a1aa !important;
  }

  body.dark-mode .ubs-input {
    background: #2b2b40 !important;
    border-color: #3f3f5f !important;
    color: #ffffff !important;
  }

  body.dark-mode .ubs-upload-area {
    background: #232333 !important;
    border-color: rgba(255, 255, 255, 0.1) !important;
  }

  body.dark-mode .ubs-close-btn,
  body.dark-mode .ubs-btn-cancel {
    background: #323248 !important;
    color: #a1a1aa !important;
    border: none !important;
  }

  body.dark-mode .ubs-pill-name,
  body.dark-mode .ubs-upload-text {
    color: #a1a1aa !important;
  }

  /* -- Form Fields -- */
  .ubs-field-group {
    margin-bottom: 20px !important;
  }

  .ubs-label {
    display: block !important;
    font-size: 12.5px !important;
    font-weight: 500 !important;
    color: #6b7280 !important;
    letter-spacing: 0.6px !important;
    margin-bottom: 8px !important;
  }

  .ubs-input {
    width: 100% !important;
    background: #f9fafb !important;
    border: 1px solid rgba(0, 0, 0, 0.1) !important;
    border-radius: 10px !important;
    padding: 8px !important;
    color: #111318 !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    outline: none !important;
    transition: border-color 0.2s, box-shadow 0.2s !important;
    box-shadow: none !important;
    box-sizing: border-box !important;
  }

  .ubs-input:focus {
    border-color: #4f8fff !important;
    box-shadow: 0 0 0 3px rgba(79, 143, 255, 0.15) !important;
  }

  /* -- Upload Zone -- */
  .ubs-upload-area {
    border: 1.5px dashed rgba(0, 0, 0, 0.12) !important;
    border-radius: 12px !important;
    background: #f9fafb !important;
    padding: 28px 20px !important;
    text-align: center !important;
    cursor: pointer !important;
    transition: all 0.2s !important;
    position: relative !important;
  }

  .ubs-upload-area:hover,
  .ubs-upload-area.ubs-dragover {
    border-color: #4f8fff !important;
    background: rgba(79, 143, 255, 0.04) !important;
    box-shadow: 0 0 0 3px rgba(79, 143, 255, 0.12) !important;
  }

  .ubs-file-input {
    position: absolute !important;
    inset: 0 !important;
    opacity: 0 !important;
    cursor: pointer !important;
    width: 100% !important;
    height: 100% !important;
  }

  .ubs-upload-icon-circle {
    width: 44px !important;
    height: 44px !important;
    border-radius: 10px !important;
    background: rgba(79, 143, 255, 0.08) !important;
    border: 1px solid rgba(79, 143, 255, 0.18) !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin: 0 auto 12px !important;
  }

  .ubs-upload-icon-circle svg {
    width: 20px !important;
    height: 20px !important;
    color: #4f8fff !important;
  }

  .ubs-upload-text {
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #111318 !important;
  }

  .ubs-upload-text span {
    color: #4f8fff !important;
  }

  .ubs-upload-hint {
    font-size: 12px !important;
    color: #6b7280 !important;
    margin-top: 4px !important;
  }

  /* -- File Pill -- */
  .ubs-file-pill {
    display: none !important;
    align-items: center !important;
    gap: 10px !important;
    background: rgba(16, 185, 129, 0.06) !important;
    border: 1px solid rgba(16, 185, 129, 0.2) !important;
    border-radius: 8px !important;
    padding: 10px 14px !important;
    margin-top: 12px !important;
    font-size: 13px !important;
  }

  .ubs-file-pill.ubs-visible {
    display: flex !important;
  }

  .ubs-file-pill svg {
    width: 16px !important;
    height: 16px !important;
    color: #10b981 !important;
    flex-shrink: 0 !important;
  }

  .ubs-pill-name {
    flex: 1 !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    white-space: nowrap !important;
    color: #111318 !important;
  }

  .ubs-pill-size {
    color: #6b7280 !important;
    font-size: 12px !important;
    flex-shrink: 0 !important;
  }

  .ubs-pill-remove {
    width: 20px !important;
    height: 20px !important;
    border-radius: 50% !important;
    background: rgba(248, 113, 113, 0.1) !important;
    border: none !important;
    color: #ef4444 !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    transition: background 0.15s !important;
  }

  /* -- Actions -- */
  .ubs-actions {
    display: flex !important;
    gap: 12px !important;
    margin-top: 28px !important;
  }

  .ubs-btn-cancel {
    flex: 1 !important;
    color: #6b7280 !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
  }

  .ubs-btn-submit {
    flex: 2 !important;
    font-size: 14.5px !important;
    font-weight: 600 !important;
  }

  .ubs-spinner {
    display: none !important;
    width: 16px !important;
    height: 16px !important;
    border: 2px solid var(--purple) !important;
    border-top-color: #fff !important;
    border-radius: 50% !important;
    animation: ubsSpin 0.7s linear infinite !important;
    margin: 0 auto !important;
  }

  .ubs-loading .ubs-btn-label {
    display: none !important;
  }

  .ubs-loading .ubs-spinner {
    display: block !important;
  }

  @@keyframes ubsSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* -- Toast -- */
  .ubs-toast {
    position: fixed !important;
    top: 28px !important;
    right: 28px !important;
    background: #ffffff !important;
    border: 1px solid rgba(16, 185, 129, 0.3) !important;
    border-radius: 12px !important;
    padding: 14px 20px !important;
    font-size: 14px !important;
    color: #059669 !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12) !important;
    transform: translateY(12px) !important;
    opacity: 0 !important;
    transition: all 0.3s ease !important;
    pointer-events: none !important;
    z-index: 999999 !important;
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    font-family: 'DM Sans', sans-serif !important;
  }

  .ubs-toast.ubs-show {
    transform: translateY(0) !important;
    opacity: 1 !important;
  }

  .ubs-toast svg {
    width: 18px !important;
    height: 18px !important;
  }

  .ubs-helper-text {
    display: block !important;
    font-size: 11px !important;
    color: #9ca3af !important;
    /* Muted gray */
    margin-top: 6px !important;
    line-height: 1.4 !important;
    font-family: 'DM Sans', sans-serif !important;
  }

  /* Optional: Style for when there is a validation error */
  .ubs-helper-text.error-text {
    color: #ef4444 !important;
    font-weight: 500 !important;
  }

  /* Ensure this is specific enough to override the default border */
  .ubs-upload-area.ubs-error {
    border-color: #ef4444 !important;
    background: rgba(239, 68, 68, 0.04) !important;
  }

  body.dark-mode .ubs-helper-text {
    color: #ef4444 !important;
  }
</style>

<div class="ubs-backdrop d-none" id="bankSlipBackdrop">
  <div class="ubs-modal-card" role="dialog" aria-modal="true">

    <div class="ubs-header">
      <div>
        <div class="d-flex align-items-center gap-3">
          <span class="ubs-title">Attach Bank Slip</span>
        </div>
        <div class="ubs-subtitle">Upload your payment confirmation</div>
      </div>
      <button class="ubs-close-btn" onclick="bsCloseModal()" aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <div class="row">
      <div class="col ubs-field-group">
        <label class="ubs-label">Reference Number</label>
        <input type="text" id="bsReferenceNo" class="ubs-input" placeholder="e.g. TXN-20240305-001" readonly />
      </div>

      <div class="col ubs-field-group">
        <label class="ubs-label">Amount Paid</label>
        <input type="number" id="bsAmountPaid" class="ubs-input" placeholder="0.00" min="0" step="0.01" readonly />
      </div>
    </div>

    <div class="ubs-field-group">
      <label class="ubs-label">Approval By <span class="text-danger">*</span></label>
      <select id="bsApprovalBy" class="ubs-input" required></select>
      <span class="ubs-helper-text" id="bsApprovalHint"></span>
    </div>

    <div class="ubs-field-group">
      <label class="ubs-label">Pay by</label>
      <select id="bsPayby" class="ubs-input">
        <option value="bank">Bank Transfer</option>
        <option value="cash">Cash</option>
      </select>
    </div>

    <div class="ubs-field-group">
      <label class="ubs-label">Bank Slip File <span class="text-danger">*</span></label>
      <div class="ubs-upload-area" id="bsUploadZone">
        <input type="file" id="bsSlipFile" class="ubs-file-input" accept="image/*"
          onchange="bsHandleFileChange(event)" />
        <div class="ubs-upload-icon-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="17 8 12 3 7 8" />
            <line x1="12" y1="3" x2="12" y2="15" />
          </svg>
        </div>
        <div class="ubs-upload-text">Drop file here or <span>browse</span></div>
        <div class="ubs-upload-hint">Supports JPG, PNG · Max 10MB</div>
      </div>

      <div class="ubs-file-pill" id="bsFilePill">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <polyline points="20 6 9 17 4 12" />
        </svg>
        <span class="ubs-pill-name" id="bsFileName">—</span>
        <span class="ubs-pill-size" id="bsFileSize"></span>
        <button class="ubs-pill-remove" onclick="bsRemoveFile()">✕</button>
      </div>
    </div>

    <div class="ubs-field-group">
      <label class="ubs-label">Memo</label>
      <textarea id="bsMemo" class="ubs-input auto-resize" placeholder="Enter Memo"></textarea>
    </div>

    <div class="ubs-actions">
      <button class="btn btn-secondary ubs-btn-cancel" onclick="bsCloseModal()">Cancel</button>
      <button class="btn btn-info ubs-btn-submit" id="bsSubmitBtn" onclick="bsSubmitForm()">
        <span class="ubs-btn-label"><i class="ti ti-send"></i> Submit Slip</span>
        <div class="ubs-spinner"></div>
      </button>
    </div>
  </div>
</div>

<div id="bsToast" class="ubs-toast d-none">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
    <polyline points="20 6 9 17 4 12" />
  </svg>
  Bank slip submitted successfully!
</div>

<script>

  $(function () {
    const $backdrop = $('#bankSlipBackdrop');
    const $zone = $('#bsUploadZone');
    const $pill = $('#bsFilePill');
    const $submitBtn = $('#bsSubmitBtn');
    const $fileInput = $('#bsSlipFile');

    let _bsData = {};

    // Move modal to body to avoid stacking context issues
    $backdrop.appendTo('body');
    $('#bsToast').appendTo('body');

    // ==========================================
    // PAYMENT METHOD
    // ==========================================

    function bsTogglePayBy() {
      const isCash = $('#bsPayby').val() === 'cash';
      const $uploadGroup = $zone.closest('.ubs-field-group');

      $uploadGroup.toggle(!isCash);

      if (isCash) {
        bsRemoveFile();
        $zone.removeClass('ubs-error');
      }
    }

    $('#bsPayby').on('change', bsTogglePayBy);

    // ==========================================
    // FILE UPLOAD EVENTS
    // ==========================================

    $zone.on('dragover', function (e) {
      e.preventDefault();
      $zone.addClass('ubs-dragover');
    });

    $zone.on('dragleave drop', function () {
      $zone.removeClass('ubs-dragover');
    });

    $zone.on('drop', function (e) {
      e.preventDefault();

      if ($('#bsPayby').val() === 'cash') return;

      const file = e.originalEvent.dataTransfer.files[0];

      if (file) {
        if (!file.type.startsWith('image/')) {
          $zone.addClass('ubs-error');
          return;
        }

        bsSetFile(file);
        $zone.removeClass('ubs-error');
      }
    });

    // Standard file selection
    window.bsHandleFileChange = function (e) {
      const file = e.target.files[0];

      if (!file) return;

      if (!file.type.startsWith('image/')) {
        $zone.addClass('ubs-error');
        e.target.value = '';
        return;
      }

      bsSetFile(file);
      $zone.removeClass('ubs-error');
    };

    function bsSetFile(file) {
      $('#bsFileName').text(file.name);
      $('#bsFileSize').text(bsFormatSize(file.size));

      $pill.addClass('ubs-visible').css('display', 'flex');
    }

    window.bsRemoveFile = function () {
      $fileInput.val('');
      $pill.removeClass('ubs-visible').hide();
      $('#bsFileName').text('—');
      $('#bsFileSize').text('');
    };

    function bsFormatSize(b) {
      if (b < 1024) return b + ' B';

      const kb = b / 1024;

      if (kb < 1024) return kb.toFixed(1) + ' KB';

      return (kb / 1024).toFixed(1) + ' MB';
    }

    // ==========================================
    // MODAL OPEN
    // ==========================================

    window.AttachBankSlip = function (
      customerId,
      customerName,
      quoteNo,
      amount
    ) {
      _bsData = {
        customerId,
        customerName,
        quoteNo,
        amount
      };

      $('#bsReferenceNo').val(quoteNo || '');
      $('#bsAmountPaid').val(amount || '');

      // Default payment method
      $('#bsPayby').val('bank').trigger('change');
      bsTogglePayBy();

      // Reset previous values
      bsRemoveFile();
      $('#bsMemo').val('');

      $submitBtn.removeClass('ubs-loading').prop('disabled', false);

      // Show modal
      $backdrop.addClass('ubs-active').removeClass('d-none');

      // Load approval users
      LoadData('CreateQuotation/LoadUserApproval', function (response) {
        const res = JSON.parse(response.data);

        if (!res || res.length === 0) return;

        const formattedData = res.map(item => ({
          id: item.UserLoginID,
          text: item.FullName
        }));

        const $select = $('#bsApprovalBy');

        if ($select.hasClass('select2-hidden-accessible')) {
          $select.select2('destroy').empty();
        }

        $select.select2({
          placeholder: 'Select Approval By',
          allowClear: true,
          width: '100%',
          data: formattedData,
          dropdownParent: $('.ubs-modal-card')
        });

        $select.on('select2:select', function () {
          clearRequire();
        });

        $select.val(null).trigger('change');

      }, false, 'json');
    };

    // ==========================================
    // MODAL CLOSE / RESET
    // ==========================================

    window.bsCloseModal = function () {
      $backdrop.removeClass('ubs-active');

      setTimeout(function () {
        $backdrop.addClass('d-none');
        bsReset();
      }, 300);
    };

    function bsReset() {
      $('#bsReferenceNo, #bsAmountPaid, #bsMemo').val('');

      $('#bsPayby').val('bank');
      $('#bsPayby').trigger('change');

      _bsData = {};

      bsRemoveFile();

      $submitBtn
        .removeClass('ubs-loading')
        .prop('disabled', false);

      clearRequire();

      $zone.removeClass('ubs-error');

      $('#bsApprovalBy').val(null).trigger('change');
    }

    // ==========================================
    // VALIDATION HELPERS
    // ==========================================

    function clearRequire() {
      const $container = $('#bsApprovalBy')
        .next('.select2-container')
        .find('.select2-selection');

      const $hint = $('#bsApprovalHint');

      $container.css('border', '1px solid rgba(0,0,0,0.1)');

      $hint.text('').removeClass('error-text');
    }

    // ==========================================
    // CLOSE EVENTS
    // ==========================================

    $backdrop.on('click', function (e) {
      if ($(e.target).is($backdrop)) {
        bsCloseModal();
      }
    });

    $(document).on('keydown', function (e) {
      if (e.key === 'Escape' && $backdrop.hasClass('ubs-active')) {
        bsCloseModal();
      }
    });

    // ==========================================
    // FORM SUBMISSION & VALIDATION
    // ==========================================

    window.bsSubmitForm = function () {
      const $refInput = $('#bsReferenceNo');
      const $amountInput = $('#bsAmountPaid');
      const $approvalSelect = $('#bsApprovalBy');
      const $selectContainer = $approvalSelect.next('.select2-container');
      const $approvalHint = $('#bsApprovalHint');
      const $txtMemo = $('#bsMemo');

      const files = $fileInput[0].files;

      let isValid = true;

      // Payment method
      const payBy = $('#bsPayby').val();
      const isCash = payBy === 'cash';

      // Form values
      const refNo = ($refInput.val() || '').trim();
      const amount = ($amountInput.val() || '').trim();
      const memo = ($txtMemo.val() || '').trim();
      const approvalBy = $approvalSelect.val();

      const hasFile = files.length > 0;

      // Clear previous validation
      $('.ubs-input, .select2-selection').css('border-color', '');

      $selectContainer.css('border', 'none');

      $zone.removeClass('ubs-error');

      // Approval By is always required
      if (!approvalBy) {
        $selectContainer
          .find('.select2-selection')
          .css('border', '1px solid #ef4444');

        $approvalHint
          .text('This field is required!')
          .addClass('error-text');

        isValid = false;
      }

      // Bank slip required only for Bank Transfer
      if (!isCash && !hasFile) {
        $zone.addClass('ubs-error');
        isValid = false;
      }

      if (!isValid) return;

      // ======================================
      // PREPARE SUBMISSION
      // ======================================

      $submitBtn
        .addClass('ubs-loading')
        .prop('disabled', true);

      const payload = {
        CustomerID: _bsData.customerId || 0,
        InvoiceNo: refNo,
        Amount: amount,
        NeedApproveByID: approvalBy,
        PayBy: payBy,
        Memo: memo
      };

      const formData = new FormData();

      formData.append('data', JSON.stringify(payload));

      // Attach file only when available and not Cash
      if (!isCash && hasFile) {
        formData.append('BankSlip', files[0]);
      }

      // ======================================
      // AJAX SUBMISSION
      // ======================================

      $.ajax({
        url: '/CreateQuotation/QuotationAttBankSlip',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,

        success: function (response) {
          if (response.success) {
            bsCloseModal();
            bsShowToast();
          } else {
            alert(response.message);

            $submitBtn
              .removeClass('ubs-loading')
              .prop('disabled', false);
          }
        },

        error: function () {
          $submitBtn
            .removeClass('ubs-loading')
            .prop('disabled', false);
        }
      });
    };

    // ==========================================
    // SUCCESS TOAST
    // ==========================================

    function bsShowToast() {
      const $t = $('#bsToast');

      $t.addClass('ubs-show');

      setTimeout(function () {
        $t.removeClass('ubs-show');
      }, 3500);
    }

  });

</script>
