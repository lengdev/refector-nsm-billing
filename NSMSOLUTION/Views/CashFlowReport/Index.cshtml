@{ Layout = null; }
<script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.min.js"></script>

<!-- Google Fonts & Khmer Fonts (Matching Balance Sheet / Profit & Loss) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Moul&family=Noto+Sans+Khmer:wght@400;700&family=Kantumruy+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<div id="cash-flow-view-wrapper">
    <div class="custom-search-toolbar">
        <div class="toolbar-left">
            <label>From Date:</label>
            <input id="TxtFromDate" />
            <label style="margin-left: 10px;">To Date:</label>
            <input id="TxtToDate" />
            <button class="btn-custom-search" onclick="generateCashFlowReport();">
                <i class="fa fa-search"></i> Search
            </button>
        </div>
        <div class="toolbar-right">
            <button class="btn-pill btn-pill-excel" onclick="ExportExcel();" title="Export Excel">
                <i class="fa fa-file-excel"></i> Export to Excel
            </button>
            <button class="btn-pill btn-pill-pdf" onclick="PrintReport();" title="Print / PDF">
                <i class="fa fa-file-pdf-o"></i> Print PDF
            </button>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/_AccountingAdvanceFilter.cshtml", new ViewDataDictionary { { "ReportType", "CF" } })

    <div class="pl-report-header" id="cfReportHeader" style="margin-top: 15px; margin-bottom: 20px;">
        <div class="print-date-line" id="lblPrintDate">Print Date: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</div>
        <div class="bs-company-kh" id="lblCompanyNameKh">@(ViewBag.CompanyNameKh ?? ViewBag.CompanyKH ?? "")</div>
        <div class="bs-company-en" id="lblCompanyNameEn">@(ViewBag.CompanyNameEn ?? ViewBag.CompanyEN ?? "")</div>
        <div class="bs-company-divider">
            ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~
        </div>
        <h3 id="lblReportTitle">CASH FLOW STATEMENT</h3>
        <div class="tb-date-range-bar" id="lblDateRangeBar">
            <span id="lblCfFrom">01/01/2026</span> - <span id="lblCfTo">31/01/2026</span>
        </div>
    </div>

    <!-- Demo Data Warning Banner -->
    <div id="DemoDataBanner" class="demo-banner" style="display: none;">
        <i class="fa fa-info-circle"></i>
        <span><strong>Note:</strong> Showing sample/mock report data. No transactions were found in the database for the selected date range.</span>
    </div>

    <div class="table-responsive">
        <table id="TableGride" class="table table-bordered report-table">
            <thead>
                <tr>
                    <th>Activities / Accounts</th>
                    <th style="text-align: right; width: 30%;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr class="cf-section-header"><td colspan="2">CASH FLOWS FROM OPERATING ACTIVITIES</td></tr>
                <tr class="cf-group-header"><td colspan="2" style="padding-left: 44px !important;">Operating Inflows:</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Customer Payments</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Advance Payments</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Other Receipts</td><td align="right">—</td></tr>
                <tr class="cf-group-header"><td colspan="2" style="padding-left: 44px !important;">Operating Outflows:</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Rent</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Utilities</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Other Expenses</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 64px !important;">Other Payments</td><td align="right">—</td></tr>
                <tr class="cf-section-total"><td style="padding-left: 44px !important;">Net cash provided by operating activities</td><td align="right">—</td></tr>
                <tr class="cf-section-header"><td colspan="2">CASH FLOWS FROM INVESTING ACTIVITIES</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 44px !important;">Software &amp; Equipment</td><td align="right">—</td></tr>
                <tr class="cf-section-total"><td style="padding-left: 44px !important;">Net cash provided by (used in) investing activities</td><td align="right">—</td></tr>
                <tr class="cf-section-header"><td colspan="2">CASH FLOWS FROM FINANCING ACTIVITIES</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 44px !important;">Owner Investment</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 44px !important;">Loan Received</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td style="padding-left: 44px !important;">Loan Repayment</td><td align="right">—</td></tr>
                <tr class="cf-section-total"><td style="padding-left: 44px !important;">Net cash provided by (used in) financing activities</td><td align="right">—</td></tr>
                <tr class="cf-kpi-row"><td>NET INCREASE IN CASH</td><td align="right">—</td></tr>
                <tr class="cf-account-row"><td>Cash at beginning of period</td><td align="right">—</td></tr>
                <tr class="cf-kpi-row"><td>CASH AT END OF PERIOD</td><td align="right">—</td></tr>
            </tbody>
        </table>
    </div>
</div>

