    <!-- ==================================================================== -->
    <!-- SECTION 1: BASIC INFORMATION                                         -->
    <!-- ==================================================================== -->
    <div class="pb-section-header">
        <span class="pb-title">BASIC INFORMATION</span>
        <div class="pb-line"></div>
    </div>

    <div class="row">
        <!-- LEFT COLUMN -->
        <div class="col-md-6 pr-lg-4">
            <!-- Vendor -->
            <div class="form-group-row">
                <label class="pb-col-label" for="cboVendor">Vendor<span class="star">*</span></label>
                <div class="pb-col-input">
                    @{
                        var seenVendors = new HashSet<int>();
                    }
                    <select id="cboVendor" class="form-control select2">
                        <option value="" @(selectedVendorId <= 0 ? "selected" : "")>---Please select---</option>
                        @if (vendors != null)
                        {
                            foreach (System.Data.DataRow r in vendors.Rows)
                            {
                                int vId = 0;
                                int.TryParse(r["VendorID"].ToString(), out vId);
                                if (vId <= 0 || !seenVendors.Add(vId)) { continue; }
                                string vName = r["VendorDisplayName"].ToString();
                                string contact = r["ContactPerson"] != null ? r["ContactPerson"].ToString() : "";
                                string phone = r["Phone"] != null ? r["Phone"].ToString() : "";
                                bool isSel = (vId == selectedVendorId);
                                <option value="@vId" data-contact="@contact" data-phone="@phone" @(isSel ? "selected" : "")>@vName</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Contact Person -->
            <div class="form-group-row">
                <label class="pb-col-label" for="txtContactPerson">Contact Person</label>
                <div class="pb-col-input">
                    <input type="text" id="txtContactPerson" class="form-control inp-highlight-yellow" placeholder="" />
                </div>
            </div>

            <!-- Phone -->
            <div class="form-group-row">
                <label class="pb-col-label" for="txtPhone">Phone</label>
                <div class="pb-col-input">
                    <input type="text" id="txtPhone" class="form-control inp-highlight-yellow" placeholder="" />
                </div>
            </div>

            <!-- Memo -->
            <div class="form-group-row align-top">
                <label class="pb-col-label pt-1" for="txtMemo">Memo</label>
                <div class="pb-col-input">
                    <textarea id="txtMemo" class="form-control" rows="3" style="height: 68px !important; resize: vertical;" placeholder=""></textarea>
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN -->
        <div class="col-md-6 pl-lg-4">
            <!-- RV No / PV No -->
            <div class="form-group-row">
                <label class="pb-col-label" for="txtPaymentNo">PV No<span class="star">*</span></label>
                <div class="pb-col-input">
                    <input type="text" id="txtPaymentNo" class="form-control" readonly value="Auto Generate Code" />
                </div>
            </div>

            <!-- Payment Date -->
            <div class="form-group-row">
                <label class="pb-col-label" for="txtPaymentDate">Payment Date<span class="star">*</span></label>
                <div class="pb-col-input">
                    <div class="input-group input-group-sm" id="wrapPaymentDate">
                        <input type="text" id="txtPaymentDate" class="form-control" value="@currentDate" placeholder="dd/MM/yyyy" autocomplete="off" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-date-btn" id="btnPaymentDate" title="Choose date">
                                <i class="far fa-calendar-alt"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pay Amount -->
            <div class="form-group-row">
                <label class="pb-col-label" for="txtPayAmount">Pay Amount</label>
                <div class="pb-col-input">
                    <div class="input-group input-group-sm" id="wrapPayAmount">
                        <input type="number" id="txtPayAmount" class="form-control text-right" min="0" step="0.01" placeholder="0.00" onkeyup="onPayAmountKeyup(event);" />
                        <div class="input-group-append">
                            <button type="button" class="btn btn-apply-btn" id="btnApplyAmount" onclick="applyPayAmount();">
                                Apply
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Method -->
            <div class="form-group-row">
                <label class="pb-col-label" for="cboPaymentMethod">Payment Method</label>
                <div class="pb-col-input">
                    <select id="cboPaymentMethod" class="form-control">
                        @{
                            var seenMethods = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                            bool hasCashSelected = false;
                            if (paymentMethods != null && paymentMethods.Rows.Count > 0)
                            {
                                foreach (System.Data.DataRow pm in paymentMethods.Rows)
                                {
                                    string pmId = pm["PaymentMethodID"].ToString();
                                    string pmName = pm["PaymentMethod"].ToString().Trim();
                                    if (!string.IsNullOrEmpty(pmName) && seenMethods.Add(pmName))
                                    {
                                        bool isCash = string.Equals(pmName, "Cash", StringComparison.OrdinalIgnoreCase);
                                        if (isCash) { hasCashSelected = true; }
                                        <option value="@pmId" @(isCash ? "selected" : "")>@pmName</option>
                                    }
                                }
                            }
                            if (!seenMethods.Contains("Cash"))
                            {
                                <option value="1" @(!hasCashSelected ? "selected" : "")>Cash</option>
                                hasCashSelected = true;
                            }
                            if (!seenMethods.Contains("Bank Transfer"))
                            {
                                <option value="2">Bank Transfer</option>
                            }
                            if (!seenMethods.Contains("Cheque"))
                            {
                                <option value="3">Cheque</option>
                            }
                            if (!seenMethods.Contains("Petty Cash"))
                            {
                                <option value="4">Petty Cash</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <!-- Account Name -->
            <div class="form-group-row">
                <label class="pb-col-label" for="cboPaymentAccount">Account Name<span class="star">*</span></label>
                <div class="pb-col-input">
                    <select id="cboPaymentAccount" class="form-control select2">
                        <option value="">---Please select---</option>
                        @if (paymentAccounts != null && paymentAccounts.Rows.Count > 0)
                        {
                            foreach (System.Data.DataRow r in paymentAccounts.Rows)
                            {
                                string accId = r["ChartOfAccountID"].ToString();
                                string accFullName = r["FullAccountName"].ToString();
                                if (!string.IsNullOrEmpty(accId) && seenAccounts.Add(accId))
                                {
                                    bool isSelAcc = (!string.IsNullOrEmpty(defaultAccId) && accId == defaultAccId);
                                    <option value="@accId" @(isSelAcc ? "selected" : "")>@accFullName</option>
                                }
                            }
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================================================================== -->
    <!-- SECTION 2: INVOICE FOR PAYMENT                                       -->
    <!-- ==================================================================== -->
    <div class="pb-section-header mt-3">
        <span class="pb-title">INVOICE FOR PAYMENT</span>
        <div class="pb-line"></div>
    </div>

    <div class="pb-table-container">
        <table class="table pb-table" id="tblInvoices">
            <colgroup>
                <col style="width: 4%;" />
                <col style="width: 10%;" />
                <col style="width: 20%;" />
                <col style="width: 12%;" />
                <col style="width: 12%;" />
                <col style="width: 14%;" />
                <col style="width: 12%;" />
                <col style="width: 11%;" />
                <col style="width: 5%;" />
            </colgroup>
            <thead>
                <tr>
                    <th class="text-center">#</th>
                    <th>Date</th>
                    <th>Reference</th>
                    <th class="text-right">Amount</th>
                    <th class="text-right">Balance</th>
                    <th class="text-right">Pay</th>
                    <th class="text-right">Discount</th>
                    <th class="text-right">Remain</th>
                    <th class="text-center">
                        <input type="checkbox" id="chkSelectAll" onchange="toggleSelectAllInvoices(this);" title="Select/Deselect All" />
                    </th>
                </tr>
            </thead>
            <tbody id="tblInvoicesBody">
                <tr>
                    <td colspan="9" class="text-center text-muted" style="height: 235px; vertical-align: middle;">
                        <i class="fa fa-info-circle mr-1"></i> Please select a vendor to load outstanding invoices.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Heavy Grey Divider - Spanning Full Width -->
    <hr class="pb-heavy-divider" />

    <!-- ==================================================================== -->
    <!-- SECTION 3: REMARK & SUMMARY TOTALS                                   -->
    <!-- ==================================================================== -->
    <div class="row align-items-start">
        <!-- Left: Remark -->
        <div class="col-md-7 pr-md-4">
            <label class="font-weight-bold text-secondary mb-1" for="txtRemark" style="font-size: 12.5px;">Remark</label>
            <textarea id="txtRemark" class="form-control" rows="3" style="width: 100%; max-width: 650px; height: 82px !important; resize: vertical;" placeholder=""></textarea>
        </div>

        <!-- Right: Totals Summary (Synced to Right Edge) -->
        <div class="col-md-5 pl-md-2 text-right">
            <table class="pb-summary-table ml-auto">
                <tbody>
                    <tr>
                        <td class="lbl-sum">Total Balance</td>
                        <td class="val-sum" id="lblTotalBalance">0.00</td>
                    </tr>
                    <tr>
                        <td class="lbl-sum">Total Pay</td>
                        <td class="val-sum" id="lblTotalPay">0.00</td>
                    </tr>
                    <tr>
                        <td class="lbl-sum">Discount($)</td>
                        <td class="val-sum" id="lblTotalDiscount">0.00</td>
                    </tr>
                    <tr class="row-balance-applied">
                        <td class="lbl-sum font-weight-bold text-dark">Balance Applied</td>
                        <td class="val-sum font-weight-bold text-dark" id="lblBalanceApplied">0.00</td>
                    </tr>
                    <tr>
                        <td class="lbl-sum">Remain Balance</td>
                        <td class="val-sum font-weight-bold" id="lblRemainBalance">0.00</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Direct bottom bar (Used when not loaded in modal) -->
    <div class="pb-bottom-bar" id="pbDirectFooter">
        <button type="button" class="btn btn-outline-primary mr-2" id="btnDirectSaveNew" onclick="submitPayBill(true);"><i class="ti ti-plus mr-1"></i> Save &amp; New</button>
        <button type="button" class="btn btn-outline-primary mr-2" id="btnDirectSave" onclick="submitPayBill(false);"><i class="ti ti-device-floppy mr-1"></i> Save Change</button>
        <button type="button" class="btn btn-outline-danger" onclick="closePayBillModal();"><i class="ti ti-x mr-1"></i> Close</button>
    </div>

</div>

<!-- ==========================================================================
     CLIENT JAVASCRIPT ENGINE & LOGIC
     ========================================================================== -->
<script>
    var allBills = [];
    var selectedBillsMap = {};
    var billsLoading = false;

    var currentSystemID = '@(ViewBag.SystemID ?? "")';
    var currentWarehouseID = '@(ViewBag.WarehouseID ?? "")';

    $(document).ready(function () {
        // Detect & apply dynamic system theme color
        applyDynamicTheme();

        // Setup standard modal header and footer buttons matching system modals
        setupSystemModalActions();

        // Initialize Select2 dropdowns
        initSelect2Dropdowns();

        // Initialize Datepicker
        initPaymentDatePicker();

        // Sync vendor contact information on start
        syncVendorContactDetails();

        // Preselect vendor or trigger bill load
        if ($('#cboVendor').val()) {
            onVendorChange('@selectedBillId');
        } else {
            refreshPVNumber();
        }
    });

    // ──────────────────────────────────────────────────────────────────────────
    // DYNAMIC SYSTEM / WAREHOUSE THEME RESOLUTION
    // ──────────────────────────────────────────────────────────────────────────
    function getSystemThemeColor() {
        // 1. Check CSS root variable --base-bg-color
        try {
            var rootColor = getComputedStyle(document.documentElement).getPropertyValue('--base-bg-color');
            if (rootColor && rootColor.trim() && rootColor.trim() !== 'transparent') {
                return rootColor.trim();
            }
        } catch (e) { }

        // 2. Check localStorage "BaseSystemBGColor"
        try {
            var lsColor = localStorage.getItem("BaseSystemBGColor");
            if (lsColor && lsColor.trim() && lsColor.trim() !== 'transparent' && lsColor.trim() !== 'rgba(0, 0, 0, 0)') {
                return lsColor.trim();
            }
        } catch (e) { }

        // 3. Check parent window if in modal or iframe
        try {
            if (window.parent && window.parent !== window) {
                var pRoot = window.parent.getComputedStyle(window.parent.document.documentElement).getPropertyValue('--base-bg-color');
                if (pRoot && pRoot.trim()) return pRoot.trim();
                var pLs = window.parent.localStorage.getItem("BaseSystemBGColor");
                if (pLs && pLs.trim()) return pLs.trim();
            }
        } catch (e) { }

        // 4. Check active DOM elements on page or parent (AdminLTE active nav or navbar)
        try {
            var $activeLink = $("aside nav ul > li.nav-item > .nav-link.active, .navbar.main-header, .navbar-custom, .navbar-main").first();
            if ($activeLink.length) {
                var bg = $activeLink.css("background-color");
                if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent' && bg !== 'rgb(255, 255, 255)') {
                    return bg;
                }
            }
        } catch (e) { }

        // 5. SystemID fallback mapping
        var sysId = parseInt(currentSystemID || '0');
        if (sysId === 13) return '#2072b2';
        if (sysId === 28) return '#2275b9';
        if (sysId === 25) return '#c5d9f1';

        // 6. Default fallback
        return '#2072b2';
    }

