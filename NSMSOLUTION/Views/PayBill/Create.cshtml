    function initPaymentDatePicker() {
        var $input = $('#txtPaymentDate');
        var initialized = false;

        if (typeof $.fn.daterangepicker === 'function') {
            try {
                var startMoment = moment();
                var curText = $input.val();
                if (curText) {
                    var parts = curText.split('/');
                    if (parts.length === 3) {
                        startMoment = moment(parts[2] + '-' + parts[1] + '-' + parts[0], 'YYYY-MM-DD');
                        if (!startMoment.isValid()) startMoment = moment();
                    }
                }

                $input.daterangepicker({
                    singleDatePicker: true,
                    showDropdowns: true,
                    autoApply: true,
                    autoUpdateInput: true,
                    startDate: startMoment,
                    locale: { format: 'DD/MM/YYYY' },
                    parentEl: $('#payBillCreateApp').length ? $('#payBillCreateApp') : 'body'
                }, function (start) {
                    $input.val(start.format('DD/MM/YYYY'));
                    refreshPVNumber();
                });

                $input.on('apply.daterangepicker', function (ev, picker) {
                    $input.val(picker.startDate.format('DD/MM/YYYY'));
                    refreshPVNumber();
                });

                initialized = true;
            } catch (err) {
                console.warn('daterangepicker warning:', err);
            }
        }

        if (!initialized && typeof $.fn.datepicker === 'function') {
            try {
                $input.datepicker({
                    format: 'dd/mm/yyyy',
                    dateFormat: 'dd/mm/yy',
                    autoclose: true,
                    todayHighlight: true
                }).on('changeDate', function () {
                    refreshPVNumber();
                });
                initialized = true;
            } catch (err) {
                console.warn('datepicker warning:', err);
            }
        }

        $('#wrapPaymentDate button, #wrapPaymentDate input').off('click.openDp').on('click.openDp', function () {
            if ($input.data('daterangepicker')) {
                $input.data('daterangepicker').show();
            } else if (typeof $input.datepicker === 'function') {
                $input.datepicker('show');
            } else {
                $input.focus();
            }
        });
    }

    function onVendorChange(specificBill) {
        refreshPVNumber();
        loadOutstandingBills(specificBill);
    }

    function refreshPVNumber() {
        var pDate = $('#txtPaymentDate').val() || '@currentDate';
        $.ajax({
            url: '@Url.Action("GetPVNumber", "PayBill")',
            type: 'GET',
            data: { 
                paymentDate: pDate,
                systemId: currentSystemID,
                warehouseId: currentWarehouseID
            },
            success: function (res) {
                if (res && res.success && res.pvNumber) {
                    $('#txtPaymentNo').val(res.pvNumber);
                } else {
                    $('#txtPaymentNo').val('Auto Generate Code');
                }
            },
            error: function () {
                $('#txtPaymentNo').val('Auto Generate Code');
            }
        });
    }

    function loadOutstandingBills(specificBill) {
        var vId = $('#cboVendor').val() || 0;
        var targetBill = (typeof specificBill !== 'undefined') ? specificBill : '@selectedBillId';

        if (!vId || vId === '0') {
            billsLoading = false;
            allBills = [];
            selectedBillsMap = {};
            renderInvoicesTable();
            calculateAndSyncTotals();
            return;
        }

        billsLoading = true;
        $('#tblInvoicesBody').html('<tr><td colspan="9" class="text-center text-muted" style="height: 235px; vertical-align: middle;"><i class="fa fa-spinner fa-spin mr-1"></i> Loading unpaid invoices...</td></tr>');

        $.ajax({
            url: '@Url.Action("GetUnpaidBills", "PayBill")',
            type: 'GET',
            data: { 
                vendorId: vId,
                billId: targetBill,
                systemId: currentSystemID,
                warehouseId: currentWarehouseID
            },
            success: function (res) {
                billsLoading = false;
                if (res && res.success) {
                    var rawBills = res.bills || res.data || [];
                    if (typeof rawBills === 'string') {
                        try { rawBills = JSON.parse(rawBills); } catch (e) { rawBills = []; }
                    }

                    var seenKeys = {};
                    var seenBillNos = {};
                    var deduplicated = [];

                    (Array.isArray(rawBills) ? rawBills : []).forEach(function (b) {
                        var key = getBillKey(b);
                        var bNo = (b.BillNumber || '').toString().trim().toUpperCase();

                        if (seenKeys[key]) return;
                        if (bNo && !bNo.startsWith('EXP-') && seenBillNos[bNo]) return;

                        seenKeys[key] = true;
                        if (bNo && !bNo.startsWith('EXP-')) {
                            seenBillNos[bNo] = true;
                        }
                        deduplicated.push(b);
                    });

                    allBills = deduplicated;
                    selectedBillsMap = {};

                    if (allBills.length > 0) {
                        allBills.forEach(function (b) {
                            var key = getBillKey(b);
                            var isTarget = (targetBill && (b.BillID == targetBill || b.BillNumber == targetBill));
                            selectedBillsMap[key] = $.extend({}, b, {
                                AmountToPay: isTarget ? parseNum(b.AmountDue) : 0.00,
                                Discount: 0.00,
                                IsSelected: isTarget ? true : false
                            });
                        });
                    }

                    renderInvoicesTable();
                    calculateAndSyncTotals();
                } else {
                    allBills = [];
                    selectedBillsMap = {};
                    renderInvoicesTable();
                    calculateAndSyncTotals();
                }
            },
            error: function () {
                billsLoading = false;
                allBills = [];
                selectedBillsMap = {};
                renderInvoicesTable();
                calculateAndSyncTotals();
            }
        });
    }

    function renderInvoicesTable() {
        if (!allBills || allBills.length === 0) {
            var msg = $('#cboVendor').val() ? 'No outstanding invoices found for this vendor.' : 'Please select a vendor to load outstanding invoices.';
            $('#tblInvoicesBody').html('<tr><td colspan="9" class="text-center text-muted" style="height: 235px; vertical-align: middle;"><i class="fa fa-info-circle mr-1"></i> ' + msg + '</td></tr>');
            $('#chkSelectAll').prop('checked', false);
            return;
        }

        var html = '';
        allBills.forEach(function (b, idx) {
            var key = getBillKey(b);
            var item = selectedBillsMap[key] || { AmountToPay: 0, Discount: 0, IsSelected: false };
            var isSel = !!item.IsSelected;
            var payVal = parseNum(item.AmountToPay);
            var discVal = parseNum(item.Discount);
            var dueVal = parseNum(b.AmountDue);
            var remainVal = Math.max(0, dueVal - payVal - discVal);

            html += '<tr class="' + (isSel ? 'row-selected' : '') + '" data-key="' + key + '">';
            
            // #
            html += '<td class="text-center align-middle text-muted">' + (idx + 1) + '</td>';

            // Date
            html += '<td class="align-middle text-truncate">' + (b.BillDateFormatted || '-') + '</td>';

            // Reference
            html += '<td class="align-middle font-weight-bold text-truncate" title="' + (b.BillNumber || '') + '">' + (b.BillNumber || '-') + '</td>';

            // Amount
            html += '<td class="text-right align-middle">' + formatNumber(b.GrandTotal) + '</td>';

            // Balance
            html += '<td class="text-right align-middle font-weight-bold">' + formatNumber(b.AmountDue) + '</td>';
            
            // Pay input
            html += '<td class="text-right align-middle p-1">';
            html += '  <input type="text" class="form-control text-right inp-grid inp-row-pay" data-key="' + key + '" value="' + formatNumber(payVal) + '" oninput="onRowPayChange(this, \'' + key + '\', false);" onchange="onRowPayChange(this, \'' + key + '\', true);" onfocus="this.select();" />';
            html += '</td>';

            // Discount input
            html += '<td class="text-right align-middle p-1">';
            html += '  <input type="text" class="form-control text-right inp-grid inp-row-discount" data-key="' + key + '" value="' + formatNumber(discVal) + '" oninput="onRowDiscountChange(this, \'' + key + '\', false);" onchange="onRowDiscountChange(this, \'' + key + '\', true);" onfocus="this.select();" />';
            html += '</td>';

            // Remain
            html += '<td class="text-right align-middle font-weight-bold cell-row-remain" data-key="' + key + '">';
            html += formatNumber(remainVal);
            html += '</td>';

            // Checkbox & Edit Pencil Button
            html += '<td class="text-center align-middle text-nowrap">';
            html += '  <input type="checkbox" class="chk-row-item align-middle mr-1" data-key="' + key + '" ' + (isSel ? 'checked' : '') + ' onchange="onRowCheckChange(this, \'' + key + '\');" />';
            html += '  <a href="javascript:void(0);" class="pb-btn-edit-pencil align-middle" title="Select / Focus" onclick="quickEditRow(event, \'' + key + '\');"><i class="fas fa-pencil-alt"></i></a>';
            html += '</td>';

            html += '</tr>';
        });

        $('#tblInvoicesBody').html(html);

        // Apply theme to freshly created pencil buttons
        var themeColor = getSystemThemeColor();
        $('.pb-btn-edit-pencil').css({
            'background-color': themeColor,
            'border-color': themeColor
        });

        var totalItems = allBills.length;
        var checkedItems = allBills.filter(function (b) {
            var key = getBillKey(b);
            return selectedBillsMap[key] && selectedBillsMap[key].IsSelected;
        }).length;
        $('#chkSelectAll').prop('checked', totalItems > 0 && totalItems === checkedItems);
    }

    function quickEditRow(e, key) {
        if (e && e.preventDefault) e.preventDefault();
        var bill = allBills.find(function (b) { return getBillKey(b) === key; });
        if (!bill) return;

        var item = selectedBillsMap[key];
        var isCurrentlySelected = item && item.IsSelected && (parseNum(item.AmountToPay) > 0 || parseNum(item.Discount) > 0);

        if (isCurrentlySelected) {
            // Deselect cleanly
            selectedBillsMap[key] = $.extend({}, bill, { AmountToPay: 0, Discount: 0, IsSelected: false });
            syncSingleRow(key, true);
            calculateAndSyncTotals();
        } else {
            // Select row with full due balance and focus pay input
            var fullDue = parseNum(bill.AmountDue);
            selectedBillsMap[key] = $.extend({}, bill, { AmountToPay: fullDue, Discount: 0, IsSelected: true });
            syncSingleRow(key, true);
            calculateAndSyncTotals();
            var $payInp = $('tr[data-key="' + key + '"] .inp-row-pay');
            if ($payInp.length) {
                $payInp.focus().select();
            }
        }
    }

    function onRowPayChange(input, key, isFinal) {
        var rawVal = $(input).val();
        var val = parseNum(rawVal);
        var bill = allBills.find(function (b) { return getBillKey(b) === key; });
        if (!bill) return;

        var disc = selectedBillsMap[key] ? parseNum(selectedBillsMap[key].Discount || 0) : 0;
        var maxPay = Math.max(0, parseNum(bill.AmountDue) - disc);

        if (val > maxPay) {
            val = maxPay;
            if (isFinal && typeof DialogSweetAlert === 'function') {
                DialogSweetAlert('warning', 'Payment cannot exceed balance (' + formatNumber(maxPay) + ')');
            }
        }
        if (val < 0) val = 0;

        if (isFinal) {
            $(input).val(formatNumber(val));
        }

        var isSel = (val > 0 || disc > 0);
        selectedBillsMap[key] = $.extend({}, bill, {
            AmountToPay: val,
            Discount: disc,
            IsSelected: isSel
        });

        syncSingleRow(key, isFinal);
        calculateAndSyncTotals();
    }

    function onRowDiscountChange(input, key, isFinal) {
        var rawVal = $(input).val();
        var disc = parseNum(rawVal);
        var bill = allBills.find(function (b) { return getBillKey(b) === key; });
        if (!bill) return;

        var pay = selectedBillsMap[key] ? parseNum(selectedBillsMap[key].AmountToPay || 0) : 0;
        var due = parseNum(bill.AmountDue);

        if (disc + pay > due) {
            disc = Math.max(0, due - pay);
        }
        if (disc < 0) disc = 0;

        if (isFinal) {
            $(input).val(formatNumber(disc));
        }

        var isSel = (pay > 0 || disc > 0);
        selectedBillsMap[key] = $.extend({}, bill, {
            AmountToPay: pay,
            Discount: disc,
            IsSelected: isSel
        });

        syncSingleRow(key, isFinal);
        calculateAndSyncTotals();
    }

    function onRowCheckChange(chk, key) {
        var isChecked = $(chk).is(':checked');
        var bill = allBills.find(function (b) { return getBillKey(b) === key; });
        if (!bill) return;

        if (isChecked) {
            var fullDue = parseNum(bill.AmountDue);
            selectedBillsMap[key] = $.extend({}, bill, { AmountToPay: fullDue, Discount: 0, IsSelected: true });
        } else {
            selectedBillsMap[key] = $.extend({}, bill, { AmountToPay: 0, Discount: 0, IsSelected: false });
        }

        syncSingleRow(key, true);
        calculateAndSyncTotals();
    }

    function toggleSelectAllInvoices(chk) {
        var isChecked = $(chk).is(':checked');
        allBills.forEach(function (b) {
            var key = getBillKey(b);
            if (isChecked) {
                var fullDue = parseNum(b.AmountDue);
                selectedBillsMap[key] = $.extend({}, b, { AmountToPay: fullDue, Discount: 0, IsSelected: true });
            } else {
                selectedBillsMap[key] = $.extend({}, b, { AmountToPay: 0, Discount: 0, IsSelected: false });
            }
        });

        renderInvoicesTable();
        calculateAndSyncTotals();
    }

    function syncSingleRow(key, syncInputs) {
        var item = selectedBillsMap[key];
        var bill = allBills.find(function (b) { return getBillKey(b) === key; });
        if (!item || !bill) return;

        var $row = $('tr[data-key="' + key + '"]');
        var isSel = !!item.IsSelected;
        var pay = parseNum(item.AmountToPay);
        var disc = parseNum(item.Discount);
        var due = parseNum(bill.AmountDue);
        var remain = Math.max(0, due - pay - disc);

        $row.toggleClass('row-selected', isSel);
        $row.find('.chk-row-item').prop('checked', isSel);
        if (syncInputs) {
            $row.find('.inp-row-pay').val(formatNumber(pay));
            $row.find('.inp-row-discount').val(formatNumber(disc));
        }
        $row.find('.cell-row-remain').text(formatNumber(remain));

        var totalItems = allBills.length;
        var checkedItems = allBills.filter(function (b) {
            var k = getBillKey(b);
            return selectedBillsMap[k] && selectedBillsMap[k].IsSelected;
        }).length;
        $('#chkSelectAll').prop('checked', totalItems > 0 && totalItems === checkedItems);
    }

    function onPayAmountKeyup(e) {
        if (e.keyCode === 13) {
            applyPayAmount();
        }
    }

    function applyPayAmount() {
        var totalApply = parseNum($('#txtPayAmount').val());
        if (totalApply <= 0) return;

        if (!allBills || allBills.length === 0) return;

        var remaining = totalApply;

        allBills.forEach(function (b) {
            var key = getBillKey(b);
            var due = parseNum(b.AmountDue);
            var disc = selectedBillsMap[key] ? parseNum(selectedBillsMap[key].Discount || 0) : 0;
            var maxPay = Math.max(0, due - disc);

            if (remaining > 0 && maxPay > 0) {
                var alloc = Math.min(remaining, maxPay);
                selectedBillsMap[key] = $.extend({}, b, {
                    AmountToPay: alloc,
                    Discount: disc,
                    IsSelected: (alloc > 0)
                });
                remaining -= alloc;
            } else {
                selectedBillsMap[key] = $.extend({}, b, {
                    AmountToPay: 0,
                    Discount: disc,
                    IsSelected: false
                });
            }
        });

        renderInvoicesTable();
        calculateAndSyncTotals();
    }

    function calculateAndSyncTotals() {
        var totalBalance = 0;
        var totalPay = 0;
        var totalDiscount = 0;

        allBills.forEach(function (b) {
            totalBalance += parseNum(b.AmountDue);
            var key = getBillKey(b);
            if (selectedBillsMap[key] && selectedBillsMap[key].IsSelected) {
                totalPay += parseNum(selectedBillsMap[key].AmountToPay || 0);
                totalDiscount += parseNum(selectedBillsMap[key].Discount || 0);
            }
        });

        var balanceApplied = totalPay + totalDiscount;
        var remainBalance = Math.max(0, totalBalance - balanceApplied);

        // Sync Summary Table
        $('#lblTotalBalance').text(formatNumber(totalBalance));
        $('#lblTotalPay').text(formatNumber(totalPay));
        $('#lblTotalDiscount').text(formatNumber(totalDiscount));
        $('#lblBalanceApplied').text(formatNumber(balanceApplied));
        $('#lblRemainBalance').text(formatNumber(remainBalance));

        // Sync Pay Amount text input
        $('#txtPayAmount').val(totalPay > 0 ? totalPay.toFixed(2) : '0.00');
    }

    function getBillKey(bill) {
        return (bill.ExpenseID && bill.ExpenseID > 0) ? ('EXP_' + bill.ExpenseID) : ('BILL_' + bill.BillID);
    }

    function parseNum(val) {
        if (typeof accounting !== 'undefined' && accounting.unformat) {
            return accounting.unformat(val) || 0;
        }
        if (!val) return 0;
        if (typeof val === 'number') return isNaN(val) ? 0 : val;
        var clean = val.toString().replace(/[^0-9.-]/g, '');
        var num = parseFloat(clean);
        return isNaN(num) ? 0 : num;
    }

    function formatNumber(num) {
        if (typeof accounting !== 'undefined' && accounting.formatMoney) {
            return accounting.formatMoney(num, '');
        }
        return (parseFloat(num) || 0).toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function closePayBillModal() {
        try {
            var m = document.getElementById('modal-default') || document.querySelector('.modal.show');
            if (m && window.bootstrap && bootstrap.Modal) {
                var inst = bootstrap.Modal.getInstance(m) || bootstrap.Modal.getOrCreateInstance(m);
                if (inst) inst.hide();
            }
        } catch (e) { }

        try {
            if (typeof closeDialogClick === 'function') {
                closeDialogClick('modal-default');
            }
        } catch (e) { }

        try {
            $('#modal-default, .modal').modal('hide');
        } catch (e) { }

        setTimeout(function () {
            $('#modal-default, .modal').removeClass('show in').hide();
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({ 'padding-right': '', 'overflow': 'auto' });
        }, 100);
    }

    function submitPayBill(isSaveAndNew) {
        if (billsLoading) {
            if (typeof DialogSweetAlert === 'function') {
                DialogSweetAlert('warning', 'Please wait for invoices to finish loading.');
            }
            return;
        }

        var vendorId = $('#cboVendor').val();
        if (!vendorId || vendorId === '0') {
            if (typeof DialogSweetAlert === 'function') {
                DialogSweetAlert('warning', 'Please select a vendor.');
            }
            return;
        }

        var accountId = $('#cboPaymentAccount').val();
        if (!accountId) {
            if (typeof DialogSweetAlert === 'function') {
                DialogSweetAlert('warning', 'Please select an account.');
            }
            return;
        }

        var details = [];
        var totalPay = 0;

        allBills.forEach(function (b) {
            var key = getBillKey(b);
            var item = selectedBillsMap[key];
            if (item && item.IsSelected && parseNum(item.AmountToPay) > 0) {
                var amt = parseNum(item.AmountToPay);
                totalPay += amt;
                details.push({
                    BillID: item.BillID || 0,
                    ExpenseID: item.ExpenseID || 0,
                    BillNumber: item.BillNumber || '',
                    PONumber: item.PONumber || '',
                    Amount: parseNum(item.GrandTotal),
                    AmountPaid: parseNum(item.AmountPaid),
                    AmountDue: parseNum(item.AmountDue),
                    PaymentAmount: amt,
                    DepositAmount: parseNum(item.DepositAmount || 0),
                    DepositExpenseID: item.DepositExpenseID || 0
                });
            }
        });

        if (details.length === 0 || totalPay <= 0) {
            if (typeof DialogSweetAlert === 'function') {
                DialogSweetAlert('warning', 'Please enter payment amount for at least one invoice.');
            }
            return;
        }

        var payeeText = $('#txtContactPerson').val() || $('#cboVendor option:selected').text();
        var pmId = $('#cboPaymentMethod').val() || 1;
        var pmText = $('#cboPaymentMethod option:selected').text() || 'Cash';
        var pvNo = $('#txtPaymentNo').val();
        if (pvNo === 'Auto Generate Code') pvNo = '';

        var memoText = $('#txtMemo').val() || '';
        var remarkText = $('#txtRemark').val() || '';
        var combinedMemo = memoText;
        if (remarkText) {
            combinedMemo = combinedMemo ? (combinedMemo + ' | Remark: ' + remarkText) : remarkText;
        }

        var header = {
            SystemID: currentSystemID,
            WarehouseID: currentWarehouseID,
            VendorID: vendorId,
            Payee: payeeText,
            PVNumber: pvNo,
            Reference: '',
            PaymentDate: $('#txtPaymentDate').val(),
            ChartOfAccountID: accountId,
            PaymentModeID: pmId,
            PaymentMode: pmText,
            Memo: combinedMemo || ('Payment for ' + details.length + ' vendor bill(s)'),
            TotalPaymentAmount: totalPay
        };

        var $btnAction = isSaveAndNew ? $('#btnSaveNew, #btnDirectSaveNew') : $('#SaveChange, #btnDirectSave');
        var origHtml = $btnAction.html();
        $btnAction.prop('disabled', true).html('<i class="fa fa-spinner fa-spin mr-1"></i> Saving...');

        $.ajax({
            url: '@Url.Action("SavePayment", "PayBill")',
            type: 'POST',
            data: {
                paymentHeader: JSON.stringify(header),
                paymentDetails: JSON.stringify(details)
            },
            success: function (res) {
                $btnAction.prop('disabled', false).html(origHtml);
                if (res && res.success) {
                    var pid = res.paymentId;
                    var pv = res.pvNumber || header.PVNumber || '';

                    if (typeof DialogSweetAlert === 'function') {
                        DialogSweetAlert('loadsuccess', 'Payment saved successfully! PV: ' + pv);
                    } else if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            position: 'top',
                            icon: 'success',
                            title: 'Payment Saved Successfully!',
                            html: pv ? ('Voucher Nº: <strong>' + pv + '</strong>') : '',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    }

                    // Reload underlying grid
                    if ($('#BunSearch').length) {
                        $('#BunSearch').click();
                    } else if (typeof LoadDataSearch === 'function') {
                        LoadDataSearch();
                    }

                    if (isSaveAndNew) {
                        resetFormForNewPayment();
                    } else {
                        closePayBillModal();
                    }
                } else {
                    var errMsg = (res && res.message) ? res.message : 'Failed to save payment.';
                    if (typeof DialogSweetAlert === 'function') {
                        DialogSweetAlert('error', errMsg);
                    } else if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'Save Failed',
                            html: errMsg
                        });
                    }
                }
            },
            error: function (xhr) {
                $btnAction.prop('disabled', false).html(origHtml);
                var msg = 'Error saving payment: ' + (xhr.statusText || 'Server error');
                if (typeof DialogSweetAlert === 'function') {
                    DialogSweetAlert('error', msg);
                } else if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Error', text: msg });
                }
            }
        });
    }

    function resetFormForNewPayment() {
        $('#cboVendor').val('').trigger('change');
        $('#txtContactPerson').val('');
        $('#txtPhone').val('');
        $('#txtMemo').val('');
        $('#txtRemark').val('');
        $('#txtPayAmount').val('');
        allBills = [];
        selectedBillsMap = {};
        renderInvoicesTable();
        calculateAndSyncTotals();
        refreshPVNumber();
    }
</script>
