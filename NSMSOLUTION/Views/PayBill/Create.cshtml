@{
    Layout = null;
    var paymentAccounts = ViewBag.PaymentAccounts as System.Data.DataTable;
    var paymentMethods = ViewBag.PaymentMethods as System.Data.DataTable;
    var vendors = ViewBag.Vendors as System.Data.DataTable;
    int selectedVendorId = 0;
    if (ViewBag.VendorID != null)
    {
        int.TryParse(Convert.ToString(ViewBag.VendorID), out selectedVendorId);
    }
    else if (ViewBag.SelectedVendorID != null)
    {
        int.TryParse(Convert.ToString(ViewBag.SelectedVendorID), out selectedVendorId);
    }
    string selectedBillId = Convert.ToString(ViewBag.SelectedBillID ?? "");
    string currentDate = Convert.ToString(ViewBag.CurrentDate ?? DateTime.Now.ToString("dd/MM/yyyy"));
    string currentUserName = Convert.ToString(ViewBag.CurrentUserName ?? "Admin");

    // Deduplicate Accounts and determine default (e.g. 10000 Petty Cash NSM)
    string defaultAccId = "";
    var seenAccounts = new HashSet<string>();
    if (paymentAccounts != null && paymentAccounts.Rows.Count > 0)
    {
        foreach (System.Data.DataRow r in paymentAccounts.Rows)
        {
            string accId = r["ChartOfAccountID"].ToString();
            string accFullName = r["FullAccountName"].ToString();
            if (string.IsNullOrEmpty(defaultAccId))
            {
                if (accFullName.Contains("10000") || accFullName.IndexOf("Petty Cash", StringComparison.OrdinalIgnoreCase) >= 0)
                {
                    defaultAccId = accId;
                }
            }
        }
    }
}

