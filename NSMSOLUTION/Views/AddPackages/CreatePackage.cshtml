@{
    Layout = null;
}
@Html.Raw(@ViewBag.DrawHTMLForm)
<script>
    var TblRow = '';
    var rowData = "";
    var PackageData = "";
    var PrimaryValue = "@ViewBag.PrimaryValue";
    var isSaveChange = false;
    $(function () {
        PackageData = "@ViewBag.PackageData";
        rowData = '<div class="row">';
        rowData += '<div class="col">';
        rowData += '<table class="table table-bordered" id="tblPackages">';
        rowData += '<thead class="bg-gray">';
        rowData += '<tr>';
        rowData += '<th>#</th><th>Bandwidth(Mbps)</th><th>Duration</th><th>UM</th><th>Cost</th><th>Price</th><th>DowSpeed</th><th>UpSpeed</th>';
        rowData += '<th class="d-none">DepositFee</th><th class="d-none">FreeMonth</th>';
        rowData += '<th class="col-2">Feature</th><th>Status</th><th></th>';
        rowData += '</tr>';
        rowData += '</thead>';
        rowData += '<tbody>';
        rowData += '<tr name="rowNo">';
        rowData += '<td align="right" name="tdNo">1</td>';
        rowData += '<td><input class="form-control text-center" onchange=onBandwidthChange(this); name="Bandwidth" type="text" required/><input type="hidden" name="PackageDetailID" value="0"/></td>';
        rowData += '<td><input class="form-control text-center" name="Duration" type="text" required/></td>';
        rowData += '<td><input class="form-control text-center" name="UM" type="text" required/></td>';
        rowData += '<td><input class="form-control text-center" name="Cost" type="text" required/></td>';
        rowData += '<td><input class="form-control text-center" name="Price" type="text" required/></td>';
        rowData += '<td><input class="form-control text-center" name="DowSpeed" type="text" required/></td>';
        rowData += '<td><input class="form-control text-center" name="UpSpeed" type="text" required/></td>';
        rowData += '<td class="d-none"><input class="form-control text-center" name="DepositFee" type="text"/></td>';
        rowData += '<td class="d-none"><input class="form-control text-center" name="FreeDuration" type="text"/></td>';
        rowData += '<td><textarea class="form-control" name="Feature"></textarea></td><td><select class="form-control" name="Status"><option value="Enable">Enable</option><option value="Disable">Disable</option></select></td><td></td>';
        rowData += '</tr>';
        rowData += '</tbody>';
        rowData += '</table>';
        rowData += '</div></div>';

        TblRow = '<tr name="rowNo">';
        TblRow += '<td align="right" name="tdNo">1</td>';
        TblRow += '<td><input class="form-control text-center" onchange=onBandwidthChange(this); name="Bandwidth" type="text" required/><input type="hidden" name="PackageDetailID" value="0"/></td>';
        TblRow += '<td><input class="form-control text-center" name="Duration" type="text" required/></td>';
        TblRow += '<td><input class="form-control text-center" name="UM" type="text" required/></td>';
        TblRow += '<td><input class="form-control text-center" name="Cost" type="text" required/></td>';
        TblRow += '<td><input class="form-control text-center" name="Price" type="text" required/></td>';
        TblRow += '<td><input class="form-control text-center" name="DowSpeed" type="text" required/></td>';
        TblRow += '<td><input class="form-control text-center" name="UpSpeed" type="text" required/></td>';
        TblRow += '<td class="d-none"><input class="form-control text-center" name="DepositFee" type="text"/></td>';
        TblRow += '<td class="d-none"><input class="form-control text-center" name="FreeDuration" type="text"/></td>';
        TblRow += '<td><textarea class="form-control" name="Feature"></textarea></td><td><select class="form-control" name="Status"><option value="Enable">Enable</option><option value="Disable">Disable</option></select></td>';
        TblRow += '<td><div class="btn-group"><a name="Delete" onclick="RemoveTableRow(' + "'rowNo'" + ', ' + "'tdNo'" + ', this);" class="btn btn-danger btn-sm" href="javascript:void(0);" title="Delete" alt="Delete"><i class="ti ti-trash"></i></a></div></td>';
        TblRow += '</tr>';

        $("form[name=CreatePackage] table").after(rowData);
        AddTableRow("Bandwidth", "tblPackages", "rowNo", TblRow, "tdNo", this, function () {
            $("input[name=Bandwidth]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=Duration]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=Cost]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=Price]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=DowSpeed]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=UpSpeed]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=DepositFee]").keypress(function (event) { allowInputOnlyNumber(event); });
            $("input[name=FreeDuration]").keypress(function (event) { allowInputOnlyNumber(event); });

            $("input[name=Bandwidth], input[name=Duration], input[name=Cost], input[name=Price], input[name=DowSpeed], input[name=UpSpeed], input[name=DepositFee], input[name=FreeDuration], input[name=UM]").on('keydown', function (e) {
                if (e.which == 40) {
                    var index = $('input[name=' + $(this).attr('name') + ']').index($(this));
                    var THIS = $('input[name=' + $(this).attr('name') + ']');
                    $(this).closest('tr').next().find('input[name=' + $(this).attr('name') + ']').focus().select();
                    var scrollPosition = (THIS.eq(index).offset().top - 120);
                    $(window).scrollTop(scrollPosition);
                    delete e.which;
                    return false;
                }
                if (e.which == 38) {
                    var index = $('input[name=' + $(this).attr('name') + ']').index($(this));
                    var THIS = $('input[name=' + $(this).attr('name') + ']');
                    $(this).closest('tr').prev().find('input[name=' + $(this).attr('name') + ']').focus().select();
                    var scrollPosition = (THIS.eq(index).offset().top - 200);
                    $(window).scrollTop(scrollPosition);
                    delete e.which;
                    return false;
                }
            });
        });
        if (PackageData != "") {
            PackageData = JSON.parse(PackageData.replace(/&quot;/ig, '"'));
            $.each(PackageData, function (index) {
                AddTableRow("Bandwidth", "tblPackages", "rowNo", TblRow, "tdNo", this);
                $.each(PackageData[index], function (key, value) {
                    if ($("input[name=" + key + "]:eq(" + index + ")").is("input"))
                        $("input[name=" + key + "]:eq(" + index + ")").val(value);
                    else if ($("input[name=" + key + "]:eq(" + index + ")").is("checkbox")) {
                        if (value)
                            $("input[name=" + key + "]:eq(" + index + ")").attr("checked", "checked");
                        else
                            $("input[name=" + key + "]:eq(" + index + ")").removeAttr("checked");
                    }
                    else if ($("textarea[name=" + key + "]:eq(" + index + ")").is("textarea")) {
                        if (value != "") {
                            $("textarea[name=" + key + "]:eq(" + index + ")").append($.parseHTML(value)[0].data);
                        }
                    }
                    else if ($("select[name=" + key + "]:eq(" + index + ")").is("select"))
                        $("select[name=" + key + "]:eq(" + index + ")").val(value);
                });
            });
        }
    });
    function onBandwidthChange(THIS) {
        var index = $("input[name=Bandwidth]").index(THIS);
        var value = $(THIS).val();
        $("input[name=DowSpeed]").eq(index).val(value);
        $("input[name=UpSpeed]").eq(index).val(value);
    }

    function SaveChangeAddPackage() {
        var check = true;
        isSaveChange = true;
        var Package = [];
        var PackageDetail = [];
        var ServiceNameID = $("#TxtServiceName").val();
        var ConnectionTypeID = $("#TxtPackageTypeName").val();
        var ServiceName = $("#TxtServiceName option:selected").text();
        var PackageCode = "";// encodeURIComponent(nl2br($("#TxtPackageCode").val()));
        var PackageName = encodeURIComponent(nl2br($("#TxtPackageName").val()));
        var SpecialNote = encodeURIComponent(nl2br($("#TxtSpecialNote").val()));
        var TermsandCondition = encodeURIComponent(nl2br($("#TxtTermsandCondition").val()));
        var Remark = encodeURIComponent(nl2br($("#TxtRemark").val()));
        var ExpenseAccountID = $("#TxtExpenseAccountID").val();
        var ARAccountID = $("#Txt_ARAccount").val();
        var IncomeAccountID = $("#TxtIncomeAccount").val();

        var InputVATAccountID = $("#TxtInputVATAccount").val();
        var DeferredRevenueAccountID = $("#TxtDeferredRevenueAccount").val();
        var OutputVATAccountID = $("#TxtOutputVATAccount").val();
        var SalesDiscountAccountID = $("#Txt_SalesDiscountAccount").val();
        var PurchaseDiscountAccountID = $("#Txt_PurchaseDiscountAccount").val();
        var PackageType = $("#TxtPackageType").val();
        var PackageStatus = $("#TxtPackageStatus").val();

        var IsDoubleSpeedAtNight = $("#IsDoubleSpeedAtNight").val();
        if (ServiceNameID == '0') {
            DialogSweetAlert('error', "Service Name is required.");
            $("#TxtServiceName").focus();
            check = false;
        }
        else if (ConnectionTypeID == '') {
            DialogSweetAlert('error', "Connection Type is required.");
            $("#TxtPackageTypeName").focus();
            check = false;
        }
        else if (PackageName == '') {
            DialogSweetAlert('error', "Package Name is required.");
            $("#TxtPackageName").focus();
            check = false;
        }

        if (check) {
            RowFields = [];
            addRowFiled("PackageDetailID", "PackageDetailID", "");
            addRowFiled("Bandwidth", "Bandwidth", "Required");
            addRowFiled("Duration", "Duration", "Required");
            addRowFiled("UM", "UM", "Required");
            addRowFiled("Cost", "Cost", "");
            addRowFiled("Price", "Price", "Required");
            addRowFiled("DowSpeed", "DowSpeed", "Required");
            addRowFiled("UpSpeed", "UpSpeed", "Required");
            //addRowFiled("DepositFee", "DepositFee", "Required");
            //addRowFiled("FreeDuration", "FreeDuration", "Required");
            addRowFiled("Feature", "Feature");
            addRowFiled("Status", "Status");
            PackageDetail = getRowData('rowNo', RowFields);
            Package = [{
                PackageID: PrimaryValue,
                ServiceNameID: ServiceNameID, ConnectionTypeID: ConnectionTypeID, PackageName: PackageName,
                PackageCode: PackageCode, SpecialNote: SpecialNote, TermsandCondition: TermsandCondition, Remark: Remark,
                ServiceName: ServiceName, ExpenseAccountID: ExpenseAccountID, IncomeAccountID: IncomeAccountID, IsDoubleSpeedAtNight: IsDoubleSpeedAtNight,
                InputVATAccountID: InputVATAccountID, DeferredRevenueAccountID: DeferredRevenueAccountID,
                OutputVATAccountID: OutputVATAccountID, PackageType: PackageType, ARAccountID: ARAccountID, SalesDiscountAccountID: SalesDiscountAccountID, PurchaseDiscountAccountID: PurchaseDiscountAccountID, PackageStatus: PackageStatus
            }];
            if (PackageDetail.length > 0) {
                var DATA = { Package: JSON.stringify(Package), PackageDetail: JSON.stringify(PackageDetail) };
                var URL = "/AddPackages/SaveChangePackage";
                DoSaveChangeData(URL, DATA, function (response) {
                    //$("#BunSearch").click();
                    //$("input[name=RD]").click();
                    //$("#TxtServiceName").val('');
                    //$("#TxtPackageTypeName").val('');
                    $("#TxtPackageName").val('');
                    //$("#TxtSpecialNote").val('');
                    //$("#TxtTermsandCondition").val('');
                    //$("#TxtRemark").val('');
                    $("tr[name=rowNo]").not(':last').remove();
                    AddTableRow("Bandwidth", "tblPackages", "rowNo", TblRow, "tdNo", this);
                    setTimeout(function () {
                        $("#TxtPackageName").focus();
                    }, 350);
                    //if (PackageData != "") {
                    $("#CloseModal").click();
                    //}
                });
            }
        }
        return check;
    }

    $("#modal-default").on('hide.bs.modal', function () {
        if (isSaveChange) {
            $("#BunSearch").click();
            $("input[name=RD]").click();
        }
    });

</script>
