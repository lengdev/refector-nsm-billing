        //console.log(CustID, InvNo);
        //Edit_Tbl_Row('', '', InvNo, false, '', CustID, false, '', '');
        let obj = { PrimaryFieldValue: "0", InvoiceNo: InvNo, CustomerID: CustID, FormStatus: "CreateInvoice", ConnectionID: '', EditInvoice: true, IsRenew: false, ISSO: 2 };
        AddQuotation(obj, "Edit Customer Invoice");
    }

</script>
