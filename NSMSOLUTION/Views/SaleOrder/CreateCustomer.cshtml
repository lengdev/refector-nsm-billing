    function generateCustAcc() {
        var tendigitrandomnumber = Math.floor(1000000000 + Math.random() * 9000000000);
        tendigitrandomnumber = tendigitrandomnumber.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '-');
        $("#CustomerAccount").val(tendigitrandomnumber);
    }
    $("#CustomerAccount").focus(function () {
        var tendigitrandomnumber = $("#CustomerAccount").val().replace(/-/g, '');
        $("#CustomerAccount").val(tendigitrandomnumber).select();
    });
    $("#CustomerAccount").blur(function () {
        var tendigitrandomnumber = $("#CustomerAccount").val().replace(/-/g, '');
        tendigitrandomnumber = tendigitrandomnumber.toString().replace(/\B(?=(\d{3})+(?!\d))/g, '-');
        $("#CustomerAccount").val(tendigitrandomnumber);
    });
    function tdNum() {
        $("td[name=tdNumber]").parent("tr").each(function (i) {
            $("td[name=tdNumber]").eq(i).html(i + 1);
        });
        $("input[name=QTY]").autoNumeric({ mDec: false });
        $("input[name=PackagePrice]").autoNumeric();
        $("input[name=Disp]").autoNumeric({ vMin: '0.00' });
        $("input[name=Disusd]").autoNumeric({ vMin: '0.00' });
        $("input[name=Amount]").autoNumeric({ vMin: '0.00' });
        Total();
    }
    function Total() {
        var Amount = 0;
        $.each($("input[name=Amount]"), function (index) {
            Amount += accounting.unformat($("input[name=Amount]").eq(index).val());
        });
        $("label[name=SubTotal]").html(accounting.formatMoney(Amount, ''));
        VAT();
    }
    function cal(THIS) {
        var attrName = $(THIS).attr('name');
        var index = $(THIS).parent().parent().parent('tr').index();
        var QTY = accounting.unformat($("input[name=QTY]").eq(index).val());
        var UnitPrice = accounting.unformat($("input[name=PackagePrice]").eq(index).val());
        var DiscountP = accounting.unformat($("input[name=Disp]").eq(index).val());
        var DiscountUSD = accounting.unformat($("input[name=Disusd]").eq(index).val());
        var Amount = accounting.unformat($("input[name=Amount]").eq(index).val());
        var Totalval = (QTY * UnitPrice);
        if (attrName == 'Disp') {
            DiscountUSD = ((Totalval * DiscountP) / 100);
            $("input[name=Disusd]").eq(index).val(accounting.formatMoney(DiscountUSD, ''));
        }
        else if (attrName == 'Disusd') {
            DiscountP = ((DiscountUSD / Totalval) * 100);
            $("input[name=Disp]").eq(index).val(accounting.formatMoney(DiscountP, ''));
        }
        Amount = (Totalval - DiscountUSD);
        $("input[name=Amount]").eq(index).val(accounting.formatMoney(Amount, ''));
        Total();
    }
    function VAT() {
        var SubTotal = accounting.unformat($("label[name=SubTotal]").html());
        var VAT = 0;
        var Total = 0;
        if ($('#IncludedVAT').is(':checked'))
            VAT = (SubTotal * 10) / 100;
        $("label[name=VAT]").html(accounting.formatMoney(VAT, ''));
        Total = (SubTotal + VAT);
        $("label[name=Total]").html(accounting.formatMoney(Total, ''));
        DisP(); DisUSD();
    }
