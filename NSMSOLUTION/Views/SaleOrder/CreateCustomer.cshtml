    function changeKey(originalKey, newKey, arr) {
        var newArr = [];
        for (var i = 0; i < arr.length; i++) {
            var obj = arr[i];
            obj[newKey] = obj[originalKey];
            delete (obj[originalKey]);
            newArr.push(obj);
        }
        return newArr;
    }

    function setFocusTbl() {
        var tabindex = 1;
        $('#tblSeviceDetail input, select, textarea').each(function () {
            if (this.type != "hidden") {
                var $input = $(this);
                $input.attr("tabindex", tabindex);
                tabindex++;
                $(this).focus(function () {
                    $(this).select();
                })
            }
        });

        $('input[name=QTY], input[name=PackagePrice], input[name=Disp], input[name=Disusd]').on('keydown', function (e) {
            if (e.which == 40) {
                var index = $('input[name=' + $(this).attr('name') + ']').index($(this));
                var THIS = $('input[name=' + $(this).attr('name') + ']');
                $(this).closest('tr').next().find('input[name=' + $(this).attr('name') + ']').focus().select();
                var scrollPosition = (THIS.eq(index).offset().top - 120);
                $(window).scrollTop(scrollPosition);
                delete e.which;
                return false;
            }
            if (e.which == 38) {
                var index = $('input[name=' + $(this).attr('name') + ']').index($(this));
                var THIS = $('input[name=' + $(this).attr('name') + ']');
                $(this).closest('tr').prev().find('input[name=' + $(this).attr('name') + ']').focus().select();
                var scrollPosition = (THIS.eq(index).offset().top - 200);
                $(window).scrollTop(scrollPosition);
                delete e.which;
                return false;
            }
        });

        $('input[name=QTY], input[name=PackagePrice], input[name=Disp], input[name=Disusd]').on('keypress', function (e) {
            if (e.which == 13) {
                var $next = $('[tabIndex=' + (+this.tabIndex + 1) + ']');
                $next.focus().select();
                e.preventDefault();
                delete e.which;
                return false;
            }
        });
    }

    function loadServicePlan(callback) {
        callback = (typeof callback == "undefined" ? "" : callback);
        LoadData('SaleOrder/LoadServicePlan', function (result) {
            var data = JSON.parse(result).data;
            data = JSON.parse(data);
            $("#ServicePlan").typeahead({
                hint: true,
                highlight: true,
                minLength: 0
            },
                {
                    limit: 9999,
                    display: "Name",
                    source: function (query, cb) {
                        var matches = [];
                        $.each(data, function (i, str) {
                            const value = str.ServiceName;
                            const globalRegex = new RegExp(query, '\ig');
                            if (globalRegex.test(value)) {
                                matches.push({ Name: str.ServiceName, ID: str.ServiceID });
                            }
                        });
                        cb(matches);
                    }
                }).bind("typeahead:selected", function (obj, data, name) {
                    ServicePlanID = data.ID;
                    $("#PackageName").val('');
                    LoadPackage(ServicePlanID);
                    $("input[name=ServiceID]").val(data.ID);
                    $("#ServicePlan").parent().css("border-bottom", "none");
                    $("#PackageName").parent(".wrap-input2").css("border-bottom", "1px solid #adadad");
                    $("#divPackageFeature").html('');
                    $("#PackageName").val('');

                });
            $("#ServicePlan").on("click", function () {
                $("#ServicePlan").typeahead("open");
            });
            if (callback != "") {
                return callback(data);
            }
        });
    }

