    function delRow(THIS) {
        var i = $(THIS).parent().parent().parent().next("tr[name=depositFee]").length;
        if (i == 1)
            $(THIS).parent().parent().parent().next("tr[name=depositFee]").remove();
        $(THIS).parent().parent().parent("tr").remove();

        if ($("table[name=tblSeviceDetail] tbody tr:last").length == 0) {
            $("table[name=tblSeviceDetail] tbody").append(tblrow);
            loadServicePlan();
            invTmp = "1";
            isoninvTmp = false;
        }
        tdNum();

        var kk = 0;
        $("input[name=ServiceID]").each(function () {
            if ($(this).val() != 0)
                kk++;
        });
        $("#enddate").parent().parent().show();
        $("#end_Date").show();
        if (kk > 1) {
            HaveServiceIDMoreThenOne = 2;
            $("#enddate").parent().parent().hide();
            $("#end_Date").hide();
        }
    }

    function DisP() {
        var DiscountUSD = 0;
        var Total = accounting.unformat($("label[name=Total]").html());
        var DiscountP = accounting.unformat($("input[name=TxtDisP]").val());
        DiscountUSD = ((Total * DiscountP) / 100);
        $("input[name=TxtDisUSD]").val(accounting.formatMoney(DiscountUSD, ''));
        Total = (Total - DiscountUSD);
        $("label[name=GrandTotal]").html(accounting.formatMoney(Total, ''));
    }

    function DisUSD() {
        var DiscountP = 0;
        var Total = accounting.unformat($("label[name=Total]").html());
        var DiscountUSD = accounting.unformat($("input[name=TxtDisUSD]").val());
        DiscountP = ((DiscountUSD / Total) * 100);
        $("input[name=TxtDisP]").val(accounting.formatMoney(DiscountP, ''));
        Total = (Total - DiscountUSD);
        $("label[name=GrandTotal]").html(accounting.formatMoney(Total, ''));
    }

