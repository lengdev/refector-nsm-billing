    function LoadCustomerGroup() {
        LoadData('SaleOrder/LoadCustomerGroup', function (result) {
            var odata = JSON.parse(result).data;
            odata = JSON.parse(odata);
            $("#CustomerGroup").typeahead({
                hint: true,
                highlight: true,
                minLength: 0
            },
                {
                    limit: 9999,
                    display: "Name",
                    source: function (query, cb) {
                        var matches = [];
                        $.each(odata, function (i, str) {
                            const value = str.CustomerGroup;
                            const globalRegex = new RegExp(query, '\ig');
                            if (globalRegex.test(value)) {
                                matches.push({ Name: str.CustomerGroup, ID: str.CustomerGroupID });
                            }
                        });
                        cb(matches);
                    }
                }).bind("typeahead:selected", function (obj, data, name) {
                    $("#CustomerGroupID").val(data.ID);
                });
            $("#CustomerGroup").on("click", function () {
                $("#CustomerGroup").typeahead("open");
                $("#CustomerGroup").select();
            });
        });
    }

