    function ExportExcel() {
        var table = document.getElementById("TableGride");
        if (!table) {
            alert("No Profit and Loss data is available to export.");
            return;
        }
        if (!window.XLSX || !XLSX.utils) {
            alert("Excel export is unavailable because the spreadsheet library did not load. Please refresh and try again.");
            return;
        }

        var headerRows = [
            [getProfitLossExportHeaderText($("#profit-loss-view-wrapper #lblCompanyNameKh").text(), "")],
            [getProfitLossExportHeaderText($("#profit-loss-view-wrapper #lblCompanyNameEn").text(), "")],
            [getProfitLossExportHeaderText($("#profit-loss-view-wrapper #lblReportTitle").text(), "Profit and Loss")],
            [$.trim($("#profit-loss-view-wrapper #lblDateRangeBar").text())],
            ["Print Date: " + kendo.toString(new Date(), "dd-MMM-yyyy HH:mm")]
        ];
        var tableSheet = XLSX.utils.table_to_sheet(table);
        var tableRows = XLSX.utils.sheet_to_json(tableSheet, { header: 1, raw: true });
        var tableRange = tableSheet["!ref"] ? XLSX.utils.decode_range(tableSheet["!ref"]) : { e: { c: 1 } };
        var columnCount = Math.max(1, tableRange.e.c + 1);
        var worksheet = XLSX.utils.aoa_to_sheet(headerRows.concat(tableRows));
        worksheet["!merges"] = headerRows.map(function (_, rowIndex) {
            return {
                s: { r: rowIndex, c: 0 },
                e: { r: rowIndex, c: columnCount - 1 }
            };
        });
        var headerStyles = [
            { alignment: { horizontal: "center", vertical: "center" }, font: { name: "Khmer OS Muol Light", sz: 16, bold: true } },
            { alignment: { horizontal: "center", vertical: "center" }, font: { name: "Times New Roman", sz: 14, bold: true } },
            { alignment: { horizontal: "center", vertical: "center" }, font: { name: "Arial", sz: 12, bold: true } },
            { alignment: { horizontal: "center", vertical: "center" }, font: { name: "Arial", sz: 10 } },
            { alignment: { horizontal: "center", vertical: "center" }, font: { name: "Arial", sz: 10 } }
        ];
        headerStyles.forEach(function (style, rowIndex) {
            var headerCell = worksheet[XLSX.utils.encode_cell({ r: rowIndex, c: 0 })];
            if (headerCell) headerCell.s = style;
        });
        (tableSheet["!merges"] || []).forEach(function (merge) {
            worksheet["!merges"].push({
                s: { r: merge.s.r + headerRows.length, c: merge.s.c },
                e: { r: merge.e.r + headerRows.length, c: merge.e.c }
            });
        });
        worksheet["!cols"] = Array.from({ length: columnCount }, function (_, columnIndex) {
            return { wch: columnIndex === 0 ? 54 : 18 };
        });
        worksheet["!rows"] = [{ hpt: 30 }, { hpt: 24 }, { hpt: 22 }, { hpt: 20 }, { hpt: 20 }];

        var workbook = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(workbook, worksheet, "Profit And Loss");
        XLSX.writeFile(workbook, "ProfitAndLoss.xlsx");
    }

    function getProfitLossExportHeaderText(value, fallback) {
        value = $.trim(value || "");
        return !value || /^(unknown|undefined|null)$/i.test(value) ? fallback : value;
    }

