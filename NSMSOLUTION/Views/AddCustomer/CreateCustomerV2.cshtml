@{
Layout = null;
}
@Html.Raw(ViewBag.DrawHTMLFormV1)

<style>
  .SetCID {
    outline: none;
    border: none;
    padding: 5px 8px;
    border-radius: 0.75rem;
  }

  div[id*="divFrm_"] .row .col-auto {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .ivTypeOfInvoice {
    margin: 14px 0;
  }

  .agency-clone {
    margin: 12px 0;
    border: 1px dashed #ccc;
    padding: 5px 0;
  }

  .agency-clone .select2-selection {
    border: none !important;
  }

  .agency-clone .select2-selection ul {
    border-bottom: 1px solid #adadad !important;
  }

  [name="GrandTotal"] {
    color: dodgerblue;
    font-weight: 600 !important;
  }

  .div-contract {
    border: 1px dashed #ccc;
    padding: 10px;
    display: flex;
    gap: 10px;
    flex-direction: column;
  }

  .div-contract .wrap-input3 input {
    border-bottom: 1px solid #ccc;
  }

  .div-contract .ti {
    font-size: 18px;
    margin-right: 4px;
  }

  .div-contract {
    background: #fff5f5;
  }

  body.dark-mode .div-contract {
    background: transparent !important;
  }

  .DivSetCID label {
    margin-bottom: 0;
  }

  .type-of-invoice {
    margin: 1.5rem 0;
  }
</style>

<script defer>
  var _mapInitializing = false;
  var _mapReady = false;
  var _isUpdatingMap = false;
  var _lastGeocodedLat = null;
  var _lastGeocodedLng = null;
  var formType = '@ViewBag.FormType' || '';
  var isEditCustomer = '@ViewBag.IsEdit' === 'True' ? true : false;
  var isToInvoice = '@ViewBag.IsToInvoice' === 'True' ? true : false;
  var isRenew = '@ViewBag.IsRenew' === 'True' ? true : false;
  var isChangePlan = '@ViewBag.IsChangePlan' === 'True' ? true : false;
  var customerId = parseInt('@ViewBag.CustomerID') || 0;
  var domainId = localStorage.getItem('DomainID');

  $(function () {
    onModalShow(customerId, formType, function () {
      $('#IdentificationExpireDate').daterangepicker({
        singleDatePicker: true,
        autoApply: true,
        autoUpdateInput: false,
        showDropdowns: true,
        locale: { format: 'DD/MM/YYYY' }
      }).on('apply.daterangepicker', function (ev, picker) {
        $(this).val(picker.startDate.format('DD/MM/YYYY'));
      });

      if (formType) {
        hiddenInput(formType);
        $('<input>', {
          type: 'hidden',
          name: 'FormType',
          value: formType
        }).appendTo('form[name="Frm"]');
      }

      if (!customerId && !isEditCustomer) {
        $('#SetCID').trigger('change');
        return;
      }

      if (customerId && formType === 'NewRegister') {
        EditCustomer(customerId, function () {
          fillEditData(customerId);
        });
      } else {
        fillEditData(customerId, formType);
      }


      const _origGeocode = google.maps.Geocoder.prototype.geocode;
      const _cache = {};
      google.maps.Geocoder.prototype.geocode = function (request, callback) {
        const key = JSON.stringify(request);
        if (_cache[key]) {
          callback(_cache[key], google.maps.GeocoderStatus.OK);
          return;
        }
        _origGeocode.call(this, request, function (results, status) {
          if (status === google.maps.GeocoderStatus.OK) _cache[key] = results;
          callback(results, status);
        });
      };
    });
  });


  function toggleHeaderTitle() {
    const targets = $('.form-content div[id^="divFrm_"]');

    targets.each(function (index) {
      const lastIndex = targets.length - 1;
      const agencyIndex = lastIndex - 1;
      const $container = $(this);
      const $header = $container.children('div:first');
      const $headerSec = $container.children('div:nth-child(2)');
      const $rest = $container.children('div:not(:first)');
      const $titleSpan = $header.find('span.card-title').first();
      const $titleSpanSec = $header.find('span.card-title').first();

      if ($titleSpan.length === 0 || $titleSpan.next('.ti').length) return;

      const $icon = $('<i class="ti ms-2" style="cursor:pointer; font-size: 20px;"></i>');

      if (index === 0) {
        $rest.show();
        //$icon.addClass('ti-chevrons-up');
        const noneOption = domainId === '001'
          ? `<option value="None VAT">None</option>`
          : '';

        const saveAs = `
                    <div id="DivSetCID" class="d-flex align-items-center justify-content-center DivSetCID" style="margin-left:25px; padding: 0.2rem !important;">
                        <label for="SetCID">Save as to:</label>
                        <select name="SetCID" id="SetCID" class="SetCID">
                            ${noneOption}
                            <option value="VAT">TAX</option>
                            <option value="CM">CM</option>
                        </select>
                        <input type="hidden" name="IsIncludedVAT" id="IsIncludedVAT" value="false"/>
                    </div>`;
        $titleSpan.after($icon);
        $icon.after(saveAs);

        $("#SetCID").addClass("form-control select2");
        $("#SetCID").select2({
          dropdownParent: $("#SetCID").parent(),
          theme: 'bootstrap4',
          minimumResultsForSearch: Infinity,
          placeholder: ""
        });
        $('#SetCID').next('.select2-container').css({
          width: '110px',
          marginLeft: '10px'
        });

      } else if (index === lastIndex) {
        $rest.show();
        $icon.addClass('ti-chevrons-up');
        $titleSpan.after($icon);
      } else {
        index == 1 ? $rest.show() : $rest.hide();
        index == 1 ? $icon.addClass('ti-chevrons-up') : $icon.addClass('ti-chevrons-down');
        if (typeof agencyIndex !== 'undefined' && index === agencyIndex) {
          const btnAddAgency = `
                    <button type="button" id="btnAddNewAgency" class="btn btn-info btn-sm ml-2 d-none">
                        <i class="ti ti-library-plus"></i> Add New Agency
                    </button>`;
          $titleSpan.after($icon);
          $icon.after(btnAddAgency);
          addNewAgency();
        } else {
          $titleSpan.after($icon);
        }
      }

      $header.off('click.toggle').on('click.toggle', function (e) {
        const $target = $(e.target);
        const $targetEl = $target.is('input, select, textarea, button');
        const $select2Len = $target.closest('.select2-container').length;
        const $newAgencyBtn = $target.closest('#btnAddNewAgency').length;

        if ($targetEl || $select2Len || $newAgencyBtn || index == 0) {
          return;
        }

        $rest.stop(true, true).slideToggle(200, function () {
          if (typeof agencyIndex !== 'undefined' && index === agencyIndex) {
            $('#btnAddNewAgency, #btnClearAgency').toggleClass('d-none');
          }
        });
        $icon.toggleClass('ti-chevrons-down ti-chevrons-up');
      });
    });
  }

  // ── Main map loader ────────────────────────────────────────────
  function loadGoogleMap(lat = 0, lng = 0) {
    if (!navigator.geolocation) return;

    const $mapEl = $('#GoogleMap_Longitude_CurrentLocation');

    // Already initialized → just move pin (no re-geocode if same coords)
    if (_mapReady && $mapEl.data('locationpicker')) {
      if (lat !== 0 && lng !== 0) {
        const current = $mapEl.locationpicker('location');
        // ✅ Skip if coordinates haven't actually changed
        if (current.latitude === lat && current.longitude === lng) return;

        _isUpdatingMap = true;
        $mapEl.locationpicker('location', { latitude: lat, longitude: lng });
        setTimeout(() => { _isUpdatingMap = false; }, 600);
      }
      return;
    }

    if (_mapInitializing) return;
    _mapInitializing = true;

    const doInit = (lat_cust, lng_cust) => {
      $mapEl.locationpicker({
        location: { latitude: lat_cust, longitude: lng_cust },
        radius: 10,
        zoom: 18,
        scrollwheel: false,
        // ✅ Keep autocomplete for address search but bind inputs manually
        enableAutocomplete: true,
        inputBinding: {
          latitudeInput: $('#GoogleMap_Latitude'),
          longitudeInput: $('#GoogleMap_Longitude'),
          locationNameInput: $('#GoogleMap_FullAddress')
        },
        onchanged: function (currentLocation) {
          // ✅ Get the formatted address FIRST, before any guard
          const map = $(this).locationpicker('map');
          const formatted = map?.location?.formattedAddress || '';

          // ✅ Always update the address field regardless of flag
          if (formatted) {
            $('#GoogleMap_FullAddress').val(formatted);
          }

          // ✅ Now update the GoogleMap object
          if (typeof GoogleMap !== 'undefined') {
            GoogleMap.GoogleMap_FullAddress = formatted;
            GoogleMap.GoogleMap_Latitude = currentLocation.latitude;
            GoogleMap.GoogleMap_Longitude = currentLocation.longitude;
          }

          // ✅ Only block the loop feedback (not the address fill)
          if (_isUpdatingMap) return;

          _isUpdatingMap = true;
          setTimeout(() => { _isUpdatingMap = false; }, 600);
        },
      });

      _mapReady = true;
      //attachLatLngChangeListener();

      if (lat_cust !== 11.5564 && lng_cust !== 104.9282) { // skip fallback default
        setTimeout(() => {
          fillAddressFromLatLng(lat_cust, lng_cust);
        }, 800);
      }

      function fillAddressFromLatLng(lat, lng) {
        // Don't call if address already filled
        if ($('#GoogleMap_FullAddress').length > 0 && ($('#GoogleMap_FullAddress').val() || '').trim() !== '') return;

        const geocoder = new google.maps.Geocoder();
        const latlng = { lat: parseFloat(lat), lng: parseFloat(lng) };

        geocoder.geocode({ location: latlng }, function (results, status) {
          if (status === google.maps.GeocoderStatus.OK && results[0]) {
            const address = results[0].formatted_address;
            $('#GoogleMap_FullAddress').val(address);

            if (typeof GoogleMap !== 'undefined') {
              GoogleMap.GoogleMap_FullAddress = address;
            }
          }
        });
      }
    };

    navigator.geolocation.getCurrentPosition(
      function (position) {
        let lat_cust = lat || parseFloat($('#GoogleMap_Latitude').val()) || position.coords.latitude;
        let lng_cust = lng || parseFloat($('#GoogleMap_Longitude').val()) || position.coords.longitude;

        if (lat === 0 && lng === 0 && typeof GoogleMap !== 'undefined' && GoogleMap.GoogleMap_FullAddress) {
          lat_cust = GoogleMap.GoogleMap_Latitude;
          lng_cust = GoogleMap.GoogleMap_Longitude;
        }
        doInit(lat_cust, lng_cust);
      },
      function () {
        doInit(11.5179, 104.9341); // Fallback: Phnom Penh
      }
    );
  }

  function attachLatLngChangeListener() {
    let typingTimer;

    $('#GoogleMap_Latitude, #GoogleMap_Longitude')
      .off('change.mapUpdate keyup.mapUpdate')
      .on('change.mapUpdate keyup.mapUpdate', function () {

        // ✅ Ignore programmatic updates from locationpicker itself
        if (_isUpdatingMap) return;

        clearTimeout(typingTimer);
        typingTimer = setTimeout(function () {
          const lat = parseFloat($('#GoogleMap_Latitude').val()) || 0;
          const lng = parseFloat($('#GoogleMap_Longitude').val()) || 0;

          if (lat === 0 || lng === 0) return;

          const $mapEl = $('#GoogleMap_Longitude_CurrentLocation');

          // ✅ Skip if coords haven't actually changed
          if (_lastGeocodedLat === lat && _lastGeocodedLng === lng) return;

          if ($mapEl.data('locationpicker')) {
            // Move the pin
            _isUpdatingMap = true;
            $mapEl.locationpicker('location', { latitude: lat, longitude: lng });
            setTimeout(() => { _isUpdatingMap = false; }, 600);
          }

          // ✅ Force a fresh geocode — clear cache so address updates
          _lastGeocodedLat = null;
          _lastGeocodedLng = null;
          $('#GoogleMap_FullAddress').val(''); // clear stale address

          const geocoder = new google.maps.Geocoder();
          geocoder.geocode(
            { location: { lat: lat, lng: lng } },
            function (results, status) {
              if (status === google.maps.GeocoderStatus.OK && results[0]) {
                const address = results[0].formatted_address;

                _lastGeocodedLat = lat;
                _lastGeocodedLng = lng;

                $('#GoogleMap_FullAddress').val(address);

                if (typeof GoogleMap !== 'undefined') {
                  GoogleMap.GoogleMap_FullAddress = address;
                  GoogleMap.GoogleMap_Latitude = lat;
                  GoogleMap.GoogleMap_Longitude = lng;
                }
              }
            }
          );

        }, 800); // ← wait 800ms after user stops typing
      });
  }

  function previewMap() {
    if ($('#map-eye-icon').length) return;

    const $icon = $('<i id="map-eye-icon" class="ti ti-eye" data-toggle="tooltip" title="Preview Location."></i>');
    $icon.css({
      fontSize: '18px',
      position: 'absolute',
      right: '10px',
      top: '50%',
      transform: 'translateY(-50%)',
      cursor: 'pointer',
      color: 'blue'
    });

    const $wrapper = $('#GoogleMap_FullAddress').closest('.wrap-input2');
    $wrapper.css('position', 'relative').append($icon);

    $icon.on('click', function () {
      const lat = parseFloat($('#GoogleMap_Latitude').val()) || 0;
      const lng = parseFloat($('#GoogleMap_Longitude').val()) || 0;
      let url = "AddCustomer/SetCustomerLocationByGoogleMap";
      if (lat !== 0 && lng !== 0) url += `?lat=${lat}&lng=${lng}`;
      MarkerMap('GoogleMap_FullAddress', 'GoogleMap_Latitude', 'GoogleMap_Longitude', url);
    });
  }

  function addNewAgency() {
    $('#btnAddNewAgency').on('click', function (e, data) {
      const $container = $('#AgencyCommission');

      const cloneCount = $('.agency-clone').length;
      if (cloneCount >= 1) return;

      const $original = $container.children('div').not('.agency-clone');
      const isEdit = data?.isEdit === true;
      if (!$original.length) return;

      const rand = Math.floor(Math.random() * 100000);
      const $clone = $original.clone(false, false);

      $clone.find('input, textarea').val('');
      $clone.find('select').val(null).trigger('change');

      const $select = $clone.find('.select2-hidden-accessible');
      if ($select.length) {
        const newId = `${$select.attr('id')}-${rand}`;
        $clone.find('.select2-container').remove();
        $select.removeClass('select2-hidden-accessible').removeAttr('data-select2-id').attr('id', newId);
        $select.find('option').removeAttr('data-select2-id');
      }

      const $wrapper = $('<div class="agency-clone"></div>').append($clone);
      $wrapper.append('<button type="button" class="btn btn-danger btnRemoveAgency ml-2"><i class="ti ti-trash"></i> Remove</button>');
      $container.append($wrapper);

      handleCommissionType(rand);

      const newCount = $('.agency-clone').length;
      const hidden = isEdit ? 'd-none' : '';
      if ($('#btnClearAgency').length === 0) {
        $(this).after(`<button type="button" id="btnClearAgency" class="btn btn-sm btn-danger ml-2 ${hidden}"><i class="ti ti-x"></i> Clear (${newCount})</button>`);
      } else {
        $('#btnClearAgency').html(`<i class="ti ti-x"></i> Clear (${cloneCount})`);
      }
    });

    $(document).on('click', '.btnRemoveAgency', function () {
      $(this).closest('.agency-clone').remove();
      const cloneCount = $('.agency-clone').length;
      if (cloneCount === 0) $('#btnClearAgency').remove();
      else $('#btnClearAgency').html(`<i class="ti ti-x"></i> Clear (${cloneCount})`);
    });

    $(document).on('click', '#btnClearAgency', function (e) {
      e.preventDefault();
      e.stopPropagation();
      $('.agency-clone').remove();
      $(this).remove();
    });
  }

  function handleCommissionType(rnd) {
    const objData = [{ id: 1, text: 'Once Time' }, { id: 2, text: 'On Package' }];
    const $el = $(`#AgencyCommissionType-${rnd}`);
    if (!$el.length) return;

    if ($el.hasClass("select2-hidden-accessible")) $el.select2('destroy');

    $el.select2({
      theme: "bootstrap4",
      placeholder: "Enter Commission Type",
      allowClear: true,
      multiple: true,
      width: '100%',
      data: objData,
      dropdownParent: $el.closest('.agency-section, .agency-clone, body'),
      escapeMarkup: m => m
    });
    $el.on('select2:select', function (e) {
      // If a new item is selected, keep only the most recent one
      const latestValue = e.params.data.id;
      $(this).val([latestValue]).trigger('change');
    });
  }

  function getTermCondition(type) {
    LoadData(`AddCustomer/LoadCompanyLogo`, function (res) {
      const jsonData = JSON.parse(res.data);
      if (jsonData.length == 0) return;
      const resData = jsonData[0];
      const finalTerm = (type === 'VAT' || type === 'CM') ? decode(resData.TermConditionVAT) : decode(resData.TermConditionNonVAT);
      $('textarea[name="TermsConditions"]').val(finalTerm);
    }, false, "json");
  }

  function handleTypeOfInvoice() {

    const invoiceTypes = [
      { id: 'ExcludedVAT', label: 'Excluded VAT', dataValue: 'None VAT', value: true, isChecked: domainId === '001' },
      { id: 'IncludedVAT', label: 'Included VAT', dataValue: 'VAT', value: false, isChecked: domainId !== '001' },
      { id: 'CommercialINV', label: 'Commercial Inv.', dataValue: 'CM', value: false, isChecked: false }
    ];

    const visibleTypes = invoiceTypes.filter(i => domainId === '001' || i.id !== 'ExcludedVAT');

    let divInvoiceType = `<div class="row type-of-invoice divTypeOfInvoice" id="divTypeOfInvoice">`;

    $.each(visibleTypes, function (index, item) {
      divInvoiceType += `
            <div class="col-auto">
                <div class="icheck-material-cyan icheck-inline">
                    <input type="checkbox" name="TypeOfInvoice" id="${item.id}" data-value="${item.dataValue}" value="${item.value}" ${item.isChecked ? 'checked' : ''}>
                    <label for="${item.id}">${item.label}</label>
                </div>
            </div>`;
    });

    divInvoiceType += `<input type="hidden" id="VATRate" name="VATRate" value="0">`;

    divInvoiceType += `
        <div class="col-auto">
            <div class="form-group pt-1">
                <div class="custom-control custom-switch">
                    <input type="checkbox" class="custom-control-input" id="isNextInvoice">
                    <label class="custom-control-label d-none" for="isNextInvoice">Is Next Invoice</label>
                </div>
            </div>
        </div></div>`;

    $('.modal tfoot > tr > td').first().prepend(divInvoiceType);

    $('input[name="TypeOfInvoice"]').on('change', function () {

      $('input[name="TypeOfInvoice"]').not(this).prop('checked', false).val(false);
      const isChecked = this.checked;
      const dataValue = $(this).data('value');

      $(this).prop('checked', isChecked).val(isChecked);
      if (isChecked) {
        $('#SetCID').val(dataValue).trigger('change');

        const isVAT = dataValue === "VAT";
        const isCM = dataValue === "CM";

        $('#VATRate').attr('value', !isVAT ? 0 : 10);
        $('#IsIncludedVAT').val(isVAT || isCM);
      }
      calculateTotals();
    });
  }

  function handleChangeSaveAs(customerId, formType) {
    let isSyncingSetCID = false;
    const isEdit = !!customerId;
    let dataEdit;
    let invoiceNo;
    let custType;

    if (isEditCustomer) {
      if (window.App?.CustomerInfo !== undefined) {
        dataEdit = normalizeCustomerData(window.App?.CustomerInfo);
        invoiceNo = dataEdit.Invoice?.[0]?.InvoiceNo || "";
        custType = dataEdit.BillInfo?.SetCID || "";
      }
    }

    $('#SetCID').on('change', function () {

      if (isSyncingSetCID) return;

      const val = $(this).val();
      $('input[name="TypeOfInvoice"]').each(function () {
        const dataValue = $(this).data('value');
        const match = dataValue === val;
        $(this).prop('checked', match).val(match);
        if (match) {
          const isVAT = dataValue === "VAT";
          const isCM = dataValue === "CM";

          $('#VATRate').attr('value', !isVAT ? 0 : 10);
          $('#IsIncludedVAT').val(isVAT || isCM);

          //handle class trigger change
          const classValue = isVAT || isCM ? 'NSM' : 'NSM ISP';

          $('#ClassName')
            .typeahead('val', classValue)
            .trigger('typeahead:select', {
              value: classValue
            });

          const shouldLoad = !isEditCustomer || (isEditCustomer && formType == 'Invoice') || formType == 'Quotation' || isToInvoice || isRenew || isChangePlan;

          if (shouldLoad) {
            LoadData(`AddCustomer/LoadInvoicePrefix?formType=${formType}&invoiceType=${dataValue}`, function (response) {
              const res = JSON.parse(response.data);

              if (res.length === 0) return;

              setTimeout(function () {
                $('#InvoiceNo').val(res[0].PrefixNumber);
                $('#PrefixInvoice').val(res[0].Prefix);
              }, 100);

              if (custType === dataValue || (custType === "CM" && dataValue === "VAT")) {
                setTimeout(function () {
                  if (invoiceNo && isEditCustomer) {
                    $('#InvoiceNo').val(invoiceNo);
                  }
                }, 100);
              }
            }, false, "json");
          }
        }
      });
      $('#ClassName')
        .off('typeahead:select.setCID')
        .on('typeahead:select.setCID', function (e, item) {

          if (!item) return;

          let setCID = '';

          if (item.Name === 'NSM') {
            setCID = 'VAT';
          } else if (item.Name === 'NSM ISP') {
            setCID = 'None VAT';
          }

          if (setCID && !isSyncingSetCID) {
            isSyncingSetCID = true;

            $('#SetCID')
              .val(setCID)
              .trigger('change');

            isSyncingSetCID = false;
          }
        });
      getTermCondition(val);
      calculateTotals();
    });
  }

  function swapNoteAndTerm() {
    const note = $('textarea[name="Customer_Notes"]').closest('.row');
    const term = $('textarea[name="TermsConditions"]').closest('.row');
    const temp = $('<div>').insertBefore(note);
    note.insertBefore(term);
    term.insertBefore(temp);
    temp.remove();
  }

  function handleItemDescrition() {
    const spDivHtml = `
        <div class="divServicePlan" style="display: none; margin-top: 5px; border: 1px dashed #ccc; padding: 10px;">
            <div class="${isChangePlan ? `d-block` : `d-none`}">
                <div class="row">
                    <small class="badge badge-sm badge-primary" style="font-size:9px;">Current Plan</small>
                </div>
                <div class="row">
                    <label class="col-form-label">ឈ្មោះសេវាកម្មកំពុងប្រើ/Using Service Plan:</label>
                    <div class="col wrap-input4 d-inline-block">
                        <input type="text" id="OldServicePlan" class="input2 ServicePlan" name="OldServicePlan" readonly>
                        <input type="hidden" id="OldServiceID" class="input2 ServiceID" name="OldServiceID">
                    </div>
                </div>
                <div class="row">
                    <label class="col-form-label">កញ្ចប់សេវាកម្មកំពុងប្រើ/Using Package Name:</label>
                    <div class="col wrap-input4 d-inline-block">
                        <input type="text" id="OldPackageName" class="input2 PackageName" name="OldPackageName" readonly>
                        <input type="hidden" id="OldPackageID" class="input2 PackageID" name="OldPackageID">
                    </div>
                </div>
                <div class="row">
                    <div class="col wrap-input4 d-inline-block">
                        Start Date: <span id="old-start-date" class="text-danger"></span>&nbsp;&nbsp;
                        End Date: <span id="old-end-date" class="text-danger"></span>&nbsp;&nbsp;
                        Remain: <span id="remain-day-usage" class="text-danger"></span>
                    </div>
                </div>
                <div class="row mt-2">
                    <small class="badge badge-sm badge-danger" style="font-size:9px;">Change To</small>
                </div>
            </div>
            <div class="row">
                <label class="col-form-label">ឈ្មោះសេវាកម្ម/Service Plan:</label>
                <div class="col wrap-input4 d-inline-block" data-validate="Service Plan is required">
                    <input type="text" id="ServicePlan" class="input2 ServicePlan" name="ServicePlan">
                    <input type="hidden" id="ServiceID" class="input2 ServiceID" name="ServiceID">
                </div>
            </div>
            <div class="row">
