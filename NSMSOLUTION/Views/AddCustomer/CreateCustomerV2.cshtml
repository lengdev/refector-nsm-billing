        CompanyCommune: formObj.CompanyCommune || '',
        CompanyDistrict: formObj.CompanyDistrict || '',
        CompanyProvinceCity: formObj.CompanyProvinceCity || '',
        CompanyContactName: formObj.CompanyContactName || '',
        CompanyContactPosition: formObj.CompanyContactPosition || '',
        CompanyContactMobileNumber: formObj.CompanyContactMobileNumber || '',

        BillToAddress: formObj.BillToAddress || '',
        BillToCommune: formObj.BillToCommune || '',
        BillToDistrict: formObj.BillToDistrict || '',
        BillToProvinceCity: formObj.BillToProvinceCity || '',

        InstallAddress: formObj.InstallAddress || '',
        InstallCommune: formObj.InstallCommune || '',
        InstallDistrict: formObj.InstallDistrict || '',
        InstallProvinceCity: formObj.InstallProvinceCity || '',

        GoogleMap_FullAddress: formObj.GoogleMap_FullAddress || '',
        GoogleMap_Latitude: formObj.GoogleMap_Latitude || '',
        GoogleMap_Longitude: formObj.GoogleMap_Longitude || '',

        IsIncludedVAT: formObj.IsIncludedVAT === true ||
          formObj.IsIncludedVAT === 'true',
        TermCondition: formObj.TermsConditions || ''
      }
    };
  }

  function SaveChangeCustomer() {

    const formElement = document.querySelector('form[name="Frm"]');

    // Normal object (for building complex structure)
    let formObj = $('form[name="Frm"]').serializeObject();

    // FormData (for file upload + normal inputs)
    let formData = new FormData(formElement);

    let oc = [];
    let sp = [];
    let cm = [];
    let amt = [];

    // Validate attachment file
    let custId = parseInt($('#CustomerName_CustomerID').val()) || 0;
    const custAutoId = parseInt($('#CustomerName_AUTOFill').val()) || 0;
    const serviceId = parseInt($('#ServiceID').val()) || 0;
    if (custAutoId !== 0) {
      custId = 0;
    }
    if (serviceId !== 0) {
      const $custAtt = $('input[name="CustomerAttFiles"]');
      const fileLen = $custAtt.length > 0 ? $custAtt[0].files.length : null;

      if (fileLen === 0) {
        DialogSweetAlert("warning", "Please Add Attachment File");
        return;
      }
    }

    // ===============================
    // TOTAL AMOUNT
    // ===============================

    const subtotal = $('label[name="SubTotal"]').text() || 0;
    const total = $('label[name="Total"]').text() || 0;
    const grandTotal = $('input[name="GrandTotal"]').val() || 0;

    amt.push({
      Subtotal: subtotal,
      TotalDiscountP: formObj.TxtDisP || 0,
      TotalDiscountUSD: formObj.TxtDisUSD || 0,
      Total: total,
      GrandTotal: grandTotal,
      VAT: formObj.VAT || 0
    });

    formObj.InvoiceTotalAmount = amt;

    // ===============================
    // SERVICE PLAN & OTHER CHARGE
    // ===============================

    $('#TableItemInformation tbody tr').each(function () {

      const row = $(this);

      let rowData = {
        UM: row.find('[name^="UM"]').val() || '',
        QTY: row.find('[name^="QTY"]').val() || '0',
        UnitPrice: row.find('[name^="UnitPrice"]').val() || '0.00',
        DisP: row.find('[name^="DisP"]').val() || '0',
        DisUSD: row.find('[name^="DisUSD"]').val() || '0.00',
        Amount: row.find('[name^="Amount"]').val() || '0.00'
      };

      let servicePlan = row.find('[name="ServicePlan"]').val();
      let otherCharge = row.find('[name^="OtherCharge"]').val();

      if (servicePlan && servicePlan.trim() !== "") {

        sp.push({
          ServicePlan: servicePlan,
          ServiceID: row.find('[name="ServiceID"]').val(),
          PackageID: row.find('[name="PackageID"]').val() || 0,
          PackageName: row.find('[name="PackageName"]').val() || '',
          PackageDetailID: row.find('[name="PackageDetailID"]').val() || 0,
          DownSpeed: row.find('[name="DownSpeed"]').val() || 0,
          UpSpeed: row.find('[name="UpSpeed"]').val() || 0,
          Bandwidth: row.find('[name="Bandwidth"]').val() || 0,
          Feature: row.find('[name="Feature"]').val() || '',
          Duration: row.find('[name="Duration"]').val() || 0,
          PID: row.find('[name="PID"]').val() || 0,
          ChartOfAccountID: row.find('[name="ChartOfAccountID"]').val() || 0,
          ...rowData
        });

      } else if (otherCharge && otherCharge.trim() !== "") {

        oc.push({
          OtherCharge: otherCharge,
          OtherChargeID: row.find('[name^="OtherCharge_OtherChargeID"]').val(),
          ItemID: row.find('[name^="ItemID"]').val(),
          CustomerInvoiceID: row.find('[name^="CustomerInvoiceID"]').val(),
          ServiceID: row.find('[name^="ServiceID"]').val(),
          ...rowData
        });
      }
    });

    // 1. Handle the "Main" block (the first two .p-2 divs)
    const $mainBlock = $('#AgencyCommission > .p-2').slice(0, 2);
    if ($mainBlock.length > 0) {
      extractData($mainBlock, cm);
    }

    // 2. Handle all "Clone" blocks
    $('#AgencyCommission .agency-clone').each(function () {
      extractData($(this), cm);
    });

    // Helper function to pull data from a specific scope
    function extractData(container, targetArray) {

      let type = container.find('select[name*="AgencyCommissionType"]').val();
      let amountUSD = container.find('input[name="CommissionAmountUSD"]').val();
      let amountP = container.find('input[name="CommissionAmountP"]').val();
      let memo = container.find('input[name="Memo"]').val();

      // Only push if there's actual data
      if (
        (type && type.length > 0) ||
        (memo && memo.trim() !== "") ||
        (amountUSD !== "0" && amountUSD !== "")
      ) {
        targetArray.push({
          CommissionTypeID: type ? type.toString() : "",
          CommissionAmountUSD: amountUSD || "0",
          CommissionAmountP: amountP || "0",
          Memo: memo || ""
        });
      }
    }

    formObj.CustomerServicePlan = sp;
    formObj.CustomerOtherCharge = oc;
    formObj.AgencyCommissionType = cm;

    const keysToClean = ['OtherCharge', 'ServicePlan', 'PackageName', 'UM', 'QTY', 'UnitPrice', 'DisP', 'DisUSD', 'Amount', 'Memo', 'CommisionTypeID', 'CommissionAmountUSD', 'CommissionAmountP', 'VAT', 'TxtDisUSD', 'TxtDisP', 'OtherCharge_OtherChargeID', 'PackageDetailID', 'PID', 'PackageID', 'DownSpeed', 'UpSpeed', 'Bandwidth', 'ChartOfAccountID', 'Feature'];
    keysToClean.forEach(key => {
      delete formObj[key];
      delete formObj[key + '[]'];
    });

    // --- FIX: MANUALLY APPEND FILES ---
    const fileInput = document.getElementById('CustomerAttFiles');
    if (fileInput && fileInput.files.length > 0) {
      // Clear any existing entries for this name to prevent duplicates
      formData.delete("CustomerAttFiles");

      for (let i = 0; i < fileInput.files.length; i++) {
        formData.append("CustomerAttFiles", fileInput.files[i]);
      }
    }

    const customerInvID = $("#CustomerName_CustomerInvoiceID").val();
    const customerBillInvID = $("#CustomerName_BillingInvoiceID").val();
    const customerBillInfoID = $("#CustomerName_CustomerBillInformationID").val();

    formObj.CustomerInvoiceID = customerInvID;
    formObj.BillingInvoiceID = customerBillInvID;
    formObj.CustomerBillInformationID = customerBillInfoID;
    formObj.IsEdit = isEditCustomer;
    formObj.IsToInvoice = isToInvoice;
    formObj.IsRenew = isRenew;
    formObj.IsChangePlan = isChangePlan;

    // Posting data
    if (formType === 'NewRegister') {
      const registerData = buildCustomerRegisterData(formObj);

      PostData(
        'api/Customer/Register',
        registerData,
        function (response) {
          if (response.success) {
            if ($('.btnclose').length) $('.btnclose').click();
            if ($('#BunSearch').length) $('#BunSearch').click();
            DialogSweetAlert('success', response.message);
          } else {
            DialogSweetAlert('error', response.message);
          }
        },
        true,
        true,
        'json',
        true
      );

      return;
    }

    if (formType !== 'Quotation') {
      approval(formData, formObj);
    } else {
      formData.append("data", JSON.stringify(formObj));
      submitForm(formData);
    }
  }

  function submitForm(formData) {
    const objData = JSON.parse(formData.get("data"));
    const userCheck = objData && objData.RequestCheckByName;
    const userCheckId = objData && objData.RequestCheckByNameID;
    const userApproveId = objData && objData.RequestApprovalNameID;
    const customerGroup = objData && objData.CustomerGroup;
    // console.log(objData);
    // return;
    PostData(
      `AddCustomer/SaveChangeCustomerV2`,
      formData,
      function (response) {
        const res = JSON.parse(response);
        if (res.success) {
          if (formType == "NewRegister") {
            PostData('AddCustomer/GenerateCustomerTelegramContact',
              { data: JSON.stringify(res.data) }
            );
            return;
          };

          if (customerGroup === 'VIP') return;

          PostData('AddCustomer/SentNotification',
            {
              data: JSON.stringify(
                {
                  ...res.data,
                  NeedByCheck: userCheck,
                  NeedByCheckID: userCheckId,
                  NeedByApproveID: userApproveId
                }
              )
            }, (res) => {
              console.log(res)
              if (!res.success) {
                DialogSweetAlert('error', res.message);
                return;
              }

              if ($('.btnclose').length) $('.btnclose').click();
              if ($('#BunSearch').length) $('#BunSearch').click();
              DialogSweetAlert('success', res.message);

              if (isRenew || isChangePlan || isToInvoice) {
                setTimeout(function () {
                  location.reload();
                }, 1000);
              }
            }, true, false, 'json'
          );

          if (formType === 'Invoice') {
            PostData('AddCustomer/HandleTicketMessage',
              { data: JSON.stringify(res.data.LastInvoiceData) }
            );
          }
        } else {
          DialogSweetAlert('error', res.message);
        }
      },
      true,
      true,
    );
  }


</script>
