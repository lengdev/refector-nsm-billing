  function hanldeDescTypeaheadSelected() {
    // 1. Standard Other Charge Selection
    $(document).off('typeahead:select', 'input[name="OtherCharge"]')
      .on('typeahead:select', 'input[name="OtherCharge"]', function () {
        const $currentRow = $(this).closest('tr');
        formatPrice($currentRow);

        const isSP = $currentRow.find('.input-delete').attr('data-serivce-plan') === 'true';

        if ($currentRow.is(':last-child')) {
          createNewRow($currentRow, `${isSP ? 'SP' : 'OC'}`);
        }

        !isSP && otherChargeInvDate();
      });

    // 2. Service Plan Selection/Change
    $(document).off('typeahead:select', '#ServicePlan')
      .on('typeahead:select', '#ServicePlan', function () {
        $('#PackageFeature').empty();
        $('#divContract').remove();
        const $row = $(this).closest('tr');
        $row.find('input[name="PackageName"]').typeahead('val', '');
        const serviceId = $row.find('input[name="ServiceID"]').val();
        if (serviceId) {
          loadPackage(serviceId);
        };
      });

    // 3. Package Selection (Service Plan flow)
    $(document).off('typeahead:select', 'input[name="PackageName"]')
      .on('typeahead:select', 'input[name="PackageName"]', function (e) {

        $('#PackageFeature').empty();

        const $currentRow = $(this).closest('tr');
        const serviceId = $currentRow.find('input[name="ServiceID"]').val();
        const packageDetailID = $currentRow
          .find('input[name="PackageDetailID"]')
          .val();

        if (!packageDetailID) return;

        const curPackage = window.packageData
          .find(x => x.PackageDetailID == packageDetailID);

        if (!curPackage) return;

        if ($currentRow.is(':last-child')) {
          createNewRow($currentRow, 'SP');
        }

        handlePackageFeature(curPackage);
        if (serviceId) handleServiceDatePricker(curPackage);
        formatPrice($currentRow);
      });
  }

  function createNewRow($currentRow, type) {
    const $newRow = prepareClonedRow($currentRow);
    const suffix = Math.floor(Math.random() * 10000);

    const ids = {
      main: `OC_${type}_${suffix}`,
      um: `UM_${type}_${suffix}`,
      price: `Price_${type}_${suffix}`,
      id: `OtherChargeID_${type}_${suffix}`,
      itemId: `ItemID_${type}_${suffix}`
    };

    $newRow.find('input').click(function () {
      this.select();
    });

    $newRow.find('input[name="OtherCharge"]').attr('id', ids.main).val('').show();
    $newRow.find('input[name="OtherCharge_OtherChargeID"]').attr('id', ids.id).val('').show();
    $newRow.find('input[name="ItemID"]').attr('id', ids.itemId).val('');
    $newRow.find('input[name="UM"]').attr('id', ids.um).val('');
    $newRow.find('input[name="UnitPrice"]').attr('id', ids.price).val('0.00');
    $newRow.find('.divServicePlan').hide().find('input').val('');
    $newRow.find('.input-delete').attr('data-serivce-plan', type === 'SP' ? 'true' : 'false');

    $('#TableItemInformation tbody').append($newRow);

    const mapping = {};
    mapping[ids.um] = "UM";
    mapping[ids.price] = "SalePrice";
    mapping[ids.id] = "OtherChargeID";
    mapping[ids.itemId] = "ItemID";

    if (type === 'SP') {
      LoadData(`AddCustomer/LoadOtherCharge`, function (res) {
        const data = JSON.parse(res.data);
        ApplyTypeahead(ids.main, data, mapping, { Name: "ItemName" });
      }, false, "json");
    } else {
      ApplyTypeahead(ids.main, window.otherChargeData, mapping, { Name: "ItemName" });
    }

    handleRowNumber();
  }

  function handleSwapDescription() {
    $(document).off('click', '.input-delete').on('click', '.input-delete', function () {
      const $row = $(this).closest('tr');
      const index = $row.index();
      const $tbody = $('#TableItemInformation tbody');
      const total = $tbody.find('tr').length;
      const isSPClick = $(this).attr('data-serivce-plan') === 'true';

      if (index === 0) {
        $('#divContract').remove();

        const $container = $row.find('td').eq(1).find('.wrap-input3');
        const $ocInput = $container.find('input[name="OtherCharge"]');

        if ($container.find('.divServicePlan').length === 0) {
          handleItemDescrition();
        }

        const $spSection = $container.find('.divServicePlan');
        $spSection.find('input[name="ServicePlan"]').typeahead('val', '');

        //reset to default
        $row.find('input[name="UM"]').attr('id', 'UM').val('');
        $row.find('input[name="UnitPrice"]').attr('id', 'UnitPrice').val('0.00');

        if (isSPClick) {
          $spSection.hide().find('input').val('');
          $ocInput.show().typeahead('val', '');
          $row.find('input[name="OtherCharge"]').show().attr('id', 'OtherCharge').val('');
          $row.find('input[name="OtherCharge_OtherChargeID"]').attr('id', 'OtherChargeID').val('');
          $tbody.find('tr').not(':first').remove();
          $(this).attr('data-serivce-plan', 'false');
        } else {
          $ocInput.hide().typeahead('val', '');
          $spSection.show();
          loadServicePlan();
          $(this).attr('data-serivce-plan', 'true');
          $('#PackageFeature').empty();
        }
      } else if (isSPClick) {
        $row.remove();
      }

      if (!isSPClick && total !== 1) {
        $row.remove();
        ///RemoveTableRow('TRNo', 'TDNo', this, '', $row.find('input[name="OtherCharge"]').attr('id'), 'calculateTotals');
      }

      handleRowNumber();
      calculateTotals();
    });
  }

