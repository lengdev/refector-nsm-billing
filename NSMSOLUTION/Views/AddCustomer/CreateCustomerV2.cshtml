  function loadRefData(formType) {
    if (isEditCustomer) return;

    $('#ReferenceNo').on('typeahead:select', function () {
      const refNo = $(this).val();
      const custId = $('#ReferenceNo_CustomerID').val();
      $('#CustomerName_CustomerID').val(custId);
      $('#CustomerName_AUTOFill').val(custId);

      EditCustomerWithRefNumber(custId, refNo, formType, true, function () {
        const customerInfo = window.App.CustomerInfo;
        const tables = ['Table', 'Table1', 'Table2', 'Table3', 'Table4', 'Table5', 'Table6', 'Table7', 'Table8'];

        tables.forEach(tableName => {
          const data = customerInfo?.[tableName];
          if (!data?.length) return;
          $.each(data, function (index, val) {
            if ('InvoiceNo' in val) delete val.InvoiceNo;
