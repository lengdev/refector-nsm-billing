    $('#CustomerName, #CustomerNameLatin, #CustomerMobile').on('input typeahead:select', function (e) {
      const contactPerson = $('#CompanyContactName');
      const companyNameKH = $('#CompanyNameKH');
      const companyName = $('#CompanyName');
      const contactMobile = $('#CompanyContactMobileNumber');
      const isCustomerName = this.id === 'CustomerName';
      const isCustomerNameLatin = this.id === 'CustomerNameLatin';
      const value = $(this).val();

      // When name is selected from typeahead
      if (e.type === 'typeahead:select' && (isCustomerName || isCustomerNameLatin)) {
        contactPerson.val(value);
        companyAddress.val($('#CustomerAddress').val());
        billAddress.val($('#CustomerAddress').val());
        contactMobile.val($('#CustomerMobile').val());
        companyNameKH.val(value);
        companyName.val($('#CustomerNameLatin').val());
        return;
      }

      // Normal typing
      if (isCustomerName) {
        contactPerson.val(value);
        companyNameKH.val(value);
      } else if (isCustomerNameLatin) {
        companyName.val(value);
      }
      else {
        contactMobile.val(value);
      }
