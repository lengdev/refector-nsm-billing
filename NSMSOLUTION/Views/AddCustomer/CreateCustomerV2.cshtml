  function initDPK(package) {
    const $install = $('#install-date');
    const $invoice = $('#invoice-date');
    const $due = $('#payment-due-date');
    const $start = $('#start-date');
    const $end = $('#end-date');
    const $from = $('#from-date');
    const $to = $('#to-date');

    const totalDuration = package?.Duration + package?.FreeDuration;
    let activeDuration = totalDuration;
    let renewStatDate = moment();
    if (isRenew && window.App?.CustomerInfo) {
      const normalized = normalizeCustomerData(window.App.CustomerInfo);
      const serviceInvoice = normalized.Invoice?.find(i => i?.ServiceID && i?.Duration);

      if (serviceInvoice?.Duration) {
        activeDuration = parseInt(serviceInvoice.Duration) || totalDuration;
        const renewStart = moment(serviceInvoice.EndDate2, 'DD/MM/YYYY');
        if (renewStart.isValid()) {
          renewStatDate = renewStart;
        }
      }
    }

    // Install date picker
    $install.daterangepicker({
      singleDatePicker: true,
      timePicker: true,
      timePicker24Hour: true,
      autoApply: true,
      drops: 'up',
      startDate: moment(),
      locale: { format: 'DD/MM/YYYY hh:mm A' }
    });

    // Invoice date picker
    $invoice.daterangepicker({
      singleDatePicker: true,
      autoApply: true,
      drops: 'up',
      locale: { format: 'DD/MM/YYYY' }
    }).on('change', function () {
      const date = $(this).data('daterangepicker').startDate;
      $due.data('daterangepicker').setStartDate(date);
    });

    // Due date picker
    $due.daterangepicker({
      singleDatePicker: true,
      autoApply: true,
      drops: 'up',
      startDate: moment(),
      locale: { format: 'DD/MM/YYYY' }
    });

    // Shared variable — initialize with the default renew start date
    let serviceStartDate = moment(renewStatDate);

    // Start date picker
    $start.daterangepicker({
      singleDatePicker: true,
      autoApply: true,
      drops: 'up',
      startDate: renewStatDate,
      locale: { format: 'DD/MM/YYYY' }
    }).on('apply.daterangepicker', function (ev, picker) {
      picker = picker || $(this).data('daterangepicker');
      const start = picker.startDate;

      serviceStartDate = start.clone(); // ← update shared var

      const end = moment(start).add(totalDuration, 'month');
      $end.data('daterangepicker').setStartDate(end);
      $from.html(start.format('DD-MMMM-YYYY'));
      $to.html(end.format('DD-MMMM-YYYY'));

      // Reset duration label back to month when start changes
      $('#duration, #UM').html(`${totalDuration} Month${totalDuration > 1 ? 's' : ''}`);
      $('#UM').val(`${totalDuration} Month${totalDuration > 1 ? 's' : ''}`);

      $('#NextInvoiceDate').val(end.format('DD/MM/YYYY'));
      $('#EndNextInvoiceDate').val(moment(end).add(1, 'month').format('DD/MM/YYYY'));
    });

    // End date picker
    $end.daterangepicker({
      singleDatePicker: true,
      autoApply: true,
      drops: 'up',
      minDate: moment(),
      startDate: moment(renewStatDate).add(totalDuration, 'month'),
      locale: { format: 'DD/MM/YYYY' }
    }).on('apply.daterangepicker', function (ev, picker) {
      const end = picker.startDate;
      const defaultEnd = moment(serviceStartDate).add(totalDuration, 'month');

      // If picked date == default end date → show month label, else show days
      const isDefault = end.isSame(defaultEnd, 'Day');
      const days = end.diff(serviceStartDate, 'Days');
      const durationLabel = isDefault
        ? `${totalDuration} Month${totalDuration > 1 ? 's' : ''}`
        : `${days} Day${days !== 1 ? 's' : ''}`;

      $to.html(end.format('DD-MMMM-YYYY'));
      $('#duration').html(durationLabel);
      $('#UM').val(durationLabel);
      $('#NextInvoiceDate').val(end.format('DD/MM/YYYY'));
      $('#EndNextInvoiceDate').val(moment(end).add(1, 'month').format('DD/MM/YYYY'));
    });

    if (isRenew) {
      const drp = $start.data('daterangepicker');

      if (drp) {
        $start.trigger('apply.daterangepicker', { startDate: drp.startDate });
      }
    }

    // ✅ Fix: populate NextInvoiceDate if end date already has a value
    if ($end.val()) {
      const endVal = moment($end.val(), 'DD/MM/YYYY');
      $('#NextInvoiceDate').val(endVal.format('DD/MM/YYYY'));
      $('#EndNextInvoiceDate').val(moment(endVal).add(1, 'month').format('DD/MM/YYYY'));
      $to.html(endVal.format('DD-MMMM-YYYY'));
    }
  }

  function validateUserInput(formType) {

    if (formType === 'NewRegister') return;

    LoadData('AddCustomer/GetCustomerName', function (data) {
      const customers = data;
      const nameKh = customers.filter(c => c.CustomerName !== '' && c.CustomerName !== null);
      const nameLatin = customers.filter(c => c.CustomerNameLatin !== '' && c.CustomerNameLatin !== null);
      ApplyTypeahead('CustomerName', nameKh,
        {
          CustomerName_CustomerID: 'CustomerID'
        },
        { Name: 'CustomerName' }
      );
      ApplyTypeahead('CustomerNameLatin', nameLatin,
        {
          CustomerName_CustomerID: 'CustomerID'
        },
        { Name: 'CustomerNameLatin' }
      );
    }, false, "json");

    $('#CustomerName, #CustomerNameLatin').bind('typeahead:select', function (ev, suggestion, isAutoTrigger) {

      if (isAutoTrigger) return;

      const custId = $('#CustomerName_CustomerID').val();
      $('#CustomerName_CustomerID').val(custId);
      $('#CustomerName_AUTOFill').val(custId);

      LoadData(`AddCustomer/GetCustomerBilling?CustomerID=${custId}`, function (response) {
        const data = JSON.parse(response.data);
        window.App = window.App || {};
        window.App.CustomerInfo = null;

        if (!data || Object.keys(data).length === 0) {
          DialogSweetAlert('error', 'Customer Not Found');
          return;
        }

        const customerInfo = data;
        const tables = ['Table', 'Table1', 'Table2', 'Table3', 'Table4', 'Table5', 'Table6', 'Table7', 'Table8'];

        tables.forEach(tableName => {
          const data = customerInfo?.[tableName];
          if (!data?.length) return;
          $.each(data, function (index, val) {
            if ('InvoiceNo' in val) delete val.InvoiceNo;
            if ('InvoiceDate' in val) delete val.InvoiceDate;
            if ('PaymentDueDate' in val) delete val.PaymentDueDate;
            if ('InstallAddress' in val) delete val.InstallAddress;
            if ('InstallCommune' in val) delete val.InstallCommune;
            if ('InstallDistrict' in val) delete val.InstallDistrict;
            if ('InstallProvinceCity' in val) delete val.InstallProvinceCity;
            if ('GoogleMap_FullAddress' in val) delete val.GoogleMap_FullAddress;
            if ('GoogleMap_Latitude' in val) delete val.GoogleMap_Latitude;
            if ('GoogleMap_Longitude' in val) delete val.GoogleMap_Longitude;
          });
        });

        window.App.CustomerInfo = data;

        fillEditData(custId, formType);

      }, false, "json");
    });
  }

