      if (!$('#CustomerGroup').val()) {
        e.preventDefault();
        $(this).typeahead('close');
      }
    }).on('typeahead:select', function () {

      if (formType === 'NewRegister') return;

      const block = $(this).val();
      const invoiceType = $('#SetCID').val();
      LoadData(`AddCustomer/LoadCustomerQuoteCID?CustomerType=${block}&FormType=${formType}`, function (response) {
        const res = JSON.parse(response.data);
        if (res[0].length === 0) return;
        $("#CustomerCode").val(res[0].PrefixNumber);
        $("#CustomerCode_Prefix").val(res[0].Prefix);
      }, false, 'json');
    });
  }

  function calculateRow(row) {
    const qty = parseFloat(accounting.unformat(row.find('input[name="QTY"]').val())) || 0;
    const unitPrice = parseFloat(accounting.unformat(row.find('input[name="UnitPrice"]').val())) || 0;
    const disP = parseFloat(accounting.unformat(row.find('input[name="DisP"]').val())) || 0;
    const disUSD = parseFloat(accounting.unformat(row.find('input[name="DisUSD"]').val())) || 0;
    const disKHR = parseFloat(accounting.unformat(row.find('input[name="DisKHR"]').val())) || 0;
    const exchangeRate = $('input[name="ExchangeRate"]').val();

    const calc = new TotalCalculator({
      qty,
      unitPrice,
      discountUSD: disUSD,
      discountKHR: disKHR,
      discountPercent: disP,
      exchangeRate
    });

    const result = calc.calculate();
    row.find('input[name="Amount"]').val(accounting.formatMoney(result.total, ''));
    return result;
  }

  function calcSubtotal() {
    let subtotal = 0;
    let totalDiscount = 0;

    $('table[name="TblItemInfo"] tbody tr').each(function () {
      const rowResult = calculateRow($(this));
      subtotal += parseFloat(accounting.toFixed(rowResult.subtotal, 2));
      totalDiscount += rowResult.totalDiscount;
    });

    $('label[name="SubTotal"]').text(accounting.formatMoney(subtotal, ''));
    $('input[name="TxtDisUSD"]').val(accounting.formatMoney(totalDiscount, ''));

    return { subtotal, totalDiscount };
  }

  function calculateTotals() {
    setTimeout(function () {
      const { subtotal, totalDiscount } = calcSubtotal();
      const vatRate = parseFloat(accounting.unformat($('input[name="VATRate"]').val())) || 0;
      const deposit = parseFloat(accounting.unformat($('input[name="TxtDeposit"]').val())) || 0;

      const calc = new TotalCalculator({
        qty: 1,
        unitPrice: subtotal - totalDiscount,
        vatRate,
        deposit
      });

      const result = calc.calculate();

      $('input[name="VAT"]').val(accounting.formatMoney(result.amtVAT, ''));
      $('label[name="Total"]').text(accounting.formatMoney(result.total, ''));
      $('input[name="GrandTotal"]').val(accounting.formatMoney(result.grandTotal, ''));
      $('input[name="TxtBalance"]').val(accounting.formatMoney(result.balanceUSD, ''));

      return result;
    }, 10);
  }

  function handleChangeTotal() {

    // Row-level inputs (user types → recalculate)
    const rowElements = `
        input[name="QTY"],
        input[name="UnitPrice"],
        input[name="DisP"],
        input[name="DisUSD"],
        input[name="TxtDeposit"]
    `;

    $(document).on('keyup change', rowElements, function () {
      calculateTotals();
    });

    $(document).on('focus', 'input[name="TxtDisUSD"]', function () {
      $(this).select();
    });

    $(document).on('focus', 'input[name="TxtDisUSD"], input[name="VAT"]', function () {
      $(this).select();
    });

    // Summary-level: Manual Discount override
    $(document).on('keyup change', 'input[name="TxtDisUSD"]', function () {
      const manualDiscount = parseFloat(accounting.unformat($(this).val())) || 0;
      const subtotal = parseFloat(accounting.unformat($('label[name="SubTotal"]').text())) || 0;
      const vatRate = parseFloat(accounting.unformat($('input[name="VATRate"]').val())) || 0;
      const deposit = parseFloat(accounting.unformat($('input[name="TxtDeposit"]').val())) || 0;

      const calc = new TotalCalculator({ qty: 1, unitPrice: subtotal - manualDiscount, vatRate, deposit });
      const result = calc.calculate();

      $('input[name="VAT"]').val(accounting.formatMoney(result.amtVAT, ''));
      $('label[name="Total"]').text(accounting.formatMoney(result.total, ''));
      $('input[name="GrandTotal"]').val(accounting.formatMoney(result.grandTotal, ''));
      $('input[name="TxtBalance"]').val(accounting.formatMoney(result.balanceUSD, ''));
    });

    // Summary-level: Manual VAT override
    $(document).on('keyup change', 'input[name="VAT"]', function () {
      const total = parseFloat(accounting.unformat($('label[name="Total"]').text())) || 0;
      const vat = parseFloat(accounting.unformat($(this).val())) || 0;
      const deposit = parseFloat(accounting.unformat($('input[name="TxtDeposit"]').val())) || 0;

      const grandTotal = total + vat - deposit;

      $('input[name="GrandTotal"]').val(accounting.formatMoney(grandTotal, ''));
      $('input[name="TxtBalance"]').val(accounting.formatMoney(grandTotal, ''));
    });
  }

  function handleCommissionAmount(customerId) {
    $(document).on('change', '[name="AgencyCommissionType"]', function () {
      customerId = customerId || $('#CustomerName_CustomerID').val();
      if (customerId) return;
      const $container = $(this).closest('.p-2, .agency-clone');
      $container.find('[name="CommissionAmountUSD"]').val(0);
      $container.find('[name="CommissionAmountP"]').val('0%');
    });

    $(document).on('focus', '[name^="CommissionAmount"]', function () {
      const $input = $(this);
      if ($input.attr('name') === 'CommissionAmountP') {
        const val = $input.val().replace('%', '');
        $input.val(val);
        this.select();
      } else {
        this.select();
      }
    });

    $(document).on('input', '[name^="CommissionAmount"]', function () {
      const $input = $(this);
      const $container = $input.closest('.p-2, .agency-clone');
      const invoiceType = $('#SetCID').val();
      let packageAmount = 0;

      $('#TableItemInformation tbody tr').each(function (index, el) {
        if (index === 0) {
          const serviceId = $(el).find('#ServiceID').val() || 0;
          if (serviceId) {
            packageAmount = parseFloat($(el).find('#Amount').val()) || 0;
          }
        }
      });

      if ($input.attr('name') === 'CommissionAmountUSD') {
        let usd = parseFloat($input.val()) || 0;
        if (packageAmount > 0) {
          let baseAmount = invoiceType === "CM" ? packageAmount * 0.9 : packageAmount;
          let percent = (usd / baseAmount) * 100;

          let displayPercent = percent % 1 === 0 ? percent : percent.toFixed(2);
          $container.find('[name="CommissionAmountP"]').val(displayPercent + '%');
        } else {
          $container.find('[name="CommissionAmountP"]').val('0%');
        }
      }

      if ($input.attr('name') === 'CommissionAmountP') {
        let selectionStart = this.selectionStart;
        let rawVal = $input.val().replace(/%/g, '').replace(/[^0-9.]/g, '');

        $input.val(rawVal ? rawVal + '%' : '');

        if (rawVal) {
          let cursorPos = Math.min(selectionStart, rawVal.length);
          this.setSelectionRange(cursorPos, cursorPos);
        }

        let percent = parseFloat(rawVal) || 0;
        let baseAmount = invoiceType === "CM" ? packageAmount * 0.9 : packageAmount;
        let usd = (baseAmount * percent) / 100;
        $container.find('[name="CommissionAmountUSD"]').val(usd.toFixed(2));
      }
    });

    $(document).on('blur', '[name="CommissionAmountP"]', function () {
      const $input = $(this);
      let val = $input.val();
      if (val && !val.includes('%')) {
        $input.val(val + '%');
      }
    });
  }

  //Edit customer
  function normalizeCustomerData(raw) {
    if (!raw) return {
      Customer: null, Infra: null, Company: null,
      Commission: [], Billing: null, Invoice: [],
      Balance: null, Payment: null, BillInfo: null,
    };
    return {
      Customer: raw.Table?.[0] || null,
      Infra: raw.Table1?.[0] || null,
      Company: raw.Table2?.[0] || null,
      Commission: raw.Table3 || [],
      Billing: raw.Table4?.[0] || null,
      Invoice: raw.Table5 || [],
      Balance: raw.Table6?.[0] || null,
      Payment: raw.Table7?.[0] || null,
      BillInfo: raw.Table8?.[0] || null,
    };
  }

  function bindFormData(data) {
    if (!data) return;

    // Single object: Customer, Company, Commission
    const collection = ['Customer', 'Infra', 'Company', 'Commission', 'Billing',
      'Invoice', 'Payment', 'Balance', 'BillInfo'];

    collection.forEach(section => {
      if (data[section]) fillInputs(section === 'Invoice' ? data[section][0] : data[section]);
    });
  }

  function fillInputs(obj, $scope = $(document)) {
    $.each(obj, (key, value) => {

      if (value == null) return;

      const $el = $scope.find(`[name="${key}"]`);
      if (!$el.length) return;

      if ($el.is(':checkbox')) {
        if (value === "None VAT") $('#ExcludedVAT').prop('checked', true);
        else if (value === "VAT") $('#IncludedVAT').prop('checked', true);
        else if (value === "CM") $('#CommercialINV').prop('checked', true);
      }
      else if ($el.data('daterangepicker')) {
        $el.data('daterangepicker').setStartDate(moment(value));
        $el.val(moment(value).format('DD/MM/YYYY'));
      }
      else if ($el.hasClass('select2-hidden-accessible')) {
        let values = value;
        if ($el.prop('multiple')) {
          if (typeof value === "string") values = value.split(',');
          if (!Array.isArray(values)) values = [values];
        }

        $el.val(values).trigger('change');
      }
      else if ($el.hasClass('tt-input')) {
        $el.typeahead('val', value)
          .trigger('typeahead:select', [{ value }, true]);
      }
      else {
        $el.val(value).trigger('change');
      }
    });
  }

  function fillEditData(customerId, formType = '') {
    if (!customerId || !window.App?.CustomerInfo) return;
    const normalized = normalizeCustomerData(window.App.CustomerInfo);
    const autoFillCust = parseInt($('#CustomerName_AUTOFill').val()) || 0;

    if (autoFillCust === 0) {
      if (!isToInvoice && !isRenew && !isChangePlan) {
        $("#CustomerName_CustomerInvoiceID").val(normalized.Invoice[0]?.CustomerInvoiceID);
        $("#CustomerName_BillingInvoiceID").val(normalized.Billing?.BillingInvoiceID);
        $("#CustomerName_CustomerBillInformationID").val(normalized.BillInfo?.CustomerBillInformationID);
      }
    }
    if (isChangePlan) {
      const oldService = normalized.Invoice[0]?.ServiceName;
      const oldPackage = normalized.Invoice[0]?.ItemDescription;
      const oldStartDate = normalized.Invoice[0]?.StartDate || moment();
      const oldEndDate = normalized.Invoice[0]?.EndDate || moment();
      const remainDay = normalized.Invoice[0]?.RemainDay || 0;
      const prefixDay = remainDay > 1 ? 'Days' : 'Day';

      setTimeout(function () {
        $('#OldServicePlan').val(oldService);
        $('#OldPackageName').val(oldPackage);
        $('#old-start-date').text(moment(oldStartDate).format('DD-MM-YYYY'));
        $('#old-end-date').text(moment(oldEndDate).format('DD-MM-YYYY'));
        $('#remain-day-usage').text(`${remainDay} ${prefixDay}`);
      }, 1000);

      if (normalized.Invoice[0] && !isRenew) {
        normalized.Invoice[0].ServiceName = "";
      }
    }

    if (autoFillCust && formType == 'Quotation') {
      normalized.Billing = [];
      normalized.Invoice = [];
      normalized.Payment = [];
    }

    //console.log(normalized)

    // Append data to inputs, selects, etc.
    if (typeof bindFormData === 'function') {
      setTimeout(function () {
        bindFormData(normalized);
      }, 400);
    }

    // Load Google Map if coordinates exist
    const lat = normalized.BillInfo?.GoogleMap_Latitude;
    const lng = normalized.BillInfo?.GoogleMap_Longitude;
    //if (lat != null && lng != null && typeof loadGoogleMap === 'function') {
    //    loadGoogleMap(lat, lng);
    //}

    // Fill agency commissions
    if (Array.isArray(normalized.Commission) && normalized.Commission.length > 0) {
      normalized.Commission.forEach((com, index) => {
        let $scope;
        if (index === 0) {
          $scope = $('#AgencyCommission > .p-2').slice(0, 2);
        } else {
          $('#btnAddNewAgency').trigger('click', { isEdit: true });
          $scope = $('#AgencyCommission .agency-clone').last();
        }

        setTimeout(() => {
          if (typeof fillInputs === 'function') {
            fillInputs(com, $scope);
          }
        }, 800);
      });
    }

    // Fill service plan and other charges
    if (Array.isArray(normalized.Invoice) && normalized.Invoice.length > 0) {
      setTimeout(() => {
        normalized.Invoice
          .sort((a, b) => (b?.ServiceID ? 1 : 0) - (a?.ServiceID ? 1 : 0))
          .forEach((inv, index) => {
            const $row = $('#TableItemInformation tbody tr').eq(index);
            if (!$row.length) return;

            const $serviceDiv = $row.find('.divServicePlan');
            const hasServicePackage = normalized.Invoice.some(i => i?.ServiceID && i?.PackageDetailID);
            const isItem = normalized.Invoice.some(i => i?.ItemID || i?.OtherChargeID);

            if (!hasServicePackage && index === 0) {
              $serviceDiv.parent().find('.input-delete').trigger('click');
            }

            // Apply dates helper
            const setDate = (selector, value, format, triggerApply = false) => {
              if (!value) return;
              const picker = $(selector).data('daterangepicker');
              if (!picker) return;
              const date = format ? moment(value).format(format) : moment(value);
              picker.setStartDate(date);
              $(selector).val(date);
              if (triggerApply) $(selector).trigger('apply.daterangepicker', picker);
            };

            if ($serviceDiv.is(':visible')) {
              if (inv?.ServiceName) {
                const $spInput = $row.find('[name="ServicePlan"]');
                if ($spInput.data('ttTypeahead')) {
                  $spInput.typeahead('val', inv.ServiceName).trigger('typeahead:select');
                } else {
                  $spInput.val(inv.ServiceName);
                }

                const $pkgInput = $row.find('[name="PackageName"]');
                if ($pkgInput.data('ttTypeahead')) {
                  $pkgInput.typeahead('val', inv.ItemDescription || '').trigger('typeahead:select');
                } else {
                  $pkgInput.val(inv.ItemDescription || '');
                }

                $row.find('[name="PID"]').val(inv?.PID || '');
              }

              setDate('#install-date', normalized.BillInfo?.InstallDate, 'DD/MM/YYYY hh:mm A');
              setDate('#start-date', inv?.StartDate, 'DD/MM/YYYY', true);
              setDate('#end-date', inv?.EndDate, 'DD/MM/YYYY');

            } else {
              // --- FIXED OTHER CHARGES BLOCK ---
              if (inv?.ItemDescription) {
                // 1. Immediately apply IDs to data fields so calculations don't break
                $row.find('[name="OtherCharge_OtherChargeID"]').val(inv?.OtherChargeID);
                $row.find('[name="ItemID"]').val(inv?.ItemID);
                $row.find('[name="CustomerInvoiceID"]').val(inv?.CustomerInvoiceID);
                $row.find('[name="ServiceID"]').val(inv?.ServiceID);

                // 2. Safe Typeahead implementation with an instant fallback
                const $ocInput = $row.find('[name="OtherCharge"]');
                if ($ocInput.data('ttTypeahead')) {
                  $ocInput.typeahead('val', inv.ItemDescription).trigger('typeahead:select');
                } else {
                  // Fallback if plugin isn't active/ready yet
                  $ocInput.val(inv.ItemDescription);
                }

                if (isItem && index === 0) {
                  otherChargeInvDate();
                }
              }
            }

            setDate('#invoice-date', normalized.BillInfo?.InvoiceDate, 'DD/MM/YYYY');
            setDate('#payment-due-date', normalized.BillInfo?.PaymentDueDate, 'DD/MM/YYYY');

            // Fill remaining numeric fields
            ['UM', 'QTY', 'UnitPrice', 'DisP', 'DisUSD', 'Amount'].forEach(field => {
              $row.find(`[name="${field}"]`).val(inv?.[field] ?? '0');
            });
          });

        if (typeof calculateTotals === 'function') calculateTotals();
      }, 800);
    }
  }

