    function tdNum() {
        $("td[name=tdNumber]").parent("tr").each(function (i) {
            $("td[name=tdNumber]").eq(i).html(i + 1);
        });
        $("input[name=QTY").autoNumeric({ mDec: false });
        $("input[name=PackagePrice").autoNumeric();
        $("input[name=Disp").autoNumeric({ vMin: '0.00' });
        $("input[name=Disusd").autoNumeric({ vMin: '0.00' });
        $("input[name=Amount").autoNumeric({ vMin: '0.00' });
        Total();
    }
    function Total() {
        var Amount = 0;
        $.each($("input[name=Amount"), function (index) {
            Amount += accounting.unformat($("input[name=Amount").eq(index).val());
        });
        $("label[name=SubTotal]").html(Amount.toFixed(2));
        VAT();
    }
    function cal(THIS) {
        var attrName = $(THIS).attr('name');
        var index = $(THIS).parent().parent().parent('tr').index();
        var QTY = accounting.unformat($("input[name=QTY").eq(index).val());
        var UnitPrice = accounting.unformat($("input[name=PackagePrice").eq(index).val());
        var DiscountP = accounting.unformat($("input[name=Disp").eq(index).val());
        var DiscountUSD = accounting.unformat($("input[name=Disusd").eq(index).val());
        var Amount = accounting.unformat($("input[name=Amount").eq(index).val());
        var Totalval = (QTY * UnitPrice);
        if (attrName == 'Disp') {
            DiscountUSD = ((Totalval * DiscountP) / 100).toFixed(2);
            $("input[name=Disusd").eq(index).val(DiscountUSD);
        }
        else if (attrName == 'Disusd') {
            DiscountP = ((DiscountUSD / Totalval) * 100).toFixed(2);
            $("input[name=Disp").eq(index).val(accounting.formatNumber(DiscountP));
        }
        Amount = (Totalval - DiscountUSD).toFixed(2);
        $("input[name=Amount").eq(index).val(Amount);
        Total();
    }

    function VAT() {
        var SubTotal = accounting.unformat($("label[name=SubTotal]").html());
        var VAT = 0;
        var Total = 0;
        if ($('#IncludedVAT').is(':checked'))
            VAT = (SubTotal * 10) / 100;
        $("label[name=VAT]").html(VAT.toFixed(2));
        Total = (SubTotal + VAT);
        $("label[name=Total]").html(Total.toFixed(2));
        DisP(); DisUSD();
    }
    function addRowOtherCharge(data, tdData, index) {
        var tr = '<tr name="otherCharge">';
        tr += '<td name="tdNumber" align="center" valign="top">1</td>';
        tr += '<td>';
        tr += '<div class="wrap-input3 validateInput">';
        tr += '<input class="input2 OtherCharge" name="otherCharge" type="text">';
        tr += '<div class="input-delete" data-validate="Delete Row Other Charge" onclick="delRow(this);"></div>';
        tr += '<span class="focus-input2"></span>';
        tr += '</div>';
        tr += '<div><input class="input2" name="OtherChargeID" type="hidden"></div>';
        tr += '<div><input class="input2" name="StockInID" type="hidden"></div>';
        tr += '<div><input class="input2" name="ItemID" type="hidden"></div>';
        tr += '</td>';
        tr += tdData;
        tr += '</tr>';
        $("table[name=tblSeviceDetail] tbody tr:last").after(tr);
        tdNum();
        var odata = data;
        $("input[name=otherCharge]").eq(index).typeahead("destroy");
        $("input[name=otherCharge]").eq(index).typeahead({
            hint: true,
            highlight: true,
            minLength: 0
        },
            {
                limit: 9999,
                display: "Name",
                source: function (query, cb) {
                    var matches = [];
                    $.each(odata, function (i, str) {
                        const value = str.ItemName;
                        const globalRegex = new RegExp(query, '\ig');
                        if (globalRegex.test(value)) {
                            matches.push({ Name: str.ItemName, ID: str.StockInID, Fee: str.SalePrice, UM: str.UM, OtherChargeID: str.OtherChargeID, ItemID: str.ItemID });
                        }
                    });
                    cb(matches);
                }
            }).bind("typeahead:selected", function (obj, data, name) {
                var rowIndex = $(this).parent().parent().parent($("td[name=tdNumber]")).index();
                $("input[name=UM]").eq(rowIndex).val(data.UM);
                $("input[name=QTY]").eq(rowIndex).val("1");
                $("input[name=PackagePrice]").eq(rowIndex).val(data.Fee.toFixed(2));
                $("input[name=Disp]").eq(rowIndex).val("0.00");
                $("input[name=Disusd]").eq(rowIndex).val("0.00");
                $("input[name=Amount]").eq(rowIndex).val(data.Fee.toFixed(2));
                var index = $("input[name=otherCharge]").index($(this));
                $("input[name=StockInID]").eq(index).val(data.ID);
                $("input[name=OtherChargeID]").eq(index).val(data.OtherChargeID);
                $("input[name=ItemID]").eq(index).val(data.ItemID);
                if ($(this).parent().parent().parent($("td[name=tdNumber]")).is("tbody tr:last")) {
                    addRowOtherCharge(odata, tdData, (index + 1));
                }
                Total();
            });
        $("input[name=otherCharge]").eq(index).click(function () {
            $("input[name=otherCharge]").eq(index).typeahead("open");
        });
        $("input[name=otherCharge]").on('focus', function () {
            if ($(this).parent().parent().parent($("td[name=tdNumber]")).is("tbody tr:last")) {
                var index = ($("input[name=otherCharge]").index($(this)) + 1);
                addRowOtherCharge(odata, tdData, index);
            }
        });
    }

    function delRow(THIS) {
        $(THIS).parent().parent().parent("tr").remove();
        tdNum();
    }

    function DisP() {
        var DiscountUSD = 0;
        var Total = accounting.unformat($("label[name=Total]").html());
        var DiscountP = accounting.unformat($("input[name=TxtDisP").val());
        DiscountUSD = ((Total * DiscountP) / 100).toFixed(2);
        $("input[name=TxtDisUSD").val(DiscountUSD);
        Total = (Total - DiscountUSD).toFixed(2);
        $("label[name=GrandTotal").html(Total);
    }

    function DisUSD() {
        var DiscountP = 0;
        var Total = accounting.unformat($("label[name=Total]").html());
        var DiscountUSD = accounting.unformat($("input[name=TxtDisUSD").val());
        DiscountP = ((DiscountUSD / Total) * 100).toFixed(2);
        $("input[name=TxtDisP").val(DiscountP);
        Total = (Total - DiscountUSD).toFixed(2);
        $("label[name=GrandTotal").html(Total);
    }

