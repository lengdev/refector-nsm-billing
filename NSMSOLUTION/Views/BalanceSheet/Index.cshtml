<script>
    window._bsCompanyLogo = '@initCompLogo';

    // ─────────────────────────────────────────────────────────────
    // Helper: Dynamic System Color Palette Mapping
    // ─────────────────────────────────────────────────────────────
    function getSystemTheme(sysId) {
        var id = String(sysId || '').trim();
        if (id === '13') {
            return { primary: '#F89C39', hover: '#e07d15', text: '#ffffff', light: '#fff8f0', border: '#fed7aa', rgb: '248, 156, 57' };
        }
        if (id === '28') {
            return { primary: '#007bff', hover: '#0069d9', text: '#ffffff', light: '#eff6ff', border: '#bfdbfe', rgb: '0, 123, 255' };
        }
        if (id === '27') {
            return { primary: '#ffc107', hover: '#e0a800', text: '#212529', light: '#fffdf0', border: '#fef08a', rgb: '255, 193, 7' };
        }
        if (id === '25') {
            return { primary: '#d81b60', hover: '#c2185b', text: '#ffffff', light: '#fdf2f8', border: '#fbcfe8', rgb: '216, 27, 96' };
        }
        // Fallback default
        return { primary: '#F89C39', hover: '#e07d15', text: '#ffffff', light: '#fff8f0', border: '#fed7aa', rgb: '248, 156, 57' };
    }

    function applySystemTheme(sysId) {
        var theme = getSystemTheme(sysId);
        var root = document.documentElement;
        root.style.setProperty('--sys-primary', theme.primary);
        root.style.setProperty('--sys-primary-hover', theme.hover);
        root.style.setProperty('--sys-primary-text', theme.text);
        root.style.setProperty('--sys-primary-light', theme.light);
        root.style.setProperty('--sys-primary-border', theme.border);
        root.style.setProperty('--sys-primary-rgb', theme.rgb);
    }

    // ─────────────────────────────────────────────────────────────
    // Helper: Extract query string or hash parameters dynamically
    // ─────────────────────────────────────────────────────────────
   function getSystemParam(key) {
        // 1. Try standard search (?key=val)
        var s = new URLSearchParams(window.location.search);
        if (s.get(key)) return s.get(key);

        // 2. Try hash query (?key=val inside hash)
        if (window.location.hash && window.location.hash.indexOf('?') !== -1) {
            var h = new URLSearchParams(window.location.hash.substring(window.location.hash.indexOf('?')));
            if (h.get(key)) return h.get(key);
        }

        // 3. Regex fallback to inspect the full raw URL string
        var match = new RegExp('[?&]' + key + '=([^&#]*)', 'i').exec(window.location.href);
        if (match && match[1]) return decodeURIComponent(match[1]);

        // 4. Server-side initial fallbacks
        if (key.toLowerCase() === 'systemid') return '@initialSystemID';
        if (key.toLowerCase() === 'warehouseid') return '@initialWarehouseID';
        return '';
    }

    // ─────────────────────────────────────────────────────────────
    // TOGGLE ADVANCE PANEL
    // ─────────────────────────────────────────────────────────────
    function toggleAdvancePanel() {
        var $panel = $('#advancePanel');
        var $btn = $('#advancePanelToggle');
        $panel.slideToggle(200);
        $btn.toggleClass('active-panel');
    }

    // ─────────────────────────────────────────────────────────────
    // MULTISELECT DROPDOWN
    // ─────────────────────────────────────────────────────────────
    function toggleMultiselect(id, btn) {
        var $dd = $('#' + id);
        $dd.toggleClass('open');
        $('.c2s-dropdown').removeClass('open');
        $('.c2s-wrapper').removeClass('open-active');
        $('.advance-row, .advance-field').css('z-index', '');
    }

    $(document).on('change', '#shownColumnsDropdown input[type=checkbox]', function () {
        var count = $('#shownColumnsDropdown input[type=checkbox]:checked').length;
        $('#shownColumnsBtnText').text(count + ' option(s) selected');
        applyAdvanceFilters();
    });

    $(document).on('click', function (e) {
        if (!$(e.target).closest('.multiselect-wrapper').length) {
            $('.multiselect-dropdown').removeClass('open');
        }
        if (!$(e.target).closest('.c2s-wrapper').length) {
            $('.c2s-dropdown').removeClass('open');
            $('.c2s-wrapper').removeClass('open-active');
            $('.advance-row, .advance-field').css('z-index', '');
        }
    });

    // ─────────────────────────────────────────────────────────────
    // CUSTOM 2-COLUMN SELECT (c2s)
    // ─────────────────────────────────────────────────────────────
    function toggleC2sDropdown(wrapperId) {
        var $wrapper = $('#' + wrapperId);
        var $dropdown = $wrapper.find('.c2s-dropdown');
        var isOpen = $dropdown.hasClass('open');

        $('.c2s-dropdown').removeClass('open');
        $('.c2s-wrapper').removeClass('open-active');
        $('.advance-row, .advance-field').css('z-index', '');
        $('.multiselect-dropdown').removeClass('open');

        if (!isOpen) {
            $dropdown.addClass('open');
            $wrapper.addClass('open-active');
            $wrapper.closest('.advance-row').css('z-index', '9999');
            $wrapper.closest('.advance-field').css('z-index', '9999');
        }
    }

    function selectC2sItem(wrapperId, hiddenInputId, val, displayText) {
        var $wrapper = $('#' + wrapperId);
        $('#' + hiddenInputId).val(val);

        var labelText = displayText || '---Please select---';
        var $textSpan = $wrapper.find('.c2s-text');
        $textSpan.text(labelText);

        if (!val || labelText === '---Please select---') {
            $textSpan.addClass('is-placeholder');
        } else {
            $textSpan.removeClass('is-placeholder');
        }

        $wrapper.find('.c2s-dropdown').removeClass('open');
        $wrapper.removeClass('open-active');
        $('.advance-row, .advance-field').css('z-index', '');
        $wrapper.find('.c2s-item').removeClass('selected');
        if (val) {
            $wrapper.find('.c2s-item[data-val="' + val + '"]').addClass('selected');
        } else {
            $wrapper.find('.c2s-item:first').addClass('selected');
        }
        applyAdvanceFilters();
    }

    // ─────────────────────────────────────────────────────────────
    // LOAD FILTER DROPDOWNS from controller (DYNAMIC BASED ON SYSTEMID)
    // ─────────────────────────────────────────────────────────────
    function loadFilterOptions() {
        var currentSysId = getSystemParam('SystemID');
        var currentWhId = getSystemParam('WarehouseID');

        applySystemTheme(currentSysId);

        var reqData = {
            systemID: currentSysId,
            warehouseID: currentWhId
        };

        $.ajax({
            url: '@Url.Action("GetFilterOptions", "BalanceSheet")',
            type: 'POST',
            data: reqData,
            success: function(res) {
                if (!res.success) return;

                // 1. Account Dropdown
                var $accList = $('#c2s_account_list');
                $accList.empty();
                $accList.append('<div class="c2s-item c2s-placeholder selected" data-val="" onclick="selectC2sItem(\'c2s_account\', \'filterAccount\', \'\', \'---Please select---\')"><span class="c2s-name">---Please select---</span><span class="c2s-type"></span></div>');
                $.each(res.accounts || [], function(_, a) {
                    var nameText = (a.AccountNo ? a.AccountNo + ' ' : '') + a.AccountName;
                    var typeText = a.AccountCategory || 'Account';
                    var safeName = nameText.replace(/'/g, "\\'");
                    $accList.append('<div class="c2s-item" data-val="' + a.AccountNo + '" onclick="selectC2sItem(\'c2s_account\', \'filterAccount\', \'' + a.AccountNo + '\', \'' + safeName + '\')">' +
                                        '<span class="c2s-name">' + nameText + '</span>' +
                                        '<span class="c2s-type">' + typeText + '</span>' +
                                    '</div>');
                });

                // 2. Location Dropdown
                var $locList = $('#c2s_location_list');
                $locList.empty();
                $locList.append('<div class="c2s-item c2s-placeholder selected" data-val="" onclick="selectC2sItem(\'c2s_location\', \'filterLocation\', \'\', \'---Please select---\')"><span class="c2s-name">---Please select---</span><span class="c2s-type"></span></div>');
                $.each(res.locations || [], function(_, l) {
                    var safeLoc = l.WarehouseName.replace(/'/g, "\\'");
                    $locList.append('<div class="c2s-item" data-val="' + l.WarehouseID + '" onclick="selectC2sItem(\'c2s_location\', \'filterLocation\', \'' + l.WarehouseID + '\', \'' + safeLoc + '\')">' +
                                        '<span class="c2s-name">' + l.WarehouseName + '</span>' +
                                        '<span class="c2s-type">Warehouse</span>' +
                                    '</div>');
                });

                // 3. Created By Dropdown (2-column: Name & Gender)
                var $usrList = $('#c2s_createdBy_list');
                $usrList.empty();
                $usrList.append('<div class="c2s-item c2s-placeholder selected" data-val="" onclick="selectC2sItem(\'c2s_createdBy\', \'filterCreatedBy\', \'\', \'---Please select---\')"><span class="c2s-name">---Please select---</span><span class="c2s-cat"></span></div>');
                $.each(res.users || [], function(_, u) {
                    var safeUser = (u.FullName || '').replace(/'/g, "\\'");
                    var gender = u.Gender || '';
                    $usrList.append('<div class="c2s-item" data-val="' + u.UserID + '" onclick="selectC2sItem(\'c2s_createdBy\', \'filterCreatedBy\', \'' + u.UserID + '\', \'' + safeUser + '\')">' +
                                        '<span class="c2s-name">' + (u.FullName || '') + '</span>' +
                                        '<span class="c2s-cat">' + gender + '</span>' +
                                    '</div>');
                });

                // 4. Classes Dropdown
                var $clsList = $('#c2s_class_list');
                $clsList.empty();
                $clsList.append('<div class="c2s-item c2s-placeholder selected" data-val="" onclick="selectC2sItem(\'c2s_class\', \'filterClass\', \'\', \'---Please select---\')"><span class="c2s-name">---Please select---</span></div>');
                $.each(res.classes || [], function(_, c) {
                    var safeClass = c.ClassName.replace(/'/g, "\\'");
                    $clsList.append('<div class="c2s-item" data-val="' + c.ClassID + '" onclick="selectC2sItem(\'c2s_class\', \'filterClass\', \'' + c.ClassID + '\', \'' + safeClass + '\')">' +
                                        '<span class="c2s-name">' + c.ClassName + '</span>' +
                                    '</div>');
                });
            }
        });
    }

    // ─────────────────────────────────────────────────────────────
    // FILTER VALUES & BADGE
    // ─────────────────────────────────────────────────────────────
    function getAdvanceFilters() {
        return {
            txType:         $('#filterTxType').val(),
            accountNo:      $('#filterAccount').val(),
            name:           $('#filterName').val().trim(),
            refNo:          $('#filterRefNo').val().trim(),
            createdBy:      $('#filterCreatedBy').val(),
            classId:        $('#filterClass').val(),
            location:       $('#filterLocation').val(),
            sortBy:         $('#filterSortBy').val(),
            orderBy:        $('#filterOrderBy').val(),
            displayColumns: $('#filterDisplayColumns').val() || 'default'
        };
    }

    function updateActiveFilterBadge() {
        var f = getAdvanceFilters();
        var count = 0;
        if (f.txType) count++;
        if (f.accountNo) count++;
        if (f.name) count++;
        if (f.refNo) count++;
        if (f.createdBy) count++;
        if (f.classId) count++;
        if (f.location) count++;
        if (f.sortBy && f.sortBy !== 'default') count++;
        if (f.orderBy && f.orderBy !== 'asc') count++;
        if (f.displayColumns && f.displayColumns !== 'default') count++;

        var $badge = $('#activeFilterBadge');
        if (count > 0) {
            $badge.text(count).show();
        } else {
            $badge.hide();
        }
    }

    function applyAdvanceFilters() {
        updateActiveFilterBadge();
        var dateRange = $('#TxtFromDate').val();
        if (dateRange && dateRange.includes(' - ')) {
            var dates = dateRange.split(' - ');
            loadBalanceSheetData(dates[0].trim(), dates[1].trim());
        } else if (dateRange) {
            loadBalanceSheetData(dateRange, dateRange);
        }
    }

    function resetAdvanceFilters() {
        selectC2sItem('c2s_location', 'filterLocation', '', '---Please select---');
        selectC2sItem('c2s_account', 'filterAccount', '', '---Please select---');
        selectC2sItem('c2s_createdBy', 'filterCreatedBy', '', '---Please select---');
        selectC2sItem('c2s_txType', 'filterTxType', '', '---Please select---');
        selectC2sItem('c2s_class', 'filterClass', '', '---Please select---');
        selectC2sItem('c2s_sortBy', 'filterSortBy', 'default', 'Default');
        selectC2sItem('c2s_displayColumns', 'filterDisplayColumns', 'default', 'Default');
        selectC2sItem('c2s_orderBy', 'filterOrderBy', 'asc', 'Ascending');
        $('#filterRefNo').val('');
        $('#filterName').val('');

        $('#shownColumnsDropdown input[type=checkbox]').prop('checked', true);
        $('#shownColumnsBtnText').text('6 option(s) selected');

        updateActiveFilterBadge();

        var dateRange = $('#TxtFromDate').val();
        if (dateRange && dateRange.includes(' - ')) {
            var dates = dateRange.split(' - ');
            loadBalanceSheetData(dates[0].trim(), dates[1].trim());
        } else if (dateRange) {
            loadBalanceSheetData(dateRange, dateRange);
        }
    }

    // Live search on text input changes
    $(document).on('input', '#filterRefNo, #filterName', function () {
        if (window._bsFilterDebounce) clearTimeout(window._bsFilterDebounce);
        window._bsFilterDebounce = setTimeout(applyAdvanceFilters, 400);
    });

    // ─────────────────────────────────────────────────────────────
    // DATE RANGE PICKER & SEARCH TRIGGER
    // ─────────────────────────────────────────────────────────────
    function initializeDateRangePicker() {
        if ($.fn.daterangepicker) {
            let start = moment().startOf('year');
            let end = moment();

            $('#TxtFromDate').daterangepicker({
                alwaysShowCalendars: true,
                showDropdowns: true,
                showWeekNumbers: true,
                autoUpdateInput: true,
                linkedCalendars: false,
                showCustomRangeLabel: true,
                startDate: start,
                endDate: end,
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')],

                    'Last Year': [moment().subtract(1, 'year').startOf('year'), moment().subtract(1, 'year').endOf('year')]
                },
                locale: {
                    format: 'DD/MM/YYYY',
                    separator: ' - ',
                    applyLabel: 'Apply',
                    cancelLabel: 'Clear',
                    fromLabel: 'From',
                    toLabel: 'To',
                    customRangeLabel: 'Custom Range',
                    weekLabel: 'W',
                    daysOfWeek: ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'],
                    monthNames: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                    firstDay: 0
                }
            }, function (start, end, label) {
                $('#TxtFromDate').val(start.format('DD/MM/YYYY') + ' - ' + end.format('DD/MM/YYYY'));
            });

            $('#TxtFromDate').on('apply.daterangepicker', function (ev, picker) {
                var rangeStr = picker.startDate.format('DD/MM/YYYY') + ' - ' + picker.endDate.format('DD/MM/YYYY');
                $(this).val(rangeStr);
                updateActiveFilterBadge();
                loadBalanceSheetData(picker.startDate.format('DD/MM/YYYY'), picker.endDate.format('DD/MM/YYYY'));
            });

            $('#TxtFromDate').on('cancel.daterangepicker', function (ev, picker) {
                let defStart = moment().startOf('year');
                let defEnd = moment();
                picker.setStartDate(defStart);
                picker.setEndDate(defEnd);
                var rangeStr = defStart.format('DD/MM/YYYY') + ' - ' + defEnd.format('DD/MM/YYYY');
                $(this).val(rangeStr);
                updateActiveFilterBadge();
                loadBalanceSheetData(defStart.format('DD/MM/YYYY'), defEnd.format('DD/MM/YYYY'));
            });

            $('#TxtFromDate').val(start.format('DD/MM/YYYY') + ' - ' + end.format('DD/MM/YYYY'));
        }

        $('#BunSearch').on('click', function() {
            updateActiveFilterBadge();
            var dateRange = $('#TxtFromDate').val();
            if (dateRange && dateRange.includes(' - ')) {
                var dates = dateRange.split(' - ');
                loadBalanceSheetData(dates[0].trim(), dates[1].trim());
            } else if (dateRange) {
                loadBalanceSheetData(dateRange, dateRange);
            }
        });
    }

    // ─────────────────────────────────────────────────────────────
    // LOAD BALANCE SHEET DATA (POST) - Dynamic based on SystemID
    // ─────────────────────────────────────────────────────────────
    function loadBalanceSheetData(fromDate, toDate) {
        var currentSysId = getSystemParam('SystemID');
        applySystemTheme(currentSysId);

        $('#balanceSheetTable').html('<tr class="bs-header-row"><td>Account</td><td class="text-right">Amount</td></tr><tr><td colspan="2" style="text-align: center; padding: 40px; color: #94a3b8;"><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Loading data...</td></tr>');

        var filters = getAdvanceFilters();
        var dateParam = toDate;
        if (fromDate && toDate && fromDate.trim() !== toDate.trim()) {
            dateParam = fromDate.trim() + ' - ' + toDate.trim();
        } else if (!dateParam && fromDate) {
            dateParam = fromDate.trim();
        }

        var postData = {
            toDate:         dateParam,
            systemID:       currentSysId,
            warehouseID:    getSystemParam('WarehouseID'),
            txType:         filters.txType,
            accountNo:      filters.accountNo,
            name:           filters.name,
            refNo:          filters.refNo,
            createdBy:      filters.createdBy,
            classId:        filters.classId,
            location:       filters.location,
            sortBy:         filters.sortBy,
            orderBy:        filters.orderBy,
            displayColumns: filters.displayColumns
        };

        $.ajax({
            url: '@Url.Action("GetBalanceSheetData", "BalanceSheet")',
            type: 'POST',
            data: postData,
            success: function (response) {
                if (response.success) {
                    $('#dateRangeDisplay').text('To Date : ' + response.toDate);
                    if (response.company) {
                        if (response.company.CompanyNameKH) {
                            var khText = response.company.CompanyNameKH.trim();
                            if (khText && !khText.startsWith('ក្រុមហ៊ុន')) {
                                khText = 'ក្រុមហ៊ុន ' + khText;
                            }
                            $('#bsCompanyKH').text(khText);
                            window._bsCompanyKH = khText;
                        }
                        if (response.company.CompanyName) {
                            $('#bsCompanyEN').text(response.company.CompanyName);
                            window._bsCompanyEN = response.company.CompanyName;
                        }
                        if (response.company.Logo) {
                            window._bsCompanyLogo = response.company.Logo;
                        }
                    }
                    renderBalanceSheet(response.data);
                } else {
                    $('#balanceSheetTable').html('<tr class="bs-header-row"><td>Account</td><td class="text-right">Amount</td></tr><tr><td colspan="2" style="text-align: center; padding: 40px; color: #ef4444;">' + response.message + '</td></tr>');
                }
            },
            error: function () {
                $('#balanceSheetTable').html('<tr><td colspan="2" class="text-center text-danger">Error loading data.</td></tr>');
            }
        });
    }

    function formatNumber(num) {
        if (num === 0 || !num) return "-";
        var n = parseFloat(num);
        if (isNaN(n) || n === 0) return "-";
        var formatted = Math.abs(n).toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
        return n < 0 ? "<span class='negative-amount'>-" + formatted + "</span>" : formatted;
    }

    function getSelectedColumns() {
        var cols = [];
        $('#shownColumnsDropdown input[type=checkbox]:checked').each(function() {
            cols.push($(this).val());
        });
        if (cols.length === 0) cols = ['Balance'];
        return cols;
    }

    function getActiveColInfo() {
        var cols = getSelectedColumns();
        var count = 0;
        var subHeaders = '';

        if (cols.includes('Balance')) { count++; subHeaders += '<th class="text-right amount-cell">Amount</th>'; }
        if (cols.includes('ChangeDollar')) { count++; subHeaders += '<th class="text-right amount-cell">Change $</th>'; }
        if (cols.includes('ChangePercent')) { count++; subHeaders += '<th class="text-right amount-cell">Change %</th>'; }
        if (cols.includes('PercentOfRow')) { count++; subHeaders += '<th class="text-right amount-cell">% Of Row</th>'; }

        if (count === 0) { count = 1; subHeaders = '<th class="text-right amount-cell">Amount</th>'; }
        return { cols: cols, count: count, subHeaders: subHeaders };
    }

    function renderValueCells(item, isParentHeader, columns, displayCols) {
        var isPeriod = (displayCols && displayCols !== 'default' && columns && columns.length > 0) || (columns && columns.length > 1);
        if (isPeriod) {
            var cells = '';
            for (var i = 0; i < columns.length; i++) {
                if (isParentHeader) {
                    cells += '<td class="text-right amount-cell"></td>';
                } else {
                    var val = 0;
                    if (typeof item === 'number') {
                        val = item;
                    } else if (item) {
                        if (item.ColBalances && item.ColBalances.length > i) {
                            val = item.ColBalances[i];
                        } else if (item.ColTotals && item.ColTotals.length > i) {
                            val = item.ColTotals[i];
                        } else if (columns[i].Key && item.PeriodBalances && item.PeriodBalances[columns[i].Key] !== undefined) {
                            val = item.PeriodBalances[columns[i].Key];
                        } else if (item.Balance !== undefined) {
                            val = item.Balance;
                        } else if (item.Total !== undefined) {
                            val = item.Total;
                        }
                    }
                    cells += '<td class="text-right amount-cell">' + formatNumber(val) + '</td>';
                }
            }
            return cells;
        }

        // Single column mode (or Shown Columns checkboxes)
        var balance = 0;
        if (typeof item === 'number') balance = item;
        else if (item && item.Balance !== undefined) balance = item.Balance;
        else if (item && item.Total !== undefined) balance = item.Total;

        var colInfo = getActiveColInfo();
        if (isParentHeader) {
            var emptyCells = '';
            for (var j = 0; j < colInfo.count; j++) {
                emptyCells += '<td class="text-right amount-cell"></td>';
            }
            return emptyCells;
        }

        var singleCells = '';
        if (colInfo.cols.includes('Balance')) {
            singleCells += '<td class="text-right amount-cell">' + formatNumber(balance) + '</td>';
        }
        if (colInfo.cols.includes('ChangeDollar')) {
            singleCells += '<td class="text-right amount-cell">' + formatNumber(balance) + '</td>';
        }
        if (colInfo.cols.includes('ChangePercent')) {
            var pct = balance < 0 ? '-100%' : (balance > 0 ? '100%' : '-');
            singleCells += '<td class="text-right amount-cell">' + pct + '</td>';
        }
        if (colInfo.cols.includes('PercentOfRow')) {
            var pctRow = balance !== 0 ? '100%' : '-';
            singleCells += '<td class="text-right amount-cell">' + pctRow + '</td>';
        }
        return singleCells;
    }

    function renderTableHeader(toDate, columns, displayCols) {
        var isPeriod = (displayCols && displayCols !== 'default' && columns && columns.length > 0) || (columns && columns.length > 1);
        if (isPeriod) {
            var thPeriodCols = '';
            var thAmountCols = '';
            for (var i = 0; i < columns.length; i++) {
                var c = columns[i];
                thPeriodCols += '<th class="text-right amount-cell" style="font-weight:700; border-bottom:1px solid rgba(255,255,255,0.3); min-width:120px; text-align:right;">' + c.Label + '</th>';
                thAmountCols += '<th class="text-right amount-cell" style="font-size:11px; padding:6px 16px; font-weight:600; text-align:right;">' + (c.SubLabel || 'Amount') + '</th>';
            }
            return '<tr class="bs-header-row">'
                 + '<td rowspan="2" style="width:35%; min-width:280px; vertical-align:middle; font-weight:700;">Account</td>'
                 + thPeriodCols
                 + '</tr>'
                 + '<tr class="bs-header-row">' + thAmountCols + '</tr>';
        }

        var colInfo = getActiveColInfo();
        var toDateStr = toDate || 'To Date';

        if (colInfo.count === 1 && colInfo.cols.includes('Balance')) {
            return '<tr class="bs-header-row">'
                 + '<td style="width:65%">Account</td>'
                 + '<td class="text-right amount-cell" style="width:35%">Amount</td>'
                 + '</tr>';
        }

        return '<tr class="bs-header-row">'
             + '<td rowspan="2" style="width:40%; vertical-align:middle; font-weight:700;">Account</td>'
             + '<td colspan="' + colInfo.count + '" class="text-center" style="font-weight:700; border-bottom:1px solid rgba(255,255,255,0.3);">' + toDateStr + '</td>'
             + '</tr>'
             + '<tr class="bs-header-row">' + colInfo.subHeaders + '</tr>';
    }

    function renderBalanceSheet(data) {
        var now = new Date();
        var pad = function(n) { return n < 10 ? '0' + n : n; };
        var printDate = pad(now.getDate()) + '/' + pad(now.getMonth()+1) + '/' + now.getFullYear()
                      + ' ' + pad(now.getHours()) + ':' + pad(now.getMinutes());
        $('#printDateDisplay').text(printDate);

        var columns = (data && data.Columns) ? data.Columns : [];
        var displayCols = (data && data.DisplayColumns) ? data.DisplayColumns : 'default';
        var isMulti = (displayCols !== 'default' && columns && columns.length > 0) || (columns && columns.length > 1);
        var totalColCount = isMulti ? (columns.length + 1) : (getActiveColInfo().count + 1);
        var toDateStr = $('#dateRangeDisplay').text().replace('To Date : ', '').replace('As of ', '') || '';

        var html = renderTableHeader(toDateStr, columns, displayCols);

        // ASSETS section
        html += renderSection(data.Assets, columns, displayCols);
        html += '<tr class="bs-spacer"><td colspan="' + totalColCount + '"></td></tr>';

        // LIABILITIES section
        html += renderSection(data.Liabilities, columns, displayCols);
        html += '<tr class="bs-spacer"><td colspan="' + totalColCount + '"></td></tr>';

        // EQUITY section
        html += renderSection(data.Equity, columns, displayCols);
        html += '<tr class="bs-spacer"><td colspan="' + totalColCount + '"></td></tr>';

        // TOTAL LIABILITIES AND EQUITY row
        if (isMulti) {
            html += '<tr class="bs-final-total"><td>TOTAL LIABILITIES AND EQUITY</td>';
            for (var i = 0; i < columns.length; i++) {
                var totalVal = (data.TotalLiabAndEquityByPeriod && data.TotalLiabAndEquityByPeriod.length > i)
                    ? data.TotalLiabAndEquityByPeriod[i]
                    : (data.TotalLiabilities + data.TotalEquity);
                html += '<td class="text-right amount-cell">' + formatNumber(totalVal) + '</td>';
            }
            html += '</tr>';
        } else {
            html += '<tr class="bs-final-total"><td>TOTAL LIABILITIES AND EQUITY</td>' + renderValueCells(data.TotalLiabilities + data.TotalEquity, false, columns, displayCols) + '</tr>';
        }

        $('#balanceSheetTable').html(html);

        $('#summaryAssets').text(formatNumber(data.TotalAssets).replace(/<[^>]*>?/gm, ''));
        $('#summaryLiabilities').text(formatNumber(data.TotalLiabilities).replace(/<[^>]*>?/gm, ''));
        $('#summaryEquity').text(formatNumber(data.TotalEquity).replace(/<[^>]*>?/gm, ''));
    }

    // ── Level 1: Render Section (ASSETS / LIABILITIES / EQUITY) ──
    function renderSection(section, columns, displayCols) {
        if (!section || !section.Groups || section.Groups.length === 0) return '';
        var html = '';
        var isMulti = (displayCols && displayCols !== 'default' && columns && columns.length > 0) || (columns && columns.length > 1);
        var totalColCount = isMulti ? (columns.length + 1) : (getActiveColInfo().count + 1);

        html += '<tr class="bs-section-header">' +
                '<td colspan="' + totalColCount + '"><span class="collapse-icon"><i class="fas fa-chevron-down"></i></span>' +
                '<strong>' + section.SectionName + '</strong></td></tr>';

        for (var g = 0; g < section.Groups.length; g++) {
            var grp = section.Groups[g];

            // Level 2: Group Header
            if (grp.GroupName && grp.GroupName !== '') {
                html += '<tr class="bs-group-header">' +
                        '<td colspan="' + totalColCount + '"><span class="collapse-icon"><i class="fas fa-chevron-down"></i></span>' +
                        '<strong>' + grp.GroupName + '</strong></td></tr>';
            }

            for (var c = 0; c < grp.Categories.length; c++) {
                var cat = grp.Categories[c];

                // Level 3: Net Income Row
                if (cat.CategoryName === 'Net Income' && cat.Accounts.length === 1) {
                    html += "<tr class='bs-category-header'>" +
                            "<td>" + cat.Accounts[0].AccountName + "</td>" +
                            renderValueCells(cat.Accounts[0], false, columns, displayCols) +
                            "</tr>";
                    continue;
                }

                html += '<tr class="bs-category-header">' +
                        '<td colspan="' + totalColCount + '"><span class="collapse-icon"><i class="fas fa-chevron-down"></i></span>' +
                        '<strong>' + cat.CategoryName + '</strong></td></tr>';

                // Level 4: Account Rows
                html += generateRows(cat.Accounts, 1, columns, displayCols);

                var isCategoryMatchingGroup = grp.GroupName && (cat.CategoryName.trim().toLowerCase() === grp.GroupName.trim().toLowerCase());
                if (!isCategoryMatchingGroup) {
                    html += '<tr class="bs-category-total">' +
                            '<td class="text-left"><strong>Total - ' + cat.CategoryName + '</strong></td>' +
                            renderValueCells(cat, false, columns, displayCols) + '</tr>';
                }
            }

            if (grp.GroupName && grp.GroupName !== '') {
                html += '<tr class="bs-group-total">' +
                        '<td><strong>Total - ' + grp.GroupName + '</strong></td>' +
                        renderValueCells(grp, false, columns, displayCols) + '</tr>';
            }
        }

        html += '<tr class="bs-total-row">' +
                '<td><strong>Total - ' + section.SectionName + '</strong></td>' +
                renderValueCells(section, false, columns, displayCols) + '</tr>';

        return html;
    }

    // ── Recursive Account Tree Rows ──
    function generateRows(nodes, level, columns, displayCols) {
        var html = "";
        for (var i = 0; i < nodes.length; i++) {
            var node = nodes[i];
            var hasChildren = node.Children && node.Children.length > 0;

            var trClass = (level === 1) ? "bs-main-account" : "bs-sub-account";
            var displayAccount = node.AccountNo ? (node.AccountNo + " - " + node.AccountName) : node.AccountName;
            var icon = hasChildren
                ? '<span class="collapse-icon"><i class="fas fa-chevron-down"></i></span>'
                : '<span style="display:inline-block;width:20px;"></span>';

            var accountContent = displayAccount;
            if (node.IsLeaf && node.AccountNo) {
                accountContent = '<a href="javascript:void(0)" onclick="viewInvoices(\'' +
                    node.AccountNo + '\', \'' + node.AccountName.replace(/'/g, "\\'") + '\')">' +
                    displayAccount + '</a>';
            }

            html += "<tr class='" + trClass + "'>" +
                    "<td>" + icon + accountContent + "</td>" +
                    renderValueCells(node, hasChildren, columns, displayCols) +
                    "</tr>";

            if (hasChildren) {
                html += generateRows(node.Children, level + 1, columns, displayCols);
                html += "<tr class='bs-category-total'>" +
                        "<td class='text-left'><em>Total - " + displayAccount + "</em></td>" +
                        renderValueCells(node, false, columns, displayCols) +
                        "</tr>";
            }
        }
        return html;
    }

    // ── View Invoices Modal ──
  // ── View Invoices Modal ──
    function viewInvoices(accountNo, accountName) {
        var displayTitle = (accountNo ? accountNo + ' - ' : '') + accountName;
        $('#modalAccountName').text(displayTitle);
        $('#modalAccountTypeBadge').text('').hide();
        $('#invoiceTableBody').html('<tr><td colspan="8" class="text-center"><i class="fas fa-spinner fa-spin" style="margin-right:8px;"></i> Loading...</td></tr>');
        $('#invoiceModal').modal('show');

        var dateRange = $('#TxtFromDate').val();
        var fromDate = '';
        var toDate = '';

        if (dateRange && dateRange.includes(' - ')) {
            var dates = dateRange.split(' - ');
            fromDate = dates[0].trim();
            toDate = dates[1].trim();
        } else if (dateRange) {
            fromDate = dateRange.trim();
            toDate = dateRange.trim();
        }

        var postData = {
            accountNo:   accountNo,
            accountName: accountName,
            fromDate:    fromDate,     // <-- Send selected fromDate (01/07/2026)
            toDate:      toDate,       // <-- Send selected toDate (31/07/2026)
            systemID:    getSystemParam('SystemID'),
            warehouseID: getSystemParam('WarehouseID')
        };

        $.ajax({
            url: '@Url.Action("GetAccountInvoices", "BalanceSheet")',
            type: 'POST',
            data: postData,
            success: function(res) {
                if(res.success) {
                    var html = '';
                    var totalDeb = 0;
                    var totalCred = 0;
                    var runningBal = 0;
                    var accType = (res.data && res.data.length > 0) ? (res.data[0].AccountTypes || 'Asset') : 'Asset';
                    var isAssetOrExp = (accType.toLowerCase().indexOf('asset') >= 0 || accType.toLowerCase().indexOf('expense') >= 0);

                    if (res.data && res.data.length > 0) {
                        $('#modalAccountTypeBadge').text(accType).show();
                    }

                    for (var i = 0; i < res.data.length; i++) {
                        var item = res.data[i];

                        if (isAssetOrExp) {
                            runningBal += (item.Debit - item.Credit);
                        } else {
                            runningBal += (item.Credit - item.Debit);
                        }

                        // Accumulate all rows including OPENING so footer totals balance correctly
                        totalDeb += (Number(item.Debit) || 0);
                        totalCred += (Number(item.Credit) || 0);

                        var invNo = item.InvoiceNo;
                        if (!invNo || invNo === 'null' || invNo === 'undefined') {
                            invNo = '-';
                        }
                        var invType = (item.InvoiceType && item.InvoiceType !== 'null') ? item.InvoiceType : 'Journal Entry';
                        var desc = (item.Description && item.Description !== 'null') ? item.Description : '';

                        html += '<tr>';
                        html += '<td>' + item.No + '</td>';
                        html += '<td><strong>' + invNo + '</strong></td>';
                        html += '<td>' + (item.InvoiceDate || '') + '</td>';
                        html += '<td><span class="badge badge-light" style="font-weight:600;">' + invType + '</span></td>';
                        html += '<td class="text-right">' + (item.Debit !== 0 ? formatNumber(item.Debit) : '-') + '</td>';
                        html += '<td class="text-right">' + (item.Credit !== 0 ? formatNumber(item.Credit) : '-') + '</td>';
                        html += '<td class="text-right" style="font-weight:600;">' + formatNumber(runningBal) + '</td>';
                        html += '<td>' + desc + '</td>';
                        html += '</tr>';
                    }

                    if(res.data.length === 0) {
                        html = '<tr><td colspan="8" class="text-center text-muted" style="padding:24px;">No transactions found for this period.</td></tr>';
                    }

                    $('#invoiceTableBody').html(html);
                    $('#totalDebit').html(formatNumber(totalDeb));
                    $('#totalCredit').html(formatNumber(totalCred));
                    $('#totalNetBalance').html(formatNumber(runningBal));
                }
            }
        });
    }

