                    .bs-main-account td { padding-left: 45px; color:#000000; }
                    .bs-sub-account td { padding-left: 70px; color:#000000; }
                    .bs-category-total td { font-weight: bold; font-style: italic; padding-left: 45px; color:#000000; }
                    .bs-group-total td { font-weight: bold; background: #e8f0f7; padding-left: 25px; color:#000000; }
                    .bs-total-row td { font-weight: bold; border-top: 2px solid #ddd; background: #f5f5f5; color:#000000; }
                    .bs-final-total td { font-weight: bold; font-size: 15px; background: ${theme.primary}; color: #000000; }
                </style>
            </head>
            <body>
                ${companyHeader}
                ${tableContent}
            </body>
            </html>
        `);
        win.document.close();
        setTimeout(function () { win.print(); }, 800);
    }

    // ── Export to Excel ──
    function ExportExcel() {
        var table = document.getElementById("balanceSheetTable");
        if (!table) return;
        var wb = XLSX.utils.table_to_book(table, { sheet: "Balance Sheet" });
        XLSX.writeFile(wb, "BalanceSheet.xlsx");
    }

    // ── Initialize on Document Ready ──
    $(document).ready(function() {
        var currentSysId = getSystemParam('SystemID');
        applySystemTheme(currentSysId);

        initializeDateRangePicker();
        loadFilterOptions();

        var dateRange = $('#TxtFromDate').val();
        if (dateRange && dateRange.includes(' - ')) {
            var dates = dateRange.split(' - ');
            loadBalanceSheetData(dates[0].trim(), dates[1].trim());
        } else if (dateRange) {
            loadBalanceSheetData(dateRange, dateRange);
        }
    });
</script>
