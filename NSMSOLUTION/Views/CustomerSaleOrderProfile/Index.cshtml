    function CustomerChangePlan(BillingInvoiceID, PackageDetailID, ConnectionID) {
        Customer_ID = (typeof Customer_ID == "undefined" ? "" : Customer_ID);
        if (Customer_ID == "") {
            var url = window.location.hash;
            var ID = url.substring(url.indexOf('?'));
            Customer_ID = ID.substring(ID.indexOf('=')).replace(/=/g, '');
        }
        //number 2 for create invoicing...
        var Data = [];
        var obj = {};
        obj = {
            PrimaryFieldValue: "2",
            InvoiceNo: "0",
            CustomerID: "" + Customer_ID + "",
            FormStatus: "CreateInvoice",
            ChangePlan: true,
            BillingInvoiceID: BillingInvoiceID,
            PackageDetailID: PackageDetailID,
            ConnectionID: ConnectionID
        };
        Data.push(obj);
        AddQuotation(obj, "Create Customer Invoice");
    }
