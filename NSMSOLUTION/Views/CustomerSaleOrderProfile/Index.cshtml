<script>
    var NewServiceProduct = "@ViewBag.NewServiceProduct";
    var ShowCustomerInvoiceProfile = "";
    var CustomerID = "@ViewBag.CustomerID";
    var ISSO = "@ViewBag.ISSO";
    var roleCustomerProfileAttachment = "@ViewBag.roleCustomerProfileAttachment";
    var Customer_ID = "";
    //var Cust_Info = "@ViewBag.CustInfo";
    var CustDetail = "@ViewBag.CustDetail";
    var ExchangeRate = "@ViewBag.ExchangeRate";
    ExchangeRate = JSON.parse(ExchangeRate.replace(/&quot;/ig, '"'))[0];
    var CustomerTypeID = 0;
    var CustomerCode = "";
    var Commune = "", District = "", ProvinceCity = "";
    var BusinessTypeID = 0;
    var Cust_Name = "";
    var ServiceID = "";
    var ConnectionTypeID = "";
    var PackageDetailID = "";
    var BillingInvoiceID = "";
    var IndustryTypeData = "";
    var CommuneData = "";

    function LoadCustInfo(CustomerID) {
        LoadData("CustomerSaleOrderProfile/LoadCustInfo?ID=" + CustomerID, function (response) {
            var CustInfo = JSON.parse(JSON.parse(response).data)[0];
            Cust_Name = CustInfo.Cust_Name;
            Customer_ID = CustomerID;
            var row = '<div class="row">';
            row += '<div class="col-auto text-left"><i class="far fa-star"></i></div>';
            row += '<div class="col text-left">' + CustInfo.CustomerType + '</div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-user"></i></div>';
            row += '<div class="col text-left"><label>' + CustInfo.FullCustomerName + '</label></div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-phone"></i></div>';
            row += '<div class="col text-left">' + CustInfo.CustomerMobile + '</div>';
            row += '</div>';
            if (CustInfo.CustomerEmail != "") {
                row += '<div class="row">';
                row += '<div class="col-auto text-left"><i class="fa fa-envelope"></i></div>';
                row += '<div class="col text-left">' + CustInfo.CustomerEmail + '</div>';
                row += '</div>';
            }
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-building"></i></div>';
            row += '<div class="col text-left">' + CustInfo.Address + '.</div>';
            row += '</div>';
            $("div#CustInfo").html(row);
            row = '';
            if (CustInfo.IndustryType != null) {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">Business Type:</div>';
                row += '<div class="col-4 text-left">' + CustInfo.IndustryType + '</div>';
                row += '</div>';
            }
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Register Date:</div>';
            row += '<div class="col-4 text-left">' + CustInfo.RegisterDate + '</div>';
            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Nationality:</div>';
            row += '<div class="col-4 text-left">' + CustInfo.CustomerNationality + '</div>';
            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Identification / Passport No:</div>';
            row += '<div class="col-4 text-left text-truncate" title="' + CustInfo.CustomerIdentification + '">' + CustInfo.CustomerIdentification + '</div>';
            row += '</div>';
            if (CustInfo.EmployeeName != null) {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">' + "Sale's Name:" + '</div>';
                row += '<div class="col-4 text-left text-nowrap">' + CustInfo.EmployeeName + '</div>';
                row += '</div>';
            }
            if (CustInfo.ContactName != null && CustInfo.ContactName != "") {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">' + "Contact Name:" + '</div>';
                row += '<div class="col-4 text-left">' + CustInfo.ContactName + '</div>';
                row += '</div>';
            }
            $("div#CustInfo-left").html(row);
        });
    }
    function LoadCustomerServices(CustomerID) {
        LoadData("CustomerSaleOrderProfile/LoadCustomerServices?CustomerID=" + CustomerID, function (response) {
            var CustomerServices = JSON.parse(JSON.parse(response).data);
            var UpgradeP = JSON.parse(JSON.parse(response).UpgradeP);
            var row = '';
            var rowdata = '<div id="Carousel_CustService" class="carousel slide" data-ride="carousel">';
            var carousel_indicators = '<ol class="carousel-indicators carousel-indicators-numbers">';
            var carousel_inner = '<div class="carousel-inner">';
            var Length = CustomerServices.length;
            var CustServicesList = CustomerServices;
            if (Length > 1) {
                CustServicesList = CustomerServices.filter(function (item) {
                    return item.RemainDay != "Expired" && item.RemainDay != "0 days";
                });
                Length = CustServicesList.length;
                if (Length == 0) {
                    CustServicesList = CustomerServices.filter(function (item) {
                        return item.RemainDay = "Expired" || item.RemainDay == "0 days";
                    });
                }
                Length = CustServicesList.length;
            }
            $.each(CustServicesList, function (key, CustDetail) {
                row = '<div class=\"row\"><div class=\"col\">';
                row += '<div class="btn-group">';
                if (CustServicesList[key].ConnectivityStatus == 40) {
                    row += '<label class="btn bg-primary active text-uppercase">Status: ' + CustServicesList[key].Status + '</label>';
                    if (CustServicesList[key].ConnectionType == "PPPoE") {
                        row += '<label class="btn bg-cyan">PPPoE User: ' + CustServicesList[key].PPPoEUserName + '</label>';
                    } else {
                        row += '<label class="btn bg-cyan">IP Address: ' + CustServicesList[key].IPAddress + '</label>';
                    }
                }
                else if (CustServicesList[key].ConnectivityStatus == 41) {
                    row += '<label class="btn bg-warning active text-uppercase"><span class="text-white">Status: ' + CustServicesList[key].Status + '</span></label>';
                    if (CustServicesList[key].ConnectionType == "PPPoE") {
                        row += '<label class="btn bg-cyan">PPPoE User: ' + CustServicesList[key].PPPoEUserName + '</label>';
                    } else {
                        row += '<label class="btn bg-cyan">IP Address: ' + CustServicesList[key].IPAddress + '</label>';
                    }
                }
                else {
                    row += '<label class="btn bg-danger active text-uppercase">Status: ' + CustServicesList[key].Status + '</label>';
                    if (CustServicesList[key].ConnectionType == "PPPoE") {
                        row += '<label class="btn bg-cyan">PPPoE User: ' + CustServicesList[key].PPPoEUserName + '</label>';
                    } else if (CustServicesList[key].IPAddress != null) {
                        row += '<label class="btn bg-cyan">IP Address: ' + CustServicesList[key].IPAddress + '</label>';
                    }
                }
                row += '</div></div></div>';
                row += '<div class="row"><div class="col">';
                if (CustServicesList[key].ConnectionType != "PPPoE" && CustServicesList[key].ConnectionType != '') {
                    row += '<label class="col-form-label">Vlan Name: ' + CustServicesList[key].VLanName + '</label>';
                }
                else {
                    row += '<label class="col-form-label">&nbsp;</label>';
                }
                row += '</div></div>';

                if (UpgradeP.length > 0) {
                    var bilID = CustServicesList[key].BillingInvoiceID;
                    $.each(UpgradeP, function (k, v) {
                        if (bilID == v.BillingInvoiceID) {
                            row += v.NewPackageName;
                        }
                    });
                }

                ServiceID = CustDetail.ServiceID;
                ConnectionTypeID = CustDetail.PackageTypeID;
                PackageDetailID = CustDetail.PackageDetailID;
                BillingInvoiceID = CustDetail.BillingInvoiceID;
                var RemainDay = CustDetail.RemainDay;
                row += '<div class="description-block text-left">';
                //row += `<h6 class="text-dark">Connection ID: ` + CustDetail.ConnectionID + `, <label>Service ID: ` + CustDetail.SID + `, Ticket#: <a href="javascript:void(0);" onclick="onGridTicketClick('', ` + CustDetail.OpenTicketID + `, '` + CustDetail.TicketNumber +`');">` + CustDetail.TicketNumber + `</a></label></h6>`;
                row += '<h5 class="description-header text-danger">Service Plan: ' + CustDetail.ServiceName + '</h5>';
                if (CustDetail.OldPlanName != '') {
                    row += '<div class="row text-dark"><div class="col text-warning">Customer Change Plan From:</div></div>';
                    row += '<div class="row text-dark"><div class="col"><span>' + CustDetail.OldPlanName + '</span></div></div>';
                    row += '<div class="row"><div class="col text-danger">To: ';
                    row += '<span class="text-danger">' + CustDetail.PackageName + ' - ' + CustDetail.Bandwidth + ' Mbps' + ' - ' + CustDetail.UM + '</span></div></div></div>';
                }
                else
                    row += '<span class="text-dark">' + CustDetail.PackageName + ' - ' + CustDetail.Bandwidth + ' Mbps' + ' - ' + CustDetail.UM + '</span></div>';
                row += '<div class="row ">';
                row += '<div class="col-auto description-block text-left">';
                //row += '<label class="text-primary">' + CustDetail.UM;
                row += '<h5 class="description-header text-primary">' + CustDetail.UM;
                row += ' From ' + $.format.date(new Date(CustDetail.StartDate), 'dd-MMMM-yyyy') + ' To ' + $.format.date(addMonths(new Date(CustDetail.EndDate), -CustDetail.FreeDuration), 'dd-MMMM-yyyy');
                row += '</h5>';//row += '</h5></div>';
                //row += '</div>';
                if (CustDetail.FreeDuration > 0) {
                    //row += '<div class="row">';
                    //row += '<div class="col-auto">';
                    row += '<span class="text-danger">Free ' + CustDetail.FreeDuration + returnMonth(CustDetail.FreeDuration);
