@{
    Layout = null;
}

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

@* ── GRID MODE (Index page) ─────────────────────────────────────────── *@
@if (ViewBag.DrawHTMLSearchForm != null)
{
    @Html.Raw(ViewBag.DrawHTMLSearchForm)
}

<script>
    function showFundTransferForm(fundTransferId, refNo) {
        var URL = "/FundTransfer/InvoiceTMP?FundTransferID=" + fundTransferId + "&RefNo=" + refNo;
        // EXACT match of PO call parameters: "Auto" for width, "500" for height
        ShowDialogBox("Preview FT No.: " + refNo, "Auto", "500", URL);
    }
</script>

@* ── FORM MODE (inside dialog box via CreateFundTransfer) ──────────── *@
@if (ViewBag.DrawHTMLForm != null)
{
    @Html.Raw(ViewBag.DrawHTMLForm)

    <div id="divAttachmentButtonContainer" style="display:none;">
        <a href="javascript:void(0)" id="btnAddAttachmentFile" class="btn btn-info" onclick="AddAttachmentFile();" style="border-radius: 8px; font-weight: 500;">
            <i class="fa fa-paperclip"></i> Add Attachment
        </a>
    </div>
}

@* ── Fallback ───────────────────────────────────────────────────────── *@
@if (ViewBag.DrawHTMLForm == null && ViewBag.DrawHTMLSearchForm == null)
{
    <div class="alert alert-info">
        <h4>Fund Transfer</h4>
        <p>Loading…</p>
    </div>
}

<script>
    // Helper to get Kendo value or fallback to standard val()
    function getVal(id) {
        var cb = $(id).data("kendoComboBox") || $(id).data("kendoMultiColumnComboBox");
        return cb ? cb.value() : $(id).val();
    }

    $(document).ready(function() {
        // Move the attachment button to the modal footer next to Save/Close
        setTimeout(function() {
            var $btn = $('#btnAddAttachmentFile').detach();
            // Try common modal footer classes (Bootstrap or jQuery UI)
            var $footer = $('.modal-footer, .ui-dialog-buttonpane');
            if ($footer.length > 0) {
                $footer.prepend($btn);
                $btn.show();
                $btn.css({'margin-right': 'auto'}); // Push it to the left side of the footer or keep it in row
            } else {
                // Fallback: show it if footer not found
                $('#divAttachmentButtonContainer').show();
                $('#btnAddAttachmentFile').show();
            }
        }, 500);

        // Load initial balances if editing an existing record
        setTimeout(function() {
            var ftID = $("#FundTransferID").val();
            if (ftID && ftID != '0' && ftID != '') {
                // If editing, trigger the load balance logic for already selected accounts
                $("#FromAccountID, #ToAccountID").trigger('change');
            }
        }, 1000);
    });

    function AddAttachmentFile() {
        $("#AttachmentFile").click();
    }

    function ShowExistingAttachments() {
        var file = $("#AttachmentFile").val();
        if (file) {
            DialogSweetAlert("info", "Attached: " + file.split('\\').pop());
        } else {
            DialogSweetAlert("info", "No file selected.");
        }
    }

    function SaveChangeFundTransfer() {
        if (!validateInput("FundTransferForm")) {
            return;
        }

        var formData = new FormData();
        var data = $("form[name='FundTransferForm']").serializeObject();
        
        // Add Kendo/Custom values
        data.FromAccountID = getVal("#FromAccountID");
        data.ToAccountID = getVal("#ToAccountID");
        data.ClassName = getVal("#ClassName");
        data.PaymentMethodID = getVal("#PaymentMethodID");

        formData.append("FundTransferData", JSON.stringify(data));

        // Add the file from the hidden input generated by HTML.cs
        var fileInput = document.getElementById('AttachmentFile');
        if (fileInput && fileInput.files.length > 0) {
            for (var i = 0; i < fileInput.files.length; i++) {
                formData.append("AttachmentFile", fileInput.files[i]);
            }
        }

        var URL  = '@Url.Action("SaveChangeFundTransfer", "FundTransfer")';
        
        // Add loading state
        var $btn = $("button:contains('Save Change'), .btn-primary:visible").last();
        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Saving...');

        $.ajax({
            url: URL,
            type: 'POST',
            data: formData,
            processData: false, 
            contentType: false, 
            headers: { "Authorization": "Bearer " + (typeof access_Token !== 'undefined' ? access_Token : '') },
            success: function (response) {
                $btn.prop('disabled', false).html(originalHtml);
                if (response.Result == 2 || response.Result == "Successful") {
                    Swal.close();
                    $("#CloseModal").click();

                    // Refresh grid
                    if (typeof LoadTableGrid === "function") {
                        LoadTableGrid(1);
                    } else if (typeof LoadData === "function") {
                        LoadData();
                    }

                    // Trigger the notification callback
                    if (typeof SaveChangeCallbackFunction === "function") {
                        SaveChangeCallbackFunction(response);
                    }
                } else {
                    Swal.close();
                    DialogSweetAlert("error", response.Message || "Failed to save transfer.");
                }
            },
            error: function(xhr) {
                $btn.prop('disabled', false).html(originalHtml);
                Swal.close();
                DialogSweetAlert("error", "An error occurred while communicating with the server.");
            }
        });
    }

    function SaveChangeCallbackFunction(response) {
        // Telegram notification is now sent server-side (C#) for both new and edit saves.
        // No additional client-side action needed.
    }

    function DeleteFundTransfer(obj) {
        var id = GetGridPrimaryFieldValue(obj);
        ConfirmDelete(function () {
            var url = "FundTransfer/DeleteFundTransfer";
            var data = { ID: id };
            DoDeleteAjax(url, data, "Deleting Transfer...", function (response) {
                if (response.Result == "1" || response.Result == 1) {
                    if (typeof LoadTableGrid === "function") {
                        LoadTableGrid(1);
                    } else if (typeof LoadData === "function") {
                        LoadData();
                    }
                } else {
                    DialogSweetAlert("error", response.Message || "Failed to delete transfer.");
                }
            });
        });
    }

    // ─── Transfer Amount Auto Validation ────────────────────────────────────
    $(document).on('input change blur', '#TransferAmount', function() {
        validateTransferAmount();
    });

    function validateTransferAmount() {
        var amount = $('#TransferAmount').val();
        var $parent = $('#TransferAmount').closest('div');
        
        // Remove commas for validation
        var cleanAmount = amount.replace(/,/g, '');
        var numAmount = parseFloat(cleanAmount);
        
        // Check if amount is valid
        if (!amount || amount.trim() === '' || isNaN(numAmount) || numAmount <= 0) {
            $parent.addClass('alert-validate');
            $parent.attr('data-validate', 'Transfer amount must be greater than zero.');
            return false;
        } else {
            $parent.removeClass('alert-validate');
            $parent.removeAttr('data-validate');
            
            // Also validate against available balance if FromAccount is selected
            var fromBalance = $('#FromBalance').val();
            if (fromBalance && fromBalance !== '$0.00') {
                var cleanBalance = fromBalance.replace(/[$,]/g, '');
                var numBalance = parseFloat(cleanBalance);
                
                if (numAmount > numBalance) {
                    $parent.addClass('alert-validate');
                    $parent.attr('data-validate', 'Amount exceeds available balance ($' + numBalance.toFixed(2) + ')');
                    return false;
                }
            }
        }
        return true;
    }

    // ─── Account Balance Logic ──────────────────────────────────────────────
    $(document).on('change select', '#FromAccountID, #ToAccountID', function() {
        var id = $(this).val();
        var targetId = (this.id == 'FromAccountID') ? 'FromBalance' : 'ToBalance';

        // Handle Kendo ComboBox value if standard val() is empty
        if (!id) {
            id = getVal(this);
        }

        if(id && id != '0' && id != '') {
            LoadBalance(id, targetId);
            // Re-validate amount when balance changes
            if (this.id == 'FromAccountID') {
                setTimeout(function() { validateTransferAmount(); }, 500);
            }
        } else {
            $('#' + targetId).val('$0.00');
        }
    });

    // Also attach to Kendo's internal change event just in case
    setTimeout(function() {
        var fromCb = $("#FromAccountID").data("kendoComboBox") || $("#FromAccountID").data("kendoMultiColumnComboBox");
        if (fromCb) {
            fromCb.bind("change", function() { $("#FromAccountID").trigger('change'); });
        }
        var toCb = $("#ToAccountID").data("kendoComboBox") || $("#ToAccountID").data("kendoMultiColumnComboBox");
        if (toCb) {
            toCb.bind("change", function() { $("#ToAccountID").trigger('change'); });
        }
    }, 500);

    function LoadBalance(accountId, targetId) {
        var url = (typeof ServerRoot !== 'undefined') ? ServerRoot + 'FundTransfer/GetAccountBalance' : '/FundTransfer/GetAccountBalance';
        $.ajax({
            url: url,
            type: 'GET',
            data: { AccountID: accountId },
            headers: { "Authorization": "Bearer " + (typeof access_Token !== 'undefined' ? access_Token : '') },
            success: function(res) {
                // Real net balance: DR-CR for Debit-normal, CR-DR for Credit-normal
                $('#' + targetId).val('$' + res.Balance);
            },
            error: function(xhr) {
                 console.error("Balance load failed:", xhr.status, xhr.responseText);
            }
        });
    }
    // ─── Prefix Logic ───────────────────────────────────────────────────────
    $(document).on('change select', '#ClassName', function() {
        var classId = $(this).val();

        // Handle Kendo ComboBox value if standard val() is empty
        if (!classId) {
            classId = getVal(this);
        }

        if(classId && classId != '0' && classId != '') {
            LoadPrefixByClass(classId);
        }
    });

    // Also attach to Kendo's internal change event just in case
    setTimeout(function() {
        var classCb = $("#ClassName").data("kendoComboBox") || $("#ClassName").data("kendoMultiColumnComboBox");
        if (classCb) {
            classCb.bind("change", function() { $("#ClassName").trigger('change'); });
        }
    }, 500);

    function LoadPrefixByClass(classId) {
        var url = (typeof ServerRoot !== 'undefined') ? ServerRoot + 'FundTransfer/GetPrefixByClass' : '/FundTransfer/GetPrefixByClass';
        $.ajax({
            url: url,
            type: 'GET',
            data: { ClassID: classId },
            headers: { "Authorization": "Bearer " + (typeof access_Token !== 'undefined' ? access_Token : '') },
            success: function(res) {
                $('#RefNo').val(res.Prefix);
            },
            error: function(xhr) {
                 console.error("Prefix load failed:", xhr.status, xhr.responseText);
            }
        });
    }
</script>
