@{ Layout = null; }

<style>
    .invoice-content-area {
        line-height: 1.4 !important;
    }

    @@media print {
        .no-print {
            display: none !important;
        }
        .modal-backdrop,
        .modal .card-default,
        .modal .card-header,
        .modal-footer,
        .modal .close,
        .modal .dropdown-menu {
            display: none !important;
        }
        .modal-body {
            border: none !important;
            box-shadow: none !important;
            overflow: visible !important;
            padding: 0 !important;
        }
        .modal-dialog {
            max-width: 100% !important;
            width: 100% !important;
            margin: 0 !important;
        }
        body {
            margin: 0 !important;
            padding: 0 !important;
            overflow: visible !important;
        }
        .invoice-content-area {
            margin: 0 !important;
            padding: 0 !important;
        }
    }
</style>

<nav class="navbar sticky-top justify-content-end p-2 no-print">
    <div class="btn-group flex-wrap panel-toolbar gap-8 px-3 py-2" role="group">
        <button type="button" id="Edit" class="btn btn-warning btn-sm" data-toggle="tooltip" title="Edit">
            <i class="ti ti-pencil-minus"></i> <span class="d-none d-md-inline">Edit</span>
        </button>
        <button type="button" id="ShowHideImages" class="btn btn-danger btn-sm" data-toggle="tooltip" title="Show/Hide Images">
            <i class="ti ti-eye-off"></i> <span class="d-none d-md-inline">Hide Images</span>
        </button>
        <button type="button" id="CloneFT" class="btn btn-secondary btn-sm" data-toggle="tooltip" title="Clone FT">
            <i class="ti ti-copy"></i> <span class="d-none d-md-inline">Clone FT</span>
        </button>

        <!-- Send Email Dropdown -->
        <div class="btn-group">
            <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                <i class="ti ti-mail"></i> <span class="d-none d-md-inline">Send Email</span>
            </button>
            <div class="dropdown-menu" role="menu">
                <button class="dropdown-item" id="mail_ft_created">FT Created</button>
                <button class="dropdown-item" id="mail_ft_confirmation">Payment Confirmation</button>
            </div>
        </div>

        <!-- PDF Dropdown -->
        <div class="btn-group">
            <button type="button" class="btn btn-info btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                <i class="ti ti-file-type-pdf"></i> <span class="d-none d-md-inline">PDF</span>
            </button>
            <div class="dropdown-menu" role="menu">
                <button id="View_PDF_FT" class="dropdown-item">View PDF</button>
                <button id="Download_PDF_FT" class="dropdown-item">Download PDF</button>
            </div>
        </div>

        <button type="button" id="NewFT" class="btn btn-secondary btn-sm" data-bs-toggle="tooltip" title="New FT">
            <i class="ti ti-file-plus"></i> <span class="d-none d-md-inline">New FT</span>
        </button>

        <button type="button" id="Print" class="btn btn-default btn-sm" data-bs-toggle="tooltip" title="Print">
            <i class="ti ti-printer"></i> <span class="d-none d-md-inline">Print</span>
        </button>
    </div>
</nav>



<div id="div_FT_Content" class="bg-white p-2">
    <!-- Actual Invoice Content will be loaded here -->
    <div class="invoice-content-area"></div>
</div>

<script>
    var FTID = "@ViewBag.FundTransferID";
    var RefNo = "@ViewBag.RefNo";

    $(function () {
        // Load the actual invoice content
        LoadInvoiceContent();

        // Top Button Actions
        $("#Print").click(function () {
            window.print();
        });

        $("#ShowHideImages").click(function () {
            $('.img').toggle();
            $(this).html($('.img').is(':hidden') ? '<i class="ti ti-eye"></i> Show Images' : '<i class="ti ti-eye-off"></i> Hide Images');
        });

        $("#Edit").click(function () {
            var url = '@Url.Action("CreateFundTransfer", "FundTransfer")?PrimaryFieldValue=' + FTID;
            ShowDialogBox("Edit Fund Transfer", "Auto", 600, url, FTID);
        });

        $("#CloneFT").click(function () {
            var url = '@Url.Action("CreateFundTransfer", "FundTransfer")?PrimaryFieldValue=' + FTID + '&Type=Clone';
            ShowDialogBox("Clone Fund Transfer", "Auto", 600, url, FTID);
        });

        $("#NewFT").click(function () {
            var url = '@Url.Action("CreateFundTransfer", "FundTransfer")?PrimaryFieldValue=0';
            ShowDialogBox("New Fund Transfer", "Auto", 600, url, 0);
        });

        // Email dropdown click actions
        $("#mail_ft_created").click(function () {
            sendEmail("mail_ft_created");
        });

        $("#mail_ft_confirmation").click(function () {
            sendEmail("mail_ft_confirmation");
        });

        // Modal Footer Adjustments (Matching PO)
        setTimeout(function() {
            // Rename "Save Change" to "Print" and wire up print action
            var $saveBtn = $("#SaveChange");
            if ($saveBtn.length) {
                $saveBtn.html('<i class="ti ti-printer"></i> Print');
                $saveBtn.removeClass('btn-outline-secondary btn-outline-info btn-outline-warning btn-outline-danger btn-secondary btn-light btn-info btn-primary').addClass('btn-outline-primary');
                $saveBtn.off('click').on('click', function() {
                    window.print();
                });

                // Add "Request Edit" and "Cancel" before Print in the footer (Matching PO Colors)
                var extraBtns = '<div class="mr-2"><button type="button" id="RequestEdit" class="btn btn-info"><i class="ti ti-send-2"></i> Request Edit FT</button></div>';
                extraBtns += '<div class="mr-2"><button type="button" id="CancelFT" class="btn btn-warning"><i class="ti ti-circle-dashed-x"></i> Cancel FT</button></div>';
                $saveBtn.before(extraBtns);

                $("#RequestEdit").click(function() {
                    DialogSweetAlert("info", "Request Edit FT functionality triggered.");
                });
                $("#CancelFT").click(function() {
                    DialogSweetAlert("info", "Cancel FT functionality triggered.");
                });

                // Load and render action buttons (Check / Verify / Approve / Disapprove) in the footer
                LoadApprovalButtons($saveBtn);
            }
        }, 500);
    });

    function sendEmail(emailType) {
        var payTo = $(".mytable-head").first().find("tr:eq(0) td:eq(1)").text().trim();
        var companyName = $(".mytable-head").first().find("tr:eq(1) td:eq(1)").text().trim();
        var transferDate = $(".mytable-head").last().find("tr:eq(0) td:eq(1)").text().trim();
        var voucherNo = $(".mytable-head").last().find("tr:eq(1) td:eq(1)").text().trim();
        
        var grandTotalText = $(".main-tbl tr.total td.r").text().replace("$", "").trim();
        var grandTotal = parseFloat(grandTotalText.replace(/,/g, '')) || 0;

        var Data = {
            InvoiceNo: voucherNo || RefNo,
            CustomerName: payTo || "Accounting Department",
            CustomerCode: voucherNo || RefNo,
            CustomerEmail: "",
            ServiceName: "Fund Transfer Voucher (" + (voucherNo || RefNo) + ")",
            InvoiceDate: transferDate || new Date().toDateString(),
            PaymentDueDate: transferDate || new Date().toDateString(),
            GrandTotal: grandTotal,
            PDF_FileName: "",
            PNG_FileName: "",
            InvoiceFileName: "",
            EmailType: emailType,
            CEmail: "billing@nsmsolution.com.kh",
            CPhone: "Customer Service",
            CompanyAddress: ""
        };

        var URL = '@Url.Content("~/")' + "SendEmail?InvoiceNo=" + (voucherNo || RefNo);
        let HTMLData = $(".invoice-content-area").html();
        let FileName = voucherNo || RefNo;

        DialogSweetAlert("info", "Generating attachment...");

        HTMLDataToPDF(HTMLData, FileName, function (response) {
            DialogSweetAlert("close");
            try {
                response = JSON.parse(response).Data;
                let OutPutFile = response.OutPutFile;
                let OutPutUrlFile = response.OutPutUrlFile;
                let OutPutUrlImg = response.OutPutUrlImg;

                Data["PDF_FileName"] = OutPutUrlFile;
                Data["PNG_FileName"] = OutPutUrlImg;
                Data["InvoiceFileName"] = OutPutFile;

                ShowDialogBox("Send Fund Transfer", 900, 500, URL, Data, "Dialog_SendMail", "", "", "", function (res) {
                    // Send Email complete callback
                });
            } catch (err) {
                console.error(err);
                DialogSweetAlert("error", "Failed to generate attachment.");
            }
        }, 'True');
    }

    function LoadInvoiceContent() {
        var url = '@Url.Action("Invoice", "FundTransfer")?FundTransferID=' + FTID + '&RefNo=' + RefNo + '&_=' + new Date().getTime();
        $.get(url, function (result) {
            var $wrapper = $("<div>").html(result);

            var $styles = $wrapper.find("style");
            if ($styles.length) {
                $("head").find("style.ft-invoice-inline").remove();
                $styles.addClass("ft-invoice-inline");
                $("head").append($styles);
            }

            var scripts = [];
            $wrapper.find("script").each(function () {
                var $script = $(this);
                if ($script.attr("src")) {
                    var scriptEl = document.createElement("script");
                    scriptEl.src = $script.attr("src");
                    document.body.appendChild(scriptEl);
                } else {
                    scripts.push($script.html());
                }
                $script.remove();
            });

            var $content = $wrapper.find("#FT_Doc");
            if ($content.length === 0) {
                $content = $wrapper;
            }

            $(".invoice-content-area").html($content.prop("outerHTML"));

            scripts.forEach(function (code) {
                var scriptEl = document.createElement("script");
                scriptEl.type = "text/javascript";
                scriptEl.text = code;
                document.body.appendChild(scriptEl);
            });
        });
    }

    function ExportToPDF(isDownload) {
        var fileName = "FT_" + RefNo;
        var htmlContent = $(".invoice-content-area").html();
        HTMLDataToPDF(htmlContent, fileName, function (response) {
            if (response && response.length > 5) {
                window.open("@Url.Content("~/")" + response, "_blank");
            }
        }, isDownload || "False");
    }
    
    $("#View_PDF_FT").click(function() {
        ExportToPDF("False");
    });

    $("#Download_PDF_FT").click(function() {
        ExportToPDF("True");
    });

    // ── Load the FT status and render footer approval buttons ──────────────────
    function LoadApprovalButtons($saveBtn) {
        if (!FTID || FTID == "0") return;
        var url = '@Url.Action("GetFundTransferStatus", "FundTransfer")?FundTransferID=' + FTID;
        $.ajax({
            url: url,
            type: 'GET',
            headers: { "Authorization": "Bearer " + (typeof access_Token !== 'undefined' ? access_Token : '') },
            success: function (res) {
                var statusID = res.StatusID || 0;
                var btnsHtml = "";

                // StatusID flow: 60=Pending → 92=Checked → 102=Verified → 90=Approved
                // 91=Disapproved at any step
                if (statusID == 60) {
                    // Pending: show Check + Disapprove
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnCheckFT" class="btn btn-info"><i class="ti ti-writing"></i> Check</button></div>';
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnDisapproveFT" class="btn btn-danger"><i class="ti ti-circle-x"></i> Disapprove</button></div>';
                } else if (statusID == 92) {
                    // Checked: show Verify + Disapprove
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnVerifyFT" class="btn btn-primary"><i class="ti ti-shield-check"></i> Verify</button></div>';
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnDisapproveFT" class="btn btn-danger"><i class="ti ti-circle-x"></i> Disapprove</button></div>';
                } else if (statusID == 102) {
                    // Verified: show Approve + Disapprove
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnApproveFT" class="btn btn-success"><i class="ti ti-circle-check"></i> Approve</button></div>';
                    btnsHtml += '<div class="mr-2"><button type="button" id="btnDisapproveFT" class="btn btn-danger"><i class="ti ti-circle-x"></i> Disapprove</button></div>';
                }

                if (btnsHtml !== "") {
                    // Insert the buttons before the Print button
                    $saveBtn.before(btnsHtml);

                    // Wire up the click actions
                    $("#btnCheckFT").click(function () {
                        DoApproveFundTransfer(92, "Check");
                    });
                    $("#btnVerifyFT").click(function () {
                        DoApproveFundTransfer(102, "Verify");
                    });
                    $("#btnApproveFT").click(function () {
                        DoApproveFundTransfer(90, "Approve");
                    });
                    $("#btnDisapproveFT").click(function () {
                        DoApproveFundTransfer(91, "Disapprove");
                    });
                }
            },
            error: function () {
                // Silently ignore
            }
        });
    }

    // ── Call ApproveFundTransfer controller action ──────────────────────────────
    function DoApproveFundTransfer(statusID, actionLabel) {
        if (statusID == 91) {
            Swal.fire({
                title: 'Disapprove Fund Transfer?',
                text: 'Please enter a reason for disapproval:',
                input: 'text',
                inputPlaceholder: 'Enter reason...',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Disapprove!',
                cancelButtonText: 'Cancel'
            }).then(function (result) {
                if (result.isConfirmed) {
                    SubmitApproveFT(statusID, actionLabel, result.value || "");
                }
            });
        } else {
            DialogSweetCofirm(
                function () {
                    SubmitApproveFT(statusID, actionLabel, "");
                },
                null,
                actionLabel + ' Fund Transfer?',
                'Yes, ' + actionLabel + '!',
                'Are you sure you want to ' + actionLabel + ' Fund Transfer No: ' + RefNo + '?'
            );
        }
    }

    function SubmitApproveFT(statusID, actionLabel, comment) {
        DialogSweetAlert("info", "Processing...");

        var url = '@Url.Action("ApproveFundTransfer", "FundTransfer")';
        $.ajax({
            url: url,
            type: 'GET',
            data: {
                FundTransferID: FTID,
                StatusID: statusID,
                Comment: comment,
                IsDisFromSystem: false
            },
            headers: { "Authorization": "Bearer " + (typeof access_Token !== 'undefined' ? access_Token : '') },
            success: function (response) {
                Swal.close();
                if (response.Result == 2 || response.Result == "2" || response.Result == "Successful") {
                    var icon = 'success';
                    DialogSweetAlert(icon, response.Message || (actionLabel + ' successful!'));

                    // Close modal and refresh grids
                    setTimeout(function() {
                        $("#CloseModal").click();
                        if (typeof LoadTableGrid === "function") LoadTableGrid(1);
                        else if (typeof LoadData === "function") LoadData();
                    }, 1000);
                } else if (response.Message && response.Message.indexOf("Unauthorized") > -1) {
                    DialogSweetAlert("nopermission", response.Message);
                } else {
                    DialogSweetAlert("error", response.Message || "Failed to " + actionLabel.toLowerCase() + " Fund Transfer.");
                }
            },
            error: function (xhr) {
                Swal.close();
                DialogSweetAlert("error", "An error occurred while communicating with the server.");
            }
        });
    }
</script>
