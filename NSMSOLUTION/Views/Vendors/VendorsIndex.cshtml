    /* Dark-mode input normalization */
    body.dark-mode .vendor-entry input.ve-input,
    body.dark-mode .vendor-entry select.ve-select,
    body.dark-mode .vendor-entry textarea.ve-textarea,
    html[data-theme="dark"] .vendor-entry input.ve-input,
