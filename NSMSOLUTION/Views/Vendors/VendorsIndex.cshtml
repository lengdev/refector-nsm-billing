    #mypane.vc-app .vc-kpi { min-height: 96px; padding: 13px; }
    #mypane.vc-app .vc-kpi-value { font-size: 1.15rem; }
    #mypane.vc-app .vc-kpi-icon { width: 27px; height: 27px; top: 11px; right: 11px; }
    #mypane.vc-app .vc-payment-progress { margin: 0 11px 12px; padding: 11px; }
    #mypane.vc-app .vc-action-strip { align-items: flex-start; padding: 12px; }
    #mypane.vc-app .vc-action-buttons { width: 100%; }
    #mypane.vc-app .vc-quick-action { flex: 1 1 calc(50% - 7px); }
    #mypane.vc-app .vc-tab-content { padding: 15px 12px; }
    #mypane.vc-app #invoice_tab .nav-link { height: 47px; padding-inline: 12px; }
    #mypane.vc-app .vc-file-thumb { height: 150px; }
}
@@media (prefers-reduced-motion: reduce) {
    #mypane.vc-app *, #mypane.vc-app *::before, #mypane.vc-app *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
        scroll-behavior: auto !important;
    }
}
