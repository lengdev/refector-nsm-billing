                                                   data-toggle="pill" href="#custom-tabs-three-profile"
                                                   role="tab" aria-controls="custom-tabs-three-profile"
                                                   aria-selected="false">
                                                    <i class="far fa-clock"></i> Outstanding
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" id="SettledPayments-tab"
                                                   data-toggle="pill" href="#custom-tabs-three-messages"
                                                   role="tab" aria-controls="custom-tabs-three-messages"
                                                   aria-selected="false">
                                                    <i class="far fa-credit-card"></i> Payments
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" id="VendorTransactions-tab"
                                                   data-toggle="pill" href="#tabs-VendorTransactions"
                                                   role="tab" aria-controls="tabs-VendorTransactions"
                                                   aria-selected="false">
                                                    <i class="fas fa-book"></i> Vendor Ledger
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" id="VendorStatement-tab"
                                                   data-toggle="pill" href="#tabs-VendorStatement"
                                                   role="tab" aria-controls="tabs-VendorStatement"
                                                   aria-selected="false">
                                                    <i class="fas fa-chart-bar"></i> Vendor Statement
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" id="Transaction-tab"
                                                   data-toggle="pill" href="#tabs-Transaction"
                                                   role="tab" aria-controls="tabs-Transaction"
                                                   aria-selected="false">
                                                    <i class="fas fa-history"></i> Audit Log
                                                </a>
                                            </li>
                                            <li class="nav-item">
                                                <a class="nav-link" id="Documents-tab"
                                                   data-toggle="pill" href="#tabs-Documents"
                                                   role="tab" aria-controls="tabs-Documents"
                                                   aria-selected="false">
                                                    <i class="fas fa-paperclip"></i> Attachments
                                                </a>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="tab-content vc-tab-content" id="custom-tabs-three-tabContent">
                                        <div class="tab-pane fade show active" id="custom-tabs-three-home"
                                             role="tabpanel" aria-labelledby="Transcation_tab">
                                            <div class="vc-tab-heading">
                                                <span>Bills &amp; Expenses</span>
                                                <small>Vendor purchase transactions</small>
                                            </div>
                                            <div id="transactionsGrid"></div>
                                        </div>
                                        <div class="tab-pane fade" id="custom-tabs-three-profile"
                                             role="tabpanel" aria-labelledby="OpenPayables-tab">
                                            <div class="vc-tab-heading">
                                                <span>Outstanding Bills</span>
                                                <small>Unpaid and partially paid transactions</small>
                                            </div>
                                            <div id="DivCustInvoice"></div>
                                        </div>
                                        <div class="tab-pane fade" id="custom-tabs-three-messages"
                                             role="tabpanel" aria-labelledby="SettledPayments-tab">
                                            <div class="vc-tab-heading">
                                                <span>Payment History</span>
                                                <small>Payments made to this vendor</small>
                                            </div>
                                            <div id="showPaidInvoice"></div>
                                        </div>
                                        <div class="tab-pane fade" id="tabs-VendorTransactions"
                                             role="tabpanel" aria-labelledby="VendorTransactions-tab">
                                            <div id="showVendorTransactions"></div>
                                        </div>
                                        <div class="tab-pane fade" id="tabs-VendorStatement"
                                             role="tabpanel" aria-labelledby="VendorStatement-tab">
                                            <div id="showVendorStatement"></div>
                                        </div>
                                        <div class="tab-pane fade" id="tabs-Transaction"
                                             role="tabpanel" aria-labelledby="Transaction-tab">
                                            <div id="showHistory"></div>
                                        </div>
                                        <div class="tab-pane fade" id="tabs-Documents"
                                             role="tabpanel" aria-labelledby="Documents-tab">
                                            <div id="showDocuments"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    /* =========================================================
       VENDOR CENTER — CONSOLIDATED CONTROLLER
       ========================================================= */

    window.AddEditVendor = function (vendorID) {
        vendorID = (vendorID === undefined || vendorID === null || vendorID === "") ? 0 : vendorID;

        if (typeof window.ShowDialogBox !== "function") {
            console.error("ShowDialogBox is not available.");
            return;
        }

        window.ShowDialogBox("Add Vendor", "Auto", 500, "Vendors/Create_Vendor",
            vendorID, "", false, 0, 0, function () {
                $("#SaveChange")
                    .off("click.vendorCenterSave")
                    .on("click.vendorCenterSave", function (e) {
                        e.preventDefault();
                        if (typeof window.SaveChangeVendorData === "function") {
                            window.SaveChangeVendorData();
                        } else {
                            console.error("SaveChangeVendorData is not available.");
                        }
                    });
            });
    };

    /* =========================================================
       NEW: Add Expense dialog for the selected vendor
       - Same ShowDialogBox contract as AddEditVendor
       - Pre-fills VendorID / VendorName / VendorCode
       - Opens the Expense/Create view in a modal
       - Refreshes vendor KPIs + bills tab after save
       ========================================================= */
    window.AddVendorExpense = function (vendorID, options) {
        options = options || {};

        // Resolve the vendor ID: caller arg → window.VendorID → state.
        vendorID = vendorID || window.VendorID || "0";

        if (!vendorID) {
            if (window.Swal && typeof window.Swal.fire === "function") {
                window.Swal.fire("Select a vendor",
                    "Choose a vendor before recording an expense.", "info");
            } else {
                alert("Please select a vendor first.");
            }
            return;
        }

        if (typeof window.ShowDialogBox !== "function") {
            console.error("ShowDialogBox is not available.");
            return;
        }

        var vendorName = window.VendorName || "";
        var vendorCode = window.VendorCode || "";
        var title = options.title || "Add Expense";

        // Height "Auto" lets the dialog size itself; width 900 fits the
        // full Create Expense form (two-column layout at >=xl breakpoint).
        var width = options.width || 900;

        // Pass the selected vendor through the dialog's primaryValue arg
        // so Expense/Create can prefill PaymentAccount/Payee fields.
        var primaryValue = {
            VendorID: vendorID,
            VendorName: vendorName,
            VendorCode: vendorCode,
            ReturnUrl: "Vendors/VendorCenter?id=" + encodeURIComponent(vendorID)
        };

        // ShowDialogBox signature used by the existing AddEditVendor:
        //   ShowDialogBox(title, height, width, url, primaryValue,
        //                 secondaryValue, showFooter, buttonFlags, ?, onShown)
        window.ShowDialogBox(
            title,
            "Auto",
            width,
            "Vendors/ExpenseForm",
            vendorID,
            "DialogExpenseAdd",
            false,
            0,
            0,
            function () {
                // Wire the dialog's Save button (same pattern as vendor save).
                $("#SaveChange")
                    .off("click.vendorCenterExpenseSave")
                    .on("click.vendorCenterExpenseSave", function (e) {
                        e.preventDefault();

                        // Delegate to the Expense view's own save handler.
                        if (typeof window.SaveChangeExpenseData === "function") {
                            window.SaveChangeExpenseData();
                        } else if (typeof window.saveExpense === "function") {
                            window.saveExpense();
                        } else if (typeof window.SaveExpenseData === "function") {
                            window.SaveExpenseData();
                        } else {
                            console.error("No expense save handler was found " +
                                "(expected SaveChangeExpenseData / saveExpense / SaveExpenseData).");
                        }
                    });

                // When the dialog closes, refresh the vendor panel so KPIs,
                // bills list, outstanding, etc. reflect the new expense.
                $("#DialogExpenseAdd")
                    .off("hidden.bs.modal.vcExpense")
                    .on("hidden.bs.modal.vcExpense", function () {
                        if (!window.VendorID) return;
                        // Refresh KPIs (LoadVendorInfo recomputes totals) and
                        // the active tab so the new bill shows up immediately.
                        if (typeof window.LoadVendorInfo === "function") {
                            window.LoadVendorInfo(window.VendorID);
                        }
                        if (typeof window.GetTransactions === "function") {
                            window.GetTransactions(window.VendorID);
                        }
                        // Force any previously-loaded tabs to re-fetch on next open.
                        try { window.__vcResetTabCache && window.__vcResetTabCache(); } catch (e) { }
                    });
            }
        );
    };

    (function (window, document, $) {
        "use strict";

        if (!$) {
            console.error("Vendor Center requires jQuery.");
            return;
        }

        var controllerRoot = document.getElementById("mypane");
        if (!controllerRoot) {
            console.error("Vendor Center root #mypane was not found.");
            return;
        }
        if (controllerRoot.__vcControllerInitialized === true) return;
        controllerRoot.__vcControllerInitialized = true;

        $(".card.card-outline.card-border-top").removeClass("card card-outline card-border-top");

        /* ---------- Legacy global state ---------- */
        window.VendorName = window.VendorName || "";
        window.VendorID = window.VendorID || "";
        window.VendorCode = window.VendorCode || "";
        window.grids = window.grids || null;
        window.rowNumber = window.rowNumber || 0;

        /* ---------- Module state ---------- */
        var state = {
            vendors: [],
            selectedId: null,
            selectedName: "",
            selectedCode: "",
            seq: {},
            selectTimer: null,
            tabLoaded: {}
        };

        // Expose tab cache reset for the Expense dialog close handler.
        window.__vcResetTabCache = function () { state.tabLoaded = {}; };

        /* =========================================================
           Utilities
        ========================================================= */
        function hasFunction(name) { return typeof window[name] === "function"; }

        function safeText(value, fallback) {
            if (value === null || value === undefined || value === "") {
                return fallback === undefined ? "-" : fallback;
            }
            return String(value);
        }

        function parsePayload(response) {
            var value = response;
            for (var i = 0; i < 3 && typeof value === "string"; i++) {
                try { value = JSON.parse(value); } catch (e) { break; }
            }
            return (value === null || value === undefined) ? {} : value;
        }

        function getDataObject(response) {
            var payload = parsePayload(response);
            if (payload && payload.data !== undefined) return parsePayload(payload.data);
            if (payload && payload.Data !== undefined) return parsePayload(payload.Data);
            return payload;
        }

        function finiteOrNull(value) {
            if (value === null || value === undefined || value === "") return null;
            var n = Number(value);
            return Number.isFinite(n) ? n : null;
        }

        function money(value) {
            var n = Number(value);
            if (!Number.isFinite(n)) n = 0;
            if (window.accounting && accounting.formatMoney) {
                return accounting.formatMoney(n, "", 2);
            }
            return n.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function pluralize(count, singular, plural) {
            return count + " " + (count === 1 ? singular : (plural || singular + "s"));
        }

        function safeUrl(path) {
            var root = typeof window.ServerRoot === "string" ? window.ServerRoot : "";
            var raw = String(path || "");
            if (!raw.trim()) return "";
            if (/^(javascript|data|vbscript):/i.test(raw.trim())) return "";
            try {
                var resolved = new URL(root + raw, window.location.origin);
                if (resolved.protocol !== "http:" && resolved.protocol !== "https:") return "";
                if (resolved.href === window.location.href) return "";
                return resolved.href;
            } catch (e) { return ""; }
        }

        function getFragmentParameterByName(name) {
            var hash = window.location.hash || "";
            var qIndex = hash.indexOf("?");
            if (qIndex === -1) return null;
            try {
                var params = new URLSearchParams(hash.slice(qIndex));
                return params.get(name);
            } catch (e) { return null; }
        }

        function showLoading(container, message) {
            var $box = $("<div>", { "class": "vc-loading-state" });
            $("<i>", { "class": "fas fa-circle-notch fa-spin" }).appendTo($box);
            $("<span>").text(message || "Loading...").appendTo($box);
            $(container).empty().append($box);
        }

        function showEmpty(container, title, description, icon, actionLabel, actionHref) {
            var $box = $("<div>", { "class": "vc-empty-state" });
            $("<i>", { "class": icon || "far fa-folder-open" }).appendTo($box);
            $("<strong>").text(title || "No records found").appendTo($box);
            if (description) $("<span>").text(description).appendTo($box);
            if (actionLabel && actionHref) {
                $("<a>", { "class": "btn btn-sm btn-primary mt-2", href: actionHref })
                    .text(actionLabel).appendTo($box);
            }
            $(container).empty().append($box);
        }

        function closeSwalSafely() {
            try { if (window.Swal && typeof Swal.close === "function") Swal.close(); } catch (e) { }
        }

        function loadHtml(url, container, emptyMessage) {
            if (!window.VendorID) {
                showEmpty(container, "Select a vendor", "Choose a vendor from the list to view accounting activity.");
                return;
            }
            showLoading(container);
            var key = container;
            var sequence = state.seq[key] = (state.seq[key] || 0) + 1;

            try {
                LoadData(url, function (response) {
                    if (sequence !== state.seq[key]) return;
                    var payload = parsePayload(response);
                    var html = payload && payload.data !== undefined ? payload.data :
                        payload && payload.Data !== undefined ? payload.Data : response;
                    if (typeof html !== "string" || !html.trim()) {
                        showEmpty(container, emptyMessage || "No records found");
                        return;
                    }
                    $(container).html(html);
                });
            } catch (error) {
                console.error("Vendor Center request failed:", error);
                showEmpty(container, "Unable to load records",
                    "Please refresh and try again.", "fas fa-exclamation-triangle");
            }
        }

        /* =========================================================
           Theme
        ========================================================= */
        document.addEventListener("DOMContentLoaded", function () {
            var root = document.getElementById("mypane");
            if (!root) return;
            root.setAttribute("data-vc-theme",
                document.body.classList.contains("dark-mode") ? "dark" : "light");
        });

        /* =========================================================
           Vendor list
        ========================================================= */
        function showListSkeleton(count) {
            var html = "";
            for (var i = 0; i < (count || 6); i++) {
                html += '<li class="vc-skeleton" aria-hidden="true"></li>';
            }
            $("#itemList").html(html);
        }

        function setVendorSelection(id) {
            $("#itemList .k-item").removeClass("k-state-selected")
                .attr("aria-selected", "false")
                .filter(function () {
                    return String($(this).attr("data-id")) === String(id);
                }).addClass("k-state-selected").attr("aria-selected", "true");
        }

        function updateVendorHash(id) {
            var base = window.location.href.split("#")[0];
            var hash = "#!/Vendors?id=" + encodeURIComponent(id);
            if (window.history && history.replaceState) {
                history.replaceState(null, "", base + hash);
            } else {
                window.location.hash = hash;
            }
        }

        function renderVendorList(items) {
            state.vendors = Array.isArray(items) ? items : [];
            var $list = $("#itemList").empty();
            if (!state.vendors.length) { showEmpty("#itemList", "No vendors found"); return; }

            state.vendors.forEach(function (item) {
                var id = safeText(item.VendorID, "");
                var name = safeText(hasFunction("fullyDecodeHtml") ? fullyDecodeHtml(item.VendorName || "") : item.VendorName, "Unnamed vendor");
                var code = safeText(item.VendorCode, "");

                var $li = $("<li>", {
                    "class": "k-item",
                    "role": "option",
                    "data-id": id,
                    "data-name": name,
                    "data-code": code,
                    "aria-selected": String(state.selectedId) === String(id) ? "true" : "false",
                    "title": code ? name + " (" + code + ")" : name
                });

                $("<span>", { "class": "vc-vendor-list-name" }).text(name).appendTo($li);
                $("<small>", { "class": "vc-vendor-list-code" }).text(code || "Vendor").appendTo($li);

                var $edit = $("<button>", {
                    type: "button", "class": "vc-vendor-edit-btn",
                    "data-vendor-id": id, "title": "Edit vendor",
                    "aria-label": "Edit " + name
                });
                $("<i>", { "class": "fas fa-pen" }).appendTo($edit);
                $li.append($edit);

                $list.append($li);
            });

            setVendorSelection(state.selectedId);
        }

        function LoadVendorList(callback, selectedVendorID) {
            var requestId = state.seq.vendorList = (state.seq.vendorList || 0) + 1;
            if (selectedVendorID !== undefined && selectedVendorID !== null && selectedVendorID !== "") {
                state.selectedId = selectedVendorID;
                window.VendorID = selectedVendorID;
            }

            showListSkeleton(6);

            if (typeof window.LoadData !== "function") {
                console.error("LoadData is not available.");
                showEmpty("#itemList", "Unable to load vendors", "The data service is unavailable.");
                if (typeof callback === "function") callback([]);
                return;
            }

            window.LoadData("Vendors/LoadVendor", function (response) {
                if (requestId !== state.seq.vendorList) return;
                try {
                    var items = getDataObject(response);
                    if (!Array.isArray(items)) {
                        items = (items && Array.isArray(items.Table)) ? items.Table : [];
                    }

                    renderVendorList(items);

                    if (window.VendorID) {
                        var match = state.vendors.find(function (v) {
                            return String(v.VendorID) === String(window.VendorID);
                        });
                        if (match) {
                            state.selectedId = match.VendorID;
                            window.VendorID = match.VendorID;
                            window.VendorName = hasFunction("fullyDecodeHtml") ? fullyDecodeHtml(match.VendorName || "") : (match.VendorName || "");
                            window.VendorCode = match.VendorCode || "";
                            setVendorSelection(match.VendorID);
                        }
                    }

                    if (typeof callback === "function") callback(items);
                } catch (error) {
                    console.error("Error loading vendor list:", error);
                    showEmpty("#itemList", "Unable to load vendors", "Please try again.");
                    if (typeof callback === "function") callback([]);
                }
            });
        }

        window.ReloadVendorList = function (vendorID, callback) {
            var changed = String(vendorID || "") !== String(state.selectedId || "");
            LoadVendorList(function (items) {
                if (vendorID && changed) selectVendor(vendorID);
                if (typeof callback === "function") callback(items);
            }, vendorID);
        };

        /* ---------- Search filter ---------- */
        $(document).off("input.vcSearch", "#searchBox").on("input.vcSearch", "#searchBox", function () {
            var term = String($(this).val() || "").toLowerCase().trim();
            $("#itemList .k-item").each(function () {
                if (!term) { $(this).show(); return; }
                var name = String($(this).attr("data-name") || "").toLowerCase();
                var code = String($(this).attr("data-code") || "").toLowerCase();
                $(this).toggle(name.indexOf(term) > -1 || code.indexOf(term) > -1);
            });
        });

        $(document).off("keydown.vcSearch", "#searchBox").on("keydown.vcSearch", "#searchBox", function (e) {
            if (e.key === "Escape") $(this).val("").trigger("input");
        });

        /* ---------- Keyboard nav on list ---------- */
        $(document).off("keydown.vcList", "#itemList").on("keydown.vcList", "#itemList", function (e) {
            var $items = $("#itemList .k-item:visible");
            if (!$items.length) return;
            var idx = $items.index($items.filter(".k-state-selected"));

            if (e.key === "ArrowDown") { e.preventDefault(); idx = Math.min($items.length - 1, idx + 1); }
            else if (e.key === "ArrowUp") { e.preventDefault(); idx = Math.max(0, idx - 1); }
            else if (e.key === "Home") { e.preventDefault(); idx = 0; }
            else if (e.key === "End") { e.preventDefault(); idx = $items.length - 1; }
            else if ((e.key === "Enter" || e.key === " ") && idx > -1) {
                e.preventDefault();
                selectVendor($items.eq(idx).attr("data-id"));
                return;
            } else { return; }

            $items.removeClass("k-state-selected").attr("aria-selected", "false");
            $items.eq(idx).addClass("k-state-selected").attr("aria-selected", "true")[0].scrollIntoView({ block: "nearest" });
        });

        /* ---------- Click delegation ---------- */
        $(document).off("click.vcItem", "#itemList").on("click.vcItem", "#itemList", function (e) {
            var $edit = $(e.target).closest(".vc-vendor-edit-btn");
            if ($edit.length) {
                e.stopPropagation();
                var id = $edit.attr("data-vendor-id");
                if (typeof window.AddEditVendor === "function") window.AddEditVendor(id);
                return;
            }
            var $item = $(e.target).closest(".k-item");
            if ($item.length) selectVendor($item.attr("data-id"));
        });

        /* ---------- Selection ---------- */
        function selectVendor(id) {
            clearTimeout(state.selectTimer);
            state.selectTimer = setTimeout(function () { _selectVendor(id); }, 120);
        }

        function _selectVendor(id) {
            var item = state.vendors.find(function (v) { return String(v.VendorID) === String(id); });
            if (!item) return;

            state.selectedId = item.VendorID;
            window.VendorID = item.VendorID;
            window.VendorName = hasFunction("fullyDecodeHtml") ? fullyDecodeHtml(item.VendorName || "") : (item.VendorName || "");
            window.VendorCode = item.VendorCode || "";

            state.tabLoaded = {};

            setVendorSelection(item.VendorID);
            updateVendorHash(item.VendorID);

            // Disable action buttons until KPIs finish loading.
            $("#vcMakePaymentBtn").prop("disabled", true);
            $("#vcAddExpenseBtn").prop("disabled", true);

            $("#VendorAdvanceAvailable").text("—");
            $("#VendorAdvanceNote").text("Loading vendor advance...");
            $("#PaymentProgress").text("0%");
            $("#PaymentProgressBar").css("width", "0%");
            $("#PaymentProgressNote").text("Loading payment summary...");

            if (window.Swal && Swal.fire) {
                Swal.fire({
                    title: "Loading...",
                    allowOutsideClick: false, allowEscapeKey: false,
                    position: "top", timer: 15000, timerProgressBar: true,
                    didOpen: function () { Swal.showLoading(); }
                });
            }

            window.LoadVendorProfilePicture(window.VendorID);
            window.LoadVendorInfo(window.VendorID);
            window.GetTransactions(window.VendorID);
            state.tabLoaded["Transcation_tab"] = window.VendorID;

            try { $('#invoice_tab a[href="#custom-tabs-three-home"]').tab("show"); } catch (e) { }
        }

        /* =========================================================
           Profile & KPIs
        ========================================================= */
        window.LoadVendorProfilePicture = function (id) {
            id = id || window.VendorID;
            if (!id) return;

            LoadData("VendorCenter/LoadVendorProfilePicture?ID=" + encodeURIComponent(id), function (response) {
                var payload = getDataObject(response);
                var row = Array.isArray(payload) ? payload[0] : (payload.Table && payload.Table[0]) || payload;
                var picture = row && row.VendorPicture ? String(row.VendorPicture) : "";
                var url = picture ? safeUrl(picture) : "";
                var $avatar = $("#Cust_profilepic").empty();

                if (url) {
                    $("<div>", { "class": "profilepic__image" })
                        .append($("<img>", {
                            "class": "profilepic__image", "src": url,
                            "alt": "Vendor profile", "loading": "lazy"
                        })).appendTo($avatar);

                    var $actions = $("<div>", {
                        "class": "profilepic__content", "id": "addCustPic",
                        "role": "button", "tabindex": 0,
                        "aria-label": "Change vendor profile picture",
                        "css": { cursor: "pointer" }
                    });

                    $("<span>", { "class": "profilepic__icon" })
                        .append($("<i>", { "class": "fas fa-camera", "title": "Change picture" }))
                        .append(" ")
                        .append($("<i>", { "class": "far fa-trash-alt", "name": "deletepiccust", "title": "Delete picture" }))
                        .append(" ")
                        .append($("<a>", { "href": url, "target": "_blank", "rel": "noopener" })
                            .append($("<i>", { "class": "far fa-eye", "name": "viewprofilepic", "title": "View picture" })))
                        .appendTo($actions);

                    $("<span>", { "class": "profilepic__text" }).text("Edit Profile").appendTo($actions);
                    $avatar.append($actions);
                } else {
                    $avatar.append(
                        $("<div>", { "class": "profilepic__image" })
                            .append($("<i>", { "class": "fa fa-user-circle", "aria-hidden": "true" }))
                    );
                    $avatar.append(
                        $("<div>", { "class": "profilepic__content", "id": "addCustPic", "role": "button", "tabindex": 0, "aria-label": "Add vendor profile picture", "css": { cursor: "pointer" } })
                            .append($("<span>", { "class": "profilepic__icon" })
                                .append($("<i>", { "class": "fas fa-camera" })))
                            .append($("<span>", { "class": "profilepic__text" })
                                .text("Add Profile Picture"))
                    );
                }
            });
        };

        window.LoadVendorInfo = function (id) {
            id = id || window.VendorID;
            if (!id) return;

            var sequence = state.seq.profile = (state.seq.profile || 0) + 1;
            LoadData("VendorCenter/LoadVendorInfo?ID=" + encodeURIComponent(id), function (response) {
                if (sequence !== state.seq.profile || String(id) !== String(window.VendorID)) return;
                try {
                    var payload = getDataObject(response);
                    var info = payload.Table && payload.Table.length ? payload.Table[0] : {};
                    var summary = payload.Table1 && payload.Table1.length ? payload.Table1[0] : {};
                    var advanceSummary = payload.Table2 && payload.Table2.length ? payload.Table2[0] : {};

                    window.VendorName = safeText(info.VendorName, window.VendorName || "");
                    window.VendorCode = safeText(info.VendorCode, window.VendorCode || "");

                    $("#CustInfo, #CustInfo-left").empty();
                    $("#vcVendorName").text(window.VendorName || "Vendor");
                    $("#vcVendorType").empty()
                        .append($("<i>", { "class": "far fa-star mr-2" }))
                        .append(document.createTextNode(safeText(info.VendorType, "Vendor")));
                    $("#vcPhone").text(safeText(info.Phone || info.Mobile));
                    $("#vcAddress").text(safeText(info.Address));
                    $("#vcRegisterDate").text(safeText(info.RegisterDate));
                    $("#vcRegisterBy").text(safeText(info.CreateBy));
                    $("#vcPaymentVat").text(safeText(info.PaymentTerms) + " / " + safeText(info.VATTIN));

                    var total = Number(summary.TotalAmount) || 0;
                    var paid = Number(summary.PaidAmount) || 0;
                    var balance = Number(summary.BalanceAmount) || 0;
                    var invoiceCount = Number(summary.TotalInvoices) || 0;
                    var unpaidCount = Number(summary.UnpaidInvoices) || 0;
                    var partialCount = Number(summary.PartialPaidInvoices) || 0;
                    var paymentCount = Number(summary.TotalPayments) || 0;

                    $("#TotalInv").text(money(total));
                    $("#CountInv").text(pluralize(invoiceCount, "Bill"));
                    $("#Paid").text(money(paid));
                    $("#PaidInvoices").text(pluralize(paymentCount, "Payment"));
                    $("#Unpaid").text(money(balance));
                    $("#UnpaidInvoices").text(pluralize(unpaidCount + partialCount, "Bill"));

                    var paymentProgress = total > 0 ? Math.max(0, Math.min(100, (paid / total) * 100)) : 0;

                    $("#PaymentProgress").text(paymentProgress.toFixed(1) + "%");
                    $("#PaymentProgressBar").css("width", paymentProgress.toFixed(2) + "%");
                    $("#PaymentProgressNote").text(money(paid) + " paid of " + money(total) + " purchases");

                    var advanceValue = finiteOrNull(advanceSummary.VendorAdvanceAvailable);
                    var advanceCount = Number(advanceSummary.OpenDepositCount) || 0;

                    if (advanceValue !== null) {
                        $("#VendorAdvanceAvailable").text(money(Math.max(0, advanceValue)));
                        $("#VendorAdvanceNote").text(pluralize(advanceCount, "open deposit") + " · available to allocate");
                        $("#VendorAdvanceAvailable").attr("title", "Sum of remaining balances from open vendor deposits");
                    } else {
                        $("#VendorAdvanceAvailable").text(money(0));
                        $("#VendorAdvanceNote").text("No available vendor advance");
                        $("#VendorAdvanceAvailable").attr("title", "No matching open vendor deposit balance was returned");
                    }

                    // Enable action buttons now that the vendor is fully loaded.
                    $("#vcMakePaymentBtn").prop("disabled", !window.VendorID || balance <= 0);
                    $("#vcAddExpenseBtn").prop("disabled", !window.VendorID);
                } catch (e) {
                    console.error("LoadVendorInfo render failed:", e);
                } finally {
                    closeSwalSafely();
                }
            });
        };

        /* =========================================================
           Vendor attachment / profile-picture upload
        ========================================================= */
        window.AddVendorAttachmentFile = function (AddVendorProfilePic) {
            AddVendorProfilePic = (typeof AddVendorProfilePic === "undefined" ? "" : AddVendorProfilePic);

            if (!window.VendorID) {
                if (window.Swal && typeof window.Swal.fire === "function") {
                    window.Swal.fire("Select a vendor", "Please select a vendor before adding a profile picture.", "info");
                } else {
                    alert("Please select a vendor first.");
                }
                return;
            }

            var URL = "VendorCenter/SaveChangeVendorProfilePicture";
            var isProfilePicture = AddVendorProfilePic !== "";
            var title = isProfilePicture ? "Add Vendor Profile Picture" : "Add Attachment File to Vendor";
            var primaryFieldValue = {
                SaveOnItsForm: true,
                VendorName: window.VendorName,
                VendorID: window.VendorID,
                URL: URL,
                VendorCode: window.VendorCode,
                TypeFor: "AttachmentFile"
            };

            var uri = isProfilePicture ? "UploadFileForm?AllowOnlyImage=true&ShowAvatar=true" : "UploadFileForm";

            if (typeof window.ShowDialogBox2 !== "function") {
                console.error("ShowDialogBox2 is not defined. Cannot open the vendor upload dialog.");
                return;
            }

            window.ShowDialogBox2(
                title, 700, 500, uri, primaryFieldValue, "DialogAddAttCustFile",
                function () {
                    $("#DialogAddAttCustFile")
                        .on("hide.bs.modal", function () {
                            if (isProfilePicture) {
                                window.LoadVendorProfilePicture(window.VendorID);
                            } else if (typeof window.LoadCustAttachmentFile === "function") {
                                window.LoadCustAttachmentFile(window.VendorID);
                            }
                        });
                }
            );
        };

        /* =========================================================
           Tab loaders
        ========================================================= */
        window.GetTransactions = function (payeeId) {
            payeeId = payeeId || window.VendorID;
            if (!payeeId) { showEmpty("#transactionsGrid", "Select a vendor"); return; }
            state.tabLoaded["Transcation_tab"] = payeeId;
            loadHtml("VendorCenter/GetTransactions?PayeeID=" + encodeURIComponent(payeeId),
                "#transactionsGrid", "No bills or expenses found");
        };

        window.LoadOpenPayables = function () {
            if (!window.VendorID) return;
            state.tabLoaded["OpenPayables-tab"] = window.VendorID;
            loadHtml("VendorCenter/GetTransactions?PayeeID=" +
                encodeURIComponent(window.VendorID) + "&PaymentStatus=Unpaid",
                "#DivCustInvoice", "No outstanding bills");
        };

        window.LoadPaidInvoices = function () {
            if (!window.VendorID) return;
            state.tabLoaded["SettledPayments-tab"] = window.VendorID;
            loadHtml("VendorCenter/GetTransactions?PayeeID=" +
                encodeURIComponent(window.VendorID) + "&PaymentStatus=Paid",
                "#showPaidInvoice", "No payments recorded");
        };

        window.LoadVendorTransactions = function () {
            if (!window.VendorID) return;
            state.tabLoaded["VendorTransactions-tab"] = window.VendorID;
            loadHtml("VendorCenter/LoadVendorHistory?PayeeID=" +
                encodeURIComponent(window.VendorID) + "&Type=Transactions",
                "#showVendorTransactions", "No ledger transactions found");
        };

        window.LoadVendorStatement = function () {
            if (!window.VendorID) return;
            state.tabLoaded["VendorStatement-tab"] = window.VendorID;
            loadHtml("VendorCenter/LoadVendorStatement?PayeeID=" + encodeURIComponent(window.VendorID),
                "#showVendorStatement", "No statement activity found");
        };

        window.LoadVendorHistory = function () {
            if (!window.VendorID) return;
            state.tabLoaded["Transaction-tab"] = window.VendorID;
            loadHtml("VendorCenter/LoadVendorHistory?PayeeID=" +
                encodeURIComponent(window.VendorID) + "&Type=History",
                "#showHistory", "No audit history found");
        };

        window.LoadCustAttachmentFile = function (id) {
            id = id || window.VendorID;
            if (!id) { showEmpty("#showDocuments", "Select a vendor"); return; }
            state.tabLoaded["Documents-tab"] = id;
            loadHtml("VendorCenter/LoadVendorAttachmentFile?ID=" + encodeURIComponent(id),
                "#showDocuments", "No attachments found");
        };

        /* ---------- Vendor profile-picture actions ---------- */
        $(document)
            .off("click.vcAvatar", "#addCustPic")
            .on("click.vcAvatar", "#addCustPic", function (event) {
                var $target = $(event.target);
                var $delete = $target.closest('[name="deletepiccust"]');
                var $view = $target.closest('a, [name="viewprofilepic"]');

                if ($view.length) { event.stopPropagation(); return; }

                event.preventDefault();
                event.stopPropagation();

                if (!window.VendorID) return;

                if ($delete.length) {
                    if (typeof window.DialogSweetCofirm === "function") {
                        window.DialogSweetCofirm(function () {
                            if (typeof window.DoSaveChangeData === "function") {
                                window.DoSaveChangeData("VendorCenter/SaveChangeVendorProfilePicture", {
                                    Data: JSON.stringify({
                                        VendorName: window.VendorName,
                                        VendorID: window.VendorID,
                                        VendorCode: window.VendorCode
                                    })
                                });
                                window.LoadVendorProfilePicture(window.VendorID);
                            }
                        }, "", "Do you want to delete this profile picture?");
                    } else if (window.confirm("Do you want to delete this profile picture?")) {
                        if (typeof window.DoSaveChangeData === "function") {
                            window.DoSaveChangeData("VendorCenter/SaveChangeVendorProfilePicture", {
                                Data: JSON.stringify({
                                    VendorName: window.VendorName,
                                    VendorID: window.VendorID,
                                    VendorCode: window.VendorCode
                                })
                            });
                            window.LoadVendorProfilePicture(window.VendorID);
                        }
                    }
                    return;
                }

                if (typeof window.AddVendorAttachmentFile === "function") {
                    window.AddVendorAttachmentFile("AddCustomerProfilePic");
                } else {
                    console.error("AddVendorAttachmentFile is not available.");
                }
            })
            .off("keydown.vcAvatar", "#addCustPic")
            .on("keydown.vcAvatar", "#addCustPic", function (event) {
                if (event.key === "Enter" || event.key === " ") {
                    event.preventDefault();
                    $(this).trigger("click");
                }
            });

        /* ---------- Tab click → loaders ---------- */
        $(document).off("shown.bs.tab.vcTabs", '#invoice_tab a[data-toggle="pill"]')
            .on("shown.bs.tab.vcTabs", '#invoice_tab a[data-toggle="pill"]', function () {
                if (!window.VendorID) return;
                var id = this.id;
                if (state.tabLoaded[id] && String(state.tabLoaded[id]) === String(window.VendorID)) return;

                switch (id) {
                    case "Transcation_tab": window.GetTransactions(window.VendorID); break;
                    case "OpenPayables-tab": window.LoadOpenPayables(); break;
                    case "SettledPayments-tab": window.LoadPaidInvoices(); break;
                    case "VendorTransactions-tab": window.LoadVendorTransactions(); break;
                    case "VendorStatement-tab": window.LoadVendorStatement(); break;
                    case "Transaction-tab": window.LoadVendorHistory(); break;
                    case "Documents-tab": window.LoadCustAttachmentFile(); break;
                }
            });

        /* ---------- Quick action buttons (tab shortcuts) ---------- */
        $(document).off("click.vcQuick", "[data-vc-tab]").on("click.vcQuick", "[data-vc-tab]", function () {
            var target = $(this).attr("data-vc-tab");
            var $tab = $("#" + target);
            if ($tab.length) { try { $tab.tab("show"); } catch (e) { } }
        });

        /* =========================================================
           NEW: Expense button → opens Add Expense dialog
        ========================================================= */
        $(document).off("click.vcExpense", "#vcAddExpenseBtn").on("click.vcExpense", "#vcAddExpenseBtn", function () {
            if (!window.VendorID) {
                if (window.Swal && typeof window.Swal.fire === "function") {
                    window.Swal.fire("Select a vendor",
                        "Choose a vendor before recording an expense.", "info");
                } else {
                    alert("Please select a vendor first.");
                }
                return;
            }

            if (typeof window.AddVendorExpense === "function") {
                window.AddVendorExpense(window.VendorID);
            } else {
                console.error("AddVendorExpense is not available.");
            }
        });

        /* ---------- Refresh / Add buttons ---------- */
        $(document).off("click.vcRefresh", "#vcRefreshBtn").on("click.vcRefresh", "#vcRefreshBtn", function () {
            if (window.VendorID) selectVendor(window.VendorID);
        });

        $(document).off("click.vcAddNew", "#addNewVD").on("click.vcAddNew", "#addNewVD", function () {
            if (typeof window.AddEditVendor === "function") window.AddEditVendor(0);
        });

        /* =========================================================
           Init
        ========================================================= */
        $("a[data-widget=pushmenu]").click();

        var initialId = getFragmentParameterByName("id") || window.VendorID || "";
        LoadVendorList(function () {
            if (initialId) selectVendor(initialId);
        }, initialId);
    })(window, document, window.jQuery);
</script>