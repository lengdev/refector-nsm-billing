    /* ---------- 15. ANIMATIONS ---------- */
    @@keyframes vc-shimmer {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    @@keyframes vc-enter-up {
        from {
            opacity: 0;
            transform: translate3d(0, 16px, 0);
        }

        to {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    @@keyframes vc-enter-side {
        from {
            opacity: 0;
            transform: translate3d(-14px, 0, 0);
        }

        to {
            opacity: 1;
            transform: translate3d(0, 0, 0);
        }
    }

    @@keyframes vc-soft-scale {
        from {
            opacity: 0;
            transform: scale(.975) translateY(8px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    @@keyframes vc-profile-glow {
        0%, 100% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }
    }

    @@keyframes vc-tab-reveal {
        from {
            opacity: 0;
            transform: translateY(7px);
        }

        to {
            opacity: 1;
