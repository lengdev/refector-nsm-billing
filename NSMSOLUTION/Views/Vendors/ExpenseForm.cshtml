// Reload Payee list after adding a new vendor
function ReloadPayeeList(selectedPayeeID) {

    $.getJSON('@Url.Action("GetPayeeList", "Vendors")')
        .done(function (data) {

            dataSource_PayeeID = Array.isArray(data) ? data : [];

            var payeeCombo = $("#Payee")
                .data("kendoMultiColumnComboBox");

            if (!payeeCombo) {
                InitializePayeeComboBox();
                return;
            }

            payeeCombo.dataSource.data(dataSource_PayeeID);

            payeeCombo.value(selectedPayeeID || "");

            if (selectedPayeeID) {
                payeeCombo.trigger("change");
            }

        })
        .fail(function (xhr, status, error) {

            console.error("Failed to reload Payee list:", error);

        });
}

