@{ Layout = null; }

<style>
    /* ============================================================
       EXPENSE FORM — MODERN 2025 REDESIGN
       Complete restyle. Markup names, IDs, and JS hooks preserved.
    ============================================================ */
    .expense-account-kendo .expense-account-group-header {
        padding: 9px 12px;
        font-weight: 700;
        font-size: 12px;
        color: #4FA3E3;
        background: #0C1626;
        border-bottom: 1px solid rgba(255,255,255,.12);
        text-transform: uppercase;
    }
    /* Account dropdown */
    .expense-wrapper .expense-account-kendo {
        width: 100%;
        min-height: 45px;
        border-radius: 10px;
        border: 1px solid var(--ex-border-strong);
        background: var(--ex-surface);
        transition: all .18s ease;
    }

        /* Focus */
        .expense-wrapper .expense-account-kendo:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .15);
        }

        /* Input */
        .expense-wrapper .expense-account-kendo .k-input-inner {
            min-height: 43px;
            padding-left: 42px !important;
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
        }

    /* Dropdown table headers */
    .k-multicolumncombobox-popup .k-table-thead,
    .k-multicolumncombobox-popup .k-grid-header {
        background: #f8fafc;
    }

    /* Account number */
    .expense-account-no {
        display: inline-block;
        color: #6478ff;
        font-weight: 600;
    }

    /* Account name */
    .expense-account-name {
        color: #1e293b;
    }

    /* Group header */
    .k-list-group-item,
    .k-group-header {
        padding: 12px 16px !important;
        font-weight: 700;
        color: #334155;
        background: #e9e8ff !important;
        border-bottom: 1px solid #d6d9ed;
    }

    /* Dropdown row */
    .k-multicolumncombobox-popup .k-list-item {
        padding: 12px 16px;
        min-height: 48px;
    }

        /* Hover */
        .k-multicolumncombobox-popup .k-list-item:hover {
            background: #eef2ff !important;
        }

    /* Selected */
    .k-multicolumncombobox-popup .k-selected {
        background: #e5e7ff !important;
    }

    /* Dark mode */
    html[data-theme="dark"] .expense-wrapper .expense-account-kendo,
    body[data-theme="dark"] .expense-wrapper .expense-account-kendo,
    body.dark-mode .expense-wrapper .expense-account-kendo {
        background: var(--ex-surface-2);
        border-color: var(--ex-border-strong);
    }

    html[data-theme="dark"] .expense-account-name,
    body[data-theme="dark"] .expense-account-name,
    body.dark-mode .expense-account-name {
        color: var(--ex-text);
    }
    /* Payee Kendo MultiColumnComboBox */
    .expense-wrapper .expense-payee-kendo {
        width: 100%;
/*        min-height: 45px;*/
        border: 1px solid var(--ex-border-strong);
        border-radius: 10px;
        background: var(--ex-surface);
        transition: border-color .18s ease, box-shadow .18s ease;
    }

        /* Input */
        .expense-wrapper .expense-payee-kendo .k-input-inner {
/*            min-height: 43px;*/
/*            padding-left: 42px !important;*/
            border: none !important;
            background: transparent !important;
            box-shadow: none !important;
        }

    /* Person icon positioning */
    .expense-wrapper .expense-payee-kendo {
        position: relative;
    }

        /* Focus */
        .expense-wrapper .expense-payee-kendo:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .16);
        }

        /* Dropdown arrow */
        .expense-wrapper .expense-payee-kendo .k-input-button {
            border: none;
            background: transparent;
        }

        /* Hover */
        .expense-wrapper .expense-payee-kendo:hover {
            border-color: #94a3b8;
        }

    /* Dark theme */
    html[data-theme="dark"] .expense-wrapper .expense-payee-kendo,
    body[data-theme="dark"] .expense-wrapper .expense-payee-kendo,
    body.dark-mode .expense-wrapper .expense-payee-kendo {
        background: var(--ex-surface-2);
        border-color: var(--ex-border-strong);
    }

        html[data-theme="dark"] .expense-wrapper .expense-payee-kendo .k-input-inner,
        body[data-theme="dark"] .expense-wrapper .expense-payee-kendo .k-input-inner,
        body.dark-mode .expense-wrapper .expense-payee-kendo .k-input-inner {
            color: var(--ex-text);
        }
    /* ---------- Design tokens ---------- */
    .expense-wrapper {
        --ex-accent: #4f46e5;
        --ex-accent-hover: #4338ca;
        --ex-accent-soft: rgba(79, 70, 229, .08);
        --ex-accent-ring: rgba(79, 70, 229, .18);
        --ex-success: #059669;
        --ex-success-soft: rgba(5, 150, 105, .10);
        --ex-danger: #dc2626;
        --ex-danger-soft: rgba(220, 38, 38, .08);
        --ex-warning: #d97706;
        --ex-warning-soft: rgba(217, 119, 6, .10);
        --ex-info: #0284c7;
        --ex-info-soft: rgba(2, 132, 199, .08);
        --ex-bg: #f6f7fb;
        --ex-surface: #ffffff;
        --ex-surface-2: #f9fafb;
        --ex-surface-3: #f3f4f6;
        --ex-border: #e5e7eb;
        --ex-border-strong: #d1d5db;
        --ex-text: #111827;
        --ex-text-2: #374151;
        --ex-muted: #6b7280;
        --ex-faint: #9ca3af;
        --ex-radius-lg: 14px;
        --ex-radius: 10px;
        --ex-radius-sm: 7px;
        --ex-shadow-xs: 0 1px 2px rgba(16, 24, 40, .05);
        --ex-shadow-sm: 0 1px 3px rgba(16, 24, 40, .06), 0 1px 2px rgba(16, 24, 40, .04);
        --ex-shadow: 0 4px 12px rgba(16, 24, 40, .06), 0 2px 4px rgba(16, 24, 40, .04);
        --ex-shadow-lg: 0 12px 32px rgba(16, 24, 40, .10), 0 4px 8px rgba(16, 24, 40, .05);
        --ex-inset: inset 0 1px 2px rgba(16, 24, 40, .04);
        --ex-ease: cubic-bezier(.4, 0, .2, 1);
        --ex-t: .18s var(--ex-ease);
        width: 100%;
        color: var(--ex-text);
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        font-size: 14px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: var(--ex-bg);
        min-height: 100vh;
    }

        .expense-wrapper *,
        .expense-wrapper *::before,
        .expense-wrapper *::after {
            box-sizing: border-box;
        }

        .expense-wrapper .expense-shell {
            width: 100%;
            margin: 0 auto;
            padding: 20px 24px 24px;
        }

        /* ============================================================
       PAGE HEADER
    ============================================================ */
        .expense-wrapper .expense-page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 20px;
            padding: 20px 24px;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius-lg);
            background: var(--ex-surface);
            box-shadow: var(--ex-shadow-sm);
        }

        .expense-wrapper .expense-heading-left {
            display: flex;
            align-items: center;
            gap: 16px;
            min-width: 0;
        }

        .expense-wrapper .expense-heading-icon {
            display: grid;
            place-items: center;
            flex: 0 0 52px;
            width: 52px;
            height: 52px;
            border-radius: 14px;
            color: #fff;
            background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
            font-size: 1.35rem;
            box-shadow: 0 4px 12px rgba(79, 70, 229, .30);
        }

        .expense-wrapper .expense-breadcrumb {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-bottom: 4px;
            color: var(--ex-muted);
            font-size: .75rem;
            font-weight: 500;
        }

            .expense-wrapper .expense-breadcrumb i {
                font-size: .6rem;
                opacity: .6;
            }

            .expense-wrapper .expense-breadcrumb .current {
                color: var(--ex-accent);
                font-weight: 600;
            }

        .expense-wrapper .expense-heading h1 {
            margin: 0;
            color: var(--ex-text);
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: -.02em;
            line-height: 1.2;
        }

        .expense-wrapper .expense-heading p {
            margin: 3px 0 0;
            color: var(--ex-muted);
            font-size: .85rem;
        }

        .expense-wrapper .expense-header-actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .expense-wrapper .expense-header-status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 14px;
            border: 1px solid var(--ex-border);
            border-radius: 24px;
            color: var(--ex-text-2);
            background: var(--ex-surface-2);
            font-size: .78rem;
            font-weight: 600;
        }

            .expense-wrapper .expense-header-status i {
                color: var(--ex-warning);
                font-size: .5rem;
            }

        /* ============================================================
       CARDS
    ============================================================ */
        .expense-wrapper .section-card,
        .expense-wrapper .journal-card,
        .expense-wrapper .doc-card {
            min-width: 0;
            margin-bottom: 20px;
            overflow: hidden;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius-lg);
            background: var(--ex-surface);
            box-shadow: var(--ex-shadow-sm);
            transition: box-shadow var(--ex-t);
        }

            .expense-wrapper .section-card:hover {
                box-shadow: var(--ex-shadow);
            }

        .expense-wrapper .section-header,
        .expense-wrapper .journal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            padding: 16px 20px;
            border-bottom: 1px solid var(--ex-border);
            background: var(--ex-surface);
        }

        .expense-wrapper .section-title {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 0;
        }

        .expense-wrapper .section-icon {
            display: grid;
            place-items: center;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            border-radius: 10px;
            font-size: 1.1rem;
        }

        .expense-wrapper .icon-blue {
            color: var(--ex-accent);
            background: var(--ex-accent-soft);
        }

        .expense-wrapper .icon-green {
            color: var(--ex-success);
            background: var(--ex-success-soft);
        }

        .expense-wrapper .icon-orange {
            color: var(--ex-warning);
            background: var(--ex-warning-soft);
        }

        .expense-wrapper .icon-info {
            color: var(--ex-info);
            background: var(--ex-info-soft);
        }

        .expense-wrapper .section-title h6,
        .expense-wrapper .journal-header h6 {
            margin: 0;
            color: var(--ex-text);
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: -.01em;
        }

        .expense-wrapper .section-title small {
            display: block;
            margin-top: 2px;
            color: var(--ex-muted);
            font-size: .78rem;
            font-weight: 400;
        }

        .expense-wrapper .section-body {
            padding: 20px 24px 24px;
        }

        /* ============================================================
       STATUS CHIPS
    ============================================================ */
        .expense-wrapper .sec-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: .74rem;
            font-weight: 600;
            border: 1px solid transparent;
            white-space: nowrap;
        }

            .expense-wrapper .sec-status.is-ok {
                color: #047857;
                background: var(--ex-success-soft);
                border-color: rgba(5,150,105,.2);
            }

            .expense-wrapper .sec-status.is-warn {
                color: #b45309;
                background: var(--ex-warning-soft);
                border-color: rgba(217,119,6,.25);
            }

            .expense-wrapper .sec-status.is-danger {
                color: #b91c1c;
                background: var(--ex-danger-soft);
                border-color: rgba(220,38,38,.2);
            }

        /* ============================================================
       GUIDANCE BANNER
    ============================================================ */
        .expense-wrapper .ux-guide {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 20px;
            padding: 12px 16px;
            border: 1px solid rgba(2,132,199,.2);
            border-left: 3px solid var(--ex-info);
            border-radius: var(--ex-radius);
            background: var(--ex-info-soft);
            color: #0c4a6e;
            font-size: .84rem;
            line-height: 1.5;
        }

            .expense-wrapper .ux-guide > i {
                color: var(--ex-info);
                font-size: 1.1rem;
                margin-top: 1px;
                flex-shrink: 0;
            }

            .expense-wrapper .ux-guide strong {
                font-weight: 700;
            }

        /* ============================================================
       FORM FIELDS
    ============================================================ */
        .expense-wrapper .expense-fields-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px 20px;
            align-items: start;
        }

        .expense-wrapper .expense-field {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

            .expense-wrapper .expense-field > label {
                display: block;
                margin: 0;
                color: var(--ex-text-2);
                font-size: .82rem;
                font-weight: 600;
                line-height: 1.35;
            }

                .expense-wrapper .expense-field > label b,
                .expense-wrapper .expense-field > label .required {
                    color: var(--ex-danger);
                    font-weight: 700;
                    margin-left: 2px;
                }

        .expense-wrapper .form-control,
        .expense-wrapper .form-select {
/*            min-height: 44px;*/
/*            padding: 10px 14px;*/
            border: 1px solid var(--ex-border-strong);
            border-radius: var(--ex-radius);
            color: var(--ex-text);
            background-color: var(--ex-surface);
            font-size: .875rem;
            box-shadow: var(--ex-inset);
            transition: border-color var(--ex-t), box-shadow var(--ex-t);
        }

            .expense-wrapper .form-control::placeholder {
                color: var(--ex-faint);
            }

            .expense-wrapper .form-control:hover,
            .expense-wrapper .form-select:hover {
                border-color: #9ca3af;
            }

            .expense-wrapper .form-control:focus,
            .expense-wrapper .form-select:focus {
                border-color: var(--ex-accent);
                box-shadow: 0 0 0 4px var(--ex-accent-ring);
                outline: 0;
            }

        .expense-wrapper textarea.form-control {
            min-height: 90px;
            resize: vertical;
            line-height: 1.5;
        }

        .expense-wrapper .form-control[readonly],
        .expense-wrapper .form-control:disabled,
        .expense-wrapper .form-select:disabled {
            background-color: var(--ex-surface-3);
            color: var(--ex-muted);
            cursor: not-allowed;
        }

        /* Leading icons */
        .expense-wrapper .expense-control-wrap {
            position: relative;
            display: flex;
            flex: 1;
            min-width: 0;
            width: 100%;
        }

            .expense-wrapper .expense-control-wrap > .form-control,
            .expense-wrapper .expense-control-wrap > .form-select {
                min-width: 0;
                width: 100%;
            }

        .expense-wrapper .expense-field .expense-control-wrap > .form-control,
        .expense-wrapper .expense-field .expense-control-wrap > .form-select {
/*            padding-left: 42px;*/
        }

        .expense-wrapper .expense-control-icon {
            position: absolute;
            z-index: 2;
            top: 50%;
            left: 14px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 18px;
            height: 18px;
            color: var(--ex-faint);
            font-size: 15px;
            pointer-events: none;
            transform: translateY(-50%);
        }

        .expense-wrapper .expense-control-wrap:has(textarea) .expense-control-icon {
            top: 16px;
            transform: none;
        }

        /* Input groups */
        .expense-wrapper .expense-field .input-group {
            display: flex;
            flex-wrap: nowrap;
            min-width: 0;
        }

            .expense-wrapper .expense-field .input-group > .expense-control-wrap {
                flex: 1 1 0;
            }

                .expense-wrapper .expense-field .input-group > .expense-control-wrap > .form-control,
                .expense-wrapper .expense-field .input-group > .expense-control-wrap > .form-select {
                    border-top-right-radius: 0;
                    border-bottom-right-radius: 0;
                }

        .expense-wrapper .input-group-text {
            display: inline-flex;
            align-items: center;
            padding: 0 14px;
            border: 1px solid var(--ex-border-strong);
            border-left: 0;
            border-radius: 0 var(--ex-radius) var(--ex-radius) 0;
            color: var(--ex-muted);
            background: var(--ex-surface-2);
            font-size: .8rem;
            font-weight: 600;
            white-space: nowrap;
        }

        .expense-wrapper .field-hint,
        .expense-wrapper .expense-field small {
            margin-top: 2px;
            color: var(--ex-muted);
            font-size: .72rem;
        }

        /* Wide field + summary */
        .expense-wrapper .expense-field-wide {
            grid-column: span 2;
        }

        .expense-wrapper .expense-summary-inline {
            grid-column: 3;
            display: flex;
            flex-direction: column;
            gap: 8px;
            padding-top: 4px;
        }

            .expense-wrapper .expense-summary-inline > div {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 8px;
                padding: 10px 14px;
                border: 1px solid var(--ex-border);
                border-radius: var(--ex-radius);
                background: var(--ex-surface-2);
                color: var(--ex-text-2);
                font-size: .82rem;
                font-weight: 500;
            }

            .expense-wrapper .expense-summary-inline strong {
                font-weight: 700;
                font-variant-numeric: tabular-nums;
                font-size: .9rem;
            }

            .expense-wrapper .expense-summary-inline > div:nth-child(2) {
                color: #047857;
                background: var(--ex-success-soft);
                border-color: rgba(5,150,105,.25);
            }

        .expense-wrapper .expense-summary-khr {
            display: none !important;
        }

        /* ============================================================
       BUTTONS
    ============================================================ */
        .expense-wrapper .ex-btn,
        .expense-wrapper .add-row-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            min-height: 38px;
            padding: 8px 16px;
            border: 1px solid var(--ex-border-strong);
            border-radius: var(--ex-radius);
            background: var(--ex-surface);
            color: var(--ex-text-2);
            font-size: .84rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            white-space: nowrap;
            box-shadow: var(--ex-shadow-xs);
            transition: all var(--ex-t);
        }

            .expense-wrapper .ex-btn:hover,
            .expense-wrapper .add-row-btn:hover {
                border-color: var(--ex-accent);
                color: var(--ex-accent);
                box-shadow: 0 2px 8px rgba(79, 70, 229, .15);
                transform: translateY(-1px);
            }

            .expense-wrapper .ex-btn:focus-visible,
            .expense-wrapper .add-row-btn:focus-visible {
                outline: 2px solid var(--ex-accent);
                outline-offset: 2px;
            }

        .expense-wrapper .ex-btn-primary {
            border-color: var(--ex-accent);
            background: var(--ex-accent);
            color: #fff;
            box-shadow: 0 2px 8px rgba(79,70,229,.25);
        }

            .expense-wrapper .ex-btn-primary:hover {
                background: var(--ex-accent-hover);
                border-color: var(--ex-accent-hover);
                color: #fff;
                box-shadow: 0 4px 14px rgba(79,70,229,.35);
            }

        .expense-wrapper .ex-btn-danger {
            color: var(--ex-danger);
        }

        .expense-wrapper .ex-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* ============================================================
       ENTRY MODE TABS
    ============================================================ */
        .expense-wrapper .mode-tabs-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
            margin-bottom: 16px;
        }

        .expense-wrapper .mode-tabs-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--ex-muted);
            font-size: .75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

            .expense-wrapper .mode-tabs-label i {
                color: var(--ex-accent);
            }

        .expense-wrapper .mode-toggle {
            display: inline-flex;
            gap: 4px;
            padding: 4px;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius);
            background: var(--ex-surface-3);
            margin-bottom: 16px;
        }

            .expense-wrapper .mode-toggle button {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 9px 18px;
                border: 0;
                border-radius: var(--ex-radius-sm);
                background: transparent;
                color: var(--ex-muted);
                font-size: .86rem;
                font-weight: 600;
                cursor: pointer;
                transition: all var(--ex-t);
                white-space: nowrap;
            }

                .expense-wrapper .mode-toggle button i {
                    font-size: 1rem;
                    opacity: .7;
                }

                .expense-wrapper .mode-toggle button:hover {
                    color: var(--ex-text);
                }

                .expense-wrapper .mode-toggle button.active {
                    color: var(--ex-accent);
                    background: var(--ex-surface);
                    box-shadow: var(--ex-shadow-sm);
                }

                    .expense-wrapper .mode-toggle button.active i {
                        opacity: 1;
                    }

            .expense-wrapper .mode-toggle .mode-count {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                min-width: 22px;
                height: 20px;
                padding: 0 7px;
                border-radius: 10px;
                background: var(--ex-border);
                color: var(--ex-text-2);
                font-size: .7rem;
                font-weight: 700;
                font-variant-numeric: tabular-nums;
            }

            .expense-wrapper .mode-toggle button.active .mode-count {
                background: var(--ex-accent-soft);
                color: var(--ex-accent);
            }

        .expense-wrapper .mode-context {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            padding: 10px 14px;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius);
            background: var(--ex-surface-2);
            color: var(--ex-muted);
            font-size: .82rem;
        }

            .expense-wrapper .mode-context strong {
                color: var(--ex-text);
                font-weight: 700;
            }

            .expense-wrapper .mode-context i {
                color: var(--ex-accent);
            }

        /* ============================================================
       TABLES
    ============================================================ */
        .expense-wrapper .table-container {
            width: 100%;
            overflow: hidden;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius);
            background: var(--ex-surface);
        }

        .expense-wrapper .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .expense-wrapper .expense-table {
            width: 100%;
            min-width: 900px;
            margin: 0;
            font-size: .84rem;
            border-collapse: separate;
            border-spacing: 0;
        }

            .expense-wrapper .expense-table thead th {
                position: sticky;
                top: 0;
                z-index: 2;
                padding: 11px 12px;
                border-bottom: 1px solid var(--ex-border);
                background: var(--ex-surface-2);
                color: var(--ex-muted);
                font-size: .73rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .04em;
                white-space: nowrap;
            }

            .expense-wrapper .expense-table tbody td {
                padding: 8px 10px;
                border-bottom: 1px solid var(--ex-border);
                vertical-align: middle;
                background: var(--ex-surface);
            }

            .expense-wrapper .expense-table tbody tr:nth-child(even) td {
                background: var(--ex-surface-2);
            }

            .expense-wrapper .expense-table tbody tr:last-child td {
                border-bottom: 0;
            }

            .expense-wrapper .expense-table tbody tr {
                transition: background var(--ex-t);
            }

                .expense-wrapper .expense-table tbody tr:hover td {
                    background: var(--ex-accent-soft) !important;
                }

            .expense-wrapper .expense-table .form-control,
            .expense-wrapper .expense-table .form-select {
                min-height: 38px;
                padding: 6px 10px;
                border-radius: var(--ex-radius-sm);
                font-size: .84rem;
                box-shadow: none;
            }

            .expense-wrapper .expense-table .expense-control-wrap > .form-control,
            .expense-wrapper .expense-table .expense-control-wrap > .form-select {
                padding-left: 32px;
            }

            .expense-wrapper .expense-table .expense-control-icon {
                left: 10px;
                width: 14px;
                font-size: 12px;
            }

            .expense-wrapper .expense-table .empty-row td {
                padding: 36px 20px;
                color: var(--ex-muted);
                text-align: center;
                font-size: .86rem;
                background: var(--ex-surface) !important;
                font-style: italic;
            }

        .expense-wrapper .remove-row-btn {
            display: inline-grid;
            place-items: center;
            width: 34px;
            height: 34px;
            border: 0;
            border-radius: var(--ex-radius-sm);
            background: transparent;
            color: var(--ex-danger);
            cursor: pointer;
            transition: all var(--ex-t);
        }

            .expense-wrapper .remove-row-btn:hover {
                background: var(--ex-danger-soft);
                transform: scale(1.05);
            }

        .expense-wrapper .row-total {
            color: var(--ex-text);
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .expense-wrapper .table-scroll-hint {
            display: none;
            margin-top: 8px;
            color: var(--ex-muted);
            font-size: .74rem;
        }

        /* ============================================================
       DOCUMENT UPLOADER
    ============================================================ */
        .expense-wrapper .doc-dropzone {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 140px;
            padding: 24px 20px;
            border: 2px dashed var(--ex-border-strong);
            border-radius: var(--ex-radius);
            background: var(--ex-surface-2);
            text-align: center;
            cursor: pointer;
            transition: all var(--ex-t);
        }

            .expense-wrapper .doc-dropzone:hover,
            .expense-wrapper .doc-dropzone.is-dragover,
            .expense-wrapper .doc-dropzone:focus-within {
                border-color: var(--ex-accent);
                background: var(--ex-accent-soft);
            }

            .expense-wrapper .doc-dropzone input[type="file"] {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
                z-index: 2;
            }

        .expense-wrapper .doc-dropzone-icon {
            color: var(--ex-accent);
            font-size: 2rem;
        }

        .expense-wrapper .doc-dropzone h6 {
            margin: 0;
            color: var(--ex-text);
            font-size: .9rem;
            font-weight: 600;
        }

        .expense-wrapper .doc-dropzone p {
            margin: 0;
            color: var(--ex-muted);
            font-size: .78rem;
        }

        .expense-wrapper .doc-browse {
            color: var(--ex-accent);
            text-decoration: underline;
            font-weight: 600;
        }

        .expense-wrapper .doc-list-header,
        .expense-wrapper .doc-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-top: 14px;
            color: var(--ex-muted);
            font-size: .78rem;
        }

        .expense-wrapper .doc-list {
            display: grid;
            gap: 8px;
            margin-top: 10px;
        }

        .expense-wrapper .doc-empty {
            padding: 24px;
            color: var(--ex-muted);
            text-align: center;
            font-size: .84rem;
            font-style: italic;
        }

        .expense-wrapper .doc-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 14px;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius);
            background: var(--ex-surface);
            transition: all var(--ex-t);
        }

            .expense-wrapper .doc-item:hover {
                border-color: var(--ex-accent);
                box-shadow: var(--ex-shadow-sm);
            }

        .expense-wrapper .doc-item-thumb {
            display: grid;
            place-items: center;
            flex: 0 0 40px;
            width: 40px;
            height: 40px;
            border-radius: var(--ex-radius-sm);
            color: var(--ex-accent);
            background: var(--ex-accent-soft);
            font-size: 1.1rem;
        }

        .expense-wrapper .doc-item-body {
            flex: 1;
            min-width: 0;
        }

        .expense-wrapper .doc-item-name {
            overflow: hidden;
            color: var(--ex-text);
            font-size: .84rem;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .expense-wrapper .doc-item-meta {
            color: var(--ex-muted);
            font-size: .74rem;
        }

        .expense-wrapper .doc-clear-btn {
            border: 0;
            background: transparent;
            color: var(--ex-danger);
            font-size: .78rem;
            font-weight: 600;
            cursor: pointer;
        }

        .expense-wrapper .doc-remove-btn {
            display: inline-grid;
            place-items: center;
            width: 30px;
            height: 30px;
            border: 0;
            border-radius: var(--ex-radius-sm);
            background: transparent;
            color: var(--ex-danger);
            cursor: pointer;
            transition: background var(--ex-t);
        }

            .expense-wrapper .doc-remove-btn:hover {
                background: var(--ex-danger-soft);
            }

        /* ============================================================
       JOURNAL PREVIEW
    ============================================================ */
        .expense-wrapper .journal-table {
            width: 100%;
            min-width: 600px;
            border-collapse: collapse;
            font-size: .84rem;
        }

            .expense-wrapper .journal-table th,
            .expense-wrapper .journal-table td {
                padding: 10px 14px;
                border-bottom: 1px solid var(--ex-border);
            }

            .expense-wrapper .journal-table th {
                color: var(--ex-muted);
                background: var(--ex-surface-2);
                font-size: .73rem;
                text-transform: uppercase;
                letter-spacing: .04em;
                font-weight: 700;
                text-align: left;
            }

            .expense-wrapper .journal-table td {
                color: var(--ex-text);
                background: var(--ex-surface);
            }

            .expense-wrapper .journal-table tbody tr:nth-child(even) td {
                background: var(--ex-surface-2);
            }

            .expense-wrapper .journal-table .num {
                text-align: right;
                font-variant-numeric: tabular-nums;
            }

            .expense-wrapper .journal-table tfoot td {
                color: var(--ex-text);
                font-weight: 700;
                background: var(--ex-surface-3);
            }

        .expense-wrapper .journal-balance-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 12px;
            border-radius: 20px;
            color: #b45309;
            background: var(--ex-warning-soft);
            font-size: .78rem;
            font-weight: 700;
        }

            .expense-wrapper .journal-balance-badge.is-balanced {
                color: #047857;
                background: var(--ex-success-soft);
            }

            .expense-wrapper .journal-balance-badge.is-unbalanced {
                color: #b91c1c;
                background: var(--ex-danger-soft);
            }

        .expense-wrapper .acct-validation-banner {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            margin: 16px 20px;
            padding: 12px 14px;
            border: 1px solid rgba(5,150,105,.22);
            border-radius: var(--ex-radius);
            color: #047857;
            background: var(--ex-success-soft);
            font-size: .82rem;
        }

            .expense-wrapper .acct-validation-banner.is-error {
                border-color: rgba(220,38,38,.25);
                color: #b91c1c;
                background: var(--ex-danger-soft);
            }

        /* ============================================================
       DETAILS PANELS
    ============================================================ */
        .expense-wrapper .expense-extra-panel {
            margin-bottom: 16px;
            border: 1px solid var(--ex-border);
            border-radius: var(--ex-radius-lg);
            background: var(--ex-surface);
            box-shadow: var(--ex-shadow-sm);
            overflow: hidden;
        }

            .expense-wrapper .expense-extra-panel > summary {
                padding: 16px 20px;
                cursor: pointer;
                color: var(--ex-text);
                font-size: .9rem;
                font-weight: 600;
                list-style: none;
                user-select: none;
                transition: background var(--ex-t);
            }

                .expense-wrapper .expense-extra-panel > summary::-webkit-details-marker {
                    display: none;
                }

                .expense-wrapper .expense-extra-panel > summary:hover {
                    background: var(--ex-surface-2);
                }

                .expense-wrapper .expense-extra-panel > summary:after {
                    content: "⌄";
                    float: right;
                    color: var(--ex-muted);
                    transition: transform var(--ex-t);
                }

            .expense-wrapper .expense-extra-panel[open] > summary:after {
                transform: rotate(180deg);
            }

            .expense-wrapper .expense-extra-panel .doc-card {
                border: 0;
                box-shadow: none;
                margin: 0;
                border-radius: 0;
            }

        /* ============================================================
       TOASTS
    ============================================================ */
        .expense-wrapper .toast-container {
            position: fixed;
            right: 20px;
            bottom: 88px;
            z-index: 1080;
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 10px;
            pointer-events: none;
        }

        .expense-wrapper .expense-toast {
            display: flex;
            align-items: center;
            gap: 12px;
            max-width: 420px;
            padding: 14px 16px;
            border: 1px solid var(--ex-border);
            border-left: 4px solid var(--ex-accent);
            border-radius: var(--ex-radius);
            color: var(--ex-text);
            background: var(--ex-surface);
            box-shadow: var(--ex-shadow-lg);
            font-size: .84rem;
            pointer-events: auto;
            animation: toastIn .22s var(--ex-ease);
        }

    @@keyframes toastIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .expense-wrapper .expense-toast button {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font-size: 1.2rem;
        line-height: 1;
        opacity: .6;
        transition: opacity var(--ex-t);
    }

        .expense-wrapper .expense-toast button:hover {
            opacity: 1;
        }

    .expense-wrapper .expense-toast-success {
        border-left-color: var(--ex-success);
    }

        .expense-wrapper .expense-toast-success > i {
            color: var(--ex-success);
        }

    .expense-wrapper .expense-toast-error {
        border-left-color: var(--ex-danger);
    }

        .expense-wrapper .expense-toast-error > i {
            color: var(--ex-danger);
        }

    .expense-wrapper .expense-toast-info > i {
        color: var(--ex-accent);
    }

    /* ============================================================
       VALIDATION
    ============================================================ */
    .expense-wrapper .is-invalid {
        border-color: var(--ex-danger) !important;
        box-shadow: 0 0 0 4px rgba(220,38,38,.14) !important;
    }

    .expense-wrapper .error-summary {
        margin-bottom: 20px;
        padding: 14px 18px;
        border: 1px solid rgba(220,38,38,.3);
        border-left: 4px solid var(--ex-danger);
        border-radius: var(--ex-radius);
        background: var(--ex-danger-soft);
        color: #b91c1c;
        font-size: .84rem;
    }

        .expense-wrapper .error-summary h6 {
            margin: 0 0 8px;
            font-size: .88rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .expense-wrapper .error-summary ul {
            margin: 0;
            padding-left: 20px;
        }

        .expense-wrapper .error-summary a {
            color: #b91c1c;
            text-decoration: underline;
            cursor: pointer;
        }

    /* ============================================================
       DARK MODE (base)
    ============================================================ */
    html[data-theme="dark"] .expense-wrapper,
    body[data-theme="dark"] .expense-wrapper,
    body.dark-mode .expense-wrapper {
        --ex-bg: #0b1220;
        --ex-surface: #131b2e;
        --ex-surface-2: #1a2438;
        --ex-surface-3: #232f47;
        --ex-border: #2a364e;
        --ex-border-strong: #3a4863;
        --ex-text: #e8eef8;
        --ex-text-2: #b8c4d8;
        --ex-muted: #8fa0b8;
        --ex-faint: #6a7c95;
        --ex-shadow-xs: 0 1px 2px rgba(0,0,0,.3);
        --ex-shadow-sm: 0 2px 6px rgba(0,0,0,.3);
        --ex-shadow: 0 6px 18px rgba(0,0,0,.4);
        --ex-shadow-lg: 0 14px 40px rgba(0,0,0,.5);
        --ex-inset: inset 0 1px 2px rgba(0,0,0,.3);
        background: var(--ex-bg);
    }

        html[data-theme="dark"] .expense-wrapper .form-control,
        html[data-theme="dark"] .expense-wrapper .form-select,
        body[data-theme="dark"] .expense-wrapper .form-control,
        body[data-theme="dark"] .expense-wrapper .form-select,
        body.dark-mode .expense-wrapper .form-control,
        body.dark-mode .expense-wrapper .form-select {
            background-color: var(--ex-surface-2);
            color: var(--ex-text);
            border-color: var(--ex-border-strong);
        }

        html[data-theme="dark"] .expense-wrapper .expense-table thead th,
        body[data-theme="dark"] .expense-wrapper .expense-table thead th,
        body.dark-mode .expense-wrapper .expense-table thead th {
            background: var(--ex-surface-3);
            color: var(--ex-muted);
        }

        html[data-theme="dark"] .expense-wrapper .doc-item,
        body[data-theme="dark"] .expense-wrapper .doc-item,
        body.dark-mode .expense-wrapper .doc-item {
            background: var(--ex-surface-2);
            border-color: var(--ex-border);
        }

        html[data-theme="dark"] .expense-wrapper .doc-dropzone,
        body[data-theme="dark"] .expense-wrapper .doc-dropzone,
        body.dark-mode .expense-wrapper .doc-dropzone {
            background: var(--ex-surface-2);
            border-color: var(--ex-border-strong);
        }

    /* ============================================================
       RESPONSIVE (base)
    ============================================================ */
    @@media (max-width: 1100px) {
        .expense-wrapper .expense-fields-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .expense-wrapper .expense-field-wide {
            grid-column: span 1;
        }

        .expense-wrapper .expense-summary-inline {
            grid-column: span 1;
        }

        .expense-wrapper .table-scroll-hint {
            display: block;
        }
    }

    @@media (max-width: 768px) {
        .expense-wrapper .expense-shell {
            padding: 16px 16px 24px;
        }

        .expense-wrapper .section-body {
            padding: 16px;
        }

        .expense-wrapper .expense-page-header {
            padding: 16px;
        }

        .expense-wrapper .expense-heading h1 {
            font-size: 1.15rem;
        }

        .expense-wrapper .expense-fields-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .expense-wrapper .expense-field,
        .expense-wrapper .expense-field-wide,
        .expense-wrapper .expense-summary-inline {
            grid-column: 1;
        }

        .expense-wrapper .toast-container {
            left: 16px;
            right: 16px;
            align-items: stretch;
            bottom: 100px;
        }

        .expense-wrapper .expense-toast {
            max-width: none;
        }

        .expense-wrapper .mode-tabs-label {
            display: none;
        }

        .expense-wrapper .mode-toggle button {
            padding: 8px 14px;
            font-size: .8rem;
        }
    }

    /* ============================================================
       ACCESSIBILITY
    ============================================================ */
    @@media (prefers-reduced-motion: reduce) {
        .expense-wrapper *,
        .expense-wrapper *::before,
        .expense-wrapper *::after {
            animation-duration: .01ms !important;
            transition-duration: .01ms !important;
        }
    }

    .expense-wrapper .remove-row-btn:focus-visible,
    .expense-wrapper .doc-remove-btn:focus-visible,
    .expense-wrapper .doc-clear-btn:focus-visible,
    .expense-wrapper .doc-dropzone:focus-visible {
        outline: 2px solid var(--ex-accent);
        outline-offset: 2px;
    }

    .expense-wrapper .expense-table input:focus,
    .expense-wrapper .expense-table select:focus {
        position: relative;
        z-index: 1;
    }

    /* ============================================================
       EXPENSE FORM — PREMIUM ERP STYLE OVERRIDES
    ============================================================ */
    .expense-wrapper {
        --ex-accent: #2563eb;
        --ex-accent-hover: #1d4ed8;
        --ex-accent-soft: rgba(37, 99, 235, .09);
        --ex-accent-ring: rgba(37, 99, 235, .16);
        --ex-bg: #f3f6fb;
        --ex-surface: #ffffff;
        --ex-surface-2: #f8fafc;
        --ex-surface-3: #eef2f7;
        --ex-border: #e2e8f0;
        --ex-border-strong: #cbd5e1;
        --ex-text: #0f172a;
        --ex-text-2: #334155;
        --ex-muted: #64748b;
        --ex-faint: #94a3b8;
        --ex-radius-lg: 16px;
        --ex-radius: 11px;
        --ex-radius-sm: 8px;
        --ex-shadow-xs: 0 1px 2px rgba(15, 23, 42, .04);
        --ex-shadow-sm: 0 2px 8px rgba(15, 23, 42, .045);
        --ex-shadow: 0 8px 20px rgba(15, 23, 42, .065);
        --ex-shadow-lg: 0 16px 40px rgba(15, 23, 42, .12);
        background: var(--ex-bg);
    }

        .expense-wrapper .expense-shell {
            padding: clamp(14px, 2vw, 28px) clamp(12px, 2.2vw, 32px) 24px;
        }

        .expense-wrapper .expense-page-header {
            border-color: var(--ex-border);
            border-radius: 18px;
            padding: clamp(16px, 2vw, 24px);
            background: linear-gradient(135deg, var(--ex-surface) 0%, var(--ex-surface-2) 100%);
            box-shadow: var(--ex-shadow-sm);
        }

        .expense-wrapper .expense-heading-icon {
            background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%);
            box-shadow: 0 8px 18px rgba(37, 99, 235, .22);
            border-radius: 15px;
        }

        .expense-wrapper .expense-heading h1 {
            font-size: clamp(1.15rem, 1.8vw, 1.55rem);
            letter-spacing: -.035em;
        }

        .expense-wrapper .section-card,
        .expense-wrapper .journal-card,
        .expense-wrapper .doc-card,
        .expense-wrapper .expense-extra-panel {
            border-radius: 16px;
            border-color: var(--ex-border);
            box-shadow: var(--ex-shadow-sm);
        }

            .expense-wrapper .section-card:hover {
                box-shadow: var(--ex-shadow);
                border-color: #d5dfed;
            }

        .expense-wrapper .section-header,
        .expense-wrapper .journal-header {
            padding: 17px 22px;
            background: linear-gradient(180deg, var(--ex-surface) 0%, var(--ex-surface-2) 100%);
        }

            .expense-wrapper .section-title h6,
            .expense-wrapper .journal-header h6 {
                font-size: .98rem;
                letter-spacing: -.025em;
            }

        .expense-wrapper .section-icon {
            width: 42px;
            height: 42px;
            flex-basis: 42px;
            border-radius: 12px;
        }

        .expense-wrapper .section-body {
            padding: clamp(16px, 2vw, 24px);
        }

        .expense-wrapper .expense-fields-grid {
            gap: 17px 20px;
        }

        .expense-wrapper .expense-field > label {
            color: var(--ex-text-2);
            font-size: .8rem;
            letter-spacing: -.005em;
        }

        .expense-wrapper .form-control,
        .expense-wrapper .form-select {
            min-height: 45px;
            border-radius: 10px;
            border-color: var(--ex-border-strong);
            background-color: var(--ex-surface);
            font-size: .86rem;
            box-shadow: none;
        }

            .expense-wrapper .form-control:hover,
            .expense-wrapper .form-select:hover {
                border-color: #94a3b8;
            }

            .expense-wrapper .form-control:focus,
            .expense-wrapper .form-select:focus {
                border-color: var(--ex-accent);
                box-shadow: 0 0 0 3px var(--ex-accent-ring);
            }

        .expense-wrapper .input-group-text {
            border-color: var(--ex-border-strong);
            background: var(--ex-surface-3);
            color: var(--ex-muted);
            font-weight: 650;
        }

        .expense-wrapper .expense-summary-inline > div {
            border-radius: 11px;
            padding: 11px 14px;
            background: var(--ex-surface-2);
        }

            .expense-wrapper .expense-summary-inline > div:nth-child(2) {
