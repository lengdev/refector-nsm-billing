$(document).ready(function () {

    // Get users from ViewBag
    var dataSource_UserList = @Html.Raw(
        Json.Encode(ViewBag.UserList ?? new List<SelectListItem>())
    );

    // Reusable Kendo ComboBox initialization
    function initializeUserComboBox(elementId, placeholder) {

        var $element = $("#" + elementId);

        if (!$element.length) {
            return;
        }

        // Prevent duplicate initialization
        var existingWidget = $element.data("kendoComboBox");

        if (existingWidget) {
            existingWidget.destroy();
            $element.show();
        }

        // Initialize ComboBox
        $element.kendoComboBox({

            dataSource: dataSource_UserList,

            dataTextField: "Text",
            dataValueField: "Value",

            filter: "contains",
            suggest: true,

            placeholder: placeholder,

            clearButton: true,
            autoBind: true,

            // Never select the first user automatically
            index: -1,

            height: 300,

            popup: {
                appendTo: "body"
            },

            noDataTemplate: "No users found",

            change: function () {

                if (!this.value()) {
                    this.value("");
                    this.text("");
                }
            }

        });

        var combo = $element.data("kendoComboBox");

        // Clear default selection
        combo.value("");
        combo.text("");

        // Full width
        combo.wrapper.css("width", "100%");

        // Click dropdown arrow to open / close
        combo.wrapper.find(".k-select")
            .off("click.userCombo")
            .on("click.userCombo", function (e) {

                e.preventDefault();
                e.stopPropagation();

                if (combo.popup.visible()) {
                    combo.close();
                } else {
                    combo.open();
                }
            });

        // Click input to open dropdown
        combo.input
            .off("click.userCombo")
            .on("click.userCombo", function () {
                combo.open();
            });

    }

    // Initialize all user ComboBoxes
    initializeUserComboBox("CheckedBy", "Select Checked By...");
    initializeUserComboBox("VerifiedBy", "Select Verified By...");
    initializeUserComboBox("PostedBy", "Select Posted By...");

});
</script>