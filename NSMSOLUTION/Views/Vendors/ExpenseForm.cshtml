        body[data-theme="dark"] .expense-wrapper .expense-table tbody td,
        body.dark-mode .expense-wrapper .expense-table tbody td {
            background: #111c2d;
        }

        html[data-theme="dark"] .expense-wrapper .expense-table tbody tr:nth-child(even) td,
        body[data-theme="dark"] .expense-wrapper .expense-table tbody tr:nth-child(even) td,
        body.dark-mode .expense-wrapper .expense-table tbody tr:nth-child(even) td {
            background: #172438;
        }

    /* ============================================================
       ★★★ FOUR-COLUMN EXPENSE INFORMATION GRID (NEW OVERRIDE) ★★★
    ============================================================ */
    .expense-wrapper .expense-fields-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px 18px;
        align-items: start;
    }

    .expense-wrapper .expense-field-wide {
        grid-column: span 2;
    }

    .expense-wrapper .expense-summary-inline {
        grid-column: 3 / span 2;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-top: 0;
        min-width: 0;
    }

        .expense-wrapper .expense-summary-inline > div {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 11px 14px;
            border: 1px solid var(--ex-border);
            border-radius: 9px;
            background: var(--ex-surface-2);
            color: var(--ex-text-2);
            font-size: 12px;
            font-weight: 600;
            min-height: 44px;
        }

        .expense-wrapper .expense-summary-inline strong {
            font-weight: 800;
            font-variant-numeric: tabular-nums;
            font-size: 14px;
        }

        .expense-wrapper .expense-summary-inline > div:nth-child(2) {
            color: #047857;
            background: linear-gradient(135deg, rgba(21,151,106,.10), rgba(21,151,106,.04));
            border-color: rgba(21,151,106,.28);
        }

    .expense-wrapper input.form-control,
    .expense-wrapper select.form-control,
    .expense-wrapper select.form-select {
        padding-left: 38px;
    }

    .expense-wrapper .expense-control-icon {
        left: 12px;
        font-size: 12.5px;
    }

    .expense-wrapper .expense-field .input-group {
        display: flex;
        align-items: stretch;
    }

        .expense-wrapper .expense-field .input-group > .expense-control-wrap {
            flex: 1 1 auto;
            min-width: 0;
        }

            .expense-wrapper .expense-field .input-group > .expense-control-wrap > .form-control {
                border-top-right-radius: 0;
                border-bottom-right-radius: 0;
            }

    .expense-wrapper .input-group-text {
        flex: 0 0 auto;
        padding: 0 12px;
        min-height: 44px;
        font-size: 10.5px;
    }

    @@media (max-width: 1280px) {
        .expense-wrapper .expense-fields-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .expense-wrapper .expense-field-wide {
            grid-column: span 2;
        }

        .expense-wrapper .expense-summary-inline {
            grid-column: 3 / span 1;
        }
    }

    @@media (max-width: 1050px) {
        .expense-wrapper .expense-fields-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .expense-wrapper .expense-field-wide {
            grid-column: span 2;
        }

        .expense-wrapper .expense-summary-inline {
            grid-column: 1 / -1;
            flex-direction: row;
            flex-wrap: wrap;
        }

            .expense-wrapper .expense-summary-inline > div {
                flex: 1 1 0;
                min-width: 140px;
            }
    }

    @@media (max-width: 650px) {
        .expense-wrapper .expense-fields-grid {
            grid-template-columns: minmax(0, 1fr);
            gap: 12px;
        }

        .expense-wrapper .expense-field-wide,
        .expense-wrapper .expense-summary-inline {
            grid-column: 1;
        }

        .expense-wrapper .expense-summary-inline {
            flex-direction: column;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .expense-wrapper *, .expense-wrapper *::before, .expense-wrapper *::after {
            transition: none !important;
            animation: none !important;
        }
    }
</style>

<div class="expense-wrapper">
    <div class="expense-shell">
        <form id="expenseForm" method="post" enctype="multipart/form-data" autocomplete="off" novalidate
              aria-describedby="errorSummary">
            @Html.AntiForgeryToken()

            <div id="errorSummary" class="error-summary" hidden role="alert" aria-live="assertive">
                <h6><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Please review these fields</h6>
                <ul id="errorSummaryList"></ul>
            </div>

            <!-- 1. EXPENSE INFORMATION -->
            <section class="section-card" aria-labelledby="expenseInfoHeading" data-section="info">
                <div class="section-header">
                    <div class="section-title">
                        <div class="section-icon icon-blue" aria-hidden="true">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>
                        <div>
                            <h6 id="expenseInfoHeading">Expense Information</h6>
                            <small>Basic transaction, payment and verification details</small>
                        </div>
                    </div>
                    <span class="sec-status is-warn" id="infoStatus" role="status" aria-live="polite">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>Required fields</span>
                    </span>
                </div>

                <div class="section-body">
                    <div class="expense-fields-grid">
                        <!-- Row 1: Class | Payment Method | Payee | Expense No -->
                        <div class="expense-field">
                            <label for="ClassName">Class Name</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-tags expense-control-icon" aria-hidden="true"></i>
                                @Html.DropDownList(
                                    "ClassID",
                                    ViewBag.ClassList as IEnumerable<SelectListItem>,
                                    "-- Select Class --",
                                    new { @class = "form-control", id = "ClassID", name = "ClassName" }
                                )
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="PaymentMethod">Payment Method <b aria-hidden="true">*</b></label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-credit-card expense-control-icon" aria-hidden="true"></i>
                                @Html.DropDownList(
                                "PaymentMethodID",
                                ViewBag.PaymentMethodList as IEnumerable<SelectListItem>,
                                "-- Select Payment Method --",
                                new { @class = "form-control", id = "PaymentMethodID", name = "PaymentMethod" }
                            )
                                @*<select class="form-select" name="PaymentMethod" id="PaymentMethod" required aria-required="true">
            <option value="">Select method</option>
            <option value="Cash">Cash</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="Cheque">Cheque</option>
            <option value="Credit Card">Credit Card</option>
            <option value="Other">Other</option>
        </select>*@
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="Payee">Payee <b aria-hidden="true">*</b></label>

                            <div class="expense-control-wrap expense-payee-wrap">
                                <i class="bi bi-person-badge expense-control-icon" aria-hidden="true"></i>
                                <div id="Payee"></div>
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="ExpenseNo">Expense No.</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-upc-scan expense-control-icon" aria-hidden="true"></i>
                                <input class="form-control" name="ExpenseNo" id="ExpenseNo" placeholder="Enter expense no" />                                
                            </div>
                        </div>

                        <!-- Row 2: Payment Account | Date | Terms | Paid On Date -->
                        <div class="expense-field">
                            <label for="PaymentAccountID">Payment Account <b aria-hidden="true">*</b></label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-wallet2 expense-control-icon" aria-hidden="true"></i>
                                @*<select class="form-select" name="PaymentAccountID" id="PaymentAccountID" required aria-required="true">
                                    <option value="">Select cash or bank account</option>
                                </select>*@
                                <div id="PaymentAccountID"></div>
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="ExpenseDate">Date <b aria-hidden="true">*</b></label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-calendar3 expense-control-icon" aria-hidden="true"></i>
                                <input type="text"
                                       class="form-control"
                                       name="ExpenseDate"
                                       id="ExpenseDate"
                                       required
                                       aria-required="true"
                                       autocomplete="off" />
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="Terms">Terms</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-file-earmark-text expense-control-icon" aria-hidden="true"></i>
                                <input type="text"
                                       class="form-control"
                                       name="Terms"
                                       id="Terms"
                                       placeholder="Enter terms"
                                       autocomplete="off" />
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="PaidOnDate">Paid On Date</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-calendar-check expense-control-icon" aria-hidden="true"></i>
                                <input type="text"
                                       class="form-control"
                                       name="PaidOnDate"
                                       id="PaidOnDate"
                                       placeholder="Enter paid on date"
                                       autocomplete="off" />
                            </div>
                        </div>

                        <!-- Row 3: Checked By | Verified By | Posted By | Exchange Rate -->
                        <div class="expense-field">
                            <label for="CheckedBy">Checked By</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-person-check expense-control-icon" aria-hidden="true"></i>
                                <select id="CheckedBy"
                                        name="CheckedBy"
                                        class="expense-account-kendo"
                                        style="width: 100%;">
                                    <option value="">Select Checked By...</option>
                                </select>
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="VerifiedBy">Verified By</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-patch-check expense-control-icon" aria-hidden="true"></i>
                                @*<input class="form-control" name="VerifiedBy" id="VerifiedBy" placeholder="Enter verified by" />*@
                                <select id="VerifiedBy" name="VerifiedBy" class="expense-account-kendo" style="width:100%">
                                    <option value="">Select Verified By...</option>
                                </select>
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="PostedBy">Posted By</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-person-badge-fill expense-control-icon" aria-hidden="true"></i>
                                <select id="PostedBy" name="PostedBy" class="expense-account-kendo" style="width:100%">
                                    <option value="">Select Posted By...</option>
                                </select>
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="ExchangeRate">Exchange Rate</label>
                            <div class="input-group">
                                <div class="expense-control-wrap">
                                    <i class="bi bi-currency-exchange expense-control-icon" aria-hidden="true"></i>
                                    <input type="number" class="form-control" name="ExchangeRate" id="ExchangeRate"
                                           value="4100" min="0.000001" step="0.000001" inputmode="decimal" />
                                </div>
                                <span class="input-group-text">KHR</span>
                            </div>
                        </div>

                        <!-- Row 4: PO/RF/ADV No. | Bill/Invoice No. | Description (spans 2) -->
                        <div class="expense-field">
                            <label for="ReferenceNo">PO/RF/ADV No.</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-hash expense-control-icon" aria-hidden="true"></i>
                                <input class="form-control" name="ReferenceNo" id="ReferenceNo" placeholder="Enter po/rf/adv no." />
                            </div>
                        </div>
                        <div class="expense-field">
                            <label for="InvoiceNo">Bill/Invoice No.</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-receipt expense-control-icon" aria-hidden="true"></i>
                                <input class="form-control" name="InvoiceNo" id="InvoiceNo" placeholder="Enter bill/invoice no" />
                            </div>
                        </div>
                        <div class="expense-field expense-field-wide">
                            <label for="Description">Description</label>
                            <div class="expense-control-wrap">
                                <i class="bi bi-card-text expense-control-icon" aria-hidden="true"></i>
                                <textarea class="form-control" name="Description" id="Description" maxlength="1000" rows="2"
                                          placeholder="Enter description..." aria-describedby="descriptionCount"></textarea>
                            </div>
                            <small><span id="descriptionCount">0</span>/1000 characters</small>
                        </div>

                        <!-- Summary card occupies the remaining 2 columns -->
                        <div class="expense-summary-inline" aria-label="Summary totals">
                            <div><span>Sub Total</span><strong id="summarySubtotal">0.00 USD</strong></div>
                            <div><span>Grand Total</span><strong id="grandTotal">0.00 USD</strong></div>
                            <div class="expense-summary-khr"><span>Converted</span><strong id="fxKhrTotal">0.00 KHR</strong></div>
                        </div>
                    </div>

                    <input type="hidden" name="DiscountAmount" id="DiscountAmount" value="0" />
                    <input type="hidden" name="VatRate" id="VatRate" value="0" />
                    <input type="hidden" name="WhtRate" id="WhtRate" value="0" />
                    <input type="hidden" name="EntryMode" id="EntryMode" value="items" />
                    <input type="hidden" name="Subtotal" id="SubtotalValue" />
                    <input type="hidden" name="VatAmount" id="VatAmountValue" />
                    <input type="hidden" name="WhtAmount" id="WhtAmountValue" />
                    <input type="hidden" name="GrandTotal" id="GrandTotalValue" />
                    <input type="hidden" name="GrandTotalKhr" id="GrandTotalKhrValue" />
                    <span id="summaryItemSubtotal" hidden>0.00</span>
                    <span id="summaryAccountSubtotal" hidden>0.00</span>
                    <span id="fxRate" hidden>4,100</span>
                    <span id="basisLabel" hidden></span>
                    <span id="lastCalculated" hidden></span>
                </div>
            </section>

            <!-- 2. TRANSACTION DETAILS -->
            <section class="section-card" aria-labelledby="transactionHeading" data-section="lines">
                <div class="section-header">
                    <div class="section-title">
                        <div class="section-icon icon-green" aria-hidden="true">
                            <i class="bi bi-list-check"></i>
                        </div>
                        <div>
                            <h6 id="transactionHeading">Transaction Details</h6>
                            <small>Record purchased items or allocate expenses to accounts</small>
                        </div>
                    </div>
                    <span class="sec-status is-warn" id="linesStatus" role="status" aria-live="polite">
                        <i class="bi bi-exclamation-circle" aria-hidden="true"></i>
                        <span>No lines yet</span>
                    </span>
                </div>

                <div class="section-body">
                    <div class="ux-guide">
                        <i class="bi bi-lightbulb" aria-hidden="true"></i>
                        <div>
                            <strong>Pick one mode.</strong>
                            Use <strong>Items</strong> when you bought physical goods or services with quantity × price.
                            Use <strong>Expense Accounts</strong> when you're allocating the total to ledger accounts
                            (rent, utilities, etc.). You can switch anytime — totals update automatically.
                        </div>
                    </div>

                    <div class="mode-tabs-bar">
                        <span class="mode-tabs-label">
                            <i class="bi bi-ui-checks" aria-hidden="true"></i>
                            Choose entry mode
                        </span>
                        <div class="d-flex gap-2">
                            <button type="button" class="add-row-btn" id="addItemBtn">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Item
                            </button>
                            <button type="button" class="add-row-btn" id="addAccountBtn" style="display:none;">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> Add Account
                            </button>
                        </div>
                    </div>

                    <div class="mode-toggle" role="tablist" aria-label="Entry mode tabs">
                        <button type="button" id="modeItems" class="active" role="tab" aria-selected="true"
                                aria-controls="itemsPane" tabindex="0">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                            <span>Items</span>
                            <span class="mode-count" id="modeItemsCount" aria-label="0 items">0</span>
                        </button>
                        <button type="button" id="modeAccounts" role="tab" aria-selected="false"
                                aria-controls="accountsPane" tabindex="-1">
                            <i class="bi bi-journal-text" aria-hidden="true"></i>
                            <span>Expense Accounts</span>
                            <span class="mode-count" id="modeAccountsCount" aria-label="0 accounts">0</span>
                        </button>
                    </div>

                    <div class="mode-context" id="modeContext" role="status" aria-live="polite">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                        <span>You are viewing <strong id="modeContextLabel">Items</strong> — totals and journal below use this mode.</span>
                    </div>

                    <div class="tab-content">
                        <div class="tab-pane fade show active" id="itemsPane" role="tabpanel"
                             aria-labelledby="modeItems" tabindex="0">
                            <div class="table-container">
                                <div class="table-responsive">
                                    <table class="table expense-table">
                                        <caption class="visually-hidden">Expense line items</caption>
                                        <thead>
                                            <tr>
                                                <th style="width:45px" scope="col">#</th>
                                                <th style="min-width:210px" scope="col">Item / Service</th>
                                                <th style="min-width:90px" scope="col">UOM</th>
                                                <th style="min-width:100px" scope="col">Qty</th>
                                                <th style="min-width:120px" scope="col">Unit Price</th>
                                                <th style="min-width:120px" scope="col">Discount</th>
                                                <th style="min-width:130px;text-align:right" scope="col">Total</th>
                                                <th style="width:45px" scope="col"><span class="visually-hidden">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody id="itemTableBody">
                                            <tr class="empty-row"><td colspan="8">No items added yet. Click "Add Item" to begin.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="table-scroll-hint"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Swipe horizontally to see all columns</div>

                            <div class="d-flex justify-content-between mt-3">
                                <small class="empty-hint">Tip: press <kbd>Enter</kbd> in the last cell to add a new row.</small>
                                <strong style="font-size:13px">Items: <span id="itemSubtotal">0.00</span> USD</strong>
                            </div>
                        </div>

                        <div class="tab-pane fade" id="accountsPane" role="tabpanel" aria-labelledby="modeAccounts" tabindex="0">
                            <div class="table-container">
                                <div class="table-responsive">
                                    <table class="table expense-table">
                                        <caption class="visually-hidden">Expense account allocations</caption>
                                        <thead>
                                            <tr>
                                                <th style="width:45px" scope="col">#</th>
                                                <th style="min-width:210px" scope="col">Expense Account</th>
                                                <th style="min-width:190px" scope="col">Description</th>
                                                <th style="min-width:85px" scope="col">UOM</th>
                                                <th style="min-width:95px" scope="col">Qty</th>
                                                <th style="min-width:120px" scope="col">Unit Price</th>
                                                <th style="min-width:130px;text-align:right" scope="col">Total</th>
                                                <th style="width:45px" scope="col"><span class="visually-hidden">Actions</span></th>
                                            </tr>
                                        </thead>
                                        <tbody id="expenseTableBody">
                                            <tr class="empty-row"><td colspan="8">No expense accounts added yet. Click "Add Account" to begin.</td></tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="table-scroll-hint"><i class="bi bi-arrow-left-right" aria-hidden="true"></i> Swipe horizontally to see all columns</div>

                            <div class="text-end mt-3">
                                <strong style="font-size:13px">Expense Accounts: <span id="accountSubtotal">0.00</span> USD</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <details class="expense-extra-panel">
                <summary><i class="bi bi-paperclip" aria-hidden="true"></i> Supporting Documents <span class="empty-hint">Optional attachments</span></summary>
                <div class="doc-card">
                    <div class="doc-dropzone" id="docDropzone" tabindex="0" role="button"
                         aria-label="Add attachments (drag and drop or press Enter)">
                        <input type="file" id="Attachments" name="Attachments" multiple
                               accept=".pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx"
                               aria-label="Attachment files" />
                        <span class="doc-dropzone-icon" aria-hidden="true"><i class="bi bi-cloud-arrow-up"></i></span>
                        <h6>Drop files here or <span class="doc-browse">click to browse</span></h6>
                        <p>Max 10 MB per file · Up to 10 files</p>
                    </div>
                    <div class="doc-list-header"><span id="docCountBadge">0 files</span><span id="docTotalSize">0 KB</span></div>
                    <div class="doc-list" id="attachmentList">
                        <div class="doc-empty" id="docEmptyState">No files attached yet.</div>
                    </div>
                    <div class="doc-footer">
                        <span><strong id="docCount">0</strong> file(s) selected</span>
                        <button type="button" class="doc-clear-btn" id="docClearBtn" hidden>Clear all</button>
                    </div>
                </div>
            </details>

            <details class="expense-extra-panel expense-journal-panel">
                <summary><i class="bi bi-journal-bookmark" aria-hidden="true"></i> Journal Entry Preview <span class="empty-hint">Accounting validation</span></summary>
                <section class="journal-card" aria-labelledby="journalHeading" data-section="journal">
                    <div class="journal-header">
                        <h6 id="journalHeading">
                            <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                            Journal Entry Preview
                        </h6>
                        <span class="journal-balance-badge is-balanced" id="journalBalanceBadge" role="status" aria-live="polite">
                            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                            <span id="journalBalanceText">Balanced</span>
                        </span>
                    </div>

                    <div class="table-responsive">
                        <table class="journal-table">
                            <caption class="visually-hidden">Journal entry preview</caption>
                            <thead>
                                <tr>
                                    <th scope="col" style="width:120px">Account</th>
                                    <th scope="col">Account Name</th>
                                    <th scope="col" class="num" style="width:140px">Debit</th>
                                    <th scope="col" class="num" style="width:140px">Credit</th>
                                </tr>
                            </thead>
                            <tbody id="journalBody">
                                <tr>
                                    <td colspan="4" class="empty-hint" style="text-align:center;padding:24px">
                                        Add expense details to preview the journal entry.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2">Totals</td>
                                    <td class="num" id="journalDrTotal">0.00</td>
                                    <td class="num" id="journalCrTotal">0.00</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div id="acctValidation" class="acct-validation-banner is-ok" role="status" aria-live="polite">
                        <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                        <div id="acctValidationMsg">Ready to post. All accounting checks passed.</div>
                    </div>
                </section>
            </details>
        </form>

        <div class="toast-container" id="toastContainer" aria-live="polite" aria-atomic="true"></div>
    </div>
</div>

<script>
    (function (window, document) {
        "use strict";

        /* ============================================================
           EXPENSE FORM INITIALISER
        ============================================================ */
        function initExpenseForm(root) {
            root = root || document;
            const form = root.querySelector && root.querySelector("#expenseForm");
            if (!form || form.dataset.expenseInitialized === "true") return;

            const config = window.ExpenseFormConfig || {};

            /* ---------- DOM helpers ---------- */
            const byId = (id) => form.querySelector("#" + id);
            const all = (sel, ctx) => (ctx || form).querySelectorAll(sel);

            const money = (v) => {
                if (v == null || String(v).trim() === "") return 0;
                const n = Number(String(v).replace(/,/g, ""));
                return Number.isFinite(n) ? n : 0;
            };
            const round2 = (v) => Math.round((money(v) + Number.EPSILON) * 100) / 100;
            const fmt = (v) => round2(v).toLocaleString(undefined, {
                minimumFractionDigits: 2, maximumFractionDigits: 2
            });

            const escapeHtml = (v) => String(v ?? "").replace(/[&<>"']/g, ch => ({
                "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
            }[ch]));

            const setText = (id, value) => {
                const el = byId(id);
                if (el) el.textContent = value;
            };

            const setValue = (id, value) => {
                const el = byId(id);
                if (el) el.value = value;
            };

            /* ---------- Required nodes ---------- */
            const itemBody = byId("itemTableBody");
            const accountBody = byId("expenseTableBody");
            const attachmentInput = byId("Attachments");
            const dropzone = byId("docDropzone");
            const toastHost = byId("toastContainer");
            if (!itemBody || !accountBody) return;

            form.dataset.expenseInitialized = "true";

            /* ---------- Field icons ---------- */
            const fieldIconMap = {
                Payee: "bi-person-badge",
                ExpenseDate: "bi-calendar3",
                InvoiceNo: "bi-receipt",
                DiscountAmount: "bi-percent",
                PaymentAccountID: "bi-wallet2",
                PaidOnDate: "bi-calendar-check",
                ReferenceNo: "bi-upc-scan",
                VatRate: "bi-percent",
                PaymentMethod: "bi-credit-card",
                ExchangeRate: "bi-currency-exchange",
                ClassName: "bi-tags",
                WhtRate: "bi-shield-check",
                Description: "bi-card-text",
                Attachments: "bi-paperclip"
            };

            function getFieldIcon(control) {
                const id = control.id || "";
                if (fieldIconMap[id]) return fieldIconMap[id];

                const cls = control.classList;
                if (cls.contains("item-name")) return "bi-box-seam";
                if (cls.contains("item-uom")) return "bi-rulers";
                if (cls.contains("item-qty") || cls.contains("account-qty")) return "bi-hash";
                if (cls.contains("item-price") || cls.contains("account-price")) return "bi-cash";
                if (cls.contains("item-discount")) return "bi-percent";
                if (cls.contains("account-select")) return "bi-journal-text";
                if (cls.contains("account-description")) return "bi-card-text";
                if (cls.contains("account-uom")) return "bi-rulers";
                return control.tagName === "SELECT" ? "bi-chevron-expand" : "bi-pencil-square";
            }

            function enhanceFieldIcons(scope) {
                const controls = scope.querySelectorAll(
                    '.expense-field input:not([type="hidden"]):not([type="file"]), ' +
                    '.expense-field select, .expense-field textarea, ' +
                    '.expense-table input:not([type="hidden"]), .expense-table select'
                );

                controls.forEach(function (control) {
                    if (control.closest(".expense-control-wrap")) return;
                    if (control.type === "file" || control.type === "checkbox" || control.type === "radio") return;

                    const wrapper = document.createElement("span");
                    wrapper.className = "expense-control-wrap";
                    const icon = document.createElement("i");
                    icon.className = "bi " + getFieldIcon(control) + " expense-control-icon";
                    icon.setAttribute("aria-hidden", "true");

                    const parent = control.parentNode;
                    parent.insertBefore(wrapper, control);
                    wrapper.appendChild(icon);
                    wrapper.appendChild(control);
                });
            }

            enhanceFieldIcons(form);

            const iconObserver = new MutationObserver(function (records) {
                records.forEach(function (record) {
                    record.addedNodes.forEach(function (node) {
                        if (node.nodeType === 1) {
                            if (node.matches && node.matches("tr[data-row]")) enhanceFieldIcons(node);
                            else if (node.querySelectorAll) enhanceFieldIcons(node);
                        }
                    });
                });
            });
            iconObserver.observe(form, { childList: true, subtree: true });

            /* ---------- State ---------- */
            let itemIndex = 0;
            let accountIndex = 0;
            let selectedFiles = [];
            let isSubmitting = false;
            let calcPending = false;
            let dirty = false;
            let activeMode = "items";
            let isResetting = false;
            let calcRaf = null;

            /* ---------- Account data ---------- */
            const samplePaymentAccounts = [
                { id: "1000", code: "1000", name: "Cash on Hand" },
                { id: "1010", code: "1010", name: "Bank – Operating Account" },
                { id: "1020", code: "1020", name: "Bank – Petty Cash" }
            ];
            const sampleExpenseAccounts = [
                { id: "5000", code: "5000", name: "Office Supplies", type: "expense" },
                { id: "5010", code: "5010", name: "Travel & Transportation", type: "expense" },
                { id: "5020", code: "5020", name: "Meals & Entertainment", type: "expense" },
                { id: "5030", code: "5030", name: "Utilities", type: "expense" },
                { id: "5040", code: "5040", name: "Professional Fees", type: "expense" },
                { id: "1500", code: "1500", name: "Equipment", type: "asset" },
                { id: "1510", code: "1510", name: "Prepaid Expenses", type: "asset" }
            ];

            const useDemoAccounts = config.useDemoAccounts === true;
            const paymentAccounts = Array.isArray(config.paymentAccounts)
                ? config.paymentAccounts
                : (useDemoAccounts ? samplePaymentAccounts : []);
            const expenseAccounts = (Array.isArray(config.expenseAccounts)
                ? config.expenseAccounts
                : (useDemoAccounts ? sampleExpenseAccounts : []))
                .filter(a => !a.type || /expense|asset/i.test(String(a.type)));

            /* ============================================================
               TOASTS
            ============================================================ */
            function showToast(message, type) {
                type = type || "info";
                if (!toastHost) { window.alert(message); return; }
                const toast = document.createElement("div");
                toast.className = "expense-toast expense-toast-" + type;
                toast.setAttribute("role", "status");
                toast.setAttribute("aria-live", type === "error" ? "assertive" : "polite");

                const icon = type === "success" ? "bi-check-circle"
                    : type === "error" ? "bi-exclamation-circle"
                        : "bi-info-circle";

                toast.innerHTML =
                    '<i class="bi ' + icon + '" aria-hidden="true"></i>' +
                    '<span>' + escapeHtml(message) + '</span>' +
                    '<button type="button" aria-label="Dismiss">&times;</button>';

                let timer = window.setTimeout(() => toast.remove(), 4500);
                toast.querySelector("button").addEventListener("click", () => {
                    window.clearTimeout(timer);
                    toast.remove();
                });
                toastHost.appendChild(toast);
            }

            /* ============================================================
               STATUS
            ============================================================ */
            function setStatus(text, state) {
                /* Optional: update #postingStatus if host page provides one. */
                const node = document.getElementById("postingStatus");
                if (node) {
                    const icon = state === "posted" ? "bi-check-circle-fill"
                        : state === "warning" ? "bi-exclamation-circle-fill"
                            : "bi-circle";
                    node.innerHTML = '<i class="bi ' + icon + '" aria-hidden="true"></i> ' + escapeHtml(text);
                    node.dataset.state = state || "draft";
                }
            }

            /* ============================================================
               OPTIONS
            ============================================================ */
            function optionsHtml(list, placeholder, selected) {
                selected = selected == null ? "" : selected;
                const disabled = !list.length ? " disabled" : "";
                let head = '<option value=""' + disabled + '>' + escapeHtml(placeholder) + '</option>';
                return head + list.map(function (a) {
                    const id = a.id ?? a.value ?? a.AccountID ?? a.accountId ?? "";
                    const code = a.code ?? a.AccountCode ?? a.AccountNo ?? "";
                    const name = a.name ?? a.text ?? a.AccountName ?? a.accountName ?? "";
                    const label = [code, name].filter(Boolean).join(" - ") || String(id);
                    return '<option value="' + escapeHtml(id) + '"' +
                        (String(id) === String(selected) ? " selected" : "") + '>' +
                        escapeHtml(label) + '</option>';
                }).join("");
            }

            /* ============================================================
               TABLE HELPERS
            ============================================================ */
            function updateEmptyState(tbody, colspan, message) {
                const rows = tbody.querySelectorAll('tr[data-row]');
                const emptyRow = tbody.querySelector(".empty-row");
                if (!rows.length) {
                    if (!emptyRow) {
                        const tr = document.createElement("tr");
                        tr.className = "empty-row";
                        const td = document.createElement("td");
                        td.colSpan = colspan;
                        td.textContent = message;
                        tr.appendChild(td);
                        tbody.appendChild(tr);
                    }
                } else if (emptyRow) {
                    emptyRow.remove();
                }
            }

            function renumber(tbody) {
                tbody.querySelectorAll('tr[data-row]').forEach(function (row, i) {
                    const cell = row.querySelector("[data-row-number]");
                    if (cell) cell.textContent = i + 1;
                });
            }

            /* ============================================================
               ROW BUILDERS
            ============================================================ */
            function addItemRow(values) {
                values = values || {};
                const e = itemBody.querySelector(".empty-row");
                if (e) e.remove();

                const index = itemIndex++;
                const tr = document.createElement("tr");
                tr.dataset.row = "item";
                tr.innerHTML =
                    '<td data-row-number>' + (itemBody.querySelectorAll('tr[data-row]').length + 1) + '</td>' +
                    '<td><input class="form-control item-name" name="Items[' + index + '].ItemName" value="' +
                    escapeHtml(values.name || "") + '" placeholder="Product or service" maxlength="250"></td>' +
                    '<td><input class="form-control item-uom" name="Items[' + index + '].UOM" value="' +
                    escapeHtml(values.uom || "Unit") + '" placeholder="Unit" maxlength="50"></td>' +
                    '<td><input class="form-control item-qty" type="number" min="0" step="0.0001" inputmode="decimal" ' +
                    'name="Items[' + index + '].Quantity" value="' + (values.qty != null ? values.qty : 1) + '"></td>' +
                    '<td><input class="form-control item-price" type="number" min="0" step="0.01" inputmode="decimal" ' +
                    'name="Items[' + index + '].UnitPrice" value="' + (values.price != null ? values.price : 0) + '"></td>' +
                    '<td><input class="form-control item-discount" type="number" min="0" step="0.01" inputmode="decimal" ' +
                    'name="Items[' + index + '].Discount" value="' + (values.discount != null ? values.discount : 0) + '"></td>' +
                    '<td class="text-end fw-semibold"><span class="row-total">0.00</span></td>' +
                    '<td><button type="button" class="remove-row-btn" data-remove-row aria-label="Remove item" title="Remove item">' +
                    '<i class="bi bi-trash3" aria-hidden="true"></i></button></td>';

                itemBody.appendChild(tr);
                dirty = true;
                scheduleCalculate();

                const nameInput = tr.querySelector(".item-name");
                if (nameInput) nameInput.focus();
                return tr;
            }

            function addExpenseRow(values) {
                values = values || {};
                const e = accountBody.querySelector(".empty-row");
                if (e) e.remove();

                const index = accountIndex++;
                const tr = document.createElement("tr");
                tr.dataset.row = "account";
                tr.innerHTML =
                    '<td data-row-number>' + (accountBody.querySelectorAll('tr[data-row]').length + 1) + '</td>' +
                    '<td><select class="form-select account-select" name="ExpenseAccounts[' + index + '].AccountID">' +
                    optionsHtml(expenseAccounts,
                        expenseAccounts.length ? "Select expense account" : "Configure expense accounts",
                        values.accountId) +
                    '</select></td>' +
                    '<td><input class="form-control account-description" name="ExpenseAccounts[' + index + '].Description" value="' +
                    escapeHtml(values.description || "") + '" placeholder="Expense description" maxlength="500"></td>' +
                    '<td><input class="form-control account-uom" name="ExpenseAccounts[' + index + '].UOM" value="' +
                    escapeHtml(values.uom || "Unit") + '" placeholder="Unit" maxlength="50"></td>' +
                    '<td><input class="form-control account-qty" type="number" min="0" step="0.0001" inputmode="decimal" ' +
                    'name="ExpenseAccounts[' + index + '].Quantity" value="' + (values.qty != null ? values.qty : 1) + '"></td>' +
                    '<td><input class="form-control account-price" type="number" min="0" step="0.01" inputmode="decimal" ' +
                    'name="ExpenseAccounts[' + index + '].UnitPrice" value="' + (values.price != null ? values.price : 0) + '"></td>' +
                    '<td class="text-end fw-semibold"><span class="row-total">0.00</span></td>' +
                    '<td><button type="button" class="remove-row-btn" data-remove-row aria-label="Remove account" title="Remove account">' +
                    '<i class="bi bi-trash3" aria-hidden="true"></i></button></td>';

                accountBody.appendChild(tr);
                dirty = true;
                scheduleCalculate();

                const sel = tr.querySelector(".account-select");
                if (sel) sel.focus();
                return tr;
            }

            /* ============================================================
               MATH
            ============================================================ */
            function rowAmount(row, type) {
                const qtyEl = row.querySelector(type === "item" ? ".item-qty" : ".account-qty");
                const priceEl = row.querySelector(type === "item" ? ".item-price" : ".account-price");
                const discEl = type === "item" ? row.querySelector(".item-discount") : null;
                const qty = Math.max(0, money(qtyEl && qtyEl.value));
                const price = Math.max(0, money(priceEl && priceEl.value));
                const discount = discEl ? Math.max(0, money(discEl.value)) : 0;
                return round2(Math.max(0, qty * price - discount));
            }

            function getTotals() {
                let items = 0, accounts = 0;
                itemBody.querySelectorAll('tr[data-row="item"]').forEach(r => items += rowAmount(r, "item"));
                accountBody.querySelectorAll('tr[data-row="account"]').forEach(r => accounts += rowAmount(r, "account"));
                items = round2(items); accounts = round2(accounts);

                const hasAccounts = activeMode === "accounts";
                const baseSubtotal = hasAccounts ? accounts : items;

                const discountEl = byId("DiscountAmount");
                const discount = Math.min(baseSubtotal, Math.max(0, money(discountEl && discountEl.value)));
                const taxableBase = round2(baseSubtotal - discount);

                const vatRate = Math.max(0, money((byId("VatRate") || {}).value));
                const whtRate = Math.max(0, money((byId("WhtRate") || {}).value));
                const vat = round2(taxableBase * vatRate / 100);
                const wht = round2(taxableBase * whtRate / 100);
                const grand = round2(taxableBase + vat - wht);

                const rate = Math.max(0, money((byId("ExchangeRate") || {}).value));

                return {
                    items, accounts,
                    subtotal: round2(baseSubtotal),
                    basis: hasAccounts ? "accounts" : "items",
                    discount, taxableBase,
                    vatRate, vat, whtRate, wht, grand, rate,
                    khr: round2(grand * rate)
                };
            }

            function localDateValue(date) {
                const d = date || new Date();
                const y = d.getFullYear();
                const m = String(d.getMonth() + 1).padStart(2, "0");
                const day = String(d.getDate()).padStart(2, "0");
                return y + "-" + m + "-" + day;
            }

            function scheduleCalculate() {
                if (isResetting) return;
                dirty = true;
                if (calcPending) return;
                calcPending = true;
                const raf = window.requestAnimationFrame || (fn => setTimeout(fn, 16));
                calcRaf = raf(() => {
                    calcPending = false;
                    calcRaf = null;
                    calculate();
                });
            }

            /* ============================================================
               MODE TAB HELPERS
            ============================================================ */
            function updateModeCounts() {
                const itemCount = itemBody.querySelectorAll('tr[data-row="item"]').length;
                const accountCount = accountBody.querySelectorAll('tr[data-row="account"]').length;
                const ic = byId("modeItemsCount");
                const ac = byId("modeAccountsCount");
                if (ic) {
                    ic.textContent = itemCount;
                    ic.setAttribute("aria-label", itemCount + (itemCount === 1 ? " item" : " items"));
                }
                if (ac) {
                    ac.textContent = accountCount;
                    ac.setAttribute("aria-label", accountCount + (accountCount === 1 ? " account" : " accounts"));
                }
            }

            /* ============================================================
               MAIN CALCULATE
            ============================================================ */
            function calculate() {
                itemBody.querySelectorAll('tr[data-row="item"]').forEach(r => {
                    const c = r.querySelector(".row-total");
                    if (c) c.textContent = fmt(rowAmount(r, "item"));
                });
                accountBody.querySelectorAll('tr[data-row="account"]').forEach(r => {
                    const c = r.querySelector(".row-total");
                    if (c) c.textContent = fmt(rowAmount(r, "account"));
                });

                updateEmptyState(itemBody, 8, 'No items added yet. Click "Add Item" to begin.');
                updateEmptyState(accountBody, 8, 'No expense accounts added yet. Click "Add Account" to begin.');
                renumber(itemBody);
                renumber(accountBody);
                updateModeCounts();

                const t = getTotals();

                setText("itemSubtotal", fmt(t.items));
                setText("accountSubtotal", fmt(t.accounts));
                setText("summaryItemSubtotal", fmt(t.items));
                setText("summaryAccountSubtotal", fmt(t.accounts));
                setText("summarySubtotal", fmt(t.subtotal) + " USD");
                setText("grandTotal", fmt(t.grand) + " USD");
                setText("fxKhrTotal", fmt(t.khr) + " KHR");
                setText("fxRate", t.rate.toLocaleString());

                setText("basisLabel", t.basis === "accounts" ? "(from accounts)"
                    : t.basis === "items" ? "(from items)" : "");

                const lc = byId("lastCalculated");
                if (lc) lc.textContent = "Updated " + new Date().toLocaleTimeString();

                setValue("SubtotalValue", t.subtotal.toFixed(2));
                setValue("VatAmountValue", t.vat.toFixed(2));
                setValue("WhtAmountValue", t.wht.toFixed(2));
                setValue("GrandTotalValue", t.grand.toFixed(2));
                setValue("GrandTotalKhrValue", t.khr.toFixed(2));

                updateSectionStatuses(t);
                renderJournal(t);
                return t;
            }

            /* ============================================================
               SECTION STATUS CHIPS
            ============================================================ */
            function updateSectionStatuses(t) {
                const required = ["ExpenseDate", "PaymentMethod", "PaymentAccountID"];
                const missing = required.filter(id => !String((byId(id) || {}).value || "").trim());
                const infoStatus = byId("infoStatus");
                if (infoStatus) {
                    if (missing.length === 0) {
                        infoStatus.className = "sec-status is-ok";
                        infoStatus.innerHTML = '<i class="bi bi-check-circle" aria-hidden="true"></i><span>Complete</span>';
                    } else {
                        infoStatus.className = "sec-status is-warn";
                        infoStatus.innerHTML = '<i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>' +
                            missing.length + ' required missing</span>';
                    }
                }

                const linesStatus = byId("linesStatus");
                if (linesStatus) {
                    const count = itemBody.querySelectorAll('tr[data-row="item"]').length +
                        accountBody.querySelectorAll('tr[data-row="account"]').length;
                    if (count === 0) {
                        linesStatus.className = "sec-status is-warn";
                        linesStatus.innerHTML = '<i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>No lines yet</span>';
                    } else if (t.subtotal <= 0) {
                        linesStatus.className = "sec-status is-warn";
                        linesStatus.innerHTML = '<i class="bi bi-exclamation-circle" aria-hidden="true"></i><span>Add amounts</span>';
                    } else {
                        linesStatus.className = "sec-status is-ok";
                        linesStatus.innerHTML = '<i class="bi bi-check-circle" aria-hidden="true"></i><span>' +
                            count + ' line' + (count === 1 ? '' : 's') + '</span>';
                    }
                }
            }

            /* ============================================================
               JOURNAL
            ============================================================ */
            function renderJournal(t) {
                const body = byId("journalBody");
                if (!body) return;

                const lines = [];
                const accountRows = accountBody.querySelectorAll('tr[data-row="account"]');
                const itemRows = itemBody.querySelectorAll('tr[data-row="item"]');

                if (activeMode === "accounts") {
                    accountRows.forEach(function (row) {
                        const select = row.querySelector(".account-select");
                        const option = select && select.selectedOptions[0];
                        const amount = rowAmount(row, "account");
                        if (amount > 0) {
                            lines.push({
                                code: (option && option.value) || "—",
                                name: (option && option.textContent.trim()) || "Unselected expense account",
                                debit: amount, credit: 0
                            });
                        }
                    });
                } else {
                    itemRows.forEach(function (row) {
                        const nameEl = row.querySelector(".item-name");
                        const name = (nameEl && nameEl.value.trim()) || "Expense item";
                        const amount = rowAmount(row, "item");
                        if (amount > 0) lines.push({ code: "ITEM", name, debit: amount, credit: 0 });
                    });
                }

                if (t.discount > 0) lines.push({ code: "DISC", name: "Discount Received", debit: 0, credit: t.discount });
                if (t.vat > 0) lines.push({ code: "VAT-IN", name: "Input VAT", debit: t.vat, credit: 0 });
                if (t.wht > 0) lines.push({ code: "WHT-PAY", name: "Withholding Tax Payable", debit: 0, credit: t.wht });

                // const payment = byId("PaymentAccountID");
                // const paymentName = (payment && payment.selectedOptions[0])
                //     ? payment.selectedOptions[0].textContent.trim()
                //     : "Payment account";
                // if (t.grand > 0) {
                //     lines.push({
                //         code: (payment && payment.value) || "PAYMENT",
                //         name: paymentName, debit: 0, credit: round2(t.grand)
                //     });
                // }

                if (!lines.length) {
                    body.innerHTML = '<tr><td colspan="4" style="padding:24px">' +
                        '<div class="text-center" style="color:var(--ex-muted)">' +
                        '<i class="bi bi-journal-x" aria-hidden="true" style="font-size:1.6rem;display:block;margin-bottom:8px"></i>' +
                        'Add an item or expense account to see how this will be posted.' +
                        '</div></td></tr>';
                } else {
                    body.innerHTML = lines.map(function (l) {
                        return '<tr>' +
                            '<td>' + escapeHtml(l.code) + '</td>' +
                            '<td>' + escapeHtml(l.name) + '</td>' +
                            '<td class="num">' + (l.debit ? fmt(l.debit) : "—") + '</td>' +
                            '<td class="num">' + (l.credit ? fmt(l.credit) : "—") + '</td>' +
                            '</tr>';
                    }).join("");
                }

                const debit = round2(lines.reduce((s, x) => s + x.debit, 0));
                const credit = round2(lines.reduce((s, x) => s + x.credit, 0));
                setText("journalDrTotal", fmt(debit));
                setText("journalCrTotal", fmt(credit));

                const balanced = lines.length > 0 && Math.abs(debit - credit) < 0.01;
                const badge = byId("journalBalanceBadge");
                if (badge) {
                    badge.classList.toggle("is-balanced", balanced);
                    badge.classList.toggle("is-unbalanced", !balanced && lines.length > 0);
                }
                setText("journalBalanceText", lines.length === 0 ? "—" : (balanced ? "Balanced" : "Out of balance"));

                const banner = byId("acctValidation");
                const msg = byId("acctValidationMsg");
                if (banner) {
                    banner.classList.toggle("is-ok", balanced);
                    banner.classList.toggle("is-error", !balanced && lines.length > 0);
                }
                if (msg) {
                    if (lines.length === 0) {
                        msg.textContent = "Add expense accounts or items to preview the journal entry.";
                    } else if (balanced) {
                        msg.textContent = "Journal preview is balanced. Confirm account mappings before posting.";
                    } else {
                        msg.textContent = "Journal is out of balance by " + fmt(Math.abs(debit - credit)) + ".";
                    }
                }
            }

            /* ============================================================
               PAYMENT ACCOUNTS
            ============================================================ */
            function refreshPaymentAccounts() {
                const select = byId("PaymentAccountID");
                if (!select) return;
                const current = select.value;
                select.innerHTML = optionsHtml(
                    paymentAccounts,
                    paymentAccounts.length ? "Select cash or bank account" : "No payment accounts configured",
                    current
                );
            }

            /* ============================================================
               VALIDATION
            ============================================================ */
            function getFieldLabel(el, fallback) {
                if (!el) return fallback;
                const wrapper = el.closest(".expense-field, .form-group, .mb-3");
                if (wrapper) {
                    const label = wrapper.querySelector("label, .form-label");
                    if (label) return label.textContent.replace(/\*/g, "").trim();
                }
                return el.getAttribute("placeholder") || el.name || fallback || "Field";
            }

            function validateForm() {
                all(".is-invalid").forEach(el => el.classList.remove("is-invalid"));
                const issues = [];
                const markInvalid = (el, label) => {
                    if (!el) return;
                    el.classList.add("is-invalid");
                    issues.push({ el, label });
                };

                ["Payee", "ExpenseDate", "PaymentMethod", "PaymentAccountID"].forEach(function (id) {
                    const el = byId(id);
                    if (el && !String(el.value || "").trim()) {
                        markInvalid(el, getFieldLabel(el, id) + " is required");
                    }
                });

                const fx = byId("ExchangeRate");
                if (fx && money(fx.value) <= 0) markInvalid(fx, "Exchange Rate must be greater than 0");

                const t = calculate();
                const disc = byId("DiscountAmount");
                if (disc && money(disc.value) > t.subtotal + 0.001) {
                    markInvalid(disc, "Discount cannot exceed subtotal");
                }

                if (activeMode === "accounts") {
                    accountBody.querySelectorAll('tr[data-row="account"]').forEach(function (row) {
                        const select = row.querySelector(".account-select");
                        const amount = rowAmount(row, "account");
                        if (select && !select.value && amount > 0) markInvalid(select, "Expense Account is required");
                    });
                }

                const activeRows = activeMode === "accounts"
                    ? accountBody.querySelectorAll('tr[data-row="account"]')
                    : itemBody.querySelectorAll('tr[data-row="item"]');
                const inactiveRows = activeMode === "accounts"
                    ? itemBody.querySelectorAll('tr[data-row="item"]')
                    : accountBody.querySelectorAll('tr[data-row="account"]');
                const inactiveHasAmounts = Array.prototype.some.call(inactiveRows, function (row) {
                    return rowAmount(row, activeMode === "accounts" ? "item" : "account") > 0;
                });
                if (inactiveHasAmounts) {
                    issues.push({
                        el: activeMode === "accounts" ? byId("modeItems") : byId("modeAccounts"),
                        label: "There are entered amounts in the other entry mode. Switch to that mode to review and post them, or clear those rows."
                    });
                }
                if (activeRows.length === 0) {
                    showToast("Add at least one item or expense account before posting.", "error");
                    issues.push({ el: byId("addItemBtn"), label: "Add at least one line item" });
                }
                if (t.subtotal <= 0 && activeRows.length > 0) {
                    showToast("Add amounts so the expense total is greater than zero.", "error");
                    issues.push({ el: byId("DiscountAmount"), label: "Total must be greater than zero" });
                }

                const summary = byId("errorSummary");
                const list = byId("errorSummaryList");
                if (issues.length && summary && list) {
                    list.innerHTML = issues.map(function (it, i) {
                        return '<li><a href="#" data-jump="' + i + '">' + escapeHtml(it.label) + '</a></li>';
                    }).join("");
                    summary.hidden = false;
                    list.querySelectorAll("a").forEach(function (a) {
                        a.addEventListener("click", function (ev) {
                            ev.preventDefault();
                            const it = issues[Number(a.dataset.jump)];
                            if (it && it.el) {
                                try { it.el.focus({ preventScroll: true }); } catch (e) { it.el.focus(); }
                                it.el.scrollIntoView({ behavior: "smooth", block: "center" });
                            }
                        });
                    });
                } else if (summary) {
                    summary.hidden = true;
                    if (list) list.innerHTML = "";
                }

                return issues;
            }

            /* ============================================================
               ATTACHMENTS
            ============================================================ */
            const MAX_FILE_SIZE = 10 * 1024 * 1024;
            const MAX_FILES = 10;

            function formatBytes(bytes) {
                if (!bytes) return "0 KB";
                const units = ["B", "KB", "MB", "GB"];
                let i = Math.floor(Math.log(bytes) / Math.log(1024));
                if (i < 0) i = 0;
                return (bytes / Math.pow(1024, i)).toFixed(i === 0 ? 0 : 1) + " " + units[i];
            }

            function renderAttachments() {
                const list = byId("attachmentList");
                const badge = byId("docCountBadge");
                const totalSize = byId("docTotalSize");
                const count = byId("docCount");
                const clearBtn = byId("docClearBtn");
                if (!list) return;

                if (!selectedFiles.length) {
                    list.innerHTML = '<div class="doc-empty" id="docEmptyState">No files attached yet.</div>';
                } else {
                    list.innerHTML = selectedFiles.map(function (f, i) {
                        return '<div class="doc-item">' +
                            '<span class="doc-item-thumb"><i class="bi bi-file-earmark-text" aria-hidden="true"></i></span>' +
                            '<div class="doc-item-body">' +
                            '<div class="doc-item-name">' + escapeHtml(f.name) + '</div>' +
                            '<div class="doc-item-meta">' + formatBytes(f.size) + '</div>' +
                            '</div>' +
                            '<button type="button" class="doc-remove-btn" data-remove-file="' + i + '" ' +
                            'aria-label="Remove ' + escapeHtml(f.name) + '">' +
                            '<i class="bi bi-x-lg" aria-hidden="true"></i></button>' +
                            '</div>';
                    }).join("");
                }

                const totalBytes = selectedFiles.reduce((s, f) => s + f.size, 0);
                if (badge) badge.textContent = selectedFiles.length + (selectedFiles.length === 1 ? " file" : " files");
                if (totalSize) totalSize.textContent = formatBytes(totalBytes);
                if (count) count.textContent = selectedFiles.length;
                if (clearBtn) clearBtn.hidden = selectedFiles.length === 0;
            }

            function addFiles(fileList) {
                const incoming = Array.prototype.slice.call(fileList || []);
                if (!incoming.length) return;
                if (selectedFiles.length + incoming.length > MAX_FILES) {
                    showToast("You can attach up to " + MAX_FILES + " files.", "error");
                    return;
                }
                incoming.forEach(function (f) {
                    if (f.size > MAX_FILE_SIZE) {
                        showToast('"' + f.name + '" exceeds the 10 MB limit and was skipped.', "error");
                        return;
                    }
                    const dup = selectedFiles.some(x => x.name === f.name && x.size === f.size);
                    if (!dup) selectedFiles.push(f);
                });
                syncAttachmentInput();
                renderAttachments();
                dirty = true;
            }

            function syncAttachmentInput() {
                if (!attachmentInput) return;
                if (typeof DataTransfer === "undefined") return;
                try {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(f => dt.items.add(f));
                    attachmentInput.files = dt.files;
                } catch (e) { /* noop */ }
            }

            if (attachmentInput) {
                attachmentInput.addEventListener("change", function () {
                    addFiles(this.files);
                    if (!selectedFiles.length) this.value = "";
                });
            }

            if (dropzone) {
                ["dragenter", "dragover"].forEach(function (ev) {
                    dropzone.addEventListener(ev, function (e) {
                        e.preventDefault();
                        dropzone.classList.add("is-dragover");
                    });
                });
                ["dragleave", "drop"].forEach(function (ev) {
                    dropzone.addEventListener(ev, function (e) {
                        e.preventDefault();
                        dropzone.classList.remove("is-dragover");
                    });
                });
                dropzone.addEventListener("drop", function (e) {
                    if (e.dataTransfer && e.dataTransfer.files) addFiles(e.dataTransfer.files);
                });
                dropzone.addEventListener("keydown", function (e) {
                    if (e.key === "Enter" || e.key === " ") {
                        e.preventDefault();
                        attachmentInput && attachmentInput.click();
                    }
                });
            }

            form.addEventListener("click", function (e) {
                const removeFile = e.target.closest("[data-remove-file]");
                if (removeFile) {
                    selectedFiles.splice(Number(removeFile.dataset.removeFile), 1);
                    syncAttachmentInput();
                    renderAttachments();
                    return;
                }
                if (e.target.closest("#docClearBtn")) {
                    selectedFiles = [];
                    if (attachmentInput) attachmentInput.value = "";
                    renderAttachments();
                }
            });

            /* ============================================================
               MODE SWITCHING
            ============================================================ */
            function setActiveMode(mode) {
                activeMode = mode === "accounts" ? "accounts" : "items";
                setValue("EntryMode", activeMode);

                const itemsBtn = byId("modeItems");
                const accountsBtn = byId("modeAccounts");
                const itemsPane = byId("itemsPane");
                const accountsPane = byId("accountsPane");
                const addItem = byId("addItemBtn");
                const addAccount = byId("addAccountBtn");
                const label = byId("modeContextLabel");

                if (itemsBtn) {
                    itemsBtn.classList.toggle("active", activeMode === "items");
                    itemsBtn.setAttribute("aria-selected", activeMode === "items" ? "true" : "false");
                    itemsBtn.setAttribute("tabindex", activeMode === "items" ? "0" : "-1");
                }
                if (accountsBtn) {
                    accountsBtn.classList.toggle("active", activeMode === "accounts");
                    accountsBtn.setAttribute("aria-selected", activeMode === "accounts" ? "true" : "false");
                    accountsBtn.setAttribute("tabindex", activeMode === "accounts" ? "0" : "-1");
                }
                if (itemsPane) {
                    itemsPane.classList.toggle("active", activeMode === "items");
                    itemsPane.classList.toggle("show", activeMode === "items");
                }
                if (accountsPane) {
                    accountsPane.classList.toggle("active", activeMode === "accounts");
                    accountsPane.classList.toggle("show", activeMode === "accounts");
                }
                if (addItem) addItem.style.display = activeMode === "items" ? "" : "none";
                if (addAccount) addAccount.style.display = activeMode === "accounts" ? "" : "none";
                if (label) label.textContent = activeMode === "items" ? "Items" : "Expense Accounts";

                scheduleCalculate();
            }

            byId("modeItems") && byId("modeItems").addEventListener("click", () => setActiveMode("items"));
            byId("modeAccounts") && byId("modeAccounts").addEventListener("click", () => setActiveMode("accounts"));

            const modeToggle = form.querySelector(".mode-toggle");
            if (modeToggle) {
                modeToggle.addEventListener("keydown", function (e) {
                    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
                    e.preventDefault();
                    const next = activeMode === "items" ? "accounts" : "items";
                    setActiveMode(next);
                    const btn = byId(next === "items" ? "modeItems" : "modeAccounts");
                    if (btn) btn.focus();
                });
            }

            /* ============================================================
               ROW EVENT HANDLING
            ============================================================ */
            form.addEventListener("click", function (e) {
                const rm = e.target.closest("[data-remove-row]");
                if (rm) {
                    const row = rm.closest("tr[data-row]");
                    if (row) {
                        row.remove();
                        scheduleCalculate();
                        dirty = true;
                    }
                }
            });

            form.addEventListener("input", function (e) {
                if (e.target.matches(".item-qty,.item-price,.item-discount,.account-qty,.account-price")) {
                    scheduleCalculate();
                }
            });

            // form.addEventListener("change", function (e) {
            //     if (e.target.matches(".account-select,#PaymentAccountID,#PaymentMethod,#ClassName")) {
            //         scheduleCalculate();
            //     }
            // });

            /* Enter-key shortcut: add new row from the last editable cell of a row */
            form.addEventListener("keydown", function (e) {
                if (e.key !== "Enter") return;
                const cell = e.target.closest("td");
                if (!cell) return;
                const row = cell.closest("tr[data-row]");
                if (!row) return;
                const editable = row.querySelectorAll("input,select,textarea");
                const last = editable[editable.length - 1];
                if (e.target !== last) return;
                e.preventDefault();
                if (row.dataset.row === "item") addItemRow();
                else addExpenseRow();
            });

            /* Description character counter */
            const desc = byId("Description");
            const descCount = byId("descriptionCount");
            if (desc && descCount) {
                const update = () => { descCount.textContent = desc.value.length; };
                desc.addEventListener("input", update);
                update();
            }

            /* Add-row buttons */
            byId("addItemBtn") && byId("addItemBtn").addEventListener("click", () => addItemRow());
            byId("addAccountBtn") && byId("addAccountBtn").addEventListener("click", () => addExpenseRow());

            /* Default dates */
            const expDate = byId("ExpenseDate");
            if (expDate && !expDate.value) expDate.value = localDateValue();

            /* ============================================================
               FORM SUBMIT (intercepted by #SaveChange button below)
            ============================================================ */
            form.addEventListener("submit", function (e) {
                if (isSubmitting) { e.preventDefault(); return; }
                const issues = validateForm();
                if (issues.length) {
                    e.preventDefault();
                    showToast("Please fix the highlighted fields before saving.", "error");
                    const first = issues[0].el;
                    if (first && first.scrollIntoView) {
                        first.scrollIntoView({ behavior: "smooth", block: "center" });
                        try { first.focus({ preventScroll: true }); } catch (err) { first.focus(); }
                    }
                    return;
                }
                isSubmitting = true;
                const btn = document.getElementById("SaveChange");
                if (btn) {
                    btn.disabled = true;
                    btn.dataset.originalHtml = btn.innerHTML;
                    btn.innerHTML = '<i class="ti ti-loader"></i> Saving…';
                }
                setStatus("Saving…", "warning");
            });

            /* Warn on unsaved navigation */
            window.addEventListener("beforeunload", function (e) {
                if (dirty && !isSubmitting) {
                    e.preventDefault();
                    e.returnValue = "";
                }
            });

            /* ============================================================
               EXTERNAL MODAL FOOTER BUTTONS (your existing markup)
               - #SaveChange triggers a validated submit
               - #CloseModal is handled by Bootstrap data-dismiss
            ============================================================ */
            const externalSaveBtn = document.getElementById("SaveChange");
            if (externalSaveBtn && !externalSaveBtn.dataset.expenseBound) {
                externalSaveBtn.dataset.expenseBound = "true";
                externalSaveBtn.addEventListener("click", function () {
                    if (isSubmitting) return;
                    const issues = validateForm();
                    if (issues.length) {
                        showToast("Please fix the highlighted fields before saving.", "error");
                        const first = issues[0].el;
                        if (first && first.scrollIntoView) {
                            first.scrollIntoView({ behavior: "smooth", block: "center" });
                            try { first.focus({ preventScroll: true }); } catch (err) { first.focus(); }
                        }
                        return;
                    }
                    if (form.requestSubmit) form.requestSubmit();
                    else form.submit();
                });
            }

            /* Optional: clear dirty flag when the modal closes, so
               navigating away afterwards doesn't trigger beforeunload. */
            const closeBtn = document.getElementById("CloseModal");
            if (closeBtn && !closeBtn.dataset.expenseBound) {
                closeBtn.dataset.expenseBound = "true";
                closeBtn.addEventListener("click", function () {
                    dirty = false;
                });
            }

            /* ============================================================
               BOOT
            ============================================================ */
            // refreshPaymentAccounts();
            renderAttachments();
            setActiveMode("items");
            calculate();
            setStatus("Draft", "draft");

            /* Expose for host page if needed */
            window.ExpenseForm = {
                addItem: addItemRow,
                addAccount: addExpenseRow,
                calculate: calculate,
                validate: validateForm,
                getTotals: getTotals
            };
        }

        /* Support both full page and modal/dialog injection */
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", function () {
                initExpenseForm(document);
            });
        } else {
            initExpenseForm(document);
        }

        if (window.jQuery) {
            window.jQuery(document).on("shown.bs.modal", function () {
                initExpenseForm(document);
            });
        }

        const dateFields = ['#ExpenseDate', '#Terms', '#PaidOnDate'];

        dateFields.forEach(function(selector) {

            const $date = $(selector);
            const isExpenseDate = selector === '#ExpenseDate';

            let initialDate = moment();

            if ($date.val()) {
                const parsedDate = moment(
                    $date.val(),
                    ['DD-MM-YYYY', 'YYYY-MM-DD'],
                    true
                );

                if (parsedDate.isValid()) {
                    initialDate = parsedDate;
                }
            }

            $date.daterangepicker({
                singleDatePicker: true,
                showDropdowns: true,
                autoApply: true,
                autoUpdateInput: false,
                startDate: initialDate,

                locale: {
                    format: "DD-MM-YYYY",
                    firstDay: 1
                }
            });

            // ExpenseDate defaults to today
            if (isExpenseDate && !$date.val()) {
                $date.val(moment().format('DD-MM-YYYY'));
            }

            // Terms and PaidOnDate remain empty by default
            // Only populate when the user selects a date
            $date.on('apply.daterangepicker', function(ev, picker) {
                $(this).val(picker.startDate.format('DD-MM-YYYY'));
            });

            // Clear the input if needed
            $date.on('cancel.daterangepicker', function() {
                $(this).val('');
            });

        });
    })(window, document);


var dataSource_PayeeID = [];

function InitializePayeeComboBox() {

    var $payee = $("#Payee");

    if (!$payee.length) {
        console.warn("Payee element was not found.");
        return;
    }

    // Destroy existing Kendo widget safely
    var existingWidget = $payee.data("kendoMultiColumnComboBox");

    if (existingWidget) {
        existingWidget.destroy();
        $payee.removeData("kendoMultiColumnComboBox");
        $payee.empty();
    }

    // Preserve Bootstrap styling
    $payee.addClass("form-control");

    // Load Payee data
    $.ajax({
        url: '@Url.Action("GetPayeeList", "Vendors")',
        type: "GET",
        dataType: "json",
        cache: false,

        success: function (data) {

            dataSource_PayeeID = Array.isArray(data) ? data : [];

            var payeeDataSource = new kendo.data.DataSource({
                data: dataSource_PayeeID,
                schema: {
                    model: {
                        id: "PayeeID",
                        fields: {
                            PayeeID: { type: "number" },
                            Name: { type: "string" },
                            Type: { type: "string" }
                        }
                    }
                }
            });

            $payee.kendoMultiColumnComboBox({

                height: 350,

                dataTextField: "Name",
                dataValueField: "PayeeID",

                placeholder: "Vendor / recipient",

                filter: "contains",
                autoBind: true,
                suggest: true,

                clearButton: true,

                minLength: 0,

                dataSource: payeeDataSource,

                columns: [
                    {
                        field: "Name",
                        title: "Name",
                        width: 350
                    },
                    {
                        field: "Type",
                        title: "Type",
                        width: 120
                    }
                ],

                // Search Name and Type
                filtering: function (e) {

                    e.preventDefault();

                    var filterValue = (
                        e.filter && e.filter.value
                            ? e.filter.value
                            : ""
                    ).toString().trim();

                    if (!filterValue) {
                        this.dataSource.filter({});
                        return;
                    }

                    this.dataSource.filter({
                        logic: "or",
                        filters: [
                            {
                                field: "Name",
                                operator: "contains",
                                value: filterValue
                            },
                            {
                                field: "Type",
                                operator: "contains",
                                value: filterValue
                            }
                        ]
                    });
                },

                change: function (e) {

                    var selectedItem = this.dataItem();

                    if (selectedItem) {

                        console.log("Selected Payee:", {
                            PayeeID: selectedItem.PayeeID,
                            Name: selectedItem.Name,
                            Type: selectedItem.Type
                        });

                        // LoadVendorBankInfo();
                    }
                },

                // Footer Add New button
                footerTemplate: `
                    <div class="payee-footer"
                         style="padding:8px;text-align:center;">
                        <button type="button"
                                class="k-button k-primary btn-add-new-payee">
                            <span class="k-icon k-i-plus"></span>
                            Add New
                        </button>
                    </div>
                `,

                open: function () {

                    var combo = this;

                    // Use the widget popup instead of global ID
                    combo.popup.element
                        .off("click.payee")
                        .on("click.payee", ".btn-add-new-payee", function (e) {

                            e.preventDefault();
                            e.stopPropagation();

                            combo.close();

                            AddNewPayee();
                        });
                },

                dataBound: function () {

                    // Optional: customize dropdown after binding
                }

            });

            // Get initialized widget
            var payeeCombo = $payee.data("kendoMultiColumnComboBox");

            if (!payeeCombo) {
                return;
            }

            // Preserve Bootstrap styling
            payeeCombo.input.addClass("form-control");

            payeeCombo.wrapper.addClass("expense-payee-kendo");

            // Open dropdown when clicking input
            payeeCombo.input
                .off("click.payee")
                .on("click.payee", function () {

                    if (!payeeCombo.popup.visible()) {
                        payeeCombo.open();
                    }
                });

            // Open dropdown when clicking wrapper
            payeeCombo.wrapper
                .off("click.payee")
                .on("click.payee", function (e) {

                    if (
                        $(e.target).closest(
                            ".k-input-button, .k-clear-value"
                        ).length
                    ) {
                        return;
                    }

                    if (!payeeCombo.popup.visible()) {
                        payeeCombo.open();
                    }
                });

        },

        error: function (xhr, status, error) {

            console.error("Failed to load Payee list:", error);

            dataSource_PayeeID = [];

            console.error(xhr.responseText);
        }
    });
}


