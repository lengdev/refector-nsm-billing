@{
    Layout = null;
}
<link href="~/Content/BootStrapTreeView/TreeView.css" type="text/css" rel="stylesheet" />
<script src="~/Content/BootStrapTreeView/TreeView.js"></script>
<div class="card-header pl-0 mb-3">
    <h2 class="card-title mr-auto p-2">Subscriptions</h2>
</div>
<div class="row">
    <div class="col-12">
        <div id="PackageNameData"></div>
    </div>
</div>
<script>
    var PackageInfo = JSON.parse(`@Html.Raw(ViewBag.PackageInfo)`);
    $(function () {
        //Initialization of treeviews

        //$('#tree1').treed();

        //$('#tree2').treed({ openedClass: 'glyphicon-folder-open', closedClass: 'glyphicon-folder-close' });

        //$('#tree3').treed({ openedClass: 'glyphicon-chevron-right', closedClass: 'glyphicon-chevron-down' });

        let Table = PackageInfo.Table;
        let Table1 = PackageInfo.Table1;
        let Table2 = PackageInfo.Table2;
        let row = '<div class="row text-success text-nowrap">';
        $.each(Table, function (key, value) {
            row += '<div class="col-6">';
            row += '<ul name="PackageName">';
            let PackageName = value.PackageName;
            let filteredTable1 = Table1.filter(function (currentElement) {
                return currentElement.PackageName === PackageName;
            });
            row += '<li>' + (key + 1) + '. <a href="javascript:void(0);">' + PackageName + '</a> <span class="badge bg-primary">' + filteredTable1.length + '</span>';
            if (filteredTable1.length > 0) {
                let row1 = '<ul>';
                $.each(filteredTable1, function (key, val) {
                    //let PackageName = val.PackageName;
                    let filteredTable2 = Table2.filter(function (currentElement) {
                        return currentElement.PackageName === val.PackageName && currentElement.Bandwidth === val.Bandwidth;
                    });
                    row1 += '<li>' + (key + 1) + '. <a href="javascript:void(0);">Bandwidth: ' + val.Bandwidth + '</a> <span class="badge bg-primary">' + filteredTable2.length + '</span>';// + ' Duration: ' + val.UM + ' Free Duration: ' + val.FreeDuration +'</li>';
                    if (filteredTable2.length > 0) {
                        let row2 = '<ul>';
                        $.each(filteredTable2, function (key, v) {
                            row2 += `<li>` + (key + 1) + `. <a href="javascript:void(0);" onclick="showAction('` + v.PName + `', ` + v.FreeDuration +`);">Duration: ` + v.UM + ` Free Duration: ` + v.FreeDuration + ` Price: ` + v.UnitPrice + `$</a> <span class="badge bg-primary">Customer: ` + v.Customer + `</span></li>`;
                        });
                        row2 += '</ul>';
                        row1 += row2;
                        row1 += '</li>';
                    }
                    else {
                        row1 += '</li>';
                    }

                });
                row1 += '</ul>';
                row += row1;
                row += '</li>';
            }
            else {
                row += '</li>';
            }
            row += '</ul>';
            row += '</div>';
        });

        row += '</div>';
        $("#PackageNameData").html(row);
        $('ul[name=PackageName]').treed({ openedClass: 'glyphicon-folder-open', closedClass: 'glyphicon-folder-close' });
    });
    function showAction(PackageName, FreeDuration) {
        var URL = "Customer/Connection";
        ShowDialogBox2("Customer Connection", "Auto", 500, URL, 0, "DialogBoxShowAction", function () {
            setTimeout(function () {
                //$("#txtStatus").val(StatusID).trigger("change");
                $("#txtFreeDuration").val(FreeDuration).trigger("change");
                $("#txtPackageName").val(PackageName).trigger("change");               
                $("#SaveChange2").remove();
                setTimeout(function () {
                    $("#BunSearch").click();
                }, 800);
            }, 800);            
        });
    }
</script>

