    function renumberEdRows() {
        var grid = getKendoGrid();
        if (!grid || !grid.tbody) return;

        var colMap = {};
        $.each(grid.columns, function (i, col) {
            if (col.field) colMap[col.field] = i;
        });
        if (colMap['No'] === undefined) return;

        var page = (grid.dataSource && grid.dataSource.page) ? (grid.dataSource.page() || 1) : 1;
        var pageSize = (grid.dataSource && grid.dataSource.pageSize) ? (grid.dataSource.pageSize() || 0) : 0;
        var counter = (page > 1 && pageSize > 0) ? ((page - 1) * pageSize) + 1 : 1;

        grid.tbody.find('tr[data-uid]').each(function () {
            var $row = $(this);
            if ($row.hasClass('k-grouping-row') || $row.hasClass('k-group-footer') || $row.hasClass('k-footer-template')) return;

            var $noCell = $row.children('td').eq(colMap['No']);
            if ($noCell.length > 0 && $.trim($noCell.text()) !== '') {
                $noCell.text((counter < 10 ? '0' : '') + counter);
                counter++;
            }
        });
    }

    function addCurrencySymbolSpacing(grid) {
        if (!grid) return;

        var currencyFields = {
            AmountUSD: true,
            UnitPrice: true,
            Discount: true,
            VAT: true
        };
        var currencyColumnIndexes = [];

        $.each(grid.columns, function (index, column) {
            if (currencyFields[column.field]) currencyColumnIndexes.push(index);
        });

        $.each(currencyColumnIndexes, function (_, index) {
            grid.tbody.find('tr[data-uid]').each(function () {
                var $cell = $(this).children('td').eq(index);
                $cell.text($cell.text().replace(/\$(?=\S)/g, '$ '));
            });

            var $footerCell = grid.wrapper.find('tfoot tr').last().children('td').eq(index);
            if ($footerCell.length) {
                $footerCell.text($footerCell.text().replace(/\$(?=\S)/g, '$ '));
            }
        });
    }

    function bindExpenseDetailExcelHeader(grid) {
        if (grid._expenseDetailExcelHeaderBound) return;

        grid.bind('excelExport', function (e) {
            var sheet = e.workbook.sheets[0];
            var rows = sheet.rows;
            if (!rows || !rows.length) return;

            var headerInfo = updateDynamicTitle();
            var title = (headerInfo && headerInfo.title) ? headerInfo.title : 'Expense Detail';
            var compEn = (headerInfo && headerInfo.companyEn) ? headerInfo.companyEn : '';
            var compKh = (headerInfo && headerInfo.companyKh) ? headerInfo.companyKh : '';
            if (grid.options && grid.options.excel) {
                grid.options.excel.fileName = getExportFileName(compEn, 'xlsx');
            }

            var hasCompanyEn = false;
            var hasCompanyKh = false;
            var hasTitle = false;
            for (var r = 0; r < Math.min(rows.length, 10); r++) {
                if (rows[r] && rows[r].type === 'header' && rows[r].cells) {
                    for (var c = 0; c < rows[r].cells.length; c++) {
                        var cell = rows[r].cells[c];
                        if (cell && cell.value) {
                            var val = $.trim(cell.value.toString());
                            if (isExpenseDetailTitle(val)) {
                                cell.value = title;
                                cell.textAlign = 'center';
                                cell.fontSize = 12;
                                cell.bold = true;
                                hasTitle = true;
                            } else if (compEn && /^(NSM\s+TECH(?:NOLOGY)?(?:\s+CO\.?,?\s*LTD\.?)?|NSM\s+SOLUTION\s+AND\s+MAINTENANCE\s+CO\.?,?\s*LTD\.?|BS\s+PRINTING\s+AND\s+ADVERTISING\s+CO\.?,?\s*LTD\.?|NSM\s+INTERNET\s+SERVICE\s+PROVIDER)$/i.test(val)) {
                                cell.value = compEn;
                                cell.textAlign = 'center';
                                cell.fontSize = 14;
                                cell.bold = true;
                                hasCompanyEn = true;
                            }
                            if (compKh && /^ក្រុមហ៊ុន\s+/.test(val) && (val.indexOf('ថេកណូឡូជី') !== -1 || val.indexOf('សឹលូសិន') !== -1 || val.indexOf('ព្រីនធីង') !== -1 || val.indexOf('អាយអេសភី') !== -1)) {
                                cell.value = compKh;
                                cell.textAlign = 'center';
                                cell.fontSize = 16;
                                cell.fontFamily = 'Khmer OS Muol Light';
                                cell.bold = true;
                                hasCompanyKh = true;
                            }
                        }
                    }
                }
            }

            var headerRows = [];
            var columnCount = Math.max(1, grid.columns.filter(function (column) {
                return !column.hidden && column.field;
            }).length);
            if (compKh && !hasCompanyKh) {
                headerRows.push({
                    cells: [{ value: compKh, colSpan: columnCount, textAlign: 'center', fontSize: 16, fontFamily: 'Khmer OS Muol Light', bold: true }],
                    type: 'header',
                    height: 30
                });
            }
            if (compEn && !hasCompanyEn) {
                headerRows.push({
                    cells: [{ value: compEn, colSpan: columnCount, textAlign: 'center', fontSize: 14, bold: true }],
                    type: 'header',
                    height: 24
                });
            }
            if (!hasTitle) {
                headerRows.push({
                    cells: [{ value: title, colSpan: columnCount, textAlign: 'center', fontSize: 12, bold: true }],
                    type: 'header',
                    height: 22
                });
            }
            var dateRange = $.trim($('#lblDateRangeBar').text());
            headerRows.push({
                cells: [{ value: dateRange || 'All', colSpan: columnCount, textAlign: 'center', fontSize: 10 }],
                type: 'header',
                height: 20
            });
            headerRows.push({
                cells: [{ value: 'Print Date: ' + kendo.toString(new Date(), 'dd-MMM-yyyy HH:mm'), colSpan: columnCount, textAlign: 'center', fontSize: 10 }],
                type: 'header',
                height: 20
            });
            if (headerRows.length) rows.splice.apply(rows, [0, 0].concat(headerRows));
        });

        grid._expenseDetailExcelHeaderBound = true;
    }

    function bindExpenseDetailPdfHeader(grid) {
        if (!grid || grid._expenseDetailPdfHeaderBound) return;

        grid.bind('pdfExport', function (e) {
            var headerInfo = updateDynamicTitle();
            var title = (headerInfo && headerInfo.title) ? headerInfo.title : 'Expense Detail';
