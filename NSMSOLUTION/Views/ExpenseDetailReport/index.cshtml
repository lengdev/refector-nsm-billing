    function updateEdFilterBadge(activeCount, totalRows, filteredRows) {
        var $badge = $('#gjFilterStatusBadge');
        if (activeCount === 0) {
            $badge.hide().html('');
            return;
        }
        var html = '<span class="gj-badge active">' +
            '<i class="fas fa-filter" style="font-size:10px;"></i> ' +
            activeCount + ' filter' + (activeCount > 1 ? 's' : '') + ' active &mdash; ' +
            filteredRows + ' / ' + totalRows + ' rows' +
            '</span>';
        $badge.html(html).show();
    }

    window.applyEdFilters = function () {
        var grid = getKendoGrid();
        if (!grid || !grid.dataSource) return;

        /* 1. Column visibility */
        $('#gjShownColumnsDropdown input[type=checkbox]').each(function () {
            var fieldName = $(this).val();
            if ($(this).is(':checked')) { grid.showColumn(fieldName); }
            else                        { grid.hideColumn(fieldName); }
        });

        /* 2. Sorting */
        var sortField = $.trim($('#gjFilterSortBy').val());
        var sortDir   = $('#gjFilterOrderBy').val() || 'desc';
        if (sortField) {
            grid.dataSource.sort({ field: sortField, dir: sortDir });
        }

        /* 3. Build Kendo filters */
        var parseMulti = function (val) {
            if (Array.isArray(val)) {
                return val.filter(function (x) { return x !== null && x !== '' && x !== undefined; });
            }
            if (val && typeof val === 'string' && $.trim(val) !== '') {
                return val.split(',').map(function (s) { return $.trim(s); }).filter(function (x) { return !!x; });
            }
            return [];
        };

        var selectedVendors  = parseMulti($('#edFilterVendor').val());
        var selectedAccounts = parseMulti($('#gjFilterAccount').val());
        var selectedClasses  = parseMulti($('#gjFilterClass').val());
        var selectedMethods  = parseMulti($('#edFilterPaymentMethod').val());
        var selectedUsers    = parseMulti($('#gjFilterCreatedBy').val());
        var itemName = $.trim($('#edFilterItemName').val()).toLowerCase();
        var refNo    = $.trim($('#gjFilterRefNo').val()).toLowerCase();
        var fromAmt  = parseFloat($('#edFilterFromAmount').val());
        var toAmt    = parseFloat($('#edFilterToAmount').val());

        var hasFilter = !!(selectedVendors.length || selectedAccounts.length || selectedClasses.length || selectedMethods.length || selectedUsers.length || itemName || refNo || !isNaN(fromAmt) || !isNaN(toAmt));

        var activeCount = 0;
        if (selectedVendors.length) activeCount++;
        if (selectedAccounts.length) activeCount++;
        if (selectedClasses.length) activeCount++;
        if (selectedMethods.length) activeCount++;
        if (selectedUsers.length) activeCount++;
        if (itemName) activeCount++;
        if (refNo) activeCount++;
        if (!isNaN(fromAmt) || !isNaN(toAmt)) activeCount++;

        var allData = grid.dataSource.data();
        var totalBefore = allData.length;

        if (hasFilter) {
            var matchingRowIds = {};

            for (var i = 0; i < allData.length; i++) {
                var item = allData[i];
                if (!item) continue;
                allData[i]._rowId = (i + 1);

                var match = true;

                // 1. Vendors
                if (selectedVendors.length > 0) {
                    var vName = (item.Vendor || item.VendorName || '').toString().toLowerCase().trim();
                    var vId = (item.VendorID || '').toString().toLowerCase().trim();
                    var vMatch = false;
                    for (var v = 0; v < selectedVendors.length; v++) {
                        var targetV = selectedVendors[v].toLowerCase().trim();
                        if (vName === targetV || vId === targetV || (targetV.length >= 3 && vName.indexOf(targetV) !== -1)) {
                            vMatch = true;
                            break;
                        }
                    }
                    if (!vMatch) match = false;
                }

                // 2. Accounts
                if (match && selectedAccounts.length > 0) {
                    var cat = (item.Account || '').toString().toLowerCase().trim();
                    var payAcc = (item.PaymentAccount || '').toString().toLowerCase().trim();
                    var aMatch = false;
                    for (var a = 0; a < selectedAccounts.length; a++) {
                        var targetA = selectedAccounts[a].toLowerCase().trim();
                        if (cat === targetA || payAcc === targetA || cat.indexOf(targetA) !== -1 || payAcc.indexOf(targetA) !== -1 || (cat && targetA.indexOf(cat) !== -1) || (payAcc && targetA.indexOf(payAcc) !== -1)) {
                            aMatch = true;
                            break;
                        }
                    }
                    if (!aMatch) match = false;
                }

                // 3. Classes
                if (match && selectedClasses.length > 0) {
                    var cls = (item.ClassName || item.Class || item.Department || '').toString().toLowerCase().trim();
                    var clsId = (item.ClassID || '').toString().toLowerCase().trim();
                    var cMatch = false;
                    for (var c = 0; c < selectedClasses.length; c++) {
                        var targetC = selectedClasses[c].toLowerCase().trim();
                        if (cls === targetC || clsId === targetC || (targetC.length >= 3 && (cls.indexOf(targetC) !== -1 || targetC.indexOf(cls) !== -1))) {
                            cMatch = true;
                            break;
                        }
                    }
                    if (!cMatch) {
                        $('#gjFilterClass option:selected').each(function () {
                            var t = $.trim($(this).text()).toLowerCase();
                            if (t && t !== '--- all classes ---' && t !== 'all') {
                                if (cls === t || (cls && t.indexOf(cls) !== -1) || (t && cls.indexOf(t) !== -1)) {
                                    cMatch = true;
                                    return false;
                                }
                            }
                        });
                    }
                    if (!cMatch) match = false;
                }

                // 4. Payment Method
                if (match && selectedMethods.length > 0) {
                    var pm = (item.PaymentMethod || '').toString().toLowerCase().trim();
                    var pmMatch = false;
                    for (var m = 0; m < selectedMethods.length; m++) {
                        var targetM = selectedMethods[m].toLowerCase().trim();
                        if (pm === targetM) {
                            pmMatch = true;
                            break;
                        }
                    }
                    if (!pmMatch) match = false;
                }

                // 5. Users / Approved By
                if (match && selectedUsers.length > 0) {
                    var usr = (item.ApprovedBy || '').toString().toLowerCase().trim();
                    var uMatch = false;
                    for (var u = 0; u < selectedUsers.length; u++) {
                        var targetU = selectedUsers[u].toLowerCase().trim();
                        if (usr === targetU || (targetU.length >= 3 && usr.indexOf(targetU) !== -1)) {
                            uMatch = true;
                            break;
                        }
                    }
                    if (!uMatch) match = false;
                }

                // 6. Item Name
                if (match && itemName) {
                    var desc = (item.Description || '').toString().toLowerCase();
                    var itm = (item.ItemName || '').toString().toLowerCase();
                    var notes = (item.Notes || '').toString().toLowerCase();
                    if (desc.indexOf(itemName) === -1 && itm.indexOf(itemName) === -1 && notes.indexOf(itemName) === -1) {
                        match = false;
                    }
                }

                // 7. Ref / Receipt No
                if (match && refNo) {
                    var rec = (item.ReceiptNumber || '').toString().toLowerCase();
                    var expLink = (item.ExpenseIDLink || '').toString().toLowerCase();
                    var expId = (item.ExpenseID || '').toString().toLowerCase();
                    if (rec.indexOf(refNo) === -1 && expLink.indexOf(refNo) === -1 && expId.indexOf(refNo) === -1) {
                        match = false;
                    }
                }

                // 8. Amount
                var amt = parseFloat(item.AmountUSD) || 0;
                if (match && !isNaN(fromAmt) && amt < fromAmt) match = false;
                if (match && !isNaN(toAmt) && amt > toAmt) match = false;

                if (match) {
                    matchingRowIds[i + 1] = true;
                }
            }

            grid.dataSource.filter({
                field: "_rowId",
                operator: function (rowId) {
                    return !!matchingRowIds[rowId];
                },
                value: 1
            });
        } else {
            grid.dataSource.filter([]);
        }

        var totalAfter = grid.dataSource.total();
        setTimeout(renumberEdRows, 50);
        updateEdFilterBadge(activeCount, totalBefore, totalAfter);
        updateDynamicTitle();
    };

