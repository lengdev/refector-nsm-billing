@{ Layout = null; }

<!-- Google Fonts & Khmer Fonts (Matching Balance Sheet / Profit & Loss) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Moul&family=Noto+Sans+Khmer:wght@400;700&family=Kantumruy+Pro:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">

<div id="expense-detail-report-view-wrapper">
    @Html.Raw(ViewBag.DrawHTMLSearchForm)

    @Html.Partial("~/Views/Shared/_AccountingAdvanceFilter.cshtml", new ViewDataDictionary { { "ReportType", "ED" } })

    <div class="pl-report-header" id="edReportHeader" style="margin-top: 15px; margin-bottom: 20px;">
        <div class="print-date-line" id="lblPrintDate">Print Date: @DateTime.Now.ToString("dd-MMM-yyyy HH:mm")</div>
        <div class="bs-company-kh" id="lblCompanyNameKh">@(ViewBag.CompanyNameKh ?? ViewBag.CompanyKH ?? "")</div>
        <div class="bs-company-en" id="lblCompanyNameEn">@(ViewBag.CompanyNameEn ?? ViewBag.CompanyEN ?? "")</div>
        <div class="bs-company-divider">
            ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~ * ~
        </div>
        <h3 id="lblReportTitle">@(ViewBag.ReportTitle ?? "Expense Detail")</h3>
        <div class="tb-date-range-bar" id="lblDateRangeBar"></div>
    </div>
</div>

<style>
    /* ── Balance Sheet Style Report Header ── */
    .pl-report-header {
        text-align: center;
        margin-bottom: 24px;
        position: relative;
    }
    .pl-report-header .bs-company-kh {
        font-family: 'Moul', 'Khmer OS Muol Light', 'Khmer OS Muol', cursive, serif !important;
        font-size: 20px !important;
        font-weight: normal;
        line-height: 1.6;
        margin-bottom: 4px;
        color: #000;
        text-shadow: 0 0 1px rgba(0,0,0,0.15);
    }
    .pl-report-header .bs-company-en {
        font-family: 'Times New Roman', 'Roboto', 'Kantumruy Pro', serif, sans-serif;
        font-size: 16px;
        font-weight: 900;
        margin-bottom: 6px;
        color: #000;
        letter-spacing: 0.5px;
    }
    .pl-report-header .bs-company-divider {
        font-size: 10px;
        margin-bottom: 12px;
        color: #000;
        letter-spacing: 2px;
    }
    .pl-report-header h3 {
        margin: 0 0 6px 0;
        font-weight: 600;
        color: #0f172a;
        font-size: 14px;
        font-family: 'Kantumruy Pro', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    .pl-report-header .print-date-line {
        position: absolute;
        right: 0;
        top: 15px;
        font-size: 12px;
        color: #64748b;
        font-family: 'Kantumruy Pro', sans-serif;
    }
    .pl-report-header .tb-date-range-bar {
        margin-top: 12px;
        border-top: none;
        border-bottom: none;
        padding: 5px 0;
        font-size: 12px;
        font-weight: 600;
        color: #0f172a;
        text-align: left;
        font-family: 'Kantumruy Pro', sans-serif;
    }
    .report-header-print {
        margin-top: 25px;
        margin-bottom: 20px;
        width: 100%;
    }

        .report-header-print .metadata-bar {
            display: flex;
            justify-content: space-between;
            font-size: 15px;
            font-weight: bold;
            border-bottom: 1.5px solid #475569;
            padding-bottom: 8px;
            margin-bottom: 12px;
        }

    /* Left align date range search form and limit input width */
    #expense-detail-report-view-wrapper form,
    #expense-detail-report-view-wrapper .form-search {
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        justify-content: flex-start !important;
        flex-wrap: nowrap !important;
        gap: 8px !important;
        padding: 8px 4px !important;
        width: 100% !important;
    }

    #expense-detail-report-view-wrapper form table,
    #expense-detail-report-view-wrapper .form-search table {
        margin-left: 0 !important;
        margin-right: auto !important;
        width: auto !important;
        border-collapse: separate !important;
        border-spacing: 0 8px !important;
    }

    #expense-detail-report-view-wrapper form table td,
    #expense-detail-report-view-wrapper .form-search table td {
        text-align: left !important;
        width: auto !important;
    }

    #expense-detail-report-view-wrapper form table td:first-child,
    #expense-detail-report-view-wrapper .form-search table td:first-child,
    #expense-detail-report-view-wrapper form table td label,
    #expense-detail-report-view-wrapper .form-search table td label {
        text-align: left !important;
        font-weight: 600 !important;
        color: #334155 !important;
        padding-left: 0 !important;
        padding-right: 12px !important;
        white-space: nowrap !important;
        width: auto !important;
        min-width: auto !important;
    }

    #expense-detail-report-view-wrapper #TxtFromDate,
    #expense-detail-report-view-wrapper input[name="TxtFromDate"] {
        width: 240px !important;
        max-width: 240px !important;
        display: inline-block !important;
        text-align: center !important;
        border-radius: 8px !important;
        border: 1px solid #cbd5e1 !important;
        padding: 6px 12px !important;
        height: 38px !important;
        box-shadow: none !important;
    }

    /* Status badge styling */
    #gjFilterStatusBadge .gj-badge {
        display:inline-flex; align-items:center; gap:4px;
        background:#ef4444; color:#fff; font-size:11px; font-weight:700;
        padding:2px 8px; border-radius:999px; line-height:1.4;
    }
    #gjFilterStatusBadge .gj-badge.active {
        background: linear-gradient(90deg,#3b82f6,#6366f1);
    }

    /* Print Preview & Print Styles matching Profit & Loss */
    @@media print {
        body {
            font-family: 'Kantumruy Pro', Arial, Helvetica, sans-serif !important;
            font-size: 12px !important;
            padding: 15px !important;
            color: #000000 !important;
            background: #ffffff !important;
        }

        #gjAdvanceContainer,
        #expense-detail-report-view-wrapper form,
        #expense-detail-report-view-wrapper .form-search,
        .k-grid-toolbar,
        .btn,
        button {
            display: none !important;
        }

        #edReportHeader {
            display: block !important;
            text-align: center !important;
            margin-bottom: 20px !important;
        }

        .table-responsive,
        .k-grid {
            border: none !important;
            box-shadow: none !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
        }

        th {
            background-color: #efefef !important;
            color: #000000 !important;
            border: 1px solid #b0b0b0 !important;
            font-weight: bold !important;
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
        }

        td {
            border: 1px solid #d4d4d4 !important;
            color: #000000 !important;
        }

        @@page {
            size: landscape;
            margin: 10mm;
        }
    }
</style>

<script>
(function () {
    window.expenseDetailInitialDateFilterPending = true;
    window.expenseDetailInitialGridRequestCompleted = false;
    window.expenseDetailDateFilterRetryStarted = false;
    window.expenseDetailDateFilterLoaded = false;
    $('#expense-detail-report-view-wrapper .ShowGridTable').first().css('visibility', 'hidden');

    function getKendoGrid() {
        var $g = $('#expense-detail-report-view-wrapper').find('[data-role="grid"]').first();
        return $g.length ? $g.data('kendoGrid') : null;
    }

    function isExpenseDetailDateFilterRequest(settings) {
        var requestData = settings && settings.data;
        var fieldWithValue = requestData && requestData.FieldWithValue;
        if (typeof requestData === 'string') {
            var match = /(?:^|&)FieldWithValue=([^&]*)/.exec(requestData);
            if (match) {
                fieldWithValue = decodeURIComponent(match[1].replace(/\+/g, ' '));
            }
        }
        return typeof fieldWithValue === 'string' &&
            fieldWithValue.indexOf('format(COALESCE(ep.PaymentDate') !== -1;
    }

    function reloadExpenseDetailWithDateFilter() {
        var $dateInput = $('#expense-detail-report-view-wrapper').find('#TxtFromDate, input[name="TxtFromDate"]').first();
        if (!$dateInput.val() || !$dateInput.data('daterangepicker') || typeof LoadTableGrid !== 'function') return;
        if (window.expenseDetailDateFilterRetryStarted) return;
        window.expenseDetailDateFilterRetryStarted = true;
        if (typeof window.invalidateLoadGridCache === 'function') {
            window.invalidateLoadGridCache();
        }
        LoadTableGrid(1);
    }

    function updateEdDateRangeHeader() {
        var rawVal = $('#expense-detail-report-view-wrapper').find('#TxtFromDate, input[name="TxtFromDate"]').val() || '';
        rawVal = rawVal.trim();
        if (!rawVal) return;
        if (rawVal.indexOf(' - ') !== -1) {
            var parts = rawVal.split(' - ');
            $('#lblDateRangeBar').text(parts[0].trim() + ' - ' + parts[1].trim());
        } else {
            $('#lblDateRangeBar').text(rawVal);
        }
    }

    function getExpenseDetailClassValues() {
        var values = $('#gjFilterClass').val();
        return Array.isArray(values) ? values.filter(function (value) {
            return value !== null && value !== '';
        }) : (values ? [values] : []);
    }

    function rememberExpenseDetailClassSelection(value) {
        if (!value) return;
        var valueString = String(value);
        var order = window.expenseDetailClassSelectionOrder || [];
        order = order.filter(function (item) { return item !== valueString; });
        order.push(valueString);
        window.expenseDetailClassSelectionOrder = order;
    }

    function forgetExpenseDetailClassSelection(value) {
        if (!value) return;
        var valueString = String(value);
        window.expenseDetailClassSelectionOrder = (window.expenseDetailClassSelectionOrder || [])
            .filter(function (item) { return item !== valueString; });
    }

    function getExpenseDetailHeaderClassValue() {
        var values = getExpenseDetailClassValues().map(String);
        var order = window.expenseDetailClassSelectionOrder || [];
        for (var i = order.length - 1; i >= 0; i--) {
            if (values.indexOf(order[i]) !== -1) return order[i];
        }
        return values.length ? values[values.length - 1] : '';
    }

    function getSelectedClassInfo() {
        var selectedVal = '';
        var selectedText = '';

        // The report's own Class filter is authoritative; other report dropdowns may be unrelated.
        var $classFilter = $('#gjFilterClass');
        var selectedClassValue = getExpenseDetailHeaderClassValue();
        if (selectedClassValue && selectedClassValue !== '--- All Classes ---' && selectedClassValue !== 'All') {
            selectedVal = selectedClassValue;
            selectedText = $.trim($classFilter.find('option').filter(function () {
                return this.value === selectedClassValue;
            }).first().text()) || selectedClassValue;
        }

        // 1. Check Kendo DropDownLists on the page (toolbar, filter bars, etc.)
        if (!selectedText) $('[data-role="dropdownlist"]').each(function () {
            var ddl = $(this).data('kendoDropDownList');
            if (ddl) {
                var text = $.trim(ddl.text());
                var val = $.trim(ddl.value());
                if (text && text !== '--- All Classes ---' && text !== 'All' && text !== '--- Please select ---') {
                    if (text.indexOf('Tech') !== -1 || text.indexOf('NSM') !== -1 || text.indexOf('Printing') !== -1 || text.indexOf('ISP') !== -1 || text.indexOf('BS') !== -1) {
                        selectedVal = val || text;
                        selectedText = text;
                        return false;
                    }
                }
            }
        });

        // 2. Check visible toolbar dropdown text (.k-dropdown .k-input, .select2-selection__rendered)
        if (!selectedText) {
            $('.k-dropdown .k-input, .select2-selection__rendered').each(function () {
                var txt = $.trim($(this).text());
                if (txt && (txt.indexOf('Tech') !== -1 || txt.indexOf('NSM') !== -1 || txt.indexOf('Printing') !== -1 || txt.indexOf('ISP') !== -1 || txt.indexOf('BS') !== -1)) {
                    selectedVal = txt;
                    selectedText = txt;
                    return false;
                }
            });
        }

        // 4. Check all select elements
        if (!selectedText) {
            $('select').each(function () {
                var $s = $(this);
                var id = ($s.attr('id') || '').toLowerCase();
                var name = ($s.attr('name') || '').toLowerCase();
                var isClass = id.indexOf('class') !== -1 || name.indexOf('class') !== -1;

                var val = $s.val();
                val = Array.isArray(val) ? (val.length === 1 ? val[0] : '') : val;
                if (!val || val === '--- All Classes ---' || val === 'All' || val === '0' || val === '-1') return;

                var text = $.trim($s.find('option:selected').first().text()) || val;
                if (!text || text === '--- All Classes ---' || text === 'All') text = val;

                if (isClass || text.indexOf('Tech') !== -1 || text.indexOf('NSM') !== -1 || text.indexOf('Printing') !== -1 || text.indexOf('ISP') !== -1 || text.indexOf('BS') !== -1) {
                    selectedVal = val;
                    selectedText = text;
                    return false;
                }
            });
        }

        var companyKh = $.trim($('#lblCompanyNameKh').text());
        var companyEn = $.trim($('#lblCompanyNameEn').text());

        var resolvedClass = window.expenseDetailResolvedClassHeader;
        if (resolvedClass && resolvedClass.selectionKey === selectedVal) {
            companyEn = resolvedClass.companyNameEn || companyEn;
            companyKh = resolvedClass.companyNameKh || companyKh;
        }

        return {
            val: selectedVal,
            classId: resolvedClass && resolvedClass.selectionKey === selectedVal ? resolvedClass.classId : selectedVal,
            text: selectedText,
            companyKh: companyKh,
            companyEn: companyEn
        };
    }

    function getDynamicReportTitle(companyEn) {
        return 'Expense Detail';
    }

    function isExpenseDetailTitle(value) {
        return /^(?:.*\s[-–|]\s)?expenses?\s+detail(?:\s*\(filtered\s+by[^\)]*\))?$/i.test($.trim(value));
    }

    function getExportFileName(companyEn, extension) {
        var prefix = companyEn ? companyEn.replace(/[^a-z0-9]+/gi, '_').replace(/^_|_$/g, '') + '_' : '';
        return prefix + 'Expense_Detail.' + extension;
    }

    function bindExpenseDetailPdfExport() {
        var exportPdf = window.kendoGridPdfExport;
        if (!exportPdf || exportPdf._expenseDetailWrapped) return;

        var wrappedExport = function (e, config) {
            var header = document.getElementById('expense-detail-report-view-wrapper')
                ? window.expenseDetailPdfHeader
                : null;
            if (!header) return exportPdf.call(this, e, config);

            if (!e || !e.sender || typeof window._kFetchAllRows !== 'function' ||
                typeof window._flattenKendoGroups !== 'function' || !config || !config.serverRoot) {
                console.error('Expense Detail PDF export could not start: export configuration is incomplete.');
                alert('Failed to generate the Expense Detail PDF. Please try again.');
                return;
            }

            e.preventDefault();
            var grid = e.sender;
            var systemId = localStorage.getItem('SystemID');
            var dateRange = $.trim($('#lblDateRangeBar').text()) || 'All';
            var reportPrintDate = kendo.toString(new Date(), 'dd-MMM-yyyy HH:mm');
            var gridCols = grid.columns
                .filter(function (column) {
                    return !column.hidden && column.field && column.title.toLowerCase().trim() !== 'action';
                })
                .map(function (column) {
                    return {
                        field: column.field,
                        title: column.title || column.field,
                        type: column.type || null,
                        format: column.format || null
                    };
                });
            localStorage.setItem('kendo_grid_columns', JSON.stringify(gridCols));
            localStorage.setItem('report_title', header.title || 'Expense Detail');

            if (typeof window._kShowLoader === 'function') {
                window._kShowLoader('Opening report…', 'Fetching all records');
            }

            window._kFetchAllRows(grid.dataSource)
                .then(function (allData) {
                    var gridDataJson = JSON.stringify(window._flattenKendoGroups(allData));
                    localStorage.setItem('kendo_grid_export', gridDataJson);
                    if (typeof window._kUpdateLoader === 'function') {
                        window._kUpdateLoader('Generating report…', 'Please do not close this page');
                    }
                    return $.ajax({
                        url: config.serverRoot + 'KendoPDFExport',
                        type: 'POST',
                        headers: { Authorization: 'Bearer ' + access_Token },
                        data: { data: gridDataJson, systemId: systemId }
                    });
                })
                .then(function (response) {
                    var pdfDocument = new DOMParser().parseFromString(String(response), 'text/html');
                    var reportDateElement = pdfDocument.querySelector('.report-date');
                    if (reportDateElement) {
                        reportDateElement.textContent = dateRange + ' | Print Date: ' + reportPrintDate;
                    }
                    var classSelect = pdfDocument.getElementById('classSelect');
                    var selectedOption = null;
                    if (classSelect) {
                        $(classSelect).find('option').each(function () {
                            var isSelected = header.classId && this.value === String(header.classId);
                            this.selected = !!isSelected;
                            if (isSelected) selectedOption = this;
                        });
                        if (!selectedOption) {
                            selectedOption = classSelect.options[classSelect.selectedIndex];
                        }
                    }
                    if (selectedOption) {
                        selectedOption.setAttribute('data-name-en', header.companyEn || '');
                        selectedOption.setAttribute(
                            'data-name-kh',
                            (header.companyKh || '').replace(/^ក្រុមហ៊ុន\s*/, '')
                        );
                    }
                    var companyEnElement = pdfDocument.getElementById('companyNameEN');
                    var companyKhElement = pdfDocument.getElementById('companyNameKH');
                    if (companyEnElement) companyEnElement.textContent = header.companyEn || '';
                    if (companyKhElement) companyKhElement.textContent = header.companyKh || '';
                    var html = '<!DOCTYPE html>\n' + pdfDocument.documentElement.outerHTML;

                    var newTab = window.open('', '_blank');
                    if (!newTab) {
                        throw new Error('The PDF preview window was blocked by the browser.');
                    }
                    newTab.document.open();
                    newTab.document.write(html);
                    newTab.document.close();
                    if (typeof window._kUpdateLoader === 'function') {
                        window._kUpdateLoader('Done!', 'Opening in new tab…');
                    }
                    if (typeof window._kHideLoader === 'function') {
                        setTimeout(window._kHideLoader, 800);
                    }
                })
                .catch(function (error) {
                    if (typeof window._kHideLoader === 'function') window._kHideLoader();
                    console.error('Expense Detail PDF export failed:', error);
                    alert('Failed to generate the Expense Detail PDF. Please try again.');
                });
        };
        wrappedExport._expenseDetailWrapped = true;
        window.kendoGridPdfExport = wrappedExport;
    }

    function updateDynamicTitle(companyOverride, classId) {
        var classInfo = getSelectedClassInfo();
        var compEn = companyOverride ? companyOverride.companyNameEn : classInfo.companyEn;
        var compKh = companyOverride ? companyOverride.companyNameKh : classInfo.companyKh;
        var selectedClassId = classId || classInfo.classId || classInfo.val;
        var title = getDynamicReportTitle(compEn);
        window.expenseDetailPdfHeader = {
            title: title,
            companyEn: compEn,
            companyKh: compKh,
            classId: selectedClassId
        };
        bindExpenseDetailPdfExport();

        document.title = title;
        $('#lblReportTitle').text(title);
        $('.report-header-print h3, .report-header-print h4, .report-header-print h5, .report-header-print .report-title, .report-title, .header-report h3, .header-report h2, .header-report .title').text(title);

        // Update the English company name for the selected class.
        if (compEn) {
            $('#lblCompanyNameEn, .bs-company-en, .company-name-en, .header-company-en, .print-company-header .co-name-en').text(compEn);
            $('.report-header-print .company-name-en').text(compEn);
        }

        // 3. Dynamically change company Khmer name
        if (compKh) {
            $('#lblCompanyNameKh, .bs-company-kh, .company-name-kh, .header-company-kh, .print-company-header .co-name-kh').text(compKh);
            $('.report-header-print .company-name, .report-header-print h2').text(compKh);
        }

        // 4. Update header text inside report wrapper and TableGridWidget
        var $wrapper = $('#expense-detail-report-view-wrapper');
        $wrapper.find('h3, h2, h1, .report-title, .bs-company-en, .bs-company-kh, .header-company-en, .header-company-kh').each(function () {
            var $t = $(this);
            var txt = $.trim($t.text());
            if (isExpenseDetailTitle(txt)) {
                $t.text(title);
            }
            if (compEn && (txt === 'NSM TECHNOLOGY' || txt === 'NSM TECH' || txt === 'NSM TECH CO., LTD' || txt === 'NSM SOLUTION AND MAINTENANCE CO., LTD')) {
                $t.text(compEn);
            }
            if (compKh && (txt === 'ក្រុមហ៊ុន អិនអេសអិម ថេកណូឡូជី' || txt === 'អិនអេសអិម ថេកណូឡូជី' || txt.indexOf('ថេកណូឡូជី') !== -1 || txt.indexOf('សឹលូសិន') !== -1)) {
                $t.text(compKh);
            }
        });

        // 5. Update Kendo Grid PDF options
        var grid = getKendoGrid();
        if (grid) {
            if (!grid.options.pdf) grid.options.pdf = {};
            grid.options.pdf.title = title;
            grid.options.pdf.fileName = getExportFileName(compEn, 'pdf');
            if (!grid.options.excel) grid.options.excel = {};
            grid.options.excel.fileName = getExportFileName(compEn, 'xlsx');
        }

        // 6. Update TableGridWidget registry title and company names for Print Preview & export
        if (window.TableGridWidget && window.TableGridWidget.registry) {
            $.each(window.TableGridWidget.registry, function (_, config) {
                if (config) {
                    config.reportTitle = title;
                    config.Title = title;
                    config.report_title = title;
                    config.title = title;
                    if (compKh) {
                        config.companyNameKh = compKh;
                        config.CompanyNameKh = compKh;
                        config.CompanyKH = compKh;
                    }
                    if (compEn) {
                        config.companyNameEn = compEn;
                        config.CompanyNameEn = compEn;
                        config.CompanyEN = compEn;
                        config.companyName = compEn;
                    }
                    if (config.arrCompanyInfo && config.arrCompanyInfo.length > 0) {
                        try {
                            var compList = JSON.parse(config.arrCompanyInfo[0]);
                            if (compList && compList.length > 0) {
                                if (compKh) compList[0].CompanyNameKH = compKh;
                                if (compEn) compList[0].CompanyName = compEn;
                                config.arrCompanyInfo[0] = JSON.stringify(compList);
                            }
                        } catch(e) {}
                    }
                }
            });
        }

        return { title: title, companyEn: compEn, companyKh: compKh };
    }

    var classHeaderRequest = 0;
    function refreshSelectedClassHeader() {
        var $classFilter = $('#gjFilterClass');
        var classId = getExpenseDetailHeaderClassValue();

        if (!classId) {
            window.expenseDetailResolvedClassHeader = null;
            classHeaderRequest++;
            updateDynamicTitle();
            return;
        }

        window.expenseDetailResolvedClassHeader = null;
        var $selectedOption = $classFilter.find('option').filter(function () {
            return this.value === classId;
        }).first();
        var className = $.trim($selectedOption.text()) || classId;
        var classLookup = window.AccountingAdvanceFilter && window.AccountingAdvanceFilter.lastData
            ? (window.AccountingAdvanceFilter.lastData.classes || window.AccountingAdvanceFilter.lastData.Classes || [])
            : [];
        var classRecord = null;
        $.each(classLookup, function (_, item) {
            if ($.trim(String(item.ClassName || '')) === className) {
                classRecord = item;
                return false;
            }
        });
        var databaseClassId = classRecord && classRecord.ClassID != null
            ? String(classRecord.ClassID)
            : (/^\d+$/.test(classId) ? classId : '');
        var requestId = ++classHeaderRequest;

        $.ajax({
            url: '@Url.Action("GetCompanyHeader", "ExpenseDetailReport")',
            type: 'GET',
            data: { className: className, classId: databaseClassId },
            success: function (response) {
                if (requestId !== classHeaderRequest) return;
                if (!response || !response.success || !response.companyNameEn) {
                    console.warn('Expense Detail company header could not be resolved for class:', className);
                    updateDynamicTitle();
                    return;
                }
                window.expenseDetailResolvedClassHeader = {
                    selectionKey: classId,
                    classId: response.classId || classId,
                    companyNameEn: response.companyNameEn || '',
                    companyNameKh: response.companyNameKh || ''
                };
                updateDynamicTitle(response, response.classId || classId);
            },
            error: function (xhr, status, error) {
                if (requestId === classHeaderRequest) {
                    console.warn('Expense Detail company header request failed:', status, error);
                }
            }
        });
    }

    function placeAdvancePanel() {
        var $wrapper = $('#expense-detail-report-view-wrapper');
        if ($wrapper.length === 0) return;
        var $panel = $wrapper.find('#gjAdvanceContainer, #gjAdvancePanel, .gj-advance-panel').first();
        var $form = $wrapper.find('form, .form-search, table.table-search, .search-form-wrapper').first();
        var $header = $wrapper.find('#edReportHeader').first();

        if ($form.length && $panel.length) {
            $form.after($panel);
        }

        var $grid = $wrapper.find('.table-responsive, [data-role="grid"], .k-grid, #TableGride').first();
        var $gridHost = $grid.closest('.ShowGridTable');
        var $tableContainer = $grid.closest('.table-responsive, [class*="tableresponsive_"]');
        if ($tableContainer.length === 0) {
            $tableContainer = $grid.closest('.k-grid');
        }

        if ($header.length && $gridHost.length) {
