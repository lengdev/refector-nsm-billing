        });
        $(document).off('change.expenseDetailHeader', '#gjFilterClass')
            .on('change.expenseDetailHeader', '#gjFilterClass', function () {
            var values = getExpenseDetailClassValues().map(String);
            window.expenseDetailClassSelectionOrder = (window.expenseDetailClassSelectionOrder || [])
                .filter(function (value) { return values.indexOf(value) !== -1; });
            values.forEach(function (value) {
                var order = window.expenseDetailClassSelectionOrder;
                if (order.indexOf(value) === -1) order.push(value);
            });
            refreshSelectedClassHeader();
        });

        $('#expense-detail-report-view-wrapper').on('apply.daterangepicker change', 'input[name="TxtFromDate"], #TxtFromDate', function () {
            updateEdDateRangeHeader();
            if (typeof LoadTableGrid === 'function') {
                LoadTableGrid(1);
            }
        });
    });
})();
</script>
