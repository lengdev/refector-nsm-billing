    function AmountKeyup(THIS) {
        var SubTotal = 0;// $(THIS).val();
        $("input[name=ItemName]").each(function (i) {
            if ($("input[name=ItemName]").eq(i).val() != "" && $("input[name=Amount]").eq(i).val() != "") {
                SubTotal += accounting.unformat($("input[name=Amount]").eq(i).val());
            }
        });
        $("label[name=SubTotal]").html(accounting.formatNumber(SubTotal, 2));
        var Rate = ($("#Tax_Rate").val() == "" ? 0 : $("#Tax_Rate").val());
        Rate = (Rate == "" ? 0 : accounting.unformat(Rate));
        //var VAT = //$("label[name=VAT]").html();
        var Total = accounting.unformat(SubTotal);
        //if (Rate != 0) {
        var VAT = ((accounting.unformat(SubTotal) * Rate) / 100);
        $("label[name=VAT]").html(accounting.formatNumber(VAT, 2));
        Total += accounting.unformat(VAT);
        //}
        Total = accounting.unformat($("label[name=SubTotal]").html()) + accounting.unformat($("label[name=VAT]").html());

        $("label[name=Total]").html(accounting.formatNumber(Total, 2));
        var TxtDisUSD = $("input[name=TxtDisUSD]").val();
        TxtDisUSD = (TxtDisUSD == "" ? 0 : accounting.unformat(TxtDisUSD));
        var GrandTotal = accounting.unformat(Total) - TxtDisUSD;
        $("label[name=GrandTotal]").html(accounting.formatNumber(GrandTotal, 2));

        let Deposit = accounting.unformat($("input[name=TxtDeposit]").val());
        let Balance = GrandTotal - Deposit;
        $("input[name=TxtBalance]").val(accounting.formatNumber(Balance, 2));

        var cutext = $("#Currency").val();
        var ex = $("#TxtExchangeRate").val();
        if (ex != "" && cutext != "") {
            $("tr[name=TRTotalAS]").show();
            $("label[name=LBLTotalAS]").html('សរុបជា ' + cutext + ' / Total​ As ' + cutext + ':');
            var GrandTotal = accounting.unformat($("label[name=GrandTotal]").html());
            GrandTotal = parseFloat(GrandTotal) * accounting.unformat(ex);
            $("label[name=TotalAS]").html(accounting.formatNumber(GrandTotal, 2));
        }
        else {
            $("tr[name=TRTotalAS]").hide();
        }
    }
    function TotalAll() {
        var SubTotal = 0;
        $("input[name=ItemName]").each(function (i) {
            var QTY = $("input[name=QTY]").eq(i).val();
            QTY = (QTY == "" ? 0 : accounting.unformat(QTY));
            var UnitPrice = $("input[name=UnitPrice]").eq(i).val();
            UnitPrice = (UnitPrice == "" ? 0 : accounting.unformat(UnitPrice));
            var Amount = (QTY * UnitPrice);

            var DisUSD = $("input[name=DisUSD]").eq(i).val();
            DisUSD = (DisUSD == "" ? 0 : accounting.unformat(DisUSD));
            Amount = Amount - DisUSD;

            $("input[name=Amount]").eq(i).val(accounting.formatNumber(Amount, 2));
            SubTotal += Amount;
        });
        $("label[name=SubTotal]").html(accounting.formatNumber(SubTotal, 2));
        var Rate = $("#Tax_Rate").val();
        Rate = (Rate == "" ? 0 : accounting.unformat(Rate));
        //var VAT = //$("label[name=VAT]").html();
        var Total = accounting.unformat(SubTotal);
        //if (Rate != 0) {
        var VAT = ((accounting.unformat(SubTotal) * Rate) / 100);
        $("label[name=VAT]").html(accounting.formatNumber(VAT, 2));
        Total += accounting.unformat(VAT);
        Total = accounting.unformat($("label[name=SubTotal]").html()) + accounting.unformat($("label[name=VAT]").html());
        //}
        $("label[name=Total]").html(accounting.formatNumber(Total, 2));
        var TxtDisUSD = $("input[name=TxtDisUSD]").val();
        TxtDisUSD = (TxtDisUSD == "" ? 0 : accounting.unformat(TxtDisUSD));
        var GrandTotal = accounting.unformat(Total) - TxtDisUSD;
        $("label[name=GrandTotal]").html(accounting.formatNumber(GrandTotal, 2));

        let Deposit = accounting.unformat($("input[name=TxtDeposit]").val());
        let Balance = GrandTotal - Deposit;
        $("input[name=TxtBalance]").val(accounting.formatNumber(Balance, 2));

        var cutext = $("#Currency").val();
        var ex = $("#TxtExchangeRate").val();
        if (ex != "" && cutext != "") {
            $("tr[name=TRTotalAS]").show();
            $("label[name=LBLTotalAS]").html('សរុបជា ' + cutext + ' / Total​ As ' + cutext + ':');
            var GrandTotal = accounting.unformat($("label[name=GrandTotal]").html());
            GrandTotal = parseFloat(GrandTotal) * accounting.unformat(ex);
            $("label[name=TotalAS]").html(accounting.formatNumber(GrandTotal, 2));
        }
        else {
            $("tr[name=TRTotalAS]").hide();
        }
    }
    function SaveChangeCallbackFunction(response) {
        response = JSON.parse(response.Data)[0];
        var isOpen = false;
        if (Type != "Bill" && Type != "EditBill" && Type != "Credit Note") {
            isOpen = true;
            var url = '#!/Profile?ID=' + response.VendorID + '&BillNumber=' + response.BillNumber;
            OpenNewTap(url);
        }
        else if (KVendorName != "") {
            if (KVendorName != $("#Vendor_Name").val()) {
                isOpen = true;
                var url = '#!/Profile?ID=' + response.VendorID + '&BillNumber=' + response.BillNumber;
                OpenNewTap(url);
            }
            else {
                if (Status == 'ConvertToCreditNote' || Status == 'Credit Note') {
                    Bill_Number = response.BillNumber;
                    $("#BunSearch").click();
                    $("#CreditNote_Tap").click();
                    $("#txtBillNumberCreditNote").val(Bill_Number);
                    $("#BtnSearchVendorBillsCreditNote").click();
                }
                else {
                    Bill_Number = response.BillNumber;
                    $("#BunSearch").click();
                    $("#BtnSearchVendorPO").click();
                    $("#BtnSearchVendorBills").click();
                    $("#Bills_Tap").click();
                    $("#txtBillNumberBill").val(Bill_Number);
                }
                $("html, body").animate({ scrollTop: 0 }, "slow");
            }
        } else if (Type == "EditBill") {
                Bill_Number = response.BillNumber;
                $("#BunSearch").click();
                $("#PurchaseOrder_Tap").click();
                $("#BtnSearchVendorPO").click();
            $("html, body").animate({ scrollTop: 0 }, "slow");
        }

        var loc = window.location.href;
        var ID = getQueryStringValue(loc, 'ID');
        if (!isOpen && ID == "") {
            var url = '#!/Profile?ID=' + response.VendorID + '&BillNumber=' + response.BillNumber;
            OpenNewTap(url);
        }
        $("#modal-default").modal('hide');
    }

