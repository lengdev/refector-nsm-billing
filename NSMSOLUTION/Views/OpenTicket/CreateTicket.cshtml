    function loadDate(start, end) {
        $("#StartDate").data('daterangepicker').setStartDate(start);
        $("#StartDate").data('daterangepicker').setEndDate(start);
        $("#StartDate").val(start.format('DD/MM/YYYY'));

        $("#EndDate").data('daterangepicker').setStartDate(end);
        $("#EndDate").data('daterangepicker').setEndDate(end);
        $("#EndDate").val(end.format('DD/MM/YYYY'));
    }

    function onPostAudienceChange() {
        var PostAudienceStatusID = $("#PostAudience_PostAudienceID").val();
        var SupportProjectID = $("#ProjectName_SupportProjectID").val();
        if (SupportProjectID == "") {
            DialogSweetAlert("error", "Please choose Project Name.");
        }
        else if (PostAudienceStatusID == 21) {
            Member(PostAudienceStatusID, SupportProjectID, 'Specific Member');
        }
        else if (PostAudienceStatusID == 22) {
            Member(PostAudienceStatusID, SupportProjectID, 'Member Except');
        }
        else {
            MemberExcept = [];
            SpecificMember = [];
            $("#PostAudienceUserLoginID").val('');
        }
    }

    function Member(PostAudienceStatusID, SupportProjectID, Title) {
        ShowDialogBox2(Title, "800", "500", "OpenTicket/LoadUser?SupportProjectID=" + SupportProjectID, 0, "dialogAddUser", function (result) {
            $("#SaveChange2").click(function () {
                var UserLoginID = $("input[name=UserLoginID]:checked");
                SpecificMember = [];
                MemberExcept = [];
                var Member = "";
                $.each(UserLoginID, function (key, value) {
                    var obj = {};
                    obj = {
                        SupportProjectID: SupportProjectID,
                        UserLoginID: $(value).val()
                    };
                    if (PostAudienceStatusID == 21)
                        SpecificMember.push(obj);
                    else if (PostAudienceStatusID == 22)
                        MemberExcept.push(obj);
                    if (Member == "")
                        Member = $(value).val();
                    else
                        Member += "," + $(value).val();
                });

                if (PostAudienceStatusID == 21) {
                    if (Member == "")
                        DialogSweetAlert("error", "Please choose Specific Member.");
                    else {
                        $("#dialogAddUser").modal('hide');
                        $("#PostAudienceUserLoginID").val(Member);
                    }
                }
                else if (PostAudienceStatusID == 22) {
                    if (Member == "")
                        DialogSweetAlert("error", "Please choose Member Except.");
                    else {
                        $("#dialogAddUser").modal('hide');
                        $("#PostAudienceUserLoginID").val(Member);
                    }
                }
            });

            $("#dialogAddUser").on('hide.bs.modal', function () {
                if (SpecificMember.length == 0 && PostAudienceStatusID == 21) {
                    $("#PostAudience").typeahead('val', 'Public');
                    $("#PostAudience_PostAudienceID").val(20);
                    SpecificMember = [];
                    MemberExcept = [];
                    $("#PostAudienceUserLoginID").val('');
                }
                else if (MemberExcept.length == 0 && PostAudienceStatusID == 22) {
                    $("#PostAudience").typeahead('val', 'Public');
                    $("#PostAudience_PostAudienceID").val(20);
                    MemberExcept = [];
                    SpecificMember = [];
                    $("#PostAudienceUserLoginID").val('');
                }
            });

            setTimeout(function () {
                if (SpecificMember.length > 0 && PostAudienceStatusID == 21) {
                    $("input[name=UserLoginID]").each(function (key, value) {
                        var SMember = SpecificMember.filter(function (data) {
                            return data.UserLoginID == $(value).val();
                        })[0];
                        if (SMember) {
                            if (SMember.UserLoginID == $(value).val()) {
                                $(this).attr('checked', 'checked');
                            }
                        }
                    });
                }
                else if (MemberExcept.length > 0 && PostAudienceStatusID == 22) {
                    $("input[name=UserLoginID]").each(function (key, value) {
                        var SMember = MemberExcept.filter(function (data) {
                            return data.UserLoginID == $(value).val();
                        })[0];
                        if (SMember) {
                            if (SMember.UserLoginID == $(value).val()) {
                                $(this).attr('checked', 'checked');
                            }
                        }
                    });
                }
            }, 300);
        });
    }

