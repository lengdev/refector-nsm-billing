    function sendMessage() {
        var TimeNow = moment(new Date()).format("DD-MM-YYYY hh:mm:ss");
        var ReplyMessage = $("#message").val();
        if (ReplyMessage != "") {
            IsCommented = true;
            var UpdateStatus = false;
            if (TicketStatusID != $("input[name=Status]:checked").val()) {
                UpdateStatus = true;
                TicketStatusID = $("input[name=Status]:checked").val();
                TicketStatus = $("input[name=Status]:checked").data('name');
            }
            ReplyMessage = $("#message").summernote('code').replace(/&nbsp;|<br>/g, ' ');
                //$("#message").summernote('code').replace(/&nbsp;|<br>/g, ' ').text().trim() == '';
            var ReplyFromUserName = User_Full_Name;
            Data = {
                Data: JSON.stringify({
                    SupportProjectID: SupportProjectID,
                    StatusID: TicketStatusID,
                    Status: TicketStatus,
                    PriorityID: PriorityID,
                    Priority: Priority,
                    OpenTicketID: OpenTicketID,
                    FromUserLoginID: UserLoginID,
                    FromUserName: FullName,
                    ReplyFromUserLoginID: User_ID,
                    ReplyFromUserName: ReplyFromUserName,
                    Comment: encodeURIComponent(nl2br(ReplyMessage)),
                    UpdateStatus: UpdateStatus,
                    EditCommentTextID: EditCommentTextID
                })
            };
            $("#message").summernote('code', '');
            $("#message").summernote('focus');
            PostData("Tickets/SaveChangeOpenTicketComment", Data, function (response) {
                var SupportOpenTicketCommentID = JSON.parse(response).Data;
                if (EditCommentTextID == "") {
                    var row = "";
                    row += `<div class="chat-messages" name="messages">
                    <div class="direct-chat-msg">
                        <div class="direct-chat-infos clearfix">
                            <span class="direct-chat-name float-left">`+ User_Full_Name.toUpperCase() + `</span>
                            <span class="direct-chat-timestamp float-right">`+ TimeNow + `</span>
                        </div>
                        <img class="direct-chat-img" src="`+ UserProfilePicture + `" alt="message user image" />
                        <div class="direct-chat-text"><div name="CommentText">`+ ReplyMessage + `</div>
                        <div style="display:none;" name="SupportOpenTicketCommentID">`+ SupportOpenTicketCommentID + `</div>
                        <div class="ReplyAction"><i name="Edit" class="fas fa-edit" title="Edit"></i>  <i onclick="DeleteComment(this);" name="Delete" class="fa-solid fa-trash" title="Delete"></i></div>
                        </div>
                    </div>
                    </div>`;
                    $("div[name=messages]:last").after(row);
                }
                else {
                    $("div[name=CommentText]").eq(CommentTextInex).html(ReplyMessage);
                    $('#modalTicketDetailmodalbody').animate({ scrollTop: $("div[name=messages]").eq(CommentTextInex).position().top }, 'slow');
                    $("div[name=CommentText]").eq(CommentTextInex).parent().toggleClass("highlight");
                    setTimeout(function () {
                        $("div[name=CommentText]").eq(CommentTextInex).parent().removeClass("highlight");
                    }, 2000);
                }
                $.connection.hub.start().done(function () {
                    row = `<div class="chat-messages" name="messages">
                    <div class="direct-chat-msg right">
                        <div class="direct-chat-infos clearfix">
                            <span class="direct-chat-name float-right">`+ User_Full_Name.toUpperCase() + `</span>
                            <span class="direct-chat-timestamp float-right mr-2">`+ TimeNow + `</span>
                        </div>
                        <img class="direct-chat-img" src="`+ UserProfilePicture + `" alt="message user image" />
                        <div class="direct-chat-text float-right mr-2"><div name="CommentText">`+ ReplyMessage + `</div>
                        <div style="display:none;" class="ReplyAction"><i name="Edit" class="fas fa-edit" title="Edit"></i>  <i onclick="DeleteComment(this);" name="Delete" class="fa-solid fa-trash" title="Delete"></i></div>
                        </div>
                    </div>
                    </div>`;
                    if (EditCommentTextID == "") {
                        CurrentTicketIDOpened = OpenTicketID;
                        chatHub.server.sendMessage(User_Full_Name, UserProfilePicture, row, projectName, ReplyMessage, OpenTicketID, TicketNumber, SupportProjectID, System_ID, Warehouse_ID);
                    }
                });
                EditCommentTextID = "";
                $("i[name=Edit]").tooltip();
                $("i[name=Delete]").tooltip();
            });
        }
        else {
            DialogSweetAlert('error', "Please entry your description.");
        }
    }
    function ChangeStatus(Status) {
        var StatusID = Status.getAttribute("data-value");
        var OldStatus = $("button#Status").html();
        $("button#Status").html(Status.innerHTML);
        $("input[name=Status]").each(function (key, val) {
            if (StatusID == $(this).val()) {
                $(this).attr("checked", true).click();
                var CommentText = "Change Status From: <b class=\"text-red\">" + OldStatus + "</b> To: <b class=\"text-red\">" + Status.innerHTML+"</b>";
                CommentText += " By: <b class=\"text-primary\">" + User_Full_Name+"</b>";
                $("#message").summernote('code', CommentText);
                $("#message").summernote('focus');
                sendMessage();
                return false;
            }
        });
    }
    function ChangePriorityStatus(Status) {
        var StatusID = Status.getAttribute("data-value");
        var OldStatus = $("button#PriorityStatus").html();
        PriorityID = StatusID;
        Priority = Status.innerHTML;
        $("button#PriorityStatus").html(Status.innerHTML);
        var CommentText = "Change Priority Status From: <b class=\"text-red\">" + OldStatus + "</b> To: <b class=\"text-red\">" + Status.innerHTML + "</b>";
        CommentText += " By: <b class=\"text-primary\">" + User_Full_Name + "</b>";
        $("#message").summernote('code', CommentText);
        $("#message").summernote('focus');
        sendMessage();
    }
    function EditComment(THIS) {
        var index = $("i[name=Edit]").index($(THIS));
        var CommentText = $("div[name=CommentText]").eq(index).html();
        $("#message").summernote('code', CommentText);
        $("#message").summernote('focus');
        EditCommentTextID = $("div[name=SupportOpenTicketCommentID]").eq(index).html();
        CommentTextInex = index;
    }
    function DeleteComment(THIS) {
        var index = $("i[name=Delete]").index($(THIS));
        var ID = $("div[name=SupportOpenTicketCommentID]").eq(index).html();
        var Data = { TicketCommentID: ID }
        DoDelete("Tickets/DeleteComment", Data, function (response) {
            $("div[name=messages]").eq(index).remove();
        });
    }
    function DeleteTicket(OpenTicketID) {
        var Data = { ID: OpenTicketID }
        DoDelete("Tickets/DeleteTicket", Data, function (response) {
            $("#modalTicketDetail").modal('hide');
            ShowTicket('MyTicket');
        });
    }

    //$("input[name=Status]").click(function () {
    //    var ReplyMessage = $("#message").val();
    //    if (ReplyMessage == "")
    //        DialogSweetAlert('error', "Please entry your description.");
    //});

    function auto_height(elem) {  /* javascript */
        elem.style.height = "1px";
        elem.style.height = (elem.scrollHeight) + "px";
    }
</script>
