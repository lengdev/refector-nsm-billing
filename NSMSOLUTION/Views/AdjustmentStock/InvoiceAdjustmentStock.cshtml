@{
    Layout = null;
    System.Data.DataRow dataRow = ViewBag.Data.Rows[0];
}
<link href="https://fonts.googleapis.com/css2?family=Moul&display=swap" rel="stylesheet">
<style>
    .mytable th, .mytable td {
        border: 0.5px solid #000 !important;
    }

    .mytable th {
        background-color: @(dataRow["SystemID"].ToString() == "25" ? "#c5d9f1" : "#f89c39");
        color: @(dataRow["SystemID"].ToString() == "25" ? "#000" : "#fff") ;
    }

    .moul-regular {
        font-family: "Moul", serif;
        font-weight: 400;
        font-style: normal;
    }

    @@media print {
        @@page {
            size: A3 !important;
            margin: 0px 20px 0px 50px !important;
        }
    }
</style>
<div style="padding:5px;" id="DivPrintStockAdjustment">
    <div class="row">
        <div class="col-12 d-flex justify-content-between align-items-end mt-4 mb-3">
            <div class="img">
                <img class="img-fluid" src="@ViewBag.Logo" width="200" />
            </div>
        </div>

        <div style="margin: 0 auto 10px;text-align: center;">
            <h4 class="page-header mb-2 moul-regular" ​>ប័ណ្ណ​កែប្រែទំនិញ</h4>
            <h5 class="page-header text-uppercase" style="font-family: 'Times New Roman', Times, serif">Stock Adjustment</h5>
        </div>
    </div>
    <div class="row mt-2">
        <div class="col">
            <label><b>Adjust Name:</b> @dataRow["CreateBy"]</label><br />
            <label><b>Tel:</b> @dataRow["PreparedPhone"]</label><br />
            <label><b>Warehouse:</b> @dataRow["Warehouse"]</label>
        </div>
        <div class="col text-right">
            <label><b>Adjust No:</b> @dataRow["ReferenceNo"].ToString()</label><br />
            <label><b>Adjust Date:</b> @dataRow["ReceivedDate"].ToString()</label>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col">
            <table class="table mytable">
                <thead class="text-center">
                    <tr>
                        <th width="5%">No.</th>
                        <th width="10%">Item Code</th>
                        <th width="20%">Item Name</th>
                        <th width="8%">Serial Number</th>
                        <th width="8">Adjust Type</th>
                        <th width="8%">QTY Available</th>
                        <th width="8%">QTY OnHand</th>
                        <th width="8%">QTY Adjusted</th>
                        <th width="5%">UOM</th>
                        <th width="20%">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int i = 0;
                        foreach (System.Data.DataRow dr in ViewBag.Data.Rows)
                        {
                            i++;
                            <tr>
                                <td align="center">@i</td>
                                <td align="center" nowrap>@dr["ItemCode"]</td>
                                <td>@dr["ItemName"]</td>
                                <td align="center" nowrap>@dr["SerialNumber"]</td>
                                <td align="center" nowrap>@dr["AdjustType"]</td>
                                <td align="right" nowrap>@dr["QuantityAvliable"]</td>
                                <td align="right" nowrap>@dr["QuantityOnHand"]</td>
                                <td align="right" nowrap>@dr["QuantityAdjusted"]</td>
                                <td align="center">@dr["UM"]</td>
                                <td>@dr["Reason"]</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <footer>
        <div id="divFooterPrint">
            <div class="row" style="margin-top:50px">
                <div class="col-4">
                    @{string[] aa = dataRow["PreparedBySignature"].ToString().Split('~');
                        if (aa[0].ToString() != "")
                        {
                            <div class="text-center" style="height:50px">
                                <img height="60" src="../Uploads/Users/@aa[0]" />
                            </div>
                        }
                        else
                        {
                            <div class="text-center" style="height:50px"></div>
                        }
                    }
                    <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                    <div class="row">
                        <div class="col text-center">
                            <label class="col-form-label text-uppercase text-nowrap">Prepared By</label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="col-form-label text-nowrap">Name: @dataRow["PreparedBy"].ToString()</label><br>
                            <label class="col-form-label text-nowrap">Position: @dataRow["PreparedByPosition"].ToString()</label><br>
                            <label class="col-form-label text-nowrap">Date: @dataRow["ReceivedDate"].ToString()</label><br>
                        </div>
                    </div>
                </div>
                <div class="col-4">&nbsp;</div>
                <div class="col-4">
                    @{aa = dataRow["CheckSignature"].ToString().Split('~');
                        if (aa[0].ToString() != "")
                        {
                            <div class="text-center" style="height:50px">
                                <img height="60" src="../Uploads/Users/@aa[0]" />
                            </div>
                        }
                        else
                        {
                            <div class="text-center" style="height:50px"></div>
                        }
                    }
                    <hr style="height:2px;width:100%; border-width:0; color:black; background-color:black">
                    <div class="row">
                        <div class="col text-center">
                            <label class="col-form-label text-uppercase text-nowrap">
                                Check By
                            </label>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <label class="col-form-label text-nowrap">Name: @dataRow["CheckBy"].ToString()</label><br>
                            <label class="col-form-label text-nowrap">Position: @dataRow["CheckByPosition"].ToString()</label><br>
                            <label class="col-form-label text-nowrap">Date: @(dataRow["ReceivedDate"].ToString() != "" ? dataRow["ReceivedDate"].ToString():"")</label><br>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>
