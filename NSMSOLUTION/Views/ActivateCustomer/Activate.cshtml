                </div>
                <div class="row form-group">
                  <div class="col-3 text-right">
                    <label for="PPPoEIPAddress" class="col-form-label">IP Address:</label>
                  </div>
                  <div class="col">
                    <input id="PPPoEIPAddress" name="PPPoEIPAddress" type="text" class="form-control"
                      data-inputmask="'alias': 'ip'" data-mask />
                  </div>
                </div>
                <div class="row form-group justify-content-end">
                  <div class="col text-right">
                    <button id="btnGeneratePWD" type="button" class="btn btn-primary"
                      onclick="GetGeneratPWD();">Generate Password</button>
                  </div>
                </div>
              </div>
            </div>
            <div id="divUserWifiInfo" class="col-6">
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label">Device Name:</label>
                </div>
                <div class="col">
                  <input name="CustDeviceName" id="CustDeviceName" type="text" class="form-control" />
                </div>
              </div>
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label">Router IP:</label>
                </div>
                <div class="col">
                  <input name="WifiIP" id="WifiIP" value="192.168.1.1" type="text" class="form-control"
                    data-inputmask="'alias': 'ip'" data-mask />
                </div>
              </div>
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label">Wifi Name:</label>
                </div>
                <div class="col">
                  <input name="WifiName" id="WifiName" type="text" class="form-control" />
                </div>
              </div>
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label">Wifi Key:</label>
                </div>
                <div class="col">
                  <input name="WifiKey" id="WifiKey" type="text" class="form-control" />
                </div>
              </div>
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label">Router Login Name:</label>
                </div>
                <div class="col">
                  <input name="WifiLoginName" value="user" id="WifiLoginName" type="text" class="form-control" />
                </div>
              </div>
              <div class="row form-group">
                <div class="col-3 text-right">
                  <label class="col-form-label text-nowrap">Router Login PWD:</label>
                </div>
                <div class="col">
                  <input name="WifiLoginPassword" id="WifiLoginPassword" value="user" type="text"
                    class="form-control" />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
<script>
  function ActivateDate_ApplyDatePicker() {
    $("#ActivateCustDate").removeAttr("readonly");
    $("#ActivateCustDate").daterangepicker({
      drops: 'auto',
      showDropdowns: true, singleDatePicker: true, autoApply: true,
      locale: {
        format: 'DD/MM/YYYY'
      }
    }).on('apply.daterangepicker', function (ev, picker) {
      $(this).val(picker.startDate.format('DD/MM/YYYY'));
    }).on('cancel.daterangepicker', function (ev, picker) {
      $(this).val('');
    });
  }
</script>
