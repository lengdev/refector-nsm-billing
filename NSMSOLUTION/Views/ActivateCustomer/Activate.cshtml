                      data-inputmask="'alias': 'ip'" data-mask>
                  </div>
                </div>
                <div class="row form-group">
                  <div class="col-3 text-right">
                    <label class="col-form-label">Default Getway IP:</label>
                  </div>
                  <div class="col" data-validate="Getway IP is required.">
                    <input id="GetwayIP" name="GetwayIP" type="text" class="form-control" data-inputmask="'alias': 'ip'"
                      data-mask>
                  </div>
                </div>
                <div class="row form-group">
                  <div class="col-3 text-right">
                    <label class="col-form-label">Subnet IP:</label>
                  </div>
                  <div class="col" data-validate="Subnet IP Address is required.">
                    <input id="Subnet" name="SubnetIP" type="text" class="form-control" data-inputmask="'alias': 'ip'"
