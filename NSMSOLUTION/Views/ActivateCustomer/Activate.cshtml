  function LockCustService(ActivateCustomerID, ConnectivityStatus) {
    if (IsNeedReActivate) {
      var check = true;
      var RouterID = $("#Cbo_RouterName").val();
      var ConnectionType = $("#Cbo_ConnectionTyp").val();
      var ActivateCustomerData = [];
      var obj = {};
      obj["ActivateCustomerID"] = ActivateCustomerID;
      obj["RouterID"] = RouterID;
      obj["BillingInvoiceID"] = BillingInvoiceID;
      obj["InvoiceNo"] = InvoiceNo;
      obj["SID"] = SID;
      obj["CustomerID"] = CustomerID;
      obj["ConnectionID"] = $("#ConnectionID").val();
      obj["ConnectionType"] = ConnectionType;
      obj["PPPoEUserName"] = $("#PPPoEUserName").val();
      obj["PPPoEPassword"] = $("#PPPoEPassword").val();
      obj["PPPoEProfileName"] = $("#PackageName").val();
      if (ConnectionType == "PPPoE") {
        check = true;
      }
      else if (ConnectionType == "Static") {
        var IPAddress = $("#IPAddress");
        var GetwayIP = $("#GetwayIP");
        var Subnet = $("#Subnet");
        var DNS1 = $("#DNS1");
        var DNS2 = $("#DNS2");

        if ($(IPAddress).val().trim() == '') {
          showValidate(IPAddress);
          check = false;
        }
        if ($(GetwayIP).val().trim() == '') {
          showValidate(GetwayIP);
          check = false;
        }
        if ($(Subnet).val().trim() == '') {
          showValidate(Subnet);
          check = false;
        }
        if ($(DNS1).val().trim() == '') {
          showValidate(DNS1);
          check = false;
        }
        if ($(DNS2).val().trim() == '') {
          showValidate(DNS2);
          check = false;
        }
        obj["VLanID"] = $("#VLanID").val();
        var data = "";
        if ($('#VLanID').select2('data')) {
          data = $('#VLanID').select2('data');
          if (data[0])
            obj["VLanName"] = data[0].text;
        }
        obj["VLanIPAddress"] = $("#VLanIPAddress").val();
        obj["IPAddress"] = $("#IPAddress").val();
        obj["GetwayIP"] = $("#GetwayIP").val();
        obj["SubnetIP"] = $("#Subnet").val();
        obj["DNS1"] = $("#DNS1").val();
        obj["DNS2"] = $("#DNS2").val();
      }
      obj["DeviceName"] = $("#CustDeviceName").val();
      obj["WifiIP"] = $("#WifiIP").val();
      obj["WifiName"] = $("#WifiName").val();
      obj["WifiKey"] = $("#WifiKey").val();
      obj["WifiLoginName"] = $("#WifiLoginName").val();
      obj["WifiLoginPassword"] = $("#WifiLoginPassword").val();
      obj["ISReActivate"] = ISReActivate;
      ActivateCustomerData.push(obj);

      //var DATA = {
      //    CustEquipmentData: JSON.stringify(CustEquipmentData),
      //    ActivateCustomerData: JSON.stringify(ActivateCustomerData)
      //};
      if ($("#Cbo_RouterName").val() == null) {
        DialogSweetAlert("error", "Please select router name.");
        check = false;
      }
      if (check) {
        CheckIPIsExisiting(function (isvalid) {
          if (isvalid) {
            var Message = "This customer will be unable to access this service.";
            var btnInputCommentText = "Do it now";
            if (ConnectivityStatus == 40) {
              Message = "This customer will be re-active this service.";
              btnInputCommentText = "Activate Now";
            }
            var URL = "ActivateCustomer/LockCustomerService";
            var DATA = {
              ActivateCustomerID: ActivateCustomerID,
              ConnectivityStatus: ConnectivityStatus,
              //CustEquipmentData: JSON.stringify(CustEquipmentData),
              ActivateCustomerData: JSON.stringify(ActivateCustomerData)
            };
            DoSaveChangeSweetCofirm(URL, DATA, function (response) {
              $("#CloseModal").click();
              if (!IsOnCustProfile) {
                $("#CboSearchText").val(CustomerName);
                $("#BunSearch").click();
                var url = '#!/CustomerProfile?ID=' + CustomerID;
                OpenNewTap(url);
              }
              else {
                CheckConnectivityStatus(CustomerID);
                LoadCustomerServices(CustomerID);
                LoadCustConnection(CustomerID);
                LoadCustServices(CustomerID);
                $("#Customer-Connection-tab").click();
              }
            }, "", Message, btnInputCommentText);
          }
        });
      }
    }
    else {
      CheckIPIsExisiting(function (isvalid) {
        if (isvalid) {
          var Message = "This customer will be unable to access this service.";
          var btnInputCommentText = "Do it now";
          if (ConnectivityStatus == 40) {
            Message = "This customer will be re-active this service.";
            btnInputCommentText = "Activate Now";
          }
          var URL = "ActivateCustomer/LockCustomerService";
          var DATA = { ActivateCustomerID: ActivateCustomerID, ConnectivityStatus: ConnectivityStatus };
          DoSaveChangeSweetCofirm(URL, DATA, function (response) {
            $("#CloseModal").click();
            if (!IsOnCustProfile) {
              $("#CboSearchText").val(CustomerName);
              $("#BunSearch").click();
              var url = '#!/CustomerProfile?ID=' + CustomerID;
              OpenNewTap(url);
            }
            else {
              CheckConnectivityStatus(CustomerID);
              LoadCustomerServices(CustomerID);
              LoadCustConnection(CustomerID);
              LoadCustServices(CustomerID);
            }
          }, "", Message, btnInputCommentText);
        }
      });
    }
  }

