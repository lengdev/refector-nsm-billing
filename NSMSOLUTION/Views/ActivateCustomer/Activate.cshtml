  function CheckIPIsExisiting(callback, NIP, OIP) {
    var RouterID = $("#Cbo_RouterName").val();
    NIP = typeof NIP == "undefined" ? $("#IPAddress").val() : NIP;
    OIP = typeof OIP == "undefined" ? OldIP : OIP;

    var valid = false;
    var ConnectionTyp = $("#Cbo_ConnectionTyp").val();
    if (ConnectionTyp == 'Static') {
      var NewIP = NIP;
      if (OIP != NewIP) {
        return new Promise(function (resolve) {
          LoadData('ActivateCustomer/CheckIPIsExisiting/?oldIP=' + OIP + "&NewIP=" + NewIP + "&RouterID=" + RouterID, function (result) {
            var Data = JSON.parse(result);
            if (Data.Result == 2)
              valid = true;
            else {
              DialogSweetAlert("error", Data.Message);
            }
            resolve();
            return callback(valid);
          });
        });
      }
      else {
        return callback(true);
      }
    } else {
      return callback(true);
    }
  }
