            ItemName: encodeURIComponent(ItemName),
            /*UM: UM,*/
            ItemExpirationDate: (ItemExpirationDate == "" ? "" : StringToDate(ItemExpirationDate))
        });

        var dateTimeObj = [
            { CreateBy: createBy, CreateDate: createDate, IsUpdate: isEdit }
        ];


        var DATA = {
            ItemCategory: JSON.stringify(ojbCat),
            //ItemPriceList: JSON.stringify(objDatas),
            OpeningStock: JSON.stringify(objDataOpeningStock),
            DateTimeCreate: JSON.stringify(dateTimeObj)
        };
        //console.log(ItemCategory)
        PostData("AddItem/SaveChangeItem", DATA, function (res) {
            const rst = JSON.parse(res);

            if (rst.Resutl === 2 && !isEdit) {
                PostData("AddItem/SendNotificationToTelegram", { ItemID: Datas.ItemID });
            }
        });
    }

    function generateItemCode() {
        let lastSeq;
        LoadData('AddItem/GetLastSeq', function (response) {
            const res = JSON.parse(JSON.parse(response).data);
            if (res.length > 0) {
                lastSeq = res[0].seq;
                lastSeq++;
                // Convert the number to a string and pad with leading zeros
                const newItemCode = lastSeq.toString().padStart(4, '0');
                $("#ItemCode").val(newItemCode);
                $('input[name="ItemCodeSeq"]').val(lastSeq);
            }
        });
    }

    // Call generateItemCode on focus if the input is empty
    $("#ItemCode").on("focus", function () {
        const currCode = $(this).val();
        if (!currCode) {
            generateItemCode();
        }
    }).on('change', function () {
        $('input[name="ItemCodeSeq"]').val(null);
    });

    // Initial call to generateItemCode if the input is empty
    if (!$("#ItemCode").val()) {
        generateItemCode();
    }

</script>
