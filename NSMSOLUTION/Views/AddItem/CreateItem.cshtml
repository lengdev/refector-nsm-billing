@{
    Layout = null;
}

@Html.Raw(@ViewBag.DrawHTMLForm)

<script>
    $(function () {
        let isEdit = "@ViewBag.PrimaryFieldValue" > "0" ? true : false;

        $(document).on("change", 'input[name="iMultiplier"]', function () {
            let m = $(this);
            const tr = $(this).closest('tr');
            const unit = $(tr).find('input[name="iUM"]');
            if (unit.val() === "") {
                DialogSweetAlert("error", "Please select UM.", function () {
                    $(m).val("");
                    $(unit).focus();
                });
                return false;
            }
            if (parseInt(m.val()) === 0) {
                m.val(1);
            }
        });

        $(document).on("keyup", 'input[name="iCostPrice"], input[name="iSellingPrice"]', function () {
            const input = $(this);
            const name = input.attr('name');
            const tr = input.closest('tr');
            const table = input.closest('#Table_UMItem');
            const tRows = $(table).find("tbody tr");
            const i = tRows.index(tr);

            const currentValue = parseFloat(input.val() || 0);

            if (isNaN(currentValue)) return;

            if (name === "iCostPrice" || name === "iSellingPrice") {
                const m = tr.find('input[name="iMultiplier"]');

                if (m.val() === "") {
                    DialogSweetAlert("error", "Please Enter Multiplier.", function () {
                        input.val("");
                        m.focus();
                    });
                    return false;
                }

                let value = currentValue;

                for (let j = i + 1; j < tRows.length; j++) {
                    const nextRow = tRows.eq(j);
                    const nextMultiplierInput = nextRow.find('input[name="iMultiplier"]');
                    const nextMultiplier = parseFloat(nextMultiplierInput.val() || 0);

                    if (!isNaN(nextMultiplier) && nextMultiplier !== 0) {
                        value = value / nextMultiplier;
                        nextRow.find(`input[name="${name}"]`).val(value);
                    } else {
                        break;
                    }
                }
            }
        });

        $(document).on("focus", 'input[name="iCostPrice"], input[name="iSellingPrice"]', function () {
            const input = $(this);
            const name = input.attr('name');
            const tr = input.closest('tr');
            const table = input.closest('#Table_UMItem');
            const tRows = $(table).find("tbody tr");
            const i = tRows.index(tr);

            if (i === 0 || input.val().trim() !== "") return;

            const prevRow = tRows.eq(i - 1);
            const prevValue = parseFloat(prevRow.find(`input[name="${name}"]`).val() || 0);
            const currentMultiplier = parseFloat(tr.find('input[name="iMultiplier"]').val() || 0);

            if (!isNaN(prevValue) && !isNaN(currentMultiplier) && currentMultiplier !== 0) {
                const result = prevValue / currentMultiplier;
                input.val(result);
            }
        });

    });
