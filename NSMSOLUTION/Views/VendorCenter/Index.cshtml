    function switchVcFileTab(tabId) {
        $('.vc-file-sub-tab').removeClass('active');
        $('.vc-file-sub-tab[data-sub="' + tabId + '"]').addClass('active');
        $('.vc-file-sub-panel').removeClass('active');
        $('#' + tabId).addClass('active');
    }

    function LoadCustAttachmentFile(ID) {
        if (!ID) return;
        LoadData("VendorCenter/LoadVendorAttachmentFile?ID=" + ID, function (response) {
            var data = JSON.parse(JSON.parse(response).data);
            var $container = $("#showDocuments");
            $container.empty();

            var billCardsHtml = '';
            var slipCardsHtml = '';
            var billCount = 0;
            var slipCount = 0;

            if (data && data.length > 0) {
                $.each(data, function (i, item) {
                    var files = (item.AttachmentFileName || '').split('~').filter(Boolean);
                    var folder = item.DestinationFolder || '';
                    var label  = item.TypeFor    || 'Attachment';
                    var refNo  = item.InvoiceNo  || '';
                    var pvNo   = item.PVNo       || '';
                    var date   = item.FileDate   || '';
                    var badgeCls = label === 'Posting Document' ? 'bg-primary' : 'bg-secondary';
                    var displayRef = (pvNo ? ('PV: ' + pvNo) : (refNo ? ('Ref: ' + refNo) : ''));

                    $.each(files, function (j, fname) {
                        fname = fname.trim();
                        if (!fname) return;
                        var ext  = fname.split('.').pop().toLowerCase();
                        var url  = ServerRoot + folder + fname;
                        var isImg = ['jpg','jpeg','png','gif','webp','bmp'].indexOf(ext) >= 0;
                        var isPdf = ext === 'pdf';

                        var previewContent = '';
                        if (isImg) {
                            previewContent = '<img src="' + url + '" alt="' + fname + '" />';
                        } else if (isPdf) {
                            previewContent = '<i class="fas fa-file-pdf text-danger" style="font-size:3rem"></i>';
                        } else {
                            previewContent = '<i class="fas fa-file text-secondary" style="font-size:3rem"></i>';
                        }

                        var actionsHtml = 
                            '<div class="vc-file-actions">' +
                                '<a href="' + url + '" data-fancybox="gallery" data-caption="' + (pvNo ? ('PV No: ' + pvNo + ' | ') : '') + refNo + ' (' + label + ')" class="vc-action-btn" title="View">' +
                                    '<i class="fas fa-eye"></i>' +
                                '</a>' +
                                '<a href="' + url + '" download="' + fname + '" target="_blank" class="vc-action-btn" title="Download">' +
                                    '<i class="fas fa-download"></i>' +
                                '</a>' +
                            '</div>';

                        var cardHtml = 
                            '<div class="col-sm-6 col-md-4 col-lg-3 mb-3">' +
                                '<div class="vc-file-card">' +
                                    '<div class="vc-file-thumb">' +
                                        previewContent +
                                        actionsHtml +
                                    '</div>' +
                                    '<div class="vc-file-info">' +
                                        '<div class="vc-file-ref" title="' + displayRef + '">' + (displayRef || fname) + '</div>' +
                                        '<div class="vc-file-date">' + date + '</div>' +
                                    '</div>' +
                                '</div>' +
                            '</div>';

                        if (label === 'Posting Document') {
                            slipCardsHtml += cardHtml;
                            slipCount++;
                        } else {
                            billCardsHtml += cardHtml;
                            billCount++;
                        }
                    });
                });
            }

            var billPanelContent = billCount > 0 
                ? '<div class="row g-2 p-2">' + billCardsHtml + '</div>'
                : '<div class="alert alert-light m-2 border"><i class="fa fa-info-circle me-1"></i> No Expense Bills found.</div>';

            var slipPanelContent = slipCount > 0 
                ? '<div class="row g-2 p-2">' + slipCardsHtml + '</div>'
                : '<div class="alert alert-light m-2 border"><i class="fa fa-info-circle me-1"></i> No Posting Documents (PV) found.</div>';

            var headerHtml = 
                '<div class="vc-file-sub-header">' +
                    '<div class="vc-file-sub-tabs">' +
                        '<div class="vc-file-sub-tab active" data-sub="vc-pane-id" onclick="switchVcFileTab(\'vc-pane-id\')">' +
                            '<i class="far fa-file-alt"></i> Expense Bill' + (billCount > 0 ? ' <span class="badge bg-secondary ms-1">' + billCount + '</span>' : '') +
                        '</div>' +
                        '<div class="vc-file-sub-tab" data-sub="vc-pane-bank" onclick="switchVcFileTab(\'vc-pane-bank\')">' +
                            '<i class="far fa-file-check"></i> Posting Document (PV)' + (slipCount > 0 ? ' <span class="badge bg-primary ms-1">' + slipCount + '</span>' : '') +
                        '</div>' +
                    '</div>' +
                '</div>';

            var panelsHtml = 
                '<div class="vc-file-sub-panel active" id="vc-pane-id">' +
                    billPanelContent +
                '</div>' +
                '<div class="vc-file-sub-panel" id="vc-pane-bank">' +
                    slipPanelContent +
                '</div>';

            $container.html('<div class="p-3">' + headerHtml + panelsHtml + '</div>');
        });
    }


    function PreviewReceipt(paymentID, companyID, receiptNo, invoiceNo, systemID, warehouseID) {
        paymentID   = (typeof paymentID   == "undefined" ? "0" : paymentID);
        companyID   = (typeof companyID   == "undefined" ? "0" : companyID);
        receiptNo   = (typeof receiptNo   == "undefined" ? "" : receiptNo);
        invoiceNo   = (typeof invoiceNo   == "undefined" ? "" : invoiceNo);
        systemID    = (typeof systemID    == "undefined" ? "" : systemID);
        warehouseID = (typeof warehouseID == "undefined" ? "" : warehouseID);

        var url = (typeof ServerRoot !== 'undefined' ? ServerRoot : '') + 'Payment/OfficialReceipt/?PaymentID=' + paymentID
                + '&CompanyID='         + companyID
                + '&OfficialReceiptNo=' + encodeURIComponent(receiptNo)
                + '&InvoiceNo='         + encodeURIComponent(invoiceNo)
                + '&SystemID='          + systemID
                + '&WarehouseID='       + warehouseID;

        var printWin = window.open(url, '_blank');
        if (printWin) {
            printWin.focus();
        } else {
            if (typeof DialogSweetAlert !== 'undefined') DialogSweetAlert('nopermission', 'Please allow popups.');
            else alert('Please allow popups.');
        }
    }


