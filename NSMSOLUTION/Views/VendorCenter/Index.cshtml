    function LoadCustInvoice(CustomerID, PreviewInvoice) {
        PreviewInvoice = typeof PreviewInvoice === "undefined" ? "" : PreviewInvoice;
        Swal.fire({
            title: 'Loading...',
            allowOutsideClick: false,
            position: 'top',
            didOpen: () => {
                Swal.showLoading();
            }
        });
        setTimeout(function () {
            LoadData("CustomerProfile/LoadCustInvoice?ID=" + encodeURIComponent(CustomerID) + "&hideAction=true", function (response) {
                Swal.close();
                $("#DivCustInvoice").html(JSON.parse(response).data);

                // Remove any existing listener to prevent duplicates
                document.removeEventListener('click', handleInvoicePreviewClick);
                document.addEventListener('click', handleInvoicePreviewClick);
            });
        }, 100);
    }

