<script>
    var VendorName = "";
    var VendorID = "";
    var VendorCode = "";
    var grids = null;
    var rowNumber = 0;
    $(document).ready(function () {
        $("a[data-widget=pushmenu]").click();
        $("#invoice_tab a").click(function (e) {
            e.preventDefault();
        });

        setTimeout(function () {
            VendorID = getFragmentParameterByName('id');
            LoadData("VendorCenter/LoadVendor", function (response) {
                $("#vertical").kendoSplitter({
                    orientation: "vertical",
                    panes: [
                        { collapsible: false }
                    ]
                });

                $("#horizontal").kendoSplitter({
                    panes: [
                        { collapsible: true, size: "20%" },
                        { collapsible: false, size: "80%" }
                    ],
                    height: "100%"  // Ensures the splitter height adjusts automatically
                });

                var items = JSON.parse(JSON.parse(response).Data);
                renderList(items);
                // Search functionality
                $('#searchBox').on('input', function () {
                    var keyword = $(this).val().trim().toLowerCase();
                    var filtered = items.filter(item =>
                        (item.VendorName || '').toLowerCase().includes(keyword)
                    );

                    renderList(filtered);
                });
            });            
            if (VendorID != null) {
                $("#Transcation_tab").click();
                LoadVendorProfilePicture(VendorID);
                LoadVendorInfo(VendorID);
                //GetCustomerBalance(VendorID);
            }
        }, 500);
        // Populate the list
        function renderList(items) {
            var $list = $('#itemList');
            $list.empty();

            items.forEach(function (item) {
                $list.append(
                    '<li class="k-item" data-id="' + item.VendorID + '">' +
                    fullyDecodeHtml(item.VendorName) +
                    '</li>'
                );
            });

            bindListEvents(items);

            if (VendorID) {
                $list.find('.k-item').removeClass('k-state-selected');

                $list.find('.k-item[data-id="' + Number(VendorID) + '"]')
                    .addClass('k-state-selected');
            }
        }


        function bindListEvents(data) {
            $('#itemList .k-item').off('click').on('click', function () {
                $('#itemList .k-item').removeClass('k-state-selected');
                $(this).addClass('k-state-selected');

                var selectedId = $(this).data('id');
                var selectedItem = data.find(item => item.VendorID === selectedId);

                const newHash = `#!/vendorcenter?id=${selectedItem.VendorID}`;
                const currentURL = window.location.href.split('#')[0];
                const newURL = `${currentURL}${newHash}`;
                history.replaceState(null, '', newURL);

                VendorName = fullyDecodeHtml(selectedItem.VendorName);
                VendorID = selectedItem.VendorID;
                VendorCode = selectedItem.VendorCode;

                // Show loading alert
                Swal.fire({
                    title: 'Loading...',
                    allowOutsideClick: false,
                    position: 'top',
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
                // Trigger default load
                setTimeout(function () {
                    $("#Transcation_tab").click();
                    LoadVendorProfilePicture(VendorID);
                    LoadVendorInfo(VendorID);
                    //GetCustomerBalance(VendorID);
                }, 100);
            });
        }

        $("#Transcation_tab").on('click', function () {
            GetTransactions(VendorID);
        });
        $("#SettledPayments-tab").on('click', function () {
            //LoadCustPaidInvoice(VendorID);
            LoadData("VendorCenter/GetTransactions?PayeeID=" + VendorID + "&PaymentStatus=Paid", function (response) {
                //$("#transactionsGrid").html(response);
                $("#showPaidInvoice").html(response);
            });
        });
        $("#OpenPayables-tab").on('click', function () {
            //LoadCustInvoice(VendorID);
            LoadData("VendorCenter/GetTransactions?PayeeID=" + VendorID + "&PaymentStatus=Unpaid", function (response) {
                //$("#transactionsGrid").html(response);
                $("#DivCustInvoice").html(response);
            });
        });
    });

    function getFragmentParameterByName(name) {
        var hash = window.location.hash;
        var match = hash.match(new RegExp('[?&]' + name + '=([^&]*)'));
        return match ? decodeURIComponent(match[1]) : null;
    }

    function LoadVendorProfilePicture(VendorID) {
        LoadData("VendorCenter/LoadVendorProfilePicture?ID=" + VendorID, function (response) {
            var data = JSON.parse(JSON.parse(response).data);
            var VendorProfilePicture = data[0].VendorPicture;
            VendorProfilePicture = (typeof VendorProfilePicture == "undefined" ? "" : VendorProfilePicture);
            VendorProfilePicture = (VendorProfilePicture == null ? "" : VendorProfilePicture);
            //var DestinationFile = data[0].DestinationFile;
            var img = ServerRoot + VendorProfilePicture;
            img = '<img class="profilepic__image" src="' + img + '" />';
            var row = '<div>';
            row += img;
            row += '</div>';
            row += "<div id=\"addCustPic\" class=\"profilepic__content\" style=\"cursor:pointer\">";
            row += '<span class="profilepic__icon"><i class="fas fa-camera"></i> <i name="deletepiccust" class="far fa-trash-alt"></i> ';
            row += '<a id="apreviewpropic" href="' + ServerRoot + VendorProfilePicture + '">';
            row += '<i name="viewprofilepic" class="far fa-eye"></i>';
            row += '</a></span>';
            row += '<span class="profilepic__text">Edit Profile</span>';
            row += '</div>';
            if (VendorProfilePicture != "") {
                $("#Cust_profilepic").html(row);
                baguetteBox.run('#apreviewpropic');
            }
            else {
                row = '<div class="profilepic__image"><i class="fa fa-8x fa-user-circle text-danger"></i></div>';
                row += '<div class="profilepic__content" id="addCustPic" style="cursor:pointer">';
                row += '<span class="profilepic__icon"><i class="fas fa-camera"></i></span>';
                row += '<span class="profilepic__text">Edit Profile</span></div>';
                $("#Cust_profilepic").html(row);
            }
            $("#addCustPic").click(function (ev) {
                elementClicked = $(ev.target);
                var name = (typeof elementClicked.attr('name') == "undefined" ? "" : elementClicked.attr('name'));
                if (name == "")
                    AddVendorAttachmentFile('AddCustomerProfilePic');
                else if (name == "viewprofilepic") {

                }
                else {
                    DialogSweetCofirm(function () {
                        var URL = "VendorCenter/SaveChangeVendorProfilePicture";
                        var DATA = {
                            Data: JSON.stringify({ VendorName: VendorName, VendorID: VendorID, VendorCode: VendorCode })
                        };
                        DoSaveChangeData(URL, DATA);
                        row = '<div class="profilepic__image"><i class="fa fa-8x fa-user-circle text-danger"></i></div>';
                        row += "<div class=\"profilepic__content\" id=\"addCustPic\" onclick=\"AddVendorAttachmentFile('AddCustomerProfilePic');\" style=\"cursor:pointer\">";
                        row += '<span class="profilepic__icon"><i class="fas fa-camera"></i></span>';
                        row += '<span class="profilepic__text">Edit Profile</span></div>';
                        $("#Cust_profilepic").html(row);
                    }, '', 'Do you to delete this file?');
                }
            });
        });
    }

    function AddVendorAttachmentFile(AddVendorProfilePic) {
        AddVendorProfilePic = (typeof AddVendorProfilePic == "undefined" ? "" : AddVendorProfilePic)
        var URL = "VendorCenter/SaveChangeVendorProfilePicture";
        var Title = "Add Attachment File to Vendor";
        if (AddVendorProfilePic != "") {
            URL = "VendorCenter/SaveChangeVendorProfilePicture";
            Title = "Add Vendor Profile Picture";
        }
        var PrimaryFieldValue = {
            SaveOnItsForm: true,
            VendorName: VendorName,
            VendorID: VendorID,
            URL: URL,
            VendorCode: VendorCode,
            TypeFor: "AttachmentFile"
        };
        var uri = "UploadFileForm?AllowOnlyImage=true&ShowAvatar=true";
        if (AddVendorProfilePic == "")
            uri = "UploadFileForm";

        ShowDialogBox2(Title, 700, 500, uri, PrimaryFieldValue, "DialogAddAttCustFile", function () {
            $("#DialogAddAttCustFile").on('hide.bs.modal', function () {
                if (AddVendorProfilePic == "")
                    LoadCustAttachmentFile(VendorID);
                else
                    LoadVendorProfilePicture(VendorID);
            });
        });
    }
    function LoadVendorInfo(VendorID) {
        LoadData("VendorCenter/LoadVendorInfo?ID=" + VendorID, function (response) {
            var VendorInfo = JSON.parse(JSON.parse(response).data).Table[0];
            var row = '<div class="row">';
            row += '<div class="col-auto text-left"><i class="far fa-star"></i></div>';
            row += '<div class="col text-left">' + VendorInfo.VendorType + '</div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-user"></i></div>';
            row += '<div class="col text-left"><label><a target="_blank" class="text-white" href="#!/CustomerProfile?ID=' + VendorID + '">' + fullyDecodeHtml(VendorInfo.VendorName) + '</a></label></div>';
            row += '</div>';
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-phone"></i></div>';
            row += '<div class="col text-left">' + VendorInfo.Phone + '</div>';
            row += '</div>';
            if (VendorInfo.Email != "") {
                row += '<div class="row">';
                row += '<div class="col-auto text-left"><i class="fa fa-envelope"></i></div>';
                row += '<div class="col text-left">' + VendorInfo.Email + '</div>';
                row += '</div>';
            }
            row += '<div class="row">';
            row += '<div class="col-auto text-left"><i class="fa fa-building"></i></div>';
            row += '<div class="col text-left">' + VendorInfo.Address + '.</div>';
            row += '</div>';
            $("div#CustInfo").html(row);
            row = '';
            if (VendorInfo.Website != null && VendorInfo.Website != "") {
                row += '<div class="row justify-content-end">';
                row += '<div class="col-auto">Website:</div>';
                row += '<div class="col-4 text-left">' + VendorInfo.Website + '</div>';
                row += '</div>';
            }
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Register Date:</div>';
            row += '<div class="col-4 text-left">' + VendorInfo.RegisterDate + '</div>';
            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Register By:</div>';
            row += '<div class="col-4 text-left">' + VendorInfo.CreateBy + '</div>';
            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">Payment Terms:</div>';
            row += '<div class="col-4 text-left">' + VendorInfo.PaymentTerms + '</div>';
            row += '</div>';
            row += '<div class="row justify-content-end">';
            row += '<div class="col-auto">VAT TIN:</div>';
            row += '<div class="col-4 text-left text-truncate" title="' + VendorInfo.VATTIN + '">' + VendorInfo.VATTIN + '</div>';
            row += '</div>';
            $("div#CustInfo-left").html(row);
            VendorInfo = JSON.parse(JSON.parse(response).data).Table1[0];
            var TotalInv = accounting.formatMoney(VendorInfo.TotalAmount, '');
            var CountInv = accounting.formatNumber(VendorInfo.TotalInvoices);
            var UnpaidInvoices = accounting.formatNumber(VendorInfo.UnpaidInvoices);
            var PartialPaidInvoices = accounting.formatNumber(VendorInfo.PartialPaidInvoices);
            var BalanceAmount = accounting.formatMoney(VendorInfo.BalanceAmount, '');
            var TotalPayments = accounting.formatNumber(VendorInfo.TotalPayments || 0);
            var paid = accounting.formatMoney(VendorInfo.PaidAmount, '');
            $("#TotalInv").html(TotalInv);
            $("#CountInv").html(CountInv + ' Bills');
