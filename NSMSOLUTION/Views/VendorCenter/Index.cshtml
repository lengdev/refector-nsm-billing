@{ Layout = null; }
<style>
    /* Ensure proper scrolling for the item list */
    .scrollable-list {
        list-style: none;
        padding: 0;
        margin: 0;
        height: calc(100vh - 200px); /* Adjust height based on your layout (account for other elements like search box) */
        overflow-y: auto; /* Enable vertical scroll */
    }

    /* Customer Profile style Sub-tabs & Upload Button */
    .vc-file-sub-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1.5px solid #e2e8f0;
        margin-bottom: 1rem;
        padding-bottom: 0.25rem;
    }
    .vc-file-sub-tabs {
        display: flex;
        gap: 1.5rem;
    }
    .vc-file-sub-tab {
        font-size: 0.925rem;
        font-weight: 500;
        color: #64748b;
        cursor: pointer;
        padding: 6px 4px 10px 4px;
        border-bottom: 2px solid transparent;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .vc-file-sub-tab:hover {
        color: #1e293b;
    }
    .vc-file-sub-tab.active {
        color: #2563eb;
        border-bottom-color: #2563eb;
        font-weight: 600;
    }
    .vc-file-sub-panel {
        display: none;
    }
    .vc-file-sub-panel.active {
        display: block;
    }
    .vc-upload-file-btn {
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 6px 16px;
        border: 1px solid #bfdbfe;
        background-color: #eff6ff;
        color: #2563eb;
        transition: all 0.15s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .vc-upload-file-btn:hover {
        background-color: #2563eb;
        color: #ffffff;
        border-color: #2563eb;
    }

    /* File Card Layout matching Customer Profile UI with Eye & Download buttons */
    .vc-file-card {
        background: #ffffff;
        border-radius: 12px;
        border: 1.5px solid #e2e8f0;
        overflow: hidden;
        transition: all 0.2s ease;
        position: relative;
    }
    .vc-file-card:hover {
        border-color: #2563eb;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
    }
    .vc-file-thumb {
        position: relative;
        height: 320px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }
    .vc-file-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .vc-file-actions {
        position: absolute;
        bottom: 8px;
        right: 8px;
        display: flex;
        gap: 6px;
        z-index: 5;
    }
    .vc-action-btn {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: #2563eb;
        color: #ffffff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
        transition: transform 0.15s ease, background 0.15s ease;
        text-decoration: none !important;
    }
    .vc-action-btn:hover {
        background: #1d4ed8;
        transform: scale(1.1);
    }
    .vc-file-info {
        padding: 8px 12px;
        font-size: 0.78rem;
        background: #ffffff;
        border-top: 1px solid #f1f5f9;
    }
    .vc-file-ref {
        font-weight: 600;
        color: #1e293b;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .vc-file-date {
        color: #94a3b8;
        font-size: 0.72rem;
    }

    /* Flex layout for the main layout */
    #mypane, #vertical, #horizontal {
        height: 100vh;
        display: flex;
        flex-direction: column;
    }

    #horizontal {
        display: flex;
        width: 100%;
        height: 100%;
    }

    /* Left and center panes */
    /*#left-pane {
        flex: 0 0 30%;
        max-width: 30%;
    }

    #center-pane {
        flex: 0 0 70%;
        max-width: 70%;
    }*/

    .pane-content {
        padding: 10px;
        box-sizing: border-box;
    }

    /* Ensure the sticky search box is within a scrollable container */
    #itemList {
        list-style: none;
        padding: 0;
        margin: 0;
        height: calc(100vh - 100px); /* Adjust based on your layout */
        overflow-y: auto;        
    }

    .sticky-search {
        position: sticky;
        top: 0; /* Ensure it's stuck at the top of its container */
        z-index: 10; /* Ensure it sits above other content */
        background-color: white; /* Make sure the background is set so it is visible above other content */
    }

    .k-item {
        padding: 8px;
        cursor: pointer;
        border-bottom: solid 1px #e8e5e5;
    }

        .k-item.k-state-selected {
            background-color: #e0e0e0;
        }
</style>

